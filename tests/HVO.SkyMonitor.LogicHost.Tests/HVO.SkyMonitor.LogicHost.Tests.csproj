<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="MSTest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <ProjectReference Include="..\..\src\HVO.SkyMonitor.LogicHost\HVO.SkyMonitor.LogicHost.csproj" />
    <ProjectReference Include="..\..\src\HVO.SkyMonitor.ProcessingRunner.Contracts\HVO.SkyMonitor.ProcessingRunner.Contracts.csproj" />
    <ProjectReference Include="..\..\src\HVO.SkyMonitor.TestSupport\HVO.SkyMonitor.TestSupport.csproj" />
    <Compile Include="..\TestSettings\MSTestSettings.cs" Link="MSTestSettings.cs" />
    <!-- The universal object-store conformance suite is shared with the Integration project so the filesystem
         provider is held to exactly the contract the S3 provider passes; linked rather than referenced so the
         Unit run does not take a dependency on Testcontainers. The classifier treats a linked source as owned
         by every project that compiles it. -->
    <Compile Include="..\HVO.SkyMonitor.LogicHost.IntegrationTests\ObjectStoreConformanceSuite.cs" Link="Services\ObjectStoreConformanceSuite.cs" />
    <Compile Include="..\HVO.SkyMonitor.CameraAgent.LogicHost.Tests\LogicHostProcessingConformanceTests.cs" Link="Services\LogicHostProcessingConformanceTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\fixtures\processing\cameraagent-execution-evidence-*.json" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\validation\central-transient-fault-matrix.json" Link="Validation\central-transient-fault-matrix.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\validation\central-transient-runtime-signals.json" Link="Validation\central-transient-runtime-signals.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\validation\transient-review-runtime-signals.json" Link="Validation\transient-review-runtime-signals.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\validation\logichost-ui-runtime-signals.json" Link="Validation\logichost-ui-runtime-signals.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\validation\central-elastic-runtime-signals.json" Link="Validation\central-elastic-runtime-signals.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1515;CA1707;CA2007;CA1861;CA1307;CA1859</NoWarn>
  </PropertyGroup>
</Project>
