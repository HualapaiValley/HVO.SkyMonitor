<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[HVO.SkyMonitor.Astronomy]*,[HVO.SkyMonitor]*,[HVO.SkyMonitor.*]*</Include>
          <Exclude>[*.Tests]*,[*.IntegrationTests]*,[HVO.SkyMonitor.TestSupport]*</Exclude>
          <ExcludeByFile>**/obj/**,**/bin/**,**/Migrations/**</ExcludeByFile>
          <ExcludeByAttribute>ExcludeFromCodeCoverage</ExcludeByAttribute>
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
