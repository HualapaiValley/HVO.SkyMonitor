<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The wizard runs here as the installer ships it: without Terminal.Gui's syntax highlighting (Directory.Build.targets). -->
    <HvoTerminalProgram>true</HvoTerminalProgram>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="coverlet.collector"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <ProjectReference Include="..\..\src\HVO.SkyMonitor.Deployment.Cli\HVO.SkyMonitor.Deployment.Cli.csproj" />
    <ProjectReference Include="..\..\src\HVO.SkyMonitor.Deployment.Contracts\HVO.SkyMonitor.Deployment.Contracts.csproj" />
    <EmbeddedResource Include="FrozenRawIngressV14.sql" />
    <EmbeddedResource Include="ReleaseManifestSchema1.json" />
    <EmbeddedResource Include="PartialPrepareInventory.json" />
    <EmbeddedResource Include="PreflightFixtures.json" />
    <!-- What the release tool writes for its own test inputs (ReleaseAssetsToolTests), which the installer must read. -->
    <EmbeddedResource Include="..\HVO.SkyMonitor.Deployment.Distribution.Tests\Fixtures\ReleaseTool\release.json"
                      LogicalName="HVO.SkyMonitor.Deployment.Cli.Tests.ReleaseToolOutput.json" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Exercise CameraAgent's actual startup validator without referencing the host or combining CI lanes. -->
    <Compile Include="..\..\src\HVO.SkyMonitor.CameraAgent\Configuration\LocalIdentityOptions.cs" Link="Shared/LocalIdentityOptions.cs" />
    <Compile Include="..\..\src\HVO.SkyMonitor.CameraAgent\Data\CameraAgentIdentityPolicy.cs" Link="Shared/CameraAgentIdentityPolicy.cs" />
    <Compile Include="..\..\src\HVO.SkyMonitor.CameraAgent\Data\ApplicationUser.cs" Link="Shared/ApplicationUser.cs" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <EmbeddedResource Include="..\..\src\HVO.SkyMonitor.CameraAgent\appsettings.json"
                      LogicalName="HVO.SkyMonitor.Deployment.Cli.Tests.CameraAgentAppsettings.json" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\fixtures\state-compatibility\previous-release\*" Link="Fixtures\previous-release\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
