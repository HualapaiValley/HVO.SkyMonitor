#!/usr/bin/env bash
# The commands install.sh runs, faked: scripts/test:install-sh links each one's name to this file. What each says and
# does comes from FAKE_* variables, and each call is logged in ${FAKE_STATE_DIR}/calls.log. Nothing here reaches the
# network, Docker or the machine's files outside the test's own folder.
set -u

name=${0##*/}
printf '%s %s\n' "${name}" "$*" >>"${FAKE_STATE_DIR}/calls.log"

case "${name}" in
  uname)
    case "${1:-}" in
      -s) printf '%s\n' "${FAKE_KERNEL:-Linux}" ;;
      -m) printf '%s\n' "${FAKE_MACHINE:-aarch64}" ;;
      *) exit 1 ;;
    esac
    ;;

  getconf)
    [ "$*" = LONG_BIT ] || exit 1
    printf '%s\n' "${FAKE_LONG_BIT:-64}"
    ;;

  ldd)
    if [ "${FAKE_LIBC:-glibc}" = musl ]; then
      printf 'musl libc (aarch64)\nVersion 1.2.5\n' >&2
      exit 1
    fi
    printf 'ldd (Debian GLIBC 2.36-9+rpt2+deb12u9) 2.36\n'
    ;;

  id)
    case "$*" in
      -u) printf '%s\n' "${FAKE_UID:-1000}" ;;
      -un) printf 'pi\n' ;;
      *) exit 1 ;;
    esac
    ;;

  curl)
    https=false head=false out="" write="" url=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --proto)
          [ "${2:-}" != "=https" ] || https=true
          shift 2
          continue
          ;;
        -o | -w)
          if [ "$1" = -o ]; then out=$2; else write=$2; fi
          shift 2
          continue
          ;;
        --retry | --connect-timeout | --max-time)
          shift 2
          continue
          ;;
        -I) head=true ;;
        -fsSL | -sS | --tlsv1.2) ;;
        -*)
          echo "fake curl: unexpected option $1" >&2
          exit 2
          ;;
        *) url=$1 ;;
      esac
      shift
    done
    ${https} || { echo "fake curl: not limited to HTTPS (--proto =https): ${url}" >&2; exit 2; }
    # FAKE_RELEASE_URL: where the release's files are served, as HVO_SKY_INSTALL_TEST_RELEASE_URL names it.
    release_url="${FAKE_RELEASE_URL:-https://github.com/HualapaiValley/HVO.SkyMonitor/releases/download/v${FAKE_RELEASE_VERSION}}/"
    case "${url}" in
      https://github.com)
        [ -z "${FAKE_GITHUB_EXIT:-}" ] || exit "${FAKE_GITHUB_EXIT}"
        ${head} || exit 2
        # FAKE_PROXY_DATE: a proxy's reply to CONNECT, with a Date of its own, before github.com's headers.
        [ -z "${FAKE_PROXY_DATE:-}" ] || printf 'HTTP/1.1 200 Connection established\r\ndate: %s\r\n\r\n' "${FAKE_PROXY_DATE}"
        printf 'HTTP/2 200\r\n'
        if [ "${FAKE_GITHUB_DATE:-yes}" = yes ]; then
          printf 'date: %s\r\n' "$(LC_ALL=C date -u -d "@$(($(date -u +%s) + ${FAKE_CLOCK_SKEW:-0}))" '+%a, %d %b %Y %H:%M:%S GMT')"
        fi
        printf 'content-type: text/html; charset=utf-8\r\n\r\n'
        ;;
      https://ghcr.io/v2/)
        [ -z "${FAKE_GHCR_EXIT:-}" ] || exit "${FAKE_GHCR_EXIT}"
        [ "${out}" = /dev/null ] && [ "${write}" = '%{http_code}' ] || exit 2
        printf 401
        ;;
      "${release_url}"*)
        file=${url#"${release_url}"}
        [ "${file}" != "${FAKE_DOWNLOAD_FAILS:-}" ] || exit "${FAKE_DOWNLOAD_EXIT:-22}"
        [ -f "${FAKE_RELEASE_DIR}/${file}" ] || exit 22
        [ -n "${out}" ] || exit 2
        cp "${FAKE_RELEASE_DIR}/${file}" "${out}"
        ;;
      *)
        echo "fake curl: nothing answers at ${url}" >&2
        exit 6
        ;;
    esac
    ;;

  docker)
    case "$*" in
      "version --format {{.Server.Version}}")
        case "${FAKE_DOCKER_ENGINE:-up}" in
          down)
            echo "Cannot connect to the Docker daemon at unix:///var/run/docker.sock. Is the docker daemon running?" >&2
            exit 1
            ;;
          denied)
            echo "permission denied while trying to connect to the Docker daemon socket at unix:///var/run/docker.sock: Get \"http://%2Fvar%2Frun%2Fdocker.sock/v1.47/version\": dial unix /var/run/docker.sock: connect: permission denied" >&2
            exit 1
            ;;
        esac
        printf '%s\n' "${FAKE_DOCKER_VERSION:-27.3.1}"
        ;;
      "buildx version")
        case "${FAKE_BUILDX:-v0.37.1}" in
          missing) echo "docker: 'buildx' is not a docker command." >&2; exit 1 ;;
          *) printf 'github.com/docker/buildx %s 0b265a9f62db554fa9aba6dd19e1bd5704bc7d8a\n' "${FAKE_BUILDX:-v0.37.1}" ;;
        esac
        ;;
      "compose version --short")
        [ "${FAKE_COMPOSE:-2.29.7}" != missing ] || { echo "docker: 'compose' is not a docker command." >&2; exit 1; }
        printf '%s\n' "${FAKE_COMPOSE:-2.29.7}"
        ;;
      # The limits it enforces, its CPUs and memory, and its data root.
      "info --format {{.MemoryLimit}},{{.CPUCfsQuota}},{{.PidsLimit}},{{.NCPU}},{{.MemTotal}},{{.DockerRootDir}}")
        [ "${FAKE_DOCKER_INFO:-works}" = works ] || { echo "Error response from daemon: info failed" >&2; exit 1; }
        printf '%s,%s\n' "${FAKE_DOCKER_LIMITS:-true,true,true,4,8589934592}" "${FAKE_DOCKER_ROOT}"
        ;;
      *)
        echo "fake docker: unexpected: $*" >&2
        exit 2
        ;;
    esac
    ;;

  df)
    [ "${1:-}" = -Pk ] || exit 1
    free=${FAKE_DF_FREE:-50000000}
    [ "$2" != "${FAKE_DF_LOW_PATH:-}" ] || free=${FAKE_DF_LOW_FREE:-1024}
    [ "${FAKE_DF:-works}" = works ] || free="-"
    printf 'Filesystem     1024-blocks      Used Available Capacity Mounted on\n'
    printf '/dev/root         60000000  10000000 %9s      17%% /\n' "${free}"
    ;;

  timedatectl)
    [ "$*" = "show --property=NTPSynchronized --value" ] || exit 1
    printf '%s\n' "${FAKE_NTP:-yes}"
    ;;

  tar) exec "${FAKE_REAL_TAR}" "$@" ;;

  sha256sum) exec "${FAKE_REAL_SHA256SUM}" "$@" ;;

  gh)
    case "$1 ${2:-}" in
      "auth status")
        # FAKE_GH_INTERRUPT: someone presses Ctrl-C while gh runs, so install.sh is sent SIGINT.
        [ -z "${FAKE_GH_INTERRUPT:-}" ] || kill -INT "${PPID}"
        [ "${FAKE_GH_AUTH:-yes}" = yes ] || { echo "You are not logged into any GitHub hosts. To log in, run: gh auth login" >&2; exit 1; }
        ;;
      "attestation verify")
        # FAKE_ATTESTATION_FAILS: the name of the file whose attestation does not verify (SHA256SUMS or hvo-sky-install).
        if [ "${3##*/}" = "${FAKE_ATTESTATION_FAILS:-}" ]; then
          printf 'Loaded digest sha256:%s for file://%s\n' "0000" "$3"
          printf 'Loaded 1 attestation from GitHub API\n'
          printf 'Error: verifying with issuer "sigstore.dev"\n'
          printf 'X Verification failed\n'
          printf 'Error: no matching attestations found\n'
          exit 1
        fi
        printf 'Loaded 1 attestation from GitHub API\nThe following policy criteria will be enforced:\n'
        printf '\xe2\x9c\x93 Verification succeeded!\n'
        ;;
      *) exit 2 ;;
    esac
    ;;

  *)
    echo "fake-command: no fake for ${name}" >&2
    exit 127
    ;;
esac
