    "steps": [{
      "id": "CloudObservation",
      "type": "VirtualSkyCloudObservation",
      "order": 5,
      "dependsOn": ["$raw"],
      "required": true
    },
    {
      "id": "Calibration",
      "type": "Calibration",
      "order": 10,
      "dependsOn": ["$raw"],
      "options": {
        "strategy": "None",
        "outputVariant": "none"
      }
    },
    {
      "id": "RollingCombination",
      "type": "RollingCombination",
      "order": 25,
      "dependsOn": ["Calibration"],
      "options": {
        "windowSize": 2
      }
    },
    {
      "id": "CalibratedPreview",
      "type": "Preview",
      "order": 45,
      "dependsOn": ["Calibration"],
      "options": {
        "recipeVersion": "integration-calibrated-preview-v1",
        "outputVariant": "calibrated-display",
        "blackPercentile": 0.5,
        "whitePercentile": 0.999,
        "asinhStrength": 4.0
      }
    },
    {
      "id": "Preview",
      "type": "Preview",
      "order": 50,
      "dependsOn": ["RollingCombination"],
      "options": {
        "recipeVersion": "integration-mono16-preview-v1",
        "blackPercentile": 0.5,
        "whitePercentile": 0.999,
        "asinhStrength": 4.0
      }
    },
    {
      "id": "Annotation",
      "type": "Annotation",
      "order": 75,
      "dependsOn": ["Preview"],
      "options": {
        "drawLabels": true,
        "drawConstellationLines": false,
        "drawImageCircle": true,
        "drawCardinalDirections": true,
        "recipeVersion": "integration-annotation-v2"
      }
    },
    {
      "id": "LocalStorage",
      "type": "Storage",
      "order": 100,
      "dependsOn": ["$raw", "RollingCombination", "Annotation", "CalibratedPreview"],
      "options": {
        "storageRoot": __STORAGE_ROOT__,
        "retentionDays": 1,
        "updateLatestFrame": true,
        "queueForUpload": false,
        "policies": [
          {
            "role": "Preview",
            "variant": "calibrated-display",
            "recipeName": "encoded-preview",
            "queueForUpload": false,
            "retentionDays": 7
          }
        ]
      }
    },
    {
      "id": "Telemetry",
      "type": "Telemetry",
      "order": 1000,
      "dependsOn": ["CloudObservation", "Calibration", "RollingCombination", "CalibratedPreview", "Preview", "Annotation", "LocalStorage"]
    }]
  },
