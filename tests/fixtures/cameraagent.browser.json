{
  "agentId": "cameraagent-browser-acceptance",
  "module": {
    "type": "VirtualSky",
    "options": {
      "seed": 106,
      "maximumMagnitude": 6.5,
      "maximumResults": 50,
      "magnitudeZeroElectronsPerSecond": 1000.0,
      "backgroundElectronsPerSecond": 2.0,
      "shotNoiseEnabled": false,
      "readNoiseStandardDeviation": 0.0,
      "rigProfileVersion": "browser-fixture-mono16-v1"
    }
  },
  "rig": {
    "sensor": {
      "name": "BrowserFixtureMono16",
      "widthPixels": 160,
      "heightPixels": 120,
      "pixelSizeMicrons": 5.0,
      "colorMode": "Mono",
      "pixelFormat": "Mono16",
      "responseMode": "Monochrome",
      "strideBytes": 320,
      "byteOrder": "LittleEndian",
      "sensorRecipeVersion": "browser-fixture-mono16-v1"
    },
    "optics": {
      "projectionModel": "EquidistantFisheye",
      "focalLengthMillimeters": 0.0,
      "fieldOfViewDegrees": 180.0,
      "rollDegrees": 0.0,
      "lensKind": "Fisheye",
      "principalPointX": 80.0,
      "principalPointY": 60.0,
      "imageCircleRadiusPixels": 58.0,
      "horizontalFlip": false,
      "calibrationVersion": "browser-fixture-optics-v1"
    },
    "orientation": {
      "boresightAltitudeDegrees": 90.0,
      "boresightAzimuthDegrees": 0.0,
      "rollAdjustmentDegrees": 0.0
    },
    "pipeline": {
      "captureInterval": "00:00:00.1000000",
      "cadenceMode": "MinimumStartInterval",
      "dayExposure": "00:00:00.0050000",
      "nightExposure": "00:00:00.0050000",
      "dayGain": 1.0,
      "nightGain": 1.0
    },
    "controlPolicy": {
      "exposureControl": "Disabled",
      "gainControl": "Disabled"
    }
  },
  "pipeline": {
    "schemaVersion": "cameraagent-capture-pipeline-v2",
    "dependencyPolicy": "reject-enabled-dependent-v1",
    "steps": [
      {
        "id": "Calibration",
        "type": "Calibration",
        "order": 10,
        "enabled": true,
        "dependsOn": ["$raw"],
        "options": {
          "strategy": "None",
          "outputVariant": "none"
        }
      },
      {
        "id": "Preview",
        "type": "Preview",
        "order": 50,
        "enabled": true,
        "dependsOn": ["Calibration"],
        "options": {
          "recipeVersion": "browser-fixture-preview-v1",
          "outputVariant": "browser-display",
          "blackPercentile": 0.01,
          "whitePercentile": 0.99,
          "asinhStrength": 2.0
        }
      },
      {
        "id": "LocalStorage",
        "type": "Storage",
        "order": 100,
        "enabled": true,
        "dependsOn": ["Preview"],
        "options": {
          "storageRoot": __STORAGE_ROOT__,
          "retentionDays": 1,
          "updateLatestFrame": true,
          "queueForUpload": false
        }
      },
      {
        "id": "Telemetry",
        "type": "Telemetry",
        "order": 1000,
        "enabled": true,
        "dependsOn": ["Calibration", "Preview", "LocalStorage"]
      }
    ]
  },
  "schedule": {
    "schemaVersion": "capture-schedule-v1",
    "setpointProfiles": [{ "id": "continuous", "exposure": "00:00:00.0050000", "gain": 1.0, "captureInterval": "00:00:00.1000000", "cadenceMode": "MinimumStartInterval" }],
    "weeklyWindows": [
      { "id": "continuous-sunday", "day": "Sunday", "start": { "kind": "FixedLocalTime", "localTime": "00:00:00" }, "end": { "kind": "FixedLocalTime", "localTime": "00:00:00", "dayOffset": 1 }, "setpointProfileId": "continuous" },
      { "id": "continuous-monday", "day": "Monday", "start": { "kind": "FixedLocalTime", "localTime": "00:00:00" }, "end": { "kind": "FixedLocalTime", "localTime": "00:00:00", "dayOffset": 1 }, "setpointProfileId": "continuous" },
      { "id": "continuous-tuesday", "day": "Tuesday", "start": { "kind": "FixedLocalTime", "localTime": "00:00:00" }, "end": { "kind": "FixedLocalTime", "localTime": "00:00:00", "dayOffset": 1 }, "setpointProfileId": "continuous" },
      { "id": "continuous-wednesday", "day": "Wednesday", "start": { "kind": "FixedLocalTime", "localTime": "00:00:00" }, "end": { "kind": "FixedLocalTime", "localTime": "00:00:00", "dayOffset": 1 }, "setpointProfileId": "continuous" },
      { "id": "continuous-thursday", "day": "Thursday", "start": { "kind": "FixedLocalTime", "localTime": "00:00:00" }, "end": { "kind": "FixedLocalTime", "localTime": "00:00:00", "dayOffset": 1 }, "setpointProfileId": "continuous" },
      { "id": "continuous-friday", "day": "Friday", "start": { "kind": "FixedLocalTime", "localTime": "00:00:00" }, "end": { "kind": "FixedLocalTime", "localTime": "00:00:00", "dayOffset": 1 }, "setpointProfileId": "continuous" },
      { "id": "continuous-saturday", "day": "Saturday", "start": { "kind": "FixedLocalTime", "localTime": "00:00:00" }, "end": { "kind": "FixedLocalTime", "localTime": "00:00:00", "dayOffset": 1 }, "setpointProfileId": "continuous" }
    ]
  }
}
