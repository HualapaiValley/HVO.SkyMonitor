{
  "schemaVersion": "hvo-space-weather-swpc-scenario-v1",
  "scenarioId": "s23-retry-after-forms",
  "title": "Retry-After accepts only delta-seconds or exact IMF-fixdate",
  "covers": [
    "retry-after",
    "imf-fixdate",
    "calendar-date",
    "weekday"
  ],
  "containsSyntheticRecords": true,
  "notes": [
    "All response headers and the reset alert are synthetic. Each 429 is followed by an accepted reset body so the next case starts with a zero 429 count.",
    "Invalid forms give 1800 seconds. A matching weekday is required. Valid years 0001 and 9999 give the existing 60-second floor and 21600-second cap."
  ],
