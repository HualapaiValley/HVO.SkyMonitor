# HVO.SkyMonitor smoke-test environment contract.
# Generate the ignored .env.smoketest with: ./scripts/smoke:env init
# Blank credentials must be supplied by the owner-only .env baseline.
# Never put generated device identities, pairing codes, envelopes, or device secrets here.
# Blank behavior is documented at each blank field: generated, derived, inherited, or conditionally unused.

# Contract version is currently fixed at 1.
SMOKETEST_SCHEMA_VERSION=1
# Lowercase letters, digits, and hyphens only; maximum 32 characters. Blank generates a unique value.
SMOKETEST_RUN_ID=
# Valid: preserve, isolated, reset-shared. isolated derives run-scoped service namespaces.
SMOKETEST_DATA_POLICY=preserve
# Blank means unused for preserve/isolated. For reset-shared it must exactly equal SMOKETEST_RUN_ID.
SMOKETEST_CONFIRM_SHARED_DATA_RESET=
# Valid: manual, automated. Automated execution is implemented by the #151 orchestrator.
SMOKETEST_BOOTSTRAP_MODE=manual
# Blank derives TestResults/smoke/<run-id>/state and .../evidence, respectively.
# Both paths must remain distinct beneath TestResults/smoke/<run-id>/.
# Run state is private and may contain generated bootstrap identifiers; evidence must be sanitized.
SMOKETEST_RUN_STATE_PATH=
SMOKETEST_EVIDENCE_ROOT=
# Blank Compose project derives the required hvo-smoke-<run-id>. Blank Redis/buckets derive the stable values
# skymonitor:, skymonitor-artifacts, and skymonitor-diagnostics, or run-scoped values for isolated mode.
# Compose project must equal the derived value; lowercase [a-z0-9_-], starting alphanumeric.
# Redis prefix must equal skymonitor: for preserve/reset-shared or skymonitor:<run-id>: for isolated.
# MinIO buckets must equal the stable SkyMonitor names for preserve/reset-shared or the derived
# hvo-<run-id>-artifacts/diagnostics names for isolated; names are 3-63 lowercase [a-z0-9.-]
# characters starting and ending alphanumeric.
SMOKETEST_COMPOSE_PROJECT=
SMOKETEST_REDIS_PREFIX=
SMOKETEST_MINIO_ARTIFACT_BUCKET=
SMOKETEST_MINIO_DIAGNOSTICS_BUCKET=

# Control host and Docker-host path mapping.
# Docker host name/address: letters, digits, dots, and hyphens; name must equal Docker daemon Name,
# and DNS resolution must include the configured address. IPv6 URL authorities are not supported yet.
SMOKETEST_DOCKER_HOST_NAME=localhost
SMOKETEST_DOCKER_HOST_ADDRESS=127.0.0.1
# Absolute canonical repository paths as seen by this process and by the Docker daemon, respectively.
# Blank defaults each path to the repository containing this script; override the host path in a devcontainer.
# A devcontainer mapping must be a writable bind; direct-host execution normally uses the same path.
SMOKETEST_CONTROL_REPO_PATH=
SMOKETEST_REPO_HOST_PATH=
# The development .env value is intentionally ignored. Blank derives
# <host-repository>/data/smoke/<run-id>. Otherwise use an absolute canonical Docker-host path below
# SMOKETEST_REPO_HOST_PATH; an existing root must use mode 700.
HVO_RUNTIME_DATA_ROOT=
# Published TCP ports; valid range 1-65535.
LOGIC_HOST_HTTP_PORT=5174
CAMERA_AGENT_HTTP_PORT=5130
# Browser-reachable HTTP(S) URLs using the declared Docker host name/address and matching published port.
SMOKETEST_LOGIC_HOST_PUBLIC_URL=http://127.0.0.1:5174
SMOKETEST_CAMERA_AGENT_PUBLIC_URL=http://127.0.0.1:5130

# Shared services and telemetry.
# Hosts must resolve from the control environment; every port is 1-65535. SQL, Redis, MinIO API,
# SMTP transport, and OTLP ports are probed. MinIO console and SMTP web ports are range-validated only.
# SQLSERVER_DATABASE is replaced with a run-scoped name when DATA_POLICY=isolated.
SQLSERVER_HOST=hvo-docker.hvo.lan
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=SkyMonitor
SQLSERVER_USER=skymonitor-app
# Blank is inherited from .env and is invalid if still blank; init never invents shared-service credentials.
SQLSERVER_PASSWORD=
# REDIS_USER/PASSWORD authenticate the application; SMOKETEST_REDIS_PREFIX owns namespace isolation.
REDIS_HOST=hvo-docker.hvo.lan
REDIS_PORT=6379
REDIS_USER=skymonitor-app
# Blank is inherited from .env and is invalid if still blank.
REDIS_PASSWORD=
# Root credentials provision/reset only; ACCESS_KEY/SECRET_KEY are the scoped application identity.
MINIO_HOST=hvo-docker.hvo.lan
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=skymonitor
# Both blank MinIO secrets are inherited from .env and are invalid if still blank.
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=skymonitor-app
MINIO_SECRET_KEY=
# SMTP is Mailpit for this development smoke; production SMTP requires a separate deployment contract.
SMTP_HOST=hvo-docker.hvo.lan
SMTP_PORT=1025
SMTP_WEB_PORT=8025
SMTP_FROM=no-reply@skymonitor.local
# Valid protocol currently: http/protobuf. Endpoint must be an HTTP(S) OTLP receiver URL.
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.1.238:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# LogicHost and CameraAgent identity inputs.
# Owner email is used by the LogicHost login form; username is retained for seed/audit identity.
# Smoke owner password: at least 12 characters with uppercase, lowercase, digit, and non-alphanumeric.
# Blank owner password first inherits LOGIC_HOST_SMOKE_OWNER_PASSWORD from .env, then generates a
# run-scoped value if still absent.
LOGIC_HOST_SMOKE_OWNER_EMAIL=smoke-owner@skymonitor.local
LOGIC_HOST_SMOKE_OWNER_USERNAME=smoke-owner
LOGIC_HOST_SMOKE_OWNER_PASSWORD=
# Raw 256-bit key: exactly 64 hexadecimal characters. Blank first inherits from .env, then generates
# a run-scoped value if still absent. It is used only by protected smoke API probes; never print it.
LOGIC_HOST_SMOKE_API_KEY=
# Local CameraAgent owner password: at least 12 characters with uppercase, lowercase, digit, and
# non-alphanumeric. OAuth client ID/secret: any non-empty values matching the provisioned client.
# Blank CameraAgent password/OAuth secret inherit from .env and are invalid if still blank; init does
# not generate them because they must match the deployed local owner and central client.
CAMERA_AGENT_ADMIN_EMAIL=owner@cameraagent.local
CAMERA_AGENT_ADMIN_PASSWORD=
CAMERA_AGENT_OAUTH_CLIENT_ID=system-camera-agent
CAMERA_AGENT_OAUTH_CLIENT_SECRET=
# Container-internal HTTP(S) LogicHost service URLs, not browser/public URLs.
CAMERA_AGENT_LOGIC_BASEURL=http://logichost:8080
CAMERA_AGENT_IDENTITY_URL=http://logichost:8080

# Desired nominal physical Observatory. Camera deployment precision and GPS provenance are owned by #170.
# Latitude: inclusive -90..90; longitude: inclusive -180..180 and east-positive.
# Elevation: any finite numeric meters; no narrower application limit is currently imposed.
# Timezone must be an installed IANA identifier. Capture timestamps remain UTC.
SMOKETEST_OBSERVATORY_NAME="Hualapai Valley Smoke Observatory"
SMOKETEST_OBSERVATORY_LATITUDE=35.5599378
SMOKETEST_OBSERVATORY_LONGITUDE=-113.9119818
SMOKETEST_OBSERVATORY_ELEVATION_METERS=520
SMOKETEST_OBSERVATORY_TIMEZONE=America/Phoenix

# Desired CameraAgent and workload. Generated identity belongs in SMOKETEST_RUN_STATE_PATH.
SMOKETEST_CAMERA_AGENT_FRIENDLY_NAME="VirtualSky Smoke Camera"
# Safe, nonsymlinked repository-relative JSON configuration path. Validation requires its sensor
# width/height, cadence mode/interval, and night exposure to match the declared workload below.
SMOKETEST_CAMERA_CONFIG_PATH=src/HVO.SkyMonitor.CameraAgent/cameraagent.sample.json
# Dimensions: positive integer pixels with no environment-level maximum.
# Exposure/cadence: numeric seconds greater than zero with no environment-level maximum; the selected
# CameraAgent configuration may impose a narrower exposure envelope.
SMOKETEST_EXPECTED_WIDTH_PIXELS=484
SMOKETEST_EXPECTED_HEIGHT_PIXELS=304
SMOKETEST_EXPOSURE_SECONDS=20
SMOKETEST_CADENCE_SECONDS=25
# Valid smoke cadence: MinimumStartInterval. Continuous is intentionally rejected for accelerated VirtualSky.
SMOKETEST_CADENCE_MODE=MinimumStartInterval

# Approved production catalog identity and control-host installation.
# Blank root derives <control-repository>/data/catalog. Otherwise use an absolute canonical control
# path. `current` and its database payload may point only inside that root/version.
# Remaining values are exact pinned values except row count, which is a positive integer. Fixture
# packages and any package/catalog/schema/preprocessing/checksum/row-count drift fail preflight.
SMOKETEST_CATALOG_ROOT_CONTROL=
SMOKETEST_CATALOG_KIND=production
SMOKETEST_CATALOG_PACKAGE_VERSION=hyg-v4.2-p3-s2-r1
SMOKETEST_CATALOG_VERSION=4.2
SMOKETEST_CATALOG_SCHEMA_VERSION=2
SMOKETEST_CATALOG_PREPROCESSING_VERSION=3
SMOKETEST_CATALOG_DATABASE_SHA256=b51d18b722199e89aa8fe4622ebe507346c75effb375e546881452a263f0b9e2
SMOKETEST_CATALOG_ROW_COUNT=119625
