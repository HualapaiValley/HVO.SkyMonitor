<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- Linux is the supported platform. Ordinary dev/test builds select host-native assets without changing their
         output paths. An implicit publish follows the SDK host (including native ARM64 container builds); explicit
         runtimes win. Restore both supported targets so publishing without restoring works after an ordinary restore. -->
    <!-- The bundled SDK props are imported later. Honor a supplied Linux SDK host RID; otherwise query the OS
         architecture here, so an ordinary build on native ARM64 does not silently select x64 assets. -->
    <!-- _IsPublishing is an SDK-internal property supplied by dotnet publish, not a public MSBuild contract.
         This depends on global.json's pinned SDK. Revalidate scripts/test:linux-build-rids and implicit/explicit
         Linux publishing when upgrading the SDK; invoking the Publish target alone is not the CLI publish path. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(_IsPublishing)' != 'true' and $(NETCoreSdkPortableRuntimeIdentifier.StartsWith('linux-'))">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(_IsPublishing)' != 'true'">linux-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == ''">linux-x64;linux-arm64</RuntimeIdentifiers>
    <UseCurrentRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(_IsPublishing)' == 'true' and '$(UseCurrentRuntimeIdentifier)' == ''">true</UseCurrentRuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath Condition="'$(_IsPublishing)' != 'true' and '$(AppendRuntimeIdentifierToOutputPath)' == ''">false</AppendRuntimeIdentifierToOutputPath>
    <!-- Keep runtime bundling a publish concern. -->
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
  </PropertyGroup>
  <!--
    The product version (install contract section 1, #1310): one version for every program and image, the next
    release's, which scripts/release:version reads. A release tag vX.Y.Z or vX.Y.Z-rc.N must name it, and a release's
    builds are given the release's version as -p:Version (scripts/release:assets), which is this or a pre-release of it.
    A build given no version is the development build of it, X.Y.Z-dev. Directory.Build.targets refuses a build given
    any other version. The SDK appends the commit to the informational version, from the checkout or from
    -p:SourceRevisionId.
  -->
  <PropertyGroup Label="Product Version">
    <VersionPrefix>0.9.1</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' and '$(Version)' == ''">dev</VersionSuffix>
  </PropertyGroup>
</Project>
