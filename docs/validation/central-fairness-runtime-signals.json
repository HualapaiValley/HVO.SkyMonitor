{
  "schema": "hvo-runtime-signal-manifest-v1",
  "issue": 429,
  "component": "LogicHost fair scheduling and entitlements",
  "meter": "HVO.SkyMonitor.LogicHost.ProcessingFairness",
  "activitySource": "HVO.SkyMonitor.LogicHost.DerivativeWorker",
  "logs": [
    { "eventId": 2220, "level": "Information", "fields": ["Worker", "JobId", "Observatory", "Reason", "Active", "Limit"] },
    { "eventId": 2221, "level": "Warning", "fields": ["Worker", "Iteration", "ElapsedMilliseconds", "LockBusy", "ThrottledDimensions", "SkippedJobs", "Retries"] }
  ],
  "metrics": [
    { "name": "skymonitor.central.fairness.queue", "unit": "{job}", "labels": { "observatory": ["<observatory id>"], "status": ["pending", "leased", "waiting"] } },
    { "name": "skymonitor.central.fairness.queue.oldest_age", "unit": "s", "labels": { "observatory": ["<observatory id>"] } },
    { "name": "skymonitor.central.fairness.active", "unit": "{job}", "labels": { "observatory": ["<observatory id>"] } },
    { "name": "skymonitor.central.fairness.entitlement", "unit": "{job}", "labels": { "observatory": ["<observatory id>"] } },
    { "name": "skymonitor.central.fairness.saturation", "unit": "1", "labels": { "observatory": ["<observatory id>"] } },
    { "name": "skymonitor.central.fairness.throttled", "unit": "{claim}", "labels": { "observatory": ["<observatory id>"], "reason": ["observatory", "camera", "class", "class-bytes", "observatory-class"] } },
    { "name": "skymonitor.central.fairness.completions", "unit": "{attempt}", "semantics": "cumulative total from the persisted CentralProcessingUsageRollups; identical on every replica, aggregate across replicas with max", "labels": { "observatory": ["<observatory id>"], "class": ["structured-analysis", "presentation", "composition", "encoding", "image"], "outcome": ["completed", "retryablefailure", "terminalfailure", "leaseexpired", "canceled", "skipped", "quarantined", "superseded"] } },
    { "name": "skymonitor.central.fairness.usage.bytes", "unit": "By", "semantics": "cumulative total from the persisted CentralProcessingUsageRollups; identical on every replica, aggregate across replicas with max", "labels": { "observatory": ["<observatory id>"], "direction": ["input", "output"] } }
  ],
  "healthChecks": [
    { "name": "processing-entitlements", "tags": ["worker"], "data": ["enabled", "observatoriesWithWork", "pendingJobs", "activeLeases", "overAdmissionLimit", "saturatedWithOldBacklog", "saturatedDimensions"] }
  ],
  "collection": [
    "dotnet test tests/HVO.SkyMonitor.LogicHost.IntegrationTests/HVO.SkyMonitor.LogicHost.IntegrationTests.csproj --configuration Release --filter \"FullyQualifiedName~ProcessingEntitlementIntegrationTests\"",
    "dotnet test tests/HVO.SkyMonitor.LogicHost.IntegrationTests/HVO.SkyMonitor.LogicHost.IntegrationTests.csproj --configuration Release --filter \"FullyQualifiedName~ProcessingFairnessPerformanceEvidenceTests\""
  ],
  "privacy": [
    "Metrics carry observatory ids only.",
    "Log events 2220 and 2221 carry the claiming worker id (an operator-assigned host or runner name) and, for 2220, the job id; both are operational identifiers already present in the derivative job tables and lease telemetry, and neither is an owner, credential, or payload value.",
    "CentralProcessingUsageRecords rows store observatory id, device public id, job id, worker id, recipe, class, outcome, reason code, timestamps, and byte counts; no owner, credential, or payload data is stored."
  ],
  "evidence": ["TestResults/processing-fairness/<revision>/processing-fairness-evidence.json"]
}
