flowchart LR
    subgraph Agent[Camera Agent]
        A1[CapturePipelineRunner]
        A2[UploadProcessingStep]
        A3[("Local RAW storage / MinIO optional")]
    end

    subgraph Transport[Transport Layer]
        B1[["Queue/Stream (Redis/Azure Queue)"]]
        B2[("Object Storage (MinIO/S3/Azure Blob)")]
    end

    subgraph LogicHost[LogicHost Region]
        C1["FrameIngest API (/api/v1.0/frames)"]
        C2[FrameProcessingWorker]
        C3[Derivative Planner]
        C4[Latest Frame Cache]
    end

    A1 --> A2
    A2 -->|FrameEnvelope + blob refs| B1
    A2 -->|RAW/Derived objects| B2
    B1 --> C1
    C1 -->|Validate token, hash, schema| C2
    C2 -->|Write tenant namespace| B2
    C2 --> C3
    C3 --> C4
    C4 -->|Serve /latest + API| LogicHost_UI[LogicHost UI]

