{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch AppHost (dotnet run - HTTP)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/HVO.SkyMonitor.AppHost/HVO.SkyMonitor.AppHost.csproj",
                "--launch-profile",
                "http"
            ],
            "cwd": "${workspaceFolder}/src/HVO.SkyMonitor.AppHost",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "DOTNET_ENVIRONMENT": "Development",
                "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true",
                "DOCKER_HOST_ADDRESS": "0.0.0.0"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "(?:Now listening on:|Login to the dashboard at) https?://\\S+",
                "uriFormat": "http://localhost:15201"
            }
        },
        {
            "name": "Attach -> HVO.SkyMonitor (pick)",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "justMyCode": false
        },
        {
            "name": "Attach -> Simulator Agent (pick)",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "justMyCode": false
        },
        {
            "name": "Attach -> ZWO Agent (pick)",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "justMyCode": false
        }
    ],
    "compounds": [
        {
            "name": "AppHost + Attach to Projects",
            "configurations": [
                "Launch AppHost (dotnet run - HTTP)",
                "Attach -> HVO.SkyMonitor (pick)",
                "Attach -> Simulator Agent (pick)",
                "Attach -> ZWO Agent (pick)"
            ]
        }
    ]
}