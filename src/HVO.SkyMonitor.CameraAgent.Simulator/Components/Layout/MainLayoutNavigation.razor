@using Microsoft.AspNetCore.Components.Routing

<header>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar shadow-sm">
        <div class="container-fluid align-items-center px-3 px-lg-4">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <i class="bi bi-stars"></i>
                <span>Camera Agent Simulator</span>
                <span class="text-muted small">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNav"
                aria-controls="primaryNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse py-3 py-lg-0" id="primaryNav">
                <div class="nav-badge-bar me-auto">
                    @foreach (var link in PrimaryNavigationLinks)
                    {
                        <NavLink class="nav-badge" href="@link.Href" Match="@link.Match">
                            <i class="@($"{link.IconClass} nav-badge__icon")"></i>
                            <span>@link.Label</span>
                        </NavLink>
                    }
                </div>

                <div class="nav-toolbar d-flex align-items-center gap-3 mt-3 mt-lg-0 ms-lg-4">
                    <div class="nav-actions d-flex align-items-center gap-2">
                        @foreach (var action in AuxiliaryActions)
                        {
                            <button type="button" class="nav-icon-button" title="@action.Tooltip"
                                aria-label="@action.Tooltip">
                                <i class="@action.IconClass"></i>
                            </button>
                        }
                    </div>

                    <div class="nav-account-info d-flex align-items-center gap-2">
                        <span class="nav-avatar">
                            <i class="bi bi-hdd-network"></i>
                        </span>
                        <span class="nav-account-details text-start">
                            <span class="nav-account-name">Camera Agent Simulator</span>
                            <span class="nav-account-email text-muted small">(Service Account)</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>