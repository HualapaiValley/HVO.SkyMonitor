@page "/Account/Manage/ApiKeys"

@using System.ComponentModel.DataAnnotations
@using System.Linq
@using System.Security.Cryptography
@using System.Threading
@using HVO.SkyMonitor.CameraAgent.Simulator.Components.Account
@using HVO.SkyMonitor.CameraAgent.Simulator.Components.Account.Shared
@using HVO.SkyMonitor.CameraAgent.Simulator.Data
@using HVO.SkyMonitor.CameraAgent.Simulator.Security
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

<PageTitle>API keys</PageTitle>

<h3>API keys</h3>
<StatusMessage Message="@statusMessage" />

@if (!string.IsNullOrEmpty(generatedPlaintextKey))
{
    <div class="alert alert-warning api-key-generated-alert" role="alert">
        <strong>Copy this key now. It will not be shown again.</strong>
        <div class="mt-2">
            <code class="generated-key">@generatedPlaintextKey</code>
        </div>
    </div>
}

<div class="api-keys-grid">
    <div class="card api-key-card">
        <div class="card-body">
            <h5 class="card-title api-key-card__title">Existing keys</h5>
            @if (apiKeys.Count == 0)
            {
                <p class="api-key-empty text-muted mb-0">No API keys found. Create one to get started.</p>
            }
            else
            {
                <div class="table-responsive api-key-table-wrapper">
                    <table class="table table-striped align-middle mb-0 api-key-table">
                        <thead>
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Access</th>
                                <th scope="col">Created</th>
                                <th scope="col">Last used</th>
                                <th scope="col">Expires</th>
                                <th scope="col">Status</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var key in apiKeys)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(key.DisplayName) ? key.DisplayName
                                                                                : "(unnamed key)")
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge api-key-access-badge">@GetAccessLevelLabel(key.AccessLevel)</span>
                                    </td>
                                    <td>@FormatTimestamp(key.CreatedUtc)</td>
                                    <td>@FormatTimestamp(key.LastUsedUtc)</td>
                                    <td>@FormatExpiration(key.ExpiresUtc)</td>
                                    <td>
                                        @if (key.IsActive)
                                        {
                                            <span class="badge api-key-status-badge api-key-status-badge--active">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge api-key-status-badge api-key-status-badge--inactive">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group" aria-label="API key actions">
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                disabled="@(_busyKeyId == key.Id)"
                                                @onclick="() => ToggleKeyAsync(key.Id, !key.IsActive)">
                                                @(key.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                disabled="@(_busyKeyId == key.Id)" @onclick="() => DeleteKeyAsync(key.Id)">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card api-key-card">
        <div class="card-body">
            <h5 class="card-title api-key-card__title">Create a new API key</h5>
            <p class="card-text api-key-card__description">Use API keys for headless integrations. Keys inherit this
                account's identity.</p>
            <EditForm class="api-key-form" Model="FormModel" FormName="create-api-key" OnValidSubmit="OnCreateKeyAsync"
                method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="mb-3">
                    <label for="Input.DisplayName" class="form-label">Display name (optional)</label>
                    <InputText @bind-Value="FormModel.DisplayName" id="Input.DisplayName" class="form-control"
                        placeholder="OBS ingestion key" />
                    <ValidationMessage For="() => FormModel.DisplayName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="Input.AccessLevel" class="form-label">Access level</label>
                    <InputSelect @bind-Value="FormModel.AccessLevel" id="Input.AccessLevel" class="form-select">
                        @foreach (var option in AccessLevelOptions)
                        {
                            <option value="@option">@GetAccessLevelLabel(option)</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => FormModel.AccessLevel" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="Input.ExpiresOnUtc" class="form-label">Expires on (UTC, optional)</label>
                    <InputDate TValue="DateTime ?" @bind-Value="FormModel.ExpiresOnUtc" id="Input.ExpiresOnUtc"
                        class="form-control" />
                    <ValidationMessage For="() => FormModel.ExpiresOnUtc" class="text-danger" />
                    <div class="form-text">Leave blank to create a key without an expiration date.</div>
                </div>
                <button type="submit" class="btn btn-primary w-100 api-key-form__submit" disabled="@createInProgress">
                    @if (createInProgress)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    Create API key
                </button>
            </EditForm>
        </div>
    </div>
</div>