{
  "ConnectionStrings": {
    "skymonitordb": "",
    "skymonitordb-migrations": "",
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Telemetry": {
    "ServiceName": "hvo-skymonitor",
    "ActivitySources": [ "HVO.Enterprise.Telemetry", "HVO.SkyMonitor.LogicHost", "HVO.SkyMonitor.LogicHost.FleetStatus", "HVO.SkyMonitor.LogicHost.EnvironmentalObservations", "HVO.SkyMonitor.LogicHost.DerivativeWorker", "HVO.SkyMonitor.CentralTransientLifecycle" ]
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "skymonitor:"
  },
  "ObjectStorage": {
    "ServiceEndpoint": "localhost:9000",
    "Region": "us-east-1",
    "UseTls": false,
    "AddressingStyle": "Path",
    "CredentialMode": "DefaultChain",
    "AccessKey": "",
    "SecretKey": "",
    "SessionToken": "",
    "ArtifactBucket": "skymonitor-artifacts",
    "DiagnosticsBucket": "skymonitor-diagnostics"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "From": "no-reply@skymonitor.local",
    "FromDisplayName": "SkyMonitor",
    "Username": "",
    "Password": ""
  },
  "CentralIdentity": {
    "ServiceUrl": "https://localhost:7096",
    "Mode": "ClientCredentials",
    "ClientCredentials": {
      "ClientId": "logic-host",
      "ClientSecret": "",
      "Scopes": [
        "api.admin",
        "api.camera",
        "api.frames",
        "api.images"
      ]
    },
    "InteractiveClient": {
      "ClientId": "logic-host-interactive",
      "ClientSecret": "",
      "PublicAuthority": "https://localhost:7096",
      "Scopes": [
        "openid",
        "profile",
        "email",
        "api.admin"
      ],
      "CallbackPath": "/signin-central",
      "SignedOutCallbackPath": "/signout-callback-central",
      "RemoteSignOutPath": "/signout-central"
    },
    "TokenCacheDurationSeconds": 300,
    "TokenRefreshWindowSeconds": 60
  },
  "DeviceBootstrap": {
    "CentralIdentity": {
      "ServiceUrl": "https://localhost:7096",
      "Mode": "ClientCredentials",
      "ClientCredentials": {
        "ClientId": "system-camera-agent",
        "ClientSecret": "",
        "Scopes": [
          "api.camera",
          "api.frames",
          "api.images"
        ]
      },
      "TokenCacheDurationSeconds": 300,
      "TokenRefreshWindowSeconds": 60
    }
  },
  "CentralDerivativeWorker": {
    "Enabled": true,
    "WorkerId": "logic-host-derivative-worker",
    "Concurrency": 1,
    "PollInterval": "00:00:01",
    "QueueSampleInterval": "00:00:10",
    "LeaseDuration": "00:02:00",
    "RenewalInterval": "00:00:30",
    "ShutdownTimeout": "00:00:30",
    "BacklogDegradedAfter": "00:10:00"
  },
  "DeploymentLocationReconciliation": {
    "Enabled": true,
    "WorkerId": "logic-host-deployment-location-reconciliation",
    "CaptureBatchSize": 250,
    "SchedulingBatchSize": 25,
    "PollInterval": "00:00:01",
    "LeaseDuration": "00:02:00",
    "InitialRetryDelay": "00:00:01",
    "MaximumRetryDelay": "00:05:00",
    "BacklogDegradedAfter": "00:10:00"
  },
  "CentralTransient": {
    "Mode": "Off",
    "SourceRole": "Raw",
    "WindowTimeout": "00:05:00",
    "MaximumAdjacentStartInterval": "00:00:30",
    "MaximumAssociationTimeGap": "00:00:05",
    "MaximumAssociationEndpointGapPixels": 8,
    "MinimumAssociationAlignmentCosine": 0.85,
    "StarMaximumMagnitude": 6.5,
    "StarMaximumResults": 2000,
    "StarSourceSupportRadiusPixels": 1,
    "Extraction": {
      "MinimumResidualAdu": 1,
      "MinimumComponentPixels": 2,
      "MinimumIntegratedSignalAdu": 2,
      "MaximumCandidates": 32,
      "ProfileSampleCount": 8,
      "MaximumSaturationBridgePixels": 256,
      "MaximumForegroundPixels": 100000,
      "MaximumFragmentGapPixels": 3,
      "MinimumFragmentAlignmentCosine": 0.85
    },
    "Assessment": {
      "MinimumMeteorLengthPixels": 2.5,
      "MinimumMeteorElongation": 1.3,
      "MaximumMeteorMeanWidthPixels": 10,
      "CompactSensorMaximumLengthPixels": 2.5,
      "SensorArtifactMaximumMeanWidthPixels": 1.8,
      "StationaryMaximumDisplacementPixels": 0.5,
      "EnvironmentalMinimumMeanWidthPixels": 12,
      "FireballMinimumIntegratedSignalAdu": 100000,
      "FlareMinimumPeakToEndpointRatio": 3,
      "PersistentTrackMinimumObservations": 3,
      "AircraftMinimumBrightnessRatio": 3,
      "AircraftMinimumIntegratedSignalAdu": 1000,
      "SmoothMotionMaximumTurnDegrees": 180,
      "SmoothMotionMaximumStepRatio": 10
    }
  },
  "CentralTransientNotification": {
    "PollInterval": "00:00:01",
    "FenceTimeout": "00:01:00"
  },
  "TransientPayloadRelease": {
    "Enabled": false,
    "PollInterval": "00:00:05",
    "ReservationLeaseTimeout": "00:01:00",
    "InitialRetryDelay": "00:00:05",
    "MaximumRetryDelay": "00:05:00",
    "MaximumRetryCount": 5
  },
  "FleetStatus": {
    "RecommendedHeartbeatSeconds": 60,
    "FreshSeconds": 150,
    "OfflineSeconds": 300,
    "ClockToleranceSeconds": 120,
    "ReceiptRetentionHours": 24,
    "SnapshotRetentionDays": 30
  },
  "EnvironmentalObservations": {
    "ClockToleranceSeconds": 120,
    "ReceiptRetentionDays": 365,
    "RetentionSweepSeconds": 3600,
    "RetentionBatchSize": 1000,
    "MaximumQueryRangeDays": 31,
    "MaximumQueryResults": 500,
    "MaximumCorrelationStalenessDays": 7
  },
  "Catalog": {
    "Root": "",
    "RequiredCatalogId": "hyg-v42-production",
    "RequiredPackageKind": "Production"
  },
  "Observability": {
    "Service": {
      "Name": "LogicHost",
      "InstanceId": "logic-host"
    }
  },
  "AllowedHosts": "*"
}
