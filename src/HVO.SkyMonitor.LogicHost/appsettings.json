{
  "ConnectionStrings": {
    "skymonitordb": "",
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Telemetry": {
    "ServiceName": "hvo-skymonitor",
    "ActivitySources": [ "HVO.Enterprise.Telemetry", "HVO.SkyMonitor.LogicHost" ]
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "skymonitor:"
  },
  "Minio": {
    "Endpoint": "localhost",
    "Port": 9000,
    "UseSsl": false,
    "AccessKey": "",
    "SecretKey": "",
    "DefaultBucket": "skymonitor-diagnostics"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "From": "no-reply@skymonitor.local",
    "FromDisplayName": "SkyMonitor",
    "Username": "",
    "Password": ""
  },
  "CentralIdentity": {
    "ServiceUrl": "https://localhost:7096",
    "Mode": "ClientCredentials",
    "ClientCredentials": {
      "ClientId": "logic-host",
      "ClientSecret": "",
      "Scopes": [
        "api.admin",
        "api.camera",
        "api.frames",
        "api.images"
      ]
    },
    "InteractiveClient": {
      "ClientId": "logic-host-interactive",
      "ClientSecret": "",
      "PublicAuthority": "https://localhost:7096",
      "Scopes": [
        "openid",
        "profile",
        "email",
        "api.admin"
      ],
      "CallbackPath": "/signin-central",
      "SignedOutCallbackPath": "/signout-callback-central",
      "RemoteSignOutPath": "/signout-central"
    },
    "TokenCacheDurationSeconds": 300,
    "TokenRefreshWindowSeconds": 60
  },
  "DeviceBootstrap": {
    "CentralIdentity": {
      "ServiceUrl": "https://localhost:7096",
      "Mode": "ClientCredentials",
      "ClientCredentials": {
        "ClientId": "system-camera-agent",
        "ClientSecret": "",
        "Scopes": [
          "api.camera",
          "api.frames",
          "api.images"
        ]
      },
      "TokenCacheDurationSeconds": 300,
      "TokenRefreshWindowSeconds": 60
    }
  },
  "CentralDerivativeWorker": {
    "Enabled": true,
    "WorkerId": "logic-host-derivative-worker",
    "Concurrency": 1,
    "PollInterval": "00:00:01",
    "QueueSampleInterval": "00:00:10",
    "LeaseDuration": "00:02:00",
    "RenewalInterval": "00:00:30",
    "ShutdownTimeout": "00:00:30",
    "BacklogDegradedAfter": "00:10:00"
  },
  "Catalog": {
    "Root": "",
    "RequiredPackageKind": "Production"
  },
  "Observability": {
    "Service": {
      "Name": "LogicHost",
      "InstanceId": "logic-host"
    }
  },
  "AllowedHosts": "*"
}
