@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<header>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar shadow-sm">
        <div class="container-fluid align-items-center px-3 px-lg-4">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <i class="bi bi-stars"></i>
                <span>HVO SkyMonitor</span>
                <span class="text-muted small">Dashboard</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNav"
                aria-controls="primaryNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse py-3 py-lg-0" id="primaryNav">
                <div class="nav-badge-bar me-auto">
                    @foreach (var link in PrimaryNavigationLinks)
                    {
                        <NavLink class="nav-badge" href="@link.Href" Match="@link.Match">
                            <i class="@($"{link.IconClass} nav-badge__icon")"></i>
                            <span>@link.Label</span>
                        </NavLink>
                    }
                </div>

                <div class="nav-toolbar d-flex align-items-center gap-3 mt-3 mt-lg-0 ms-lg-4">
                    <div class="nav-actions d-flex align-items-center gap-2">
                        @foreach (var action in AuxiliaryActions)
                        {
                            <button type="button" class="nav-icon-button" title="@action.Tooltip"
                                aria-label="@action.Tooltip">
                                <i class="@action.IconClass"></i>
                            </button>
                        }
                    </div>

                    <AuthorizeView Context="authState">
                        <Authorized>
                            <div class="nav-account-info d-flex align-items-center gap-2 dropdown">
                                <button class="nav-avatar-button dropdown-toggle d-flex align-items-center gap-2"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                    <span class="nav-avatar">@GetUserInitials(authState.User)</span>
                                    <span class="nav-account-details text-start">
                                        <span class="nav-account-name">@GetUserDisplayName(authState.User)</span>
                                        <span class="nav-account-email text-muted small">@GetUserEmail(authState.User)</span>
                                    </span>
                                </button>

                                <ul class="dropdown-menu nav-account-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" href="Account/Manage">
                                            <i class="bi bi-person-badge"></i>
                                            Account Management
                                        </a>
                                    </li>
                                    <li>
                                        <form class="nav-logout-form" action="Account/Logout" method="post">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="returnUrl" value="@CurrentReturnUrl" />
                                            <button type="submit" class="dropdown-item nav-logout-button">
                                                <i class="bi bi-box-arrow-right"></i>
                                                Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <a class="nav-login-pill" href="Account/Login">
                                <i class="bi bi-box-arrow-in-right"></i>
                                Sign In
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </nav>
</header>