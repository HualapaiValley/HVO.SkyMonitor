@page "/devices"
@using HVO.SkyMonitor.Common.Security
@using HVO.SkyMonitor.LogicHost.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@attribute [Authorize(Policy = AuthorizationPolicyNames.ApiKeyOrCookie)]

<PageTitle>Device Registrations</PageTitle>

<div class="container py-4 device-registrations">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center mb-4 gap-3">
        <div>
            <h1 class="h3 mb-1">Device Registrations</h1>
            <p class="text-muted mb-0">Track pending camera agents and issue envelopes for operators.</p>
        </div>
        <div class="ms-lg-auto d-flex gap-2">
            <NavLink class="btn btn-primary" href="/devices/register">
                <i class="bi bi-plus-circle me-1"></i>
                Register Device
            </NavLink>
            <button type="button" class="btn btn-outline-secondary" disabled="@IsLoading" @onclick="ReloadAsync">
                <i class="bi bi-arrow-repeat me-1"></i>
                Refresh
            </button>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body d-flex flex-column flex-lg-row gap-3 align-items-lg-end">
            <div class="flex-grow-1">
                <label for="status-filter" class="form-label">Status filter</label>
                <select id="status-filter" class="form-select" @bind="StatusFilterValue">
                    <option value="">All statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="Active">Active</option>
                    <option value="Revoked">Revoked</option>
                </select>
            </div>
            <div class="form-check form-switch ms-lg-auto">
                <input id="hide-revoked" class="form-check-input" type="checkbox" role="switch" @bind="hideRevoked" />
                <label class="form-check-label" for="hide-revoked">Hide revoked registrations</label>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(LoadError))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-octagon me-2"></i>
            @LoadError
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(DeleteSuccess))
    {
        <div class="alert alert-success" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @DeleteSuccess
        </div>
    }

    @if (IsLoading)
    {
        <div class="text-muted">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
            Loading registrations...
        </div>
    }
    else
    {
        var filteredRegistrations = FilterRegistrations();
        if (Registrations.Count == 0)
        {
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle me-2"></i>
                No devices have started registration yet.
            </div>
        }
        else if (filteredRegistrations.Count == 0)
        {
            <div class="alert alert-info" role="alert">
                <i class="bi bi-funnel me-2"></i>
                No registrations match the current filters.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Device</th>
                        <th scope="col">Observatory</th>
                        <th scope="col">Owner</th>
                        <th scope="col">Status</th>
                        <th scope="col">Issued</th>
                        <th scope="col">Last Seen</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var registration in filteredRegistrations)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@registration.FriendlyName</div>
                                <div class="mono text-muted">@registration.DeviceId</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@registration.ObservatoryName</div>
                                <div class="text-muted small">Lat @FormatCoordinate(registration.ObservatoryLatitudeDegrees) / Lon @FormatCoordinate(registration.ObservatoryLongitudeDegrees)</div>
                                <div class="text-muted small">Elev @FormatElevation(registration.ObservatoryElevationMeters) m · TZ @registration.ObservatoryTimeZoneId</div>
                                <div class="mono text-muted small">@registration.ObservatoryId</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@registration.OwnerDisplayName</div>
                                <div class="text-muted small">@FormatOwnerEmail(registration.OwnerEmail)</div>
                                <div class="text-muted small">@FormatOwnerConfirmation(registration)</div>
                            </td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(registration.Status)">@registration.Status</span>
                            </td>
                            <td>@FormatTimestamp(registration.IssuedAtUtc)</td>
                            <td>@FormatTimestamp(registration.LastSeenUtc)</td>
                            <td class="text-end">
                                @if (registration.Status == DeviceRegistrationStatus.Pending)
                                {
                                    <button type="button" class="btn btn-primary btn-sm"
                                        disabled="@IsEnvelopeBusy(registration.RegistrationId)"
                                        @onclick="() => IssueEnvelopeAsync(registration)">
                                        @if (IsEnvelopeBusy(registration.RegistrationId))
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        <i class="bi bi-qr-code me-1"></i>
                                        Issue Envelope
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">--</span>
                                }

                                @if (registration.Status != DeviceRegistrationStatus.Revoked)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm ms-2"
                                        disabled="@IsDeleteBusy(registration.RegistrationId)"
                                        @onclick="() => BeginDelete(registration)">
                                        @if (IsDeleteBusy(registration.RegistrationId))
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        <i class="bi bi-trash me-1"></i>
                                        Delete
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                </table>
            </div>
        }
    }

    @if (!string.IsNullOrWhiteSpace(EnvelopeError))
    {
        <div class="alert alert-warning mt-4" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @EnvelopeError
        </div>
    }

    @if (ActiveEnvelope is not null)
    {
        <div class="card envelope-card mt-4">
            <div class="card-header d-flex flex-column flex-lg-row gap-3 align-items-lg-center">
                <div>
                    <h2 class="h5 mb-1">Envelope Ready</h2>
                    <p class="text-muted mb-0">Provide this payload to the operator within
                        @FormatRelativeDuration(ActiveEnvelope.ExpiresAtUtc).</p>
                </div>
                <div class="ms-lg-auto text-lg-end">
                    <div class="small text-muted">Expires</div>
                    <div>@FormatTimestamp(ActiveEnvelope.ExpiresAtUtc)</div>
                </div>
            </div>
            <div class="card-body">
                <dl class="row mb-3">
                    <dt class="col-sm-3 col-lg-2">Device</dt>
                    <dd class="col-sm-9 col-lg-4 mono">@ActiveEnvelope.DeviceId</dd>
                    <dt class="col-sm-3 col-lg-2">Registration</dt>
                    <dd class="col-sm-9 col-lg-4 mono">@ActiveEnvelope.RegistrationId</dd>
                </dl>
                <div class="d-flex flex-column flex-lg-row gap-3">
                    <textarea class="form-control envelope-text" rows="6" readonly>@ActiveEnvelope.Envelope</textarea>
                    <div class="d-flex flex-column gap-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CopyEnvelopeAsync">
                            <i class="bi bi-clipboard me-1"></i>
                            Copy Envelope
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ClearEnvelope">
                            <i class="bi bi-x-circle me-1"></i>
                            Dismiss
                        </button>
                    </div>
                </div>
                <p class="text-muted small mt-3 mb-0">
                    Keep this envelope offline; anyone with access can bootstrap the device until it expires.
                </p>
            </div>
        </div>
    }

    @if (DeleteTarget is not null)
    {
        <div class="card delete-card mt-4">
            <div class="card-header d-flex flex-column flex-lg-row gap-3 align-items-lg-center">
                <div>
                    <h2 class="h5 mb-1">Confirm Deletion</h2>
                    <p class="text-muted mb-0">This action immediately revokes access and cannot be undone.</p>
                </div>
                <div class="ms-lg-auto text-lg-end">
                    <div class="small text-muted">Device</div>
                    <div class="mono">@DeleteTarget.DeviceId</div>
                </div>
            </div>
            <div class="card-body">
                <p class="mb-3">Type the device ID (<span class="mono">@DeleteTarget.DeviceId</span>) to confirm deletion.</p>
                @if (!string.IsNullOrWhiteSpace(DeleteError))
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        @DeleteError
                    </div>
                }
                <div class="mb-3">
                    <label for="delete-confirmation" class="form-label">Device ID confirmation</label>
                    <input id="delete-confirmation" type="text" class="form-control"
                        placeholder="Type the device identifier"
                        autocomplete="off"
                        @bind="DeleteConfirmation"
                        @bind:event="oninput" />
                </div>
                <div class="d-flex flex-column flex-lg-row gap-2">
                    <button type="button" class="btn btn-danger"
                        disabled="@(!CanConfirmDeletion || IsDeleteBusy(DeleteTarget.RegistrationId))"
                        @onclick="ConfirmDeleteAsync">
                        <i class="bi bi-trash me-1"></i>
                        Permanently Delete
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete">
                        <i class="bi bi-x-circle me-1"></i>
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }
</div>