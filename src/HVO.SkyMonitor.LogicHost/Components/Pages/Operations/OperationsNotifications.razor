@page "/app/notifications"
@attribute [Authorize(Policy = HVO.SkyMonitor.Common.Security.AuthorizationPolicyNames.InteractiveUser)]

<PageTitle>Notifications | Network Operations</PageTitle>
<header class="mb-4"><p class="text-uppercase text-info small fw-bold mb-1">Personal network</p><h1>Subscriptions and notifications</h1><p class="text-muted">Choose how released verified events appear in your account.</p></header>
@if (IsLoading)
{
    <div class="card"><div class="card-body" role="status">Loading notification settings...</div></div>
}
else
{
    @if (StatusMessage is not null) { <div class="alert alert-info" role="status">@StatusMessage</div> }
    <section class="card mb-4" aria-labelledby="subscriptionHeading"><div class="card-body"><h2 id="subscriptionHeading" class="h5">Verified event subscription</h2><div class="form-check form-switch mb-3"><input id="verifiedSubscription" class="form-check-input" type="checkbox" @bind="IsSubscribed" /><label class="form-check-label" for="verifiedSubscription">Notify me when a verified event is publicly released</label></div><div class="form-check mb-2"><input id="inAppPreference" class="form-check-input" type="checkbox" @bind="InAppEnabled" /><label class="form-check-label" for="inAppPreference">In-app notifications</label></div><div class="form-check mb-3"><input id="emailPreference" class="form-check-input" type="checkbox" @bind="EmailEnabled" /><label class="form-check-label" for="emailPreference">Email preference (delivery activation is deferred)</label></div><button class="btn btn-primary" disabled="@IsBusy" @onclick="SaveAsync">Save preferences</button></div></section>
    <section aria-labelledby="notificationHeading"><h2 id="notificationHeading" class="h4">Recent notifications</h2>@if (Notifications.Count == 0) { <div class="card"><div class="card-body text-muted">No notifications yet.</div></div> } else { <div class="list-group">@foreach (var item in Notifications) { <button class="list-group-item list-group-item-action d-flex justify-content-between gap-3" disabled="@item.IsRead" @onclick="() => MarkReadAsync(item.Id)"><span><strong>@item.Title</strong><small class="d-block text-muted">@item.CreatedUtc.ToString("u")</small></span><span class="badge @(item.IsRead ? "text-bg-secondary" : "text-bg-info")">@(item.IsRead ? "Read" : "New")</span></button> }</div> }</section>
}
