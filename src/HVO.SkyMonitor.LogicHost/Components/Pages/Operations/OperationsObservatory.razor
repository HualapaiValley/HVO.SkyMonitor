@page "/app/observatories/{ObservatoryId:guid}"
@attribute [Authorize(Policy = HVO.SkyMonitor.Common.Security.AuthorizationPolicyNames.InteractiveUser)]

<PageTitle>@(Item?.Name ?? "Observatory") | Network Operations</PageTitle>
@if(Detail?.CamerasNextCursor is not null){<button class="btn btn-outline-light mb-3 me-2" disabled="@IsLoadingMoreCameras" @onclick="LoadMoreCamerasAsync">@(IsLoadingMoreCameras ? "Loading..." : "Load more cameras")</button>}
@if(Detail?.RegistrationsNextCursor is not null){<button class="btn btn-outline-light mb-3" disabled="@IsLoadingMoreRegistrations" @onclick="LoadMoreRegistrationsAsync">@(IsLoadingMoreRegistrations ? "Loading..." : "Load more registrations")</button>}
@if(Item is null){<div class="alert alert-warning">Observatory not found or access was removed.</div>}
else{<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><span class="badge text-bg-secondary">@Item.Role</span><h1 class="mt-2">@Item.Name</h1><p class="text-muted">Central operational state; CameraAgent-owned capture settings remain read-only here.</p></div><div class="d-flex gap-2"><a class="btn btn-primary" href="@($"app/captures?observatoryId={Item.ObservatoryId:D}")">Browse captures</a>@if(Item.Role==HVO.SkyMonitor.LogicHost.Data.ObservatoryMembershipRole.Owner){<a class="btn btn-outline-light" href="@($"app/observatories/{Item.ObservatoryId:D}/publication")">Publication</a><a class="btn btn-outline-light" href="@($"app/observatories/{Item.ObservatoryId:D}/members")">Members</a>}</div></div><div class="row g-3 mb-4"><div class="col-sm-6 col-xl-3"><div class="card"><div class="card-body"><small class="text-muted">Logical cameras</small><strong class="d-block fs-3">@Item.LogicalCameraCount</strong></div></div></div><div class="col-sm-6 col-xl-3"><div class="card"><div class="card-body"><small class="text-muted">Installations</small><strong class="d-block fs-3">@Item.ActiveInstallationCount</strong></div></div></div><div class="col-sm-6 col-xl-3"><div class="card"><div class="card-body"><small class="text-muted">Location review</small><strong class="d-block fs-3">@Item.PendingDeploymentCount</strong></div></div></div><div class="col-sm-6 col-xl-3"><div class="card"><div class="card-body"><small class="text-muted">Active jobs</small><strong class="d-block fs-3">@Item.ActiveJobCount</strong></div></div></div></div><div class="row g-4"><section class="col-xl-7" aria-labelledby="fleetHeading"><div class="card h-100"><div class="card-body"><h2 id="fleetHeading" class="h4">Camera fleet</h2>@if(Detail!.Cameras.Count==0){<p class="text-muted">No logical cameras.</p>}else{<div class="list-group list-group-flush">@foreach(var camera in Detail.Cameras){<a class="list-group-item list-group-item-action px-0" href="@($"app/cameras/{camera.LogicalCameraId:D}")"><span class="d-flex justify-content-between gap-2"><strong>@camera.Name</strong><span class="badge text-bg-secondary">@(camera.ReportedHealth?.ToString() ?? "Disconnected")</span></span><small class="d-block text-muted">@(camera.InstallationName ?? "No active installation") - @(camera.ObservedAtUtc?.ToString("u") ?? "No heartbeat")</small>@if(camera.HasStoragePressure||camera.HasRequiredLaneFailure||camera.HasQuarantine){<small class="d-block text-warning">Attention: @(camera.HasStoragePressure ? "storage pressure " : "")@(camera.HasRequiredLaneFailure ? "lane failure " : "")@(camera.HasQuarantine ? "quarantine" : "")</small>}</a>}</div>}</div></div></section><section class="col-xl-5" aria-labelledby="environmentHeading"><div class="card h-100"><div class="card-body"><h2 id="environmentHeading" class="h4">Weather and cloud</h2>@if(Detail.Environment.Count==0){<p class="text-muted">No current environmental observations.</p>}else{<dl>@foreach(var observation in Detail.Environment){<div class="d-flex justify-content-between border-bottom py-2"><dt>@observation.Kind</dt><dd class="mb-0 text-end">@(observation.NumericValue?.ToString("0.##") ?? observation.BooleanValue?.ToString() ?? "Unknown") @observation.Unit<small class="d-block @(observation.StaleAfterUtc < DateTimeOffset.UtcNow ? "text-warning" : "text-muted")">@(observation.StaleAfterUtc < DateTimeOffset.UtcNow ? "Stale" : observation.Quality.ToString()) - @observation.ObservedAtUtc.ToString("u")</small></dd></div>}</dl>}</div></div></section></div>}
