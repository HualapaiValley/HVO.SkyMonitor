@page "/app/cameras/{CameraId:guid}"
@attribute [Authorize(Policy = HVO.SkyMonitor.Common.Security.AuthorizationPolicyNames.InteractiveUser)]

<PageTitle>@(Camera?.Name ?? "Logical Camera") | Network Operations</PageTitle>
<header class="mb-4"><p class="text-uppercase text-info small fw-bold mb-1">Stable logical camera</p><h1>@(Camera?.Name ?? "Camera timeline")</h1><p class="text-muted">Captures remain attached across immutable CameraAgent installation replacements.</p></header>
@if(Camera?.InstallationsNextCursor is not null){<button class="btn btn-outline-light mb-3" disabled="@IsLoadingMoreInstallations" @onclick="LoadMoreInstallationsAsync">@(IsLoadingMoreInstallations ? "Loading..." : "Load more installations")</button>}
@if(Camera is null){<div class="alert alert-warning">Camera not found or access was removed.</div>}
else{<section class="card mb-4" aria-labelledby="installationHeading"><div class="card-body"><h2 id="installationHeading" class="h4">Installation history</h2><p>@Camera.Description</p>@if(Camera.Installations.Count==0){<p class="text-muted">No CameraAgent installation has been assigned.</p>}else{<div class="list-group list-group-flush">@foreach(var installation in Camera.Installations){<div class="list-group-item px-0"><span class="d-flex justify-content-between gap-2"><strong>@installation.InstallationName</strong><span class="badge @(installation.RetiredAtUtc is null ? "text-bg-success" : "text-bg-secondary")">@(installation.RetiredAtUtc is null ? installation.RegistrationStatus : "Retired")</span></span><small class="d-block text-muted">Installed @installation.AssignedAtUtc.ToString("u") - identity @installation.InstallationPublicId</small>@if(installation.RetiredAtUtc is not null){<small class="d-block text-muted">Retired @installation.RetiredAtUtc.Value.ToString("u") (@installation.RetirementReasonCode)</small>}</div>}</div>}</div></section><section aria-labelledby="captureHeading"><h2 id="captureHeading" class="h4">Capture timeline</h2>@if(Items.Count==0){<div class="alert alert-secondary">No captures are retained for this camera.</div>}else{<div class="list-group">@foreach(var item in Items){<a class="list-group-item list-group-item-action" href="@($"app/captures/{item.CaptureId:D}")"><strong>@item.CapturedAtUtc.ToString("u")</strong><span class="d-block text-muted">@item.ObservatoryName - @item.ArtifactCount artifact(s)</span></a>}</div>@if(NextCursor is not null){<button class="btn btn-outline-light mt-3" disabled="@IsLoadingMore" @onclick="LoadMoreAsync">@(IsLoadingMore ? "Loading..." : "Load more captures")</button>}}</section>}
