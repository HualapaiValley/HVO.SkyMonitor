@page "/app/observatories/{ObservatoryId:guid}/members"
@attribute [Authorize(Policy = HVO.SkyMonitor.Common.Security.AuthorizationPolicyNames.InteractiveUser)]

<PageTitle>Members | Network Operations</PageTitle>
<header class="mb-4"><p class="text-uppercase text-info small fw-bold mb-1">Observatory authority</p><h1>Members and invitations</h1><p class="text-muted">Roles apply to the whole observatory. The final Owner cannot be removed.</p></header>
@if(ErrorMessage is not null){<div class="alert alert-warning">@ErrorMessage</div>}
@if(AcceptanceToken is not null){<div class="alert alert-info"><strong>Invitation created.</strong> Share this one-time acceptance token through an approved private channel.<code class="d-block text-break mt-2">@AcceptanceToken</code></div>}
@if(MembersNextCursor is not null){<button class="btn btn-outline-light mb-3 me-2" disabled="@IsLoadingMoreMembers" @onclick="LoadMoreMembersAsync">@(IsLoadingMoreMembers ? "Loading..." : "Load more members")</button>}
@if(InvitationsNextCursor is not null){<button class="btn btn-outline-light mb-3" disabled="@IsLoadingMoreInvitations" @onclick="LoadMoreInvitationsAsync">@(IsLoadingMoreInvitations ? "Loading..." : "Load more invitations")</button>}
<div class="row g-4"><div class="col-lg-7"><div class="card"><div class="card-body"><h2 class="h5">Current members</h2>@if(Members.Count==0){<p class="text-muted">No membership data is available.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>User</th><th>Role</th><th>Added</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody>@foreach(var member in Members){<tr><td>@(member.Email ?? member.UserId)</td><td><span class="badge text-bg-secondary">@member.Role</span></td><td>@member.AddedAtUtc.ToString("u")</td><td><div class="btn-group btn-group-sm" role="group" aria-label="Change role for @(member.Email ?? member.UserId)"><button class="btn btn-outline-light" disabled="@(IsBusy || member.Role == HVO.SkyMonitor.LogicHost.Data.ObservatoryMembershipRole.Viewer)" @onclick="() => SetRoleAsync(member.UserId, HVO.SkyMonitor.LogicHost.Data.ObservatoryMembershipRole.Viewer)">Viewer</button><button class="btn btn-outline-light" disabled="@(IsBusy || member.Role == HVO.SkyMonitor.LogicHost.Data.ObservatoryMembershipRole.Manager)" @onclick="() => SetRoleAsync(member.UserId, HVO.SkyMonitor.LogicHost.Data.ObservatoryMembershipRole.Manager)">Manager</button><button class="btn btn-outline-light" disabled="@(IsBusy || member.Role == HVO.SkyMonitor.LogicHost.Data.ObservatoryMembershipRole.Owner)" @onclick="() => SetRoleAsync(member.UserId, HVO.SkyMonitor.LogicHost.Data.ObservatoryMembershipRole.Owner)">Owner</button><button class="btn btn-outline-danger" disabled="@IsBusy" @onclick="() => RemoveAsync(member.UserId)">Remove</button></div></td></tr>}</tbody></table></div>}</div></div></div><div class="col-lg-5"><div class="card mb-4"><div class="card-body"><h2 class="h5">Invite registered user</h2><p class="small text-muted">An invitation grants no access until the target accepts it.</p><div class="mb-3"><label class="form-label" for="targetUser">Target user ID</label><input id="targetUser" class="form-control" @bind="TargetUserId" /></div><div class="mb-3"><label class="form-label" for="offeredRole">Role</label><select id="offeredRole" class="form-select" @bind="OfferedRole"><option value="Viewer">Viewer</option><option value="Manager">Manager</option><option value="Owner">Owner</option></select></div><button class="btn btn-primary" disabled="@IsBusy" @onclick="IssueAsync">@(IsBusy ? "Creating..." : "Create invitation")</button></div></div><div class="card"><div class="card-body"><h2 class="h5">Pending invitations</h2>@if(PendingInvitations.Count==0){<p class="text-muted mb-0">No pending invitations.</p>}else{<div class="list-group list-group-flush">@foreach(var invitation in PendingInvitations){<div class="list-group-item px-0 d-flex justify-content-between gap-2"><span><strong>@(invitation.TargetEmail ?? invitation.TargetUserId)</strong><small class="d-block text-muted">@invitation.OfferedRole - expires @invitation.ExpiresAtUtc.ToString("u")</small></span><button class="btn btn-sm btn-outline-danger" disabled="@IsBusy" @onclick="() => RevokeAsync(invitation.InvitationId)">Revoke</button></div>}</div>}</div></div></div></div>
