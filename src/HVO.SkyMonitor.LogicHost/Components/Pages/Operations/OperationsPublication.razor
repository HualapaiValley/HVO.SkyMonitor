@page "/app/observatories/{ObservatoryId:guid}/publication"
@attribute [Authorize(Policy = HVO.SkyMonitor.Common.Security.AuthorizationPolicyNames.InteractiveUser)]

<PageTitle>Publication | Network Operations</PageTitle>
@if(Detail?.CamerasNextCursor is not null){<button class="btn btn-outline-light mb-3 me-2" disabled="@IsLoadingMoreCameras" @onclick="LoadMoreCamerasAsync">@(IsLoadingMoreCameras ? "Loading..." : "Load more cameras")</button>}
@if(Detail?.RegistrationsNextCursor is not null){<button class="btn btn-outline-light mb-3" disabled="@IsLoadingMoreRegistrations" @onclick="LoadMoreRegistrationsAsync">@(IsLoadingMoreRegistrations ? "Loading..." : "Load more registrations")</button>}
<header class="mb-4"><p class="text-uppercase text-info small fw-bold mb-1">Owner authority</p><h1>Publication and logical cameras</h1><p class="text-muted">Public visibility, location precision, record release, and operational membership remain independent decisions.</p></header>
@if (IsLoading)
{
    <div class="alert alert-secondary" role="status">Loading publication authority...</div>
}
else if (Settings is null || Detail is null)
{
    <div class="alert alert-warning">Owner authority is required or the observatory was not found.</div>
}
else
{
    @if (StatusMessage is not null) { <div class="alert alert-info" role="status">@StatusMessage</div> }
    <div class="row g-4">
        <section class="col-xl-6" aria-labelledby="profileHeading"><div class="card h-100"><div class="card-body"><h2 id="profileHeading" class="h4">Public profile</h2><div class="mb-3"><label class="form-label" for="publicSlug">Public slug</label><input id="publicSlug" class="form-control" @bind="PublicSlug" /></div><div class="mb-3"><label class="form-label" for="publicName">Display name</label><input id="publicName" class="form-control" @bind="PublicDisplayName" /></div><div class="mb-3"><label class="form-label" for="publicDescription">Description</label><textarea id="publicDescription" class="form-control" rows="4" @bind="PublicDescription"></textarea></div><div class="form-check form-switch mb-2"><input id="profilePublic" class="form-check-input" type="checkbox" @bind="IsPublic" /><label class="form-check-label" for="profilePublic">List this observatory publicly</label></div><div class="form-check mb-2"><input id="environmentPublic" class="form-check-input" type="checkbox" @bind="PublishEnvironmentalSummary" /><label class="form-check-label" for="environmentPublic">Publish an allowlisted environmental summary</label></div><div class="form-check mb-3"><input id="automaticEvents" class="form-check-input" type="checkbox" @bind="AllowAutomaticEvents" /><label class="form-check-label" for="automaticEvents">Allow automatic verified-event inclusion on home</label></div><button class="btn btn-primary" disabled="@IsBusy" @onclick="SaveProfileAsync">Save public profile</button></div></div></section>
        <section class="col-xl-6" aria-labelledby="locationHeading"><div class="card h-100"><div class="card-body"><h2 id="locationHeading" class="h4">Public location</h2><p class="text-muted small">Approximate coordinates are derived server-side from the authoritative location and coarsened to at least 25 km. Exact coordinates cannot be published here.</p><div class="mb-3"><label class="form-label" for="disclosureLevel">Disclosure</label><select id="disclosureLevel" class="form-select" @bind="DisclosureLevel"><option value="Hidden">Hidden</option><option value="Region">Region only</option><option value="Approximate">Approximate</option></select></div>@if(DisclosureLevel != HVO.SkyMonitor.LogicHost.Data.ObservatoryLocationDisclosureLevel.Hidden){<div class="mb-3"><label class="form-label" for="regionCode">Region code</label><input id="regionCode" class="form-control" @bind="RegionCode" /></div><div class="mb-3"><label class="form-label" for="regionLabel">Region label</label><input id="regionLabel" class="form-control" @bind="RegionLabel" /></div>}@if(DisclosureLevel == HVO.SkyMonitor.LogicHost.Data.ObservatoryLocationDisclosureLevel.Approximate){<div class="mb-3"><label class="form-label" for="precisionMeters">Minimum precision (meters)</label><input id="precisionMeters" class="form-control" type="number" min="25000" step="1000" @bind="PrecisionMeters" /></div>}<button class="btn btn-primary" disabled="@IsBusy" @onclick="SaveLocationAsync">Save location disclosure</button></div></div></section>
        <section class="col-xl-6" aria-labelledby="cameraHeading"><div class="card h-100"><div class="card-body"><h2 id="cameraHeading" class="h4">Logical cameras</h2><div class="row g-2 mb-3"><div class="col-md-4"><label class="form-label" for="cameraSlug">Slug</label><input id="cameraSlug" class="form-control" @bind="NewCameraSlug" /></div><div class="col-md-4"><label class="form-label" for="cameraName">Name</label><input id="cameraName" class="form-control" @bind="NewCameraName" /></div><div class="col-md-4"><label class="form-label" for="cameraDescription">Description</label><input id="cameraDescription" class="form-control" @bind="NewCameraDescription" /></div></div><button class="btn btn-outline-info mb-4" disabled="@IsBusy" @onclick="CreateCameraAsync">Create logical camera</button>@if(Detail.Cameras.Count==0){<p class="text-muted">No logical cameras.</p>}else{<div class="list-group list-group-flush">@foreach(var camera in Detail.Cameras){<div class="list-group-item px-0"><span class="d-flex justify-content-between gap-2"><strong>@camera.Name</strong><span class="badge @(camera.IsPubliclyReleased ? "text-bg-success" : "text-bg-secondary")">@(camera.IsPubliclyReleased ? "Released" : "Private")</span></span><small class="d-block text-muted mb-2">@(camera.InstallationName ?? "No active installation")</small><div class="d-flex flex-wrap gap-2"><select class="form-select form-select-sm w-auto" value="" @onchange="args => AssignAsync(camera.LogicalCameraId, args.Value?.ToString())"><option value="">Assign installation...</option>@foreach(var registration in Detail.Registrations.Where(item => item.AssignedLogicalCameraId != camera.LogicalCameraId)){<option value="@registration.RegistrationId">@registration.FriendlyName</option>}</select><button class="btn btn-sm @(camera.IsPubliclyReleased ? "btn-outline-warning" : "btn-outline-success")" disabled="@IsBusy" @onclick="() => SetCameraReleaseAsync(camera.LogicalCameraId, !camera.IsPubliclyReleased)">@(camera.IsPubliclyReleased ? "Withdraw" : "Release")</button></div></div>}</div>}</div></div></section>
        <section class="col-xl-6" aria-labelledby="registrationHeading"><div class="card h-100"><div class="card-body"><h2 id="registrationHeading" class="h4">Active CameraAgent registrations</h2>@if(Detail.Registrations.Count==0){<p class="text-muted">No active registrations are available.</p>}else{<div class="list-group list-group-flush">@foreach(var registration in Detail.Registrations){<div class="list-group-item px-0 d-flex justify-content-between gap-2"><span><strong>@registration.FriendlyName</strong><small class="d-block text-muted">@registration.Status</small></span><span class="badge text-bg-secondary">@(registration.AssignedLogicalCameraId is null ? "Unassigned" : "Assigned")</span></div>}</div>}</div></div></section>
    </div>
}
