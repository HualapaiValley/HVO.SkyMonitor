@page "/observatories"
@attribute [Authorize]

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Observatories</h2>
        <button class="btn btn-primary" @onclick="NewObservatory">Add Observatory</button>
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="alert alert-info">@StatusMessage</div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    <div class="row">
        <div class="col-lg-7 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    @if (Observatories.Count == 0)
                    {
                        <p class="text-muted mb-0">No observatories found. Add one to begin pairing camera agents.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Location</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var observatory in Observatories)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@observatory.Name</div>
                                                <small class="text-muted">TZ: @observatory.TimeZoneId</small>
                                            </td>
                                            <td>
                                                <div>Lat @observatory.LatitudeDegrees.ToString("F4")</div>
                                                <div>Lon @observatory.LongitudeDegrees.ToString("F4")</div>
                                                <small class="text-muted">Elev @observatory.ElevationMeters.ToString("F0") m</small>
                                            </td>
                                            <td>
                                                <span class="badge @(observatory.IsActive ? "bg-success-subtle text-success" : "bg-secondary")">@(observatory.IsActive ? "Active" : "Inactive")</span>
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-link" @onclick="() => EditObservatory(observatory)">Edit</button>
                                                <button class="btn btn-link text-danger" @onclick="() => DeleteObservatoryAsync(observatory)" disabled="@IsBusy">Delete</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@FormTitle</h5>
                    <EditForm Model="FormModel" OnValidSubmit="OnValidSubmitAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="FormModel.Name" />
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Latitude (deg)</label>
                                <InputNumber class="form-control" @bind-Value="FormModel.LatitudeDegrees" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Longitude (deg)</label>
                                <InputNumber class="form-control" @bind-Value="FormModel.LongitudeDegrees" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Elevation (m)</label>
                            <InputNumber class="form-control" @bind-Value="FormModel.ElevationMeters" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Time Zone ID</label>
                            <InputText class="form-control" @bind-Value="FormModel.TimeZoneId" />
                        </div>
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox class="form-check-input" @bind-Value="FormModel.IsActive" />
                            <label class="form-check-label">Active</label>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button class="btn btn-outline-secondary" type="button" @onclick="NewObservatory">Cancel</button>
                            <button class="btn btn-primary" type="submit" disabled="@IsBusy">Save</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>