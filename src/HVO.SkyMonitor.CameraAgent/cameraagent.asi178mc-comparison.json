{
  "agentId": "replace-with-registered-device-id",
  "module": {
    "type": "VirtualSky",
    "options": {
      "seed": 2025,
      "rigProfileVersion": "virtual-asi178mc-fujinon-unverified-v5",
      "maximumMagnitude": 6.5,
      "maximumResults": 300,
      "magnitudeZeroElectronsPerSecond": 18000.0,
      "bortleClass": 3,
      "asi178Sensor": {
        "enabled": true,
        "blackLevelContainerAdu": 64.0
      },
      "constellationIds": ["UMA", "UMI", "CAS", "CYG", "LYR", "PEG", "AND"],
      "includeConstellationEndpointStars": true,
      "solarSystemBodies": ["Sun", "Moon", "Mercury", "Venus", "Mars", "Jupiter", "Saturn", "Uranus", "Neptune"]
    }
  },
  "rig": {
    "sensor": {
      "name": "VirtualAsi178McRaw16",
      "widthPixels": 3096,
      "heightPixels": 2080,
      "pixelSizeMicrons": 2.4,
      "colorMode": "Color",
      "pixelFormat": "BayerRggb16",
      "responseMode": "BayerRaw",
      "strideBytes": 6192,
      "byteOrder": "LittleEndian",
      "sensorRecipeVersion": "virtual-asi178mc-rggb16-v1"
    },
    "optics": {
      "projectionModel": "EquidistantFisheye",
      "focalLengthMillimeters": 1.8,
      "fieldOfViewDegrees": 185.0,
      "rollDegrees": 0.0,
      "lensKind": "Fisheye",
      "principalPointX": 1548.0,
      "principalPointY": 1040.0,
      "imageCircleRadiusPixels": 1187.5,
      "focalLengthXPixels": 735.553926,
      "focalLengthYPixels": 735.553926,
      "horizontalFlip": true,
      "calibrationVersion": "asi178-fujinon-fe185c057ha1-candidate-v4"
    },
    "orientation": {
      "boresightAltitudeDegrees": 90.0,
      "boresightAzimuthDegrees": 0.0,
      "rollAdjustmentDegrees": 0.0
    },
    "pipeline": {
      "captureInterval": "00:00:25",
      "dayExposure": "00:00:00.1000000",
      "nightExposure": "00:00:20",
      "dayGain": 0.0,
      "nightGain": 150.0
    },
    "controlPolicy": {
      "exposureControl": "Disabled",
      "gainControl": "Disabled"
    },
    "profileVersion": "virtual-asi178mc-fujinon-unverified-v5"
  },
  "pipeline": {
    "schemaVersion": "cameraagent-capture-pipeline-v2",
    "dependencyPolicy": "reject-enabled-dependent-v1",
    "steps": [{
      "id": "RollingCombination",
      "type": "RollingCombination",
      "order": 25,
      "dependsOn": ["$raw"],
      "options": {
        "windowSize": 5
      }
    },
    {
      "id": "Preview",
      "type": "Preview",
      "order": 50,
      "dependsOn": ["RollingCombination"],
      "options": {
        "recipeVersion": "bayer-rggb16-bilinear-asinh-v1",
        "blackPercentile": 0.5,
        "whitePercentile": 0.9999,
        "asinhStrength": 4.0
      }
    },
    {
      "id": "Annotation",
      "type": "Annotation",
      "order": 75,
      "dependsOn": ["Preview"],
      "options": {
        "markRadius": 6,
        "markerValue": 144,
        "drawLabels": true,
        "maximumLabelMagnitude": 2.5,
        "labelScale": 2,
        "drawConstellationLines": true,
        "constellationIds": ["UMA", "UMI", "CAS", "CYG", "LYR", "PEG", "AND"],
        "constellationLineValue": 160,
        "constellationLineRed": 96,
        "constellationLineGreen": 160,
        "constellationLineBlue": 255,
        "constellationLineThickness": 2,
        "constellationLineOpacity": 0.8,
        "drawImageCircle": true,
        "drawCardinalDirections": true,
        "imageCircleValue": 96,
        "cardinalValue": 255,
        "cardinalScale": 2,
        "recipeVersion": "named-object-rgb-compass-annotation-v3"
      }
    },
    {
      "id": "LocalStorage",
      "type": "Storage",
      "order": 100,
      "dependsOn": ["Annotation"],
      "options": {
        "storageRoot": "/workspaces/HVO.SkyMonitor/data/agent",
        "retentionDays": 7,
        "updateLatestFrame": true,
        "queueForUpload": false
      }
    },
    {
      "id": "Telemetry",
      "type": "Telemetry",
      "order": 1000,
      "dependsOn": ["RollingCombination", "Preview", "Annotation", "LocalStorage"]
    }]
  },
  "schedule": {
    "schemaVersion": "capture-schedule-v1",
    "setpointProfiles": [{ "id": "continuous", "exposure": "00:00:20", "gain": 150.0, "captureInterval": "00:00:25", "cadenceMode": "MinimumStartInterval" }],
    "weeklyWindows": [
      { "id": "continuous-sunday", "day": "Sunday", "start": { "kind": "FixedLocalTime", "localTime": "00:00:00" }, "end": { "kind": "FixedLocalTime", "localTime": "00:00:00", "dayOffset": 1 }, "setpointProfileId": "continuous" },
      { "id": "continuous-monday", "day": "Monday", "start": { "kind": "FixedLocalTime", "localTime": "00:00:00" }, "end": { "kind": "FixedLocalTime", "localTime": "00:00:00", "dayOffset": 1 }, "setpointProfileId": "continuous" },
      { "id": "continuous-tuesday", "day": "Tuesday", "start": { "kind": "FixedLocalTime", "localTime": "00:00:00" }, "end": { "kind": "FixedLocalTime", "localTime": "00:00:00", "dayOffset": 1 }, "setpointProfileId": "continuous" },
      { "id": "continuous-wednesday", "day": "Wednesday", "start": { "kind": "FixedLocalTime", "localTime": "00:00:00" }, "end": { "kind": "FixedLocalTime", "localTime": "00:00:00", "dayOffset": 1 }, "setpointProfileId": "continuous" },
      { "id": "continuous-thursday", "day": "Thursday", "start": { "kind": "FixedLocalTime", "localTime": "00:00:00" }, "end": { "kind": "FixedLocalTime", "localTime": "00:00:00", "dayOffset": 1 }, "setpointProfileId": "continuous" },
      { "id": "continuous-friday", "day": "Friday", "start": { "kind": "FixedLocalTime", "localTime": "00:00:00" }, "end": { "kind": "FixedLocalTime", "localTime": "00:00:00", "dayOffset": 1 }, "setpointProfileId": "continuous" },
      { "id": "continuous-saturday", "day": "Saturday", "start": { "kind": "FixedLocalTime", "localTime": "00:00:00" }, "end": { "kind": "FixedLocalTime", "localTime": "00:00:00", "dayOffset": 1 }, "setpointProfileId": "continuous" }
    ]
  }
}
