{
  "CameraAgent": {
    "ConfigFilePath": "cameraagent.sample.json",
    "RetentionSweepIntervalMinutes": 30,
    "Observatory": {
      "LatitudeDegrees": 21.3,
      "LongitudeDegrees": -157.8,
      "ElevationMeters": 400.0,
      "TimeZoneId": "Pacific/Honolulu"
    }
  },
  "CentralIdentity": {
    "ServiceUrl": "https://localhost:5174",
    "Mode": "ClientCredentials",
    "ClientCredentials": {
      "ClientId": "camera-agent",
      "ClientSecret": "dev-secret-change-in-production",
      "Scopes": [
        "api",
        "camera"
      ]
    },
    "TokenCacheDurationSeconds": 300,
    "TokenRefreshWindowSeconds": 60
  },
  "SkyMonitor": {
    "BaseUrl": "https://localhost:5174"
  },
  "CapturePreview": {
    "PollingIntervalSeconds": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}