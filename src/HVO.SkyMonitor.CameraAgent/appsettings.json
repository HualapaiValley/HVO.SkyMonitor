{
  "CameraAgent": {
    "ConfigFilePath": "cameraagent.sample.json",
    "RetentionSweepIntervalMinutes": 30,
    "DiskPressureThresholdPercent": 10,
    "DiskPressureRecoveryPercent": 15,
    "DiskPressureRetentionDays": 1,
    "UploadBatchSize": 10,
    "UploadPollIntervalSeconds": 10,
    "UploadRetryInitialDelaySeconds": 10,
    "UploadRetryMaximumDelaySeconds": 300,
    "UploadBandwidthLimitBytesPerSecond": 0,
    "Observatory": {
      "LatitudeDegrees": 35.5599378,
      "LongitudeDegrees": -113.9119818,
      "ElevationMeters": 520.0,
      "TimeZoneId": "America/Phoenix"
    }
  },
  "CentralIdentity": {
    "Mode": "ApiKey",
    "ApiKey": {
      "Key": "smk_camera-agent_local"
    }
  },
  "LocalIdentity": {
    "AdminEmail": "owner@cameraagent.local",
    "AdminPassword": "ChangeMeNow!123"
  },
  "SkyMonitor": {
    "BaseUrl": "http://logichost:8080"
  },
  "CapturePreview": {
    "PollingIntervalSeconds": 2
  },
  "Observability": {
    "Service": {
      "Name": "CameraAgent",
      "InstanceId": "camera-agent"
    }
  },
  "Telemetry": {
    "ServiceName": "hvo-camera",
    "ActivitySources": [ "HVO.Enterprise.Telemetry", "HVO.SkyMonitor.CameraAgent" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
