{
  "CentralIdentity": {
    "ServiceUrl": "https://localhost:5001",
    "Mode": "ClientCredentials",
    "ClientCredentials": {
      "ClientId": "camera-agent",
      "ClientSecret": "dev-secret-change-in-production",
      "Scopes": [
        "api",
        "camera"
      ]
    },
    "TokenCacheDurationSeconds": 300,
    "TokenRefreshWindowSeconds": 60
  },
  "SkyMonitor": {
    "BaseUrl": "https://localhost:5001"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}