@page "/Account/AccessDenied"

<PageTitle>Access denied</PageTitle>

<AccountShell Class="single">
    <header class="ops-page-heading">
        <div>
            <p class="eyebrow">Local owner</p>
            <h1>Access denied</h1>
        </div>
    </header>
    <div class="ops-note-banner failure">
        <span class="status-icon failure" aria-hidden="true"></span>
        <span>You do not have access to this resource.</span>
    </div>
    <div class="account-form-actions">
        <a class="button secondary" href="Account/Login">Return to login</a>
    </div>
</AccountShell>
