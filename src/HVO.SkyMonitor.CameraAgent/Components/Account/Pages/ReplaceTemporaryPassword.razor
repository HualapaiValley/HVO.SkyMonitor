@page "/Account/ReplaceTemporaryPassword"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Replace temporary password</PageTitle>

<AccountShell Class="single">
    <header class="ops-page-heading">
        <div>
            <p class="eyebrow">First sign-in</p>
            <h1>Replace temporary password</h1>
            <p>The temporary owner password must be replaced before CameraAgent operations are available.</p>
        </div>
    </header>
    <StatusMessage Message="@message" />
    <div class="ops-panel">
        <EditForm Model="Input" FormName="replace-temporary-password" OnValidSubmit="OnValidSubmitAsync" method="post" class="account-form">
            <DataAnnotationsValidator />
            <ValidationSummary role="alert" />
            <div class="ops-field">
                <label for="Input.CurrentPassword">Current password</label>
                <InputText type="password" @bind-Value="Input.CurrentPassword" id="Input.CurrentPassword"
                    autocomplete="current-password" aria-required="true" />
                <ValidationMessage For="() => Input.CurrentPassword" />
            </div>
            <div class="ops-field">
                <label for="Input.NewPassword">New password</label>
                <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword"
                    autocomplete="new-password" aria-required="true" />
                <ValidationMessage For="() => Input.NewPassword" />
            </div>
            <div class="ops-field">
                <label for="Input.ConfirmPassword">Confirm new password</label>
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword"
                    autocomplete="new-password" aria-required="true" />
                <ValidationMessage For="() => Input.ConfirmPassword" />
            </div>
            <div class="account-form-actions">
                <button type="submit" class="button primary">Replace password</button>
            </div>
        </EditForm>
    </div>
</AccountShell>
