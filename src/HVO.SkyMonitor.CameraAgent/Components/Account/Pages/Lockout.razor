@page "/Account/Lockout"

<PageTitle>Locked out</PageTitle>

<AccountShell Class="single">
    <header class="ops-page-heading">
        <div>
            <p class="eyebrow">Local owner</p>
            <h1>Locked out</h1>
        </div>
    </header>
    <div class="ops-note-banner failure" role="alert">
        <span class="status-icon failure" aria-hidden="true"></span>
        <span>This account has been locked out, please try again later.</span>
    </div>
</AccountShell>
