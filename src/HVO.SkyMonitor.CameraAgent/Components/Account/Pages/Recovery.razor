<PageTitle>Recover owner access</PageTitle>

<AccountShell Class="single wide">
    <section aria-labelledby="recovery-heading">
        <header class="ops-page-heading">
            <div>
                <p class="eyebrow">Offline recovery</p>
                <h1 id="recovery-heading">Recover owner access</h1>
                <p>CameraAgent does not email password-reset links or reveal whether an account exists.</p>
            </div>
        </header>

        <div class="ops-panel">
            <header class="ops-panel-heading">
                <div>
                    <h2>Run recovery on the CameraAgent host</h2>
                    <p>Capture and durable storage continue while the local Identity credential changes.</p>
                </div>
            </header>
            <ol class="recovery-steps">
                <li>Sign in to the host as the deployment runtime user.</li>
                <li>Run the local installer command using the installed instance identifier.</li>
                <li>Open the owner-only password file it reports, sign in, and replace that temporary password immediately.</li>
            </ol>
            <code class="recovery-command">hvo-skymonitor cameraagent recover-owner --instance-id &lt;instance-id&gt; --generate-password</code>
            <p class="account-note">Recovery uses retained owner-only provisioning proof over an owner-only Unix-domain socket.</p>
        </div>

        <div class="account-form-actions recovery-actions">
            <a class="button secondary" href="Account/Login">Return to login</a>
        </div>
    </section>
</AccountShell>

<script type="module" src="@Assets["Components/Account/Pages/Recovery.razor.js"]"></script>
