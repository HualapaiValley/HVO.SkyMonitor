@page "/Account/Manage/Email"

<PageTitle>Owner email</PageTitle>

<h2>Owner email</h2>

<div class="owner-email-card">
    <label for="owner-email">Configured owner</label>
    <input id="owner-email" type="email" value="@email" class="form-control" readonly />
    <p>This address identifies the single local site owner and must match the installer manifest. Change it through a supported deployment lifecycle operation, not from the browser.</p>
</div>
