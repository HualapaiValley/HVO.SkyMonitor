@namespace HVO.SkyMonitor.CameraAgent.Components.Account.IdentityShared
@inherits LayoutComponentBase
@layout HVO.SkyMonitor.CameraAgent.Components.Layout.MainLayout

@* Each page under Manage supplies its own page heading, so the three routes carry distinct programmatic names.
   The layout emits no heading of its own: _Imports.razor applies it to the whole folder, and a heading here would
   become a second h1 or a name every page had to match. "Account settings" is the navigation region's name, and
   each page's own h1 names the page. The sidebar follows the Operations sidebar: an eyebrow, a title, icon links. *@
<AccountShell Class="manage-page">
    <div class="manage-layout">
        <div class="manage-sidebar">
            <div class="manage-sidebar-head">
                <p class="eyebrow">Local owner</p>
                <strong>Account settings</strong>
            </div>
            <nav aria-label="Account settings">
                <ManageNavMenu />
            </nav>
        </div>
        <div class="manage-content">
            @Body
        </div>
    </div>
</AccountShell>
