@namespace HVO.SkyMonitor.CameraAgent.Components.Account.IdentityShared
@inherits LayoutComponentBase
@layout HVO.SkyMonitor.CameraAgent.Components.Layout.MainLayout

@* Each page under Manage supplies its own page heading through PageHeader with
   HeadingId="manage-heading", so the three routes carry distinct programmatic names.
   The layout no longer emits a heading of its own; "Account settings" survives as the
   navigation region's name. *@
<section class="manage-page" aria-labelledby="manage-heading">
    <div class="manage-layout">
        <nav aria-label="Account settings">
            <ManageNavMenu />
        </nav>
        <div class="manage-content">
            @Body
        </div>
    </div>
</section>
