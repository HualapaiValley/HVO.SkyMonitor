@namespace HVO.SkyMonitor.CameraAgent.Components.Presentation
@using HVO.SkyMonitor.CameraAgent.Common.Gallery

@* Structure follows docs/prototypes/pipeline-operations/cameraagent-pages.js createCaptureCard() and the
   .capture-card rules in cameraagent-pages.css. Every field is derived from this exact capture; no fixture
   value, neighbouring image, or latest-frame substitution is rendered. *@
<article class="capture-card">
    <a class="capture-image product-@ProductClass" href="@DetailUrl" aria-label="@ImageLinkLabel">
        @if (SelectedSlot?.PreviewUrl is { } previewUrl && !PreviewFailed)
        {
            <img src="@previewUrl.OriginalString" alt="@ImageAlt" loading="lazy" decoding="async" @onerror="MarkPreviewFailed" />
        }
        else
        {
            <span class="capture-image-placeholder"><b>@(PreviewFailed ? "Image preview unavailable" : UnavailableTitle)</b><small>Capture facts retained</small></span>
        }
        <span class="capture-badges">
            <span>@ProductLabel</span>
            @if (EventLabel is { } eventLabel)
            {
                <span class="event-badge">@eventLabel</span>
            }
        </span>
        <span class="capture-image-overlay">
            <span><strong>Capture #@Capture.CaptureSequence</strong><small>@StageLabel / @ArtifactCountLabel</small></span>
            <time datetime="@Capture.ExposureStartedUtc.ToString("O")">@CaptureTimeUtc UTC</time>
        </span>
    </a>
    <div class="capture-card-body">
        <p>@Summary</p>
        <dl class="capture-card-facts">
            <div><dt>Source</dt><dd title="@SourceLabel">@SourceLabel</dd></div>
            <div><dt>Integration</dt><dd>@IntegrationLabel</dd></div>
            <div><dt>Pipeline</dt><dd><span class="pipeline-state"><span class="status-icon @PipelineOutcome" aria-hidden="true"></span>@PipelineStatus</span></dd></div>
        </dl>
        <div class="capture-card-actions">
            <a href="@DetailUrl">Open image</a>
            @if (RunUrl is { } runUrl)
            {
                <a class="run-link" href="@runUrl">View pipeline run</a>
            }
            else
            {
                <span class="run-link run-link--disabled" role="link" aria-disabled="true" tabindex="0" title="@RunUnavailableReason">View pipeline run</span>
            }
        </div>
    </div>
</article>
