@namespace HVO.SkyMonitor.CameraAgent.Components.Presentation
@using HVO.SkyMonitor.CameraAgent.Common.Gallery

<div class="stage-selector hvo-segmented" role="group" aria-label="Image stage" aria-describedby="@(HasUnavailable ? UnavailableId : null)">
    @foreach (var slot in Stages)
    {
        var available = slot.Availability == CameraAgentPresentationSlotAvailability.Available;
        var selected = available && slot.Stage == SelectedStage;
        <button type="button"
                class="@(selected ? "hvo-segmented__option hvo-segmented__option--selected stage-selector__button stage-selector__button--selected" : "hvo-segmented__option stage-selector__button")"
                disabled="@(!available)"
                aria-pressed="@selected.ToString().ToLowerInvariant()"
                title="@ReasonText(slot)"
                @onclick="() => SelectAsync(slot)">
            <span>@slot.Label</span>
        </button>
    }
</div>
@if (HasUnavailable)
{
    @* A disabled button is not focusable, so its title is mouse-only; the reason for every
       unavailable stage is written here where it is visible and announced. *@
    <p id="@UnavailableId" class="stage-selector__unavailable">
        @foreach (var slot in Stages.Where(static slot => slot.Availability != CameraAgentPresentationSlotAvailability.Available))
        {
            <span class="stage-selector__reason"><strong>@slot.Label</strong>: @PresentationReason(slot)</span>
        }
    </p>
}
