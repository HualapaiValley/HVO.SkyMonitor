@using HVO.SkyMonitor.CameraAgent.Components.Pages
@using HVO.SkyMonitor.CameraAgent.Services
@namespace HVO.SkyMonitor.CameraAgent.Components.Presentation

@if (_visible)
{
    <section class="video-library" aria-label="Daily time-lapse library">
        <h2>Daily time-lapses</h2>
        <p>Recorded daily generation and published videos for each retained sunrise period. Open the observing day for hourly sources and generation details.</p>
        @if (_loading) { <p role="status">Loading time-lapses…</p> }
        else if (_message is not null) { <p role="status">@_message</p> }
        else if (_products.Count == 0) { <p>No daily time-lapses have been generated in this page.</p> }
        else
        {
            <ul>@foreach (var entry in _products)
                {
                    <li data-video-state="@entry.State.ToString().ToLowerInvariant()">
                        @if (entry.State == HVO.SkyMonitor.CameraAgent.Common.NightlyProducts.NightlyProductLibraryState.Produced && entry.Product is { } product)
                        {
                            <a href="@TimeLapseLinks.Detail(product.ProductId)">@product.ReportDate.ToString("yyyy-MM-dd")</a>
                            <span> · @product.Width × @product.Height · @(product.HasGaps ? "Final with capture gaps" : "Final") · Produced</span>
                        }
                        else
                        {
                            <a href="@ArchiveCalendarPage.DayUrl(entry.ReportDate)">@entry.ReportDate.ToString("yyyy-MM-dd")</a>
                            <span> · @entry.State · @Progress(entry)</span>
                        }
                        <small> · Source window: @ObservingDayPage.LocalSpan(entry.Window.StartUtc, entry.Window.EndUtc, entry.Window.ReportingPeriod.Site.TimeZoneId) (@entry.Window.ReportingPeriod.Site.TimeZoneId)</small>
                        @if (entry.StartedUtc is { } started) { <small> · Started @started.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</small> }
                        else if (entry.State == HVO.SkyMonitor.CameraAgent.Common.NightlyProducts.NightlyProductLibraryState.Running)
                        { <small> · @(entry.JobState == HVO.SkyMonitor.CameraAgent.Common.TimeLapses.CameraAgentTimeLapseState.Queued ? "Not started" : "Start time unavailable for this retained job")</small> }
                    </li>
                }
            </ul>
        }
        @if (_searchedThrough is { } searched) { <p role="status">Bounded search through @searched.ToString("yyyy-MM-dd"); older days were not examined.</p> }
        @if (_olderBefore is not null) { <a href="@OlderUrl">Older daily videos</a> }
    </section>
}
