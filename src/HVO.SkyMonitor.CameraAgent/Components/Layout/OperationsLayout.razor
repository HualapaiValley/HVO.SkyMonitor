@inherits LayoutComponentBase
@layout MainLayout

<div class="operations-layout">
    <div class="operations-navigation-shell">
        <ResponsiveNavigation Id="operations-sections" Label="Operations sections" Breakpoint="940">
            <ToggleContent>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14"></path></svg>
                <span>Operations sections</span>
            </ToggleContent>
            <ChildContent>
                <aside class="operations-sidebar" aria-label="Operations sections">
                    <header class="operations-sidebar-head">
                        <div>
                            <p class="eyebrow">Local administration</p>
                            <strong>Operations</strong>
                        </div>
                        @if (_attention is { } attention)
                        {
                            <span class="state-chip @attention.HealthClass" title="@HealthTitle(attention)">@attention.HealthLabel</span>
                        }
                        else if (_readFailed)
                        {
                            <span class="state-chip pending" title="Current operations data is unavailable.">Unknown</span>
                        }
                    </header>

                    <nav class="operations-navigation" aria-label="Operations navigation">
                        @foreach (var group in OperationsSectionCatalog.Groups)
                        {
                            if (group != "Overview")
                            {
                                <p class="ops-nav-group" id="@GroupId(group)">@group</p>
                            }
                            foreach (var section in OperationsSectionCatalog.Sections.Where(section => section.Group == group))
                            {
                                var current = Current is not null && section.Slug == Current.Slug;
                                var count = _attention?.CountFor(section.Slug) ?? 0;
                                var note = section.CapabilityNote;
                                <a href="@section.Href"
                                   class="@(current ? "active" : null)"
                                   aria-current="@(current ? "page" : null)"
                                   aria-describedby="@(note is null ? null : NoteId(section))"
                                   title="@(note ?? section.Description)">
                                    <span class="ops-nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="@section.IconPath"></path></svg></span>
                                    <span>@section.Label</span>
                                    @if (section.Badge is { } badge)
                                    {
                                        <span class="ops-nav-badge neutral">@badge</span>
                                    }
                                    @if (count > 0)
                                    {
                                        <span class="ops-nav-badge attention">@count<span class="visually-hidden"> open attention @(count == 1 ? "item" : "items")</span></span>
                                    }
                                </a>
                                @if (note is not null)
                                {
                                    <span id="@NoteId(section)" class="visually-hidden">@note</span>
                                }
                            }
                        }
                    </nav>

                    <footer class="operations-scope">
                        <span class="agent-dot" aria-hidden="true"></span>
                        <span><strong>Local authority</strong><small>@ScopeText</small></span>
                        <a href="/operations/registration" aria-label="View registration"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6"></path></svg></a>
                    </footer>
                </aside>
            </ChildContent>
        </ResponsiveNavigation>
    </div>

    <div class="operations-content">
        <CascadingValue Value="this" IsFixed="true">
            <div class="operations-page-frame">@Body</div>
        </CascadingValue>
    </div>
</div>
