@inherits LayoutComponentBase
@layout MainLayout

<div class="operations-layout">
    <div class="operations-navigation-shell">
    <ResponsiveNavigation Id="operations-sections" Label="Operations sections" Breakpoint="940">
        <ToggleContent>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14"></path></svg>
        <span>Operations sections</span>
        </ToggleContent>
        <ChildContent>
    <aside class="operations-sidebar" aria-label="Operations sections">
        <div class="operations-sidebar__head">
            <p class="eyebrow">Local administration</p>
            <strong>Operations</strong>
        </div>
        <nav class="operations-navigation" aria-label="Operations navigation">
            @foreach (var group in OperationsSectionCatalog.Groups)
            {
                var sections = OperationsSectionCatalog.Sections.Where(section => section.Group == group).ToArray();
                if (sections.Length == 0) { continue; }
                if (group != "Overview") { <p class="operations-navigation__group" id="@GroupId(group)">@group</p> }
                <ul aria-labelledby="@(group == "Overview" ? null : GroupId(group))">
                    @foreach (var section in sections)
                    {
                        var current = Current is not null && section.Slug == Current.Slug;
                        <li>
                            @if (section.UnavailableReason is { } reason)
                            {
                                <button type="button" class="operations-navigation__link operations-navigation__link--unavailable" disabled title="@reason" aria-describedby="@($"operations-unavailable-{section.Slug}")">
                                    <svg class="operations-navigation__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="@section.IconPath"></path></svg>
                                    <span>@section.Label</span><small>#@section.UnavailableIssue</small>
                                </button>
                                <p id="@($"operations-unavailable-{section.Slug}")" class="operations-navigation__reason">@reason</p>
                            }
                            else
                            {
                            <a href="@section.Href" class="@(current ? "operations-navigation__link operations-navigation__link--current" : "operations-navigation__link")" aria-current="@(current ? "page" : null)" title="@section.Summary">
                                <svg class="operations-navigation__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="@section.IconPath"></path></svg>
                                <span>@section.Label</span>
                            </a>
                            }
                        </li>
                    }
                </ul>
            }
        </nav>
        <footer class="operations-scope"><strong>Local authority</strong><small>CameraAgent workspace</small></footer>
    </aside>
        </ChildContent>
    </ResponsiveNavigation>
    </div>

    <div class="operations-content">
        @Body
    </div>
</div>
