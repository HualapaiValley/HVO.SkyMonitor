<footer class="global-footer">
    <section class="global-footer__section global-footer__section--left">
        <span class="footer-chip footer-chip--info" title="Camera agent status">
            <i class="bi bi-camera-video me-2"></i>
            Camera Agent
        </span>
    </section>

    <section class="global-footer__section global-footer__section--center">
        <span class="footer-chip footer-chip--success" title="@LocalTimeTooltip">
            <i class="bi bi-clock-history me-2"></i>
            @LocalTimeDisplay
        </span>
    </section>

    <section class="global-footer__section global-footer__section--right">
        <span class="footer-chip footer-chip--warning" title="Preview build">
            <i class="bi bi-lightning-charge me-2"></i>
            Preview
        </span>
    </section>
</footer>
