@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization

<header class="shell-header">
    <div class="shell-header__bar">
        <a class="shell-brand" href="/" aria-label="HVO SkyMonitor current sky">
            <span class="shell-brand__mark" aria-hidden="true">
                <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="17"></circle><path d="M9 23c5-8 15-12 23-8M13 29c4-6 11-10 19-9"></path><circle cx="14" cy="13" r="1.8"></circle><circle cx="25" cy="10" r="1.3"></circle></svg>
            </span>
            <span class="shell-brand__copy"><strong>HVO SkyMonitor</strong><small>Local CameraAgent</small></span>
        </a>

        <div class="shell-menu">
            <ResponsiveNavigation Id="shell-menu-panel" Label="Site menu">
                <ToggleContent>
                <span>Menu</span>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12"></path></svg>
                </ToggleContent>
                <ChildContent>
                <div class="shell-menu__panel">
                <nav class="shell-primary" aria-label="Primary navigation">
                    @foreach (var link in PrimaryNavigationLinks)
                    {
                        <NavLink class="@NavigationClass(link)" href="@link.Href" Match="@link.Match" aria-current="@NavigationCurrent(link)">
                            <span>@link.Label</span>
                        </NavLink>
                    }
                </nav>

                <div class="nav-toolbar">
                    <AuthorizeView Context="authState">
                        <Authorized>
                            <details class="nav-account-info">
                                <summary class="nav-avatar-button" aria-label="@($"Account for {GetUserDisplayName(authState.User)}")">
                                    <span class="nav-avatar">@GetUserInitials(authState.User)</span>
                                    <span class="nav-account-details">
                                        <span class="nav-account-name">@GetUserDisplayName(authState.User)</span>
                                        <span class="nav-account-email">@GetUserEmail(authState.User)</span>
                                    </span>
                                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"></path></svg>
                                </summary>

                                <ul class="nav-account-menu">
                                    <li>
                                        <a href="Account/Manage">Account settings</a>
                                    </li>
                                    <li>
                                        <form class="nav-logout-form" action="Account/Logout" method="post">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="returnUrl" value="@CurrentReturnUrl" />
                                            <button type="submit" class="nav-logout-button">Sign out</button>
                                        </form>
                                    </li>
                                </ul>
                            </details>
                        </Authorized>
                        <NotAuthorized>
                            <a class="nav-login-pill" href="@SignInUrl">
                                Sign in
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
                </div>
                </ChildContent>
            </ResponsiveNavigation>
        </div>
    </div>
</header>
