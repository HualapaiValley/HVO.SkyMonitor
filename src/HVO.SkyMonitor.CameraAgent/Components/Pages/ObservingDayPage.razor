@page "/archive/day/{DateText}"
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Common.Automation
@using HVO.SkyMonitor.CameraAgent.Common.Gallery
@using HVO.SkyMonitor.CameraAgent.Common.NightlyProducts
@using HVO.SkyMonitor.CameraAgent.Components.Presentation
@using HVO.SkyMonitor.CameraAgent.Services
@using HVO.SkyMonitor.CameraAgent.Components.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>@PageTitleText</PageTitle>

<div class="day-page">
    @if (_invalidDate)
    {
        <PageStateNotice Kind="PageStateNotice.PageStateKind.Error" Title="Observing day not recognised" Message="Use a date in the form yyyy-MM-dd within the calendar range.">
            <a class="btn btn-outline-light btn-sm" href="@CalendarUrl">Back to calendar</a>
        </PageStateNotice>
    }
    else
    {
        <header class="day-heading">
            <div>
                <p class="eyebrow">Archive / observing day</p>
                <div class="day-title">
                    <a class="btn btn-outline-light btn-sm day-title__step" href="@DayUrl(-1)" aria-label="Previous observing day"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                    <h1 id="day-heading" tabindex="-1">@DayTitle</h1>
                    <a class="btn btn-outline-light btn-sm day-title__step" href="@DayUrl(1)" aria-label="Next observing day"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                </div>
                <p class="day-lead">@DayLead</p>
            </div>
            <div class="day-actions">
                @if (_view is { Day.CaptureCount: > 0 })
                {
                    <a class="btn btn-outline-light" href="@CapturesUrl">View @_view.Day.CaptureCount.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) captures</a>
                }
                @if (_view is { Day.CandidateCount: > 0 })
                {
                    <a class="btn btn-outline-light" href="@CandidatesUrl">View events</a>
                }
                <a class="btn btn-outline-light" href="@CalendarUrl">Calendar</a>
            </div>
        </header>

        @if (_isLoading)
        {
            <PageStateNotice Kind="PageStateNotice.PageStateKind.Loading" Title="Loading observing day" Message="Reading the night's retained captures, schedule and candidates." />
        }
        else if (_errorMessage is not null)
        {
            <PageStateNotice Kind="PageStateNotice.PageStateKind.Error" Title="Observing day unavailable" Message="@_errorMessage">
                <button type="button" class="btn btn-outline-light btn-sm" @onclick="LoadAsync">Try again</button>
            </PageStateNotice>
        }
        else if (_view is { } view)
        {
            <section class="day-hero" aria-label="Representative capture and night facts">
                <div class="day-hero__image">
                    @if (view.RepresentativeCaptureId is { } representative)
                    {
                        <a href="/gallery/@representative.ToString("D")" aria-label="Open the representative capture">
                            <img src="@ArchiveCalendarPage.ThumbnailUrl(representative)" alt="Representative capture of @DayTitle" />
                        </a>
                        <p class="day-hero__caption"><span>Representative capture</span><strong>@RepresentativeCaption(view)</strong></p>
                    }
                    else
                    {
                        <div class="day-hero__empty" role="status"><strong>No displayable capture</strong><span>@(view.Day.CaptureCount > 0 ? "Captures were retained but none has a published preview." : "No captures were retained on this observing day.")</span></div>
                    }
                </div>
                <aside class="day-facts">
                    <p class="day-facts__state">
                        <span class="hvo-chip @StateChipClass(view)">@StateLabel(view)</span>
                        <small>@StateDetail(view)</small>
                    </p>
                    <dl>
                        <div><dt>Scheduled window</dt><dd>@ScheduledWindow(view)</dd></div>
                        <div><dt>Capture coverage</dt><dd>@Coverage(view)</dd></div>
                        <div><dt>Retained captures</dt><dd>@view.Day.CaptureCount.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                        <div><dt>Cloud quality</dt><dd>Not assessed for this day</dd></div>
                        <div><dt>Total integration</dt><dd>@FormatDuration(view.TotalIntegration)</dd></div>
                        <div><dt>Local candidates</dt><dd>@view.Day.CandidateCount.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                    </dl>
                    @if (view.Schedule is not null)
                    {
                        <p class="day-facts__note" role="note">Windows come from the active schedule definition; operator overrides and manual pause are not reflected.@(view.Schedule.ActiveRevisionCaveat ? " This night predates the active revision, which was created after it." : "")</p>
                    }
                </aside>
            </section>

            <section class="night-timeline" aria-label="Night timeline">
                <header><div><p class="eyebrow">@(view.Day.Day.SunrisePeriod is null ? "Legacy noon to noon" : "Sunrise to following sunrise")</p><h2>Observing-day timeline</h2><p>Scheduled openings, retained exposures and candidate records on one local-time axis.</p></div><span class="night-timeline__range">@TimelineRange(view)</span></header>
                <div class="timeline-tracks" style="--night-hours: @NightHours(view).ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <span class="timeline-track-label">Schedule</span>
                    <div class="timeline-track" aria-label="Scheduled windows from the active schedule definition">
                        @if (view.Schedule is { OpenWindows.Count: > 0 } schedule)
                        {
                            @foreach (var window in schedule.OpenWindows)
                            {
                                <span class="timeline-bar timeline-bar--schedule" style="@BarStyle(view, window.StartUtc, window.EndUtc)" title="Scheduled @LocalTime(window.StartUtc)–@LocalTime(window.EndUtc)"></span>
                            }
                        }
                        else
                        {
                            <span class="timeline-track__empty">@(view.Schedule is null ? "Schedule unavailable" : "No schedule window")</span>
                        }
                    </div>
                    <span class="timeline-track-label">Captures</span>
                    <div class="timeline-track" aria-label="Retained capture exposure starts in @CoverageBinMinutes-minute bins">
                        @foreach (var segment in CaptureSegments(view))
                        {
                            <span class="timeline-bar timeline-bar--captures" style="@BarStyle(view, segment.StartUtc, segment.EndUtc)" title="@segment.Count captures @LocalTime(segment.StartUtc)–@LocalTime(segment.EndUtc)"></span>
                        }
                    </div>
                    <span class="timeline-track-label">Candidates</span>
                    <div class="timeline-track timeline-track--markers" aria-label="Local candidate record times, not verified observation times">
                        @foreach (var candidate in view.Candidates)
                        {
                            <a class="timeline-marker" style="@MarkerStyle(view, candidate.CreatedUtc)" href="/transients/@candidate.CandidateId.ToString("D")" title="Candidate recorded @LocalTime(candidate.CreatedUtc)"><span>Candidate recorded @LocalTime(candidate.CreatedUtc)</span></a>
                        }
                    </div>
                    <div class="timeline-hours" aria-hidden="true">
                        @foreach (var tick in HourTicks(view))
                        {
                            <span style="left: @tick.Percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">@tick.Label</span>
                        }
                    </div>
                </div>
                <div class="timeline-key"><span><i class="timeline-key__schedule"></i>Active schedule definition</span><span><i class="timeline-key__captures"></i>Exposure starts (@CoverageBinMinutes-minute bins)</span><span><i class="timeline-key__event"></i>Candidate record time</span><span class="timeline-key__unavailable">Cloud/usable intervals: unavailable</span></div>
                @if (view.Schedule?.ActiveRevisionCaveat == true) { <p class="night-timeline__note">The active schedule was created after this day. Its windows are not a historical admission record.</p> }
            </section>

            <section class="daily-products" aria-label="Generated products" aria-busy="@(_nightlyLoading ? "true" : "false")">
                <header><div><p class="eyebrow">Nightly products</p><h2>Generated products</h2><p>Recorded evaluations of this sunrise period. No capture image is substituted for a product.</p></div><a href="@ProductsPage.RetainedPath">Browse retained outputs</a></header>
                @if (view.Day.Day.SunrisePeriod is null)
                {
                    <p class="daily-products__note" role="note">Nightly products belong to sunrise report dates, so this noon-to-noon view does not show them. <a href="@SunriseDayUrl">Switch to sunrise periods</a></p>
                }
                else if (_nightlyLoading)
                {
                    <p class="daily-products__note" role="status">Loading nightly products…</p>
                }
                else if (_nightly is null)
                {
                    <p class="daily-products__note daily-products__note--warning" role="status"><strong>Nightly product status unavailable.</strong> @_nightlyMessage</p>
                }
                else if (view.Day.Day.SunrisePeriod is { } period)
                {
                    var sample = _nightly.TimeLapseSample;
                    var cards = Cards(view, period, _nightly.Day);
                    <div class="product-slots">
                        @foreach (var card in cards)
                        {
                            var kind = card.Kind;
                            var label = NightlyProductLinks.KindLabel(kind);
                            var noun = NightlyProductLinks.KindNoun(kind);
                            <article class="product-slot" data-product-kind="@noun" data-nightly-state="@card.Badge.CssClass" aria-label="Nightly @noun">
                                @if (CanOpen(card))
                                {
                                    <button type="button" id="@TileId(kind)" class="product-slot__media" aria-haspopup="dialog" aria-label="@($"Open the nightly {noun} of {DayTitle} and its details")" @onclick="() => OpenViewer(kind)">
                                        @if (card.Product is not { } product)
                                        {
                                            <i class="bi @KindIcon(kind)" aria-hidden="true"></i>
                                        }
                                        else if (_failedPreviews.Contains(product.ProductId))
                                        {
                                            <span class="product-slot__failed"><i class="bi bi-image" aria-hidden="true"></i>Preview unavailable</span>
                                        }
                                        else
                                        {
                                            <RetainedPreviewImage Source="@NightlyProductLinks.Preview(product.ProductId)" Alt="@($"Nightly {noun} of {DayTitle}")" OnFailure="() => MarkPreviewFailed(product.ProductId)" />
                                        }
                                        <span class="product-slot__open" aria-hidden="true"><i class="bi bi-arrows-angle-expand"></i></span>
                                    </button>
                                }
                                else
                                {
                                    <div class="product-slot__media" aria-hidden="true"><i class="bi @KindIcon(kind)"></i></div>
                                }
                                <h3>@label</h3>
                                <p>@ProductFacts(card)</p>
                                <div class="product-slot__chips">
                                    <span class="hvo-chip @ChipClass(card.Badge.State)" title="@card.Badge.Description">@ChipLabel(card.Badge.State)</span>
                                    @if (card.Hours.Count > 0)
                                    {
                                        <span class="product-slot__hourly">@HourlySummary(card)</span>
                                    }
                                </div>
                            </article>
                        }
                        @if (_nightly.TimeLapses is { } videos && (videos.Jobs.Count > 0 || sample is null))
                        {
                            <TimeLapseDayProducts Day="@videos" Enabled="@_nightly.TimeLapseGenerationEnabled" />
                        }
                        else
                        {
                        <article class="product-slot @(sample is null ? "product-slot--pending" : "product-slot--sample")" data-product-kind="time-lapse" aria-label="Night time-lapse">
                            @if (sample is not null)
                            {
                                <button type="button" id="@TimeLapseTileId" class="product-slot__media" aria-haspopup="dialog" aria-label="Play the time-lapse sample, not generated from this night" @onclick="OpenTimeLapse">
                                    <span class="product-slot__play"><i class="bi bi-play-circle" aria-hidden="true"></i>Play sample</span>
                                    <span class="product-slot__open" aria-hidden="true"><i class="bi bi-arrows-angle-expand"></i></span>
                                </button>
                            }
                            else
                            {
                                <div class="product-slot__media" aria-hidden="true"><i class="bi bi-film"></i></div>
                            }
                            <h3>Night time-lapse</h3>
                            <p>Time-lapse generation is not yet available. @(sample is null ? "Nothing is substituted for it." : "A configured sample can be played; it was not generated from this night and is not counted as a product.")</p>
                            <div class="product-slot__chips">
                                <span class="hvo-chip hvo-chip--neutral">Not yet generated</span>
                                @if (sample is not null) { <span class="hvo-chip hvo-chip--info">Sample</span> }
                            </div>
                        </article>
                        }
                    </div>
                    var viewed = _viewerKind is { } viewedKind ? cards.Find(card => card.Kind == viewedKind) : null;
                    var viewedId = viewed?.Product?.ProductId;
                    <LargeImageViewer Open="@ViewerOpen(viewed, sample)" OpenChanged="ViewerOpenChanged" Eyebrow="@(viewed is null ? "Sample, not from this night" : "Nightly product")" Title="@ViewerTitle(viewed)" CloseLabel="Close the product viewer" Source="@ViewerSource(viewed)" Alt="@(viewed is null ? "" : $"Nightly {NightlyProductLinks.KindNoun(viewed.Kind)} of {DayTitle}")" TriggerId="@ViewerTriggerId" OnImageError="() => MarkViewedPreviewFailed(viewedId)">
                        <Media>
                            @if (viewed is null && sample is not null)
                            {
                                <div class="product-viewer__player">
                                    <TimeLapsePlayer Source="@sample.Url" MediaType="@sample.MediaType" Width="@sample.Width" Height="@sample.Height" Label="Time-lapse sample, not generated from this night" Caption="@SampleCaption(sample)" />
                                </div>
                            }
                            else if (viewed?.Product is null)
                            {
                                <p class="product-viewer__empty" role="note"><i class="bi @(viewed is null ? "bi-film" : KindIcon(viewed.Kind))" aria-hidden="true"></i><strong>No nightly product to show</strong><span>Nothing is substituted for it. Its hourly products are listed with the details.</span></p>
                            }
                            else
                            {
                                <p class="product-viewer__empty" role="status"><i class="bi bi-image" aria-hidden="true"></i><strong>Preview unavailable</strong><span>The display preview of this product could not be read. No other image has been substituted.</span></p>
                            }
                        </Media>
                        <Details>
                            @if (viewed is null && sample is not null)
                            {
                                <div class="product-viewer" data-viewer-kind="time-lapse">
                                    <p class="product-viewer__state"><span class="hvo-chip hvo-chip--neutral">Not yet generated</span><span class="hvo-chip hvo-chip--info">Sample</span></p>
                                    <p>Time-lapse generation is not yet available. This configured sample was not generated from this night and is not counted as a product.</p>
                                    <dl class="product-viewer__facts">
                                        <div><dt>Media type</dt><dd>@sample.MediaType</dd></div>
                                        <div><dt>Declared size</dt><dd>@sample.Width × @sample.Height</dd></div>
                                    </dl>
                                </div>
                            }
                            else if (viewed is not null)
                            {
                                var noun = NightlyProductLinks.KindNoun(viewed.Kind);
                                <div class="product-viewer" data-viewer-kind="@noun">
                                    <p class="product-viewer__state"><span class="hvo-chip @ChipClass(viewed.Badge.State)">@ChipLabel(viewed.Badge.State)</span><small>@viewed.Badge.Description.</small></p>
                                    @if (viewed.Product is { } product)
                                    {
                                        <dl class="product-viewer__facts">
                                            <div><dt>Admitted frames</dt><dd>@LocalSpan(product.FirstObservationUtc, product.LastObservationUtc)</dd></div>
                                            <div><dt>Composed from</dt><dd>@(FormattableString.Invariant($"{viewed.Daily!.Status.AdmittedCount:N0} segment products"))</dd></div>
                                            <div><dt>Encoded size</dt><dd>@(FormattableString.Invariant($"{product.Width:N0} × {product.Height:N0} {product.PixelFormat}"))</dd></div>
                                            <div><dt>Total integration</dt><dd>@FormatDuration(product.TotalIntegration)</dd></div>
                                        </dl>
                                    }
                                    else
                                    {
                                        <p>@ProductFacts(viewed)</p>
                                    }
                                    @if (viewed.Hours.Count > 0)
                                    {
                                        <div class="product-hours">
                                            <span class="product-hours__label">@HourlySummary(viewed)</span>
                                            <ol aria-label="Hourly @(noun)s">
                                                @foreach (var hour in viewed.Hours)
                                                {
                                                    <li>
                                                        @if (hour.FinalProduct is { } hourly)
                                                        {
                                                            <a href="@NightlyProductLinks.Detail(hourly.ProductId)" title="@HourTitle(hour)" aria-label="@($"Hourly {noun} {HourTitle(hour)}")">@HourLabel(viewed, hour)</a>
                                                        }
                                                        else
                                                        {
                                                            <span title="@HourTitle(hour)" aria-label="@($"Hourly {noun} {HourTitle(hour)}")">@HourLabel(viewed, hour)</span>
                                                        }
                                                    </li>
                                                }
                                            </ol>
                                        </div>
                                    }
                                    @if (viewed.Product is { } linked)
                                    {
                                        <div class="product-viewer__actions">
                                            <a class="btn btn-outline-light btn-sm" href="@NightlyProductLinks.Detail(linked.ProductId)">Product detail</a>
                                            <a class="btn btn-outline-light btn-sm" href="@NightlyProductLinks.PreviewDownload(linked.ProductId)" download>Download preview</a>
                                        </div>
                                    }
                                </div>
                            }
                        </Details>
                    </LargeImageViewer>
                    var otherPeriods = _nightly.Day.OtherPeriods(period.IdentitySha256);
                    @if (otherPeriods.Count > 0)
                    {
                        <div class="daily-products__note daily-products__other" role="note">
                            <p><strong>Also recorded under another source period.</strong> This report date has evaluations retained under a sunrise period resolved for another site or time-zone rules. They belong to that period, so they are not shown above as this period's products.</p>
                            <ul>
                                @foreach (var other in otherPeriods)
                                {
                                    <li>
                                        <span>@ObservingDayPage.OtherPeriodLabel(other)</span>
                                        <ul>
                                            @foreach (var kind in ProductKinds)
                                            {
                                                var nightly = _nightly.Day.Daily(kind, other.IdentitySha256)?.FinalProduct;
                                                <li>
                                                    @NightlyProductLinks.KindLabel(kind): @OtherPeriodFacts(_nightly.Day, other, kind)@if (nightly is not null)
                                                    {
                                                        <text> · </text><a href="@NightlyProductLinks.Detail(nightly.ProductId)">Product detail</a>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
            </section>

            <div class="day-columns">
                <section class="day-events" aria-label="Detected candidates">
                    <header><div><h2>Local candidates</h2><p>Detection records, not confirmed meteors or reviewed events.</p></div><span class="hvo-chip @(view.Candidates.Count > 0 ? "hvo-chip--warning" : "hvo-chip--neutral")">@view.Day.CandidateCount.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span></header>
                    @if (view.Candidates.Count == 0)
                    {
                        <p class="day-events__empty">No local candidates were recorded on this observing day.</p>
                    }
                    else
                    {
                        <ol class="candidate-list">
                            @foreach (var candidate in view.Candidates)
                            {
                                <li><a href="/transients/@candidate.CandidateId.ToString("D")"><strong>@LocalTime(candidate.CreatedUtc)</strong><span>@OperationsPage.SplitWords(candidate.CandidateState)</span><small>@OperationsPage.SplitWords(candidate.WorkflowPhase)</small></a></li>
                            }
                        </ol>
                        @if (view.CandidatesTruncated)
                        {
                            <p class="day-events__empty"><a href="@CandidatesUrl">More candidates on this night</a></p>
                        }
                    }
                </section>
                <section class="day-automations" aria-label="Scheduled automations">
                    <header><div><h2>Scheduled automations</h2><p>Runs recorded for this observing day; history is bounded.</p></div><a href="/operations/automations">Automation schedule</a></header>
                    @if (view.AutomationRuns.Count == 0)
                    {
                        <p class="day-events__empty">No runs appear in the recent history for this observing day. Older runs may be outside the retained history.</p>
                    }
                    else
                    {
                        <ol class="automation-list">
                            @foreach (var run in view.AutomationRuns)
                            {
                                <li class="automation-run automation-run--@run.Outcome.ToString().ToLowerInvariant()"><div><strong>@run.DefinitionId</strong><span>@OperationsPage.SplitWords(run.Outcome.ToString())@(string.IsNullOrWhiteSpace(run.Detail) ? "" : $" / {run.Detail}")</span></div><time datetime="@run.ScheduledForUtc.ToString("O")">@LocalTime(run.ScheduledForUtc)</time></li>
                            }
                        </ol>
                    }
                </section>
            </div>
        }
    }
</div>
