@inherits SiteTimeComponent
@page "/"
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Common.Gallery
@using HVO.SkyMonitor.CameraAgent.Services
@using HVO.SkyMonitor.Processing
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@attribute [StreamRendering]
@rendermode InteractiveServer

<PageTitle>@(_accessDenied ? "Access denied" : IsArchived ? $"Capture #{ArchivedView!.Capture.CaptureSequence}" : "Current sky")</PageTitle>

@* Structure and class names follow docs/prototypes/pipeline-operations/dashboard.html element for element so the
   scoped stylesheet carries the prototype's cameraagent-pages.css rules unchanged. Features without a backend stay
   in the DOM as disabled controls that name the issue delivering them; fixture values are never rendered. *@
@if (_accessDenied)
{
    <div class="state-notice state-notice--error" role="alert">You are not authorized to view this capture.</div>
}
else
{
<div class="current-sky-page site-main @(IsArchived ? "historical-sky" : "")">
    <header class="site-heading current-sky-heading">
        <div>
            <p class="eyebrow">@(IsArchived ? "Archive / retained capture" : "Authenticated local observatory")</p>
            <h1 id="current-sky-heading" tabindex="-1">@(IsArchived ? $"Capture #{ArchivedView!.Capture.CaptureSequence}" : "Current sky")</h1>
            @if (IsArchived)
            {
                <p><time datetime="@ArchivedView!.Capture.ExposureStartedUtc.ToString("O")">@SiteTime.Format(ArchivedView.Capture.ExposureStartedUtc)</time>. This view stays on the selected capture as new images arrive.</p>
            }
            else
            {
                <p>The latest durable presentation from this CameraAgent, with its source capture and processing state kept explicit.</p>
            }
        </div>
        @if (IsArchived && ArchiveNavigation is not null)
        {
            @ArchiveNavigation
        }
        <div class="site-heading-actions">
            @if (IsArchived)
            {
                <a class="button secondary" href="/">Return to current sky</a>
            }
            else
            {
                <span class="live-indicator @(_presentation?.ImageFreshness == CameraAgentPresentationImageFreshness.Current ? "" : "history")"><i></i>@LiveIndicatorLabel</span>
            }
            <button type="button" class="button secondary refresh-link" disabled="@_refreshing" @onclick="RefreshNowAsync">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 6V2m0 0h-4m4 0-3 3a7 7 0 1 0 1.7 7"></path></svg>
                @(IsArchived ? "Retry image layers" : "Refresh image")
            </button>
        </div>
    </header>

    @if (_errorMessage is not null)
    {
        <div class="state-notice state-notice--error" role="alert">
            <strong>Current sky refresh unavailable</strong>
            <span>@_errorMessage</span>
            @if (_presentation is not null)
            {
                <span>The last successfully read image and capture facts remain visible.</span>
            }
        </div>
    }

    <section class="dashboard-status" aria-label="@(IsArchived ? "Historical capture status" : "CameraAgent status")" aria-live="polite">
        <div class="dashboard-status__state"><span class="status-icon @SystemIconClass" aria-hidden="true"></span><span><strong>@SystemLabel</strong><small>@(_presentation?.System.Message ?? "Loading CameraAgent state.")</small></span></div>
        <dl>
            <div><dt>@(IsArchived ? "Selected capture" : "Current capture")</dt><dd>@(_presentation?.LatestCapture is { } latest ? $"#{latest.CaptureSequence}" : "Unavailable")</dd></div>
            @if (IsArchived)
            {
                <div><dt>Captured</dt><dd>@SiteTime.Format(ArchivedView!.Capture.ExposureStartedUtc)</dd></div>
            }
            else
            {
                <div><dt>Image age</dt><dd>@(FactCapture is { } image ? FormatDuration(image.AgeSeconds) : "Unavailable")</dd></div>
            }
            <div><dt>LogicHost</dt><dd><a href="/operations/delivery" title="@CentralStatusReason">@CentralStatusLabel</a></dd></div>
            <div><dt>Storage</dt><dd><a href="/operations/storage" title="@StorageStatusReason">@StorageStatusLabel</a></dd></div>
            <div><dt>Capture cadence</dt><dd>@CaptureCadenceLabel</dd></div>
        </dl>
    </section>

    <section class="sky-workspace current-sky-hero" aria-label="Current image workspace" @ref="_layerRoot">
        <div class="sky-primary">
        <article class="sky-viewer-card current-sky-visual">
            <header class="card-heading image-heading">
                <div>
                    @if (!IsArchived)
                    {
                        <p class="eyebrow">@(FactCapture is { } reference ? $"Capture #{reference.CaptureSequence} / sequence {reference.CaptureSequence}" : "Latest durable capture")</p>
                    }
                    <h2>@ImageHeading</h2>
                    <p>@ImageSubtitle</p>
                </div>
                <div class="image-heading-actions">
                    @if (FactCapture is not null)
                    {
                        <span class="product-badge @ProductBadgeClass">@ProductBadgeLabel</span>
                    }
                    @if (_liveExecutionId is { } liveRun)
                    {
                        <a class="button secondary small" href="/operations/pipeline/executions/@liveRun">
                            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="5" cy="10" r="2"></circle><circle cx="15" cy="5" r="2"></circle><circle cx="15" cy="15" r="2"></circle><path d="m7 9 6-3m-6 5 6 3"></path></svg>
                            View pipeline run
                        </a>
                    }
                </div>
            </header>

            @if (!IsArchived && (_initialLoading || _refreshDeadlineMessage is not null))
            {
                <div class="state-notice sky-refresh-notice" role="status" aria-live="polite">
                    <strong>Current Sky page refresh</strong>
                    <span>@(_refreshDeadlineMessage ?? "The current image is still loading. Retrying automatically.")</span>
                </div>
            }

            <figure class="sky-figure @(ShowLayeredHero ? "" : "layers-suppressed")" @ref="_figure">
                <div class="sky-image-stage" style="@StageAspectStyle">
                    @if (ShowLayeredHero)
                    {
                        <div class="sky-layer-workspace" aria-label="Current sky layers" @key="_layers!.CaptureId" data-presentation-identity="@_layers!.PresentationIdentitySha256">
                            <div class="sky-layer-canvas @(_layerInteractive ? "sky-layer-canvas--verified" : "")">
                                <img @key="_layerPreviewAttempt" src="@LayerPreviewUrl" alt="@ImageAlt" />
                                <div class="sky-layer-overlay scene-overlay" aria-hidden="true">@LayerSvg</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <CaptureImage Loading="@(_initialLoading && _presentation is null)"
                                      Source="@DisplaySlot?.PreviewUrl"
                                      RetryObservedUtc="@_presentation?.ObservedUtc"
                                      Alt="@ImageAlt"
                                      EmptyTitle="@(IsArchived ? "This capture cannot be displayed" : "No sky image is available yet")"
                                      EmptyMessage="@(IsArchived ? "Retained facts and authorized technical downloads remain available. No other capture is substituted." : "CameraAgent will keep this view ready for the first durable displayable capture.")" />
                    }
                </div>
                <figcaption>
                    <div>
                        <span class="status-icon @CaptureOutcomeIconClass" aria-hidden="true"></span>
                        <span><strong>@CaptureOutcomeTitle</strong><small>@CaptureOutcomeSubtitle</small></span>
                    </div>
                    @if (ShowLayeredHero)
                    {
                        <div class="scene-semantics" aria-label="Layer evidence types"><span class="measured">Measured</span><span class="expected">Expected</span><span class="predicted">Predicted</span></div>
                    }
                    <div class="figure-actions">
                        @if (FactCapture is not null)
                        {
                            <a class="inline-action" href="@DetailUrl" @onclick="OpenTechnicalEvidenceAsync" @onclick:preventDefault="IsArchived">@(IsArchived ? "Evidence and downloads" : "Open capture details")</a>
                        }
                        @if (_presentation?.DisplayCapture is not null && DisplaySlot is not null)
                        {
                            <button id="current-sky-view-large" class="image-tool" type="button" aria-label="Open full screen image" title="Open full screen image" @onclick="OpenFullScreenAsync"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 3H3v4m10-4h4v4M7 17H3v-4m10 4h4v-4"></path></svg></button>
                        }
                    </div>
                </figcaption>
                @if (_technicalEvidenceError is not null)
                {
                    <p class="technical-evidence-error" role="alert">@_technicalEvidenceError</p>
                }
                @if (_viewerError is not null)
                {
                    <p class="technical-evidence-error" role="alert">@_viewerError</p>
                }
                <section class="fullscreen-controls" aria-label="Full screen image controls">
                    <div class="fullscreen-controls-heading"><strong>@ImageHeading</strong><span>@LayerCountLabel</span><button type="button" class="button secondary small" @onclick="CloseFullScreenAsync">Close image</button></div>
                    @if (ShowLayeredHero && _layers is not null)
                    {
                        <div class="fullscreen-layer-list">@foreach (var layer in _layers.Layers) { @LayerToggle(layer) }</div>
                        <div class="overlay-actions">
                            <button class="text-button" type="button" disabled="@(!_layerInteractive)" @onclick="RestoreLayerDefaults">Restore profile defaults</button>
                            <button class="text-button" type="button" disabled="@(_saving || !_layerInteractive)" @onclick="SaveSelectedStackAsync">@(_saving ? "Preparing image..." : "Download selected stack (display JPEG)")</button>
                        </div>
                        @if (_saveMessage is not null) { <p role="status" class="sky-layer-result">@_saveMessage <a href="@SavedArtifactUrl" download>Download JPEG again</a> <a href="@SavedOriginalUrl" download>Download original full-resolution stack</a></p> }
                        @if (_saveError is not null) { <p role="alert" class="sky-layer-result sky-layer-result--error">@_saveError</p> }
                    }
                    else { <p class="scene-unavailable">This selected stage has no interactive overlay stack.</p> }
                </section>
            </figure>

            @if (_presentation is not null && _presentation.Stages.Count > 0)
            {
                <div class="stage-switcher dashboard-stages stage-selector" role="group" aria-label="Image stage" aria-describedby="stage-unavailable">
                    @foreach (var slot in OrderedStages)
                    {
                        var available = slot.Availability == CameraAgentPresentationSlotAvailability.Available;
                        var active = available && slot.Stage == _selectedStage;
                        <button type="button" class="@(active ? "active" : "")" title="@(available ? $"Show {slot.Label} image" : $"{slot.Label}: {StageUnavailableReason(slot)}")" disabled="@(!available)" aria-pressed="@(active ? "true" : "false")" @onclick="() => SelectStage(slot.Stage)"><span>@(slot.Stage == CameraAgentPresentationStage.Combined ? "Live mean" : slot.Label)</span><small>@StageCaption(slot.Stage)</small></button>
                    }
                </div>
                <p id="stage-unavailable" class="stage-unavailable">@foreach (var slot in _presentation.Stages.Where(static slot => slot.Availability != CameraAgentPresentationSlotAvailability.Available)) { <span>@slot.Label: @StageUnavailableReason(slot)</span> }</p>
                <p class="stage-status" aria-live="polite">@StageStatus</p>
                @if (DisplaySlot is { DisplayPolicy: { } displayPolicy } displayed)
                {
                    <p class="stage-display-policy" aria-label="Display policy">
                        <strong>Display:</strong> @displayPolicy
                        @if (displayed.ArtifactId is { } stageArtifactId)
                        {
                            <span> Stage artifact <code>@stageArtifactId</code>@(displayed.DisplayArtifactId is { } shown && shown != stageArtifactId ? $"; shown pixels from artifact {shown:D}" : string.Empty).</span>
                            @if (DisplayContentUrl is { } contentUrl) { <a href="@contentUrl" download>Download stage artifact</a> }
                        }
                    </p>
                }
            }
            @if (_facts?.CombinedLineage is { } lineage && _presentation?.DisplayCapture?.CaptureId == _facts.CaptureId)
            {
                <section class="stack-lineage" aria-labelledby="stack-heading">
                    <header>
                        <div><p class="eyebrow">Multi-source image lineage</p><h3 id="stack-heading">Unregistered live mean ending at capture #@_facts.CaptureSequence</h3></div>
                    </header>
                    <div class="source-strip">
                        @for (var index = 0; index < lineage.SourceArtifactIds.Count && index < 8; index++)
                        {
                            var sourceId = lineage.SourceArtifactIds[index];
                            var source = _combinedProduct?.Sources.FirstOrDefault(item => item.ArtifactId == sourceId);
                            var endpoint = source?.CaptureId == _facts.CaptureId;
                            var previewable = source is { Role: HVO.SkyMonitor.AgentCore.FrameArtifactRole.Calibrated or HVO.SkyMonitor.AgentCore.FrameArtifactRole.Raw, CaptureId: not null } && !_failedSourcePreviews.Contains(sourceId);
                            <div class="source-entry @(endpoint ? "reference" : "")" title="Source artifact @sourceId">
                                @if (previewable)
                                {
                                    <a href="/gallery/@source!.CaptureId"><RetainedPreviewImage @key="sourceId" Source="@($"/api/v1/operations/artifacts/{sourceId:D}/preview")" Alt="@($"{(endpoint ? "Window endpoint capture" : "Capture")} {source.CaptureSequence?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? sourceId.ToString("D")}")" OnFailure="() => _failedSourcePreviews.Add(sourceId)" /></a>
                                }
                                else { <span class="unavailable source-placeholder"><b>Preview unavailable</b></span> }
                                <span>@(endpoint ? "Endpoint N" : $"N-{lineage.SourceArtifactIds.Count - 1 - index}")</span><small title="Artifact @sourceId">@(source?.CaptureSequence is { } sequence ? $"#{sequence}" : $"Source {index + 1}")</small>
                            </div>
                        }
                    </div>
                    <dl class="lineage-facts">
                        <div><dt>Included</dt><dd>@IncludedFramesLabel(lineage)</dd></div>
                        <div><dt>Total integration</dt><dd>@TotalIntegrationLabel(lineage)</dd></div>
                        <div><dt>Observation span</dt><dd>@(_combinedObservationSpan is { } span ? FormattableString.Invariant($"{span.TotalSeconds:0.###} seconds (first to last start)") : "Unavailable: complete source timing not retained")</dd></div>
                        <div><dt>Window endpoint</dt><dd>Capture #@_facts.CaptureSequence</dd></div>
                    </dl>
                    @if (lineage.SourceCount > 8 || _combinedProduct?.SourcesTruncated == true) { <p>Source display is bounded to the first eight recorded IDs.</p> }
                    @if (_lineageMessage is not null) { <p role="status">@_lineageMessage</p> }
                    <p class="design-disclosure lineage-note"><strong>@(IsArchived ? "Retained method:" : "Current baseline:")</strong> @LineageDisclosure(lineage) Registered stacking remains a separate design target.</p>
                </section>
            }
            @if (LayerMessage is { } layerMessage && _presentation?.DisplayCapture is not null)
            {
                <p class="sky-layer-unavailable" role="status">@layerMessage</p>
            }
        </article>
        @if (IsArchived)
        {
            @OperationsStrip
            @Evidence
        }
        </div>

        <aside class="sky-inspector current-sky-inspector">
            <section class="inspector-card overlay-controls scene-panel @(ShowLayeredHero ? "" : "evidence-unavailable")" aria-labelledby="overlays-heading">
                <header><div><p class="eyebrow">Reproducible presentation</p><h2 id="overlays-heading">Scene evidence</h2></div><span>@LayerCountLabel</span></header>
                <p>Measured image evidence, expected sky context, and predicted diagnostics remain distinct from the base image.</p>
                <div class="overlay-list sky-layer-controls">
                    <div class="overlay-group" role="group" aria-label="Measured layers"><p><strong>Measured</strong><span>Image-derived associations</span></p>
                        <button class="text-button refresh-measured-evidence" type="button" disabled="@(_layers is null || _layerLoading || _saving || _viewerOpen)" @onclick="RefreshMeasuredEvidenceAsync">@(_layerLoading ? "Reading measured evidence..." : "Refresh measured evidence")</button>
                        @if (!HasLayer(AstrometricDiagnosticPresentation.AssociationsLayer))
                        {
                            <label><input type="checkbox" disabled /><span class="layer-swatch stars"></span><span><strong>Measured stellar associations</strong><small>@(_astrometry?.DiagnosticsReason ?? "No compatible accepted result retained")</small></span></label>
                        }
                        @foreach (var layer in RetainedLayers("Measured")) { @LayerToggle(layer) }
                        @if (!HasLayer("MeasuredTransientTrails"))
                        {
                            <label><input type="checkbox" disabled /><span class="layer-swatch meteor"></span><span><strong>Measured transient trails</strong><small>@(_layers?.TrailEvidence?.Reason ?? (_layers?.TrailEvidence?.State == "NoRecordedCandidate" ? "No recorded candidate for this capture" : "Compatible measured trail evidence is unavailable"))</small></span></label>
                        }
                        @if (_layers?.TrailEvidence is { Trails.Count: > 0 } trailEvidence)
                        {
                            <p>Positional uncertainty unavailable. No uncertainty band is drawn.</p>
                            <ul class="source-list">
                                @foreach (var trail in trailEvidence.Trails)
                                {
                                    <li><a href="/transients/@trail.CandidateId.ToString("D")">@OperationsPage.SplitWords(trail.State)</a>
                                        <a href="/gallery/@trail.SourceManifest.Descriptor.Capture.CaptureId.ToString("D")">Capture #@trail.SourceManifest.Descriptor.Capture.CaptureSequence</a>
                                        <time datetime="@trail.DetectorInput.Source.ObservationStartedUtc.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@SiteTime.Format(trail.DetectorInput.Source.ObservationStartedUtc)</time>
                                    </li>
                                }
                            </ul>
                        }
                        <label><input type="checkbox" disabled /><span class="layer-swatch deep-sky"></span><span><strong>Deep-sky associations</strong><small>measured product not produced</small></span></label>
                    </div>
                    <div class="overlay-group" role="group" aria-label="Sky context layers"><p><strong>Sky context</strong><span>Expected projected geometry</span></p>
                        <a class="text-button" href="/operations/pipeline/graphs/new?section=scene-overlay#scene-overlay">Edit scene visibility, sizes and constellation style</a>
                        <a class="text-button" href="/operations/pipeline/graphs/new?section=legacy-annotation#legacy-annotation">Edit legacy Annotation styling</a>
                        <a class="text-button" href="/operations/pipeline/graphs/new?section=frame-facts#frame-facts">Edit Frame Facts corner templates</a>
                        @foreach (var layer in RetainedLayers("Sky context")) { @LayerToggle(layer) }
                        @if (!HasLayer("scene-annotation", "star-annotations")) { <label><input type="checkbox" disabled /><span class="layer-swatch stars"></span><span><strong>Sky annotations</strong><small>expected / not retained for this capture</small></span></label> }
                        @if (!HasLayer("scene-constellations", "constellations")) { <label><input type="checkbox" disabled /><span class="layer-swatch constellations"></span><span><strong>Constellation lines</strong><small>expected / not retained for this capture</small></span></label> }
                        @if (!HasLayer("scene-cardinals", "cardinal-directions")) { <label><input type="checkbox" disabled /><span class="layer-swatch cardinals"></span><span><strong>Cardinal directions</strong><small>configured rig geometry / not retained</small></span></label> }
                    </div>
                    <div class="overlay-group" role="group" aria-label="Diagnostics layers"><p><strong>Diagnostics</strong><span>Never a measured-visibility claim</span></p>
                        <a class="text-button" href="/operations/pipeline/graphs/new?section=weather-cloud-overlay#weather-cloud-overlay">Edit weather and cloud overlay</a>
                        <a class="text-button" href="/operations/pipeline/graphs/new?section=cloud-layer#cloud-layer">Edit existing cloud layer</a>
                        <a class="text-button" href="/operations/pipeline/graphs/new?section=environment-layer#environment-layer">Edit existing environment layer</a>
                        <label><input type="checkbox" disabled /><span class="layer-swatch expected"></span><span><strong>Expected, not detected</strong><small>diagnostic catalog positions / arrives with #526</small></span></label>
                        @if (!HasLayer(AstrometricDiagnosticPresentation.ResidualsLayer))
                        {
                            <label><input type="checkbox" disabled /><span class="layer-swatch residuals"></span><span><strong>Astrometric residuals</strong><small>@(_astrometry?.DiagnosticsReason ?? "No compatible accepted result retained")</small></span></label>
                        }
                        @if (!HasLayer(HVO.SkyMonitor.Processing.OrbitalTrackPresentation.LayerKind))
                        {
                            <label><input type="checkbox" disabled /><span class="layer-swatch satellites"></span><span><strong>Predicted satellite tracks</strong><small>No compatible prediction retained for this capture</small></span></label>
                        }
                        @foreach (var layer in RetainedLayers("Diagnostics")) { @LayerToggle(layer) }
                        @if (!HasLayer("cloud-mask", "cloud-labels")) { <label><input type="checkbox" disabled /><span class="layer-swatch cloud"></span><span><strong>Measured cloud assessment</strong><small>image analyzer / no layer retained, #1004</small></span></label> }
                        @if (!HasLayer("scene-image-circle", "image-circle")) { <label><input type="checkbox" disabled /><span class="layer-swatch boundary"></span><span><strong>Image geometry</strong><small>native coordinates / not retained</small></span></label> }
                        @if (!HasLayer("environment", "corner-annotations")) { <label><input type="checkbox" disabled /><span class="layer-swatch environment"></span><span><strong>Frame facts</strong><small>source and coordinate provenance / not retained</small></span></label> }
                    </div>
                </div>
                @if (_layers is not null && _presentation?.DisplayCapture?.CaptureId == _layers.CaptureId)
                {
                    <div class="overlay-actions">
                        <button class="text-button restore-layers" type="button" disabled="@(!ShowLayeredHero || !_layerInteractive)" @onclick="RestoreLayerDefaults">Restore profile defaults</button>
                        <div class="sky-layer-save"><button type="button" class="text-button" disabled="@(_saving || !ShowLayeredHero || !_layerInteractive)" title="Saves the base image with selected overlays as an immutable artifact, then downloads a display JPEG (at most 2048 pixels per side). Analysis is not rerun." @onclick="SaveSelectedStackAsync">@(_saving ? "Preparing image..." : "Download selected stack (display JPEG)")</button></div>
                    </div>
                    @if (_saveMessage is not null) { <p role="status" class="sky-layer-result">@_saveMessage <a href="@SavedArtifactUrl" download>Download JPEG again</a> <a href="@SavedOriginalUrl" download>Download original full-resolution stack</a></p> }
                    @if (_saveError is not null) { <p role="alert" class="sky-layer-result sky-layer-result--error">@_saveError</p> }
                }
                else { <p class="scene-unavailable">Selectable scene layers are unavailable for this image.</p> }
            </section>

            <section class="inspector-card astrometry-card" aria-labelledby="astrometry-heading" aria-busy="@(_astrometryLoading ? "true" : "false")">
                <header><div><p class="eyebrow">Measured image solution</p><h2 id="astrometry-heading">Astrometry</h2></div><span class="state-chip @AstrometryChipClass">@AstrometryStatus</span></header>
                @if (_astrometry?.Solution is { } solution)
                {
                    var assessment = solution.Assessment;
                    <p class="astrometry-reason">@assessment.Reason (@assessment.ReasonCode). Retained capture evidence; no calibration activation.</p>
                    <dl>
                        <div><dt>Projection basis</dt><dd>@(_astrometry.GeometryBasis ?? "Unavailable") / @_astrometry.ProjectionModel</dd></div>
                        <div><dt>Inliers / held-out</dt><dd>@(assessment.Quality is { } quality ? $"{quality.InlierCount} / {quality.VerificationCount}" : "Unavailable")</dd></div>
                        <div><dt>Fit / held-out RMS</dt><dd>@(solution.Residuals.FittingRmsPixels is { } fit ? FormattableString.Invariant($"{fit:0.####} / {solution.Residuals.VerificationRmsPixels:0.####} px") : "Unavailable")</dd></div>
                        <div><dt>Quality score</dt><dd>@(assessment.Quality is { } q ? FormattableString.Invariant($"{q.Score0To100:0.#} / 100 (engineering; not probability)") : "Unavailable")</dd></div>
                        <div><dt>Conditioning</dt><dd>@(solution.Residuals.Conditioning?.Status ?? "Unavailable")</dd></div>
                        <div><dt>Refraction</dt><dd>@assessment.RefractionModel</dd></div>
                        <div><dt>Capture midpoint UTC</dt><dd><time datetime="@assessment.Frame.MidpointUtc.ToString("O")">@assessment.Frame.MidpointUtc.ToString("O")</time></dd></div>
                        <div><dt>Coordinate model</dt><dd>@assessment.CoordinateModel; mean-of-date calculator</dd></div>
                    </dl>
                    <details class="astrometry-provenance"><summary>Capture-bound identities and uncertainty</summary>
                        <dl>
                            <div><dt>Capture / raw artifact</dt><dd><code>@_astrometry.CaptureId / @assessment.Frame.SourceArtifactId</code></dd></div>
                            <div><dt>Source descriptor / pixels</dt><dd><code>@assessment.Frame.SourceDescriptorSha256 / @assessment.Frame.SourcePayloadSha256</code></dd></div>
                            <div><dt>Solution identity</dt><dd><code>@solution.SolutionIdentitySha256</code></dd></div>
                            <div><dt>Measured identity</dt><dd><code>@solution.MeasuredIdentitySha256</code></dd></div>
                            <div><dt>Catalog package</dt><dd>@solution.CatalogPackage.CatalogId / @solution.CatalogPackage.PackageVersion / @solution.CatalogPackage.PackageKind</dd></div>
                            <div><dt>Catalog / selection identity</dt><dd><code>@assessment.CatalogIdentitySha256 / @assessment.CatalogSelectionIdentitySha256</code></dd></div>
                            <div><dt>Retained calibration</dt><dd>@_astrometry.CalibrationVersion <code>@assessment.CalibrationIdentitySha256</code></dd></div>
                            <div><dt>Readout identity</dt><dd><code>@solution.ReadoutIdentitySha256</code></dd></div>
                            <div><dt>Source output / horizontal flip</dt><dd>@_astrometry.WidthPixels × @_astrometry.HeightPixels / @_astrometry.HorizontalFlip</dd></div>
                            @if (_astrometry.SourceDescriptor?.Layout.Readout is { } readout)
                            {
                                <div><dt>Native / crop / bin</dt><dd>@readout.NativeWidth × @readout.NativeHeight; ROI @readout.RoiX, @readout.RoiY, @readout.RoiWidth × @readout.RoiHeight; bin @readout.BinX × @readout.BinY (@readout.BinningAlgorithm)</dd></div>
                            }
                            <div><dt>Exposure UTC</dt><dd>@assessment.Frame.ExposureStartUtc.ToString("O") — @assessment.Frame.ExposureEndUtc.ToString("O")</dd></div>
                            <div><dt>Uncertainty</dt><dd>@solution.UncertaintyReasonCode</dd></div>
                            @if (solution.Uncertainty is { } uncertainty)
                            {
                                <div><dt>Uncertainty model validity</dt><dd>@uncertainty.Validity.Status</dd></div>
                                @if (uncertainty.Estimate is { } estimate)
                                {
                                    <div><dt>Conditional estimate offset from accepted fit</dt><dd>@FormattableString.Invariant($"{estimate.OffsetFromAcceptedDegrees:0.########}°; focal ratio {estimate.FocalScaleOffsetFromAccepted:0.########}")</dd></div>
                                }
                                <div><dt>Conditional fit</dt><dd>@UncertaintyComponent(uncertainty.ConditionalFit)</dd></div>
                                <div><dt>Systematic</dt><dd>@UncertaintyComponent(uncertainty.Systematic)</dd></div>
                                <div><dt>Shared calibration</dt><dd>@UncertaintyComponent(uncertainty.SharedCalibration.Pose)</dd></div>
                                <div><dt>Total pose</dt><dd>@UncertaintyComponent(uncertainty.Total)</dd></div>
                                <div><dt>Clock source / synchronization</dt><dd>@uncertainty.Clock.Source / @uncertainty.Clock.Synchronization</dd></div>
                                <div><dt>Horizontal clock bound</dt><dd>@(uncertainty.ClockComponent.MaximumHorizontalRotationDegrees is { } bound ? FormattableString.Invariant($"≤ {bound:0.########}° (bound, not probability)") : uncertainty.ClockComponent.ReasonCode)</dd></div>
                            }
                        </dl>
                        <p>Pose uncertainties describe the retained conditional estimate. Fit and held-out RMS describe this capture only. Point uncertainty is withheld; no uncertainty band is inferred from RMS.</p>
                    </details>
                }
                else
                {
                    <p class="astrometry-reason">@AstrometryAbsence</p>
                }
                <form class="pixel-sky-calculator" @onsubmit="CalculatePixelToSky" @onsubmit:preventDefault>
                    <p><strong>Pixel to sky</strong><span>@CalculatorAvailability</span></p>
                    <div><label>X pixel<input type="number" step="any" min="0" disabled="@(!CanCalculate)" @bind="_pixelX" /></label><label>Y pixel<input type="number" step="any" min="0" disabled="@(!CanCalculate)" @bind="_pixelY" /></label><button class="button secondary small" type="submit" disabled="@(!CanCalculate)">Pixel to sky</button></div>
                </form>
                <form class="pixel-sky-calculator sky-pixel-calculator" @onsubmit="CalculateSkyToPixel" @onsubmit:preventDefault>
                    <p><strong>Sky to pixel</strong><span>Uses the same capture epoch, source readout, crop, binning, flip and aperture.</span></p>
                    <label>Coordinates<select @bind="_skyCoordinates" disabled="@(!CanCalculate)"><option value="equatorial">Equatorial (mean of date)</option><option value="horizontal">Horizontal (geometric)</option></select></label>
                    <div><label>@(_skyCoordinates == "horizontal" ? "Altitude degrees" : "RA hours")<input type="number" step="any" disabled="@(!CanCalculate)" @bind="_skyFirst" /></label><label>@(_skyCoordinates == "horizontal" ? "Azimuth degrees" : "Declination degrees")<input type="number" step="any" disabled="@(!CanCalculate)" @bind="_skySecond" /></label><button class="button secondary small" type="submit" disabled="@(!CanCalculate)">Sky to pixel</button></div>
                </form>
                @if (_calculatorResult is not null && CanCalculate) { <p role="status" class="astrometry-calculator-result">@_calculatorResult</p> }
            </section>

            <section class="inspector-card capture-facts current-sky-summary" aria-labelledby="acquisition-heading" aria-live="polite" aria-atomic="true" aria-busy="@(_refreshing ? "true" : "false")">
                <header><div><p class="eyebrow">Reference capture</p><h2 id="acquisition-heading">Acquisition</h2></div><span class="state-chip @FreshnessChipClass">@FreshnessLabel</span></header>
                @if (FactCapture is { } capture)
                {
                    <dl>
                        <div><dt>Exposure</dt><dd>@FormatExposure(_facts?.ExposureMilliseconds)</dd></div>
                        <div><dt>Gain</dt><dd>@(_facts?.Gain?.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable")</dd></div>
                        <div><dt>Exposure start</dt><dd><time datetime="@capture.ExposureStartedUtc.ToString("O")">@SiteTime.Format(capture.ExposureStartedUtc)</time></dd></div>
                        <div><dt>Sensor temperature</dt><dd>@(_facts?.SensorTemperatureC is { } temperature ? FormattableString.Invariant($"{temperature:0.#} C") : "Unavailable")</dd></div>
                        <div><dt>Dimensions</dt><dd>@(_facts is { Width: { } width, Height: { } height } ? $"{width} x {height}" : "Unavailable")</dd></div>
                        <div><dt>Presentation</dt><dd>@StageFactLabel</dd></div>
                        <div><dt>Display basis</dt><dd>@DisplayBasisLabel</dd></div>
                        <div><dt>Evidence</dt><dd>@EvidenceLabel(capture.EvidenceOrigin)</dd></div>
                        <div><dt>Observing night</dt><dd>@ObservingNightLabel</dd></div>
                        <div><dt>Cloud</dt><dd>@(_facts is { } cloudFacts ? FormatCloud(cloudFacts.Cloud) : "Unavailable")</dd></div>
                    </dl>
                    @if (!IsArchived) { <p class="summary-copy">@SummaryMessage</p> }
                    @if (_facts?.CombinedLineageUnavailable == true) { <p class="facts-unavailable" role="status">Combined stage lineage is not available in this bounded view.</p> }
                    @if (_factsUnavailableReason is not null) { <p class="facts-unavailable" role="status">@_factsUnavailableReason</p> }
                    @if (_presentation?.System.NextTransitionUtc is { } nextTransition) { <p class="next-transition">Next schedule transition <time datetime="@nextTransition.ToString("O")">@SiteTime.Format(nextTransition)</time>.</p> }
                    @if (!IsArchived) { <a class="inline-action layers-link" href="@DetailUrl">View immutable raw source</a> }
                }
                else
                {
                    <p class="summary-copy">@SummaryMessage</p>
                }
            </section>

            <section class="inspector-card rig-facts" aria-labelledby="rig-heading">
                <header><div><p class="eyebrow">Capture-time profile</p><h2 id="rig-heading">Rig and location</h2></div><span>@(_facts?.CaptureProfile is null ? "Not retained" : "Recorded")</span></header>
                <dl>
                    <div><dt>Sensor sample</dt><dd>@SensorSampleLabel</dd></div>
                    <div><dt>Optics</dt><dd>@OpticsLabel</dd></div>
                    <div><dt>Projection</dt><dd>@ProjectionLabel</dd></div>
                    <div><dt>Site</dt><dd class="@(_facts?.Location?.Availability == "Available" ? null : "fact-unavailable")">@SiteLabel
                        @if (_facts?.Location is { Availability: "Available", DeploymentVersion: { } version, TimeZoneId: { } zone })
                        { <small class="capture-location-provenance">@zone / recorded deployment v@(version)</small> }
                    </dd></div>
                    <div><dt>Profile</dt><dd>@(_facts?.ProcessingProfile is { } profile ? $"{profile.Name} / {profile.Version}" : "Unavailable")</dd></div>
                </dl>
            </section>
        </aside>
    </section>

    @if (!IsArchived)
    {
        @OperationsStrip
    }

    @if (UnavailableStageCount > 0 && _presentation?.DisplayCapture is not null)
    {
        <div class="state-notice" role="status">
            <strong>Partial image stages</strong>
            <span>@UnavailableStageCount stage@(UnavailableStageCount == 1 ? " is" : "s are") unavailable for this capture. Available controls always name the artifact they display.</span>
        </div>
    }
    @if (_presentation?.HistoryBoundReached == true)
    {
        <div class="state-notice" role="status">
            <strong>No displayable image found in bounded history</strong>
            <span>Open the Archive to inspect retained captures and technical evidence.</span>
        </div>
    }
</div>
}

@code {
    private RenderFragment OperationsStrip => __builder =>
    {
        <section class="operations-strip" aria-label="@(IsArchived ? "Historical capture evidence" : "Current CameraAgent operations")">
            <article><span class="metric-icon capture"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h3l2-2h6l2 2h3v11H4V7Z"></path><circle cx="12" cy="12.5" r="3.5"></circle></svg></span><div><small>Acquisition</small><strong>@(IsArchived ? ArchivedView!.Capture.RawState : SystemLabel)</strong><span>@(_presentation?.LatestCapture is { } acquired ? $"{(IsArchived ? "Selected" : "Latest")} capture #{acquired.CaptureSequence}" : "No durable capture yet")</span></div></article>
            <article><span class="metric-icon processing"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2 4 4 .5-3 3 .8 4.5-3.8-2-3.8 2 .8-4.5-3-3L10 7l2-4Z"></path></svg></span><div><small>Processing</small><strong>@ProcessingStripLabel</strong><span>@(_liveExecutionId is null ? "Run link unavailable" : $"Run for capture #{FactCapture?.CaptureSequence}")</span></div></article>
            <article><span class="metric-icon transient"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 19 5-6 3 2 6-10M6 6l1 2 2 1-2 1-1 2-1-2-2-1 2-1 1-2Z"></path></svg></span><div><small>Transient lane</small><strong>@TransientOutcomeLabel</strong><span>@TransientOutcomeReason</span></div></article>
            <article><span class="metric-icon delivery"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h12m-5-5 5 5-5 5M5 5v14"></path></svg></span><div><small>Central delivery</small><strong>@CentralStatusLabel</strong><span>@CentralStatusReason</span></div></article>
        </section>
    };

    private RenderFragment LayerToggle(CameraAgentPresentationLayer layer) => __builder =>
    {
        <label><input type="checkbox" disabled="@(!ShowLayeredHero || !_layerInteractive || layer.Satellite is { Renderable: false })" checked="@_selectedLayers.Contains(layer.IdentitySha256)" @onchange="args => SelectLayer(layer.IdentitySha256, args.Value is true)" data-layer-target="@layer.DomGroupId" data-layer-identity="@layer.IdentitySha256" /><span class="layer-swatch @layer.Kind"></span><span><strong>@LayerLabel(layer.Kind)</strong><small>@LayerDescription(layer.Kind) @SatelliteDescription(layer.Satellite)</small></span></label>
    };
}
