@page "/transients/{CandidateId:guid}"
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Event evidence</PageTitle>

<div class="transient-detail archive-main">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="@BackUrl">Detected events</a><span>/</span><span aria-current="page">Candidate evidence</span></nav>
    @if (_isLoading)
    {
        <header class="event-detail-heading"><h1>Event evidence</h1></header>
        <section class="detail-state" role="status"><strong>Loading retained candidate evidence</strong></section>
    }
    else if (_errorMessage is not null || _detail is null || _evidence is null)
    {
        <header class="event-detail-heading"><h1>Event evidence</h1></header>
        <section class="detail-state detail-state--error" role="alert"><div><strong>Candidate unavailable</strong><p>@(_errorMessage ?? "The requested transient candidate was not found.")</p></div><a class="btn btn-outline-light" href="@BackUrl">Return to events</a></section>
    }
    else
    {
        <header class="event-detail-heading">
            <div><p class="eyebrow">Events / Local evidence / Local camera</p><h1>@CameraAgentEventFacts.Title(_detail.AssessmentEvidence)</h1><p>@FormatTime(_evidence.RecordedUtc) · @(_evidence.Reference?.Source is null ? "Candidate recorded time; observation time unavailable" : "Source observation time")<br />Causal evidence: @_detail.CausalEvidence.State · Centered context: @(_detail.CenteredEvidence.CenteredContextConverged == true ? "Converged receipt" : "Incomplete or unavailable") · Owner review unavailable</p></div>
            <div class="event-detail-status"><span class="classification-chip @CameraAgentEventFacts.ClassificationKey(_detail.AssessmentEvidence)">@CameraAgentEventFacts.Classification(_detail.AssessmentEvidence)</span><span>Local candidate</span></div>
        </header>
        <div class="event-media-tabs" role="tablist" aria-label="Event evidence media" aria-describedby="event-media-reason">
            <button type="button" role="tab" aria-selected="false" aria-controls="event-media-panel" disabled>Centered animation</button><button type="button" role="tab" aria-selected="false" aria-controls="event-media-panel" disabled>Path composite</button><button type="button" role="tab" aria-selected="false" aria-controls="event-media-panel" disabled>Detection mask</button>
        </div>
        <section class="event-media-layout">
            <div id="event-media-panel" class="event-media-view" aria-label="Extracted event media unavailable"><div class="event-media-unavailable"><h2>Event media not produced</h2><p id="event-media-reason">No exact retained animation, path composite, or detection-mask artifact is exposed by this candidate's local evidence. Source frames remain available in the context panel.</p></div></div>
            <aside class="event-context">
                <h2>Centered context</h2><p>Exact receipt source identities, ordered around the candidate endpoint. A causal three-frame window is not a complete five-frame centered window.</p>
                <div class="context-frame-list">
                    @foreach (var frame in _evidence.Frames)
                    {
                        <div class="context-frame @(frame.Position == 0 ? "reference" : null) @(frame.Source is null ? "unavailable" : null)">
                            @if (frame.Image is { } image) { <img src="@image.PreviewUrl" alt="Exact source at @frame.PositionLabel" loading="lazy" /> }
                            else { <span class="context-frame-placeholder">Unavailable</span> }
                            <div><strong>@frame.PositionLabel</strong>
                                @if (frame.Source is { } source)
                                {
                                    <small>@LocalTime(source.ObservationStartedUtc)</small><a href="/gallery/@source.CaptureId.ToString("D")">Capture #@source.CaptureSequence</a>
                                    @if (frame.ExecutionId is { } executionId) { <a href="@RunUrl(executionId)">Pipeline run</a> }
                                    else { <small>Run link not recorded</small> }
                                }
                                else { <small>No exact retained source identity</small> }
                            </div><span>@Offset(frame)</span>
                        </div>
                    }
                </div>
                <a class="context-day-link" href="@NearbyUrl">Captures from this observing day →</a>
            </aside>
        </section>
        <section class="science-grid" aria-label="Scientific evidence">
            <article class="science-panel"><header><h2>Observed measurements</h2><span>Direct detector evidence</span></header><dl class="science-facts">
                <div><dt>Duration <i class="science-value-kind unresolved">Unresolved</i></dt><dd>Not measured</dd></div><div><dt>Angular path <i class="science-value-kind unresolved">Unresolved</i></dt><dd>Not recorded</dd></div>
                <div><dt>Start / end direction <i class="science-value-kind unresolved">Unresolved</i></dt><dd>No retained astrometric measurement</dd></div><div><dt>Angular velocity <i class="science-value-kind unresolved">Unresolved</i></dt><dd>No retained timing and astrometry</dd></div>
                <div><dt>Pixel path length <i class="science-value-kind">Measured</i></dt><dd>@Number(_detail.CandidateEvidence.Features?.LengthPixels, "px")</dd></div><div><dt>Peak signal <i class="science-value-kind">Measured</i></dt><dd>@(_detail.CandidateEvidence.Features is { } signal ? $"{signal.PeakSignalAdu} ADU" : "Not recorded")</dd></div>
                <div class="full"><dt>Measurement limits</dt><dd>Exposure and context spans are not event duration. Pixel length does not establish angular motion. @(_detail.CandidateEvidence.Features is { } features ? $"{features.SaturatedSampleCount} saturated detector samples recorded." : "Saturation evidence not recorded.")</dd></div>
            </dl></article>
            <article class="science-panel"><header><h2>Derived estimates</h2><span>Retained local assessment</span></header><dl class="science-facts">
                <div><dt>Classification <i class="science-value-kind derived">Inferred</i></dt><dd>@CameraAgentEventFacts.Classification(_detail.AssessmentEvidence)</dd></div><div><dt>Confidence <i class="science-value-kind derived">Score</i></dt><dd>@CameraAgentEventFacts.Confidence(_detail.AssessmentEvidence)</dd></div>
                <div><dt>Apparent magnitude <i class="science-value-kind unresolved">Unresolved</i></dt><dd>Not calibrated</dd></div><div><dt>Photometric method <i class="science-value-kind unresolved">Unresolved</i></dt><dd>No retained photometric estimate</dd></div>
                <div class="full"><dt>Method and authority</dt><dd>Retained assessment · @(_detail.AssessmentEvidence.Authority ?? "authority not recorded"). Method: @FormatList(_detail.AssessmentEvidence.Methods). The score is not a calibrated probability or owner review. Uncertainty is not recorded.</dd></div>
            </dl></article>
            <article class="science-panel"><header><h2>Physical trajectory</h2><span>Single-camera limitation</span></header><div class="trajectory-unresolved">No correlated physical trajectory</div><dl class="science-facts">
                @foreach (var quantity in new[] { "Physical speed", "Event altitude", "Ground track", "Impact location" }) { <div><dt>@quantity <i class="science-value-kind unresolved">Unresolved</i></dt><dd>Requires genuine correlation</dd></div> }
            </dl></article>
        </section>
        <section class="satellite-assessment archive-panel" aria-labelledby="orbital-heading"><header><div><h2 id="orbital-heading">Orbital match evidence</h2><p>Unavailable. No exact orbital-correlation assessment is retained for this candidate.</p></div><span class="hvo-chip">Not produced</span></header><p>Predicted geometry alone cannot establish optical visibility or reject a local candidate.</p><button class="btn btn-outline-light" type="button" disabled aria-describedby="orbital-reason">Inspect orbital assessment</button><p id="orbital-reason">Orbital assessment is not available on this camera.</p></section>
        <section class="event-review-grid">
            <article class="archive-panel"><header><div><h2>Review &amp; classification</h2><p>LogicHost owns authoritative review and its append-only history. CameraAgent preserves immutable local evidence.</p></div><span class="hvo-chip">Review unavailable</span></header><div class="event-review-actions"><button class="btn btn-outline-light" type="button" disabled aria-describedby="owner-review-reason">Review candidate</button><button class="btn btn-outline-light" type="button" disabled aria-describedby="owner-review-reason">Revise classification</button><a class="btn btn-outline-light" href="@ObservingDayUrl">Observing day</a></div><p id="owner-review-reason" class="ops-note-banner">No central owner-review identity or supported review destination is recorded locally. Local @_detail.Candidate.EventState workflow does not establish owner confirmation or rejection.</p></article>
            <article class="archive-panel"><header><div><h2>Evidence provenance</h2><p>Technical identity remains secondary.</p></div><span>Retained local record</span></header><ul class="evidence-list"><li><strong>Candidate ID</strong><span><code>@_detail.Candidate.CandidateId</code></span></li><li><strong>Event ID</strong><span><code>@_detail.Candidate.EventId</code></span></li><li><strong>Assessment ID</strong><span><code>@FormatGuid(_detail.AssessmentEvidence.AssessmentId)</code></span></li><li><strong>Detector methods</strong><span>@FormatList(_detail.CausalEvidence.Methods)</span></li><li><strong>Extraction identity</strong><span><code>@(_detail.CenteredEvidence.IdentitySha256 ?? _detail.CausalEvidence.IdentitySha256 ?? "Not recorded")</code></span></li>
                @if (_evidence.Reference?.Capture is { } reference)
                {
                    <li><strong>Rig profile identity</strong><span><code>@(reference.Capture.RigId ?? "Not recorded")</code></span></li>
                    <li><strong>Processing profile</strong><span><code>@(reference.Capture.Detail?.ProcessingProfile?.Sha256 ?? "Not recorded")</code></span></li>
                    @if (reference.Capture.Artifacts.SingleOrDefault(artifact => artifact.ArtifactId == _evidence.Reference.Source?.ArtifactId) is { } sourceArtifact) { <li><strong>Source checksum SHA-256</strong><span><code>@sourceArtifact.ChecksumSha256</code></span></li> }
                }
            </ul></article>
        </section>
        <details class="local-stage-evidence archive-panel"><summary>Local workflow and evidence receipts</summary><section class="stage-grid" aria-label="Transient evidence stages">
            <article><h2>Candidate evidence</h2><p>@_detail.CandidateEvidence.State · @_detail.CandidateEvidence.ContextSourceCount context sources</p><p>@FormatList(_detail.CandidateEvidence.ReasonCodes)</p>@if (_detail.CandidateEvidence.Geometry is { } geometry) { <p>@geometry.CoordinateWidth × @geometry.CoordinateHeight detector coordinates · @FormatBounds(geometry)</p> }</article>
            <article><h2>Causal window</h2><p>Evidence state: @_detail.CausalEvidence.State.</p><p>@_detail.CausalEvidence.SourceCount ordered sources · Centered context converged: @FormatBoolean(_detail.CausalEvidence.CenteredContextConverged)</p><code>@_detail.CausalEvidence.IdentitySha256</code></article>
            <article><h2>Centered window</h2><p>Evidence state: @_detail.CenteredEvidence.State.</p><p>@_detail.CenteredEvidence.SourceCount ordered sources · Centered context converged: @FormatBoolean(_detail.CenteredEvidence.CenteredContextConverged)</p><code>@_detail.CenteredEvidence.IdentitySha256</code></article>
            <article><h2>Assessment</h2><p>Evidence state: @_detail.AssessmentEvidence.State.</p><p>@FormatList(_detail.AssessmentEvidence.ReasonCodes)</p><code>@_detail.AssessmentEvidence.IdentitySha256</code></article>
            <article><h2>Final evidence</h2><p>Evidence state: @_detail.FinalEvidence.State · Local @_detail.FinalEvidence.EventState</p><dl><div><dt>First / last source observation</dt><dd>@FormatTime(_detail.FinalEvidence.FirstObservedUtc) / @FormatTime(_detail.FinalEvidence.LastObservedUtc)</dd></div><div><dt>Receipt identity SHA-256</dt><dd><code>@_detail.FinalEvidence.ReceiptIdentitySha256</code></dd></div></dl></article>
        </section></details>
    }
</div>
