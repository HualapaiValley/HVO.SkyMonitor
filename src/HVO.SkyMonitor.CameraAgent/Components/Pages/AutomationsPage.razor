@page "/operations/automations"
@layout OperationsLayout
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Common.Automation
@using HVO.SkyMonitor.CameraAgent.Common.Environmental
@using HVO.SkyMonitor.CameraAgent.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Automations</PageTitle>

<div class="automations-page">
    <PageHeader Eyebrow="Registered local tasks" Title="Automations" Lead="Every automated behaviour this CameraAgent runs on its own, with the durable state that drives it. Only registered task and trigger kinds appear here; nothing on this page executes arbitrary commands.">
        <button class="btn btn-outline-light" disabled="@_loading" @onclick="LoadAsync">Refresh</button>
    </PageHeader>

    @if (_loading)
    {
        <PageStateNotice Kind="PageStateNotice.PageStateKind.Loading" Title="Loading registered automations" Message="Reading the capture schedule and environmental source state." />
    }
    else
    {
        @if (_schedule is null && _environment is null && _automation is null)
        {
            <PageStateNotice Kind="PageStateNotice.PageStateKind.Error" Title="Automations unavailable" Message="@(_message ?? "Neither the capture schedule, the environmental sources, nor the local automations could be read.")">
                <button type="button" class="btn btn-outline-light" disabled="@_loading" @onclick="LoadAsync">Try again</button>
            </PageStateNotice>
        }
        else if (_message is not null)
        {
            <PageStateNotice Kind="PageStateNotice.PageStateKind.Stale" Title="Showing partial data" Message="@_message" />
        }

        <section class="automation-grid" aria-label="Registered automations">
            @if (_schedule is not null)
            {
                <article class="automation-card automation-card--wide" aria-labelledby="automation-schedule">
                    <header>
                        <div><p class="eyebrow">Exposure-admission authority</p><h2 id="automation-schedule">Capture schedule</h2></div>
                        <span class="state-chip @(_schedule.Decision.Admitted ? "state-chip--open" : "state-chip--closed")">@(_schedule.Decision.Admitted ? "Open" : "Closed")</span>
                    </header>
                    <dl class="fact-grid">
                        <div><dt>Active revision</dt><dd>Revision @_schedule.ActiveRevision.RevisionNumber</dd></div>
                        <div><dt>Reason</dt><dd>@Split(_schedule.Decision.Reason.ToString())</dd></div>
                        <div><dt>Next transition</dt><dd>@FormatUtc(_schedule.Decision.NextTransitionUtc)</dd></div>
                        <div><dt>Weekly windows</dt><dd>@_schedule.ActiveRevision.Definition.WeeklyWindows.Count</dd></div>
                        <div><dt>Date exceptions</dt><dd>@(_schedule.ActiveRevision.Definition.DateExceptions?.Count ?? 0)</dd></div>
                        <div><dt>Blackouts</dt><dd>@(_schedule.ActiveRevision.Definition.Blackouts?.Count ?? 0)</dd></div>
                        <div><dt>Active overrides</dt><dd>@_schedule.Overrides.Count</dd></div>
                        <div><dt>Setpoint profiles</dt><dd>@string.Join(", ", _schedule.ActiveRevision.Definition.SetpointProfiles.Select(static profile => profile.Id))</dd></div>
                    </dl>
                    <h3>Next scheduled activity</h3>
                    @if (_schedule.Preview.Intervals.Count == 0)
                    {
                        <p class="empty-copy">No open or closed intervals occur in the current preview range.</p>
                    }
                    else
                    {
                        <ol class="calendar-list">
                            @foreach (var interval in _schedule.Preview.Intervals.Take(MaximumIntervals))
                            {
                                <li>
                                    <strong>@(interval.SetpointProfileId ?? "Closed")</strong>
                                    <span>@Split(interval.Source.ToString())</span>
                                    <time datetime="@interval.StartUtc.ToString("O")">@interval.StartUtc.ToString("u")</time>
                                    <time datetime="@interval.EndUtc.ToString("O")">@interval.EndUtc.ToString("u")</time>
                                </li>
                            }
                        </ol>
                    }
                    <a class="inline-link" href="/operations/schedule">Edit the capture schedule</a>
                </article>
            }

            @if (_environment is not null)
            {
                <article class="automation-card automation-card--wide" aria-labelledby="automation-environment">
                    <header>
                        <div><p class="eyebrow">Environmental acquisition</p><h2 id="automation-environment">Source acquisition tasks</h2></div>
                        <span class="state-chip @(_environment.Enabled ? "state-chip--open" : "state-chip--closed")">@(_environment.Enabled ? "Enabled" : "Disabled")</span>
                    </header>
                    @if (_environment.Sources.Count == 0)
                    {
                        <p class="empty-copy">No environmental sources are registered in the startup configuration.</p>
                    }
                    else
                    {
                        <ul class="task-list">
                            @foreach (var source in _environment.Sources)
                            {
                                <li>
                                    <div><strong>@source.Id</strong><span>@Split(source.Kind.ToString()) / @(source.Required ? "required" : "optional") / @(source.SupportsOnDemand ? "on demand available" : "polling only")</span></div>
                                    <dl>
                                        <div><dt>Next poll</dt><dd>@FormatUtc(source.NextPollUtc)</dd></div>
                                        <div><dt>Freshness</dt><dd>@Split(source.Freshness)</dd></div>
                                        <div><dt>Last outcome</dt><dd>@(source.LastDisposition is null ? "None yet" : Split(source.LastDisposition.ToString()!))</dd></div>
                                        <div><dt>Consecutive failures</dt><dd>@source.ConsecutiveFailures</dd></div>
                                    </dl>
                                </li>
                            }
                        </ul>
                    }
                    <a class="inline-link" href="/operations/environment">Review environmental history</a>
                </article>
            }

            <article class="automation-card" aria-labelledby="automation-triggers">
                <header><div><p class="eyebrow">Registered vocabulary</p><h2 id="automation-triggers">Environmental acquisition trigger kinds</h2></div></header>
                <p>Environmental acquisition may only be started by these registered triggers. They are the source's own vocabulary, driven by the capture lane. Local automation definitions use their own separate trigger vocabulary, shown in the editor below.</p>
                <ul class="trigger-list">
                    @foreach (var trigger in Enum.GetValues<EnvironmentalAcquisitionTrigger>())
                    {
                        <li>@Split(trigger.ToString())</li>
                    }
                </ul>
            </article>

            <article class="automation-card automation-card--wide" aria-labelledby="automation-definitions">
                <header>
                    <div><p class="eyebrow">Versioned local contract</p><h2 id="automation-definitions" tabindex="-1">Local automation definitions</h2></div>
                    @if (_automation is not null)
                    {
                        <span class="state-chip state-chip--readonly">@_automation.Definitions.Count of @LocalAutomationContract.MaximumDefinitions</span>
                    }
                </header>
                @if (_automation is null)
                {
                    <p class="empty-copy">The local automation store could not be read, so definitions and run history are unavailable.</p>
                }
                else
                {
                    <p class="truth-note">Every definition names one registered task kind and one registered trigger kind. Nothing on this page runs a command, a script, or a path, and no definition can express one. Saving records an immutable revision; the runner never admits an exposure and never changes capture timing.</p>
                    @if (_commandMessage is not null && !_confirming)
                    {
                        @* While the modal is open the same notice is announced inside it instead. *@
                        <p class="truth-note @(_commandMessageIsError ? "automation-error" : "automation-ok")" role="@(_commandMessageIsError ? "alert" : "status")">@_commandMessage</p>
                    }

                    <h3>Registered tasks</h3>
                    <ul class="task-list">
                        @foreach (var descriptor in _automation.Registry)
                        {
                            <li>
                                <div><strong>@Split(descriptor.TaskKind.ToString())</strong><span>@(descriptor.Available ? "available" : descriptor.UnavailableReason)</span></div>
                                <dl>
                                    <div><dt>Compatible triggers</dt><dd>@string.Join(", ", descriptor.CompatibleTriggers.Select(static trigger => Split(trigger.ToString())))</dd></div>
                                    <div><dt>Targets</dt><dd>@(descriptor.Targets.Count == 0 ? "None registered" : string.Join(", ", descriptor.Targets))</dd></div>
                                </dl>
                            </li>
                        }
                    </ul>

                    <h3>Definitions</h3>
                    @if (_automation.Definitions.Count == 0)
                    {
                        <p class="empty-copy">No local automation is defined on this CameraAgent.</p>
                    }
                    else
                    {
                        <div class="table-scroll">
                            <table class="facts-table">
                                <caption class="visually-hidden">Local automation definitions</caption>
                                <thead><tr><th scope="col">Identifier</th><th scope="col">Name</th><th scope="col">State</th><th scope="col">Task</th><th scope="col">Trigger</th><th scope="col">Version</th><th scope="col">Next run</th><th scope="col">Last run</th><th scope="col">Actions</th></tr></thead>
                                <tbody>
                                    @foreach (var definition in _automation.Definitions)
                                    {
                                        <tr @key="definition.Definition.DefinitionId">
                                            <th scope="row">@definition.Definition.DefinitionId</th>
                                            <td>@definition.Definition.Name</td>
                                            <td>@(definition.Definition.Enabled ? "Enabled" : "Disabled")</td>
                                            <td>@Split(definition.Definition.TaskKind.ToString()) / @definition.Definition.TaskTarget</td>
                                            <td>@Split(definition.Definition.TriggerKind.ToString()) every @definition.Definition.TriggerInterval @(definition.Definition.TriggerKind == LocalAutomationTriggerKind.Periodic ? "s" : "captures")</td>
                                            <td>@definition.Version</td>
                                            <td>@DescribeNextRun(definition)</td>
                                            <td>@(definition.LastRun is null ? "None yet" : $"{Split(definition.LastRun.Outcome.ToString())} at {definition.LastRun.StartedAtUtc:u}")</td>
                                            <td class="row-actions">
                                                <button id="@EditTriggerId(definition)" type="button" class="btn btn-outline-light" aria-label="Edit @definition.Definition.DefinitionId" disabled="@(_busy || _loading)" @onclick="() => BeginEdit(definition)">Edit</button>
                                                <button id="@ToggleTriggerId(definition)" type="button" class="btn btn-outline-light" aria-label="@(definition.Definition.Enabled ? "Disable" : "Enable") @definition.Definition.DefinitionId" disabled="@(_busy || _loading)" @onclick="() => BeginToggle(definition)">@(definition.Definition.Enabled ? "Disable" : "Enable")</button>
                                                <button id="@RemoveTriggerId(definition)" type="button" class="btn btn-outline-light" aria-label="Remove @definition.Definition.DefinitionId" disabled="@(_busy || _loading)" @onclick="() => BeginRemove(definition)">Remove</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <h3>Recorded revisions</h3>
                        @foreach (var definition in _automation.Definitions)
                        {
                            <details class="revision-history" @key="definition.Definition.DefinitionId">
                                <summary>@definition.Definition.DefinitionId &mdash; @definition.History.Count retained of @LocalAutomationContract.MaximumProjectedRevisions shown</summary>
                                <div class="table-scroll">
                                    <table class="facts-table">
                                        <caption class="visually-hidden">Recorded revisions of @definition.Definition.DefinitionId, newest first</caption>
                                        <thead><tr><th scope="col">Version</th><th scope="col">Recorded</th><th scope="col">Actor</th><th scope="col">State</th><th scope="col">Task</th><th scope="col">Trigger</th><th scope="col">Reason</th><th scope="col">Revision</th></tr></thead>
                                        <tbody>
                                            @foreach (var revision in definition.History)
                                            {
                                                <tr @key="revision.Version">
                                                    <th scope="row">@revision.Version</th>
                                                    <td>@revision.RecordedAtUtc.ToString("u")</td>
                                                    <td>@revision.Actor</td>
                                                    <td>@(revision.Removed ? "Removed" : revision.Definition.Enabled ? "Enabled" : "Disabled")</td>
                                                    <td>@revision.Definition.TaskTarget</td>
                                                    <td>@Split(revision.Definition.TriggerKind.ToString()) / @revision.Definition.TriggerInterval</td>
                                                    <td>@(revision.Reason ?? "Not recorded")</td>
                                                    <td class="mono">@revision.RevisionSha256[..12]</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        }
                    }

                    <h3 id="automation-editor" tabindex="-1">@(_editingVersion == 0 ? "Define an automation" : $"Edit {_idInput}")</h3>
                    <fieldset class="automation-form" disabled="@(_busy || _loading)">
                        <legend class="visually-hidden">Local automation definition</legend>
                        <div class="automation-field">
                            <label for="automation-id">Identifier</label>
                            <input id="automation-id" class="form-control" autocomplete="off" readonly="@(_editingVersion != 0)" @bind="_idInput" @bind:after="FormChanged" />
                        </div>
                        <div class="automation-field">
                            <label for="automation-name">Name</label>
                            <input id="automation-name" class="form-control" autocomplete="off" @bind="_nameInput" @bind:after="FormChanged" />
                        </div>
                        <div class="automation-field">
                            <label for="automation-task">Registered task</label>
                            <select id="automation-task" class="form-select" @bind="_taskKindInput" @bind:after="FormChanged">
                                @foreach (var descriptor in _automation.Registry)
                                {
                                    <option value="@descriptor.TaskKind">@Split(descriptor.TaskKind.ToString())</option>
                                }
                            </select>
                        </div>
                        <div class="automation-field">
                            <label for="automation-target">Task target</label>
                            <select id="automation-target" class="form-select" @bind="_targetInput" @bind:after="FormChanged">
                                <option value="">Select a registered target</option>
                                @foreach (var target in Targets())
                                {
                                    <option value="@target">@target</option>
                                }
                            </select>
                        </div>
                        <div class="automation-field">
                            <label for="automation-trigger">Registered trigger</label>
                            <select id="automation-trigger" class="form-select" @bind="_triggerKindInput" @bind:after="FormChanged">
                                @foreach (var trigger in CompatibleTriggers())
                                {
                                    <option value="@trigger">@Split(trigger.ToString())</option>
                                }
                            </select>
                        </div>
                        <div class="automation-field">
                            <label for="automation-interval">@(_triggerKindInput == LocalAutomationTriggerKind.Periodic ? "Interval (seconds)" : "Interval (captures)")</label>
                            <input id="automation-interval" class="form-control" inputmode="numeric" autocomplete="off" @bind="_intervalInput" @bind:after="FormChanged" />
                        </div>
                        <div class="automation-field automation-field--check">
                            <input id="automation-enabled" class="form-check-input" type="checkbox" @bind="_enabledInput" @bind:after="FormChanged" />
                            <label for="automation-enabled">Enabled</label>
                        </div>
                        <div class="automation-field automation-field--wide">
                            <label for="automation-reason">Reason (recorded with the revision)</label>
                            <input id="automation-reason" class="form-control" autocomplete="off" @bind="_reasonInput" @bind:after="FormChanged" />
                        </div>
                    </fieldset>
                    <div class="automation-actions">
                        <button id="@SaveTriggerId" type="button" class="btn btn-primary" disabled="@(_busy || _loading)" @onclick="BeginSave">Save automation</button>
                        @if (_editingVersion != 0)
                        {
                            <button type="button" class="btn btn-outline-light" disabled="@(_busy || _loading)" @onclick="ResetForm">Cancel edit</button>
                        }
                    </div>
                }
            </article>

            @if (_automation is not null)
            {
                <article class="automation-card" aria-labelledby="automation-calendar">
                    <header><div><p class="eyebrow">Wall-clock occurrences</p><h2 id="automation-calendar">Next-run calendar</h2></div></header>
                    @if (_automation.Calendar.Count == 0)
                    {
                        <p class="empty-copy">No enabled definition uses a wall-clock trigger, so no calendar entry is due. Capture-relative definitions appear in the definitions table with their next capture sequence.</p>
                    }
                    else
                    {
                        <ol class="calendar-list">
                            @foreach (var entry in _automation.Calendar)
                            {
                                <li @key="entry.DefinitionId">
                                    <strong>@entry.Name</strong>
                                    <span>@entry.TaskTarget</span>
                                    <time datetime="@entry.DueUtc.ToString("O")">@entry.DueUtc.ToString("u")</time>
                                    <span>@Split(entry.TaskKind.ToString())</span>
                                </li>
                            }
                        </ol>
                    }
                </article>

                <article class="automation-card automation-card--wide" aria-labelledby="automation-runs">
                    <header>
                        <div><p class="eyebrow">Durable journal</p><h2 id="automation-runs">Run history</h2></div>
                        @if (_automation.ObservedCaptureSequence is { } observed)
                        {
                            <span class="state-chip state-chip--readonly">Capture sequence @observed</span>
                        }
                    </header>
                    @if (_automation.Runs.Count == 0)
                    {
                        <p class="empty-copy">No automation run has been recorded on this CameraAgent.</p>
                    }
                    else
                    {
                        <div class="table-scroll">
                            <table class="facts-table">
                                <caption class="visually-hidden">The @LocalAutomationContract.MaximumProjectedRuns most recent recorded automation runs across all definitions, newest first</caption>
                                <thead><tr><th scope="col">Started</th><th scope="col">Automation</th><th scope="col">Trigger</th><th scope="col">Scheduled for</th><th scope="col">Outcome</th><th scope="col">Detail</th><th scope="col">Revision</th></tr></thead>
                                <tbody>
                                    @foreach (var run in _automation.Runs)
                                    {
                                        <tr @key="run.Sequence">
                                            <th scope="row">@run.StartedAtUtc.ToString("u")</th>
                                            <td>@run.DefinitionId</td>
                                            <td>@Split(run.TriggerKind.ToString())</td>
                                            <td>@run.ScheduledForUtc.ToString("u")</td>
                                            <td>@Split(run.Outcome.ToString())</td>
                                            <td>@(run.Detail.Length == 0 ? "Running" : run.Detail)</td>
                                            <td class="mono">@run.RevisionSha256[..12]</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </article>
            }

            @if (_confirming)
            {
                <dialog class="confirmation-panel" aria-labelledby="automation-confirm-heading" aria-describedby="automation-confirm-description"
                        @oncancel="CancelCommand" @ref="_confirmationDialog">
                    <div>
                        <p class="eyebrow">Durable automation confirmation</p>
                        <h2 id="automation-confirm-heading">@ConfirmationHeading()</h2>
                        <p id="automation-confirm-description">@ConfirmationDescription()</p>
                        @if (_commandMessage is not null)
                        {
                            @* The open modal makes the card behind it inert, so the outcome has to be announced here. *@
                            <p class="truth-note @(_commandMessageIsError ? "automation-error" : "automation-ok")" role="alert">@_commandMessage</p>
                        }
                    </div>
                    <div><button type="button" class="btn btn-primary" disabled="@_busy" @onclick="ConfirmCommandAsync">Confirm</button><button type="button" class="btn btn-outline-light" disabled="@_busy" autofocus @onclick="CancelCommand">Cancel</button></div>
                </dialog>
            }
        </section>
    }
</div>
