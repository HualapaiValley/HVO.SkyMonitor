@page "/operations/automations"
@layout OperationsLayout
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Components.Operations
@using HVO.SkyMonitor.CameraAgent.Common.Automation
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Automations</PageTitle>

<OperationsPageHeading Eyebrow="Automation / typed scheduled work" Title="Automations" HeadingId="automations-heading"
                       Description="Generate observing-day products and perform bounded maintenance through registered task types, explicit triggers, and durable run history.">
    <Actions>
        <button type="button" id="automation-refresh" class="icon-button" aria-label="Refresh" title="Refresh" disabled="@_loading" @onclick="LoadAsync">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15.5 7A6 6 0 1 0 16 11"></path><path d="M16 3.5V7h-3.5"></path></svg>
        </button>
        <button type="button" id="@CreateTriggerId" class="button primary" title="@CreateUnavailableReason"
                aria-describedby="@(CreateUnavailableReason is null ? null : "automation-create-reason")"
                disabled="@(CreateUnavailableReason is not null || _busy || _loading)" @onclick="OpenCreate">Create automation</button>
        @if (CreateUnavailableReason is not null)
        {
            <span id="automation-create-reason" class="visually-hidden">@CreateUnavailableReason</span>
        }
    </Actions>
</OperationsPageHeading>

<div class="ops-note-banner" role="status"><span class="status-icon success" aria-hidden="true"></span><span><strong>Capture Schedule remains separate.</strong> Capture Schedule admits exposures; Automations consume durable data or perform explicitly supported maintenance after defined boundaries. <a class="automation-link" href="/operations/schedule">Open Capture Schedule</a></span></div>

@if (_loading && _automation is null)
{
    <div class="ops-note-banner" role="status"><span class="status-icon running" aria-hidden="true"></span><span>Loading local automations.</span></div>
}
else if (_automation is null)
{
    <div class="ops-note-banner" role="alert"><span class="status-icon failure" aria-hidden="true"></span><span><strong>Automations unavailable.</strong> @_error</span></div>
}
else
{
    var automation = _automation;
    @if (_error is not null)
    {
        <div class="ops-note-banner" role="alert"><span class="status-icon failure" aria-hidden="true"></span><span><strong>Showing the last valid snapshot.</strong> @_error</span></div>
    }
    @if (AvailableTask is null)
    {
        <div class="ops-note-banner" role="status"><span class="status-icon warning" aria-hidden="true"></span><span><strong>No automation task is available.</strong> @RegistryUnavailableReason</span></div>
    }
    @if (_calendarMessage is not null)
    {
        <div class="ops-note-banner automation-utc" role="status"><span class="status-icon warning" aria-hidden="true"></span><span><strong>Times are shown in UTC because the site timezone could not be read.</strong> @_calendarMessage</span></div>
    }
    @if (_commandMessage is not null && _dialog == DialogMode.None)
    {
        <div class="ops-note-banner automation-message" role="@(_commandMessageIsError ? "alert" : "status")"><span class="status-icon @(_commandMessageIsError ? "failure" : "success")" aria-hidden="true"></span><span>@_commandMessage</span></div>
    }

    <nav class="automation-tabs" aria-label="Automation views">
        <button type="button" class="@(_view == AutomationView.Definitions ? "active" : null)" aria-pressed="@(_view == AutomationView.Definitions ? "true" : "false")" @onclick="() => SelectView(AutomationView.Definitions)">Definitions</button>
        <button type="button" class="@(_view == AutomationView.Schedule ? "active" : null)" aria-pressed="@(_view == AutomationView.Schedule ? "true" : "false")" @onclick="() => SelectView(AutomationView.Schedule)">Schedule</button>
        <button type="button" class="@(_view == AutomationView.Runs ? "active" : null)" aria-pressed="@(_view == AutomationView.Runs ? "true" : "false")" @onclick="() => SelectView(AutomationView.Runs)">Run history</button>
    </nav>

    @switch (_view)
    {
        case AutomationView.Schedule:
            var (trackStart, trackEnd) = TrackWindow();
            var markers = RunMarkers(trackStart, trackEnd);
            var captureRelative = automation.Definitions
                .Where(static item => item.Definition.Enabled && item.NextRunCaptureSequence is not null)
                .OrderBy(static item => item.NextRunCaptureSequence)
                .ToList();
            <div class="automation-view" id="automation-schedule">
                <section class="ops-panel" aria-labelledby="automation-day-heading">
                    <header class="ops-panel-heading">
                        <div><h3 id="automation-day-heading">Next 24 hours</h3><p>Wall-clock triggers use @_timeZoneId and the capture windows from Capture Schedule.</p></div>
                        <span>@Clock(trackStart) – @Clock(trackEnd) @(_calendar is null ? "UTC" : "local")</span>
                    </header>
                    <div class="automation-track-scroll">
                        <div class="automation-day-track" role="img" aria-label="@(Plural(markers.Count, "run", "runs")) due in the next 24 hours. The same runs are listed below.">
                            @foreach (var band in CaptureWindows(trackStart, trackEnd))
                            {
                                <span class="automation-night" style="left:@Css(band.Left)%;width:@Css(band.Width)%">@band.Label</span>
                            }
                            <i class="automation-now" style="left:@Css(Percent(automation.ReadAtUtc, trackStart, trackEnd))%"><small>Now @Clock(automation.ReadAtUtc)</small></i>
                            @foreach (var marker in markers)
                            {
                                <span class="automation-run-tick" style="left:@Css(marker.Tick)%"></span>
                                @if (marker.Card is { } card)
                                {
                                    <span class="automation-run-marker @(marker.Row == 0 ? "row-0" : "row-1")" style="left:@Css(card)%"><strong>@marker.Time</strong><small>@marker.Name</small></span>
                                }
                            }
                        </div>
                    </div>
                    <h4 class="automation-subheading">Upcoming runs</h4>
                    @if (automation.Calendar.Count == 0 && captureRelative.Count == 0)
                    {
                        <p class="automation-empty">No enabled automation is due. Enable a definition to schedule its next run.</p>
                    }
                    else
                    {
                        <ol class="automation-upcoming">
                            @foreach (var entry in automation.Calendar.OrderBy(static item => item.DueUtc))
                            {
                                <li @key="@($"{entry.DefinitionId}-{entry.DueUtc.UtcTicks}")"><strong>@DayClock(entry.DueUtc)</strong><span>@entry.Name</span><small>@entry.TaskTarget</small></li>
                            }
                            @foreach (var item in captureRelative)
                            {
                                <li @key="@($"{item.Definition.DefinitionId}-capture")"><strong>@DescribeNextRun(item)</strong><span>@item.Definition.Name</span><small>@item.Definition.TaskTarget</small></li>
                            }
                        </ol>
                    }
                </section>
                <div class="ops-grid two">
                    <section class="ops-panel" aria-labelledby="automation-vocabulary-heading">
                        <header class="ops-panel-heading"><div><h3 id="automation-vocabulary-heading">Trigger vocabulary</h3><p>Task types opt into only compatible durable triggers.</p></div></header>
                        <div class="ops-validation-list">
                            @foreach (var trigger in automation.Registry.SelectMany(static descriptor => descriptor.CompatibleTriggers).Distinct())
                            {
                                var (minimum, maximum) = IntervalBounds(trigger);
                                <div class="ops-validation-item">
                                    <i aria-hidden="true">+</i>
                                    @if (trigger == LocalAutomationTriggerKind.Periodic)
                                    {
                                        <span><strong>Periodic.</strong> A fixed wall-clock interval of @minimum to @maximum seconds, counted from the definition's epoch.</span>
                                    }
                                    else
                                    {
                                        <span><strong>Capture relative.</strong> After every @minimum to @maximum durable captures, counted from the capture observed when the definition was enabled.</span>
                                    }
                                </div>
                            }
                            <div class="ops-validation-item neutral"><i aria-hidden="true">-</i><span>Missed occurrences are recorded as missed, never replayed.</span></div>
                        </div>
                    </section>
                    <section class="ops-panel" aria-labelledby="automation-ownership-heading">
                        <header class="ops-panel-heading"><div><h3 id="automation-ownership-heading">Execution ownership</h3><p>Local definitions run here, whether or not LogicHost is reachable.</p></div></header>
                        <dl class="ops-facts">
                            <div><dt>Definitions stored</dt><dd>On this CameraAgent</dd></div>
                            <div><dt>Executor</dt><dd>Local durable scheduler</dd></div>
                            <div><dt>Capture timing</dt><dd>Never changed</dd></div>
                            <div><dt>Definitions</dt><dd>@automation.Definitions.Count of @LocalAutomationContract.MaximumDefinitions</dd></div>
                            <div><dt>Revisions retained</dt><dd>Up to @LocalAutomationContract.MaximumRetainedRevisions per definition</dd></div>
                            <div><dt>Observed capture</dt><dd>@(automation.ObservedCaptureSequence is { } observed ? $"Sequence {observed}" : "None yet")</dd></div>
                            <div class="full"><dt>Commands</dt><dd>Only registered task types run; arbitrary commands are never accepted.</dd></div>
                        </dl>
                    </section>
                </div>
            </div>
            break;

        case AutomationView.Runs:
            <div class="automation-view" id="automation-runs">
                <section class="ops-panel" aria-labelledby="automation-runs-heading">
                    <header class="ops-panel-heading">
                        <div><h3 id="automation-runs-heading">Recent retained runs</h3><p>Every occurrence is recorded once with its outcome. A retry is a new run; a recorded run is never rewritten.</p></div>
                        <span>@Plural(automation.Runs.Count, "run", "runs") retained</span>
                    </header>
                    @if (automation.Runs.Count == 0)
                    {
                        <p class="automation-empty">No automation run has been recorded on this CameraAgent.</p>
                    }
                    else
                    {
                        <div class="ops-table-wrap">
                            <table class="ops-table automation-run-table">
                                <thead><tr><th scope="col">Run</th><th scope="col">Automation</th><th scope="col">Trigger</th><th scope="col">Scheduled for</th><th scope="col">Outcome</th><th scope="col">Detail</th></tr></thead>
                                <tbody>
                                    @foreach (var run in automation.Runs)
                                    {
                                        <tr @key="run.Sequence">
                                            <td>@DayClock(run.StartedAtUtc)</td>
                                            <td><strong>@DefinitionName(run.DefinitionId)</strong><small>@run.DefinitionId</small></td>
                                            <td>@Split(run.TriggerKind.ToString())</td>
                                            <td>
                                                @DayClock(run.ScheduledForUtc)
                                                @if (run.ObservedCaptureSequence is { } sequence)
                                                {
                                                    <small>Capture @sequence</small>
                                                }
                                            </td>
                                            <td><span class="state-chip @OutcomeClass(run.Outcome)">@Split(run.Outcome.ToString())</span></td>
                                            <td>@(string.IsNullOrWhiteSpace(run.Detail) ? "None" : run.Detail)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            </div>
            break;

        default:
            var next = NextEntry;
            var nextCapture = NextCaptureRelative;
            var lastDay = LastDay;
            <div class="automation-view" id="automation-definitions">
                <section class="ops-status-rail" aria-label="Automation status">
                    <div><span>Enabled</span><strong>@EnabledCount</strong><small>of @Plural(automation.Definitions.Count, "definition", "definitions")</small></div>
                    <div>
                        <span>Next run</span>
                        @if (next is not null)
                        {
                            <strong>@Clock(next.DueUtc)</strong><small>@next.Name</small>
                        }
                        else if (nextCapture is not null)
                        {
                            <strong>Capture @nextCapture.NextRunCaptureSequence</strong><small>@nextCapture.Definition.Name</small>
                        }
                        else
                        {
                            <strong>None scheduled</strong><small>No enabled definition is due</small>
                        }
                    </div>
                    <div><span>Running</span><strong>@RunningCount</strong><small>@(RunningCount == 0 ? "No active tasks" : "In progress now")</small></div>
                    <div><span>Last 24 hours</span><strong>@lastDay.Succeeded / @lastDay.Finished</strong><small>Successful runs@(lastDay.Truncated ? " (latest 50 runs only)" : null)</small></div>
                </section>

                @if (automation.Definitions.Count == 0)
                {
                    <p class="automation-empty">No local automation is defined on this CameraAgent.@(AvailableTask is null ? null : " Use Create automation to schedule a registered task.")</p>
                }
                <div class="automation-card-grid">
                    @foreach (var definition in automation.Definitions)
                    {
                        var item = definition.Definition;
                        <article class="automation-card" @key="item.DefinitionId" aria-labelledby="@($"automation-card-{item.DefinitionId}")">
                            <header>
                                <span class="automation-icon environment" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M8 3.5a2 2 0 0 1 4 0v7.6a4 4 0 1 1-4 0Z"></path><path d="M10 8v6"></path></svg></span>
                                <div><h3 id="@($"automation-card-{item.DefinitionId}")">@item.Name</h3><p>@TaskDescription(item)</p></div>
                                <span class="state-chip @(item.Enabled ? "success" : "pending")">@(item.Enabled ? "Enabled" : "Disabled")</span>
                            </header>
                            <dl>
                                <div><dt>Trigger</dt><dd>@DescribeTrigger(item.TriggerKind, item.TriggerInterval)</dd></div>
                                <div><dt>Target</dt><dd>@item.TaskTarget</dd></div>
                                <div><dt>Last run</dt><dd>@DescribeLastRun(definition.LastRun)</dd></div>
                                <div><dt>Next run</dt><dd>@DescribeNextRun(definition)</dd></div>
                            </dl>
                            @if (definition.History.Count > 0)
                            {
                                <details class="revision-history">
                                    <summary>@Plural(definition.History.Count, "recorded revision", "recorded revisions")</summary>
                                    <ol>
                                        @foreach (var revision in definition.History)
                                        {
                                            <li @key="revision.Version">
                                                <strong>Revision @revision.Version</strong>
                                                <span>@DayClock(revision.RecordedAtUtc) / @revision.Actor / @(revision.Removed ? "Removed" : revision.Definition.Enabled ? "Enabled" : "Disabled")</span>
                                                @if (!string.IsNullOrWhiteSpace(revision.Reason))
                                                {
                                                    <small>@revision.Reason</small>
                                                }
                                            </li>
                                        }
                                    </ol>
                                </details>
                            }
                            <footer>
                                <span>@Split(item.TaskKind.ToString()) / revision @definition.Version</span>
                                <div class="automation-card-actions">
                                    <button type="button" id="@EditTriggerId(definition)" class="button secondary small" aria-label="@($"Edit {item.DefinitionId}")" disabled="@(_busy || _loading)" @onclick="() => BeginEdit(definition)">Edit</button>
                                    <button type="button" id="@ToggleTriggerId(definition)" class="button secondary small" aria-label="@($"{(item.Enabled ? "Disable" : "Enable")} {item.DefinitionId}")" disabled="@(_busy || _loading)" @onclick="() => BeginToggle(definition)">@(item.Enabled ? "Disable" : "Enable")</button>
                                    <button type="button" id="@RemoveTriggerId(definition)" class="button secondary small" aria-label="@($"Remove {item.DefinitionId}")" disabled="@(_busy || _loading)" @onclick="() => BeginRemove(definition)">Remove</button>
                                </div>
                            </footer>
                        </article>
                    }
                    <article class="automation-card unsupported" aria-labelledby="automation-card-restart">
                        <header>
                            <span class="automation-icon reboot" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M10 2v7"></path><path d="M6 4a7 7 0 1 0 8 0"></path></svg></span>
                            <div><h3 id="automation-card-restart">Scheduled CameraAgent Restart</h3><p>Requires authenticated lifecycle support, graceful drain, restart verification, and a terminal receipt.</p></div>
                            <span class="state-chip pending">Design target</span>
                        </header>
                        <dl>
                            <div><dt>Task type</dt><dd>Not registered</dd></div>
                            <div><dt>Interface</dt><dd>Installer CLI only</dd></div>
                            <div><dt>Scheduling</dt><dd>Unavailable</dd></div>
                            <div><dt>Safety</dt><dd>Lifecycle service required</dd></div>
                        </dl>
                        <footer>
                            <span>Arbitrary command execution is never allowed.</span>
                            <button type="button" class="button secondary small" disabled>Unavailable</button>
                        </footer>
                    </article>
                </div>
            </div>
            break;
    }

    @if (_dialog != DialogMode.None)
    {
        <dialog class="action-dialog operations-dialog automation-dialog" aria-labelledby="automation-dialog-heading" aria-describedby="automation-dialog-description" @ref="_dialogElement" @oncancel="DismissDialog">
            <div class="dialog-header">
                <div>
                    <p class="eyebrow">@(_dialog == DialogMode.Editor ? Editing ? "Edit automation" : "Create automation" : ConfirmationEyebrow())</p>
                    <h2 id="automation-dialog-heading">@(_dialog == DialogMode.Editor ? Editing ? $"Edit {_idInput}" : "Define a local automation" : ConfirmationHeading())</h2>
                </div>
                <button type="button" class="icon-button" aria-label="Close dialog" disabled="@_busy" @onclick="CloseDialog">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"></path></svg>
                </button>
            </div>
            @if (_dialog == DialogMode.Editor)
            {
                <p id="automation-dialog-description" class="dialog-intro">Choose a registered task, its target and a trigger. Nothing is recorded until you review and confirm; arbitrary commands are never accepted.</p>
                <fieldset disabled="@(_busy || _loading)">
                    <legend class="visually-hidden">Local automation definition</legend>
                    <div class="automation-dialog-grid">
                        <label class="ops-field">Identifier
                            <input id="automation-id" autocomplete="off" spellcheck="false" readonly="@Editing" aria-describedby="automation-id-help" @bind="_idInput" @bind:after="FormChanged" />
                            <small id="automation-id-help" class="automation-field-hint">@(Editing ? "Fixed once recorded." : "Lower-case letters, digits, hyphens and dots; fixed once recorded.")</small>
                        </label>
                        <label class="ops-field">Name
                            <input id="automation-name" autocomplete="off" maxlength="@LocalAutomationContract.MaximumNameLength" @bind="_nameInput" @bind:after="FormChanged" />
                        </label>
                        <label class="ops-field">Registered task
                            <select id="automation-task" @bind="_taskKindInput" @bind:after="TaskChanged">
                                @foreach (var descriptor in automation.Registry)
                                {
                                    <option value="@descriptor.TaskKind" disabled="@(!descriptor.Available)">@Split(descriptor.TaskKind.ToString())</option>
                                }
                            </select>
                        </label>
                        <label class="ops-field">Task target
                            <select id="automation-target" @bind="_targetInput" @bind:after="FormChanged">
                                <option value="">Select a registered target</option>
                                @foreach (var target in Targets())
                                {
                                    <option value="@target">@target</option>
                                }
                            </select>
                        </label>
                        <label class="ops-field">Trigger
                            <select id="automation-trigger" @bind="_triggerKindInput" @bind:after="TriggerChanged">
                                @foreach (var trigger in CompatibleTriggers())
                                {
                                    <option value="@trigger">@Split(trigger.ToString())</option>
                                }
                            </select>
                        </label>
                        <label class="ops-field">@(_triggerKindInput == LocalAutomationTriggerKind.Periodic ? "Interval (seconds)" : "Interval (captures)")
                            <input id="automation-interval" inputmode="numeric" autocomplete="off" aria-describedby="automation-interval-help" @bind="_intervalInput" @bind:after="FormChanged" />
                            <small id="automation-interval-help" class="automation-field-hint">@IntervalHint()</small>
                        </label>
                        <label class="automation-check full"><input id="automation-enabled" type="checkbox" @bind="_enabledInput" @bind:after="FormChanged" /> Run this automation once it is recorded</label>
                        <label class="ops-field full">Reason (recorded with the revision)
                            <input id="automation-reason" autocomplete="off" @bind="_reasonInput" @bind:after="FormChanged" />
                        </label>
                    </div>
                </fieldset>
                @if (_commandMessage is not null)
                {
                    <div class="ops-note-banner automation-dialog-message" role="alert"><span class="status-icon failure" aria-hidden="true"></span><span>@_commandMessage</span></div>
                }
                <footer>
                    <button type="button" id="automation-editor-cancel" class="button secondary" disabled="@_busy" @onclick="CloseDialog">Cancel</button>
                    <button type="button" id="@SaveTriggerId" class="button primary" disabled="@(_busy || _loading)" @onclick="BeginSave">Review and save</button>
                </footer>
            }
            else
            {
                <p id="automation-dialog-description" class="dialog-intro">@ConfirmationDescription()</p>
                @if (_pendingKind == PendingCommandKind.Save)
                {
                    <dl class="ops-facts automation-confirm-facts">
                        <div><dt>Identifier</dt><dd>@_idInput.Trim()</dd></div>
                        <div><dt>Name</dt><dd>@_nameInput.Trim()</dd></div>
                        <div><dt>Task</dt><dd>@Split(_taskKindInput.ToString())</dd></div>
                        <div><dt>Target</dt><dd>@_targetInput.Trim()</dd></div>
                        <div><dt>Trigger</dt><dd>@(int.TryParse(_intervalInput, System.Globalization.NumberStyles.Integer, Invariant, out var interval) ? DescribeTrigger(_triggerKindInput, interval) : _intervalInput)</dd></div>
                        <div><dt>State</dt><dd>@(_enabledInput ? "Enabled" : "Disabled")</dd></div>
                        <div class="full"><dt>Reason</dt><dd>@(TrimmedReason() ?? "None given")</dd></div>
                    </dl>
                }
                else
                {
                    <fieldset disabled="@_busy">
                        <legend class="visually-hidden">Command reason</legend>
                        <label class="ops-field">Reason (optional, recorded with the revision)
                            <input id="automation-command-reason" autocomplete="off" @bind="_commandReasonInput" />
                        </label>
                    </fieldset>
                }
                @if (_commandMessage is not null)
                {
                    <div class="ops-note-banner automation-dialog-message" role="alert"><span class="status-icon failure" aria-hidden="true"></span><span>@_commandMessage</span></div>
                }
                <footer>
                    <button type="button" id="@CancelId" class="button secondary" disabled="@_busy" @onclick="CancelCommand">@(_pendingKind == PendingCommandKind.Save ? "Back to editor" : "Cancel")</button>
                    <button type="button" id="@ConfirmId" class="button primary" disabled="@_busy" @onclick="ConfirmCommandAsync">@ConfirmLabel()</button>
                </footer>
            }
        </dialog>
    }
}
