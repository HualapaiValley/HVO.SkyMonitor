@page "/operations/sky-map"
@layout OperationsLayout
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Sky map &amp; catalog</PageTitle>

<div class="sky-map-page">
    <PageHeader Eyebrow="Installed catalog and observing geometry" Title="Sky map &amp; catalog" Lead="The installed read-only catalog, the authoritative observer coordinates, and the visible scene this rig's calibrated optics produce for one UTC instant. Everything here is computed locally from durable state; no tiles, geocoding, browser location, or network access is used.">
        <button class="btn btn-outline-light" disabled="@_loading" @onclick="LoadAsync">Refresh</button>
    </PageHeader>

    <form class="instant-picker" @onsubmit="ApplyInstantAsync" @onsubmit:preventDefault>
        <label for="sky-map-instant">Scene instant (UTC)</label>
        <input id="sky-map-instant" type="datetime-local" step="1" @bind="_instantInput" disabled="@_loading" />
        <button type="submit" class="btn btn-outline-light" disabled="@_loading">Project</button>
        <button type="button" class="btn btn-outline-light" disabled="@(_loading || _instantInput is null)" @onclick="UseNowAsync">Use now</button>
        <span class="instant-hint">Accepts at most 24 hours ahead and 62 days behind the current time. Leave empty to use the current instant.</span>
    </form>

    @if (_loading)
    {
        <PageStateNotice Kind="PageStateNotice.PageStateKind.Loading" Title="Projecting the sky map" Message="Reading the installed catalog, the active deployment location, and the active rig geometry." />
    }
    else if (_state is null)
    {
        <PageStateNotice Kind="@(_invalid ? PageStateNotice.PageStateKind.Info : PageStateNotice.PageStateKind.Error)" Title="@(_invalid ? "Instant outside the accepted window" : "Sky map unavailable")" Message="@_message">
            <button type="button" class="btn btn-outline-light" disabled="@_loading" @onclick="LoadAsync">Try again</button>
        </PageStateNotice>
    }
    else
    {
        <p class="sky-summary" role="note">@_state.Summary</p>

        <section class="sky-grid" aria-label="Sky map facts">
            <article class="sky-card" aria-labelledby="sky-observer">
                <header>
                    <div><p class="eyebrow">Authoritative deployment coordinates</p><h2 id="sky-observer">Observer location</h2></div>
                    <span class="state-chip @(_manual is { Supported: true } ? "state-chip--open" : "state-chip--readonly")">@(_manual is { Supported: true } ? "Owner editable" : "Read only")</span>
                </header>
                <p class="truth-note">These values are the active immutable deployment version. They are owned by the protected local version store, never by this page's own state, and an owner edit appends a new version rather than rewriting this one. Nothing here geocodes, reads browser location, or uses the network.</p>
                <dl class="fact-grid">
                    <div><dt>Latitude</dt><dd>@Number(_state.Observer.LatitudeDegrees, 6)&deg;</dd></div>
                    <div><dt>Longitude</dt><dd>@Number(_state.Observer.LongitudeDegrees, 6)&deg; east-positive</dd></div>
                    <div><dt>Elevation</dt><dd>@Number(_state.Observer.ElevationMeters, 2) m</dd></div>
                    <div><dt>Time zone</dt><dd>@_state.Observer.TimeZoneId</dd></div>
                    <div><dt>Source kind</dt><dd>@Split(_state.Observer.SourceKind.ToString())</dd></div>
                    <div><dt>Origin</dt><dd>@Split(_state.Observer.Origin.ToString())</dd></div>
                    <div><dt>Location id</dt><dd>@_state.Observer.LocationId</dd></div>
                    <div><dt>Version</dt><dd>@_state.Observer.Version</dd></div>
                    <div><dt>Recorded source</dt><dd>@_state.Observer.Source</dd></div>
                    <div><dt>Horizontal accuracy</dt><dd>@(_state.Observer.HorizontalAccuracyMeters is { } accuracy ? $"{Number(accuracy, 2)} m" : "Not recorded")</dd></div>
                    <div><dt>Effective from</dt><dd>@_state.Observer.EffectiveFromUtc.ToString("u")</dd></div>
                    <div><dt>Effective until</dt><dd>@(_state.Observer.EffectiveUntilUtc?.ToString("u") ?? "Open ended")</dd></div>
                    <div><dt>Effective at instant</dt><dd>@(_state.Observer.EffectiveAtInstant ? "Yes" : "No: the scene uses coordinates outside their effective window")</dd></div>
                    <div><dt>Staged acknowledgement</dt><dd>@(_state.Observer.StagedAcknowledgementPending ? "A central acknowledgement is staged and activates at the next start" : "None")</dd></div>
                    <div><dt>Canonical identity</dt><dd class="mono">@_state.Observer.CanonicalSha256</dd></div>
                    <div><dt>Pending manual version</dt><dd>@(_manual?.Override is { PendingRestart: true } pendingOverride ? $"Version {_manual.NextVersion} entered {pendingOverride.RecordedAtUtc:u} activates at the next start" : "None")</dd></div>
                </dl>
            </article>

            <article class="sky-card sky-card--wide" aria-labelledby="sky-observer-edit">
                <header>
                    <div><p class="eyebrow">Audited local mutation</p><h2 id="sky-observer-edit">Edit observer coordinates</h2></div>
                    @if (_manual is { Supported: true } editable)
                    {
                        <span class="state-chip state-chip--readonly">Current version @editable.KnownVersion</span>
                    }
                </header>
                @if (_manual is not { Supported: true })
                {
                    <p class="empty-copy">This CameraAgent's deployment-location owner does not expose the audited local mutation contract, so coordinates remain read only here.</p>
                }
                else
                {
                    <p class="truth-note">
                        Saving appends deployment version @_manual.NextVersion through the protected local owner. It becomes the
                        active version at the <strong>next CameraAgent start</strong>: every capture recorded by the running process
                        keeps version @_manual.KnownVersion, and every capture after the restart carries the new version. Earlier
                        versions and the captures bound to them are never rewritten. The entry is offline: no geocoding, tiles,
                        browser location, or network request is made.
                    </p>
                    @if (_manual.CentralAcknowledgementRequired)
                    {
                        <p class="truth-note">Central integration is enabled, so the new version is proposed to LogicHost first and activates only after it is acknowledged and this agent restarts. LogicHost can acknowledge or reject the local proposal; it never replaces these coordinates with its own.</p>
                    }
                    @if (_manual.StagedAcknowledgementPending)
                    {
                        <p class="truth-note">A central acknowledgement is already staged. It activates first at the next start, and this manual entry is then proposed as its successor.</p>
                    }
                    @if (_manual.OverrideSupersededAtUtc is { } supersededAtUtc)
                    {
                        <p class="truth-note">A previous manual entry was superseded at @supersededAtUtc.ToString("u") because the startup configuration seed itself changed. Configured coordinates currently govern this deployment.</p>
                    }
                    @if (_manualMessage is not null)
                    {
                        <p class="truth-note @(_manualMessageIsError ? "manual-error" : "manual-ok")" role="@(_manualMessageIsError ? "alert" : "status")">@_manualMessage</p>
                    }
                    <fieldset class="coordinate-form" disabled="@(_busy || _loading)">
                        <legend class="visually-hidden">Manual observer coordinates</legend>
                        <div class="coordinate-field">
                            <label for="sky-map-latitude">Latitude (degrees)</label>
                            <input id="sky-map-latitude" class="form-control" inputmode="decimal" autocomplete="off" @bind="_latitudeInput" @bind:after="FormChanged" />
                        </div>
                        <div class="coordinate-field">
                            <label for="sky-map-longitude">Longitude (degrees, east positive)</label>
                            <input id="sky-map-longitude" class="form-control" inputmode="decimal" autocomplete="off" @bind="_longitudeInput" @bind:after="FormChanged" />
                        </div>
                        <div class="coordinate-field">
                            <label for="sky-map-elevation">Elevation (metres)</label>
                            <input id="sky-map-elevation" class="form-control" inputmode="decimal" autocomplete="off" @bind="_elevationInput" @bind:after="FormChanged" />
                        </div>
                        <div class="coordinate-field">
                            <label for="sky-map-time-zone">Time zone (IANA identifier)</label>
                            <input id="sky-map-time-zone" class="form-control" autocomplete="off" @bind="_timeZoneInput" @bind:after="FormChanged" />
                        </div>
                        <div class="coordinate-field coordinate-field--wide">
                            <label for="sky-map-reason">Reason (recorded with the version)</label>
                            <input id="sky-map-reason" class="form-control" autocomplete="off" @bind="_reasonInput" @bind:after="FormChanged" />
                        </div>
                    </fieldset>
                    <div class="coordinate-actions">
                        <button id="@EditTriggerId" type="button" class="btn btn-primary" disabled="@(_busy || _loading)" @onclick="BeginEdit">Save coordinates</button>
                    </div>

                    <h3>Recorded manual changes</h3>
                    @if (_manual.History.Count == 0)
                    {
                        <p class="empty-copy">No manual coordinate change has been recorded on this CameraAgent.</p>
                    }
                    else
                    {
                        <div class="table-scroll">
                            <table class="facts-table">
                                <caption class="visually-hidden">Audited manual coordinate changes, newest first</caption>
                                <thead><tr><th scope="col">Recorded</th><th scope="col">Actor</th><th scope="col">Expected version</th><th scope="col">Latitude</th><th scope="col">Longitude</th><th scope="col">Elevation</th><th scope="col">Time zone</th><th scope="col">Reason</th></tr></thead>
                                <tbody>
                                    @foreach (var entry in _manual.History)
                                    {
                                        <tr @key="entry.Sequence">
                                            <th scope="row">@entry.RecordedAtUtc.ToString("u")</th>
                                            <td>@entry.Actor</td>
                                            <td>@entry.ExpectedVersion</td>
                                            <td>@Number(entry.LatitudeDegrees, 6)&deg;</td>
                                            <td>@Number(entry.LongitudeDegrees, 6)&deg;</td>
                                            <td>@Number(entry.ElevationMeters, 2) m</td>
                                            <td>@entry.TimeZoneId</td>
                                            <td>@(entry.Reason ?? "Not recorded")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </article>

            @if (_confirming && _manual is { Supported: true } confirming)
            {
                <dialog class="confirmation-panel" aria-labelledby="coordinate-heading" aria-describedby="coordinate-description"
                        @oncancel="CancelEdit" @ref="_confirmationDialog">
                    <div><p class="eyebrow">Deployment-version confirmation</p><h2 id="coordinate-heading">Append manual version @confirming.NextVersion?</h2><p id="coordinate-description">Captures recorded by the running process keep version @confirming.KnownVersion. The entered coordinates become active at the next CameraAgent start@(confirming.CentralAcknowledgementRequired ? ", after LogicHost acknowledges the proposal" : string.Empty).</p></div>
                    <div><button type="button" class="btn btn-primary" disabled="@_busy" @onclick="ConfirmEditAsync">Confirm change</button><button type="button" class="btn btn-outline-light" disabled="@_busy" autofocus @onclick="CancelEdit">Cancel</button></div>
                </dialog>
            }

            <article class="sky-card" aria-labelledby="sky-catalog">
                <header><div><p class="eyebrow">Installed read-only snapshot</p><h2 id="sky-catalog">Catalog identity</h2></div></header>
                <dl class="fact-grid">
                    <div><dt>Name</dt><dd>@_state.Catalog.Name</dd></div>
                    <div><dt>Version</dt><dd>@_state.Catalog.Version</dd></div>
                    <div><dt>Schema version</dt><dd>@_state.Catalog.SchemaVersion</dd></div>
                    <div><dt>Preprocessing version</dt><dd>@_state.Catalog.PreprocessingVersion</dd></div>
                    <div><dt>License</dt><dd>@_state.Catalog.License</dd></div>
                    <div><dt>Checksum</dt><dd class="mono">@_state.Catalog.ChecksumSha256</dd></div>
                    <div><dt>Limiting magnitude</dt><dd>@Number(_state.MaximumMagnitude, 2)</dd></div>
                    <div><dt>Algorithm version</dt><dd>@_state.AstronomyAlgorithmVersion</dd></div>
                </dl>
                <p class="empty-copy">The catalog is deployed as a versioned read-only snapshot. Its install location is deliberately not shown.</p>
            </article>

            <article class="sky-card" aria-labelledby="sky-geometry">
                <header><div><p class="eyebrow">Active rig, after readout</p><h2 id="sky-geometry">Cardinal and image geometry</h2></div></header>
                <dl class="fact-grid">
                    <div><dt>Projection model</dt><dd>@Split(_state.Geometry.ProjectionModel)</dd></div>
                    <div><dt>Aperture</dt><dd>@_state.Geometry.Aperture</dd></div>
                    <div><dt>Boresight altitude</dt><dd>@Number(_state.Geometry.BoresightAltitudeDegrees, 3)&deg;</dd></div>
                    <div><dt>Boresight azimuth</dt><dd>@Number(_state.Geometry.BoresightAzimuthDegrees, 3)&deg;</dd></div>
                    <div><dt>Roll</dt><dd>@Number(_state.Geometry.RollDegrees, 3)&deg;</dd></div>
                    <div><dt>Horizontal flip</dt><dd>@(_state.Geometry.HorizontalFlip ? "Applied" : "None")</dd></div>
                    <div><dt>Field of view</dt><dd>@Number(_state.Geometry.FieldOfViewDegrees, 2)&deg;@(_state.Geometry.VerticalFieldOfViewDegrees is { } vertical ? $" x {Number(vertical, 2)}°" : string.Empty)</dd></div>
                    <div><dt>Principal point</dt><dd>@Number(_state.Geometry.PrincipalPointX, 2), @Number(_state.Geometry.PrincipalPointY, 2) px</dd></div>
                    <div><dt>Focal length</dt><dd>@Number(_state.Geometry.FocalLengthXPixels, 2) / @Number(_state.Geometry.FocalLengthYPixels, 2) px</dd></div>
                    <div><dt>Image size</dt><dd>@_state.Geometry.WidthPixels x @_state.Geometry.HeightPixels px</dd></div>
                    <div><dt>Image circle radius</dt><dd>@(_state.Geometry.ImageCircleRadiusPixels is { } radius ? $"{Number(radius, 2)} px" : "Rectangular aperture")</dd></div>
                    <div><dt>Rig profile</dt><dd>@_state.Geometry.RigProfileVersion</dd></div>
                    <div><dt>Calibration version</dt><dd>@_state.Geometry.ProjectionCalibrationVersion</dd></div>
                    <div><dt>Projection algorithm</dt><dd>@_state.Geometry.ProjectionAlgorithmVersion</dd></div>
                    <div><dt>Rig profile identity</dt><dd class="mono">@_state.Geometry.RigProfileHashSha256</dd></div>
                </dl>
                <h3>Cardinal directions</h3>
                <div class="table-scroll">
                    <table class="facts-table">
                        <caption class="visually-hidden">Cardinal horizon directions and their projected pixels</caption>
                        <thead><tr><th scope="col">Direction</th><th scope="col">Azimuth</th><th scope="col">Pixel X</th><th scope="col">Pixel Y</th></tr></thead>
                        <tbody>
                            @foreach (var cardinal in _state.Geometry.Cardinals)
                            {
                                <tr>
                                    <th scope="row">@cardinal.Name</th>
                                    <td>@Number(cardinal.AzimuthDegrees, 1)&deg;</td>
                                    <td>@(cardinal.PixelX is { } x ? Number(x, 1) : "Not projected")</td>
                                    <td>@(cardinal.PixelY is { } y ? Number(y, 1) : "Not projected")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </article>

            <article class="sky-card sky-card--wide" aria-labelledby="sky-scene">
                <header>
                    <div><p class="eyebrow">Bounded visible scene</p><h2 id="sky-scene">Visible objects at @_state.AtUtc.ToString("u")</h2></div>
                    <span class="state-chip @(_state.ObjectsAtBound ? "state-chip--bound" : "state-chip--open")">@_state.Objects.Count / @_state.MaximumObjects</span>
                </header>
                @if (_state.Objects.Count == 0)
                {
                    <p class="empty-copy">No catalog object brighter than the limiting magnitude falls inside the calibrated image at this instant.</p>
                }
                else
                {
                    <svg class="sky-dial" viewBox="0 0 200 200" role="img" aria-label="Altitude and azimuth plot of the visible objects; the outer ring is the horizon and the centre is the zenith.">
                        <circle cx="100" cy="100" r="92" class="sky-dial__horizon" />
                        <circle cx="100" cy="100" r="46" class="sky-dial__ring" />
                        <line x1="100" y1="8" x2="100" y2="192" class="sky-dial__ring" />
                        <line x1="8" y1="100" x2="192" y2="100" class="sky-dial__ring" />
                        <text x="100" y="6" class="sky-dial__label" text-anchor="middle">N</text>
                        <text x="196" y="103" class="sky-dial__label" text-anchor="end">E</text>
                        <text x="100" y="199" class="sky-dial__label" text-anchor="middle">S</text>
                        <text x="4" y="103" class="sky-dial__label" text-anchor="start">W</text>
                        @foreach (var item in _state.Objects)
                        {
                            <circle cx="@Number(DialX(item.AltitudeDegrees, item.AzimuthDegrees), 2)"
                                    cy="@Number(DialY(item.AltitudeDegrees, item.AzimuthDegrees), 2)"
                                    r="@Number(DialRadius(item.Magnitude), 2)"
                                    class="sky-dial__object">
                                <title>@item.DisplayName (magnitude @Number(item.Magnitude, 2))</title>
                            </circle>
                        }
                    </svg>
                    <div class="table-scroll">
                        <table class="facts-table">
                            <caption class="visually-hidden">Visible catalog objects ordered by brightness then identifier</caption>
                            <thead><tr><th scope="col">Object</th><th scope="col">Magnitude</th><th scope="col">Altitude</th><th scope="col">Azimuth</th><th scope="col">Pixel</th><th scope="col">HIP</th></tr></thead>
                            <tbody>
                                @foreach (var item in _state.Objects)
                                {
                                    <tr>
                                        <th scope="row">@item.DisplayName</th>
                                        <td>@Number(item.Magnitude, 2)</td>
                                        <td>@Number(item.AltitudeDegrees, 2)&deg;</td>
                                        <td>@Number(item.AzimuthDegrees, 2)&deg;</td>
                                        <td>@Number(item.PixelX, 1), @Number(item.PixelY, 1)</td>
                                        <td>@(item.HipparcosId ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </article>

            <article class="sky-card" aria-labelledby="sky-constellations">
                <header><div><p class="eyebrow">Installed topology</p><h2 id="sky-constellations">Visible constellations</h2></div></header>
                @if (_state.Constellations.Count == 0)
                {
                    <p class="empty-copy">No constellation figure has a chord inside the calibrated image at this instant.</p>
                }
                else
                {
                    <ul class="constellation-list">
                        @foreach (var constellation in _state.Constellations)
                        {
                            <li><strong>@constellation.ConstellationId</strong><span>@constellation.VisibleSegmentCount chords</span></li>
                        }
                    </ul>
                }
            </article>

            <article class="sky-card" aria-labelledby="sky-provenance">
                <header><div><p class="eyebrow">Capture-time evidence</p><h2 id="sky-provenance">Latest retained scene provenance</h2></div></header>
                @if (_state.LatestCaptureScene is not { } provenance)
                {
                    <p class="empty-copy">No retained capture currently carries scene provenance in the local latest-frame evidence, so capture-time scene identity is omitted rather than inferred.</p>
                }
                else
                {
                    <dl class="fact-grid">
                        <div><dt>Scene instant</dt><dd>@(provenance.SceneUtc?.ToString("u") ?? "Not recorded")</dd></div>
                        <div><dt>Catalog</dt><dd>@provenance.CatalogName @provenance.CatalogVersion</dd></div>
                        <div><dt>Projection model</dt><dd>@Split(provenance.ProjectionModel)</dd></div>
                        <div><dt>Rig profile</dt><dd>@provenance.RigProfileVersion</dd></div>
                        <div><dt>Calibration version</dt><dd>@(provenance.ProjectionCalibrationVersion ?? "Not recorded")</dd></div>
                        <div><dt>Scene identity</dt><dd class="mono">@provenance.SceneId</dd></div>
                        <div><dt>Catalog checksum</dt><dd class="mono">@provenance.CatalogChecksumSha256</dd></div>
                        <div><dt>Rig profile identity</dt><dd class="mono">@(provenance.RigProfileHashSha256 ?? "Not recorded")</dd></div>
                        <div><dt>Stage identity</dt><dd class="mono">@(provenance.ProjectedSceneStageIdentitySha256 ?? "Not staged")</dd></div>
                    </dl>
                }
            </article>
        </section>
    }
</div>
