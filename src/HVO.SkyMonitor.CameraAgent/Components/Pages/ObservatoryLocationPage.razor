@inherits SiteTimeComponent
@page "/operations/site"
@page "/operations/sky-map"
@layout OperationsLayout
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Components.Operations
@using HVO.SkyMonitor.CameraAgent.Common.SiteProfile
@using HVO.SkyMonitor.CameraAgent.Common.SkyMap
@using HVO.SkyMonitor.CameraAgent.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Observatory &amp; location</PageTitle>

<OperationsPageHeading Eyebrow="Setup / geometry authority" Title="@("Observatory & location")" HeadingId="site-heading"
                       Description="Keep local capture geometry available offline while showing the separate LogicHost Observatory assignment and review state.">
    <Actions>
        @* An icon keeps the prototype's two-action heading on one line with the title; the label names it for assistive technology. *@
        <button type="button" class="icon-button" aria-label="Refresh" title="Refresh" disabled="@(_loading || _busy)" @onclick="LoadAsync">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15.5 7A6 6 0 1 0 16 11"></path><path d="M16 3.5V7h-3.5"></path></svg>
        </button>
        <a class="button secondary" href="/operations/site#site-history-heading">View revision history</a>
        <button id="@LocationTriggerId" type="button" class="button primary" disabled="@(_loading || _busy || _manual is not { Supported: true } || _state is null)"
                title="@(_manual is { Supported: true } ? null : "This CameraAgent's location owner does not accept local drafts.")" @onclick="OpenLocationDialog">Create local draft</button>
    </Actions>
</OperationsPageHeading>

@if (_notice is not null && _dialog == SiteDialog.None)
{
    <div class="ops-note-banner site-message" role="@(_noticeIsError ? "alert" : "status")"><span class="status-icon @(_noticeIsError ? "failure" : "success")" aria-hidden="true"></span><span>@_notice</span></div>
}

@if (_loading && _state is null)
{
    <section class="ops-note-banner" aria-label="Loading"><span class="status-icon running" aria-hidden="true"></span><span><strong>Reading the site.</strong> Loading the active deployment location, site profile, catalog, and rig geometry.</span></section>
}
else if (_state is null)
{
    <section class="ops-note-banner" role="alert" aria-label="Site unavailable">
        <span class="status-icon @(_invalid ? "warning" : "failure")" aria-hidden="true"></span>
        <span><strong>@(_invalid ? "Instant outside the accepted window." : "Location and projection unavailable.")</strong> @_message</span>
    </section>
    @if (_invalid)
    {
        <button type="button" class="button secondary small" disabled="@_loading" @onclick="UseNowAsync">Use the current instant</button>
    }
}
else
{
    var observer = _state.Observer;
    var banner = LocationBanner;
    <section class="ops-note-banner site-location-banner" aria-label="Location state">
        <span class="status-icon @banner.Icon" aria-hidden="true"></span>
        @if (banner.AppliesAtRestart)
        {
            <div><span><strong>@banner.Title</strong> @banner.Text</span><RestartToApply Subject="the staged location" /></div>
        }
        else
        {
            <span><strong>@banner.Title</strong> @banner.Text</span>
        }
    </section>

    <div class="ops-grid sidebar-right">
        <section class="ops-panel" aria-labelledby="site-location-heading">
            <header class="ops-panel-heading"><div><h2 id="site-location-heading">Deployment location</h2><p>Protected local snapshot used for schedules, projection, and capture evidence.</p></div><span>Version @observer.Version</span></header>
            <div class="site-map" @ref="_mapElement">
                <div class="ops-map">
                    @if (MapTiles is { Count: > 0 } tiles)
                    {
                        <div class="site-map-tiles" aria-hidden="true">
                            @foreach (var tile in tiles)
                            {
                                <img @key="(tile.Column, tile.Row)" src="@tile.Source" alt="" draggable="false" decoding="async" style="@TileStyle(tile)" />
                            }
                        </div>
                    }
                    <i class="ops-map-pin"></i>
                    <span class="ops-map-label">@(SiteName ?? "Deployment location")</span>
                    @if (MapTiles is { Count: > 0 } && _site?.Map is { } map)
                    {
                        <a class="site-map-attribution" href="@map.AttributionLink" target="_blank" rel="noopener noreferrer"><span>@map.Attribution</span></a>
                    }
                </div>
                <p class="site-map-note">
                    @if (MapTiles is { Count: > 0 })
                    {
                        <span class="site-map-online">Map tiles are loaded by your browser from @TileHost; CameraAgent itself makes no map request and never uses the map for geometry.</span>
                        <span class="site-map-offline">Map tiles could not be loaded, so the offline schematic is shown. Location, schedules, and projection are unaffected.</span>
                    }
                    else
                    {
                        <span>@(_site is null ? "The map settings could not be read, so the offline schematic is shown." : "The online map is turned off in this CameraAgent's configuration, so the offline schematic is shown.")</span>
                    }
                </p>
            </div>
        </section>

        <section class="ops-panel" aria-labelledby="site-profile-heading">
            <header class="ops-panel-heading"><div><h2 id="site-profile-heading">Local site profile</h2><p>Available even when standalone or disconnected.</p></div><span class="state-chip @(ProfileSet ? "success" : "pending")">@(ProfileSet ? "Active" : "Not set")</span></header>
            <dl class="ops-facts">
                <div class="full"><dt>Observatory</dt><dd>@(_site?.Profile.Profile.ObservatoryName ?? "Not named")</dd></div>
                <div class="full"><dt>Camera</dt><dd>@(_site?.Profile.EffectiveCameraName ?? "Not named")@if (_site?.Profile is { Profile.CameraName: null, EffectiveCameraName: not null }) {<small class="site-muted"> from installation</small>}</dd></div>
                <div><dt>Owner</dt><dd>@(_site?.Profile.Profile.OwnerName ?? "Not recorded")</dd></div>
                <div><dt>Contact</dt><dd>@(_site?.Profile.Profile.OwnerContact ?? "Not recorded")</dd></div>
                <div><dt>Latitude</dt><dd>@Latitude(observer.LatitudeDegrees)</dd></div>
                <div><dt>Longitude</dt><dd>@Longitude(observer.LongitudeDegrees)</dd></div>
                <div><dt>Elevation</dt><dd>@Elevation(observer.ElevationMeters)</dd></div>
                <div><dt>Timezone</dt><dd>@observer.TimeZoneId</dd></div>
                <div class="full"><dt>Source</dt><dd>@SourceText</dd></div>
            </dl>
            @if (_site is null)
            {
                <p class="site-note">The site profile could not be read. Refresh to try again.</p>
            }
            else
            {
                @if (_site.Profile.Problem is { } problem)
                {
                    <p class="site-note">@problem</p>
                }
                else
                {
                    <p class="site-note">Saved in the operator settings file, <code>@_site.Profile.SettingsFilePath</code>.</p>
                }
                <button id="@ProfileTriggerId" type="button" class="text-button" disabled="@(_busy || _loading || _site.Profile.SettingsFilePath is null)" @onclick="OpenProfileDialog">Edit profile</button>
            }
        </section>
    </div>

    <div class="ops-grid two">
        <section class="ops-panel" aria-labelledby="site-authority-heading">
            <header class="ops-panel-heading"><div><h2 id="site-authority-heading">Authority boundary</h2><p>Local and central facts remain explicit.</p></div></header>
            <div class="ops-table-wrap">
                <table class="ops-table">
                    <thead><tr><th scope="col">Fact</th><th scope="col">Authority</th><th scope="col">Local behavior</th></tr></thead>
                    <tbody>
                        <tr><td><strong>Capture geometry</strong></td><td>CameraAgent</td><td>Editable as versioned local draft</td></tr>
                        <tr><td><strong>Offline schedule location</strong></td><td>CameraAgent</td><td>Uses active protected snapshot</td></tr>
                        <tr><td><strong>Observatory and camera names</strong></td><td>CameraAgent</td><td>Descriptive only; not sent to LogicHost</td></tr>
                        <tr><td><strong>Observatory membership</strong></td><td>LogicHost</td><td>Read-only assignment</td></tr>
                        <tr><td><strong>Reconciliation decision</strong></td><td>LogicHost</td><td>Never silently replaces local facts</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="ops-panel" aria-labelledby="site-assignment-heading">
            <header class="ops-panel-heading"><div><h2 id="site-assignment-heading">LogicHost assignment</h2><p>@AssignmentLead</p></div><span class="state-chip @AssignmentChip.Css">@AssignmentChip.Text</span></header>
            @if (_site?.Assignment is not { } assignment)
            {
                <p class="site-note">The LogicHost assignment could not be read. Local geometry is unaffected.</p>
            }
            else if (assignment.State == CameraAgentSiteAssignmentState.Standalone)
            {
                <dl class="ops-facts">
                    <div><dt>Mode</dt><dd>Standalone</dd></div>
                    <div><dt>Observatory</dt><dd>Not assigned</dd></div>
                </dl>
                <p class="site-note">Central integration is turned off, so this camera never contacts LogicHost. There is no Observatory membership to show and nothing is reviewed centrally; the local location governs on its own.</p>
            }
            else if (assignment.State == CameraAgentSiteAssignmentState.Registered)
            {
                <dl class="ops-facts">
                    <div class="full"><dt>Registered as</dt><dd>@(assignment.RegistrationName ?? "Not named")</dd></div>
                    <div><dt>Location review</dt><dd>@LocationReviewText(assignment.LocationReview)</dd></div>
                    <div><dt>Observatory membership</dt><dd>Not reported to this camera</dd></div>
                    <div><dt>Last check</dt><dd>@(assignment.LastAttemptUtc is { } attempt ? Timestamp(attempt) : "Not yet run")</dd></div>
                    <div><dt>Acknowledged version</dt><dd>@(assignment.AcknowledgedVersion?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "None")</dd></div>
                    <div><dt>Proposed version</dt><dd>@(assignment.ProposedVersion?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "None")</dd></div>
                </dl>
                <p class="site-note">LogicHost owns the Observatory record, its name and this camera's membership, and does not send them to the camera. What the camera keeps is LogicHost's review of its location.</p>
            }
            else
            {
                <p class="site-note">@(assignment.State == CameraAgentSiteAssignmentState.NotRegistered
                    ? "Central integration is on, but this camera has not completed device registration, so LogicHost has not assigned it to an Observatory. Local geometry governs until it does."
                    : "The registration record could not be read. Local geometry is unaffected.")</p>
            }
            @if (_site?.Assignment is { State: not CameraAgentSiteAssignmentState.Standalone })
            {
                <a class="text-button" href="@RegistrationHref">View registration state</a>
            }
        </section>
    </div>

    <div class="ops-grid two">
        <section class="ops-panel" aria-labelledby="site-catalog-heading">
            <header class="ops-panel-heading"><div><h2 id="site-catalog-heading">Star catalog</h2><p>The installed read-only snapshot every projection on this camera uses.</p></div><span class="state-chip success">Active</span></header>
            <dl class="ops-facts">
                <div><dt>Catalog</dt><dd>@_state.Catalog.Name</dd></div>
                <div><dt>Version</dt><dd>@_state.Catalog.Version</dd></div>
                <div><dt>Limiting magnitude</dt><dd>@Number(_state.MaximumMagnitude, 1)</dd></div>
                <div><dt>Scene object limit</dt><dd>@_state.MaximumObjects.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) brightest</dd></div>
                <div class="full"><dt>License</dt><dd>@_state.Catalog.License</dd></div>
            </dl>
            <p class="site-note">Only the active catalog is shown. Other installed versions are selected on the host with <code>hvo-skymonitor catalog select</code>, which restarts CameraAgent on the chosen version. The object limit is set under Operator settings below.</p>
        </section>

        <section class="ops-panel" aria-labelledby="site-rig-heading">
            <header class="ops-panel-heading"><div><h2 id="site-rig-heading">Active rig</h2><p>The projection geometry capture uses now, after readout.</p></div><span>@RigTitle</span></header>
            <dl class="ops-facts">
                <div><dt>Projection</dt><dd>@Split(_state.Geometry.ProjectionModel)</dd></div>
                <div><dt>Field of view</dt><dd>@Number(_state.Geometry.FieldOfViewDegrees, 1)&deg;@(_state.Geometry.VerticalFieldOfViewDegrees is { } vertical ? $" x {Number(vertical, 1)}°" : string.Empty)</dd></div>
                <div><dt>Image size</dt><dd>@_state.Geometry.WidthPixels x @_state.Geometry.HeightPixels px</dd></div>
                <div><dt>Image circle</dt><dd>@(_state.Geometry.ImageCircleRadiusPixels is { } radius ? $"{Number(radius, 0)} px radius" : "Rectangular")</dd></div>
                <div><dt>Boresight</dt><dd>Alt @Number(_state.Geometry.BoresightAltitudeDegrees, 1)&deg; / Az @Number(_state.Geometry.BoresightAzimuthDegrees, 1)&deg;</dd></div>
                <div><dt>Roll / flip</dt><dd>@Number(_state.Geometry.RollDegrees, 1)&deg; / @(_state.Geometry.HorizontalFlip ? "Flipped" : "None")</dd></div>
            </dl>
            <a class="text-button" href="/operations/camera">Edit in Camera &amp; rig</a>
        </section>
    </div>

    <section class="ops-panel site-scene" aria-labelledby="site-scene-heading">
        <header class="ops-panel-heading">
            <div><h2 id="site-scene-heading">Visible sky</h2><p>What the active rig sees from this location at one instant, projected offline from the catalog. Nothing is captured.</p></div>
            <span class="state-chip @(_state.ObjectsAtBound ? "warning" : "success")">@_state.Objects.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) objects</span>
        </header>
        <form class="site-instant" @onsubmit="ProjectAsync" @onsubmit:preventDefault>
            <label class="ops-field">Scene instant (@SiteTime.Label)<input id="site-instant" type="datetime-local" step="1" @bind="_instantInput" disabled="@_loading" /></label>
            <button type="submit" class="button secondary small" disabled="@_loading">Project</button>
            <button type="button" class="button secondary small" disabled="@(_loading || _instantInput is null)" @onclick="UseNowAsync">Use now</button>
            <p>Showing @Timestamp(_state.AtUtc). Pick a moment up to 24 hours ahead or 62 days back to preview the sky the camera would record then.</p>
        </form>
        @if (_state.ObjectsAtBound)
        {
            <div class="ops-note-banner compact"><span class="status-icon warning" aria-hidden="true"></span><span>Only the @_state.MaximumObjects.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) brightest objects are projected. Raise the object limit under Operator settings to include fainter ones.</span></div>
        }
        @if (_state.Objects.Count == 0)
        {
            <p class="site-note">No catalog object brighter than magnitude @Number(_state.MaximumMagnitude, 1) falls inside the calibrated image at this instant.</p>
        }
        else
        {
            var scene = ScenePage;
            <div class="site-scene-layout">
                <div class="site-scene-table">
                    <div class="site-scene-filters">
                        <label class="ops-field">Find object<input id="site-scene-search" type="search" autocomplete="off" @bind="_search" @bind:event="oninput" @bind:after="ResetScenePage" /></label>
                        <label class="ops-field">Brightness<select id="site-scene-magnitude" @bind="_magnitudeFilter" @bind:after="ResetScenePage"><option value="">Any magnitude</option>@foreach (var limit in MagnitudeLimits) { <option value="@limit">Magnitude @limit or brighter</option> }</select></label>
                    </div>
                    <div class="ops-table-wrap site-scene-wrap" @ref="_sceneWrap">
                        <table class="ops-table">
                            <caption class="visually-hidden">Visible objects, @SortDescription. Select an object's name to label it on the sky plot.</caption>
                            <thead>
                                <tr>
                                    <th scope="col" aria-sort="@AriaSort(SceneSort.Name)"><button type="button" class="site-sort" @onclick="() => SortBy(SceneSort.Name)">Object</button></th>
                                    <th scope="col">Type</th>
                                    <th scope="col" aria-sort="@AriaSort(SceneSort.Magnitude)"><button type="button" class="site-sort" @onclick="() => SortBy(SceneSort.Magnitude)">Magnitude</button></th>
                                    <th scope="col" aria-sort="@AriaSort(SceneSort.Altitude)"><button type="button" class="site-sort" @onclick="() => SortBy(SceneSort.Altitude)">Altitude</button></th>
                                    <th scope="col" aria-sort="@AriaSort(SceneSort.Azimuth)"><button type="button" class="site-sort" @onclick="() => SortBy(SceneSort.Azimuth)">Azimuth</button></th>
                                    <th scope="col">Direction</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in scene.Items)
                                {
                                    var selected = item.Id == _selectedId;
                                    <tr @key="item.Id" class="@(selected ? "selected" : null)">
                                        <td class="site-object-cell"><button type="button" class="site-object" aria-pressed="@(selected ? "true" : "false")" @onclick="() => SelectObject(item.Id)"><strong>@item.DisplayName</strong><span class="visually-hidden">, label on the sky plot</span></button></td>
                                        <td>@item.Kind</td>
                                        <td>@Number(item.Magnitude, 2)</td>
                                        <td>@Number(item.AltitudeDegrees, 1)&deg;</td>
                                        <td>@Number(item.AzimuthDegrees, 1)&deg;</td>
                                        <td>@Compass(item.AzimuthDegrees)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (scene.Total == 0)
                    {
                        <p class="site-note">No visible object matches this filter.</p>
                    }
                    <nav class="site-pager" aria-label="Visible object pages">
                        <span role="status">@(scene.Total == 0 ? "No matches" : $"{scene.First}-{scene.Last} of {scene.Total}")</span>
                        <button type="button" class="button secondary small" disabled="@(_scenePage == 0)" @onclick="PreviousScenePage">Previous</button>
                        <span>Page @(scene.Pages == 0 ? 0 : _scenePage + 1) of @scene.Pages</span>
                        <button type="button" class="button secondary small" disabled="@(_scenePage + 1 >= scene.Pages)" @onclick="NextScenePage">Next</button>
                    </nav>
                </div>
                <div class="site-scene-side">
                    <ObservatorySkyDial Scene="_state" OnPage="scene.OnPage" SelectedId="@_selectedId" Figures="_figures" ObjectSelected="RevealObject" />
                    <div class="site-selection">
                        <p role="status">
                            @if (SelectedObject is { } chosen)
                            {
                                <span>Labelled: <strong>@chosen.DisplayName</strong>, @chosen.Kind.ToLowerInvariant(), magnitude @Number(chosen.Magnitude, 2), altitude @Number(chosen.AltitudeDegrees, 1)&deg;, azimuth @Number(chosen.AzimuthDegrees, 1)&deg; (@Compass(chosen.AzimuthDegrees)).</span>
                            }
                            else
                            {
                                <span>No object is labelled.</span>
                            }
                        </p>
                        <button type="button" class="text-button" disabled="@(SelectedObject is null)" @onclick="ClearSelection">Clear label</button>
                    </div>
                    <div class="site-figures-heading">
                        <h3 id="site-figures-heading">Constellations</h3>
                        <button type="button" class="text-button" disabled="@(_figures.Count == 0)" @onclick="ClearFigures">Clear figures</button>
                    </div>
                    @if (ConstellationChoices is { Count: > 0 } choices)
                    {
                        <p class="site-note site-figures-note">@(_state.Constellations.Count == 0
                            ? "No constellation figure crosses the image at this instant."
                            : "Select figures to draw their lines on the plot. Figures outside the image at this instant are unavailable.")</p>
                        <div class="site-constellations" role="group" aria-labelledby="site-figures-heading">
                            @foreach (var choice in choices)
                            {
                                var id = choice.Id;
                                <button type="button"
                                        class="site-constellation"
                                        data-constellation="@id"
                                        aria-pressed="@(_figures.Contains(id) ? "true" : "false")"
                                        disabled="@(!choice.InImage)"
                                        title="@(choice.InImage ? $"Draw {choice.Name} on the sky plot" : $"{choice.Name} is not in the image at this instant")"
                                        @onclick="() => ToggleFigure(id)">
                                    @choice.Name
                                    @if (!choice.InImage)
                                    {
                                        <span class="visually-hidden">, not in the image at this instant</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="site-note">The installed catalog carries no constellation figures, so none can be drawn.</p>
                    }
                </div>
            </div>
        }
        <p class="site-note site-provenance"><span class="status-icon @Provenance.Icon" aria-hidden="true"></span><span>@Provenance.Text</span></p>
    </section>

    <div class="ops-grid two">
        <section class="ops-panel" aria-labelledby="site-history-heading">
            <header class="ops-panel-heading"><div><h2 id="site-history-heading" tabindex="-1">Location changes</h2><p>Each local draft appends a version; earlier versions and their captures never change.</p></div><span>@(_manual?.History.Count ?? 0) recorded</span></header>
            @if (_manual is not { Supported: true })
            {
                <p class="site-note">This CameraAgent's location owner does not keep a local change history.</p>
            }
            else if (_manual.History.Count == 0)
            {
                <p class="site-note">No local location draft has been recorded. The active location came from installation or LogicHost.</p>
            }
            else
            {
                <div class="ops-table-wrap site-history-wrap">
                    <table class="ops-table">
                        <thead><tr><th scope="col">Recorded</th><th scope="col">By</th><th scope="col">Location</th><th scope="col">Time zone</th><th scope="col">Reason</th></tr></thead>
                        <tbody>
                            @foreach (var entry in _manual.History)
                            {
                                <tr @key="entry.Sequence">
                                    <td>@Timestamp(entry.RecordedAtUtc)</td>
                                    <td>@ActorName(entry.Actor)</td>
                                    <td>@Latitude(entry.LatitudeDegrees), @Longitude(entry.LongitudeDegrees) / @Elevation(entry.ElevationMeters)</td>
                                    <td>@entry.TimeZoneId</td>
                                    <td>@(entry.Reason ?? "Not recorded")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="ops-panel" aria-labelledby="site-settings-heading">
            <header class="ops-panel-heading"><div><h2 id="site-settings-heading">Operator settings</h2><p>One file holds every setting changed on this camera.</p></div><span class="state-chip @(SettingsFileState.Tone)">@SettingsFileState.Label</span></header>
            @if (_site is null)
            {
                <p class="site-note">The operator settings could not be read. Refresh to try again.</p>
            }
            else if (_site.Profile.SettingsFilePath is not { } settingsPath)
            {
                <p class="site-note">This host loads no operator settings file, so settings are changed in its own configuration instead.</p>
            }
            else
            {
                <dl class="ops-facts">
                    <div class="full"><dt>File</dt><dd><code>@settingsPath</code></dd></div>
                </dl>
                @if (_site.Profile.Problem is { } settingsProblem)
                {
                    <p class="site-note">@settingsProblem</p>
                }
                @if (_site.ObjectLimit is { } objectLimit)
                {
                    <fieldset class="site-settings-form" disabled="@(_busy || _loading || _site.Profile.Problem is not null)">
                        <legend class="visually-hidden">Scene object limit</legend>
                        <label class="ops-field">Scene object limit (brightest objects, 1 to @CameraAgentSkyMapProjection.MaximumConfigurableObjects.ToString("N0", System.Globalization.CultureInfo.InvariantCulture))<input id="site-object-limit" inputmode="numeric" autocomplete="off" placeholder="@CameraAgentSkyMapProjection.DefaultMaximumObjects.ToString(System.Globalization.CultureInfo.InvariantCulture)" @bind="_objectLimitInput" @bind:after="ObjectLimitFormChanged" /></label>
                        <div class="site-settings-actions">
                            <button type="button" class="button secondary" @onclick="() => SaveObjectLimitAsync(useDefault: false)">Save limit</button>
                            <button type="button" class="text-button" disabled="@(objectLimit.SavedValue is null)" @onclick="() => SaveObjectLimitAsync(useDefault: true)">Use default</button>
                        </div>
                    </fieldset>
                    @if (objectLimit.Overridden)
                    {
                        <p class="site-note">Another setting source supplies the object limit, so the value saved here has no effect until that source no longer sets it.</p>
                    }
                }
                <p class="site-note">Other settings can be added to this file by hand; it loads over the image's defaults and survives upgrades. On an installer deployment it is <code>state/identity/appsettings.local.json</code> in the instance directory. The object limit and site profile apply at once; most other settings take effect at the next CameraAgent start.</p>
            }
        </section>
    </div>
}

@if (_dialog != SiteDialog.None)
{
    <dialog class="action-dialog operations-dialog site-dialog" aria-labelledby="site-dialog-heading" @ref="_dialogElement" @oncancel="CloseDialog">
        <div class="dialog-header">
            <div><p class="eyebrow">@(_dialog == SiteDialog.Location ? "Local location draft" : "Local site profile")</p><h2 id="site-dialog-heading">@DialogTitle</h2></div>
            <button type="button" class="icon-button" aria-label="Close dialog" disabled="@_busy" @onclick="CloseDialog">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"></path></svg>
            </button>
        </div>
        @if (_dialog == SiteDialog.Location && _manual is { Supported: true } manual)
        {
            <p class="dialog-intro">
                Saving appends location version @manual.NextVersion. It becomes active at the <strong>next CameraAgent start</strong>;
                captures recorded until then keep version @manual.ActiveVersion, and earlier versions and their captures never change.
                Entry is offline: nothing is geocoded and no browser location is read.
            </p>
            @if (manual.CentralAcknowledgementRequired)
            {
                <div class="dialog-note"><strong>LogicHost reviews this draft first.</strong><span>Central integration is on, so the version is proposed to LogicHost and activates only after it is acknowledged and CameraAgent restarts. LogicHost can acknowledge or reject it; it never replaces these coordinates with its own.</span></div>
            }
            @if (manual.StagedAcknowledgementPending)
            {
                <div class="dialog-note"><strong>An acknowledged version is already staged.</strong><span>It activates first at the next start, and this draft is then proposed as its successor.</span></div>
            }
            @if (manual.OverrideSupersededAtUtc is { } supersededAtUtc)
            {
                <div class="dialog-note"><strong>An earlier draft was superseded.</strong><span>The installation's configured location changed at @Timestamp(supersededAtUtc), so configured coordinates govern this deployment.</span></div>
            }
            <fieldset disabled="@_busy">
                <legend class="visually-hidden">Location draft</legend>
                <div class="site-dialog-grid">
                    <label class="ops-field">Latitude (degrees, north positive)<input id="site-latitude" inputmode="decimal" autocomplete="off" @bind="_latitudeInput" @bind:after="LocationFormChanged" /></label>
                    <label class="ops-field">Longitude (degrees, east positive)<input id="site-longitude" inputmode="decimal" autocomplete="off" @bind="_longitudeInput" @bind:after="LocationFormChanged" /></label>
                    <label class="ops-field">Elevation (metres)<input id="site-elevation" inputmode="decimal" autocomplete="off" @bind="_elevationInput" @bind:after="LocationFormChanged" /></label>
                    <label class="ops-field">Time zone (IANA)<input id="site-time-zone" autocomplete="off" @bind="_timeZoneInput" @bind:after="LocationFormChanged" /></label>
                </div>
                <label class="ops-field">Reason (recorded with the version)<input id="site-location-reason" autocomplete="off" maxlength="512" @bind="_locationReasonInput" @bind:after="LocationFormChanged" /></label>
            </fieldset>
        }
        else if (_dialog == SiteDialog.Profile && _site is { } site)
        {
            <p class="dialog-intro">Names and contact details label this camera in the workspace. They stay on this CameraAgent; capture, geometry, and LogicHost registration never read them. Saving writes them to the operator settings file, which can also be edited by hand.</p>
            <fieldset disabled="@_busy">
                <legend class="visually-hidden">Site profile</legend>
                <div class="site-dialog-grid">
                    <label class="ops-field">Observatory name<input id="site-observatory-name" autocomplete="off" maxlength="@SiteProfileLimits.MaximumNameLength" @bind="_observatoryNameInput" @bind:after="ProfileFormChanged" /></label>
                    <label class="ops-field">Camera name<input id="site-camera-name" autocomplete="off" maxlength="@SiteProfileLimits.MaximumNameLength" @bind="_cameraNameInput" @bind:after="ProfileFormChanged" /></label>
                    <label class="ops-field">Owner name<input id="site-owner-name" autocomplete="off" maxlength="@SiteProfileLimits.MaximumNameLength" @bind="_ownerNameInput" @bind:after="ProfileFormChanged" /></label>
                    <label class="ops-field">Owner contact<input id="site-owner-contact" autocomplete="off" maxlength="@SiteProfileLimits.MaximumContactLength" @bind="_ownerContactInput" @bind:after="ProfileFormChanged" /></label>
                </div>
                @if (site.OwnerLoginEmail is { } email && string.IsNullOrWhiteSpace(_ownerContactInput))
                {
                    <button type="button" class="text-button site-use-email" @onclick="() => UseOwnerEmail(email)">Use sign-in email @email</button>
                }
            </fieldset>
            <div class="dialog-note"><span>Leave a field empty to clear it. An empty camera name shows as "This camera".</span></div>
        }
        @if (_notice is not null)
        {
            @* The open modal makes the page behind it inert, so outcomes are announced inside the dialog. *@
            <div class="site-dialog-message"><div class="ops-note-banner compact" role="@(_noticeIsError ? "alert" : "status")"><span class="status-icon @(_noticeIsError ? "failure" : "success")" aria-hidden="true"></span><span>@_notice</span></div></div>
        }
        <footer>
            <button type="button" class="button secondary" disabled="@_busy" autofocus @onclick="CloseDialog">Cancel</button>
            @if (_dialog == SiteDialog.Location)
            {
                <button type="button" class="button primary" disabled="@_busy" @onclick="SaveLocationAsync">Save location draft</button>
            }
            else
            {
                <button type="button" class="button primary" disabled="@_busy" @onclick="SaveProfileAsync">Save profile</button>
            }
        </footer>
    </dialog>
}
