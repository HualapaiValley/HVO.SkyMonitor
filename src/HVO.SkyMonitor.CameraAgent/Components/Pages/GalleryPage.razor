@page "/gallery"
@using HVO.SkyMonitor.AgentCore
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Common.Gallery
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Archive</PageTitle>

@* Structure follows docs/prototypes/pipeline-operations/gallery.html element for element. Counts are of the
   loaded bounded page and are labelled as such; they are never presented as archive totals. Filters bind to
   supported bounded queries; search filters only the loaded page and says so. *@
<div class="gallery-page site-main archive-main">
    <header class="site-heading gallery-title archive-heading">
        <div>
            <p class="eyebrow">Archive / bounded local history</p>
            <h1>Captures</h1>
            <p>One result per acquisition. Every thumbnail identifies whether it displays the reference frame or a multi-source derivative.</p>
        </div>
        <div class="gallery-heading-facts">
            <span aria-live="polite" aria-atomic="true"><strong>@VisibleItems.Count</strong> on this page</span>
            <span><strong>@ArtifactCount</strong> artifacts</span>
            <span><strong>@EventCountLabel</strong> events</span>
        </div>
    </header>

    <section class="gallery-explainer" aria-label="Archive capture image semantics">
        <span class="explainer-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4V5Z"></path><path d="m7 16 3-4 3 3 2-2 2 3"></path></svg></span>
        <div><strong>Each card is one capture and one pipeline run.</strong><p>The thumbnail can be a processed single frame, a causal stack ending at that capture, or a centered derivative targeting it. Source lineage stays visible.</p></div>
        @if (VisibleItems.Count > 0)
        {
            <a href="@DetailUrl(VisibleItems[0].CaptureId)">Open newest capture</a>
        }
    </section>

    <form class="gallery-toolbar" @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault aria-label="Archive capture filters">
        <label class="gallery-search">
            <span>Search captures</span>
            <span class="input-shell">
                <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"></circle><path d="m13 13 4 4"></path></svg>
                <input id="gallerySearch" type="search" placeholder="Sequence, product, or status (this page)" value="@_draftSearch" @oninput="SetDraftSearch" />
            </span>
        </label>
        <label><span>From UTC</span><input id="galleryFrom" type="datetime-local" step="1" value="@_draftFrom" @onchange="SetDraftFrom" /></label>
        <label><span>To UTC</span><input id="galleryTo" type="datetime-local" step="1" value="@_draftTo" @onchange="SetDraftTo" /></label>
        <label><span>Outcome</span>
            <select id="galleryOutcome" value="@_draftOutcome" @onchange="SetDraftOutcome">
                <option value="all">All outcomes</option>
                <option value="Completed">Succeeded</option>
                <option value="Skipped">Attention</option>
                <option value="TerminalFailure">Failed</option>
                <option value="Running">In progress</option>
            </select>
        </label>
        <label><span>Image product</span>
            <select id="galleryProduct" value="@_draftProduct" @onchange="SetDraftProduct">
                <option value="all">All products</option>
                <option value="registered" disabled>Registered stack / design target</option>
                <option value="Combined">Unregistered live mean</option>
                <option value="Calibrated">Single frame</option>
                <option value="Raw">Raw only</option>
            </select>
        </label>
        <div class="view-switcher" role="group" aria-label="Archive capture layout">
            <button id="gridView" class="@(_compact ? "" : "active")" type="button" aria-label="Grid view" aria-pressed="@(_compact ? "false" : "true")" title="Grid view" @onclick="() => SetCompact(false)"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="5" height="5"></rect><rect x="12" y="3" width="5" height="5"></rect><rect x="3" y="12" width="5" height="5"></rect><rect x="12" y="12" width="5" height="5"></rect></svg></button>
            <button id="compactView" class="@(_compact ? "active" : "")" type="button" aria-label="Compact view" aria-pressed="@(_compact ? "true" : "false")" title="Compact view" @onclick="() => SetCompact(true)"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5h10M7 10h10M7 15h10"></path><circle cx="3.5" cy="5" r=".7"></circle><circle cx="3.5" cy="10" r=".7"></circle><circle cx="3.5" cy="15" r=".7"></circle></svg></button>
        </div>
        <div class="toolbar-actions"><button type="submit" class="button secondary small">Apply</button><button type="button" class="button secondary small" @onclick="ClearFilters">Clear</button></div>
    </form>

    <details class="advanced-filters" open="@HasAdvancedFilters">
        <summary>Advanced filters</summary>
        <div class="advanced-filters__grid">
            <div><label for="gallery-origin">Evidence origin</label><select id="gallery-origin" @bind="_draftOrigin"><option value="">Any origin</option><option value="Simulated">Simulated</option><option value="DeveloperFixture">Developer fixture</option><option value="Unknown">Unknown</option></select></div>
            <div><label for="gallery-role">Artifact role</label><select id="gallery-role" @bind="_draftRole"><option value="">Any role</option>@foreach (var role in Enum.GetValues<FrameArtifactRole>()) { <option value="@role">@OperationsPage.SplitWords(role.ToString())</option> }</select></div>
            <div><label for="gallery-recipe">Recipe name</label><input id="gallery-recipe" maxlength="128" @bind="_draftRecipe" /></div>
            <div><label for="gallery-status">Processing status</label><select id="gallery-status" @bind="_draftStatus"><option value="">Any status</option><option value="Pending">Pending</option><option value="Running">Running</option><option value="Completed">Completed</option><option value="Skipped">Skipped</option><option value="RetryableFailure">Retryable failure</option><option value="TerminalFailure">Terminal failure</option></select></div>
            <div><label for="gallery-raw">Raw state</label><input id="gallery-raw" maxlength="64" @bind="_draftRawState" /></div>
            <div><label for="gallery-min-sequence">Minimum sequence</label><input id="gallery-min-sequence" type="number" min="1" step="1" @bind="_draftMinimumSequence" /></div>
            <div><label for="gallery-max-sequence">Maximum sequence</label><input id="gallery-max-sequence" type="number" min="1" step="1" @bind="_draftMaximumSequence" /></div>
            <div><label for="gallery-size">Page size</label><select id="gallery-size" @bind="_draftPageSize"><option value="24">24</option><option value="50">50</option><option value="100">100</option></select></div>
        </div>
    </details>

    @if (_isLoading)
    {
        <section class="gallery-state" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><div><strong>Loading gallery page</strong><p>Reading bounded durable capture metadata.</p></div></section>
    }
    else if (_errorMessage is not null)
    {
        <section class="gallery-state gallery-state--error" role="alert"><div><strong>Gallery unavailable</strong><p>@_errorMessage</p></div><button type="button" class="button secondary small" @onclick="ReloadAsync">Try again</button></section>
    }
    else if (VisibleItems.Count == 0)
    {
        <section id="galleryEmpty" class="gallery-empty" role="status"><strong>No captures match these filters</strong><p>Change the search or product selection to restore results.@(SearchIsActive ? " Search filters the loaded page only." : string.Empty)</p></section>
    }
    else
    {
        @if (_page!.Items.Count == 100 || _page.NextCursor is not null)
        {
            <p class="large-state" role="status">This is a bounded page. Additional capture history remains unloaded.</p>
        }
        <section id="galleryGrid" class="prototype-gallery-grid @(_compact ? "compact" : "")" aria-label="Capture results">
            @foreach (var capture in VisibleItems)
            {
                <ArchiveCard Capture="@capture"
                             Presentation="@CardPresentation(capture)"
                             DetailUrl="@DetailUrl(capture.CaptureId)" />
            }
        </section>
    }

    <footer class="gallery-pagination">
        <span>@(_page is null ? "No bounded page loaded" : $"Showing {VisibleItems.Count} of {_page.Items.Count} loaded capture{(_page.Items.Count == 1 ? string.Empty : "s")}")</span>
        <div>
            <button class="button secondary small" type="button" disabled="@(string.IsNullOrWhiteSpace(Cursor))" @onclick="ShowNewest">Newer</button>
            <button class="button secondary small" type="button" disabled="@(_page?.NextCursor is null)" @onclick="ShowNext">Older captures</button>
        </div>
    </footer>
</div>
