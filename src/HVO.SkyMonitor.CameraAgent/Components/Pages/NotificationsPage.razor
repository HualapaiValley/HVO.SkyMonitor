@inherits SiteTimeComponent
@page "/operations/notifications"
@layout OperationsLayout
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Common.Notifications
@using HVO.SkyMonitor.CameraAgent.Components.Operations
@using HVO.SkyMonitor.CameraAgent.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Operator notifications</PageTitle>

<OperationsPageHeading Eyebrow="System / opt-in alerts" Title="Operator notifications" HeadingId="notifications-heading"
                       Description="Opt-in standalone SMTP email and generic HTTPS webhook notifications for local operational health events. Disabled by default and strictly isolated from capture.">
    <Actions>
        <button type="button" id="notifications-refresh" class="button secondary" disabled="@Busy" @onclick="LoadAsync">
            @(_loading ? "Refreshing…" : "Refresh")
        </button>
    </Actions>
</OperationsPageHeading>

@if (_loading && _view is null)
{
    <div class="ops-note-banner" role="status"><span class="status-icon running" aria-hidden="true"></span><span>Loading notification settings.</span></div>
}
else if (_view is null)
{
    <div class="ops-note-banner" role="alert"><span class="status-icon failure" aria-hidden="true"></span><span><strong>Notifications unavailable.</strong> @_loadError</span></div>
}
else
{
    var status = _view.Status;
    var secrets = _view.Configuration.Secrets;

    @if (_view.Configuration.StoreCorrupt)
    {
        <div id="notifications-corrupt-banner" class="ops-note-banner" role="alert">
            <span class="status-icon failure" aria-hidden="true"></span>
            <span><strong>Saved notification store unreadable.</strong> Delivery is suspended and host configuration fallbacks are blocked until you save replacement settings or disable notifications below.</span>
        </div>
    }

    @if (_banner is not null)
    {
        <div id="notifications-banner" class="ops-note-banner" role="@(_banner.IsError ? "alert" : "status")">
            <span class="status-icon @_banner.Tone" aria-hidden="true"></span>
            <span>@_banner.Text</span>
        </div>
    }

    <section class="ops-status-rail" aria-label="Notification status">
        <div>
            <span>Notifications</span>
            <strong id="notifications-master-state">@(status.Enabled ? "Enabled" : "Disabled")</strong>
            <small>@(status.Enabled ? "Opt-in local dispatch active" : "Off by default; no outbound traffic")</small>
        </div>
        <div>
            <span>SMTP email</span>
            <strong id="notifications-smtp-state">@ChannelStateLabel(status.Smtp)</strong>
            <small>@ChannelDetail(status.Smtp)</small>
        </div>
        <div>
            <span>Generic webhook</span>
            <strong id="notifications-webhook-state">@ChannelStateLabel(status.Webhook)</strong>
            <small>@ChannelDetail(status.Webhook)</small>
        </div>
        <div>
            <span>Queue / anti-storm</span>
            <strong>@status.QueueDepth / @status.QueueCapacity</strong>
            <small>@status.TotalCoalesced coalesced · @(status.TotalSuppressedCooldown + status.TotalSuppressedRateLimit) rate-limited</small>
        </div>
    </section>

    <form class="notifications-form" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
        <fieldset class="notifications-fieldset" disabled="@(!CanEdit)">
            <legend class="visually-hidden">Operator notifications settings</legend>

            <section class="ops-panel ops-grid" aria-labelledby="notifications-optin-heading">
                <header class="ops-panel-heading">
                    <div>
                        <h2 id="notifications-optin-heading">Opt-in &amp; anti-storm bounds</h2>
                        <p>Notifications remain off unless explicitly enabled. Dispatch runs asynchronously with bounded retries and never blocks capture, processing, retention, login, or recovery.</p>
                    </div>
                    <span class="state-chip @(_enabled ? "success" : "pending")">@(_enabled ? "Opted in" : "Off by default")</span>
                </header>

                <label class="notifications-toggle">
                    <input id="notifications-enabled" type="checkbox" @bind="_enabled" />
                    <span><strong>Enable operator notifications</strong><small>Turn on asynchronous local health alerts via the channels configured below.</small></span>
                </label>

                <div class="notifications-row three">
                    <label class="ops-field">Max notifications per hour
                        <input id="notifications-hourly-cap" type="number" min="1" max="60" @bind="_maxNotificationsPerHour" />
                    </label>
                    <label class="ops-field">Request timeout (seconds)
                        <input id="notifications-timeout" type="number" min="1" max="30" @bind="_requestTimeoutSeconds" />
                    </label>
                    <label class="ops-field">Capture stall threshold (minutes)
                        <input id="notifications-stall-threshold" type="number" min="1" max="1440" @bind="_captureStallThresholdMinutes" />
                    </label>
                </div>
            </section>

            <div class="ops-grid two">
                <section class="ops-panel ops-grid" aria-labelledby="notifications-smtp-heading">
                    <header class="ops-panel-heading">
                        <div>
                            <h2 id="notifications-smtp-heading">SMTP email</h2>
                            <p>Works with any standard SMTP mailbox/relay or Azure Communication Services Email SMTP endpoint. Mailpit is excluded from production.</p>
                        </div>
                        <span class="state-chip @ChannelChip(status.Smtp)">@ChannelStateLabel(status.Smtp)</span>
                    </header>

                    <label class="notifications-toggle">
                        <input id="smtp-enabled" type="checkbox" @bind="_smtpEnabled" />
                        <span><strong>Enable SMTP email channel</strong></span>
                    </label>

                    <div class="notifications-row two">
                        <label class="ops-field">SMTP host
                            <input id="smtp-host" autocomplete="off" spellcheck="false" maxlength="@SmtpNotificationOptions.MaximumHostLength"
                                   placeholder="smtp.example.org" @bind="_smtpHost" />
                        </label>
                        <label class="ops-field">Port
                            <input id="smtp-port" type="number" min="1" max="65535" @bind="_smtpPort" />
                        </label>
                    </div>

                    <div class="notifications-row two">
                        <label class="ops-field">Transport security
                            <select id="smtp-security" @bind="_smtpSecurityMode">
                                <option value="@SmtpSecurityMode.StartTls">STARTTLS (port 587, fail-closed)</option>
                                <option value="@SmtpSecurityMode.ImplicitTls">Implicit TLS / SMTPS (port 465)</option>
                                <option value="@SmtpSecurityMode.None">None (unauthenticated local LAN relay only)</option>
                            </select>
                        </label>
                        <label class="ops-field">From display name
                            <input id="smtp-from-name" autocomplete="off" maxlength="@SmtpNotificationOptions.MaximumDisplayNameLength"
                                   @bind="_smtpFromDisplayName" />
                        </label>
                    </div>

                    <label class="ops-field">From address
                        <input id="smtp-from-address" type="email" autocomplete="off" maxlength="@SmtpNotificationOptions.MaximumAddressLength"
                               placeholder="camera@example.org" @bind="_smtpFromAddress" />
                    </label>

                    <label class="ops-field">Recipients (comma-separated, up to @OperatorNotificationsOptions.MaximumRecipients)
                        <input id="smtp-recipients" autocomplete="off" spellcheck="false"
                               placeholder="ops@example.org, oncall@example.org" @bind="_smtpRecipients" />
                    </label>

                    <div class="notifications-secret-box">
                        <div class="notifications-secret-head">
                            <strong>Protected SMTP credentials</strong>
                            <span class="notifications-secret-meta" id="smtp-secret-status">
                                Username: @SecretSourceText(secrets.HasSmtpUsername, secrets.SmtpUsernameSource) · Password: @SecretSourceText(secrets.HasSmtpPassword, secrets.SmtpPasswordSource)
                            </span>
                        </div>
                        <p class="notifications-hint">Stored encrypted with ASP.NET Core Data Protection. STARTTLS or Implicit TLS is required whenever SMTP credentials are configured; SecurityMode=None is limited to unauthenticated local LAN relays. Leave blank to keep the existing credential; saved values are never returned to the browser.</p>
                        <div class="notifications-row two">
                            <label class="ops-field">SMTP username (write-only)
                                <input id="smtp-username" type="password" autocomplete="new-password"
                                       placeholder="@(secrets.HasSmtpUsername ? "Stored — enter to replace" : "Optional username")"
                                       @bind="_smtpUsernameInput" />
                            </label>
                            <label class="ops-field">SMTP password (write-only)
                                <input id="smtp-password" type="password" autocomplete="new-password"
                                       placeholder="@(secrets.HasSmtpPassword ? "Stored — enter to replace" : "Optional password")"
                                       @bind="_smtpPasswordInput" />
                            </label>
                        </div>
                        <div class="notifications-clear-row">
                            <label><input id="smtp-clear-username" type="checkbox" @bind="_clearSmtpUsername" /> Clear stored username</label>
                            <label><input id="smtp-clear-password" type="checkbox" @bind="_clearSmtpPassword" /> Clear stored password</label>
                        </div>
                    </div>
                </section>

                <section class="ops-panel ops-grid" aria-labelledby="notifications-webhook-heading">
                    <header class="ops-panel-heading">
                        <div>
                            <h2 id="notifications-webhook-heading">Generic HTTP POST webhook</h2>
                            <p>Optional JSON webhook compatible with Slack, ntfy, Pushover, and generic HTTPS receivers. Redirects and loopback/metadata addresses are refused.</p>
                        </div>
                        <span class="state-chip @ChannelChip(status.Webhook)">@ChannelStateLabel(status.Webhook)</span>
                    </header>

                    <label class="notifications-toggle">
                        <input id="webhook-enabled" type="checkbox" @bind="_webhookEnabled" />
                        <span><strong>Enable generic webhook channel</strong></span>
                    </label>

                    <div class="notifications-row two">
                        <label class="ops-field">Payload profile
                            <select id="webhook-format" @bind="_webhookFormat">
                                <option value="@WebhookPayloadFormat.Generic">Generic JSON</option>
                                <option value="@WebhookPayloadFormat.Slack">Slack incoming webhook</option>
                                <option value="@WebhookPayloadFormat.Ntfy">ntfy (root JSON or topic-path text)</option>
                                <option value="@WebhookPayloadFormat.Pushover">Pushover Messages API</option>
                            </select>
                        </label>
                        <label class="ops-field">Auth header name
                            <input id="webhook-auth-header" autocomplete="off" spellcheck="false" maxlength="@WebhookNotificationOptions.MaximumHeaderNameLength"
                                   placeholder="Authorization" @bind="_webhookAuthHeaderName" />
                        </label>
                    </div>

                    <div class="notifications-secret-box">
                        <div class="notifications-secret-head">
                            <strong>Protected webhook endpoint &amp; tokens</strong>
                            <span class="notifications-secret-meta" id="webhook-secret-status">
                                URL: @WebhookUrlStatusText(secrets) · Token: @SecretSourceText(secrets.HasWebhookAuthToken, secrets.WebhookAuthTokenSource)@if (_webhookFormat == WebhookPayloadFormat.Ntfy || secrets.HasWebhookNtfyTopic) { <text> · Topic: @SecretSourceText(secrets.HasWebhookNtfyTopic, secrets.WebhookNtfyTopicSource)</text> }
                            </span>
                        </div>
                        <p class="notifications-hint">Webhook URLs, auth tokens, and ntfy topics are stored encrypted and never returned to the browser. Only the URL scheme and host are shown after saving.</p>
                        <label class="ops-field">HTTPS webhook URL (write-only)
                            <input id="webhook-url" type="password" autocomplete="new-password"
                                   placeholder="@(secrets.HasWebhookUrl ? "Stored — enter new HTTPS URL to replace" : "https://hooks.example.org/...")"
                                   @bind="_webhookUrlInput" />
                        </label>
                        <div class="notifications-row two">
                            <label class="ops-field">@(_webhookFormat == WebhookPayloadFormat.Pushover ? "Pushover app token (write-only)" : "Bearer / auth token (write-only)")
                                <input id="webhook-auth-token" type="password" autocomplete="new-password"
                                       placeholder="@(secrets.HasWebhookAuthToken ? "Stored — enter to replace" : "Optional token")"
                                       @bind="_webhookAuthTokenInput" />
                            </label>
                            @if (_webhookFormat == WebhookPayloadFormat.Pushover)
                            {
                                <label class="ops-field">Pushover user key (write-only)
                                    <input id="webhook-user-key" type="password" autocomplete="new-password"
                                           placeholder="@(secrets.HasWebhookUserKey ? "Stored — enter to replace" : "Required for Pushover")"
                                           @bind="_webhookUserKeyInput" />
                                </label>
                            }
                            else if (_webhookFormat == WebhookPayloadFormat.Ntfy)
                            {
                                <label class="ops-field">ntfy topic (write-only; required for root URL)
                                    <input id="webhook-ntfy-topic" type="password" autocomplete="new-password"
                                           maxlength="@WebhookNotificationOptions.MaximumTopicLength"
                                           placeholder="@(secrets.HasWebhookNtfyTopic ? "Stored — enter to replace" : "Required when URL ends with /")"
                                           @bind="_webhookNtfyTopicInput" />
                                </label>
                            }
                        </div>
                        <div class="notifications-clear-row">
                            <label><input id="webhook-clear-url" type="checkbox" @bind="_clearWebhookUrl" /> Clear stored URL</label>
                            <label><input id="webhook-clear-token" type="checkbox" @bind="_clearWebhookAuthToken" /> Clear stored token</label>
                            @if (_webhookFormat == WebhookPayloadFormat.Pushover || secrets.HasWebhookUserKey)
                            {
                                <label><input id="webhook-clear-user-key" type="checkbox" @bind="_clearWebhookUserKey" /> Clear user key</label>
                            }
                            @if (_webhookFormat == WebhookPayloadFormat.Ntfy || secrets.HasWebhookNtfyTopic)
                            {
                                <label><input id="webhook-clear-ntfy-topic" type="checkbox" @bind="_clearWebhookNtfyTopic" /> Clear stored topic</label>
                            }
                        </div>
                    </div>

                    <label class="notifications-toggle compact">
                        <input id="webhook-allow-private" type="checkbox" @bind="_webhookAllowPrivateNetwork" />
                        <span>Allow private LAN HTTPS webhook hosts (RFC 1918 / ULA). Loopback, link-local, and cloud metadata remain blocked.</span>
                    </label>
                </section>
            </div>

            <section class="ops-panel ops-grid" aria-labelledby="notifications-events-heading">
                <header class="ops-panel-heading">
                    <div>
                        <h2 id="notifications-events-heading">Bounded operational health events</h2>
                        <p>Select which of the five local health signals trigger alerts and set per-event cooldown windows to prevent alert storms.</p>
                    </div>
                </header>

                <div class="ops-table-wrap">
                    <table class="ops-table notifications-events-table">
                        <thead>
                            <tr>
                                <th scope="col">Event</th>
                                <th scope="col">Enabled</th>
                                <th scope="col">Cooldown / schedule</th>
                                <th scope="col">Signal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Capture stalled</strong></td>
                                <td><input id="event-capture-stalled" type="checkbox" aria-label="Enable capture stalled notification" @bind="_captureStalledEnabled" /></td>
                                <td><input id="cooldown-capture-stalled" type="number" min="1" max="1440" aria-label="Capture stalled cooldown minutes" @bind="_captureStalledCooldown" /> min</td>
                                <td>No successful capture within stall threshold while running and schedule-admitted.</td>
                            </tr>
                            <tr>
                                <td><strong>Camera disconnected</strong></td>
                                <td><input id="event-camera-disconnected" type="checkbox" aria-label="Enable camera disconnected notification" @bind="_cameraDisconnectedEnabled" /></td>
                                <td><input id="cooldown-camera-disconnected" type="number" min="1" max="1440" aria-label="Camera disconnected cooldown minutes" @bind="_cameraDisconnectedCooldown" /> min</td>
                                <td>Camera module unavailable or active rig runtime failure persisted past threshold.</td>
                            </tr>
                            <tr>
                                <td><strong>Disk pressure</strong></td>
                                <td><input id="event-disk-pressure" type="checkbox" aria-label="Enable disk pressure notification" @bind="_diskPressureEnabled" /></td>
                                <td><input id="cooldown-disk-pressure" type="number" min="1" max="1440" aria-label="Disk pressure cooldown minutes" @bind="_diskPressureCooldown" /> min</td>
                                <td>Local storage volume under disk pressure or capacity probe failure (sanitized volume alias).</td>
                            </tr>
                            <tr>
                                <td><strong>Upgrade / recovery failed</strong></td>
                                <td><input id="event-upgrade-failed" type="checkbox" aria-label="Enable upgrade or recovery failed notification" @bind="_upgradeFailedEnabled" /></td>
                                <td><input id="cooldown-upgrade-failed" type="number" min="1" max="1440" aria-label="Upgrade or recovery failed cooldown minutes" @bind="_upgradeFailedCooldown" /> min</td>
                                <td>Failed installer lifecycle receipt, retained-integrity recovery requirement, or unavailable admission.</td>
                            </tr>
                            <tr>
                                <td><strong>Daily heartbeat</strong></td>
                                <td><input id="event-daily-heartbeat" type="checkbox" aria-label="Enable daily heartbeat notification" @bind="_dailyHeartbeatEnabled" /></td>
                                <td><input id="daily-heartbeat-time" type="text" maxlength="5" placeholder="08:00" aria-label="Daily heartbeat time HH:mm" @bind="_dailyHeartbeatTime" /> (site time)</td>
                                <td>Once-per-day operational health summary with capture state, disk status, and uptime.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="notifications-actions">
                    <button type="submit" id="notifications-save" class="button primary" disabled="@(!CanEdit)">
                        @(_saving ? "Saving…" : "Save settings")
                    </button>
                    @if (!_view.CanMutate)
                    {
                        <span class="notifications-hint">Read-only access: sign in as the local owner to edit settings or send test alerts.</span>
                    }
                    else if (!_view.Configuration.CanPersist)
                    {
                        <span class="notifications-hint">This host is running without persistent notification storage.</span>
                    }
                </div>
            </section>
        </fieldset>
    </form>

    <section class="ops-panel ops-grid" aria-labelledby="notifications-test-heading">
        <header class="ops-panel-heading">
            <div>
                <h2 id="notifications-test-heading">Verification test-send</h2>
                <p>Send a sanitized test alert using the saved configuration and protected credentials. Stored secrets are never echoed in results or logs.</p>
            </div>
        </header>

        <div class="notifications-actions">
            <button type="button" id="notifications-test-all" class="button secondary" disabled="@(!CanTest)" @onclick="() => SendTestAsync(NotificationTestTarget.AllEnabled)">
                @(_testing ? "Testing…" : "Test enabled channels")
            </button>
            <button type="button" id="notifications-test-smtp" class="button secondary" disabled="@(!CanTest)" @onclick="() => SendTestAsync(NotificationTestTarget.Smtp)">
                Test SMTP
            </button>
            <button type="button" id="notifications-test-webhook" class="button secondary" disabled="@(!CanTest)" @onclick="() => SendTestAsync(NotificationTestTarget.Webhook)">
                Test webhook
            </button>
        </div>

        @if (_lastTestResult is not null)
        {
            <div id="notifications-test-result" class="notifications-test-results" role="status">
                @if (_lastTestResult.RateLimited)
                {
                    <div class="ops-note-banner compact"><span class="status-icon warning" aria-hidden="true"></span><span>Test send rate-limited. Wait briefly before trying again.</span></div>
                }
                else
                {
                    @foreach (var channel in _lastTestResult.Channels)
                    {
                        <div class="ops-note-banner compact">
                            <span class="status-icon @(!channel.Attempted ? "pending" : channel.Succeeded ? "success" : "failure")" aria-hidden="true"></span>
                            <span><strong>@channel.Channel.ToUpperInvariant():</strong> @channel.Message @if (channel.Attempted) { <small>(@channel.ReasonCode · @channel.DurationMilliseconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) ms)</small> }</span>
                        </div>
                    }
                }
            </div>
        }
    </section>

    <section class="ops-panel ops-grid" aria-labelledby="notifications-history-heading">
        <header class="ops-panel-heading">
            <div>
                <h2 id="notifications-history-heading">Recent delivery history</h2>
                <p>Bounded in-memory delivery audit (last 20 attempts). Only sanitized event slugs, channels, and reason codes are recorded.</p>
            </div>
        </header>

        @if (status.RecentDeliveries.Count == 0)
        {
            <p class="notifications-hint" id="notifications-history-empty">No notification deliveries have been attempted since CameraAgent started.</p>
        }
        else
        {
            <div class="ops-table-wrap">
                <table class="ops-table" id="notifications-history-table">
                    <thead>
                        <tr>
                            <th scope="col">Time</th>
                            <th scope="col">Event</th>
                            <th scope="col">Channel</th>
                            <th scope="col">Outcome</th>
                            <th scope="col">Reason</th>
                            <th scope="col">Coalesced</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in status.RecentDeliveries)
                        {
                            <tr>
                                <td>@FormatSiteTime(entry.OccurredUtc)</td>
                                <td>@(entry.IsTest ? "test" : entry.EventKind)</td>
                                <td>@entry.Channel</td>
                                <td><span class="state-chip @(entry.Outcome == "sent" ? "success" : "warning")">@entry.Outcome</span></td>
                                <td>@entry.ReasonCode</td>
                                <td>@entry.CoalescedCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
