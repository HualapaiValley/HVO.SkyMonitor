@page "/"

<PageTitle>Capture Dashboard</PageTitle>

<div class="dashboard">
	<section class="dashboard__header">
		<div>
			<h1>Capture Telemetry</h1>
			<p class="text-muted">Live cadence, exposure, and gain data streaming directly from the capture loop.</p>
		</div>
		<span class="status-pill @StatusCssClass">@StatusText</span>
	</section>

	<section class="telemetry-grid">
		<article class="telemetry-card">
			<span class="telemetry-card__label">Avg Interval</span>
			<span class="telemetry-card__value">@FormatMs(Aggregate?.AverageIntervalMilliseconds)</span>
			<span class="telemetry-card__hint">Target @FormatTimeSpan(LatestSample?.Interval)</span>
		</article>
		<article class="telemetry-card">
			<span class="telemetry-card__label">Avg Exposure</span>
			<span class="telemetry-card__value">@FormatMs(Aggregate?.AverageExposureMilliseconds)</span>
			<span class="telemetry-card__hint">Gain @FormatGain(LatestSample?.Gain)</span>
		</article>
		<article class="telemetry-card">
			<span class="telemetry-card__label">Duty Cycle</span>
			<span class="telemetry-card__value">@FormatPercent(Aggregate?.DutyCycle)</span>
			<span class="telemetry-card__hint">Avg loop @FormatMs(Aggregate?.AverageLoopMilliseconds)</span>
		</article>
		<article class="telemetry-card">
			<span class="telemetry-card__label">Frames / min</span>
			<span class="telemetry-card__value">@FormatNumber(Aggregate?.CapturesPerMinute)</span>
			<span class="telemetry-card__hint">Stored @(Aggregate?.FramesStored ?? 0)</span>
		</article>
	</section>

	<section class="latest-frame">
		<div class="latest-frame__heading">
			<div>
				<h2>Latest Capture</h2>
				<p class="text-muted">Raw sensor output beside the current rolling stack.</p>
			</div>
			@if (Rig is not null)
			{
				<div class="rig-summary" aria-label="Active camera rig">
					<span class="rig-summary__label">Active Rig</span>
					<strong>@Rig.Sensor.Name</strong>
					<span>@Rig.Sensor.WidthPixels x @Rig.Sensor.HeightPixels · @Rig.Sensor.PixelFormat</span>
					<span>@Rig.Optics.ProjectionModel · @Rig.Optics.FieldOfViewDegrees.ToString("F0") deg FOV</span>
					<span>Alt @Rig.Orientation.BoresightAltitudeDegrees.ToString("F1") deg · Az @Rig.Orientation.BoresightAzimuthDegrees.ToString("F1") deg</span>
				</div>
			}
		</div>
		@if (LatestSample is null)
		{
			<p class="text-muted">Waiting for telemetry…</p>
		}
		else
		{
			<div class="latest-frame__grid">
				<div>
					<span class="label">Captured</span>
					<span class="value">@FormatTimestamp(LatestSample.StartedUtc)</span>
				</div>
				<div>
					<span class="label">Exposure</span>
					<span class="value">@FormatMs(LatestSample.Exposure.TotalMilliseconds)</span>
				</div>
				<div>
					<span class="label">Gain</span>
					<span class="value">@FormatGain(LatestSample.Gain)</span>
				</div>
				<div>
					<span class="label">Processing</span>
					<span class="value">@FormatMs(LatestSample.ProcessingLatency.TotalMilliseconds)</span>
				</div>
				<div>
					<span class="label">Interval</span>
					<span class="value">@FormatMs(LatestSample.Interval.TotalMilliseconds)</span>
				</div>
				<div>
					<span class="label">Mode</span>
					<span class="value">@LatestSample.Mode</span>
				</div>
			</div>

			<div class="latest-frame__previews">
				<figure class="frame-preview-card">
					<figcaption>
						<span>Individual Frame</span>
						<small>Raw Mono16, displayed as JPEG</small>
					</figcaption>
					@if (!string.IsNullOrEmpty(RawPreviewImageSource))
					{
						<img src="@RawPreviewImageSource" alt="Latest raw camera frame" />
					}
					<dl class="frame-details">
						<div><dt>Captured</dt><dd>@FormatFrameTimestamp(RawFrame)</dd></div>
						<div><dt>Exposure</dt><dd>@FormatFrameExposure(RawFrame)</dd></div>
						<div><dt>Gain</dt><dd>@FormatFrameGain(RawFrame)</dd></div>
						<div><dt>Offset</dt><dd>@FormatFrameOffset(RawFrame)</dd></div>
					</dl>
				</figure>
				<figure class="frame-preview-card">
					<figcaption>
						<span>Rolling Stack</span>
						<small>Current processed combination</small>
					</figcaption>
					@if (!string.IsNullOrEmpty(ProcessedPreviewImageSource))
					{
						<img src="@ProcessedPreviewImageSource" alt="Latest processed stacked frame" />
					}
					<dl class="frame-details">
						<div><dt>Captured</dt><dd>@FormatFrameTimestamp(ProcessedFrame)</dd></div>
						<div><dt>Frames</dt><dd>@FormatStackCount(ProcessedFrame)</dd></div>
						<div><dt>Stack</dt><dd>@(ProcessedFrame?.RecipeVersion ?? "—")</dd></div>
						<div><dt>Integration</dt><dd>@FormatStackIntegration(ProcessedFrame)</dd></div>
					</dl>
				</figure>
			</div>
		}
	</section>

	<section class="history">
		<div class="history__header">
			<h2>Recent Captures</h2>
			<button class="btn btn-sm btn-outline-light" @onclick="RefreshAsync" disabled="@IsRefreshing">
				<i class="bi bi-arrow-repeat"></i>
				Refresh
			</button>
		</div>
		@if (RecentSamples.Count == 0)
		{
			<p class="text-muted">No telemetry buffered yet.</p>
		}
		else
		{
			<div class="table-responsive">
				<table class="table table-dark table-sm align-middle mb-0">
					<thead>
						<tr>
							<th scope="col">Time (UTC)</th>
							<th scope="col">Interval</th>
							<th scope="col">Exposure</th>
							<th scope="col">Gain</th>
							<th scope="col">Loop</th>
							<th scope="col">Flags</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var sample in RecentSamples)
						{
							<tr>
								<td>@sample.StartedUtc.ToString("HH:mm:ss")</td>
								<td>@FormatMs(sample.Interval.TotalMilliseconds)</td>
								<td>@FormatMs(sample.Exposure.TotalMilliseconds)</td>
								<td>@FormatGain(sample.Gain)</td>
								<td>@FormatMs(sample.LoopDuration.TotalMilliseconds)</td>
								<td>
									@if (sample.RequiresImmediateUpload)
									{
										<span class="badge text-bg-danger">Immediate Upload</span>
									}
									@if (!sample.FrameStored)
									{
										<span class="badge text-bg-warning">Not Stored</span>
									}
									else
									{
										<span class="badge text-bg-success">Stored</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
</div>
