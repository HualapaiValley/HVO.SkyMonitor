@page "/devices/bootstrap"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using HVO.SkyMonitor.CameraAgent.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]

<PageTitle>Device Bootstrap</PageTitle>

<div class="container py-4 device-bootstrap">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Device Bootstrap</h1>
            <p class="text-muted mb-0">Pair this CameraAgent with LogicHost without editing capture configuration.</p>
        </div>
        <div class="ms-lg-auto d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" disabled="@IsBusy" @onclick="ReloadAsync">
                <i class="bi bi-arrow-repeat me-1"></i>
                Refresh
            </button>
            @if (Secrets is not null)
            {
                <button type="button" class="btn btn-outline-danger" disabled="@IsBusy" @onclick="ClearSecretsAsync">
                    <i class="bi bi-x-circle me-1"></i>
                    Clear Secrets
                </button>
            }
        </div>
    </div>

    @if (IsCentralIntegrationDisabled)
    {
        <div class="alert alert-info" role="status">
            <i class="bi bi-info-circle me-2"></i>
            LogicHost integration is disabled. This CameraAgent is operating independently and cannot import a bootstrap envelope.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(SubmitError))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @SubmitError
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(SubmitSuccess))
    {
        <div class="alert alert-success" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @SubmitSuccess
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(CopyStatus))
    {
        <div class="alert alert-secondary py-2" role="status">@CopyStatus</div>
    }

    @if (!IsCentralIntegrationDisabled)
    {
        <section class="pairing-guide mb-4" aria-labelledby="pairing-guide-title">
            <div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-end mb-3">
                <div>
                    <div class="eyebrow">Cross-host pairing</div>
                    <h2 id="pairing-guide-title" class="h4 mb-1">One secure handoff, four checkpoints</h2>
                    <p class="text-muted mb-0">You are signed in here with the <strong>CameraAgent local owner account</strong>. LogicHost uses a separate <strong>observatory owner account</strong>.</p>
                </div>
                <a class="btn btn-primary ms-lg-auto" href="@LogicHostRegistrationUri" target="_blank" rel="noopener noreferrer">
                    Open LogicHost registration <i class="bi bi-box-arrow-up-right ms-1"></i>
                </a>
            </div>
            <ol class="pairing-steps list-unstyled mb-0">
                <li class="pairing-step complete">
                    <span class="step-marker">1</span>
                    <div><strong>Collect local identity</strong><span>Copy the Device ID and one-time verification code below.</span></div>
                </li>
                <li class="pairing-step @(Secrets is null ? "current" : "complete")" aria-current="@(Secrets is null ? "step" : null)">
                    <span class="step-marker">2</span>
                    <div><strong>Verify on LogicHost</strong><span>Sign in there as an observatory owner, select the observatory, and issue an envelope.</span></div>
                </li>
                <li class="pairing-step @(Secrets is null ? null : "complete")">
                    <span class="step-marker">3</span>
                    <div><strong>Return the envelope</strong><span>Paste the short-lived envelope on this page. It is never placed in a URL.</span></div>
                </li>
                <li class="pairing-step @(IsCaptureIdentityAligned && IsHeartbeatReady && IsUploadReady ? "complete" : null)">
                    <span class="step-marker">4</span>
                    <div><strong>Confirm readiness</strong><span>Identity, heartbeat, and artifact delivery are checked below.</span></div>
                </li>
            </ol>
        </section>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-5">
            <div class="card h-100">
                <div class="card-header">
                    <h2 class="h5 mb-0">Device Identity</h2>
                </div>
                <div class="card-body">
                    @if (IsCentralIntegrationDisabled)
                    {
                        <p class="text-muted mb-0">Central device identity is not generated in standalone mode.</p>
                    }
                    else if (Identity is null)
                    {
                        <div class="text-muted">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                            Generating identity...
                        </div>
                    }
                    else
                    {
                        <dl class="row small mb-0">
                            <dt class="col-sm-4">Device ID</dt>
                            <dd class="col-sm-8">
                                <div class="copy-value"><span class="mono">@Identity.DeviceId</span><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CopyDeviceIdAsync" aria-label="Copy Device ID"><i class="bi bi-clipboard"></i></button></div>
                            </dd>
                            <dt class="col-sm-4">Verification Code</dt>
                            <dd class="col-sm-8">
                                <div class="copy-value"><span class="mono">@Identity.VerificationCode</span><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CopyVerificationCodeAsync" aria-label="Copy verification code"><i class="bi bi-clipboard"></i></button></div>
                            </dd>
                            <dt class="col-sm-4">Created</dt>
                            <dd class="col-sm-8">@FormatTimestamp(Identity.CreatedUtc)</dd>
                        </dl>
                        <p class="text-muted small mt-3 mb-0">
                            Copy both values into LogicHost. A pending registration for this same device can be verified again. Revoke an active registration before pairing the device again.
                        </p>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-7">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h2 class="h5 mb-0">Bootstrap Envelope</h2>
                    <span
                        class="badge @(Secrets is null ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success")">
                        @(Secrets is null ? "Not Registered" : "Registered")
                    </span>
                </div>
                <div class="card-body">
                    @if (IsCentralIntegrationDisabled)
                    {
                        <p class="text-muted mb-0">Enable LogicHost integration and restart before pairing this CameraAgent.</p>
                    }
                    else
                    {
                    <EditForm Model="this" OnValidSubmit="SubmitAsync">
                        <div class="mb-3">
                            <label class="form-label" for="envelopeInput">Envelope</label>
                            <textarea id="envelopeInput" class="form-control envelope-input" rows="6"
                                @bind="EnvelopeInput" placeholder="Paste the envelope string issued by LogicHost"
                                required></textarea>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@IsBusy">
                                @if (IsBusy)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                <i class="bi bi-plug me-1"></i>
                                Bootstrap
                            </button>
                        </div>
                    </EditForm>
                    }
                    @if (Secrets is not null)
                    {
                        <div class="mt-4">
                            <h3 class="h6">Current Registration</h3>
                            <dl class="row small mb-0">
                                <dt class="col-sm-4">Friendly Name</dt>
                                <dd class="col-sm-8">@Secrets.FriendlyName</dd>
                                <dt class="col-sm-4">Observatory</dt>
                                <dd class="col-sm-8 mono">@Secrets.ObservatoryId</dd>
                                <dt class="col-sm-4">Device Public Id</dt>
                                <dd class="col-sm-8 mono">@Secrets.DevicePublicId</dd>
                                <dt class="col-sm-4">Issued</dt>
                                <dd class="col-sm-8">@FormatTimestamp(Secrets.IssuedAtUtc)</dd>
                                <dt class="col-sm-4">Expires</dt>
                                <dd class="col-sm-8">@FormatTimestamp(Secrets.ExpiresAtUtc)</dd>
                            </dl>
                            @if (Secrets.CentralIdentity is not null)
                            {
                                <div class="mt-3">
                                    <h4 class="h6">LogicHost Central Identity</h4>
                                    <dl class="row small mb-0">
                                        <dt class="col-sm-4">Authority</dt>
                                        <dd class="col-sm-8 mono">@Secrets.CentralIdentity.ServiceUrl</dd>
                                        <dt class="col-sm-4">Token Endpoint</dt>
                                        <dd class="col-sm-8 mono">@Secrets.CentralIdentity.TokenEndpoint</dd>
                                        <dt class="col-sm-4">Client Id</dt>
                                        <dd class="col-sm-8 mono">@Secrets.CentralIdentity.ClientCredentials?.ClientId</dd>
                                        <dt class="col-sm-4">Interactive Client</dt>
                                        <dd class="col-sm-8 mono">@Secrets.CentralIdentity.InteractiveClient?.ClientId</dd>
                                    </dl>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!IsCentralIntegrationDisabled)
    {
        <section class="card readiness-card mt-4" aria-labelledby="readiness-title">
            <div class="card-header d-flex flex-column flex-md-row gap-2 align-items-md-center">
                <div>
                    <div class="eyebrow">Final checkpoint</div>
                    <h2 id="readiness-title" class="h5 mb-0">Pairing readiness</h2>
                </div>
                <span class="badge ms-md-auto @(IsCaptureIdentityAligned && IsHeartbeatReady && IsUploadReady ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                    @(IsCaptureIdentityAligned && IsHeartbeatReady && IsUploadReady ? "Ready" : "Waiting")
                </span>
            </div>
            <div class="card-body readiness-grid">
                <div class="readiness-item">
                    <i class="bi @(IsCaptureIdentityAligned ? "bi-check-circle-fill text-success" : "bi-exclamation-circle text-warning")"></i>
                    <div><strong>Capture identity</strong><span>@(IsCaptureIdentityAligned ? $"Aligned as {CaptureAgentId}" : "Capture and provisioned device identities do not match.")</span></div>
                </div>
                <div class="readiness-item">
                    <i class="bi @(IsHeartbeatReady ? "bi-check-circle-fill text-success" : "bi-clock text-warning")"></i>
                    <div><strong>LogicHost heartbeat</strong><span>@(IsHeartbeatReady ? $"Acknowledged {FormatTimestamp(Heartbeat.LastAcknowledgedUtc!.Value)}" : Secrets is null ? "Complete bootstrap first." : "Waiting for the first acknowledgement.")</span></div>
                </div>
                <div class="readiness-item">
                    <i class="bi @(IsUploadReady ? "bi-check-circle-fill text-success" : "bi-clock text-warning")"></i>
                    <div><strong>Local upload queue</strong><span>@(!HostOptions.Value.CaptureDistribution.UploadEnabled ? "Upload is disabled in CameraAgent settings." : IsUploadReady ? $"Healthy; {Outbox.PendingCount} pending, {Outbox.RetryCount} retrying." : Secrets is null ? "Complete bootstrap first." : $"{Outbox.Availability}; {Outbox.RetryCount} retrying, {Outbox.QuarantineCount} quarantined.")</span></div>
                </div>
            </div>
        </section>
    }
</div>
