@page "/gallery/{CaptureId:guid}"
@using HVO.SkyMonitor.AgentCore
@using HVO.SkyMonitor.CameraAgent.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Capture detail</PageTitle>

<div class="detail-page">
    @if (_isLoading)
    {
        <PageHeader Title="Capture detail" />
        <section class="detail-state" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><strong>Loading exact capture facts</strong></section>
    }
    else if (_errorMessage is not null || _capture is null)
    {
        <PageHeader Title="Capture detail" />
        <section class="detail-state detail-state--error" role="alert"><div><strong>Capture unavailable</strong><p>@(_errorMessage ?? "The requested capture was not found.")</p></div><a class="btn btn-outline-light" href="@BackUrl">Return to gallery results</a></section>
    }
    else
    {
        <CurrentSkyPage @key="_capture.CaptureId" ArchivedView="@_view">
            <ArchiveNavigation>
                <nav class="capture-navigation" aria-label="Adjacent captures">
                    @if (_previousCaptureId is { } previousCaptureId)
                    {
                        <a class="capture-navigation__control" href="@CaptureUrl(previousCaptureId)" aria-label="Previous capture" title="Previous capture"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                    }
                    else
                    {
                        <span class="capture-navigation__control capture-navigation__control--disabled" title="Previous capture unavailable"><i class="bi bi-chevron-left" aria-hidden="true"></i><span class="visually-hidden">Previous capture unavailable</span></span>
                    }
                    <a class="capture-navigation__archive" href="@BackUrl">All captures</a>
                    @if (_nextCaptureId is { } nextCaptureId)
                    {
                        <a class="capture-navigation__control" href="@CaptureUrl(nextCaptureId)" aria-label="Next capture" title="Next capture"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    }
                    else
                    {
                        <span class="capture-navigation__control capture-navigation__control--disabled" title="Next capture unavailable"><i class="bi bi-chevron-right" aria-hidden="true"></i><span class="visually-hidden">Next capture unavailable</span></span>
                    }
                </nav>
            </ArchiveNavigation>
            <Evidence>
                <section id="technical-evidence" class="capture-evidence" tabindex="-1" aria-labelledby="capture-evidence-heading">
                    <header class="capture-evidence__header">
                        <div><p class="eyebrow">Retained capture</p><h2 id="capture-evidence-heading">Evidence and downloads</h2></div>
                        <div class="evidence-tabs" role="tablist" aria-label="Capture evidence views">
                            @foreach (var tab in EvidenceTabs)
                            {
                                var selected = tab == _evidenceTab;
                                <button id="evidence-tab-@tab" type="button" role="tab" aria-selected="@(selected ? "true" : "false")" aria-controls="evidence-panel-@tab" tabindex="@(selected ? 0 : -1)" class="@(selected ? "active" : "")" @onclick="() => _evidenceTab = tab" @ref="_evidenceTabButtons[tab]" @onkeydown="args => MoveEvidenceTabAsync(args, tab)">@EvidenceTabLabel(tab)@if (tab == EvidenceTab.Artifacts) { <span>@_capture.Artifacts.Count</span> }</button>
                            }
                        </div>
                    </header>

                    <div id="evidence-panel-@EvidenceTab.Overview" class="evidence-panel" role="tabpanel" aria-labelledby="evidence-tab-@EvidenceTab.Overview" hidden="@(_evidenceTab != EvidenceTab.Overview)">
                        @if (_capture.Detail is null) { <p class="unavailable-state">Extended capture evidence is unavailable.</p> }
                        <dl class="evidence-summary">
                            <div><dt>Raw state</dt><dd>@OperationsPage.SplitWords(_capture.RawState)</dd></div>
                            <div><dt>Evidence origin</dt><dd>@EvidenceLabel(_capture.EvidenceOrigin)</dd></div>
                            <div><dt>Durable ingress</dt><dd><time datetime="@_capture.DurableIngressUtc.ToString("O")">@GalleryPage.FormatCaptureTime(_capture.DurableIngressUtc)</time></dd></div>
                            <div><dt>Processing profile</dt><dd>@(_capture.Detail?.ProcessingProfile is { } profile ? $"{profile.Name} / {profile.Version}" : "Unavailable")</dd></div>
                            <div><dt>Raw retention hold</dt><dd>@(_capture.Detail?.RawRetentionHold is not { } hold ? "Unavailable" : hold ? "Held" : "Not held")</dd></div>
                            <div><dt>Processing</dt><dd>@CompletedNodeCount of @_capture.ProcessingNodes.Count stages completed</dd></div>
                            <div><dt>Cloud assessment</dt><dd>@CloudSummary</dd></div>
                            <div><dt>Evidence availability</dt><dd>@(_capture.Detail?.EvidenceAvailability ?? "Unavailable")</dd></div>
                        </dl>
                    </div>

                    <div id="evidence-panel-@EvidenceTab.Artifacts" class="evidence-panel" role="tabpanel" aria-labelledby="evidence-tab-@EvidenceTab.Artifacts" hidden="@(_evidenceTab != EvidenceTab.Artifacts)">
                        <h3 class="visually-hidden">Artifacts</h3>
                        @if (_capture.Artifacts.Count == 0) { <p class="unavailable-state">No artifacts are recorded for this capture.</p> }
                        else
                        {
                            <ul class="evidence-rows">
                                @foreach (var artifact in _capture.Artifacts)
                                {
                                    var artifactState = FindArtifactState(artifact.ArtifactId);
                                    var name = ArtifactLabel(artifact.Role);
                                    <li>
                                        <div class="evidence-row">
                                            <div class="evidence-row__name"><strong>@name</strong><small>@(artifact.Variant ?? "Default variant") / @(artifact.Recipe?.Name ?? "Acquisition")</small></div>
                                            <span>@OperationsPage.FormatBytes(artifact.ByteLength)</span>
                                            <span>@(artifactState is null ? "State unavailable" : $"{artifactState.RetentionState} / {artifactState.DeliveryAvailability}")</span>
                                            <div class="evidence-row__actions">
                                                @if (IsProjectedArtifact(artifact.ArtifactId)) { <a href="@GalleryPage.PreviewUrl(artifact.ArtifactId)" aria-label="Open @name preview">Preview</a> }
                                                <a href="@ContentUrl(artifact.ArtifactId)" download aria-label="Download @name content">Download</a>
                                            </div>
                                        </div>
                                        <details class="evidence-identifiers">
                                            <summary>Identifiers and lineage</summary>
                                            <dl>
                                                <div><dt>Artifact ID</dt><dd><code>@artifact.ArtifactId</code></dd></div>
                                                <div><dt>SHA-256</dt><dd><code>@artifact.ChecksumSha256</code></dd></div>
                                                <div><dt>Media type</dt><dd>@(artifact.MediaType ?? "Unspecified")</dd></div>
                                                <div><dt>Created</dt><dd>@(artifact.CreatedUtc is null ? "Unspecified" : GalleryPage.FormatCaptureTime(artifact.CreatedUtc.Value))</dd></div>
                                                <div><dt>Source ID</dt><dd>@(artifact.SourceId ?? "Unspecified")</dd></div>
                                                <div><dt>Processing node</dt><dd>@(artifact.ProcessingNodeId ?? "Acquisition")</dd></div>
                                                <div><dt>Delivery statuses</dt><dd>@(artifactState is null || artifactState.DeliveryStatuses.Count == 0 ? "Unavailable" : string.Join(", ", artifactState.DeliveryStatuses.Select(static delivery => $"{delivery.StorageAlias}: {delivery.Status}")))</dd></div>
                                                <div><dt>Source artifact IDs</dt><dd>@if (artifact.SourceArtifactIds.Count == 0) { <span>Origin artifact</span> } else { @foreach (var source in artifact.SourceArtifactIds) { <code>@source</code> } }</dd></div>
                                                @if (artifact.Recipe is { } recipe)
                                                {
                                                    <div><dt>Recipe version</dt><dd>@recipe.SemanticVersion / @recipe.ImplementationVersion</dd></div>
                                                    <div><dt>Options SHA-256</dt><dd><code>@recipe.OptionsSha256</code></dd></div>
                                                    <div><dt>Identity SHA-256</dt><dd><code>@recipe.IdentitySha256</code></dd></div>
                                                }
                                            </dl>
                                        </details>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <div id="evidence-panel-@EvidenceTab.Processing" class="evidence-panel" role="tabpanel" aria-labelledby="evidence-tab-@EvidenceTab.Processing" hidden="@(_evidenceTab != EvidenceTab.Processing)">
                        @if (_capture.ProcessingNodes.Count == 0) { <p class="unavailable-state">No processing nodes are recorded for this capture.</p> }
                        else
                        {
                            <ul class="evidence-rows">
                                @foreach (var node in _capture.ProcessingNodes)
                                {
                                    var nodeDetail = FindNodeDetail(node.NodeId);
                                    <li>
                                        <div class="evidence-row">
                                            <div class="evidence-row__name"><strong>@OperationsPage.SplitWords(node.NodeId.Replace('-', ' '))</strong><small>@(node.RecipeName ?? "Infrastructure") / @(node.Required ? "required" : "optional")</small></div>
                                            <span>@OperationsPage.SplitWords(node.Status)</span>
                                            <span>@FormatNodeDuration(nodeDetail)</span>
                                            <span>@FormatNodeOutcome(node, nodeDetail)</span>
                                        </div>
                                        <details class="evidence-identifiers">
                                            <summary>Inputs and identifiers</summary>
                                            <dl>
                                                <div><dt>Node ID</dt><dd><code>@node.NodeId</code></dd></div>
                                                <div><dt>Output</dt><dd>@(node.OutputRole is null ? "None" : ArtifactLabel(node.OutputRole.Value)) / @(node.OutputVariant ?? "Unspecified")</dd></div>
                                                <div><dt>Dependencies</dt><dd>@(nodeDetail is null || nodeDetail.Dependencies.Count == 0 ? "None recorded" : string.Join(", ", nodeDetail.Dependencies))</dd></div>
                                                <div><dt>Attempt</dt><dd>@(nodeDetail?.Attempt.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable")</dd></div>
                                                <div><dt>Started</dt><dd>@FormatNodeStarted(nodeDetail)</dd></div>
                                                <div><dt>Completed</dt><dd>@(nodeDetail is null ? "Unavailable" : GalleryPage.FormatCaptureTime(nodeDetail.CompletedUtc))</dd></div>
                                                <div><dt>Failure category</dt><dd>@(nodeDetail?.FailureCategory ?? "None recorded")</dd></div>
                                                <div><dt>Execution profile SHA-256</dt><dd><code>@FormatNodeProfile(nodeDetail)</code></dd></div>
                                                <div><dt>Artifact IDs</dt><dd>@if (node.ArtifactIds.Count == 0) { <span>None recorded</span> } else { @foreach (var artifactId in node.ArtifactIds) { <code>@artifactId</code> } }</dd></div>
                                                <div><dt>Inputs and contexts</dt><dd>
                                                    @if (nodeDetail?.Inputs is null) { <span>Unavailable for legacy processing record.</span> }
                                                    else if (nodeDetail.Inputs.Count == 0) { <span>No recipe inputs submitted.</span> }
                                                    else { <ol>@foreach (var input in nodeDetail.Inputs) { <li>@InputEvidence(input)</li> }</ol> }
                                                    @if (nodeDetail?.InputsTruncated == true) { <span>Additional input evidence is retained but omitted from this bounded view.</span> }
                                                </dd></div>
                                            </dl>
                                        </details>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <div id="evidence-panel-@EvidenceTab.Technical" class="evidence-panel" role="tabpanel" aria-labelledby="evidence-tab-@EvidenceTab.Technical" hidden="@(_evidenceTab != EvidenceTab.Technical)">
                        <div class="technical-grid">
                            <article><h3>Capture record</h3><dl><div><dt>Capture ID</dt><dd><code>@_capture.CaptureId</code></dd></div><div><dt>Agent / rig</dt><dd>@_capture.AgentId / @(_capture.RigId ?? "Unspecified")</dd></div><div><dt>Sequence</dt><dd>@_capture.CaptureSequence</dd></div><div><dt>Manifest schema</dt><dd>@(_capture.Detail?.ManifestSchemaVersion ?? "Unavailable")</dd></div><div><dt>Processing profile SHA-256</dt><dd><code>@(_capture.Detail?.ProcessingProfile?.Sha256 ?? "Unavailable")</code></dd></div></dl></article>
                            <article><h3>Layout</h3>@if (_capture.Detail?.Layout is not { } layoutFacts) { <p>Unavailable</p> } else { <dl><div><dt>Dimensions</dt><dd>@layoutFacts.Width x @layoutFacts.Height</dd></div><div><dt>Pixel format</dt><dd>@layoutFacts.PixelFormat, @layoutFacts.ByteOrder</dd></div><div><dt>Sample / container</dt><dd>@layoutFacts.SampleDepthBits / @layoutFacts.ContainerDepthBits bits, @layoutFacts.Packing</dd></div><div><dt>Stride / length</dt><dd>@layoutFacts.StrideBytes bytes / @OperationsPage.FormatBytes(layoutFacts.ByteLength)</dd></div><div><dt>CFA / black / white</dt><dd>@layoutFacts.CfaPattern / @(layoutFacts.BlackLevel?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable") / @(layoutFacts.WhiteLevel?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable")</dd></div></dl> }</article>
                            <article><h3>Timing</h3>@if (_capture.Detail?.Timing is not { } timing) { <p>Unavailable</p> } else { <dl><div><dt>Requested start</dt><dd>@GalleryPage.FormatCaptureTime(timing.RequestedStartUtc)</dd></div><div><dt>Exposure</dt><dd>@GalleryPage.FormatCaptureTime(timing.ExposureStartedUtc) to @GalleryPage.FormatCaptureTime(timing.ExposureEndedUtc)</dd></div><div><dt>Readout complete</dt><dd>@GalleryPage.FormatCaptureTime(timing.ReadoutCompletedUtc)</dd></div><div><dt>Durable ingress</dt><dd>@GalleryPage.FormatCaptureTime(timing.DurableIngressUtc)</dd></div><div><dt>Setpoint applied</dt><dd>@(timing.SetpointAppliedUtc is null ? "Unavailable" : GalleryPage.FormatCaptureTime(timing.SetpointAppliedUtc.Value))</dd></div></dl> }</article>
                            <article><h3>Controls</h3>@if (_capture.Detail?.Controls is not { } controls) { <p>Unavailable</p> } else { <dl><div><dt>Exposure requested / effective</dt><dd>@controls.RequestedExposureMilliseconds / @controls.EffectiveExposureMilliseconds ms</dd></div><div><dt>Gain requested / effective</dt><dd>@controls.RequestedGain / @controls.EffectiveGain</dd></div><div><dt>Offset requested / effective</dt><dd>@(controls.RequestedOffset?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable") / @(controls.EffectiveOffset?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable")</dd></div><div><dt>Temperature setpoint / effective</dt><dd>@(controls.TemperatureSetpointC?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable") / @(controls.EffectiveTemperatureC?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable") C</dd></div></dl> }</article>
                            <article><h3>Cloud assessment</h3>@if (_capture.Detail is null) { <p>Cloud assessment is unavailable.</p> } else { var cloud = _capture.Detail.CloudAssessment; <dl><div><dt>Status / quality</dt><dd>@cloud.Availability / @(cloud.Status ?? "Unavailable") / @(cloud.Quality ?? "Unavailable")</dd></div><div><dt>Coverage / confidence</dt><dd>@FormatPercent(cloud.CoverageMillionths) / @FormatPercent(cloud.ConfidenceMillionths)</dd></div><div><dt>Reasons</dt><dd>@(cloud.ReasonCodes.Count == 0 ? "None recorded" : string.Join(", ", cloud.ReasonCodes.Select(OperationsPage.SplitWords)))</dd></div><div><dt>Mask</dt><dd>@(cloud.MaskPresent is null ? "Unavailable" : cloud.MaskPresent.Value ? "Present" : "Not present")@(cloud.MaskWidth is { } maskWidth && cloud.MaskHeight is { } maskHeight ? $", {maskWidth} x {maskHeight}" : string.Empty)</dd></div><div><dt>Mask SHA-256</dt><dd><code>@(cloud.MaskChecksumSha256 ?? "Unavailable")</code></dd></div></dl> }</article>
                        </div>
                    </div>

                    <div id="evidence-panel-@EvidenceTab.Replay" class="evidence-panel replay-entry" role="tabpanel" aria-labelledby="evidence-tab-@EvidenceTab.Replay" hidden="@(_evidenceTab != EvidenceTab.Replay)">
                        <p>Re-run this retained capture with a chosen pipeline revision. Replay never repeats acquisition, never replaces the current view, and never uploads or publishes automatically.</p>
                        <p class="replay-entry__action"><a class="btn btn-outline-light" href="@ReplayUrl">Replay this capture</a></p>
                    </div>
                </section>
            </Evidence>
        </CurrentSkyPage>
        <p class="back-action"><a class="btn btn-outline-light" href="@BackUrl">Back to gallery results</a></p>
    }
</div>
