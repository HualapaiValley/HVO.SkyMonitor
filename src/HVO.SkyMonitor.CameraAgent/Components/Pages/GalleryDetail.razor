@page "/gallery/{CaptureId:guid}"
@using HVO.SkyMonitor.AgentCore
@using HVO.SkyMonitor.CameraAgent.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Capture detail</PageTitle>

<div class="detail-page">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="@BackUrl">Gallery results</a><span>/</span><span aria-current="page">Capture detail</span></nav>
    @if (_isLoading)
    {
        <section class="detail-state" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><strong>Loading exact capture facts</strong></section>
    }
    else if (_errorMessage is not null || _capture is null)
    {
        <section class="detail-state detail-state--error" role="alert"><div><strong>Capture unavailable</strong><p>@(_errorMessage ?? "The requested capture was not found.")</p></div><a class="btn btn-outline-light" href="@BackUrl">Return to gallery results</a></section>
    }
    else
    {
        var preview = GalleryPage.PreferredPreview(_capture);
        <header class="detail-heading"><div><p class="eyebrow">Sequence @_capture.CaptureSequence / @EvidenceLabel(_capture.EvidenceOrigin)</p><h1><time datetime="@_capture.ExposureStartedUtc.ToString("O")">@GalleryPage.FormatCaptureTime(_capture.ExposureStartedUtc)</time></h1><p>Exact local capture, artifact, recipe, lineage, and processing-node facts.</p></div><span>@OperationsPage.SplitWords(_capture.RawState)</span></header>
        <section class="detail-hero">
                <figure>
                @if (preview is not null)
                {
                    <img src="@GalleryPage.PreviewUrl(preview.ArtifactId)" alt="Capture @_capture.CaptureSequence @OperationsPage.SplitWords(preview.Role.ToString())" />
                    <figcaption>@OperationsPage.SplitWords(preview.Role.ToString()) / direct same-host preview endpoint</figcaption>
                }
                else
                {
                    <div class="unsupported-preview"><i class="bi bi-image" aria-hidden="true"></i><strong>Preview unsupported</strong><span>No AnnotatedPreview or Preview artifact is available for display.</span></div>
                }
            </figure>
            <dl class="capture-facts"><div><dt>Capture ID</dt><dd><code>@_capture.CaptureId</code></dd></div><div><dt>Agent</dt><dd>@_capture.AgentId</dd></div><div><dt>Rig</dt><dd>@(_capture.RigId ?? "Unspecified")</dd></div><div><dt>Sequence</dt><dd>@_capture.CaptureSequence</dd></div><div><dt>Exposure started</dt><dd><time datetime="@_capture.ExposureStartedUtc.ToString("O")">@GalleryPage.FormatCaptureTime(_capture.ExposureStartedUtc)</time></dd></div><div><dt>Durable ingress</dt><dd><time datetime="@_capture.DurableIngressUtc.ToString("O")">@GalleryPage.FormatCaptureTime(_capture.DurableIngressUtc)</time></dd></div><div><dt>Raw state</dt><dd>@OperationsPage.SplitWords(_capture.RawState)</dd></div><div><dt>Evidence origin</dt><dd>@EvidenceLabel(_capture.EvidenceOrigin)</dd></div></dl>
        </section>

        <section class="fact-section evidence-section" aria-labelledby="evidence-heading">
            <header><p class="eyebrow">Reconstruction evidence</p><h2 id="evidence-heading">Manifest, layout, timing, and controls</h2></header>
            @if (_capture.Detail is null)
            {
                <p class="unavailable-state">Extended capture evidence is unavailable.</p>
            }
            else
            {
                <dl class="evidence-facts"><div><dt>Evidence availability</dt><dd>@_capture.Detail.EvidenceAvailability</dd></div><div><dt>Manifest schema</dt><dd>@(_capture.Detail.ManifestSchemaVersion ?? "Unavailable")</dd></div><div><dt>Raw retention hold</dt><dd>@(_capture.Detail.RawRetentionHold is null ? "Unavailable" : _capture.Detail.RawRetentionHold.Value ? "Held" : "Not held")</dd></div></dl>
                <div class="projection-grid">
                    <article><h3>Layout</h3>@if (_capture.Detail.Layout is null) { <p>Unavailable</p> } else { var layoutFacts = _capture.Detail.Layout; <dl><div><dt>Dimensions</dt><dd>@layoutFacts.Width x @layoutFacts.Height</dd></div><div><dt>Stride</dt><dd>@layoutFacts.StrideBytes bytes</dd></div><div><dt>Pixel format</dt><dd>@layoutFacts.PixelFormat</dd></div><div><dt>Byte order</dt><dd>@layoutFacts.ByteOrder</dd></div><div><dt>Sample / container</dt><dd>@layoutFacts.SampleDepthBits / @layoutFacts.ContainerDepthBits bits</dd></div><div><dt>Packing</dt><dd>@layoutFacts.Packing</dd></div><div><dt>CFA pattern</dt><dd>@layoutFacts.CfaPattern</dd></div><div><dt>Black / white</dt><dd>@(layoutFacts.BlackLevel?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable") / @(layoutFacts.WhiteLevel?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable")</dd></div><div><dt>Byte length</dt><dd>@OperationsPage.FormatBytes(layoutFacts.ByteLength)</dd></div></dl> }</article>
                    <article><h3>Timing</h3>@if (_capture.Detail.Timing is null) { <p>Unavailable</p> } else { var timing = _capture.Detail.Timing; <dl><div><dt>Requested start</dt><dd>@GalleryPage.FormatCaptureTime(timing.RequestedStartUtc)</dd></div><div><dt>Exposure start</dt><dd>@GalleryPage.FormatCaptureTime(timing.ExposureStartedUtc)</dd></div><div><dt>Exposure end</dt><dd>@GalleryPage.FormatCaptureTime(timing.ExposureEndedUtc)</dd></div><div><dt>Readout complete</dt><dd>@GalleryPage.FormatCaptureTime(timing.ReadoutCompletedUtc)</dd></div><div><dt>Durable ingress</dt><dd>@GalleryPage.FormatCaptureTime(timing.DurableIngressUtc)</dd></div><div><dt>Setpoint applied</dt><dd>@(timing.SetpointAppliedUtc is null ? "Unavailable" : GalleryPage.FormatCaptureTime(timing.SetpointAppliedUtc.Value))</dd></div></dl> }</article>
                    <article><h3>Controls</h3>@if (_capture.Detail.Controls is null) { <p>Unavailable</p> } else { var controls = _capture.Detail.Controls; <dl><div><dt>Exposure requested / effective</dt><dd>@controls.RequestedExposureMilliseconds / @controls.EffectiveExposureMilliseconds ms</dd></div><div><dt>Gain requested / effective</dt><dd>@controls.RequestedGain / @controls.EffectiveGain</dd></div><div><dt>Offset requested / effective</dt><dd>@(controls.RequestedOffset?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable") / @(controls.EffectiveOffset?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable")</dd></div><div><dt>Temperature setpoint / effective</dt><dd>@(controls.TemperatureSetpointC?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable") / @(controls.EffectiveTemperatureC?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable") C</dd></div></dl> }</article>
                </div>
            }
        </section>

        <section class="fact-section" aria-labelledby="artifacts-heading"><header><p class="eyebrow">Immutable evidence</p><h2 id="artifacts-heading">Artifacts</h2></header>
            @if (_capture.Artifacts.Count == 0) { <p>No artifacts are recorded for this capture.</p> }
            else
            {
                <div class="artifact-list">
                    @foreach (var artifact in _capture.Artifacts)
                    {
                        var artifactState = FindArtifactState(artifact.ArtifactId);
                        <article><header><div><p class="eyebrow">@OperationsPage.SplitWords(artifact.Role.ToString())</p><h3><code>@artifact.ArtifactId</code></h3></div><div class="artifact-links">@if (SupportsPreview(artifact)) { <a href="@GalleryPage.PreviewUrl(artifact.ArtifactId)" aria-label="Open @OperationsPage.SplitWords(artifact.Role.ToString()) image preview">Open preview</a> }<a href="@ContentUrl(artifact.ArtifactId)" download aria-label="Download @OperationsPage.SplitWords(artifact.Role.ToString()) artifact content">Download content</a></div></header>
                            <dl><div><dt>Media type</dt><dd>@(artifact.MediaType ?? "Unspecified")</dd></div><div><dt>Byte length</dt><dd>@OperationsPage.FormatBytes(artifact.ByteLength)</dd></div><div><dt>Created</dt><dd>@(artifact.CreatedUtc is null ? "Unspecified" : GalleryPage.FormatCaptureTime(artifact.CreatedUtc.Value))</dd></div><div><dt>Variant</dt><dd>@(artifact.Variant ?? "Unspecified")</dd></div><div><dt>Source ID</dt><dd>@(artifact.SourceId ?? "Unspecified")</dd></div><div><dt>Processing node</dt><dd>@(artifact.ProcessingNodeId ?? "Acquisition")</dd></div><div class="wide"><dt>SHA-256</dt><dd><code>@artifact.ChecksumSha256</code></dd></div></dl>
                            <dl class="delivery-facts"><div><dt>Retention</dt><dd>@(artifactState?.RetentionState ?? "Unavailable")</dd></div><div><dt>Delivery availability</dt><dd>@(artifactState?.DeliveryAvailability ?? "Unavailable")</dd></div><div class="wide"><dt>Delivery statuses</dt><dd>@(artifactState is null || artifactState.DeliveryStatuses.Count == 0 ? "Unavailable" : string.Join(", ", artifactState.DeliveryStatuses.Select(static delivery => $"{delivery.StorageAlias}: {delivery.Status}")))</dd></div></dl>
                            <section class="lineage" aria-label="Artifact lineage"><h4>Source artifact IDs</h4>@if (artifact.SourceArtifactIds.Count == 0) { <p>Origin artifact / no source artifacts.</p> } else { <ul>@foreach (var source in artifact.SourceArtifactIds) { <li><code>@source</code></li> }</ul> }</section>
                            @if (artifact.Recipe is not null)
                            {
                                <section class="recipe" aria-label="Recipe identity"><h4>Recipe</h4><dl><div><dt>Name</dt><dd>@artifact.Recipe.Name</dd></div><div><dt>Semantic version</dt><dd>@artifact.Recipe.SemanticVersion</dd></div><div><dt>Implementation</dt><dd>@artifact.Recipe.ImplementationVersion</dd></div><div><dt>Options SHA-256</dt><dd><code>@artifact.Recipe.OptionsSha256</code></dd></div><div class="wide"><dt>Identity SHA-256</dt><dd><code>@artifact.Recipe.IdentitySha256</code></dd></div></dl></section>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <section class="fact-section" aria-labelledby="nodes-heading"><header><p class="eyebrow">Capture-time graph</p><h2 id="nodes-heading">Processing nodes</h2></header>
            @if (_capture.ProcessingNodes.Count == 0) { <p>No processing nodes are recorded for this capture.</p> }
            else { <div class="node-grid">@foreach (var node in _capture.ProcessingNodes) { var nodeDetail = FindNodeDetail(node.NodeId); <article><header><h3>@node.NodeId</h3><span>@OperationsPage.SplitWords(node.Status)</span></header><dl><div><dt>Required</dt><dd>@(node.Required ? "Yes" : "No")</dd></div><div><dt>Recipe</dt><dd>@(node.RecipeName ?? "Unspecified")</dd></div><div><dt>Output role</dt><dd>@(node.OutputRole is null ? "None" : OperationsPage.SplitWords(node.OutputRole.Value.ToString()))</dd></div><div><dt>Output variant</dt><dd>@(node.OutputVariant ?? "Unspecified")</dd></div><div><dt>Dependencies</dt><dd>@(nodeDetail is null || nodeDetail.Dependencies.Count == 0 ? "None recorded" : string.Join(", ", nodeDetail.Dependencies))</dd></div><div><dt>Attempt</dt><dd>@(nodeDetail?.Attempt.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Unavailable")</dd></div><div><dt>Completed</dt><dd>@(nodeDetail is null ? "Unavailable" : GalleryPage.FormatCaptureTime(nodeDetail.CompletedUtc))</dd></div><div><dt>Failure category</dt><dd>@(nodeDetail?.FailureCategory ?? "None recorded")</dd></div></dl><h4>Artifact IDs</h4>@if (node.ArtifactIds.Count == 0) { <p>None recorded.</p> } else { <ul>@foreach (var artifactId in node.ArtifactIds) { <li><code>@artifactId</code></li> }</ul> }</article> }</div> }
        </section>

        <section class="fact-section" aria-labelledby="cloud-heading"><header><p class="eyebrow">Derived environmental evidence</p><h2 id="cloud-heading">Cloud assessment</h2></header>
            @if (_capture.Detail is null) { <p class="unavailable-state">Cloud assessment is unavailable.</p> }
            else { var cloud = _capture.Detail.CloudAssessment; <dl class="cloud-facts"><div><dt>Availability</dt><dd>@cloud.Availability</dd></div><div><dt>Status</dt><dd>@(cloud.Status ?? "Unavailable")</dd></div><div><dt>Quality</dt><dd>@(cloud.Quality ?? "Unavailable")</dd></div><div><dt>Coverage</dt><dd>@FormatPercent(cloud.CoverageMillionths)</dd></div><div><dt>Confidence</dt><dd>@FormatPercent(cloud.ConfidenceMillionths)</dd></div><div><dt>Reasons</dt><dd>@(cloud.ReasonCodes.Count == 0 ? "None recorded" : string.Join(", ", cloud.ReasonCodes.Select(OperationsPage.SplitWords)))</dd></div><div><dt>Mask presence</dt><dd>@(cloud.MaskPresent is null ? "Unavailable" : cloud.MaskPresent.Value ? "Present" : "Not present")</dd></div><div><dt>Mask dimensions</dt><dd>@(cloud.MaskWidth is null || cloud.MaskHeight is null ? "Unavailable" : $"{cloud.MaskWidth} x {cloud.MaskHeight}")</dd></div><div class="wide"><dt>Mask SHA-256</dt><dd><code>@(cloud.MaskChecksumSha256 ?? "Unavailable")</code></dd></div></dl> }
        </section>
        <p class="back-action"><a class="btn btn-outline-light" href="@BackUrl">Back to gallery results</a></p>
    }
</div>
