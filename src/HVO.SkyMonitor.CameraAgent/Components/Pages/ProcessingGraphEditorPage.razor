@page "/operations/pipeline/graphs/new"
@layout OperationsLayout
@using HVO.SkyMonitor.AgentCore
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Common.Capture.Processing
@using HVO.SkyMonitor.CameraAgent.Services
@using HVO.SkyMonitor.Processing
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Draft graph</PageTitle>

<div class="editor-page">
    <PageHeader Eyebrow="New immutable draft" Title="Draft graph" Lead="Compose a processing graph as an ordered node list. Preview compiles it against this CameraAgent without writing anything; saving creates an immutable draft revision that is validated and activated from the Named graphs list. Nothing here touches the live capture path.">
        <a class="btn btn-outline-light" href="/operations/pipeline/graphs">Back to named graphs</a>
    </PageHeader>

    @if (_loading)
    {
        <PageStateNotice Kind="PageStateNotice.PageStateKind.Loading" Title="Preparing the draft" Message="@(_from is null ? "Starting an empty draft." : "Loading the source revision's definition.")" />
    }
    else
    {
        @if (_message is not null)
        {
            <section class="editor-banner @(_messageIsError ? "editor-banner--error" : null)" role="@(_messageIsError ? "alert" : "status")">@_message @if (_savedRevisionId is not null) { <a href="/operations/pipeline/graphs/@Uri.EscapeDataString(_savedRevisionId)">Open the saved draft</a> }</section>
        }
        @if (_model.SourceRevisionId is not null)
        {
            <p class="editor-note" role="note">Started from revision <code>@_model.SourceRevisionId</code>. Only edited options change; unknown options and step aliases are preserved. Saving creates a new revision.</p>
        }

        <form class="editor-form" aria-labelledby="editor-form-heading" @onsubmit="PreviewAsync" @onsubmit:preventDefault>
            <header class="editor-form-header">
                <h2 id="editor-form-heading">Graph definition</h2>
            </header>
            <fieldset class="editor-group" disabled="@_busy">
                <legend>Identity</legend>
                <div class="field-grid">
                    <label>Graph name<input class="form-control" @bind="_model.Name" @bind:after="FormChanged" /></label>
                    <label>Revision label<input class="form-control" @bind="_model.Revision" @bind:after="FormChanged" /></label>
                </div>
                <dl class="identity-facts">
                    <div><dt>Pipeline schema</dt><dd>@_model.SchemaVersion</dd></div>
                    <div><dt>Dependency policy</dt><dd>@_model.DependencyPolicy</dd></div>
                </dl>
                <p class="editor-note">Schema and dependency policy are carried from the source revision and are not editable here.</p>
            </fieldset>

            <fieldset class="editor-group" disabled="@_busy">
                <legend>Nodes in execution order</legend>
                <p class="editor-note">Each node names the raw capture or nodes above it as inputs. Reorder with the move buttons; nothing depends on drag, pointer precision, or colour.</p>
                @if (_model.Nodes.Count == 0)
                {
                    <p class="editor-note">No nodes yet. Add the first node below.</p>
                }
                <ol class="node-rows">
                    @foreach (var node in _model.Nodes)
                    {
                        var index = _model.Nodes.IndexOf(node);
                        <li class="node-row" id="@RowId(node)" tabindex="-1" @key="node">
                            <div class="node-row__head">
                                <label>Identifier<input class="form-control" aria-label="Node identifier" @bind="node.Id" @bind:after="FormChanged" /></label>
                                <label>Type<select class="form-select" aria-label="Node type" @bind="node.Type" @bind:after="FormChanged">@if (!GraphService.StepAliases.Contains(node.Type, StringComparer.Ordinal)) { <option value="@node.Type">@node.Type</option> }@foreach (var alias in GraphService.StepAliases) { <option value="@alias">@alias</option> }</select></label>
                                <label class="check"><input type="checkbox" @bind="node.Required" @bind:after="FormChanged" /> Required</label>
                                <label class="check"><input type="checkbox" @bind="node.Enabled" @bind:after="FormChanged" /> Enabled</label>
                                <span class="node-row__actions">
                                    <button type="button" class="btn btn-sm btn-outline-light" aria-label="Move @node.Id up" disabled="@(index == 0)" @onclick="() => Move(node, -1)">Move up</button>
                                    <button type="button" class="btn btn-sm btn-outline-light" aria-label="Move @node.Id down" disabled="@(index == _model.Nodes.Count - 1)" @onclick="() => Move(node, 1)">Move down</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Remove @node.Id" @onclick="() => Remove(node)">Remove</button>
                                </span>
                            </div>
                            <fieldset class="node-row__dependencies">
                                <legend>Inputs of @node.Id</legend>
                                @{ var eligible = _model.EligibleDependencies(node); }
                                @foreach (var candidate in _model.RenderableDependencies(node))
                                {
                                    var selected = node.DependsOn.Contains(candidate);
                                    var stale = selected && !eligible.Contains(candidate, StringComparer.Ordinal);
                                    <label class="@(stale ? "check check--stale" : "check")"><input type="checkbox" checked="@selected" @onchange="args => ToggleDependency(node, candidate, args.Value is true)" /> @(candidate == ProcessingGraphDraftModel.RawInput ? "raw capture" : candidate)@(stale ? " (no longer above this node; clear it)" : "")</label>
                                }
                            </fieldset>
                            @if (node.OptionsForm is { } optionsForm)
                            {
                                <section class="node-options-section" id="@OptionsSection(node)" aria-label="@optionsForm.Descriptor.Title">
                                    <h3 id="@SceneOptionsAnchor(node)">@optionsForm.Descriptor.Title</h3>
                                    @if (optionsForm.Descriptor.StepAlias == FrameFactsPresentation.StepAlias)
                                    {
                                        <FrameFactsOptionsEditor @key="optionsForm" IdPrefix="@($"node-options-{index}")" Form="optionsForm" Changed="FormChanged" />
                                    }
                                    else
                                    {
                                        <ProcessingNodeOptionsEditor IdPrefix="@($"node-options-{index}")" Form="optionsForm" Changed="FormChanged"
                                            NodeEnabled="@(_model.SchemaVersion == CapturePipelineSchemaVersions.ExplicitV2 ? node.Enabled : null)"
                                            NodeEnabledChanged="value => node.Enabled = value" />
                                    }
                                </section>
                            }
                            else if (node.HasOptions) { <p class="editor-note">Carries opaque options from the source revision. This step has no supported option editor; no version upgrade is applied.</p> }
                        </li>
                    }
                </ol>
                <div class="add-node">
                    <label>Add node of type<select class="form-select" aria-label="New node type" @bind="_newType">@foreach (var alias in GraphService.StepAliases) { <option value="@alias">@alias</option> }</select></label>
                    <button type="button" class="btn btn-outline-light" disabled="@(string.IsNullOrWhiteSpace(_newType))" @onclick="AddNode">Add node</button>
                </div>
            </fieldset>

            @if (_model.Nodes.Any(node => FrameFactsDraftConversion.IsLegacy(node.Type)))
            {
                <section id="@(_model.Nodes.Any(node => node.OptionsForm?.Descriptor.StepAlias == FrameFactsPresentation.StepAlias) ? "frame-facts-conversion" : "frame-facts")" class="editor-group" aria-label="Frame Facts conversion">
                    <h2>Frame Facts corner presets</h2>
                    <p>The legacy presets remain in this draft. Converting selects the rich version for every legacy preset node and opts manifest/materializer consumers in together. Token templates, pinned fonts and dark panels replace automatic legacy typography. Existing variants, dependencies and unknown options are retained.</p>
                    <button type="button" class="btn btn-outline-light" disabled="@_busy" @ref="_conversionTrigger" @onclick="ReviewConversionAsync">Review whole-draft Frame Facts conversion</button>
                </section>
            }
            @if (_conversion is not null)
            {
                <section class="conversion-review" tabindex="-1" @ref="_conversionReview" aria-label="Review whole-draft conversion">
                    <h2>Before and after</h2>
                    <p>This is a preview of the entire draft. Confirming changes only this form. Saving, validation and activation remain separate. Retained revisions and products keep their former output.</p>
                    <div class="conversion-columns">
                        <div><h3>Before: legacy presets</h3><pre>@_conversionBefore</pre></div>
                        <div><h3>After: opt-in rich templates</h3><pre>@System.Text.Json.JsonSerializer.Serialize(_conversion, DisplayJson)</pre></div>
                    </div>
                    <button type="button" class="btn btn-primary" @onclick="AcceptConversion">Apply conversion to draft</button>
                    <button type="button" class="btn btn-outline-light" @onclick="CancelConversionAsync">Cancel conversion</button>
                </section>
            }

            <div class="editor-actions">
                <button type="submit" class="btn btn-outline-light" disabled="@_busy">Preview plan</button>
                <button type="button" class="btn btn-primary" disabled="@(_busy || _plan is null || !_graphChanged || _savedRevisionId is not null)" @onclick="SaveDraftAsync">Save immutable draft</button>
                @if (_plan is null) { <span class="editor-note">Preview the plan before saving.</span> }
            </div>
        </form>
        @if (Section is "scene-overlay" or "constellations" && !_model.Nodes.Any(static node => node.OptionsForm?.Descriptor.StepAlias == "ScenePresentationLayer"))
        {
            <p role="status">This graph has no supported scene overlay node. Add ScenePresentationLayer with its ProjectedScene input to configure visibility, sizes and constellation style.</p>
        }

        @if (Section == "legacy-annotation" && !_model.Nodes.Any(static node => node.OptionsForm?.Descriptor.StepAlias == "Annotation"))
        {
            <p role="status">This graph has no supported legacy Annotation node. Select a retained graph with Annotation to edit its existing styling. Missing or unsupported nodes are not replaced or upgraded; saving, validation and activation remain separate.</p>
        }
        @if (Section == "projected-scene" && !_model.Nodes.Any(static node => node.OptionsForm?.Descriptor.StepAlias == "ProjectedScene"))
        {
            <p role="status">This graph has no supported projected scene node. Add ProjectedScene with an explicit raw dependency to configure physical predicted-scene queries. VirtualSky keeps its separate module settings and authoritative rendered scene; saving, validation and activation remain separate.</p>
        }
        @if (Section == "calibration" && !_model.Nodes.Any(static node => node.OptionsForm?.Descriptor.StepAlias == "Calibration"))
        {
            <p role="note">This graph has no calibration node. Add Calibration with an explicit raw dependency to configure it. Existing models and master provisioning stay unchanged; saving, validation and activation remain separate.</p>
        }
        @if (Section == "cloud-assessment" && !_model.Nodes.Any(static node => node.OptionsForm?.Descriptor.StepAlias == "CloudAssessment"))
        {
            <p role="note">This graph has no cloud assessment node. Add CloudAssessment with an explicit raw or calibrated image dependency to configure it. Clear-reference provisioning stays unchanged; saving, validation and activation remain separate.</p>
        }
        @if (Section == "weather-cloud-overlay" && !_model.Nodes.Any(static node => node.OptionsForm?.Descriptor.StepAlias == "WeatherCloudOverlay"))
        {
            <p role="note">This graph has no weather and cloud overlay node. Add WeatherCloudOverlay with an explicit preview and CloudAssessment dependency to configure it; saving and activation remain separate.</p>
        }
        @if (Section == "frame-facts" && !_model.Nodes.Any(static node => FrameFactsDraftConversion.IsLegacy(node.Type) || node.OptionsForm?.Descriptor.StepAlias == FrameFactsPresentation.StepAlias))
        {
            <p role="status">This graph has no Frame Facts node. Add FrameFactsPresentationLayerV1 with its ProjectedScene and combined-preview inputs, and explicitly opt manifest/materializer consumers in before previewing the plan.</p>
        }

        @if (_plan is not null)
        {
            <section class="editor-preview" aria-labelledby="editor-preview-heading">
                <h2 id="editor-preview-heading">Compiled preview</h2>
                <p class="editor-note">The diagram is a projection of the compiled plan; the list above is the editable source of truth and the diagram's text alternative.</p>
                <GraphDependencyDiagram Nodes="_plan.DesiredNodes" NodeSelected="FocusRowAsync" />
                <GraphPlanView Plan="_plan" />
            </section>
        }
    }
</div>
