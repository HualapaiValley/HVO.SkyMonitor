@page "/environmental"
@page "/operations/environment"
@layout OperationsLayout
@using System.Globalization
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Components.Operations
@using HVO.SkyMonitor.CameraAgent.Common.Environmental
@using HVO.SkyMonitor.Processing
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Environment</PageTitle>

<OperationsPageHeading Eyebrow="Processing / independent observations" Title="Environment" HeadingId="environment-heading"
                       Description="Track weather and camera conditions independently from image processing, with explicit freshness and capture associations.">
    <Actions>
        <button type="button" id="environment-refresh" class="icon-button" aria-label="Refresh" title="Refresh" disabled="@(_loading || _submitting)" @onclick="LoadAsync">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15.5 7A6 6 0 1 0 16 11"></path><path d="M16 3.5V7h-3.5"></path></svg>
        </button>
        <button type="button" id="@AcquireTriggerId" class="button primary" title="@AcquireUnavailableReason"
                aria-describedby="@(AcquireUnavailableReason is null ? null : "environment-acquire-reason")"
                disabled="@(_submitting || AcquireUnavailableReason is not null)" @onclick="OpenAcquireDialog">Acquire now</button>
        @if (AcquireUnavailableReason is not null)
        {
            <span id="environment-acquire-reason" class="visually-hidden">@AcquireUnavailableReason</span>
        }
    </Actions>
</OperationsPageHeading>

@if (_loading && _status is null)
{
    <div class="ops-note-banner" role="status"><span class="status-icon running" aria-hidden="true"></span><span>Loading environmental observations.</span></div>
}
else if (_status is null)
{
    <div class="ops-note-banner" role="alert"><span class="status-icon failure" aria-hidden="true"></span><span><strong>Environmental status unavailable.</strong> @_error</span></div>
}
else
{
    @if (!_status.Enabled)
    {
        <div class="ops-note-banner environment-disabled" role="status"><span class="status-icon warning" aria-hidden="true"></span><span><strong>Environmental acquisition is disabled.</strong> This agent's configuration takes no scheduled or on-demand observations. Retained history below stays readable.</span></div>
    }
    @if (_error is not null)
    {
        <div class="ops-note-banner" role="alert"><span class="status-icon failure" aria-hidden="true"></span><span>@_error</span></div>
    }
    @if (_commandMessage is not null && !_dialogOpen)
    {
        <section class="ops-panel command-result @(_commandMessageIsError ? "error" : "success")" role="@(_commandMessageIsError ? "alert" : "status")" aria-live="@(_commandMessageIsError ? "assertive" : "polite")">
            <header class="ops-panel-heading">
                <div><h2><span class="status-icon @(_commandMessageIsError ? "failure" : "success")" aria-hidden="true"></span> @_commandMessage</h2></div>
                <button type="button" class="icon-button" aria-label="Dismiss" @onclick="DismissResult">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"></path></svg>
                </button>
            </header>
            @if (_commandResult is not null)
            {
                var receipt = _commandResult.Receipt;
                <dl class="ops-facts">
                    <div><dt>Source</dt><dd>@receipt.SourceId</dd></div>
                    <div><dt>Outcome</dt><dd>@OperationsPage.SplitWords(receipt.Disposition.ToString())</dd></div>
                    <div><dt>Disposition reason</dt><dd>@receipt.Reason</dd></div>
                    <div><dt>Observation</dt><dd>@(receipt.ObservationId?.ToString() ?? "No observation committed")</dd></div>
                    <div><dt>Started</dt><dd>@FormatUtc(receipt.StartedUtc)</dd></div>
                    <div><dt>Completed</dt><dd>@FormatUtc(receipt.CompletedUtc)</dd></div>
                </dl>
            }
            @if (_commandRefreshWarning is not null)
            {
                <p class="refresh-warning">@_commandRefreshWarning</p>
            }
        </section>
    }

    <div class="ops-reading-grid" aria-label="Latest readings" role="list">
        @foreach (var slot in ReadingSlots)
        {
            var reading = Reading(slot);
            <article class="ops-reading @(reading.Observation is null ? "empty" : null)" role="listitem" data-slot="@slot.Key">
                <span>@slot.Label</span>
                <strong>@reading.Value</strong>
                <small>@reading.State</small>
                @if (reading.Detail is not null)
                {
                    <small>@reading.Detail</small>
                }
            </article>
        }
    </div>
    @if (_latestError is not null)
    {
        <p class="environment-inline-warning" role="status">@_latestError</p>
    }

    <div class="ops-grid two">
        <section class="ops-panel" aria-labelledby="environment-sources-heading">
            <header class="ops-panel-heading">
                <div><h2 id="environment-sources-heading">Source schedule</h2><p>Environmental observations remain targetless durable history.</p></div>
                <span>@NextPollText</span>
            </header>
            @if (_status.Sources.Count == 0)
            {
                <p class="environment-empty">No environmental sources are configured.</p>
            }
            else
            {
                <div class="ops-table-wrap">
                    <table class="ops-table environment-source-table">
                        <thead><tr><th scope="col">Source</th><th scope="col">Trigger</th><th scope="col">Age</th><th scope="col">State</th></tr></thead>
                        <tbody>
                            @foreach (var source in _status.Sources)
                            {
                                <tr data-source="@source.Id">
                                    <td><strong>@source.Id</strong><small>@OperationsPage.SplitWords(source.Kind.ToString()) / @(source.Required ? "Required" : "Optional")</small></td>
                                    <td>@TriggerText(source)</td>
                                    <td>@FormatAge(source.LastObservationAgeSeconds)</td>
                                    <td>
                                        <span class="state-chip @FreshnessTone(source.Freshness)">@source.Freshness</span>
                                        @if (source.LastDisposition is { } disposition && disposition != EnvironmentalAcquisitionDisposition.Produced)
                                        {
                                            <small class="@(source.ConsecutiveFailures > 0 ? "failure" : null)">@OperationsPage.SplitWords(disposition.ToString())@(source.ConsecutiveFailures > 0 ? FormattableString.Invariant($" / {source.ConsecutiveFailures} in a row") : string.Empty)</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        <section class="ops-panel" aria-labelledby="environment-delivery-heading">
            <header class="ops-panel-heading">
                <div><h2 id="environment-delivery-heading">Delivery policy</h2><p>Environment delivery is independent from artifact delivery.</p></div>
                <span>@(_status.Delivery.ExportEnabled ? OperationsPage.SplitWords(_status.Delivery.Availability) : "Local only")</span>
            </header>
            <dl class="ops-facts environment-delivery">
                <div><dt>LogicHost export</dt><dd>@(_status.Delivery.ExportEnabled ? "Enabled" : "Disabled")</dd></div>
                <div><dt>Pending</dt><dd>@(_status.Delivery.ExportEnabled ? PendingText(_status.Delivery) : "Not exported")</dd></div>
                <div><dt>Stored locally</dt><dd>@_status.StoredCount.ToString("N0", CultureInfo.InvariantCulture) / @OperationsPage.FormatBytes(_status.StoredBytes)</dd></div>
                <div><dt>Retention</dt><dd>@_status.RetentionDays days</dd></div>
                <div><dt>Capacity rejections</dt><dd>@_status.OverflowCount.ToString("N0", CultureInfo.InvariantCulture)</dd></div>
                <div><dt>Oldest pending</dt><dd>@OldestPendingText(_status.Delivery)</dd></div>
                <div class="full"><dt>Last acknowledgment</dt><dd>@(_status.Delivery.LastAcknowledgedUtc is { } acknowledged ? FormatUtc(acknowledged) : _status.Delivery.ExportEnabled ? "Not yet acknowledged" : "Export disabled")</dd></div>
            </dl>
        </section>
    </div>

    <section class="ops-panel environment-history" aria-labelledby="environment-history-heading">
        <header class="ops-panel-heading">
            <div><h2 id="environment-history-heading">Observation history</h2><p>Every committed observation, newest first. Values are shown exactly as recorded.</p></div>
            <label class="ops-field environment-kind-filter" for="environment-history-kind">Kind
                <select id="environment-history-kind" value="@(_historyKind?.ToString() ?? string.Empty)" disabled="@_submitting" @onchange="HistoryKindChanged">
                    <option value="">All kinds</option>
                    @foreach (var kind in Enum.GetValues<EnvironmentalObservationKind>())
                    {
                        <option value="@kind">@OperationsPage.SplitWords(kind.ToString())</option>
                    }
                </select>
            </label>
        </header>
        @if (_history is null || _history.Items.Count == 0)
        {
            <p class="environment-empty">@(_historyKind is null ? "No local observations have been committed." : "No local observations of this kind have been committed.")</p>
        }
        else
        {
            <div class="ops-table-wrap">
                <table class="ops-table environment-history-table">
                    <thead><tr><th scope="col">Observed (UTC)</th><th scope="col">Kind</th><th scope="col">Value</th><th scope="col">Source</th><th scope="col">Quality</th></tr></thead>
                    <tbody>
                        @foreach (var item in _history.Items)
                        {
                            <tr>
                                <td><time datetime="@item.ObservedAtUtc.ToString("O", CultureInfo.InvariantCulture)">@FormatUtc(item.ObservedAtUtc)</time></td>
                                <td>@OperationsPage.SplitWords(item.Kind.ToString())</td>
                                <td><strong>@FormatReading(item)</strong>@if (item.Unit == EnvironmentalObservationUnit.MagnitudesPerSquareArcsecond)
                                {<small>@SkyBrightnessUnit</small>}</td>
                                <td>@item.SourceId<small>@OperationsPage.SplitWords(item.SourceKind.ToString())</small></td>
                                <td>@item.Quality</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="environment-paging">
            <button type="button" class="button secondary small" disabled="@(_submitting || _historyCursor is null)" @onclick="NewestAsync">Newest</button>
            <button type="button" class="button secondary small" disabled="@(_submitting || _history?.NextCursor is null)" @onclick="OlderAsync">Older observations</button>
        </div>
    </section>

    <section class="ops-panel environment-attempts" aria-labelledby="environment-attempts-heading">
        <header class="ops-panel-heading">
            <div><h2 id="environment-attempts-heading">Recent attempts</h2><p>Durable acquisition receipts, including attempts that produced no observation.</p></div>
        </header>
        @if (_status.Attempts.Count == 0)
        {
            <p class="environment-empty">No acquisition attempts have been recorded.</p>
        }
        else
        {
            <div class="ops-table-wrap">
                <table class="ops-table environment-attempt-table">
                    <thead><tr><th scope="col">Completed (UTC)</th><th scope="col">Source</th><th scope="col">Trigger</th><th scope="col">Outcome</th></tr></thead>
                    <tbody>
                        @foreach (var attempt in _status.Attempts)
                        {
                            <tr>
                                <td><time datetime="@attempt.CompletedUtc.ToString("O", CultureInfo.InvariantCulture)">@FormatUtc(attempt.CompletedUtc)</time></td>
                                <td>@attempt.SourceId
                                    @if (attempt.CaptureId is { } captureId)
                                    {
                                        <small><a href="@($"/gallery/{captureId:D}")">@(attempt.CaptureSequence is { } sequence ? FormattableString.Invariant($"Capture {sequence}") : "Capture")</a></small>
                                    }
                                </td>
                                <td>@OperationsPage.SplitWords(attempt.Trigger.ToString())</td>
                                <td><span class="state-chip @DispositionTone(attempt.Disposition)">@OperationsPage.SplitWords(attempt.Disposition.ToString())</span><small>@attempt.Reason</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (_dialogOpen)
    {
        <dialog class="action-dialog operations-dialog environment-dialog" aria-labelledby="environment-acquire-heading" aria-describedby="environment-acquire-description" @ref="_dialogElement" @oncancel="CancelDialog">
            <form @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                <div class="dialog-header">
                    <div><p class="eyebrow">Operator command</p><h2 id="environment-acquire-heading">Acquire an observation now</h2></div>
                    <button type="button" class="icon-button" aria-label="Close dialog" disabled="@_submitting" @onclick="CancelDialog">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"></path></svg>
                    </button>
                </div>
                <p id="environment-acquire-description" class="dialog-intro">Runs one configured on-demand source once. The attempt is kept as a durable receipt whether or not it produces an observation, and scheduled polling is unaffected.</p>
                @if (_pinnedRetry)
                {
                    <div class="dialog-note"><strong>Retry the same request.</strong><span>The first attempt's result is unknown, so the source and reason are locked. Retrying sends the identical request with the same durable key, so the source is never run twice for it.</span></div>
                }
                <fieldset disabled="@(_submitting || _pinnedRetry)">
                    <legend class="visually-hidden">Acquisition request</legend>
                    <label class="ops-field" for="environment-source">Source
                        <select id="environment-source" @bind="_selectedSourceId">
                            @foreach (var source in _status.Sources.Where(static source => source.SupportsOnDemand))
                            {
                                <option value="@source.Id">@source.Id (@OperationsPage.SplitWords(source.Kind.ToString()))</option>
                            }
                        </select>
                    </label>
                    <label class="ops-field" for="environment-reason">Reason
                        <input id="environment-reason" maxlength="128" required placeholder="Why this observation is needed" @bind="_reason" />
                    </label>
                </fieldset>
                @if (_commandMessage is not null)
                {
                    <div class="environment-dialog-message"><div class="ops-note-banner compact command-result @(_commandMessageIsError ? "error" : "pending")" role="@(_commandMessageIsError ? "alert" : "status")"><span class="status-icon @(_commandMessageIsError ? "failure" : "running")" aria-hidden="true"></span><span>@_commandMessage</span></div></div>
                }
                <footer>
                    <button type="button" class="button secondary" disabled="@_submitting" @onclick="CancelDialog">Cancel</button>
                    <button type="submit" id="environment-acquire-confirm" class="button primary" disabled="@_submitting">@(_submitting ? "Requesting observation..." : _pinnedRetry ? "Retry request" : "Request observation")</button>
                </footer>
            </form>
        </dialog>
    }
}
