@page "/operations/unavailable/{Section}"
@layout OperationsLayout
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Components.Operations
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]

<PageTitle>@(Entry?.Label ?? "Unavailable section") | Operations</PageTitle>

<section class="unavailable-section" aria-labelledby="unavailable-heading">
    @if (Entry is null)
    {
        <OperationsPageHeading Eyebrow="Operations" Title="Section unavailable" HeadingId="unavailable-heading"
                               Description="This Operations section does not exist." />
    }
    else
    {
        <OperationsPageHeading Eyebrow="@Entry.Eyebrow" Title="@Entry.Label" HeadingId="unavailable-heading" Description="@Entry.Description" />
        <div class="ops-note-banner" role="status">
            <span class="status-icon pending" aria-hidden="true"></span>
            <p><strong>Not implemented on this CameraAgent.</strong> @Entry.UnavailableReason This page has no controls until the section's local capability exists.</p>
        </div>
    }
    <a class="button secondary" href="/operations">Back to Operations overview</a>
</section>
