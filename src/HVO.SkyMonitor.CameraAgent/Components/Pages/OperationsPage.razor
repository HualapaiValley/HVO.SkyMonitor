@page "/operations"
@layout OperationsLayout
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Components.Operations
@using HVO.SkyMonitor.CameraAgent.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Operations</PageTitle>

<OperationsPageHeading Eyebrow="@HeadingEyebrow" Title="Operations" HeadingId="operations-heading"
                       Description="Configure and operate this camera without making local acquisition dependent on LogicHost.">
    <Actions>
        <a class="button secondary" href="/">View current sky</a>
        @if (CanPause)
        {
            <button id="capture-action" type="button" class="button secondary" disabled="@_isSubmitting" @onclick="BeginPause">Pause capture</button>
        }
        else if (CanResume)
        {
            <button id="capture-action" type="button" class="button primary" disabled="@_isSubmitting" @onclick="BeginResume">Resume capture</button>
        }
    </Actions>
</OperationsPageHeading>

@if (_isInitialLoading && _view is null)
{
    <section class="ops-state-deck pending" aria-label="Current operating state" aria-busy="true">
        <div class="ops-state-primary"><span class="ops-state-orbit" aria-hidden="true"><i></i></span><span><strong>Loading current operations</strong><span>Reading durable and runtime sources.</span></span></div>
    </section>
}
else if (_view is null && !_unauthorized)
{
    <div class="ops-note-banner operations-failure" role="alert">
        <span class="status-icon failure" aria-hidden="true"></span>
        <span><strong>Operations unavailable.</strong> @(_errorMessage ?? "Current operations data is unavailable.")</span>
        <button type="button" class="button secondary small" @onclick="RefreshNowAsync">Try again</button>
    </div>
}
else if (_view is not null)
{
    var summary = _view.Summary;
    var telemetry = summary.CaptureTelemetry.Value;
    var attention = OperationsAttention.From(_view, _errorMessage is not null);
    var changes = RecentChanges;

    @if (_errorMessage is not null)
    {
        <div class="ops-note-banner" role="alert">
            <span class="status-icon warning" aria-hidden="true"></span>
            <span><strong>Showing last valid data.</strong> @_errorMessage Automatic refresh will retry.</span>
        </div>
    }

    <section class="ops-state-deck @DeckClass" aria-label="Current operating state">
        <div class="ops-state-primary"><span class="ops-state-orbit" aria-hidden="true"><i></i></span><span><strong>@CaptureHeadline</strong><span>@CaptureDetail</span></span></div>
        <dl class="ops-state-facts">
            <div><dt>Next capture</dt><dd>Not reported</dd></div>
            <div><dt>Admission</dt><dd>@AdmissionText</dd></div>
            <div><dt>Active profile</dt><dd>@ActiveProfileText</dd></div>
            <div><dt>LogicHost</dt><dd>@(IsCentralIntegrationDisabled ? "Disabled" : SplitWords(summary.Heartbeat.Value.Availability))</dd></div>
        </dl>
        @if (_latestRun is not null)
        {
            <a class="button primary" href="@($"/operations/pipeline/executions/{_latestRun.ExecutionId}")">Latest run</a>
        }
        else
        {
            <a class="button primary" href="/operations/pipeline/executions">Processing runs</a>
        }
    </section>

    <div class="ops-grid sidebar-right">
        <section class="ops-panel" aria-labelledby="attention-heading">
            <header class="ops-panel-heading"><div><h2 id="attention-heading">Needs attention</h2><p>Items that do not stop local acquisition but should be reviewed.</p></div><span>@attention.Items.Count open</span></header>
            @if (attention.Items.Count == 0)
            {
                <p class="ops-panel-empty"><span class="status-icon success" aria-hidden="true"></span>No open items in the latest reading.</p>
            }
            else
            {
                <div class="ops-attention-list">
                    @foreach (var item in attention.Items)
                    {
                        <article class="ops-attention-item @item.Tone"><span class="status-icon @item.Icon" aria-hidden="true"></span><span><strong>@item.Title</strong><small>@item.Detail</small></span><a href="@item.Href">@item.LinkText</a></article>
                    }
                </div>
            }
        </section>

        <section class="ops-panel" aria-labelledby="configuration-heading">
            <header class="ops-panel-heading"><div><h2 id="configuration-heading">Active configuration</h2><p>Every capture binds these exact revisions.</p></div><span>@(_configurationReadUtc is { } read ? $"Read {FormatClock(read)} UTC" : "Not read")</span></header>
            <div class="ops-configuration-grid">
                <a class="ops-config-card" href="/operations/camera"><span>Camera &amp; rig</span><strong>@RigTitle</strong><small>@RigDetail</small></a>
                <a class="ops-config-card" href="/operations/schedule"><span>Schedule</span><strong>@(_schedule is null ? "Schedule unavailable" : $"Schedule r{_schedule.ActiveRevision.RevisionNumber}")</strong><small>@ScheduleDetail</small></a>
                <a class="ops-config-card" href="/operations/pipeline"><span>Pipeline</span><strong>@(_pipeline is null ? "Pipeline unavailable" : $"Pipeline r{_pipeline.Active.RevisionNumber}")</strong><small>@PipelineDetail</small></a>
                <a class="ops-config-card" href="/operations/calibration"><span>Calibration</span><strong>@CalibrationTitle</strong><small>@CalibrationDetail</small></a>
            </div>
        </section>
    </div>

    <section class="ops-panel ops-grid" aria-labelledby="lane-heading">
        <header class="ops-panel-heading"><div><h2 id="lane-heading">Durable work lanes</h2><p>Image freshness and system safety remain separate signals.</p></div><a href="/operations/system">Full diagnostics</a></header>
        <div class="ops-lane-list">
            <div class="ops-lane"><span><strong>Raw ingress</strong><small>Immutable evidence</small></span><small class="ops-lane-note">@BacklogText(summary.RawIngress.Value)</small><span>@CountText(summary.RawIngress.Value.PendingCount, "pending")</span></div>
            <div class="ops-lane"><span><strong>Frame processing</strong><small>Current graph</small></span><small class="ops-lane-note">@BacklogText(summary.CaptureProcessing.Value)</small><span>@ProcessingLaneText</span></div>
            <div class="ops-lane"><span><strong>Central delivery</strong><small>Durable outbox</small></span><small class="ops-lane-note">@(IsCentralIntegrationDisabled ? "Central integration is disabled" : BacklogText(summary.ArtifactOutbox.Value))</small><span>@DeliveryLaneText</span></div>
            @if (FullestStorage is { } storage)
            {
                var used = UsedPercent(storage);
                <div class="ops-lane"><span><strong>Storage pressure</strong><small>@FormatBytes(storage.AvailableBytes) available</small></span><span class="ops-meter @(storage.IsUnderPressure ? "attention" : "blue")" role="meter" aria-label="@($"{SplitWords(storage.Alias)} storage used")" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@used"><i style="@($"width: {used}%")"></i></span><span>@used% used</span></div>
            }
            else
            {
                <div class="ops-lane"><span><strong>Storage pressure</strong><small>Capacity not reported</small></span><small class="ops-lane-note">No storage probe has succeeded</small><span>Unavailable</span></div>
            }
        </div>
    </section>

    <div class="ops-grid two">
        <section class="ops-panel" aria-labelledby="facts-heading">
            <header class="ops-panel-heading"><div><h2 id="facts-heading">Current operating facts</h2><p>Bounded signals for this CameraAgent process.</p></div><span>@FormatClock(summary.CapturedUtc) UTC</span></header>
            <div class="ops-metric-grid">
                @if (telemetry.LatestCaptureStartedUtc is { } latestCapture)
                {
                    <div class="ops-metric"><span>Capture age</span><strong>@FormatAge(latestCapture)</strong><small>Average interval @FormatSeconds(telemetry.AverageIntervalMilliseconds)</small></div>
                }
                else
                {
                    <div class="ops-metric"><span>Capture age</span><strong>None</strong><small>No capture activity yet</small></div>
                }
                <div class="ops-metric"><span>Last processing</span><strong>@LastProcessingValue</strong><small>@LastProcessingDetail</small></div>
                <div class="ops-metric"><span>Sensor</span><strong class="unreported">Not reported</strong><small>Not reported by this CameraAgent</small></div>
                <div class="ops-metric"><span>Cloud estimate</span><strong class="unreported">Not reported</strong><small>Not reported by this CameraAgent</small></div>
            </div>
        </section>
        <section class="ops-panel" aria-labelledby="changes-heading">
            <header class="ops-panel-heading"><div><h2 id="changes-heading">Recent changes</h2><p>Authenticated configuration and control history.</p></div><span>UTC</span></header>
            @if (changes.Count == 0)
            {
                <p class="ops-panel-empty"><span class="status-icon pending" aria-hidden="true"></span>Recent changes are unavailable.</p>
            }
            else
            {
                <ol class="ops-audit-list">
                    @foreach (var change in changes)
                    {
                        <li><time datetime="@FormatIso(change.Utc)">@FormatChangeTime(change.Utc)</time><strong>@change.Area</strong><span>@change.Text</span></li>
                    }
                </ol>
            }
        </section>
    </div>
}

@if (_pendingCommand is not null)
{
    <dialog class="action-dialog operations-dialog" aria-labelledby="operations-dialog-heading" aria-describedby="operations-dialog-description"
            @ref="_confirmationDialog" @oncancel="CancelConfirmationAsync" @oncancel:preventDefault>
        <div class="dialog-header">
            <div><p class="eyebrow">Authenticated local action</p><h2 id="operations-dialog-heading">@_pendingCommand.Heading</h2></div>
            <button type="button" class="icon-button" aria-label="Close dialog" disabled="@_isSubmitting" @onclick="CancelConfirmationAsync"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"></path></svg></button>
        </div>
        <p id="operations-dialog-description">@_pendingCommand.Description</p>
        <div class="operations-dialog-note"><strong>Local authority only</strong><span>Changes capture admission on this CameraAgent only. Expected state version @_pendingCommand.ExpectedVersion.</span></div>
        @if (_commandError is not null)
        {
            <div class="ops-note-banner compact dialog-error" role="alert"><span class="status-icon failure" aria-hidden="true"></span><span>@_commandError Confirming again retries the same request.</span></div>
        }
        <footer>
            <button type="button" class="button secondary" disabled="@_isSubmitting" @onclick="CancelConfirmationAsync">Cancel</button>
            <button type="button" class="button primary" disabled="@_isSubmitting" @onclick="ConfirmCommandAsync">@(_isSubmitting ? "Submitting..." : "Confirm")</button>
        </footer>
    </dialog>
}

<div class="toast" role="status" aria-live="polite" hidden="@(_toast is null)">
    <span class="status-icon success" aria-hidden="true"></span>
    <div><strong>@_toast?.Title</strong><p>@_toast?.Detail</p></div>
</div>
