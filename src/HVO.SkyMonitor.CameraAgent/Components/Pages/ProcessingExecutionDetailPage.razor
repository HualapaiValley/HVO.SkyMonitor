@page "/operations/pipeline/executions/{ExecutionId:guid}"
@layout MainLayout
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Common.Capture.Processing
@using HVO.SkyMonitor.CameraAgent.Services
@using HVO.SkyMonitor.CameraAgent.Components.Operations
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Pipeline run</PageTitle>

<div class="execution-page">
    @if (_loading && _view is null)
    {
        <PageStateNotice Kind="PageStateNotice.PageStateKind.Loading" Title="Loading execution" Message="Reading the durable execution journal." />
    }
    else if (_view is null)
    {
        <PageStateNotice Kind="@(_notFound ? PageStateNotice.PageStateKind.Info : PageStateNotice.PageStateKind.Error)" Title="@(_notFound ? "Execution not found" : "Execution unavailable")" Message="@_message">
            @if (!_notFound) { <button type="button" class="btn btn-outline-light btn-sm" disabled="@_loading" @onclick="RefreshAsync">Try again</button> }
        </PageStateNotice>
    }
    else
    {
        var execution = _view.Execution;
        <section class="run-workspace" aria-label="Pipeline run">
            <aside class="run-workspace__rail" aria-label="Pipeline navigation">
                <header class="run-rail__heading"><div><p class="eyebrow">Local operations</p><h2>Pipeline runs</h2></div><button type="button" class="icon-button" disabled="@_loading" @onclick="RefreshAsync" aria-label="Refresh pipeline run"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 6V2m0 0h-4m4 0-3 3a7 7 0 1 0 1.7 7" /></svg></button></header>
                <div class="run-rail__controls"><label class="search-field"><span class="visually-hidden">Filter captures</span><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4 4" /></svg><input type="search" placeholder="Filter captures" @bind="_runSearch" @bind:event="oninput" /></label><label><span class="visually-hidden">Filter by outcome</span><select @bind="_outcomeFilter"><option value="all">All outcomes</option><option value="Completed">Succeeded</option><option value="Running">In progress</option><option value="Pending">Pending</option><option value="Failed">Failed</option><option value="Cancelled">Cancelled</option><option value="Expired">Expired</option></select></label></div>
                <div class="run-rail__section"><div class="run-rail__label"><h3>Recent captures</h3><small>UTC</small></div>
                @if (_recent is null)
                {
                    <p class="muted">Recent captures are unavailable.</p>
                }
                else
                {
                    <div class="run-list">@foreach (var run in FilteredRuns)
                    {
                        <a class="run-item @(run.ExecutionId == execution.ExecutionId ? "selected" : "")" aria-current="@(run.ExecutionId == execution.ExecutionId ? "page" : null)" href="/operations/pipeline/executions/@run.ExecutionId"><span class="status-icon @PipelineRunPresentation.StatusClass(run.Status.ToString())" aria-hidden="true"></span><span class="run-copy"><strong>@RunCaptureLabel(run.CaptureId)</strong><small>@PipelineRunPresentation.StatusLabel(run.Status.ToString()) / @run.ExecutionClass</small></span><time datetime="@run.AcceptedUtc.ToString("O")">@run.AcceptedUtc.ToString("HH:mm")</time></a>
                    }</div>
                    @if (FilteredRuns.Count == 0) { <p class="muted">No captures match this filter.</p> }
                }
                </div>
                <div class="run-rail__section stage-section"><div class="run-rail__label"><h3>All stages</h3><button type="button" class="run-rail__filter" aria-pressed="@_requiredOnly.ToString().ToLowerInvariant()" @onclick="() => _requiredOnly = !_requiredOnly"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M6 10h8m-5 5h2" /></svg>Required only</button></div>
                    <div class="stage-list">@foreach (var node in _view.Nodes.Where(node => !_requiredOnly || node.Required))
                    {
                        <button type="button" class="stage-item @(node.NodeId == _selectedNodeId ? "selected" : "")" aria-pressed="@((node.NodeId == _selectedNodeId).ToString().ToLowerInvariant())" @onclick="() => SelectNode(node.NodeId)"><span class="status-icon @PipelineRunPresentation.StatusClass(node.Status)" aria-hidden="true"></span><span title="@node.NodeId">@PipelineRunPresentation.Name(node)</span><small>@PipelineRunPresentation.Duration(PipelineRunPresentation.Duration(node))</small></button>
                    }</div>
                </div>
            </aside>
            <div class="run-workspace__main">
                <header class="run-overview"><div><p class="run-breadcrumb"><a href="/operations">Operations</a><span>/</span><a href="/operations/pipeline/executions">Pipeline</a><span>/</span>Run</p><div class="run-title"><span class="run-title__glyph @TitleStatusClass status-icon @PipelineRunPresentation.StatusClass(execution.Status.ToString())" aria-hidden="true"></span><div><h1>@(_captureSequence is { } sequence ? $"Capture #{sequence}" : "Capture pipeline run")</h1><p>@PipelineRunPresentation.StatusLabel(execution.Status.ToString()) / @execution.ExecutionClass execution</p></div></div></div><div class="heading-actions"><a class="btn btn-outline-light" href="/operations/pipeline/replays/new?captureId=@execution.CaptureId"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 6V2m0 0h-4m4 0-3 3a7 7 0 1 0 1.7 7" /></svg>Reprocess</a><button type="button" class="icon-button" disabled aria-label="More run actions unavailable: no additional action contract" title="No additional run actions available"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="4" cy="10" r="1" /><circle cx="10" cy="10" r="1" /><circle cx="16" cy="10" r="1" /></svg></button></div></header>
                <section class="run-summary" aria-label="Run summary"><div class="run-summary__origin"><span class="camera-glyph" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h3l1.5-2h7L17 7h3a2 2 0 0 1 2 2v9H2V9a2 2 0 0 1 2-2Z" /><circle cx="12" cy="12.5" r="4" /></svg></span><div><span>Triggered by @execution.TriggerKind</span><strong>@TriggerLabel</strong><small>Graph @GraphRevisionLabel / @ScheduleLabel</small></div></div><dl class="run-overview__facts"><div><dt>Status</dt><dd>@PipelineRunPresentation.StatusLabel(execution.Status.ToString())</dd></div><div><dt>Total duration</dt><dd>@PipelineRunPresentation.Duration(execution.Duration)</dd></div><div><dt>Artifacts</dt><dd>@_view.Nodes.SelectMany(static node => node.Outputs).Select(static output => output.ArtifactId).Distinct().Count()</dd></div><div><dt>LogicHost</dt><dd>@LogicHostState</dd></div></dl></section>
                @if (execution.FailureReason is not null || execution.Status == ProcessingGraphExecutionStatus.Failed)
                {
                    <section class="run-notice failure" role="note"><span class="status-icon failure" aria-hidden="true"></span><div><strong>Recorded execution failure</strong><p>@(execution.FailureReason ?? "This execution failed; no detailed reason was retained.")</p></div><a href="#run-inspector">Inspect evidence</a></section>
                }
                else if (_transient?.Events.Any(static stage => stage.CandidateId is not null) == true)
                {
                    <section class="run-notice warning" role="note"><span class="status-icon warning" aria-hidden="true"></span><div><strong>Independent candidate evidence retained</strong><p>Recorded local transient milestones are separate from the image pipeline. No central confirmation is implied.</p></div><a href="/transients/@_transient.Events.First(static stage => stage.CandidateId is not null).CandidateId">View candidate</a></section>
                }
                <section class="graph-card" aria-label="Capture-time dependency graph"><ExecutionRunDiagram @key="execution.ExecutionId" Nodes="@_view.Nodes" GraphTitle="@($"Pipeline revision {GraphRevisionLabel}")" TransientEvents="@(_transient?.Events ?? [])" TransientEnabled="@(TransientEnabled || _transient?.Events.Count > 0)" TransientUnavailable="@_transientUnavailable" SelectedNodeId="@_selectedNodeId" NodeSelected="SelectNode" SelectedTransientKey="@(_selectedTransient is null ? null : ExecutionRunDiagram.StageKey(_selectedTransient))" TransientSelected="SelectTransient" />
                </section>
                <section id="run-inspector" class="run-inspector detail-card" aria-label="Selected stage">
                    <nav class="run-inspector__tabs detail-tabs" role="tablist" aria-label="Stage details">
                        <button id="run-tab-stage" type="button" role="tab" aria-selected="@((_tab == "stage").ToString().ToLowerInvariant())" aria-controls="run-panel" tabindex="@(_tab == "stage" ? 0 : -1)" @onclick="SelectStageTab" @onkeydown="args => TabKeyAsync(args, 0)">Stage summary</button>
                        <button id="run-tab-artifacts" type="button" role="tab" aria-selected="@((_tab == "artifacts").ToString().ToLowerInvariant())" aria-controls="run-panel" tabindex="@(_tab == "artifacts" ? 0 : -1)" @onclick="SelectArtifactsTab" @onkeydown="args => TabKeyAsync(args, 1)">Artifacts <span>@_view.Nodes.Sum(static node => node.Outputs.Count)</span></button>
                        <button id="run-tab-attempts" type="button" role="tab" aria-selected="@((_tab == "attempts").ToString().ToLowerInvariant())" aria-controls="run-panel" tabindex="@(_tab == "attempts" ? 0 : -1)" @onclick="SelectAttemptsTab" @onkeydown="args => TabKeyAsync(args, 2)">Attempts</button>
                    </nav>
                    <div id="run-panel" class="tab-panel" role="tabpanel" aria-labelledby="@($"run-tab-{_tab}")" @ref="_panel">
                    @if (_selectedTransient is { } transient)
                    {
                        <header class="detail-heading"><div><p class="eyebrow">Independent transient lane / recorded milestone</p><h2>@ExecutionRunDiagram.TransientName(transient.StageKey)</h2><p>@transient.State / @(transient.CandidateId is { } candidateId ? $"Candidate {candidateId:D}" : "Capture-scoped milestone")</p></div><span class="state-chip pending">@transient.State</span></header>
                        <div class="detail-grid"><section class="stage-facts"><h3>Execution</h3><dl><div><dt>Recorded</dt><dd>@transient.RecordedUtc.ToString("HH:mm:ss.fff") UTC</dd></div><div><dt>Duration</dt><dd>Not recorded</dd></div><div><dt>Attempt</dt><dd>Not recorded</dd></div><div><dt>Runner</dt><dd>Independent transient lane</dd></div></dl><h3>Dependencies</h3><p class="unavailable-copy">Only evidenced predecessor edges are drawn.</p><h3>Outputs</h3><p class="unavailable-copy">Artifact inventory is unavailable for this milestone.</p></section><section class="event-log"><div class="event-heading"><h3>Stage events</h3><span>Recorded milestone</span></div><ol><li><time>@transient.RecordedUtc.ToString("HH:mm:ss.fff")</time><span class="event-level">Recorded</span><p>@transient.StageKey / @transient.State</p></li></ol><p class="unavailable-copy">@(_tab == "attempts" ? "Attempt history is not recorded by this milestone contract." : _tab == "artifacts" ? "No output artifact identities are recorded by this milestone contract." : "No inferred start, completion or attempt duration is shown.")</p></section></div>
                    }
                    else if (SelectedNode is { } selected)
                    {
                        @if (_tab == "stage")
                        {
                            <header class="detail-heading"><div><p class="eyebrow">Edge processing / @(selected.Required ? "Required" : "Optional")</p><h2>@PipelineRunPresentation.Name(selected)</h2><p>@PipelineRunPresentation.Description(selected)</p></div><span class="state-chip @PipelineRunPresentation.StatusClass(selected.Status)">@PipelineRunPresentation.StatusLabel(selected.Status)</span></header>
                            <div class="detail-grid"><section class="stage-facts"><h3>Execution</h3><dl><div><dt>Started</dt><dd>@(selected.StartedUtc?.ToString("HH:mm:ss.fff") is { } started ? $"{started} UTC" : "Not recorded")</dd></div><div><dt>Completed</dt><dd>@(selected.CompletedUtc?.ToString("HH:mm:ss.fff") is { } ended ? $"{ended} UTC" : "Not recorded")</dd></div><div><dt>Duration</dt><dd>@PipelineRunPresentation.Duration(PipelineRunPresentation.Duration(selected))</dd></div><div><dt>Attempts</dt><dd>@selected.AttemptCount recorded</dd></div><div><dt>Runner</dt><dd>@PipelineRunPresentation.Runner(selected)</dd></div><div><dt>Stage</dt><dd>@selected.NodeId</dd></div></dl><h3>Dependencies</h3><div class="token-list">@if (selected.Dependencies.Count == 0) { <span>No dependencies recorded</span> } @foreach (var dependency in selected.Dependencies) { <span>@dependency.ProducerId / @(dependency.Required ? "required" : "optional")</span> }</div><h3>Outputs</h3><div class="token-list outputs">@if (selected.Outputs.Count == 0) { <span>No outputs recorded</span> } @foreach (var output in selected.Outputs) { <span>@output.Role / @output.Variant / @output.AvailabilityState</span> }</div></section><section class="event-log"><div class="event-heading"><h3>Stage events</h3><span>Recorded execution facts</span></div><ol>@foreach (var fact in StageFacts(selected)) { <li><time>@(fact.Time?.ToString("HH:mm:ss.fff") ?? "Not timed")</time><span class="event-level @fact.Tone">@fact.Label</span><p>@fact.Message</p></li> }</ol><p class="unavailable-copy">Journal facts are shown at their recorded times; no log messages or successful commits are synthesized.</p></section></div>
                        }
                        else if (_tab == "artifacts")
                        {
                            <header class="panel-heading"><div><p class="eyebrow">Immutable run evidence</p><h2>Produced artifacts</h2></div><button type="button" class="btn btn-outline-light" disabled title="No run manifest download contract">Download manifest unavailable</button></header>
                            <div class="artifact-table-wrap"><table><caption class="visually-hidden">Recorded artifacts for this execution</caption><thead><tr><th>Artifact</th><th>Producer</th><th>Size</th><th>Retention</th><th>Publication</th></tr></thead><tbody>@foreach (var node in _view.Nodes) { @foreach (var output in node.Outputs) { var artifact = _capture?.Artifacts.FirstOrDefault(item => item.ArtifactId == output.ArtifactId); <tr><td><strong>@output.Role / @output.Variant</strong><small>@output.ArtifactId</small></td><td>@node.NodeId</td><td>@(artifact?.ByteLength is { } length ? FormatBytes(length) : "Not recorded")</td><td>@output.AvailabilityState</td><td>@(output.Published ? "Published locally" : "Not published")<small>@(output.AvailabilityReason ?? "Central delivery is a separate fact")</small></td></tr> } }</tbody></table></div>
                            @if (_view.Nodes.All(static node => node.Outputs.Count == 0)) { <p class="unavailable-copy">No outputs recorded.</p> }
                        }
                        else
                        {
                            <header class="panel-heading"><div><p class="eyebrow">Immutable execution history</p><h2>@PipelineRunPresentation.Name(selected) attempts</h2></div><span class="quiet-label">Newest first</span></header><ol class="attempt-list">@foreach (var attempt in selected.Attempts.OrderByDescending(static item => item.AttemptNumber)) { <li><span class="status-icon @PipelineRunPresentation.StatusClass(attempt.Status)" aria-hidden="true"></span><span class="attempt-copy"><strong>Attempt @attempt.AttemptNumber — @PipelineRunPresentation.StatusLabel(attempt.Status)</strong><span>@attempt.ExecutionRoute / @PipelineRunPresentation.Duration(attempt.Duration)</span><span>@(attempt.Reason ?? attempt.Outcome ?? "No outcome recorded")</span></span><time>@attempt.StartedUtc.ToString("HH:mm:ss.fff") UTC</time></li> }</ol>
                            @if (selected.Attempts.Count == 0) { <p class="unavailable-copy">No attempts recorded.</p> }
                        }
                    }
                    else { <p class="unavailable-copy">No processing stage is recorded. Designed cloud, meteor and central slots remain explicitly unavailable in the graph.</p> }
                    </div>
                </section>
            </div>
        </section>
        <details class="run-technical"><summary>Technical details and complete execution journal</summary>
        <section class="execution-summary" aria-label="Execution summary">
            <div class="execution-status"><span class="state-chip @ProcessingExecutionsPage.StatusClass(execution.Status)">@execution.Status</span>@if (execution.CancellationRequested && !execution.IsTerminal) { <span class="muted">Cancellation requested</span> }</div>
            <dl class="fact-grid">
                <div><dt>Execution ID</dt><dd><code>@execution.ExecutionId</code></dd></div>
                <div><dt>Class</dt><dd>@execution.ExecutionClass</dd></div>
                <div><dt>Graph revision</dt><dd><code>@execution.GraphRevisionId</code></dd></div>
                <div><dt>Graph definition SHA-256</dt><dd><code>@execution.GraphDefinitionIdentitySha256</code></dd></div>
                <div><dt>Shared plan SHA-256</dt><dd><code>@_view.SharedPlanIdentitySha256</code></dd></div>
                <div><dt>Local plan SHA-256</dt><dd><code>@_view.LocalPlanIdentitySha256</code></dd></div>
                <div><dt>Source capture</dt><dd><a href="/gallery/@execution.CaptureId"><code>@execution.CaptureId</code></a></dd></div>
                <div><dt>Primary artifact</dt><dd><code>@execution.PrimaryArtifactId</code></dd></div>
                <div><dt>Trigger</dt><dd>@execution.TriggerKind@(execution.TriggerReference is null ? "" : $" / {execution.TriggerReference}")</dd></div>
                <div><dt>Priority</dt><dd>@execution.Priority</dd></div>
                <div><dt>Accepted</dt><dd>@execution.AcceptedUtc.ToString("u")</dd></div>
                <div><dt>Available</dt><dd>@execution.AvailableUtc.ToString("u")</dd></div>
                <div><dt>Deadline</dt><dd>@execution.DeadlineUtc.ToString("u")</dd></div>
                <div><dt>Maximum age</dt><dd>@execution.MaximumAgeUtc.ToString("u")</dd></div>
                <div><dt>Started</dt><dd>@(execution.StartedUtc?.ToString("u") ?? "Not started")</dd></div>
                <div><dt>Completed</dt><dd>@(execution.CompletedUtc?.ToString("u") ?? "Not completed")</dd></div>
                <div><dt>Duration</dt><dd>@ProcessingExecutionsPage.FormatDuration(execution.Duration)</dd></div>
                <div><dt>Attempts</dt><dd>@execution.AttemptCount</dd></div>
            </dl>
            @if (execution.FailureReason is not null)
            {
                <p class="failure-reason" role="note"><strong>Failure reason:</strong> @execution.FailureReason</p>
            }
        </section>

        <section class="execution-nodes" aria-labelledby="execution-nodes-heading">
            <h2 id="execution-nodes-heading">Nodes in execution order</h2>
            <ol class="node-list">
                @foreach (var node in _view.Nodes)
                {
                    <li class="node" id="node-@node.NodeId">
                        <details open="@(node.Status is not "Completed")">
                            <summary><span class="state-chip @NodeStatusClass(node.Status)">@node.Status</span><strong>@node.NodeId</strong><span class="muted">@(node.Required ? "required" : "optional") / @node.AttemptCount attempt@(node.AttemptCount == 1 ? "" : "s") / @ProcessingExecutionsPage.FormatDuration(node.StartedUtc is { } s && node.CompletedUtc is { } c ? c - s : null)</span></summary>
                            <dl class="fact-grid">
                                <div><dt>Plan SHA-256</dt><dd><code>@node.PlanSha256</code></dd></div>
                                <div><dt>Started</dt><dd>@(node.StartedUtc?.ToString("u") ?? "Not started")</dd></div>
                                <div><dt>Completed</dt><dd>@(node.CompletedUtc?.ToString("u") ?? "Not completed")</dd></div>
                                @if (node.Reason is not null) { <div><dt>Reason</dt><dd>@node.Reason</dd></div> }
                            </dl>
                            <h3>Inputs</h3>
                            @if (node.Inputs.Count == 0) { <p class="muted">No recorded inputs.</p> }
                            else
                            {
                                <table class="node-table"><caption class="visually-hidden">Inputs of @node.NodeId</caption><thead><tr><th scope="col">Position</th><th scope="col">Kind</th><th scope="col">Capture</th><th scope="col">Artifact</th><th scope="col">Descriptor SHA-256</th><th scope="col">Payload SHA-256</th></tr></thead><tbody>
                                @foreach (var input in node.Inputs) { <tr><td>@input.WindowPosition</td><td>@input.Kind</td><td><a href="/gallery/@input.CaptureId"><code>@ProcessingExecutionsPage.Short(input.CaptureId)</code></a></td><td><code>@ProcessingExecutionsPage.Short(input.ArtifactId)</code></td><td><code>@(input.DescriptorSha256 ?? input.OutputIdentitySha256 ?? "-")</code></td><td><code>@(input.PayloadSha256 ?? "-")</code></td></tr> }
                                </tbody></table>
                            }
                            <h3>Attempts</h3>
                            @if (node.Attempts.Count == 0) { <p class="muted">No attempts recorded.</p> }
                            else
                            {
                                <table class="node-table"><caption class="visually-hidden">Attempts of @node.NodeId</caption><thead><tr><th scope="col">Attempt</th><th scope="col">Status</th><th scope="col">Outcome</th><th scope="col">Started</th><th scope="col">Duration</th><th scope="col">Reason</th></tr></thead><tbody>
                                @foreach (var attempt in node.Attempts) { <tr><td>@attempt.AttemptNumber</td><td>@attempt.Status</td><td>@(attempt.Outcome ?? "-")</td><td>@attempt.StartedUtc.ToString("u")</td><td>@ProcessingExecutionsPage.FormatDuration(attempt.Duration)</td><td>@(attempt.Reason ?? "-")</td></tr> }
                                </tbody></table>
                            }
                            <h3>Outputs</h3>
                            @if (node.Outputs.Count == 0) { <p class="muted">No outputs recorded.</p> }
                            else
                            {
                                <table class="node-table"><caption class="visually-hidden">Outputs of @node.NodeId</caption><thead><tr><th scope="col">Ordinal</th><th scope="col">Role / variant</th><th scope="col">Artifact</th><th scope="col">Output identity SHA-256</th><th scope="col">Availability</th></tr></thead><tbody>
                                @foreach (var output in node.Outputs) { <tr><td>@output.Ordinal</td><td>@output.Role / @output.Variant</td><td>@if (execution.ExecutionClass == ProcessingGraphExecutionClass.Replay && output.AvailabilityState == "Available") { <a href="/api/v1/operations/processing-graphs/executions/@execution.ExecutionId/outputs/@output.ArtifactId/content"><code>@ProcessingExecutionsPage.Short(output.ArtifactId)</code></a> } else { <code>@ProcessingExecutionsPage.Short(output.ArtifactId)</code> }</td><td><code>@output.OutputIdentitySha256</code></td><td>@output.AvailabilityState@(output.AvailabilityReason is null ? "" : $" ({output.AvailabilityReason})")</td></tr> }
                                </tbody></table>
                            }
                        </details>
                    </li>
                }
            </ol>
        </section>
        </details>
    }
</div>
