@page "/operations/pipeline/executions/{ExecutionId:guid}"
@layout MainLayout
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Common.Capture.Processing
@using HVO.SkyMonitor.CameraAgent.Services
@using HVO.SkyMonitor.CameraAgent.Components.Operations
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Execution detail</PageTitle>

<div class="execution-page">
    @if (_loading && _view is null)
    {
        <PageStateNotice Kind="PageStateNotice.PageStateKind.Loading" Title="Loading execution" Message="Reading the durable execution journal." />
    }
    else if (_view is null)
    {
        <PageStateNotice Kind="@(_notFound ? PageStateNotice.PageStateKind.Info : PageStateNotice.PageStateKind.Error)" Title="@(_notFound ? "Execution not found" : "Execution unavailable")" Message="@_message">
            @if (!_notFound) { <button type="button" class="btn btn-outline-light btn-sm" disabled="@_loading" @onclick="RefreshAsync">Try again</button> }
        </PageStateNotice>
    }
    else
    {
        var execution = _view.Execution;
        <section class="run-workspace" aria-label="Pipeline run">
            <aside class="run-workspace__rail" aria-label="Pipeline navigation">
                <header class="run-rail__heading"><div><p class="eyebrow">Local operations</p><h2>Pipeline runs</h2></div><button type="button" class="btn btn-outline-light btn-sm" disabled="@_loading" @onclick="RefreshAsync" aria-label="Refresh pipeline run">↻</button></header>
                <div class="run-rail__controls"><label><span class="visually-hidden">Filter captures</span><input type="search" placeholder="Filter captures" @bind="_runSearch" /></label><label><span class="visually-hidden">Filter by outcome</span><select @bind="_outcomeFilter"><option value="all">All outcomes</option><option value="Completed">Succeeded</option><option value="Running">In progress</option><option value="Failed">Failed</option></select></label></div>
                <div class="run-rail__section"><div class="run-rail__label"><h3>Recent captures</h3><small>UTC</small></div>
                @if (_recent is null)
                {
                    <p class="muted">Recent captures are unavailable.</p>
                }
                else
                {
                    @foreach (var run in FilteredRuns)
                    {
                        <a class="@(run.ExecutionId == execution.ExecutionId ? "run-rail__item run-rail__item--selected" : "run-rail__item")" href="/operations/pipeline/executions/@run.ExecutionId"><strong>@StatusGlyph(run.Status.ToString()) @RunCaptureLabel(run.CaptureId)</strong><span>@run.ExecutionClass / @run.Status / @run.AcceptedUtc.ToString("HH:mm") UTC</span></a>
                    }
                    @if (FilteredRuns.Count == 0) { <p class="muted">No captures match this filter.</p> }
                }
                </div>
                <div class="run-rail__section"><div class="run-rail__label"><h3>All stages</h3><button type="button" class="run-rail__filter" aria-pressed="@_requiredOnly" @onclick="() => _requiredOnly = !_requiredOnly">Required only</button></div>
                    @foreach (var node in _view.Nodes.Where(node => !_requiredOnly || node.Required))
                    {
                        <button type="button" class="@(node.NodeId == _selectedNodeId ? "run-rail__item run-rail__item--selected" : "run-rail__item")" @onclick="() => _selectedNodeId = node.NodeId">@StatusGlyph(node.Status) @node.NodeId <small>@node.Status / @ProcessingExecutionsPage.FormatDuration(node.StartedUtc is { } started && node.CompletedUtc is { } completed ? completed - started : null)</small></button>
                    }
                </div>
            </aside>
            <div class="run-workspace__main">
                <header class="run-overview"><div><p class="run-breadcrumb"><a href="/operations">Operations</a> / <a href="/operations/pipeline/executions">Pipeline</a> / Run</p><div class="run-title"><span class="run-title__glyph @TitleStatusClass" aria-hidden="true">@StatusGlyph(execution.Status.ToString())</span><div><h1>@(_captureSequence is { } sequence ? $"Capture #{sequence}" : "Capture pipeline run")</h1><p>@execution.Status / @execution.ExecutionClass execution</p></div></div></div><a class="btn btn-outline-light" href="/operations/pipeline/replays/new?captureId=@execution.CaptureId">Reprocess</a></header>
                <section class="run-summary" aria-label="Run summary"><div class="run-summary__origin"><strong>Triggered by @execution.TriggerKind</strong><span>@(execution.TriggerReference ?? $"Accepted {execution.AcceptedUtc:u}")</span></div><dl class="run-overview__facts"><div><dt>Status</dt><dd>@execution.Status</dd></div><div><dt>Total duration</dt><dd>@ProcessingExecutionsPage.FormatDuration(execution.Duration)</dd></div><div><dt>Artifacts</dt><dd>@_view.Nodes.Sum(static node => node.Outputs.Count)</dd></div><div><dt>LogicHost</dt><dd>@LogicHostState</dd></div></dl></section>
                <section class="graph-card" aria-label="Capture-time dependency graph"><header class="graph-card__heading"><div><p class="eyebrow">Capture-time dependency graph</p><h2>Pipeline revision @GraphRevisionLabel</h2></div><div class="graph-card__legend"><span class="legend-success">● Succeeded</span><span class="legend-running">● Running</span><span class="legend-attention">! Attention</span><span>○ Skipped</span></div></header><ExecutionRunDiagram Nodes="@_view.Nodes" TransientEvents="@(_transient?.Events ?? [])" TransientEnabled="@TransientEnabled" TransientUnavailable="@_transientUnavailable" SelectedNodeId="@_selectedNodeId" NodeSelected="id => _selectedNodeId = id" />
                <section class="transient-band" aria-label="Independent transient lane"><div><p class="eyebrow">Fireball / transient track</p><h3>Independent durable lane</h3></div><span class="hvo-chip hvo-chip--neutral">@TransientLabel</span>
                    <p>@(!TransientEnabled ? "This local detector is disabled for this CameraAgent." : _transient is { Events.Count: > 0 } ? "The graph shows only committed, candidate-scoped milestones. Missing stages and central acknowledgement are not inferred." : "No stage events are recorded for this capture; no run outcome is inferred.")</p>
                </section></section>
                <section class="run-inspector" aria-label="Selected stage">
                    <nav class="run-inspector__tabs" aria-label="Stage details">
                        <button type="button" aria-pressed="@(_tab == "stage")" @onclick="SelectStageTab">Stage summary</button>
                        <button type="button" aria-pressed="@(_tab == "artifacts")" @onclick="SelectArtifactsTab">Artifacts</button>
                        <button type="button" aria-pressed="@(_tab == "attempts")" @onclick="SelectAttemptsTab">Attempts</button>
                    </nav>
                    @if (SelectedNode is { } selected)
                    {
                        <h3>@selected.NodeId <span class="hvo-chip hvo-chip--neutral">@selected.Status</span></h3>
                        @if (_tab == "stage")
                        {
                            <p>@(selected.Required ? "Required" : "Optional") stage / @ProcessingExecutionsPage.FormatDuration(selected.StartedUtc is { } start && selected.CompletedUtc is { } end ? end - start : null) / @selected.Outputs.Count output(s).</p>
                            <p>Depends on: @(selected.Dependencies.Count == 0 ? "none" : string.Join(", ", selected.Dependencies.Select(static dependency => dependency.ProducerId)))</p>
                            @if (selected.Reason is not null) { <p>@selected.Reason</p> }
                        }
                        else if (_tab == "artifacts")
                        {
                            <ul>@foreach (var output in selected.Outputs) { <li>@output.Role / @output.Variant / @output.AvailabilityState</li> }</ul>
                            @if (selected.Outputs.Count == 0) { <p>No outputs recorded.</p> }
                        }
                        else
                        {
                            <ol>@foreach (var attempt in selected.Attempts) { <li>Attempt @attempt.AttemptNumber: @attempt.Status / @attempt.ExecutionRoute / @ProcessingExecutionsPage.FormatDuration(attempt.Duration)</li> }</ol>
                            @if (selected.Attempts.Count == 0) { <p>No attempts recorded.</p> }
                        }
                    }
                </section>
            </div>
        </section>
        <details class="run-technical"><summary>Technical details and complete execution journal</summary>
        <section class="execution-summary" aria-label="Execution summary">
            <div class="execution-status"><span class="state-chip @ProcessingExecutionsPage.StatusClass(execution.Status)">@execution.Status</span>@if (execution.CancellationRequested && !execution.IsTerminal) { <span class="muted">Cancellation requested</span> }</div>
            <dl class="fact-grid">
                <div><dt>Execution ID</dt><dd><code>@execution.ExecutionId</code></dd></div>
                <div><dt>Class</dt><dd>@execution.ExecutionClass</dd></div>
                <div><dt>Graph revision</dt><dd><code>@execution.GraphRevisionId</code></dd></div>
                <div><dt>Graph definition SHA-256</dt><dd><code>@execution.GraphDefinitionIdentitySha256</code></dd></div>
                <div><dt>Shared plan SHA-256</dt><dd><code>@_view.SharedPlanIdentitySha256</code></dd></div>
                <div><dt>Local plan SHA-256</dt><dd><code>@_view.LocalPlanIdentitySha256</code></dd></div>
                <div><dt>Source capture</dt><dd><a href="/gallery/@execution.CaptureId"><code>@execution.CaptureId</code></a></dd></div>
                <div><dt>Primary artifact</dt><dd><code>@execution.PrimaryArtifactId</code></dd></div>
                <div><dt>Trigger</dt><dd>@execution.TriggerKind@(execution.TriggerReference is null ? "" : $" / {execution.TriggerReference}")</dd></div>
                <div><dt>Priority</dt><dd>@execution.Priority</dd></div>
                <div><dt>Accepted</dt><dd>@execution.AcceptedUtc.ToString("u")</dd></div>
                <div><dt>Available</dt><dd>@execution.AvailableUtc.ToString("u")</dd></div>
                <div><dt>Deadline</dt><dd>@execution.DeadlineUtc.ToString("u")</dd></div>
                <div><dt>Maximum age</dt><dd>@execution.MaximumAgeUtc.ToString("u")</dd></div>
                <div><dt>Started</dt><dd>@(execution.StartedUtc?.ToString("u") ?? "Not started")</dd></div>
                <div><dt>Completed</dt><dd>@(execution.CompletedUtc?.ToString("u") ?? "Not completed")</dd></div>
                <div><dt>Duration</dt><dd>@ProcessingExecutionsPage.FormatDuration(execution.Duration)</dd></div>
                <div><dt>Attempts</dt><dd>@execution.AttemptCount</dd></div>
            </dl>
            @if (execution.FailureReason is not null)
            {
                <p class="failure-reason" role="note"><strong>Failure reason:</strong> @execution.FailureReason</p>
            }
        </section>

        <section class="execution-nodes" aria-labelledby="execution-nodes-heading">
            <h2 id="execution-nodes-heading">Nodes in execution order</h2>
            <ol class="node-list">
                @foreach (var node in _view.Nodes)
                {
                    <li class="node" id="node-@node.NodeId">
                        <details open="@(node.Status is not "Completed")">
                            <summary><span class="state-chip @NodeStatusClass(node.Status)">@node.Status</span><strong>@node.NodeId</strong><span class="muted">@(node.Required ? "required" : "optional") / @node.AttemptCount attempt@(node.AttemptCount == 1 ? "" : "s") / @ProcessingExecutionsPage.FormatDuration(node.StartedUtc is { } s && node.CompletedUtc is { } c ? c - s : null)</span></summary>
                            <dl class="fact-grid">
                                <div><dt>Plan SHA-256</dt><dd><code>@node.PlanSha256</code></dd></div>
                                <div><dt>Started</dt><dd>@(node.StartedUtc?.ToString("u") ?? "Not started")</dd></div>
                                <div><dt>Completed</dt><dd>@(node.CompletedUtc?.ToString("u") ?? "Not completed")</dd></div>
                                @if (node.Reason is not null) { <div><dt>Reason</dt><dd>@node.Reason</dd></div> }
                            </dl>
                            <h3>Inputs</h3>
                            @if (node.Inputs.Count == 0) { <p class="muted">No recorded inputs.</p> }
                            else
                            {
                                <table class="node-table"><caption class="visually-hidden">Inputs of @node.NodeId</caption><thead><tr><th scope="col">Position</th><th scope="col">Kind</th><th scope="col">Capture</th><th scope="col">Artifact</th><th scope="col">Descriptor SHA-256</th><th scope="col">Payload SHA-256</th></tr></thead><tbody>
                                @foreach (var input in node.Inputs) { <tr><td>@input.WindowPosition</td><td>@input.Kind</td><td><a href="/gallery/@input.CaptureId"><code>@ProcessingExecutionsPage.Short(input.CaptureId)</code></a></td><td><code>@ProcessingExecutionsPage.Short(input.ArtifactId)</code></td><td><code>@(input.DescriptorSha256 ?? input.OutputIdentitySha256 ?? "-")</code></td><td><code>@(input.PayloadSha256 ?? "-")</code></td></tr> }
                                </tbody></table>
                            }
                            <h3>Attempts</h3>
                            @if (node.Attempts.Count == 0) { <p class="muted">No attempts recorded.</p> }
                            else
                            {
                                <table class="node-table"><caption class="visually-hidden">Attempts of @node.NodeId</caption><thead><tr><th scope="col">Attempt</th><th scope="col">Status</th><th scope="col">Outcome</th><th scope="col">Started</th><th scope="col">Duration</th><th scope="col">Reason</th></tr></thead><tbody>
                                @foreach (var attempt in node.Attempts) { <tr><td>@attempt.AttemptNumber</td><td>@attempt.Status</td><td>@(attempt.Outcome ?? "-")</td><td>@attempt.StartedUtc.ToString("u")</td><td>@ProcessingExecutionsPage.FormatDuration(attempt.Duration)</td><td>@(attempt.Reason ?? "-")</td></tr> }
                                </tbody></table>
                            }
                            <h3>Outputs</h3>
                            @if (node.Outputs.Count == 0) { <p class="muted">No outputs recorded.</p> }
                            else
                            {
                                <table class="node-table"><caption class="visually-hidden">Outputs of @node.NodeId</caption><thead><tr><th scope="col">Ordinal</th><th scope="col">Role / variant</th><th scope="col">Artifact</th><th scope="col">Output identity SHA-256</th><th scope="col">Availability</th></tr></thead><tbody>
                                @foreach (var output in node.Outputs) { <tr><td>@output.Ordinal</td><td>@output.Role / @output.Variant</td><td>@if (execution.ExecutionClass == ProcessingGraphExecutionClass.Replay && output.AvailabilityState == "Available") { <a href="/api/v1/operations/processing-graphs/executions/@execution.ExecutionId/outputs/@output.ArtifactId/content"><code>@ProcessingExecutionsPage.Short(output.ArtifactId)</code></a> } else { <code>@ProcessingExecutionsPage.Short(output.ArtifactId)</code> }</td><td><code>@output.OutputIdentitySha256</code></td><td>@output.AvailabilityState@(output.AvailabilityReason is null ? "" : $" ({output.AvailabilityReason})")</td></tr> }
                                </tbody></table>
                            }
                        </details>
                    </li>
                }
            </ol>
        </section>
        </details>
    }
</div>
