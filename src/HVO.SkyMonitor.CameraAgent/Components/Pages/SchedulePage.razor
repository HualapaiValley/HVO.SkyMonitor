@inherits SiteTimeComponent
@page "/schedule"
@page "/operations/schedule"
@layout OperationsLayout
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.CameraAgent.Components.Operations
@using HVO.SkyMonitor.AgentCore
@using HVO.SkyMonitor.CameraAgent.Common.Scheduling
@using HVO.SkyMonitor.CameraAgent.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Schedule</PageTitle>

<OperationsPageHeading Eyebrow="Capture / deterministic admission" Title="Schedule" HeadingId="schedule-heading"
                       Description="Define when capture may start, then apply exposure setpoints without catch-up captures. Changes are saved as a draft revision and take effect only when you apply it.">
    <Actions>
        <button type="button" id="schedule-refresh" class="icon-button" aria-label="Refresh" title="Refresh" disabled="@(_loading || _busy)" @onclick="RefreshAsync">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15.5 7A6 6 0 1 0 16 11"></path><path d="M16 3.5V7h-3.5"></path></svg>
        </button>
        <button type="button" id="schedule-override-open" class="button secondary" disabled="@(_state is null || _busy || OverrideUnavailableReason is not null)"
                title="@OverrideUnavailableReason" aria-describedby="@(OverrideUnavailableReason is null ? null : "schedule-override-unavailable")" @onclick="OpenOverrideDialog">Temporary override</button>
        @if (OverrideUnavailableReason is { } overrideUnavailable)
        {
            <span id="schedule-override-unavailable" class="visually-hidden">@overrideUnavailable</span>
        }
        <button type="button" id="schedule-edit-open" class="button primary" disabled="@(_state is null || _model is null)" @onclick="OpenEditor">@(_editorDirty ? "Continue draft" : "Edit draft")</button>
    </Actions>
</OperationsPageHeading>

@if (_loading)
{
    <div class="ops-note-banner" role="status"><span class="status-icon running" aria-hidden="true"></span><span>Loading durable schedule state.</span></div>
}
else if (_state is null)
{
    <div class="ops-note-banner schedule-message" role="alert"><span class="status-icon failure" aria-hidden="true"></span><span><strong>Schedule unavailable.</strong> @_message</span></div>
}
else
{
    var decision = _state.Decision;
    @if (_message is not null && _dialog == ScheduleDialog.None)
    {
        <div class="ops-note-banner schedule-message" role="@(_messageIsError ? "alert" : "status")"><span class="status-icon @(_messageIsError ? "failure" : "success")" aria-hidden="true"></span><span>@_message</span></div>
    }

    <section class="ops-profile-banner schedule-state" aria-label="Current admission">
        <div>
            <span class="status-icon @(decision.Admitted ? "success" : "warning")" aria-hidden="true"></span>
            <span>
                <strong>Revision @_state.ActiveRevision.RevisionNumber is @(decision.Admitted ? "open" : "closed")</strong>
                <small>@DecisionSummary</small>
            </span>
        </div>
        <dl>
            <div><dt>Local timezone</dt><dd>@TimeZoneText</dd></div>
            <div><dt>Next transition</dt><dd>@(decision.NextTransitionUtc is { } next ? DayClock(next) : "None scheduled")</dd></div>
            <div><dt>Active setpoint</dt><dd>@(decision.SetpointProfileId ?? "None")</dd></div>
        </dl>
    </section>

    @if (_state.PendingRevision is { } pending)
    {
        var rollback = pending.RevisionNumber < _state.ActiveRevision.RevisionNumber;
        <section class="ops-note-banner schedule-pending" aria-label="Saved draft">
            <span class="status-icon warning" aria-hidden="true"></span>
            <div>
                @if (PendingRigSchedule)
                {
                    <p><strong>Revision @pending.RevisionNumber carries a named rig awaiting restart.</strong> It cannot be applied as a schedule draft; restart CameraAgent to apply it, or cancel the pending rig.</p>
                    <div class="schedule-pending-actions">
                        <a class="button secondary small" href="/operations/camera">View or cancel the pending rig</a>
                        <RestartToApply Subject="the staged rig" />
                    </div>
                }
                else
                {
                    <p><strong>Draft revision @pending.RevisionNumber is saved but not active.</strong> @(rollback ? "Applying it rolls the schedule back to an earlier revision." : "Review it and apply it at the next capture boundary.")</p>
                    @if (!ScheduleActionsBlocked)
                    {
                        <div class="schedule-pending-actions">
                            <button type="button" id="@PendingActivationTriggerId(pending.RevisionId)" class="button primary small" disabled="@_busy" @onclick="() => BeginActivation(pending.RevisionId, PendingActivationTriggerId(pending.RevisionId), rollback)">@(rollback ? "Review rollback" : "Review apply")</button>
                        </div>
                    }
                }
            </div>
        </section>
    }

    <section class="ops-panel" aria-labelledby="schedule-tonight-heading">
        <header class="ops-panel-heading">
            <div><h3 id="schedule-tonight-heading">Tonight</h3><p>Planned admission for the current local night from the active revision. Live safety and pause are shown above.</p></div>
            @if (Tonight is { } tonightHeader)
            {
                <span>@tonightHeader.LocalDate.ToString("d MMM", Invariant) / local time</span>
            }
        </header>
        @if (Tonight is { } tonight)
        {
            <div class="schedule-clock" aria-hidden="true">
                @foreach (var segment in tonight.Segments.Where(static item => SegmentClass(item) is not null))
                {
                    <i class="schedule-segment @SegmentClass(segment)" style="@SegmentStyle(tonight, segment)"></i>
                }
                @if (NowFraction(tonight) is { } now)
                {
                    <b class="schedule-now" style="left: @Percent(now)"></b>
                }
                <strong>@TonightLabel(tonight)</strong>
                @foreach (var tick in Ticks(tonight))
                {
                    <span style="left: @Percent(tick.Fraction)">@tick.Label</span>
                }
            </div>
            <ul class="schedule-window-list" aria-label="Capture windows tonight">
                @{ var open = tonight.Segments.Where(static item => item.Admitted).ToArray(); }
                @if (open.Length == 0)
                {
                    <li><strong>No capture window tonight.</strong><span>@ClosedReason(tonight)</span></li>
                }
                @foreach (var segment in open)
                {
                    <li class="@SegmentClass(segment)"><strong>@Clock(segment.StartUtc) to @Clock(segment.EndUtc)</strong><span>@SegmentDetail(segment)</span></li>
                }
            </ul>
        }
        else
        {
            <div class="ops-note-banner compact" role="status"><span class="status-icon warning" aria-hidden="true"></span><span>@(_calendarMessage ?? "The schedule calendar is unavailable.") Refresh to try again.</span></div>
        }
    </section>

    <div class="ops-grid two">
        <section class="ops-panel" aria-labelledby="schedule-regimes-heading">
            <header class="ops-panel-heading"><div><h3 id="schedule-regimes-heading">Capture regimes</h3><p>A setpoint is selected when each exposure is admitted.</p></div><span>r@(_state.ActiveRevision.RevisionNumber)</span></header>
            <div class="ops-regime-grid">
                @foreach (var setpoint in _state.ActiveRevision.Definition.SetpointProfiles)
                {
                    var active = decision.Admitted && string.Equals(decision.SetpointProfileId, setpoint.Id, StringComparison.Ordinal);
                    <article class="ops-regime-card @(active ? "active" : null)">
                        <span>@(active ? "Active now" : "Standby")</span>
                        <h4>@setpoint.Id</h4>
                        <dl>
                            <div><dt>Exposure</dt><dd>@Seconds(setpoint.Exposure)</dd></div>
                            <div><dt>Gain</dt><dd>@Number(setpoint.Gain)</dd></div>
                            <div class="full"><dt>Cadence</dt><dd>@CadenceText(setpoint)</dd></div>
                            <div class="full"><dt>Windows</dt><dd>@WindowSummary(setpoint.Id)</dd></div>
                        </dl>
                    </article>
                }
            </div>
        </section>
        <section class="ops-panel" aria-labelledby="schedule-week-heading">
            <header class="ops-panel-heading">
                <div><h3 id="schedule-week-heading">Weekly availability</h3><p>Each row is one local night, noon to noon, with solar boundaries, date exceptions, blackouts and overrides resolved.</p></div>
                @if (_calendar is not null)
                {
                    <span>@_calendar.Nights.Count(static night => night.Segments.Any(static item => item.Admitted)) of @_calendar.Nights.Count open</span>
                }
            </header>
            @if (_calendar is null)
            {
                <p class="schedule-muted">The schedule calendar is unavailable.</p>
            }
            else
            {
                <div class="ops-week">
                    @foreach (var night in _calendar.Nights)
                    {
                        <div class="ops-week-row">
                            <span>@night.LocalDate.ToString("ddd d", Invariant)</span>
                            <span class="ops-week-bar" aria-hidden="true">
                                @foreach (var segment in night.Segments.Where(static item => SegmentClass(item) is not null))
                                {
                                    <i class="schedule-segment @SegmentClass(segment)" style="@SegmentStyle(night, segment)"></i>
                                }
                            </span>
                            <small>@NightSummary(night)</small>
                        </div>
                    }
                </div>
                <ul class="schedule-legend" aria-label="Legend">
                    <li><i class="schedule-segment open"></i>Schedule window</li>
                    <li><i class="schedule-segment override-open"></i>Override open</li>
                    <li><i class="schedule-segment blackout"></i>Blackout or forced closed</li>
                </ul>
            }
        </section>
    </div>

    <div class="ops-grid two">
        <section class="ops-panel" aria-labelledby="schedule-exceptions-heading">
            <header class="ops-panel-heading">
                <div><h3 id="schedule-exceptions-heading">Exceptions &amp; overrides</h3><p>Blackouts outrank temporary overrides, which outrank date exceptions and the repeating week.</p></div>
                <button type="button" id="schedule-exceptions-edit" class="button secondary small" disabled="@(_model is null)" @onclick="@(() => OpenEditorAt(EditorStep.Blackouts, "schedule-exceptions-edit"))">Edit blackouts</button>
            </header>
            @{ var rules = ExceptionRows(); }
            @if (rules.Count == 0 && _state.Overrides.Count == 0)
            {
                <p class="schedule-muted">No date exceptions, blackouts or temporary overrides. The repeating week applies.</p>
            }
            else
            {
                <div class="ops-table-wrap">
                    <table class="ops-table schedule-exceptions">
                        <thead><tr><th scope="col">Starts</th><th scope="col">Rule</th><th scope="col">Detail</th><th scope="col">Ends</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                            @foreach (var rule in rules)
                            {
                                <tr><td>@rule.Starts</td><td><strong>@rule.Rule</strong></td><td>@rule.Detail</td><td>@rule.Ends</td><td></td></tr>
                            }
                            @foreach (var item in _state.Overrides)
                            {
                                <tr>
                                    <td>@DayClock(item.StartUtc)</td>
                                    <td><strong>@(item.Mode == CaptureScheduleOverrideMode.ForceOpen ? "Force open" : "Force closed")</strong></td>
                                    <td>Temporary override@(item.SetpointProfileId is null ? null : $" / {item.SetpointProfileId}")@(item.OneShot ? " / one capture" : null)</td>
                                    <td>@DayClock(item.EndUtc)</td>
                                    <td class="schedule-row-action"><button type="button" class="button secondary small" aria-label="Clear override @OverrideLabel(item)" disabled="@_busy" @onclick="() => ClearOverrideAsync(item.Id)">Clear</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        <section class="ops-panel" aria-labelledby="schedule-precedence-heading">
            <header class="ops-panel-heading"><div><h3 id="schedule-precedence-heading">Admission precedence</h3><p>The first blocking condition wins and remains reason-coded.</p></div></header>
            <ol class="ops-progress-steps">
                @foreach (var step in PrecedenceSteps())
                {
                    <li class="ops-progress-step @step.State"><strong>@step.Title</strong><span>@step.Detail</span></li>
                }
            </ol>
        </section>
    </div>

    <section class="ops-panel ops-grid" aria-labelledby="schedule-history-heading">
        <header class="ops-panel-heading"><div><h3 id="schedule-history-heading">Revision history</h3><p>Applying or rolling back never rewrites the revision bound to earlier captures.</p></div><span>@_state.History.Count revisions</span></header>
        <div class="ops-table-wrap">
            <table class="ops-table">
                <thead><tr><th scope="col">Revision</th><th scope="col">State</th><th scope="col">Source</th><th scope="col">Created</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var revision in _state.History)
                    {
                        var isActive = revision.RevisionId == _state.ActiveRevision.RevisionId;
                        var isPending = revision.RevisionId == _state.PendingRevision?.RevisionId;
                        <tr class="@(isActive ? "current-row" : null)">
                            <td><strong>Revision @revision.RevisionNumber</strong> <code>@ShortHash(revision.ProfileSha256)</code></td>
                            <td>
                                @if (isActive)
                                {
                                    <span class="state-chip success">Active</span>
                                }
                                else if (isPending)
                                {
                                    <span class="state-chip warning">Draft</span>
                                }
                                else
                                {
                                    @(revision.RevisionNumber < _state.ActiveRevision.RevisionNumber ? "Superseded" : "Not applied")
                                }
                            </td>
                            <td>@revision.Source</td>
                            <td>@DayClock(revision.CreatedUtc)</td>
                            <td class="schedule-row-action">
                                @if (!isActive && !ScheduleActionsBlocked && revision.RevisionId != _rigSelection?.PendingScheduleRevisionId)
                                {
                                    var rollback = revision.RevisionNumber < _state.ActiveRevision.RevisionNumber;
                                    <button type="button" id="@HistoryActivationTriggerId(revision)" class="button secondary small" disabled="@_busy" @onclick="() => BeginActivation(revision.RevisionId, HistoryActivationTriggerId(revision), rollback)">@(rollback ? "Review rollback" : "Review apply")</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (_dialog == ScheduleDialog.Editor && _model is not null)
    {
        <dialog class="action-dialog operations-dialog schedule-dialog schedule-editor" aria-labelledby="schedule-editor-heading" @ref="_dialogElement" @oncancel="CloseDialog">
            <div class="dialog-header">
                <div><p class="eyebrow">Schedule draft / basis revision @((_state.PendingRevision ?? _state.ActiveRevision).RevisionNumber)</p><h2 id="schedule-editor-heading">Edit schedule draft</h2></div>
                <button type="button" class="icon-button" aria-label="Close dialog" disabled="@_busy" @onclick="CloseDialog">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"></path></svg>
                </button>
            </div>
            <nav class="schedule-steps" aria-label="Draft sections">
                <ol>
                    @foreach (var step in EditorSteps)
                    {
                        var index = Array.IndexOf(EditorSteps, step) + 1;
                        <li><button type="button" aria-current="@(_step == step ? "step" : null)" @onclick="() => _step = step"><span>@index</span>@StepTitle(step)</button></li>
                    }
                </ol>
            </nav>
            @if (ScheduleActionsBlocked)
            {
                <div class="dialog-note"><strong>Saving is disabled.</strong><span>@(RigPendingRestart ? "A named rig is waiting for CameraAgent to restart. Restart or cancel it before saving schedule changes." : "Named rig selection is unavailable. Close this dialog and refresh before saving.")</span></div>
            }

            <section class="schedule-step" hidden="@(_step != EditorStep.Policy)" aria-labelledby="schedule-step-policy">
                <h3 id="schedule-step-policy" class="visually-hidden">Capture policy</h3>
                <p class="dialog-intro">The day and night values apply when no setpoint window is open. Typed fields rewrite only what they show; @_model.ProcessingStepCount processing step@(_model.ProcessingStepCount == 1 ? "" : "s"), @_model.DateExceptionCount date exception@(_model.DateExceptionCount == 1 ? "" : "s"), and module options carry over unchanged.</p>
                <fieldset class="editor-group" disabled="@_busy">
                    <legend>Exposure and cadence policy</legend>
                    <div class="policy-fields">
                        <label class="ops-field">Capture interval s<input inputmode="decimal" @bind="_model.CaptureIntervalSeconds" @bind:after="FormChanged" /></label>
                        <label class="ops-field">Cadence mode<select @bind="_model.CadenceMode" @bind:after="FormChanged">@foreach (var mode in Enum.GetNames<CaptureCadenceMode>()) { <option value="@mode">@Split(mode)</option> }</select></label>
                        <label class="ops-field">Day exposure ms<input inputmode="decimal" @bind="_model.DayExposureMilliseconds" @bind:after="FormChanged" /></label>
                        <label class="ops-field">Night exposure ms<input inputmode="decimal" @bind="_model.NightExposureMilliseconds" @bind:after="FormChanged" /></label>
                        <label class="ops-field">Day gain<input inputmode="decimal" @bind="_model.DayGain" @bind:after="FormChanged" /></label>
                        <label class="ops-field">Night gain<input inputmode="decimal" @bind="_model.NightGain" @bind:after="FormChanged" /></label>
                    </div>
                    @if (_model.HasEnvelope)
                    {
                        <p class="editor-note">Metered exposure envelope</p>
                        <div class="policy-fields">
                            <label class="ops-field">Minimum exposure ms<input inputmode="decimal" @bind="_model.MinimumExposureMilliseconds" @bind:after="FormChanged" /></label>
                            <label class="ops-field">Maximum exposure ms<input inputmode="decimal" @bind="_model.MaximumExposureMilliseconds" @bind:after="FormChanged" /></label>
                            <label class="ops-field">Minimum gain<input inputmode="decimal" @bind="_model.MinimumGain" @bind:after="FormChanged" /></label>
                            <label class="ops-field">Maximum gain<input inputmode="decimal" @bind="_model.MaximumGain" @bind:after="FormChanged" /></label>
                            <label class="ops-field">Target ADU level<input inputmode="decimal" @bind="_model.TargetAduLevel" @bind:after="FormChanged" /></label>
                            <label class="ops-field">Adjustment order<select @bind="_model.ExposurePreference" @bind:after="FormChanged">@foreach (var preference in Enum.GetNames<ExposureGainPreference>()) { <option value="@preference">@Split(preference)</option> }</select></label>
                        </div>
                    }
                    else
                    {
                        <p class="editor-note">This profile has no metered exposure envelope; day and night values apply directly.</p>
                    }
                </fieldset>
                <fieldset class="editor-group" disabled="@_busy">
                    <legend>Automatic control policy</legend>
                    <div class="policy-fields">
                        <label class="ops-field">Exposure control<select @bind="_model.ExposureControl" @bind:after="FormChanged">@foreach (var ownership in Enum.GetNames<AutomaticControlOwnership>()) { <option value="@ownership">@Split(ownership)</option> }</select></label>
                        <label class="ops-field">Gain control<select @bind="_model.GainControl" @bind:after="FormChanged">@foreach (var ownership in Enum.GetNames<AutomaticControlOwnership>()) { <option value="@ownership">@Split(ownership)</option> }</select></label>
                        <label class="ops-field">Temperature mode<select @bind="_model.TemperatureMode" @bind:after="FormChanged">@foreach (var mode in Enum.GetNames<TemperatureControlMode>()) { <option value="@mode">@Split(mode)</option> }</select></label>
                        <label class="ops-field">Temperature target C<input inputmode="decimal" placeholder="none" @bind="_model.TemperatureTargetC" @bind:after="FormChanged" /></label>
                    </div>
                </fieldset>
            </section>

            <section class="schedule-step" hidden="@(_step != EditorStep.Setpoints)" aria-labelledby="schedule-step-setpoints">
                <h3 id="schedule-step-setpoints" class="visually-hidden">Setpoints</h3>
                <p class="dialog-intro">A setpoint is the exposure, gain and cadence a schedule window captures with. Weekly windows and overrides refer to setpoints by identifier.</p>
                <fieldset class="editor-group" disabled="@_busy">
                    <legend>Setpoint profiles</legend>
                    <ul class="setpoint-list">
                        @foreach (var row in _model.Setpoints)
                        {
                            <li class="editor-card" @key="row">
                                <label class="ops-field">Identifier<input aria-label="Setpoint identifier" @bind="row.Id" @bind:after="FormChanged" /></label>
                                <label class="ops-field">Exposure ms<input inputmode="decimal" aria-label="Setpoint exposure milliseconds" @bind="row.ExposureMilliseconds" @bind:after="FormChanged" /></label>
                                <label class="ops-field">Gain<input inputmode="decimal" aria-label="Setpoint gain" @bind="row.Gain" @bind:after="FormChanged" /></label>
                                <label class="ops-field">Interval s<input inputmode="decimal" aria-label="Setpoint capture interval seconds" @bind="row.CaptureIntervalSeconds" @bind:after="FormChanged" /></label>
                                <label class="ops-field">Cadence<select aria-label="Setpoint cadence mode" @bind="row.CadenceMode" @bind:after="FormChanged">@foreach (var mode in Enum.GetNames<CaptureCadenceMode>()) { <option value="@mode">@Split(mode)</option> }</select></label>
                                <label class="ops-field">Target FPS<input inputmode="decimal" aria-label="Setpoint target frames per second" placeholder="none" @bind="row.TargetFps" @bind:after="FormChanged" /></label>
                                <button type="button" class="button secondary small" aria-label="Remove setpoint @row.Id" @onclick="() => RemoveSetpoint(row)">Remove</button>
                            </li>
                        }
                    </ul>
                    <div><button type="button" class="button secondary small" @onclick="AddSetpoint">Add setpoint profile</button></div>
                </fieldset>
            </section>

            <section class="schedule-step" hidden="@(_step != EditorStep.Windows)" aria-labelledby="schedule-step-windows">
                <h3 id="schedule-step-windows" class="visually-hidden">Weekly windows</h3>
                <p class="dialog-intro">Each window opens on the checked start days and may end the next morning. Solar boundaries resolve for the site location each night; times are local to @_timeZoneId.</p>
                <fieldset class="editor-group" disabled="@_busy">
                    <legend>Weekly windows</legend>
                    @if (_model.WeeklyWindows.Count == 0)
                    {
                        <p class="editor-note">A canonical profile needs at least one weekly window.</p>
                    }
                    <ul class="window-list">
                        @foreach (var window in _model.WeeklyWindows)
                        {
                            <li class="window-item editor-card" @key="window">
                                <div class="window-item__head">
                                    <div class="window-days" role="group" aria-label="Days for window @window.Id">
                                        <span>Start days</span>
                                        @foreach (var day in Enum.GetValues<DayOfWeek>())
                                        {
                                            var selectedDay = day;
                                            <label class="check"><input type="checkbox" checked="@window.Days.Contains(day)" @onchange="e => SetWindowDay(window, selectedDay, e.Value is true)" /><span title="@day">@day.ToString()[..3]</span></label>
                                        }
                                    </div>
                                    <label class="ops-field">Setpoint profile<select @bind="window.SetpointProfileId" @bind:after="FormChanged">@foreach (var setpoint in _model.Setpoints) { <option value="@setpoint.Id">@setpoint.Id</option> }</select></label>
                                    <button type="button" class="button secondary small" aria-label="Remove window for @(string.Join(", ", window.Days.Order()))" @onclick="() => RemoveWindow(window)">Remove</button>
                                </div>
                                <div class="boundary-grid">
                                    @BoundaryFields(("Start", window.Start))
                                    @BoundaryFields(("End", window.End))
                                </div>
                                <details class="window-identifiers">
                                    <summary>Window identifiers</summary>
                                    <div>
                                        @foreach (var day in window.Days.Order())
                                        {
                                            <div @key="day">
                                                <label class="ops-field">@day identifier<input @bind="window.DayIds[day]" @bind:after="FormChanged" /></label>
                                                @if (window.Days.Count > 1)
                                                {
                                                    <button type="button" class="button secondary small" aria-label="Split @day from window @window.Id" @onclick="() => SplitWindow(window, day)">Split @day</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </details>
                            </li>
                        }
                    </ul>
                    <div><button type="button" class="button secondary small" @onclick="AddWindow">Add weekly window</button></div>
                </fieldset>
            </section>

            <section class="schedule-step" hidden="@(_step != EditorStep.Blackouts)" aria-labelledby="schedule-step-blackouts">
                <h3 id="schedule-step-blackouts" class="visually-hidden">Blackouts</h3>
                <p class="dialog-intro">A blackout closes capture for a fixed span regardless of windows and overrides. Enter dates and times in @SiteTime.Label. Repeated or skipped daylight-saving hours cannot identify one instant.</p>
                <fieldset class="editor-group" disabled="@_busy">
                    <legend>Blackouts</legend>
                    @if (_model.Blackouts.Count == 0)
                    {
                        <p class="editor-note">No blackout closes the schedule regardless of windows.</p>
                    }
                    <ul class="blackout-list">
                        @foreach (var blackout in _model.Blackouts)
                        {
                            <li class="editor-card" @key="blackout">
                                <label class="ops-field">Identifier<input @bind="blackout.Id" @bind:after="FormChanged" /></label>
                                <label class="ops-field">Start (@SiteTime.Label)<input type="datetime-local" step="any" value="@BlackoutInput(blackout, true)" @onchange="args => SetBlackoutInput(blackout, true, args)" /></label>
                                <label class="ops-field">End (@SiteTime.Label)<input type="datetime-local" step="any" value="@BlackoutInput(blackout, false)" @onchange="args => SetBlackoutInput(blackout, false, args)" /></label>
                                <button type="button" class="button secondary small" aria-label="Remove blackout @blackout.Id" @onclick="() => RemoveBlackout(blackout)">Remove</button>
                            </li>
                        }
                    </ul>
                    <div><button type="button" class="button secondary small" @onclick="AddBlackout">Add blackout</button></div>
                </fieldset>
            </section>

            <section class="schedule-step" hidden="@(_step != EditorStep.Processing)" aria-labelledby="schedule-step-processing">
                <h3 id="schedule-step-processing" class="visually-hidden">Processing graph</h3>
                <p class="dialog-intro">Disable optional processing steps for this revision. Disabled steps stay in the desired graph and are left out of the effective graph.</p>
                <div class="pipeline-console" aria-labelledby="pipeline-heading">
                    <header>
                        <h4 id="pipeline-heading">Desired and effective graph</h4>
                        @if (_pipelinePlan is not null)
                        {
                            <dl><div><dt>Desired</dt><dd><code>@ShortHash(_pipelinePlan.DesiredSha256)</code></dd></div><div><dt>Effective</dt><dd><code>@ShortHash(_pipelinePlan.EffectiveSha256)</code></dd></div></dl>
                        }
                    </header>
                    @if (_pipelinePlan is null)
                    {
                        <p class="editor-note">The graph preview is out of date. Use Validate and preview on the Review step to refresh it.</p>
                    }
                    else
                    {
                        @if (!_pipelineCanToggle)
                        {
                            <p class="editor-note">This revision uses legacy graph inference. Save a cameraagent-local-profile-v2 revision before using step toggles.</p>
                        }
                        <div class="pipeline-columns">
                            <article><h5>Desired graph</h5><ol>@foreach (var node in _pipelinePlan.DesiredNodes) { <li><div><strong>@node.Id</strong><span>@node.Alias / @(node.Required ? "required" : "optional")</span><small>@(node.Dependencies is null ? "Dependencies unavailable" : string.Join(" <- ", node.Dependencies))</small></div><button type="button" class="button secondary small" disabled="@(_busy || !_pipelineCanToggle)" @onclick="() => TogglePipelineAsync(node.Id, !node.Enabled)">@(node.Enabled ? "Disable" : "Enable")</button></li> }</ol></article>
                            <article><h5>Effective graph</h5><ol>@foreach (var node in _pipelinePlan.EffectiveNodes) { <li><div><strong>@node.Id</strong><span>@(node.OutputRole is null ? "Infrastructure" : $"{node.OutputRole}/{node.OutputVariant}")</span><small>@(node.Dependencies is null ? "No declared dependencies" : string.Join(" <- ", node.Dependencies))</small></div></li> }</ol></article>
                        </div>
                    }
                </div>
            </section>

            <section class="schedule-step" hidden="@(_step != EditorStep.Review)" aria-labelledby="schedule-step-review">
                <h3 id="schedule-step-review" class="visually-hidden">Review</h3>
                <p class="dialog-intro">Validate the draft to see the windows it opens over the next seven days. Saving creates an immutable draft revision; nothing changes until you apply it.</p>
                <div class="schedule-review-actions"><button type="button" class="button secondary" disabled="@_busy" @onclick="PreviewAsync">Validate and preview</button></div>
                <div class="schedule-preview" aria-live="polite">
                    @if (_preview is null)
                    {
                        <p class="editor-note">Not validated since the last change.</p>
                    }
                    else if (_preview.Intervals.Count == 0)
                    {
                        <p class="editor-note">No open or closed intervals occur in the next seven days.</p>
                    }
                    else
                    {
                        <ol>
                            @foreach (var interval in _preview.Intervals.Take(20))
                            {
                                <li class="@(interval.Disposition == ExpandedScheduleDisposition.Open ? "open" : "closed")"><strong>@(interval.SetpointProfileId ?? "Closed")</strong><span>@DayClock(interval.StartUtc) to @DayClock(interval.EndUtc)</span><small>@Split(interval.Source.ToString())</small></li>
                            }
                        </ol>
                    }
                    @if (_preview is not null && _preview.UnavailableWindows.Count > 0)
                    {
                        <h4>Nights without the solar event</h4>
                        <ul class="unavailable-list">
                            @foreach (var window in _preview.UnavailableWindows)
                            {
                                <li><strong>@window.LocalDate.ToString("ddd d MMM", Invariant): closed</strong><span>@Split(window.ReasonCode)</span></li>
                            }
                        </ul>
                    }
                </div>
                <details class="editor-advanced">
                    <summary>Advanced canonical JSON</summary>
                    <p class="editor-note">Edits here replace the typed fields until you change a typed field, which rewrites this text from the form. Opaque module and step options are restored from the basis revision by the server.</p>
                    @if (!_typedInputsValid)
                    {
                        <p class="editor-note">Correct the typed fields before editing canonical JSON so those changes are preserved.</p>
                    }
                    <textarea aria-label="Local profile JSON" @bind="_editorJson" @bind:event="oninput" @bind:after="JsonChanged" disabled="@(_busy || !_typedInputsValid)" spellcheck="false"></textarea>
                    <span>@_editorJson.Length chars</span>
                </details>
            </section>

            @if (_message is not null)
            {
                @* The open modal makes the page behind it inert, so outcomes are announced inside the dialog. *@
                <div class="schedule-dialog-message"><div class="ops-note-banner compact schedule-message" role="@(_messageIsError ? "alert" : "status")"><span class="status-icon @(_messageIsError ? "failure" : "success")" aria-hidden="true"></span><span>@_message</span></div></div>
            }
            <footer>
                @if (_editorDirty)
                {
                    <button type="button" class="button secondary schedule-discard" disabled="@_busy" @onclick="DiscardEditsAsync">Discard edits</button>
                }
                <button type="button" class="button secondary" disabled="@(_step == EditorSteps[0])" @onclick="() => MoveStep(-1)">Back</button>
                @if (_step != EditorSteps[^1])
                {
                    <button type="button" class="button secondary" @onclick="() => MoveStep(1)">Next</button>
                }
                <button type="button" class="button primary" disabled="@(_busy || ScheduleActionsBlocked)" @onclick="StageAsync">Save draft</button>
            </footer>
        </dialog>
    }
    else if (_dialog == ScheduleDialog.Override)
    {
        <dialog class="action-dialog operations-dialog schedule-dialog" aria-labelledby="schedule-override-heading" @ref="_dialogElement" @oncancel="CloseDialog">
            <div class="dialog-header">
                <div><p class="eyebrow">Bounded operator override</p><h2 id="schedule-override-heading">Temporary override</h2></div>
                <button type="button" class="icon-button" aria-label="Close dialog" disabled="@_busy" @onclick="CloseDialog">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"></path></svg>
                </button>
            </div>
            <p class="dialog-intro">Open or close capture for a bounded span without editing the schedule. The override is bound to active revision @_state.ActiveRevision.RevisionNumber, and blackouts still win.</p>
            <fieldset disabled="@_busy">
                <legend class="visually-hidden">Override settings</legend>
                <label class="ops-field">Override<select id="schedule-override-mode" @bind="_overrideMode"><option value="ForceClosed">Force closed: stop admitting captures</option><option value="ForceOpen">Force open: admit captures</option></select></label>
                <div class="schedule-dialog-grid">
                    <label class="ops-field">Starts (@_timeZoneId)<input type="datetime-local" step="60" @bind="_overrideStart" /></label>
                    <label class="ops-field">Ends (@_timeZoneId)<input type="datetime-local" step="60" @bind="_overrideEnd" /></label>
                </div>
                @if (_overrideMode == "ForceOpen")
                {
                    <label class="ops-field">Setpoint profile<select @bind="_overrideProfile">@foreach (var setpoint in _state.ActiveRevision.Definition.SetpointProfiles) { <option value="@setpoint.Id">@setpoint.Id</option> }</select></label>
                    <label class="schedule-check"><input type="checkbox" @bind="_overrideOneShot" /> End after the first admitted capture</label>
                }
            </fieldset>
            @if (_message is not null)
            {
                <div class="schedule-dialog-message"><div class="ops-note-banner compact schedule-message" role="@(_messageIsError ? "alert" : "status")"><span class="status-icon @(_messageIsError ? "failure" : "success")" aria-hidden="true"></span><span>@_message</span></div></div>
            }
            <footer>
                <button type="button" class="button secondary" disabled="@_busy" @onclick="CloseDialog">Cancel</button>
                <button type="button" class="button primary" disabled="@_busy" @onclick="AddOverrideAsync">Create override</button>
            </footer>
        </dialog>
    }
    else if (_dialog == ScheduleDialog.Activation && _confirmRevisionId is not null)
    {
        <dialog class="action-dialog operations-dialog schedule-dialog" aria-labelledby="apply-heading" aria-describedby="apply-description" @ref="_dialogElement" @oncancel="CancelActivation">
            <div class="dialog-header">
                <div><p class="eyebrow">Capture-boundary confirmation</p><h2 id="apply-heading">@(_confirmRollback ? "Roll back to" : "Apply") revision @_confirmRevisionNumber?</h2></div>
            </div>
            <p id="apply-description" class="dialog-intro">The capture in progress finishes durable publication before revision @_confirmRevisionNumber becomes active. Captures already taken keep the revision they were admitted under.</p>
            @if (_message is not null)
            {
                <div class="schedule-dialog-message"><div class="ops-note-banner compact schedule-message" role="@(_messageIsError ? "alert" : "status")"><span class="status-icon @(_messageIsError ? "failure" : "success")" aria-hidden="true"></span><span>@_message</span></div></div>
            }
            <footer>
                <button type="button" class="button secondary" disabled="@_busy" autofocus @onclick="CancelActivation">Cancel</button>
                <button type="button" class="button primary" disabled="@_busy" @onclick="ConfirmActivationAsync">@(_confirmRollback ? "Confirm rollback" : "Confirm apply")</button>
            </footer>
        </dialog>
    }
}

@code {
    private RenderFragment<(string Label, CaptureProfileFormModel.BoundaryRow Boundary)> BoundaryFields => context =>
        @<fieldset class="boundary-fields">
            <legend>@context.Label</legend>
            <label class="ops-field">Event<select aria-label="@context.Label boundary kind" @bind="context.Boundary.Kind" @bind:after="FormChanged">@foreach (var kind in Enum.GetNames<CaptureScheduleBoundaryKind>()) { <option value="@kind">@Split(kind)</option> }</select></label>
            @if (context.Boundary.IsFixed)
            {
                <label class="ops-field">Local time<input placeholder="18:30" aria-label="@context.Label local time" @bind="context.Boundary.LocalTime" @bind:after="FormChanged" /></label>
            }
            else
            {
                <label class="ops-field">Offset minutes<input inputmode="decimal" placeholder="0" aria-label="@context.Label offset minutes" @bind="context.Boundary.OffsetMinutes" @bind:after="FormChanged" /></label>
                <label class="ops-field">If no event<input placeholder="HH:mm" aria-label="@context.Label no-event fallback local time" @bind="context.Boundary.NoEventFallbackLocalTime" @bind:after="FormChanged" /></label>
            }
            <label class="ops-field">Day offset<input inputmode="numeric" placeholder="0" aria-label="@context.Label day offset" @bind="context.Boundary.DayOffset" @bind:after="FormChanged" /></label>
        </fieldset>;
}
