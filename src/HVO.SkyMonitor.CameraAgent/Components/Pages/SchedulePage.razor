@page "/schedule"
@page "/operations/schedule"
@layout OperationsLayout
@using HVO.SkyMonitor.CameraAgent.Authorization
@using HVO.SkyMonitor.AgentCore
@using HVO.SkyMonitor.CameraAgent.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = CameraAgentAuthorizationPolicyNames.OperationsReadV1)]
@rendermode InteractiveServer

<PageTitle>Schedule</PageTitle>

<div class="schedule-console">
    <header class="schedule-header">
        <div>
            <p class="eyebrow">Local acquisition authority</p>
            <h1 id="schedule-heading" tabindex="-1">Capture schedule</h1>
            <p>Durable profile revisions, effective UTC windows, and standalone admission state.</p>
        </div>
        <button class="btn btn-outline-light" disabled="@_busy" @onclick="RefreshAsync">Refresh</button>
    </header>

    @if (_loading)
    {
        <section class="schedule-banner" role="status">Loading durable schedule state.</section>
    }
    else if (_state is null)
    {
        <section class="schedule-banner schedule-banner--error" role="alert">
            <strong>Schedule unavailable</strong><span>@_message</span>
        </section>
    }
    else
    {
        @if (_message is not null)
        {
            <section class="schedule-banner @(_messageIsError ? "schedule-banner--error" : null)" role="@(_messageIsError ? "alert" : "status")">@_message</section>
        }

        <section class="schedule-grid" aria-label="Current schedule state">
            <article class="schedule-card schedule-card--hero">
                <p class="eyebrow">Current admission</p>
                <div class="decision-line">
                    <h2>@(_state.Decision.Admitted ? "Open" : "Closed")</h2>
                    <span class="decision-chip @(_state.Decision.Admitted ? "decision-chip--open" : "decision-chip--closed")">@Split(_state.Decision.Reason.ToString())</span>
                </div>
                <dl>
                    <div><dt>Setpoint</dt><dd>@(_state.Decision.SetpointProfileId ?? "None")</dd></div>
                    <div><dt>Effective interval</dt><dd>@FormatInterval(_state.Decision.Interval?.StartUtc, _state.Decision.Interval?.EndUtc)</dd></div>
                    <div><dt>Next transition</dt><dd>@FormatUtc(_state.Decision.NextTransitionUtc)</dd></div>
                    <div><dt>State version</dt><dd>@_state.StateVersion</dd></div>
                </dl>
            </article>

            <article class="schedule-card">
                <p class="eyebrow">Active immutable profile</p>
                <h2>Revision @_state.ActiveRevision.RevisionNumber</h2>
                <code>@ShortHash(_state.ActiveRevision.ProfileSha256)</code>
                <p>@_state.ActiveRevision.Source / @_state.ActiveRevision.CreatedUtc.ToString("u")</p>
            </article>

            <article class="schedule-card">
                <p class="eyebrow">Pending candidate</p>
                @if (_state.PendingRevision is null)
                {
                    <h2>No draft</h2><p>Active state changes only after a validated draft is explicitly applied.</p>
                }
                else
                {
                    var rollback = _state.PendingRevision.RevisionNumber < _state.ActiveRevision.RevisionNumber;
                    <h2>Revision @_state.PendingRevision.RevisionNumber</h2>
                    <code>@ShortHash(_state.PendingRevision.ProfileSha256)</code>
                    <button id="@PendingActivationTriggerId(_state.PendingRevision.RevisionId)" class="btn btn-primary" disabled="@_busy" @onclick="() => BeginActivation(_state.PendingRevision.RevisionId, PendingActivationTriggerId(_state.PendingRevision.RevisionId), rollback)">@(rollback ? "Review rollback" : "Review apply")</button>
                }
            </article>
        </section>

        <section class="pipeline-console" aria-labelledby="pipeline-heading">
            <header><div><p class="eyebrow">Versioned processing authority</p><h2 id="pipeline-heading">Desired and effective graph</h2></div>@if (_pipelinePlan is not null) { <dl><div><dt>Desired SHA-256</dt><dd><code>@ShortHash(_pipelinePlan.DesiredSha256)</code></dd></div><div><dt>Effective SHA-256</dt><dd><code>@ShortHash(_pipelinePlan.EffectiveSha256)</code></dd></div></dl> }</header>
            @if (_pipelinePlan is null)
            {
                <p class="pipeline-unavailable">The processing graph preview is unavailable. Validate the canonical profile editor.</p>
            }
            else
            {
                @if (!_pipelineCanToggle)
                {
                    <p class="pipeline-unavailable">This immutable revision uses legacy graph inference. Stage a cameraagent-local-profile-v2 revision before using node toggles.</p>
                }
                <div class="pipeline-columns">
                    <article><h3>Desired graph</h3><p>Disabled nodes remain visible here and are absent from the effective graph.</p><ol>@foreach (var node in _pipelinePlan.DesiredNodes) { <li><div><strong>@node.Id</strong><span>@node.Alias / @(node.Required ? "required" : "optional")</span><small>@(node.Dependencies is null ? "Dependencies unavailable" : string.Join(" <- ", node.Dependencies))</small></div><button class="btn btn-sm @(node.Enabled ? "btn-outline-warning" : "btn-outline-light")" disabled="@(_busy || !_pipelineCanToggle)" @onclick="() => TogglePipelineAsync(node.Id, !node.Enabled)">@(node.Enabled ? "Disable" : "Enable")</button></li> }</ol></article>
                    <article><h3>Effective graph</h3><p>Validated execution order for the next activated profile revision.</p><ol>@foreach (var node in _pipelinePlan.EffectiveNodes) { <li><div><strong>@node.Id</strong><span>@(node.OutputRole is null ? "Infrastructure" : $"{node.OutputRole}/{node.OutputVariant}")</span><small>@(node.Dependencies is null ? "No declared dependencies" : string.Join(" <- ", node.Dependencies))</small></div></li> }</ol></article>
                </div>
            }
        </section>

        @if (_confirmRevisionId is not null)
        {
            <dialog class="confirmation-panel" aria-labelledby="apply-heading" aria-describedby="apply-description"
                    @oncancel="CancelActivation" @ref="_confirmationDialog">
                <div><p class="eyebrow">Capture-boundary confirmation</p><h2 id="apply-heading">@(_confirmRollback ? "Rollback revision?" : "Apply revision?")</h2><p id="apply-description">The current admitted capture will finish durable publication before this revision becomes active.</p></div>
                <div><button type="button" class="btn btn-primary" disabled="@_busy" @onclick="ConfirmActivationAsync">@(_confirmRollback ? "Confirm rollback" : "Confirm apply")</button><button type="button" class="btn btn-outline-light" disabled="@_busy" autofocus @onclick="CancelActivation">Cancel</button></div>
            </dialog>
        }

        <section class="editor-layout">
            <article class="schedule-card editor-card" aria-labelledby="schedule-editor-heading">
                <header><div><p class="eyebrow">Validated profile editor</p><h2 id="schedule-editor-heading">Schedule draft</h2></div><span>Basis revision @((_state.PendingRevision ?? _state.ActiveRevision).RevisionNumber)</span></header>
                @if (_model is not null)
                {
                    <p class="editor-note">Typed fields rewrite only what they show. @_model.ProcessingStepCount processing step@(_model.ProcessingStepCount == 1 ? "" : "s"), @_model.DateExceptionCount date exception@(_model.DateExceptionCount == 1 ? "" : "s"), module options, and every other field carry over from the basis revision unchanged.</p>

                    <fieldset class="editor-group" disabled="@_busy">
                        <legend>Setpoint profiles</legend>
                        <div class="editor-table" role="table" aria-label="Setpoint profiles">
                            <div class="editor-row editor-row--head" role="row"><span role="columnheader">Identifier</span><span role="columnheader">Exposure ms</span><span role="columnheader">Gain</span><span role="columnheader">Interval s</span><span role="columnheader">Cadence</span><span role="columnheader">Target FPS</span><span role="columnheader" aria-label="Actions"></span></div>
                            @foreach (var row in _model.Setpoints)
                            {
                                <div class="editor-row" role="row" @key="row">
                                    <span role="cell"><input class="form-control" aria-label="Setpoint identifier" @bind="row.Id" @bind:after="FormChanged" /></span>
                                    <span role="cell"><input class="form-control" inputmode="decimal" aria-label="Setpoint exposure milliseconds" @bind="row.ExposureMilliseconds" @bind:after="FormChanged" /></span>
                                    <span role="cell"><input class="form-control" inputmode="decimal" aria-label="Setpoint gain" @bind="row.Gain" @bind:after="FormChanged" /></span>
                                    <span role="cell"><input class="form-control" inputmode="decimal" aria-label="Setpoint capture interval seconds" @bind="row.CaptureIntervalSeconds" @bind:after="FormChanged" /></span>
                                    <span role="cell"><select class="form-select" aria-label="Setpoint cadence mode" @bind="row.CadenceMode" @bind:after="FormChanged">@foreach (var mode in Enum.GetNames<CaptureCadenceMode>()) { <option value="@mode">@Split(mode)</option> }</select></span>
                                    <span role="cell"><input class="form-control" inputmode="decimal" aria-label="Setpoint target frames per second" placeholder="none" @bind="row.TargetFps" @bind:after="FormChanged" /></span>
                                    <span role="cell"><button type="button" class="btn btn-sm btn-outline-light" aria-label="Remove setpoint @row.Id" @onclick="() => RemoveSetpoint(row)">Remove</button></span>
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-light" @onclick="AddSetpoint">Add setpoint profile</button>
                    </fieldset>

                    <fieldset class="editor-group" disabled="@_busy">
                        <legend>Weekly windows</legend>
                        @if (_model.WeeklyWindows.Count == 0)
                        {
                            <p class="editor-note">A canonical profile needs at least one weekly window.</p>
                        }
                        <ul class="window-list">
                            @foreach (var window in _model.WeeklyWindows)
                            {
                                <li class="window-item" @key="window">
                                    <div class="window-item__head">
                                        <label>Identifier<input class="form-control" @bind="window.Id" @bind:after="FormChanged" /></label>
                                        <label>Day<select class="form-select" @bind="window.Day" @bind:after="FormChanged">@foreach (var day in Enum.GetNames<DayOfWeek>()) { <option value="@day">@day</option> }</select></label>
                                        <label>Setpoint profile<select class="form-select" @bind="window.SetpointProfileId" @bind:after="FormChanged">@foreach (var setpoint in _model.Setpoints) { <option value="@setpoint.Id">@setpoint.Id</option> }</select></label>
                                        <button type="button" class="btn btn-sm btn-outline-light" aria-label="Remove window @window.Id" @onclick="() => RemoveWindow(window)">Remove</button>
                                    </div>
                                    <div class="boundary-grid">
                                        @BoundaryFields(("Start", window.Start))
                                        @BoundaryFields(("End", window.End))
                                    </div>
                                </li>
                            }
                        </ul>
                        <button type="button" class="btn btn-sm btn-outline-light" @onclick="AddWindow">Add weekly window</button>
                    </fieldset>

                    <fieldset class="editor-group" disabled="@_busy">
                        <legend>Blackouts</legend>
                        @if (_model.Blackouts.Count == 0)
                        {
                            <p class="editor-note">No blackout closes the schedule regardless of windows.</p>
                        }
                        <ul class="blackout-list">
                            @foreach (var blackout in _model.Blackouts)
                            {
                                <li @key="blackout">
                                    <label>Identifier<input class="form-control" @bind="blackout.Id" @bind:after="FormChanged" /></label>
                                    <label>Start UTC<input class="form-control" @bind="blackout.StartUtc" @bind:after="FormChanged" /></label>
                                    <label>End UTC<input class="form-control" @bind="blackout.EndUtc" @bind:after="FormChanged" /></label>
                                    <button type="button" class="btn btn-sm btn-outline-light" aria-label="Remove blackout @blackout.Id" @onclick="() => RemoveBlackout(blackout)">Remove</button>
                                </li>
                            }
                        </ul>
                        <button type="button" class="btn btn-sm btn-outline-light" @onclick="AddBlackout">Add blackout</button>
                    </fieldset>
                }

                <details class="editor-advanced">
                    <summary>Advanced canonical JSON</summary>
                    <p class="editor-note">Edits here replace the typed fields until you change a typed field above, which rewrites this text from the form. Opaque module and step options are restored from the basis revision by the server.</p>
                    <textarea aria-label="Local profile JSON" @bind="_editorJson" @bind:event="oninput" @bind:after="JsonChanged" disabled="@_busy" spellcheck="false"></textarea>
                    <span>@_editorJson.Length chars</span>
                </details>
                <div class="editor-actions">
                    <button class="btn btn-outline-light" disabled="@_busy" @onclick="PreviewAsync">Validate and preview</button>
                    <button class="btn btn-primary" disabled="@_busy" @onclick="StageAsync">Save immutable draft</button>
                </div>
            </article>

            <article class="schedule-card preview-card" aria-labelledby="schedule-preview-heading" aria-live="polite">
                <p class="eyebrow">Future UTC expansion</p><h2 id="schedule-preview-heading">Preview</h2>
                @if (_preview is null)
                {
                    <p>Validate the editor to inspect effective windows before staging.</p>
                }
                else if (_preview.Intervals.Count == 0)
                {
                    <p>No open or closed intervals occur in this preview range.</p>
                }
                else
                {
                    <ol>
                        @foreach (var interval in _preview.Intervals.Take(20))
                        {
                            <li><span>@Split(interval.Source.ToString())</span><strong>@(interval.SetpointProfileId ?? "Closed")</strong><span>Start <time datetime="@interval.StartUtc.ToString("O")">@interval.StartUtc.ToString("u")</time></span><span>End <time datetime="@interval.EndUtc.ToString("O")">@interval.EndUtc.ToString("u")</time></span></li>
                        }
                    </ol>
                }
                @if (_preview is not null && _preview.UnavailableWindows.Count > 0)
                {
                    <h3>Unavailable solar windows</h3>
                    <ul class="unavailable-list">
                        @foreach (var window in _preview.UnavailableWindows)
                        {
                            <li><strong>@window.LocalDate: closed</strong><span>@Split(window.Source.ToString())</span><span>@Split(window.ReasonCode)</span><span>Start <time datetime="@window.LocalDayStartUtc.ToString("O")">@window.LocalDayStartUtc.ToString("u")</time></span><span>End <time datetime="@window.LocalDayEndUtc.ToString("O")">@window.LocalDayEndUtc.ToString("u")</time></span></li>
                        }
                    </ul>
                }
            </article>
        </section>

        <section class="schedule-grid lower-grid">
            <article class="schedule-card">
                <p class="eyebrow">Bounded operator override</p><h2>Create override</h2>
                <label>Mode<select class="form-select" @bind="_overrideMode"><option value="ForceClosed">Force closed</option><option value="ForceOpen">Force open</option></select></label>
                <label>Start UTC<input class="form-control" @bind="_overrideStart" /></label>
                <label>End UTC<input class="form-control" @bind="_overrideEnd" /></label>
                @if (_overrideMode == "ForceOpen")
                {
                    <label>Setpoint profile<input class="form-control" @bind="_overrideProfile" /></label>
                    <label class="check"><input type="checkbox" @bind="_overrideOneShot" /> Consume on first admission</label>
                }
                <button class="btn btn-outline-warning" disabled="@_busy" @onclick="AddOverrideAsync">Create durable override</button>
            </article>

            <article class="schedule-card">
                <p class="eyebrow">Active and upcoming</p><h2>Overrides</h2>
                @if (_state.Overrides.Count == 0)
                {
                    <p>No durable overrides are active or upcoming.</p>
                }
                else
                {
                    <ul class="override-list">
                        @foreach (var item in _state.Overrides)
                        {
                            <li><div><strong>@Split(item.Mode.ToString())</strong><span>@item.StartUtc.ToString("u") to @item.EndUtc.ToString("u")</span></div><button class="btn btn-sm btn-outline-light" disabled="@_busy" @onclick="() => ClearOverrideAsync(item.Id)">Clear</button></li>
                        }
                    </ul>
                }
            </article>

            <article class="schedule-card history-card">
                <p class="eyebrow">Immutable history</p><h2>Revision history</h2>
                <ol>
                    @foreach (var revision in _state.History)
                    {
                        <li><div><strong>Revision @revision.RevisionNumber</strong><code>@ShortHash(revision.ProfileSha256)</code><span>@revision.CreatedUtc.ToString("u")</span></div>@if (revision.RevisionId != _state.ActiveRevision.RevisionId) { var rollback = revision.RevisionNumber < _state.ActiveRevision.RevisionNumber; <button id="@HistoryActivationTriggerId(revision)" class="btn btn-sm btn-outline-light" disabled="@_busy" @onclick="() => BeginActivation(revision.RevisionId, HistoryActivationTriggerId(revision), rollback)">@(rollback ? "Review rollback" : "Review apply")</button> }</li>
                    }
                </ol>
            </article>
        </section>
    }
</div>

@code {
    private RenderFragment<(string Label, CaptureProfileFormModel.BoundaryRow Boundary)> BoundaryFields => context =>
        @<div class="boundary-fields">
            <span class="boundary-fields__label">@context.Label</span>
            <label>Kind<select class="form-select" aria-label="@context.Label boundary kind" @bind="context.Boundary.Kind" @bind:after="FormChanged">@foreach (var kind in Enum.GetNames<CaptureScheduleBoundaryKind>()) { <option value="@kind">@Split(kind)</option> }</select></label>
            @if (context.Boundary.IsFixed)
            {
                <label>Local time<input class="form-control" placeholder="18:30" aria-label="@context.Label local time" @bind="context.Boundary.LocalTime" @bind:after="FormChanged" /></label>
            }
            else
            {
                <label>Offset minutes<input class="form-control" inputmode="decimal" placeholder="0" aria-label="@context.Label offset minutes" @bind="context.Boundary.OffsetMinutes" @bind:after="FormChanged" /></label>
                <label>No-event fallback<input class="form-control" placeholder="HH:mm" aria-label="@context.Label no-event fallback local time" @bind="context.Boundary.NoEventFallbackLocalTime" @bind:after="FormChanged" /></label>
            }
            <label>Day offset<input class="form-control" inputmode="numeric" placeholder="0" aria-label="@context.Label day offset" @bind="context.Boundary.DayOffset" @bind:after="FormChanged" /></label>
        </div>;
}
