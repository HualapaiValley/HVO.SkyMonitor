@using HVO.SkyMonitor.CameraAgent.Services
@using HVO.SkyMonitor.CameraAgent.Components.Pages
@using Microsoft.AspNetCore.Components.Web

@if (Nodes.Count == 0)
{
    <p>No execution nodes were recorded.</p>
}
else
{
    <div class="run-diagram__toolbar">
        <span>@Nodes.Count recorded stages / @Nodes.Sum(static node => node.Outputs.Count) outputs</span>
        <div role="group" aria-label="Graph zoom">
            <button type="button" class="btn btn-outline-light btn-sm" @onclick="ZoomOut" aria-label="Zoom out">−</button>
            <button type="button" class="btn btn-outline-light btn-sm" @onclick="FitGraph" aria-label="Fit graph">Fit</button>
            <button type="button" class="btn btn-outline-light btn-sm" @onclick="ZoomIn" aria-label="Zoom in">+</button>
        </div>
    </div>
    <div class="run-diagram__scroll">
        <svg class="run-diagram" style="@GraphSizeStyle" viewBox="0 0 @Width @Height" role="group" aria-labelledby="@TitleId @DescriptionId">
            <title id="@TitleId">Execution dependency graph</title>
            <desc id="@DescriptionId">@string.Join(" ", Nodes.Select(node => $"{node.NodeId}: {node.Status}; {(node.Dependencies.Count == 0 ? "no dependencies" : "depends on " + string.Join(", ", node.Dependencies.Select(static dependency => dependency.ProducerId)))}."))</desc>
            @foreach (var band in _bands)
            {
                <g class="run-diagram__band"><rect x="@band.X" y="0" width="@band.Width" height="@Height" /><text x="@(band.X + 12)" y="18">@band.Label</text></g>
            }
            <g class="run-diagram__source"><rect x="@Margin" y="@(HeaderHeight + NodeHeight / 2 - 20)" width="@SourceWidth" height="40" rx="8" /><text x="@(Margin + 10)" y="@(HeaderHeight + NodeHeight / 2 + 5)">Raw capture</text></g>
            @foreach (var edge in _edges)
            {
                <path class="@(edge.Required ? "run-diagram__edge" : "run-diagram__edge run-diagram__edge--optional")" d="@edge.Path" />
            }
            @foreach (var item in _layout)
            {
                var node = item.Node;
                <g class="@NodeClass(node)" role="button" tabindex="0" aria-pressed="@((SelectedNodeId == node.NodeId).ToString().ToLowerInvariant())" aria-label="@node.NodeId: @node.Status, @(node.Required ? "required" : "optional"), @node.Outputs.Count output@(node.Outputs.Count == 1 ? "" : "s"). Activate for details." @onclick="() => NodeSelected.InvokeAsync(node.NodeId)" @onkeydown="args => HandleKey(args, node.NodeId)">
                    <rect x="@item.X" y="@item.Y" width="@NodeWidth" height="@NodeHeight" rx="8" />
                    <text class="run-diagram__status" x="@(item.X + 12)" y="@(item.Y + 27)">@(StatusGlyph(node.Status))</text>
                    <text x="@(item.X + 31)" y="@(item.Y + 27)">@(DisplayName(node.NodeId))</text>
                    <text class="run-diagram__meta" x="@(item.X + 12)" y="@(item.Y + 48)">@node.Status / @ProcessingExecutionsPage.FormatDuration(node.StartedUtc is { } start && node.CompletedUtc is { } end ? end - start : null)</text>
                    <path class="run-diagram__divider" d="M@(item.X + 10),@(item.Y + 65) H@(item.X + NodeWidth - 10)" />
                    <text class="run-diagram__meta" x="@(item.X + 12)" y="@(item.Y + 85)">@node.Outputs.Count artifact@(node.Outputs.Count == 1 ? "" : "s")</text>
                    <text class="run-diagram__meta" x="@(item.X + NodeWidth - 12)" y="@(item.Y + 85)" text-anchor="end">@(node.Required ? "REQUIRED" : "OPTIONAL")</text>
                </g>
            }
            <g class="run-diagram__boundary"><rect x="@PublicationX" y="@(HeaderHeight + NodeHeight / 2 - 20)" width="@SourceWidth" height="40" rx="8" /><text x="@(PublicationX + 10)" y="@(HeaderHeight + NodeHeight / 2 + 5)">Published @Nodes.Sum(static node => node.Outputs.Count(static output => output.Published))</text></g>
            <text class="run-diagram__unavailable" x="@(LogicHostX + 12)" y="@(HeaderHeight + NodeHeight / 2)">No per-run receipt</text>
        </svg>
    </div>
    <div class="run-diagram__legend"><span>━ Required dependency</span><span>┄ Optional dependency</span><span>Click or press Enter on a stage for details</span></div>
}

@code {
    private const int NodeWidth = 204;
    private const int NodeHeight = 100;
    private const int ColumnGap = 76;
    private const int RowGap = 20;
    private const int Margin = 16;
    private const int HeaderHeight = 32;
    private const int SourceWidth = 148;
    private static int _instances;
    private readonly int _instance = Interlocked.Increment(ref _instances);
    private List<PlacedNode> _layout = [];
    private List<GraphEdge> _edges = [];
    private List<GraphBand> _bands = [];
    private double Zoom { get; set; } = 0.5;
    private bool _fit = true;

    [Parameter, EditorRequired] public IReadOnlyList<CameraAgentProcessingNodeView> Nodes { get; set; } = [];
    [Parameter] public string? SelectedNodeId { get; set; }
    [Parameter] public EventCallback<string> NodeSelected { get; set; }

    private string TitleId => $"execution-graph-title-{_instance}";
    private string DescriptionId => $"execution-graph-description-{_instance}";
    private int Width => LogicHostX + SourceWidth + Margin;
    private int EdgeX => Margin + SourceWidth + ColumnGap;
    private int PublicationX => _layout.Count == 0 ? EdgeX : _layout.Max(static item => item.X) + NodeWidth + ColumnGap;
    private int LogicHostX => PublicationX + SourceWidth + ColumnGap;
    // Fit never reduces the recorded graph below half-size. Wider graphs remain
    // horizontally scrollable instead of compressing node text to illegibility.
    private string GraphSizeStyle => _fit
        ? $"width: max(100%, {Width * 0.5}px); height: auto;"
        : $"width: {Width * Zoom}px; height: {Height * Zoom}px;";

    private void FitGraph() { _fit = true; Zoom = 0.5; }
    private void ZoomOut() { _fit = false; Zoom = Math.Max(0.5, Zoom - 0.25); }
    private void ZoomIn() { _fit = false; Zoom = Math.Min(2, Zoom + 0.25); }
    private int Height => _layout.Count == 0 ? 0 : _layout.Max(static item => item.Y) + NodeHeight + Margin;

    protected override void OnParametersSet()
    {
        var byId = Nodes.ToDictionary(static node => node.NodeId, StringComparer.Ordinal);
        var ranks = new Dictionary<string, int>(StringComparer.Ordinal);
        int Rank(string id, int depth)
        {
            if (ranks.TryGetValue(id, out var known)) return known;
            if (depth > Nodes.Count || !byId.TryGetValue(id, out var node)) return 0;
            var rank = 0;
            foreach (var dependency in node.Dependencies)
            {
                if (byId.ContainsKey(dependency.ProducerId)) rank = Math.Max(rank, Rank(dependency.ProducerId, depth + 1) + 1);
            }
            return ranks[id] = rank;
        }
        foreach (var node in Nodes) Rank(node.NodeId, 0);
        var columns = new Dictionary<int, int>();
        _layout = [];
        foreach (var node in Nodes)
        {
            var rank = ranks[node.NodeId];
            var row = columns.GetValueOrDefault(rank);
            columns[rank] = row + 1;
            _layout.Add(new PlacedNode(node, EdgeX + rank * (NodeWidth + ColumnGap), HeaderHeight + row * (NodeHeight + RowGap)));
        }
        _bands =
        [
            new GraphBand(0, EdgeX, "Camera and acquisition"),
            new GraphBand(EdgeX, PublicationX - EdgeX, "CameraAgent edge processing"),
            new GraphBand(PublicationX, LogicHostX - PublicationX, "Durable publication"),
            new GraphBand(LogicHostX, SourceWidth + Margin, "LogicHost / unavailable")
        ];
        var positions = _layout.ToDictionary(static item => item.Node.NodeId, StringComparer.Ordinal);
        _edges = [];
        foreach (var target in _layout)
        {
            if (target.Node.Dependencies.Any(static dependency => dependency.ProducerId == "$raw"))
            {
                var y = target.Y + NodeHeight / 2;
                _edges.Add(new GraphEdge($"M{Margin + SourceWidth},{HeaderHeight + NodeHeight / 2} C{EdgeX - 25},{HeaderHeight + NodeHeight / 2} {EdgeX - 25},{y} {target.X},{y}", true));
            }
            foreach (var dependency in target.Node.Dependencies)
            {
                if (!positions.TryGetValue(dependency.ProducerId, out var source)) continue;
                var x1 = source.X + NodeWidth;
                var y1 = source.Y + NodeHeight / 2;
                var x2 = target.X;
                var y2 = target.Y + NodeHeight / 2;
                var middle = (x1 + x2) / 2;
                _edges.Add(new GraphEdge($"M{x1},{y1} C{middle},{y1} {middle},{y2} {x2},{y2}", dependency.Required));
            }
        }
        foreach (var source in _layout.Where(static item => item.Node.Outputs.Any(static output => output.Published)))
        {
            var x1 = source.X + NodeWidth;
            var y1 = source.Y + NodeHeight / 2;
            var x2 = PublicationX;
            var y2 = HeaderHeight + NodeHeight / 2;
            var middle = (x1 + x2) / 2;
            _edges.Add(new GraphEdge($"M{x1},{y1} C{middle},{y1} {middle},{y2} {x2},{y2}", true));
        }
    }

    private string NodeClass(CameraAgentProcessingNodeView node) =>
        $"run-diagram__node run-diagram__node--{node.Status.ToLowerInvariant()}{(SelectedNodeId == node.NodeId ? " run-diagram__node--selected" : "")}";

    private static string StatusGlyph(string status) => status switch
    {
        "Completed" => "✓",
        "Running" => "●",
        "RetryableFailure" or "TerminalFailure" => "!",
        "Skipped" => "○",
        _ => "·"
    };

    private static string DisplayName(string nodeId) => nodeId.Length <= 21 ? nodeId : string.Concat(nodeId.AsSpan(0, 18), "...");

    private async Task HandleKey(KeyboardEventArgs args, string id)
    {
        if (args.Key is "Enter" or " ") await NodeSelected.InvokeAsync(id);
    }

    private sealed record PlacedNode(CameraAgentProcessingNodeView Node, int X, int Y);
    private sealed record GraphEdge(string Path, bool Required);
    private sealed record GraphBand(int X, int Width, string Label);
}
