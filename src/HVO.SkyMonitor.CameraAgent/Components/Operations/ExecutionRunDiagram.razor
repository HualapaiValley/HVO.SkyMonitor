@inherits SiteTimeComponent
@using System.Globalization
@using HVO.SkyMonitor.CameraAgent.Services
@using HVO.SkyMonitor.CameraAgent.Common.Transients

<div class="run-graph" @ref="_root">
    <header class="graph-toolbar">
        <div><p class="eyebrow">Capture-time dependency graph</p><h2>@GraphTitle</h2></div>
        <div class="graph-controls" role="group" aria-label="Graph controls">
            <div class="legend" aria-label="Status legend"><span><i class="status-dot success"></i>Succeeded</span><span><i class="status-dot running"></i>Running</span><span><i class="status-dot warning"></i>Attention</span><span><i class="status-dot skipped"></i>Skipped</span></div>
            <div class="zoom-controls">
                <button type="button" class="icon-button" @onclick="FitGraph" aria-label="Fit graph" title="Fit graph to viewport"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 3H3v4m10-4h4v4M7 17H3v-4m10 4h4v-4" /></svg></button>
                <button type="button" class="icon-button" @onclick="ZoomOut" aria-label="Zoom out">−</button>
                <output class="run-diagram__zoom" aria-label="Graph zoom mode">@ZoomPercent%</output>
                <button type="button" class="icon-button" @onclick="ZoomIn" aria-label="Zoom in">+</button>
                <button type="button" class="icon-button" @ref="_fullscreenButton" @onclick="ToggleFullscreenAsync" title="@(_fullscreen ? "Exit fullscreen" : "Fullscreen")" aria-label="@(_fullscreen ? "Exit graph fullscreen" : "Graph fullscreen")" aria-pressed="@_fullscreen.ToString().ToLowerInvariant()"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v14M3 10h14M10 3l-2.5 2.5M10 3l2.5 2.5M10 17l-2.5-2.5M10 17l2.5-2.5M3 10l2.5-2.5M3 10l2.5 2.5M17 10l-2.5-2.5M17 10l-2.5 2.5" /></svg></button>
            </div>
        </div>
    </header>
    <div class="run-diagram__scroll graph-viewport" @ref="_viewport" tabindex="0" aria-label="Scrollable pipeline dependency graph">
        <div class="graph-scale" style="@ScaleSizeStyle">
            <div class="graph-canvas run-diagram" style="@($"{GraphSizeStyle}--node-height:{NodeHeight}px;")" role="group" aria-labelledby="@TitleId @DescriptionId">
                <span id="@TitleId" class="visually-hidden">Execution dependency graph</span><span id="@DescriptionId" class="visually-hidden">@GraphDescription</span>
                @foreach (var band in _bands)
                {
                    <div class="ownership-zone" style="left:@(band.X)px;width:@(band.Width)px"><span>@band.Label</span></div>
                }
                <div class="transient-track-band" style="top:@(TransientTop)px"><span><strong>Fireball / transient track</strong><small>Independent durable lane / recorded milestones in @SiteTime.Label</small></span></div>
                <svg class="graph-edges" viewBox="0 0 @Width @Height" aria-hidden="true">
                    <defs><marker id="@ArrowId" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0L10 5L0 10z" /></marker></defs>
                    @* Highlighted dependencies paint last so a muted sibling sharing a single-port
                       stretch cannot cover the selected path. *@
                    @foreach (var edge in _edges.OrderBy(static edge => edge.Highlighted))
                    {
                        <path class="@EdgeClass(edge)" d="@edge.Path" marker-end="url(#@ArrowId)" />
                    }
                    @foreach (var edge in TransientEdges)
                    {
                        <path class="run-diagram__transient-edge" d="@edge" marker-end="url(#@ArrowId)" />
                    }
                </svg>
                <div class="graph-node boundary-node" style="left:@(Margin)px;top:@(SourceY)px" role="note"><span class="node-heading"><span class="node-title"><strong>Raw capture</strong><small>Immutable source evidence</small></span></span><span class="node-footer">Acquisition boundary / not a journal stage</span></div>
                @foreach (var item in _layout)
                {
                    var node = item.Node;
                    <button type="button" class="@NodeClass(node)" style="left:@(item.X)px;top:@(item.Y)px" data-node-id="@node.NodeId" data-status="@PipelineRunPresentation.StatusClass(node.Status)" aria-pressed="@((SelectedNodeId == node.NodeId).ToString().ToLowerInvariant())" aria-label="@($"{PipelineRunPresentation.Name(node)} ({node.NodeId}): {PipelineRunPresentation.StatusLabel(node.Status)}, {(node.Required ? "required" : "optional")}, {node.Outputs.Count} outputs. Activate for details.")" @onclick="() => NodeSelected.InvokeAsync(node.NodeId)">
                        <span class="node-heading"><span class="status-icon @PipelineRunPresentation.StatusClass(node.Status)" aria-hidden="true"></span><span class="node-title"><strong title="@node.NodeId">@PipelineRunPresentation.Name(node)</strong><small title="@PipelineRunPresentation.Type(node)">@PipelineRunPresentation.Type(node)</small></span><span class="node-duration">@PipelineRunPresentation.Duration(PipelineRunPresentation.Duration(node))</span></span>
                        <span class="node-footer"><span>@node.Outputs.Count @(node.Outputs.Count == 1 ? "artifact" : "artifacts")</span><span class="requirement @(!node.Required ? "optional" : "")">@(node.Required ? "Required" : "Optional")</span></span>
                    </button>
                }
                <div class="graph-node boundary-node" style="left:@(PublicationX)px;top:@(SourceY)px" role="note"><span class="node-heading"><span class="node-title"><strong>Durable publication</strong><small>@Nodes.Sum(static node => node.Outputs.Count(static output => output.Published)) published output records</small></span></span><span class="node-footer">Publication is distinct from delivery</span></div>
                <div class="graph-node central boundary-node unavailable" style="left:@(LogicHostX)px;top:@(SourceY)px" role="note"><span class="node-heading"><span class="status-icon skipped" aria-hidden="true"></span><span class="node-title"><strong>LogicHost receipt</strong><small>No per-run receipt retained</small></span></span><span class="node-footer">Unavailable / no fabricated central stage</span></div>
                @if (!HasCloudProduct)
                {
                    <div class="graph-node unavailable run-diagram__cloud-placeholder" style="left:@(EdgeX)px;top:@(CloudTop)px" role="note" aria-label="Cloud assessment: not produced; no cloud product recorded"><span class="node-heading"><span class="status-icon skipped" aria-hidden="true"></span><span class="node-title"><strong>Cloud assessment</strong><small>Not produced</small></span></span><span class="node-footer">No cloud product recorded / no dependency inferred</span></div>
                }
                <div class="run-diagram__transient">
                    @if (!TransientEnabled || TransientUnavailable || TransientEvents.Count == 0)
                    {
                        <div class="graph-node transient unavailable run-diagram__transient-empty" style="left:@(EdgeX)px;top:@(TransientTop + 64)px" role="note" aria-label="Meteor detection: @TransientEmptyLabel"><span class="node-heading"><span class="status-icon skipped" aria-hidden="true"></span><span class="node-title"><strong>Meteor detection</strong><small>@TransientEmptyLabel</small></span></span><span class="node-footer">No stage success or causal edge inferred</span></div>
                    }
                    else
                    {
                        @foreach (var lane in TransientLanes)
                        {
                            <div class="run-diagram__transient-label" style="left:@(Margin)px;top:@(lane.Y - 22)px">@LaneLabel(lane.CandidateId)</div>
                            @for (var i = 0; i < lane.Events.Count; i++)
                            {
                                var stage = lane.Events[i];
                                var x = TransientX(lane, i);
                                <button type="button" class="graph-node transient run-diagram__transient-node @(!StageSucceeded(stage) ? "run-diagram__transient-node--attention" : "") @(SelectedTransientKey == StageKey(stage) ? "selected" : "")" style="left:@(x)px;top:@(lane.Y)px" aria-pressed="@((SelectedTransientKey == StageKey(stage)).ToString().ToLowerInvariant())" aria-label="@($"{TransientName(stage.StageKey)}: {stage.State}, {SiteTime.Format(stage.RecordedUtc)}")" @onclick="() => TransientSelected.InvokeAsync(stage)">
                                    <span class="node-heading"><span class="status-icon @TransientStatus(stage)" aria-hidden="true"></span><span class="node-title"><strong title="@TransientName(stage.StageKey)">@TransientName(stage.StageKey)</strong><small>@stage.State</small></span></span><span class="node-footer"><time class="node-recorded-time" datetime="@stage.RecordedUtc.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)" title="@SiteTime.Format(stage.RecordedUtc)">@SiteTime.Local(stage.RecordedUtc).ToString("HH:mm:ss zzz", CultureInfo.InvariantCulture)</time><span class="requirement optional">Independent</span></span>
                                </button>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </div>
    <footer class="graph-footer"><p><span class="required-line"></span>Required dependency <span class="optional-line"></span>Optional contribution</p><p>@(Nodes.Count == 0 ? "No processing nodes were recorded; the independent transient track is shown." : "Select a stage to inspect its recorded execution evidence.")</p></footer>
</div>
