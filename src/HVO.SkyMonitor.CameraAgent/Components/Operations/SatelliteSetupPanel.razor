@using HVO.SkyMonitor.CameraAgent.Settings
@if (_view is { } view)
{
    <section class="ops-panel satellite-setup" aria-labelledby="satellite-setup-heading">
        <header class="ops-panel-heading"><div><h2 id="satellite-setup-heading">Orbital refresh &amp; satellite setup</h2><p>These switches use the same settings catalogue as <code>hvo-sky config</code>.</p></div></header>
        @foreach (var group in view.Groups)
        {
            var definition = CameraAgentSettingsCatalogue.FindGroup(group.Group)!.Settings.Single();
            var state = group.Settings.Single();
            <div id="@(group.Group + "-switch")" class="feature-switch">
                <label class="ops-field" for="@(group.Group + "-enabled")">@definition.Title
                    <select id="@(group.Group + "-enabled")" value="@(state.PendingValue?.GetString() ?? state.Value?.GetString())"
                            disabled="@(_busy || !group.CanWrite || !state.CanWrite)" @onchange="args => SaveAsync(group, args.Value?.ToString() ?? string.Empty)">
                        @foreach (var choice in definition.AllowedValues!) { <option value="@choice.Value">@choice.Label</option> }
                    </select>
                </label>
                <p>@definition.Description</p>
                <p>In effect: @definition.LabelOf(state.Value?.GetString() ?? "false"). Source: @state.Source.
                    @(definition.AppliesAfterRestart ? "Applies after a restart." : "Applies immediately.")
                    @if (state.PendingValue is { } pending) { <strong>Pending restart: @definition.LabelOf(pending.GetString()!).</strong> }
                </p>
                @if (!group.CanWrite || !state.CanWrite) { <p role="status">@(state.ReadOnlyReason ?? group.ReadOnlyReason)</p> }
            </div>
        }
        <p><a href="/operations/software#software-orbital-heading">Continue orbital refresh setup in Software &amp; Catalog</a></p>
        <div id="satellite-availability" role="status">
            <p>Setup checks the default six-hour window from the selected scene instant. Each search validates its requested window and object epochs.</p>
            @foreach (var problem in view.Problems)
            {
                <p data-reason="@problem.Code">@problem.Message <a href="@problem.Link">@problem.Action</a></p>
            }
            @if (view.Problems.Count == 0) { <p>Local snapshot and time data cover this window. Search passes below to validate the selected objects and their epochs.</p> }
        </div>
        <details id="satellite-time-data">
            <summary>Read-only time-data configuration and resolved status</summary>
            <p>Each CameraAgent release bundles one verified finals2000A Earth-orientation file and one <code>leap-seconds.list</code>, and planning uses that pair by default. To override it, set all four of <code>CameraAgent:SatellitePlanning:EarthOrientationPath</code>, <code>EarthOrientationSha256</code>, <code>LeapSecondsPath</code> and <code>LeapSecondsSha256</code> in the operator settings file with absolute paths visible inside CameraAgent. While any of them is set, no other pair is used: an incomplete or invalid override stops planning. Environment variables and <code>config/secrets</code> override that file. With <strong>Time-data refresh</strong> on and its daily automation created, CameraAgent downloads a newer pair at most once a day, checks the providers' checksums and parses it before adopting it; without an override, planning uses the verified pair that covers the planned time and covers planning latest (the bundled pair on a tie), so a refreshed pair that cannot evaluate the rest of the day it was retrieved never replaces one that can.</p>
            <dl class="ops-facts">
                <div class="full"><dt>Active source</dt><dd>@(view.ActiveSource ?? "Not resolved")</dd></div>
                @foreach (var file in view.Files)
                {
                    <div class="full"><dt>@file.Title</dt><dd>@file.Status<small>Path: @(file.Path ?? "Not configured")</small><small>SHA-256: @(file.Sha256 ?? "Not configured")</small>@if (file.Origin is { } origin) { <small>Provenance: @origin</small> }</dd></div>
                }
                <div class="full"><dt>Earth-orientation coverage</dt><dd>@Interval(view.EarthOrientationCoverage)</dd></div>
                <div class="full"><dt>Final (Bulletin B)</dt><dd>@Interval(view.FinalCoverage)</dd></div>
                <div class="full"><dt>Predicted (Bulletin A)</dt><dd>@Interval(view.PredictedCoverage)<small>Rapid observed-only days between the final and predicted spans are not used.</small></dd></div>
                <div class="full"><dt>Checked window</dt><dd>@Window(view.WindowEarthOrientation)</dd></div>
                <div class="full"><dt>Leap-second expiry (exclusive)</dt><dd>@(view.LeapSecondsExpireUtc?.ToString("O") ?? "Not resolved")</dd></div>
            </dl>
            @if (view.TimeData is { } status)
            {
                <dl id="time-data-refresh" class="ops-facts" data-refresh-outcome="@status.Refresh.Outcome" data-expired="@(status.Expired ? "true" : "false")" data-covers-now="@(status.CoversNow ? "true" : "false")">
                    <div class="full"><dt>Planning coverage</dt><dd>@Coverage(status)</dd></div>
                    <div class="full"><dt>Time-data refresh</dt><dd>@(status.RefreshEnabled ? "On" : "Off")@if (!status.RefreshScheduled) { <small>The daily automation is not set up. <a href="/operations/automations?setup=time-data">Create the time-data refresh automation</a>.</small> }</dd></div>
                    <div class="full"><dt>Last refresh attempt</dt><dd>@Attempt(status.Refresh)@if (status.Refresh.Detail is { Length: > 0 } detail) { <small>@detail</small> }@if (status.Refresh.NextPermittedAttemptUtc is { } next) { <small>Next permitted attempt: @next.ToString("O")</small> }</dd></div>
                    <div class="full"><dt>Last successful adoption</dt><dd>@Adoption(status.ManagedPair)</dd></div>
                </dl>
            }
            <p><a href="https://github.com/HualapaiValley/HVO.SkyMonitor/blob/development/v1/docs/astronomy/satellite-planning-v1.md#enable-local-planning">Time-data setup instructions</a>. Capture-time predicted tracks remain unavailable pending #529/#1393; astrometry remains unavailable pending #526/#1187/#523.</p>
        </details>
        @if (_message is not null) { <p role="status">@_message</p> }
        <button type="button" class="button secondary small" disabled="@_busy" @onclick="LoadAsync">Reload setup status</button>
    </section>
}
else if (_message is not null)
{
    <p role="status">@_message</p>
}
