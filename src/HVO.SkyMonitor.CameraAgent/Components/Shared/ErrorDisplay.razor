<div class="error-display" role="alert">
    <div class="error-display__icon">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
    </div>
    <div class="error-display__content">
        <h2 class="error-display__title">We hit a snag</h2>
        <p class="error-display__message">
            Something went wrong while rendering this page. Try reloading the view or return to the dashboard.
        </p>
        @if (!string.IsNullOrWhiteSpace(CorrelationId))
        {
            <p class="error-display__correlation text-muted">
                <span class="error-display__correlation-label">Correlation ID:</span>
                <code>@CorrelationId</code>
            </p>
        }
        <div class="error-display__actions">
            <button type="button" class="btn btn-primary" @onclick="Reload">Reload page</button>
            <button type="button" class="btn btn-outline-light" @onclick="OnDismissClicked">Dismiss</button>
        </div>
    </div>
</div>