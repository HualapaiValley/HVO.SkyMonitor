<!DOCTYPE html>
<html lang="en" data-theme="hvo-dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#05070d" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/themes/hvo-dark.css" />
    <link rel="stylesheet" href="@Assets["HVO.SkyMonitor.CameraAgent.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body data-theme="hvo-dark">
    <CascadingAuthenticationState>
        <AppErrorBoundary @ref="_appErrorBoundary">
            <ChildContent>
                <Routes @rendermode="PageRenderMode" />
            </ChildContent>
            <ErrorContent>
                <ErrorDisplay OnDismiss="RecoverFromError" />
            </ErrorContent>
        </AppErrorBoundary>
    </CascadingAuthenticationState>
    <ReconnectModal />

    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
