{
    "agentId": "replace-with-registered-device-id",
    "module": {
        "type": "VirtualSky",
        "options": {
            "seed": 2025,
            "maximumMagnitude": 6.5,
            "maximumResults": 2000,
            "magnitudeZeroElectronsPerSecond": 300.0,
            "bortleClass": 3,
            "asi174Sensor": {
                "enabled": true,
                "blackLevelAdu": 64.0
            },
            "constellationIds": ["ORI", "UMA", "UMI", "CAS", "CYG", "LYR"],
            "solarSystemBodies": ["Sun", "Moon", "Mercury", "Venus", "Mars", "Jupiter", "Saturn", "Uranus", "Neptune"]
        }
    },
    "rig": {
        "sensor": {
            "name": "VirtualAsi174MmReduced",
            "widthPixels": 484,
            "heightPixels": 304,
            "pixelSizeMicrons": 5.86,
            "colorMode": "Mono",
            "pixelFormat": "Mono16",
            "responseMode": "Monochrome",
            "strideBytes": 968,
            "byteOrder": "LittleEndian",
            "sensorRecipeVersion": "virtual-asi174mm-electron-domain-v2"
        },
        "optics": {
            "projectionModel": "EquidistantFisheye",
            "focalLengthMillimeters": 0.0,
            "fieldOfViewDegrees": 180.0,
            "rollDegrees": 0.0,
            "lensKind": "Fisheye",
            "principalPointX": 242.0,
            "principalPointY": 152.0,
            "imageCircleRadiusPixels": 148.96,
            "horizontalFlip": false,
            "calibrationVersion": "virtual-fisheye-180-equidistant-v1"
        },
        "orientation": {
            "boresightAltitudeDegrees": 90.0,
            "boresightAzimuthDegrees": 0.0,
            "rollAdjustmentDegrees": 0.0
        },
        "pipeline": {
            "captureInterval": "00:00:25",
            "dayExposure": "00:00:00.2500000",
            "nightExposure": "00:00:20",
            "dayGain": 0.0,
            "nightGain": 150.0,
            "envelope": {
                "minExposure": "00:00:00.0500000",
                "maxExposure": "00:00:30",
                "minGain": 0.0,
                "maxGain": 400.0,
                "dayDefaults": {
                    "exposure": "00:00:00.2500000",
                    "gain": 0.0
                },
                "nightDefaults": {
                    "exposure": "00:00:20",
                    "gain": 150.0
                },
                "targetAduLevel": 0.65
            }
        },
        "controlPolicy": {
            "temperature": {
                "mode": "Target",
                "targetC": -5.0
            },
            "autoGain": "Disabled",
            "autoExposure": "Disabled"
        }
    },
    "processingSteps": [
        {
            "id": "RollingCombination",
            "type": "RollingCombination",
            "order": 25,
            "options": {
                "enabled": true,
                "windowSize": 5
            }
        },
        {
            "id": "Preview",
            "type": "Preview",
            "order": 50,
            "options": {
                "enabled": true,
                "recipeVersion": "mono16-asinh-v2",
                "blackPercentile": 0.5,
                "whitePercentile": 0.9999,
                "asinhStrength": 4.0
            }
        },
        {
            "id": "Annotation",
            "type": "Annotation",
            "order": 75,
            "options": {
                "enabled": true,
                "markRadius": 6,
                "markerValue": 144,
                "drawLabels": true,
                "maximumLabelMagnitude": 2.5,
                "labelScale": 2,
                "drawConstellationLines": true,
                "drawImageCircle": true,
                "drawCardinalDirections": true,
                "imageCircleValue": 96,
                "cardinalValue": 255,
                "cardinalScale": 2,
                "recipeVersion": "named-object-compass-annotation-v3"
            }
        },
        {
            "id": "Calibration",
            "type": "HVO.SkyMonitor.CameraAgent.Common.Capture.Processing.CalibrationCaptureProcessingStep, HVO.SkyMonitor.CameraAgent.Common",
            "order": -1000,
            "options": {
                "enabled": true,
                "calibrationPasses": 2,
                "maxCalibrationSeconds": 30,
                "strategy": "NightlyBias"
            }
        },
        {
            "id": "LocalStorage",
            "type": "HVO.SkyMonitor.CameraAgent.Common.Capture.Processing.NoOpFileStorageProcessingStep, HVO.SkyMonitor.CameraAgent.Common",
            "order": 100,
            "options": {
                "storageRoot": "/workspaces/HVO.SkyMonitor/data/agent",
                "retentionDays": 7,
                "updateLatestFrame": true,
                "queueForUpload": true
            }
        },
        {
            "id": "ArchiveStorage",
            "type": "HVO.SkyMonitor.CameraAgent.Common.Capture.Processing.NoOpFileStorageProcessingStep, HVO.SkyMonitor.CameraAgent.Common",
            "order": 110,
            "options": {
                "storageRoot": "/workspaces/HVO.SkyMonitor/data/archive",
                "retentionDays": 30,
                "updateLatestFrame": false,
                "queueForUpload": false
            }
        },
        {
            "id": "Upload",
            "type": "HVO.SkyMonitor.CameraAgent.Common.Capture.Processing.NoOpUploadProcessingStep, HVO.SkyMonitor.CameraAgent.Common",
            "order": 500,
            "options": {
                "enabled": true,
                "uploadAllFrames": false,
                "batchSize": 3,
                "warmupSeconds": 5,
                "endpoint": "https://example.invalid/api/upload"
            }
        },
        {
            "id": "Telemetry",
            "type": "HVO.SkyMonitor.CameraAgent.Common.Capture.Processing.TelemetryCaptureProcessingStep, HVO.SkyMonitor.CameraAgent.Common",
            "order": 1000
        }
    ]
}
