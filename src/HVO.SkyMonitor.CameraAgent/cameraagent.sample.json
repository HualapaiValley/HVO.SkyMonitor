{
    "module": {
        "type": "VirtualSky",
        "options": {
            "seed": 2025,
            "starCount": 32
        }
    },
    "rig": {
        "sensor": {
            "name": "VirtualAsi174MmReduced",
            "widthPixels": 640,
            "heightPixels": 480,
            "pixelSizeMicrons": 5.86,
            "colorMode": "Mono",
            "pixelFormat": "Mono16"
        },
        "optics": {
            "projectionModel": "EquidistantFisheye",
            "focalLengthMillimeters": 3.0,
            "fieldOfViewDegrees": 180.0,
            "rollDegrees": 0.0
        },
        "orientation": {
            "boresightAltitudeDegrees": 90.0,
            "boresightAzimuthDegrees": 0.0,
            "rollAdjustmentDegrees": 0.0
        },
        "pipeline": {
            "captureInterval": "00:00:05",
            "dayExposure": "00:00:00.2500000",
            "nightExposure": "00:00:02.5000000",
            "dayGain": 1.0,
            "nightGain": 150.0,
            "envelope": {
                "minExposure": "00:00:00.0500000",
                "maxExposure": "00:00:15",
                "minGain": 1.0,
                "maxGain": 400.0,
                "dayDefaults": {
                    "exposure": "00:00:00.2500000",
                    "gain": 2.5
                },
                "nightDefaults": {
                    "exposure": "00:00:02.5000000",
                    "gain": 150.0
                },
                "targetAduLevel": 0.65
            }
        },
        "controlPolicy": {
            "temperature": {
                "mode": "Target",
                "targetC": -5.0
            },
            "autoGain": "Disabled",
            "autoExposure": "Disabled"
        }
    },
    "processingSteps": [
        {
            "id": "RollingCombination",
            "type": "RollingCombination",
            "order": 25,
            "options": {
                "enabled": true,
                "windowSize": 5
            }
        },
        {
            "id": "Preview",
            "type": "Preview",
            "order": 50,
            "options": {
                "enabled": true,
                "recipeVersion": "mono16-high-byte-v1"
            }
        },
        {
            "id": "Annotation",
            "type": "Annotation",
            "order": 75,
            "options": {
                "enabled": true,
                "focalLengthPixels": 500,
                "recipeVersion": "zenith-marker-v1"
            }
        },
        {
            "id": "Calibration",
            "type": "HVO.SkyMonitor.CameraAgent.Common.Capture.Processing.CalibrationCaptureProcessingStep, HVO.SkyMonitor.CameraAgent.Common",
            "order": -1000,
            "options": {
                "enabled": true,
                "calibrationPasses": 2,
                "maxCalibrationSeconds": 30,
                "strategy": "NightlyBias"
            }
        },
        {
            "id": "LocalStorage",
            "type": "HVO.SkyMonitor.CameraAgent.Common.Capture.Processing.NoOpFileStorageProcessingStep, HVO.SkyMonitor.CameraAgent.Common",
            "order": 100,
            "options": {
                "storageRoot": "/workspaces/HVO.SkyMonitor/data/agent",
                "retentionDays": 7,
                "updateLatestFrame": true
            }
        },
        {
            "id": "ArchiveStorage",
            "type": "HVO.SkyMonitor.CameraAgent.Common.Capture.Processing.NoOpFileStorageProcessingStep, HVO.SkyMonitor.CameraAgent.Common",
            "order": 110,
            "options": {
                "storageRoot": "/workspaces/HVO.SkyMonitor/data/archive",
                "retentionDays": 30,
                "updateLatestFrame": false
            }
        },
        {
            "id": "Upload",
            "type": "HVO.SkyMonitor.CameraAgent.Common.Capture.Processing.NoOpUploadProcessingStep, HVO.SkyMonitor.CameraAgent.Common",
            "order": 500,
            "options": {
                "enabled": true,
                "uploadAllFrames": false,
                "batchSize": 3,
                "warmupSeconds": 5,
                "endpoint": "https://example.invalid/api/upload"
            }
        },
        {
            "id": "Telemetry",
            "type": "HVO.SkyMonitor.CameraAgent.Common.Capture.Processing.TelemetryCaptureProcessingStep, HVO.SkyMonitor.CameraAgent.Common",
            "order": 1000
        }
    ]
}
