<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>HVO.SkyMonitor.Deployment.Cli</AssemblyName>
    <RootNamespace>HVO.SkyMonitor.Deployment</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <!--
      A release ships the installer as one file, hvo-sky-install-<rid> (install contract section 4), so the native SQLite
      library that catalog validation opens is bundled into it, and the .NET host extracts it when the installer starts,
      instead of the publish leaving it beside the executable.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <!--
    The installer's build identity (install contract section 1, #1312): its informational version is
    <version>+<40-character commit>, which the installer's version option prints. The version is the product version
    (Directory.Build.props, #1310): a release publish is given the release's as -p:Version, and a build given none is
    the development build, X.Y.Z-dev. The SDK appends the commit it reads from the checkout, or the -p:SourceRevisionId
    a build without one is given.
  -->
  <Target Name="HvoInstallerBuildIdentity"
          AfterTargets="InitializeSourceControlInformation"
          BeforeTargets="AddSourceRevisionToInformationalVersion">
    <!-- A build with neither a checkout nor a supplied commit says so rather than printing a bare version. -->
    <PropertyGroup Condition="'$(SourceRevisionId)' == ''">
      <SourceRevisionId>unknown</SourceRevisionId>
    </PropertyGroup>
    <!--
      The release tool's safe identifier, so the stamp is always exactly <version>+<commit>. \A and \z anchor the whole
      value: $ would also match before a final line feed.
    -->
    <Error Code="HVO1312"
           Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(InformationalVersion)', '\A[A-Za-z0-9]([A-Za-z0-9.-]{0,126}[A-Za-z0-9])?\z')) or $(InformationalVersion.Contains('..'))"
           Text="The installer version '$(InformationalVersion)' must be 1-128 ASCII letters, digits, periods and hyphens, start and end with a letter or digit, and contain no '..'." />
    <Error Code="HVO1312"
           Condition="'$(SourceRevisionId)' != 'unknown' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(SourceRevisionId)', '\A[0-9a-f]{40}\z'))"
           Text="The installer source revision '$(SourceRevisionId)' must be a 40-character lowercase commit ID or 'unknown'." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\HVO.SkyMonitor.AgentCore\HVO.SkyMonitor.AgentCore.csproj" />
    <ProjectReference Include="..\HVO.SkyMonitor.Catalog.Sqlite\HVO.SkyMonitor.Catalog.Sqlite.csproj" />
    <ProjectReference Include="..\HVO.SkyMonitor.Deployment.Contracts\HVO.SkyMonitor.Deployment.Contracts.csproj" />
    <ProjectReference Include="..\HVO.SkyMonitor.TerminalUi\HVO.SkyMonitor.TerminalUi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- CameraAgent owns how an owner password file is read; the installer compiles the same reader so it validates,
         authenticates with, and classifies exactly the password CameraAgent seeds (#1278). -->
    <Compile Include="..\HVO.SkyMonitor.CameraAgent\Configuration\OwnerPasswordFileText.cs" Link="Shared/OwnerPasswordFileText.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="SplitHost/*.jq" />
    <InternalsVisibleTo Include="HVO.SkyMonitor.Deployment.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../scripts/deploy/teardown-context.sh" LogicalName="HVO.SkyMonitor.Deployment.SplitHost.TeardownContext.sh" />
  </ItemGroup>
</Project>
