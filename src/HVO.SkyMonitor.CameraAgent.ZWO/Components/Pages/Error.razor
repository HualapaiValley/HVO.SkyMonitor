@page "/Error"
@layout MainLayout

<PageTitle>Something went wrong</PageTitle>

<section class="error-page" aria-labelledby="error-page-title">
    <div class="error-page__icon" aria-hidden="true">
        <i class="bi bi-exclamation-triangle-fill"></i>
    </div>
    <div class="error-page__content">
        <h1 id="error-page-title" class="error-page__title">We hit a snag</h1>
        <p class="error-page__description">
            An unexpected error occurred while processing your request. Try refreshing the page, or return to the
            dashboard.
        </p>

        <div class="error-page__meta">
            @if (ShowCorrelationId)
            {
                <p>
                    <span class="error-page__meta-label">Correlation ID:</span>
                    <code>@CorrelationId</code>
                </p>
            }
            @if (ShowRequestId)
            {
                <p>
                    <span class="error-page__meta-label">Request ID:</span>
                    <code>@RequestId</code>
                </p>
            }
        </div>

        <div class="error-page__actions">
            <button type="button" class="btn btn-primary" @onclick="Reload">Reload page</button>
            <a class="btn btn-outline-light" href="/">Return home</a>
        </div>
    </div>
</section>