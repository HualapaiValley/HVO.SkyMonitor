#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

# Deterministic gate for scripts/lib/trx-evidence.sh.
#
# Every case states the fixture, the expected exit status and a substring the output must
# contain. The substring matters as much as the status: a check that refuses for the wrong
# reason is a check that will accept for the wrong reason later, and an exit code alone cannot
# tell those apart.
#
# The fixture set varies the SERIALISATION as deliberately as the content. The defect this
# gate exists to prevent (#769) was not a wrong predicate — the predicate was right about
# every outcome value it was ever shown. It was a right predicate applied to one assumed
# layout, and a fixture set that varies only content proves the predicate and nothing about
# the parse.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly REPO_ROOT
readonly FIXTURES="$REPO_ROOT/tests/fixtures/trx-evidence"

# shellcheck source=lib/trx-evidence.sh
source "$SCRIPT_DIR/lib/trx-evidence.sh"

failures=0
cases=0

expect() {
    local fixture="$1" want_exit="$2" want_text="$3"
    cases=$((cases + 1))
    local out status
    set +e
    out="$(trx_assert_executed_and_passed "$FIXTURES/$fixture" 'gate' 2>&1)"
    status=$?
    set -e
    if [[ "$status" != "$want_exit" ]] || [[ "$out" != *"$want_text"* ]]; then
        failures=$((failures + 1))
        printf 'FAIL %s\n  expected exit=%s containing: %s\n  actual   exit=%s output:\n%s\n' \
            "$fixture" "$want_exit" "$want_text" "$status" "$out" >&2
    fi
}

# Some properties are about what the output must NOT contain -- a cap is only a cap if the
# ninth item is absent. A positive substring cannot express that.
expect_absent() {
    local fixture="$1" unwanted="$2"
    cases=$((cases + 1))
    local out
    set +e
    out="$(trx_assert_executed_and_passed "$FIXTURES/$fixture" 'gate' 2>&1)"
    set -e
    if [[ "$out" == *"$unwanted"* ]]; then
        failures=$((failures + 1))
        printf 'FAIL(absent) %s\n  output must not contain: %s\n  actual output:\n%s\n' \
            "$fixture" "$unwanted" "$out" >&2
    fi
}

# The counters assertion, stated the same way. Separate from expect() because it exercises a
# different function rather than a different fixture: the two assertions promise different
# things, and a gate that conflated them would let either one's regression hide behind the
# other's verdict.
expect_counters() {
    local fixture="$1" want_exit="$2" want_text="$3"
    cases=$((cases + 1))
    local out status
    set +e
    out="$(trx_assert_counters_executed_and_passed "$FIXTURES/$fixture" 'gate' 2>&1)"
    status=$?
    set -e
    if [[ "$status" != "$want_exit" ]] || [[ "$out" != *"$want_text"* ]]; then
        failures=$((failures + 1))
        printf 'FAIL(counters) %s\n  expected exit=%s containing: %s\n  actual   exit=%s output:\n%s\n' \
            "$fixture" "$want_exit" "$want_text" "$status" "$out" >&2
    fi
}

# The same two passing results in three serialisations. All three must be accepted AND must
# report two results: a line-based count reports one for the collapsed forms.
expect expanded-all-passed.trx    0 '2 results, every one Passed'
expect collapsed-all-passed.trx   0 '2 results, every one Passed'
expect single-line-document.trx   0 '2 results, every one Passed'
expect crlf-all-passed.trx        0 '2 results, every one Passed'

# The same mixed pair in both serialisations. The collapsed one is the fail-open this fixes:
# its line contains outcome="Passed", so a line-level invert reported that everything passed.
expect expanded-mixed.trx         1 'B: NotExecuted'
expect collapsed-mixed.trx        1 'B: NotExecuted'

# Console output that merely looks like markup is not markup: "<" is escaped as "&lt;" in XML
# character data, so an escaped element start-tag cannot match.
expect stdout-quotes-markup.trx   0 '2 results, every one Passed'

# CDATA is the exception to that rule — a raw "<" is legal inside it — so a CDATA-wrapped
# start-tag does match. The consequence is fail-closed, and this fixture pins that direction:
# a phantom non-Passed element refuses the run rather than admitting it.
expect cdata-phantom-result.trx   1 'ghost: NotExecuted'
# The other direction, and the reason the pair exists: a CDATA-wrapped Passed phantom cannot
# turn a refusal into an acceptance, because every real element is still tested — but it does
# inflate the reported count, and the count is the line a human reads. Two real results are
# reported as three. Pinned so the discrepancy is a known, documented cost rather than a
# surprise, and so that anyone who later makes the count authoritative has to face it.
expect cdata-phantom-passed.trx   0 '3 results, every one Passed'

# XML permits an unescaped ">" inside an attribute value, which truncates the match before
# outcome=. The truncated element is refused for being unreadable rather than skipped.
expect gt-in-attribute.trx        1 'unparseable result'

# A start-tag whose attributes wrap across lines is legal XML and is not supported: grep is
# line-oriented and the element name is not followed by a space on its own line, so the tag
# matches nothing at all. That reads as an empty selection, which refuses — the fixture pins
# the direction rather than the wording, because unsupported must never mean accepted.
expect wrapped-start-tag.trx      1 'recorded no results'

# A prefixed namespace is not what MSTest writes. Recorded as a limit rather than as support:
# it reads as an empty selection, which refuses.
expect prefixed-namespace.trx     1 'recorded no results'

# An element with no outcome attribute is refused. An element this cannot parse is not
# evidence that it passed.
expect no-outcome-attribute.trx   1 'unparseable result'

# Nothing selected, an empty file, and a file that is not there.
expect zero-results.trx           1 'recorded no results'
expect empty.trx                  1 'no results file was written'
expect does-not-exist.trx         1 'no results file was written'

# The case the whole family exists for: a skipped run reports ResultSummary outcome
# "Completed" and exits zero, and every counter a validator would naturally check is zero.
# Only the per-result outcome distinguishes it.
expect skipped-run.trx            1 'A: NotExecuted'
expect skipped-run.trx            1 'Reasons recorded by the tests themselves'

# The per-result dump is capped at eight so a trial recording thousands of NotExecuted results
# cannot bury the line naming the failure, and the uncapped total is printed beside it so the
# cap costs no information about scale. Twelve results, eight named, one total.
expect many-unpassed.trx          1 'T08: NotExecuted'
expect many-unpassed.trx          1 '12 results are not Passed'
# The ninth must NOT appear: this is what pins the cap itself rather than merely the count.
expect_absent many-unpassed.trx   'T09: NotExecuted'
# Singular, because "1 results" is the kind of wrong that survives forever once shipped.
expect_absent skipped-run.trx     'results are not Passed'
expect skipped-run.trx            1 '1 result is not Passed'

# COUNTERS (#803)
#
# This assertion used to live only in scripts/test:cameraagent-standalone-211, a runner no
# workflow invokes, so nothing would have noticed it drifting. The accepting direction is
# pinned as deliberately as the refusing one: a gate that only ever refuses proves no more than
# one that only ever accepts.
expect_counters expanded-all-passed.trx   0 'counters verified, executed=2 passed=2'
expect_counters collapsed-all-passed.trx  0 'counters verified, executed=2 passed=2'
expect_counters crlf-all-passed.trx       0 'counters verified, executed=2 passed=2'
expect_counters single-line-document.trx  0 'counters verified, executed=2 passed=2'

# The defect the element-anchored read fixed, in its own direction: a genuine pass whose StdOut
# quotes executed="0" must still be accepted. A line-based read refused it, which is a
# fail-closed defect in a guard whose whole purpose is to be trusted.
expect_counters counters-stdout-quotes-zero.trx 0 'counters verified, executed=1 passed=1'
# The OTHER direction of the same decision, and the one that actually pins the parse. The pair
# above sits on separate lines, so a whole-line read still sees only the real element and stays
# green -- which means it cannot detect a line-based regression at all. Here the quoted text
# shares its line with a zero-executed Counters, exactly as a collapsed TRX serialises it, so a
# line read reports executed=3 passed=3 and ACCEPTS a skipped run. Element-anchored refuses.
expect_counters counters-collapsed-stdout-quotes.trx 1 'executed=0 passed=0'

# The skipped run the whole family exists for, read through the totals rather than the outcomes.
expect_counters skipped-run.trx           1 'executed=0'
expect_counters counters-not-executed.trx 1 'executed=0'

# Executed but not all passing, and the missing-attribute case. Absent is refused rather than
# read as zero: an unreadable total is not evidence of a pass.
expect_counters counters-passed-below-executed.trx  1 'executed=2 passed=1'
expect_counters counters-missing-passed-attribute.trx 1 'passed=<absent>'
expect_counters counters-absent.trx       1 'exactly one Counters element'

# Limit 1 at the top of the library, pinned. This assertion reads a singleton, so a CDATA-quoted
# phantom would change WHICH value is read rather than merely inflating an advisory count. The
# real Counters here says executed=1 passed=1; the phantom says zero. Refusing the ambiguous
# file is the only safe reading, and this is the fixture that stops anyone relaxing the
# exactly-one requirement as defensive tidiness.
expect_counters cdata-phantom-counters.trx 1 'exactly one Counters element'

# The phantom alone. Exactly-one is satisfied by a quoted tag when the real element is absent,
# so the count cannot see this: the phantom is not competing with a real reading, it IS the
# reading. Without the CDATA-stripped cross-check this file is accepted as executed=7 passed=7
# by a run whose ResultSummary records no totals whatsoever.
expect_counters counters-phantom-only.trx 1 'quoted inside CDATA'

# Bash reads a leading-zero operand as octal and ABORTS the arithmetic on an invalid digit.
# Inside an `if` condition that abort is a false result, so an unvalidated executed="008" fell
# through to acceptance. Values past 2^64 wrap instead. Both are refused before any arithmetic.
expect_counters counters-leading-zero.trx 1 'not readable as plain decimal totals'
expect_counters counters-overflow.trx     1 'not readable as plain decimal totals'

# Nothing to read at all.
expect_counters empty.trx                 1 'no results file was written'
expect_counters does-not-exist.trx        1 'no results file was written'

if ((failures > 0)); then
    printf '%s of %s TRX evidence contract cases failed.\n' "$failures" "$cases" >&2
    exit 1
fi
printf 'All %s TRX evidence contract cases passed.\n' "$cases"
