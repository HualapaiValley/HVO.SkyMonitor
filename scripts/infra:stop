#!/usr/bin/env bash
# infra:stop - Stop infrastructure and application services
# Usage: ./scripts/infra:stop [--clear-cache [SERVICE...]] [SERVICE...]
# Examples:
#   ./scripts/infra:stop                       # Stop all services
#   ./scripts/infra:stop postgres redis        # Stop specific services
#   ./scripts/infra:stop --clear-cache redis   # Stop redis and wipe its cache volume
#   ./scripts/infra:stop --clear-cache all     # Stop everything and clear caches

set -euo pipefail

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [[ -f .env ]]; then
    set -a
    source .env
    set +a
fi

readonly INFRA_SERVICES=(postgres minio redis smtp)
readonly APP_SERVICES=(logichost cameraagent)
readonly ALL_SERVICES=("${INFRA_SERVICES[@]}" "${APP_SERVICES[@]}")

STOP_SERVICES=()
CLEAR_CACHE=false
CACHE_TARGETS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --clear-cache)
            CLEAR_CACHE=true
            shift
            temp_targets=()
            while [[ $# -gt 0 ]] && [[ ! $1 =~ ^-- ]]; do
                if [[ "$1" == "all" ]]; then
                    temp_targets=("${ALL_SERVICES[@]}")
                else
                    temp_targets+=("$1")
                fi
                shift
            done
            if [[ ${#temp_targets[@]} -gt 0 ]]; then
                CACHE_TARGETS+=("${temp_targets[@]}")
            fi
            ;;
        *)
            if [[ "$1" == "all" ]]; then
                STOP_SERVICES=("${ALL_SERVICES[@]}")
            else
                STOP_SERVICES+=("$1")
            fi
            shift
            ;;
    esac
done

if [[ ${#STOP_SERVICES[@]} -eq 0 ]]; then
    STOP_SERVICES=("${ALL_SERVICES[@]}")
fi

if [[ "$CLEAR_CACHE" == true ]] && [[ ${#CACHE_TARGETS[@]} -eq 0 ]]; then
    CACHE_TARGETS=("${STOP_SERVICES[@]}")
fi

contains_service() {
    local needle="$1"
    shift || true
    for candidate in "$@"; do
        if [[ "$candidate" == "$needle" ]]; then
            return 0
        fi
    done
    return 1
}

get_docker_context() {
    local service="$1"
    case "$service" in
        postgres) echo "${POSTGRES_DOCKER_CONTEXT:-default}" ;;
        minio) echo "${MINIO_DOCKER_CONTEXT:-default}" ;;
        redis) echo "${REDIS_DOCKER_CONTEXT:-default}" ;;
        smtp) echo "${SMTP_DOCKER_CONTEXT:-default}" ;;
        logichost) echo "${LOGICHOST_DOCKER_CONTEXT:-default}" ;;
        cameraagent) echo "${CAMERAAGENT_DOCKER_CONTEXT:-default}" ;;
        *) echo "default" ;;
    esac
}

get_compose_file() {
    local service="$1"
    case "$service" in
        postgres|minio|redis|smtp) echo "docker-compose.infrastructure.yml" ;;
        logichost|cameraagent) echo "docker-compose.apps.yml" ;;
        *) echo "docker-compose.apps.yml" ;;
    esac
}

get_service_host_var() {
    local service="$1"
    case "$service" in
        postgres) echo "POSTGRES_HOST" ;;
        minio) echo "MINIO_HOST" ;;
        redis) echo "REDIS_HOST" ;;
        smtp) echo "SMTP_HOST" ;;
        *) echo "" ;;
    esac
}

get_service_data_dir_var() {
    local service="$1"
    case "$service" in
        postgres) echo "POSTGRES_DATA_DIR" ;;
        minio) echo "MINIO_DATA_DIR" ;;
        redis) echo "REDIS_DATA_DIR" ;;
        *) echo "" ;;
    esac
}

get_service_data_dir_default() {
    local service="$1"
    case "$service" in
        postgres) echo "./data/postgres" ;;
        minio) echo "./data/minio" ;;
        redis) echo "./data/redis" ;;
        *) echo "" ;;
    esac
}

resolve_data_dir_path() {
    local raw_path="$1"
    if [[ -z "$raw_path" ]]; then
        printf '%s' ""
        return
    fi

    case "$raw_path" in
        ~)
            printf '%s' "$HOME"
            return
            ;;
        ~/*)
            printf '%s' "$HOME/${raw_path#~/}"
            return
            ;;
        /*)
            printf '%s' "$raw_path"
            return
            ;;
    esac

    local trimmed="$raw_path"
    trimmed="${trimmed#./}"
    printf '%s' "$REPO_ROOT/$trimmed"
}

get_resolved_data_dir() {
    local service="$1"
    local dir_var
    dir_var="$(get_service_data_dir_var "$service")"
    if [[ -z "$dir_var" ]]; then
        printf '%s' ""
        return
    fi

    local configured_path
    configured_path="${!dir_var:-}"
    if [[ -z "$configured_path" ]]; then
        configured_path="$(get_service_data_dir_default "$service")"
    fi

    if [[ -z "$configured_path" ]]; then
        printf '%s' ""
        return
    fi

    resolve_data_dir_path "$configured_path"
}

ensure_local_data_dir() {
    local service="$1"
    local context="$2"

    if [[ "$context" != "default" ]]; then
        return
    fi

    local resolved
    resolved="$(get_resolved_data_dir "$service")"
    if [[ -z "$resolved" ]]; then
        return
    fi

    if [[ ! -d "$resolved" ]]; then
        mkdir -p "$resolved"
        echo -e "${GREEN}Created data directory for ${service}: ${resolved}${NC}"
    fi
}

ensure_remote_host_binding() {
    local service="$1"
    local context="$2"
    local host_var
    host_var="$(get_service_host_var "$service")"

    if [[ -z "$host_var" ]] || [[ "$context" == "default" ]]; then
        return
    fi

    local host_value="${!host_var:-}"
    if [[ -z "$host_value" ]]; then
        echo -e "${RED}Service '$service' uses docker context '$context' but ${host_var} is not set.${NC}"
        echo -e "${YELLOW}Set ${host_var} to the remote IP/hostname before continuing.${NC}"
        exit 1
    fi

    case "$host_value" in
        localhost|127.0.0.1|0.0.0.0)
            echo -e "${RED}${host_var}=${host_value} cannot reach remote context '$context'.${NC}"
            echo -e "${YELLOW}Update ${host_var} to the remote host address (e.g., 192.168.2.104) and retry.${NC}"
            exit 1
            ;;
    esac
}

stop_service() {
    local service="$1"
    local context
    context="$(get_docker_context "$service")"
    local compose_file
    compose_file="$(get_compose_file "$service")"

    ensure_remote_host_binding "$service" "$context"

    echo -e "${BLUE}Stopping ${service}...${NC}"
    if docker --context "$context" compose -f "$compose_file" ps "$service" >/dev/null 2>&1; then
        docker --context "$context" compose -f "$compose_file" stop "$service" >/dev/null 2>&1 || true
        echo -e "${GREEN}✓ Stopped $service${NC}"
    else
        echo -e "${YELLOW}⚠ $service container not found${NC}"
    fi
}

clear_cache_for_service() {
    local service="$1"
    local context
    context="$(get_docker_context "$service")"
    local compose_file
    compose_file="$(get_compose_file "$service")"

    ensure_remote_host_binding "$service" "$context"

    echo -e "${BLUE}Clearing cache for ${service}...${NC}"
    case "$service" in
        postgres|minio|redis)
            docker --context "$context" compose -f "$compose_file" rm -f "$service" >/dev/null 2>&1 || true
            local volume_name="skymonitor-${service}-data"
            if docker --context "$context" volume ls --format '{{.Name}}' | grep -q "^${volume_name}$"; then
                docker --context "$context" volume rm "$volume_name" >/dev/null 2>&1 || true
                echo -e "${GREEN}✓ Removed volume ${volume_name}${NC}"
            else
                echo -e "${YELLOW}ℹ Volume ${volume_name} not found${NC}"
            fi
            local resolved_dir
            resolved_dir="$(get_resolved_data_dir "$service")"
            if [[ -n "$resolved_dir" ]] && [[ -d "$resolved_dir" ]]; then
                rm -rf "$resolved_dir"
                echo -e "${GREEN}✓ Cleared ${resolved_dir}${NC}"
            fi
            ensure_local_data_dir "$service" "$context"
            ;;
        smtp)
            docker --context "$context" compose -f "$compose_file" rm -f "$service" >/dev/null 2>&1 || true
            ;;
        logichost|cameraagent)
            docker --context "$context" compose -f "$compose_file" rm -f "$service" >/dev/null 2>&1 || true
            ;;
        *)
            echo -e "${RED}Unknown service: $service${NC}"
            return 1
            ;;
    esac
}

echo -e "${BLUE}=== Stopping Services ===${NC}"
for service in "${STOP_SERVICES[@]}"; do
    stop_service "$service"
    if [[ "$CLEAR_CACHE" == true ]] && contains_service "$service" "${CACHE_TARGETS[@]}"; then
        clear_cache_for_service "$service"
    fi
    echo ""
done

echo -e "${GREEN}All requested services processed.${NC}"
if [[ "$CLEAR_CACHE" == true ]]; then
    echo -e "${GREEN}Cache clearing completed where requested.${NC}"
fi

echo "Use './scripts/infra:start' to bring services back online."

