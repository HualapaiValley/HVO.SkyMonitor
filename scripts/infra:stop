#!/usr/bin/env bash
# infra:stop - Stop local application containers without affecting shared services.
# Usage: ./scripts/infra:stop [logichost|cameraagent|all]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

services=("$@")
[[ ${#services[@]} -gt 0 ]] || services=(logichost cameraagent)
[[ " ${services[*]} " == *" all "* ]] && services=(logichost cameraagent)

for service in "${services[@]}"; do
    [[ "$service" == "logichost" || "$service" == "cameraagent" ]] || {
        echo "Unknown application service: $service" >&2
        exit 1
    }
done

docker compose -f docker-compose.apps.yml stop "${services[@]}"
