#!/usr/bin/env bash
# infra:stop - Stop infrastructure and application services
# Usage: ./scripts/infra:stop [--clear-cache [SERVICE...]] [SERVICE...]

set -euo pipefail

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [[ -f .env ]]; then
    set -a
    source .env
    set +a
fi

readonly INFRA_SERVICES=(postgres minio redis smtp)
readonly APP_SERVICES=(logichost cameraagent)
readonly ALL_SERVICES=("${INFRA_SERVICES[@]}" "${APP_SERVICES[@]}")

clean_cameraagent_data() {
    mkdir -p data/cameraagent/identity data/cameraagent/dataprotection
    rm -f data/cameraagent/identity/* 2>/dev/null || true
    rm -f data/cameraagent/dataprotection/* 2>/dev/null || true
}

get_compose_file() {
    local service="$1"
    case "$service" in
        postgres|minio|redis|smtp) echo "docker-compose.infrastructure.yml" ;;
        logichost|cameraagent) echo "docker-compose.apps.yml" ;;
        *) echo "docker-compose.infrastructure.yml" ;;
    esac
}

STOP_SERVICES=()
CLEAR_CACHE=false
CACHE_TARGETS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --clear-cache)
            CLEAR_CACHE=true
            shift
            temp_targets=()
            while [[ $# -gt 0 ]] && [[ ! $1 =~ ^-- ]]; do
                if [[ "$1" == "all" ]]; then
                    temp_targets=("${ALL_SERVICES[@]}")
                else
                    temp_targets+=("$1")
                fi
                shift
            done
            if [[ ${#temp_targets[@]} -gt 0 ]]; then
                CACHE_TARGETS+=("${temp_targets[@]}")
            fi
            ;;
        *)
            if [[ "$1" == "all" ]]; then
                STOP_SERVICES=("${ALL_SERVICES[@]}")
            else
                STOP_SERVICES+=("$1")
            fi
            shift
            ;;
    esac
done

if [[ ${#STOP_SERVICES[@]} -eq 0 ]]; then
    STOP_SERVICES=("${ALL_SERVICES[@]}")
fi

if [[ "$CLEAR_CACHE" == true ]] && [[ ${#CACHE_TARGETS[@]} -eq 0 ]]; then
    CACHE_TARGETS=("${STOP_SERVICES[@]}")
fi

contains_service() {
    local needle="$1"
    shift || true
    for candidate in "$@"; do
        if [[ "$candidate" == "$needle" ]]; then
            return 0
        fi
    done
    return 1
}

stop_service() {
    local service="$1"
    local compose_file="$(get_compose_file "$service")"
    echo -e "${BLUE}Stopping ${service}...${NC}"
    if docker compose -f "$compose_file" ps "$service" >/dev/null 2>&1; then
        docker compose -f "$compose_file" stop "$service" >/dev/null 2>&1 || true
        echo -e "${GREEN}✓ Stopped $service${NC}"
    else
        echo -e "${YELLOW}⚠ $service container not found${NC}"
    fi
}

clear_cache_for_service() {
    local service="$1"
    local compose_file="$(get_compose_file "$service")"

    echo -e "${BLUE}Clearing cache for ${service}...${NC}"
    case "$service" in
        postgres|minio|redis)
            docker compose -f "$compose_file" rm -f "$service" >/dev/null 2>&1 || true
            local volume_name="skymonitor-${service}-data"
            if docker volume ls --format '{{.Name}}' | grep -q "^${volume_name}$"; then
                docker volume rm "$volume_name" >/dev/null 2>&1 || true
                echo -e "${GREEN}✓ Removed volume ${volume_name}${NC}"
            else
                echo -e "${YELLOW}ℹ Volume ${volume_name} not found${NC}"
            fi
            local cache_dir="data/${service}"
            if [[ -d "$cache_dir" ]]; then
                rm -rf "$cache_dir"
                echo -e "${GREEN}✓ Cleared ${cache_dir}${NC}"
            fi
            ;;
        smtp)
            docker compose -f "$compose_file" rm -f "$service" >/dev/null 2>&1 || true
            ;;
        logichost|cameraagent)
            docker compose -f "$compose_file" rm -f "$service" >/dev/null 2>&1 || true
            if [[ "$service" == "cameraagent" ]]; then
                clean_cameraagent_data
            fi
            ;;
        *)
            echo -e "${RED}Unknown service: $service${NC}"
            return 1
            ;;
    esac
}

echo -e "${BLUE}=== Stopping Services ===${NC}"
for service in "${STOP_SERVICES[@]}"; do
    stop_service "$service"
    if [[ "$CLEAR_CACHE" == true ]] && contains_service "$service" "${CACHE_TARGETS[@]}"; then
        clear_cache_for_service "$service"
    fi
    echo ""
done

echo -e "${GREEN}All requested services processed.${NC}"
if [[ "$CLEAR_CACHE" == true ]]; then
    echo -e "${GREEN}Cache clearing completed where requested.${NC}"
fi

echo "Use './scripts/infra:start' to bring services back online."

