#!/usr/bin/env bash
# Provision the bucket-scoped MinIO account used by SkyMonitor applications.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

set -a
source .env
set +a

docker --context hvo-docker cp deploy/hvo-docker/minio/skymonitor-policy.json skymonitor-minio:/tmp/skymonitor-policy.json
docker --context hvo-docker exec \
    -e MINIO_ACCESS_KEY \
    -e MINIO_SECRET_KEY \
    skymonitor-minio \
    sh -c 'mc alias set local http://localhost:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null && (mc admin user svcacct info local "$MINIO_ACCESS_KEY" >/dev/null 2>&1 || mc admin user svcacct add local "$MINIO_ROOT_USER" --access-key "$MINIO_ACCESS_KEY" --secret-key "$MINIO_SECRET_KEY" --policy /tmp/skymonitor-policy.json)'
