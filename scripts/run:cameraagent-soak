#!/usr/bin/env bash
# Run a real-duration CameraAgent container soak without making it a PR gate.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly REPO_ROOT
readonly DURATION="${1:-24h}"
readonly RESULTS_ROOT="$REPO_ROOT/TestResults/cameraagent-soak"
RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
readonly RUN_ID
readonly RUN_ROOT="$RESULTS_ROOT/$RUN_ID"
readonly CONTAINER_NAME="hvo-cameraagent-soak-$RUN_ID"
readonly IMAGE_NAME="hvo-cameraagent-soak:local"

if [[ ! "$DURATION" =~ ^[1-9][0-9]*(s|m|h)$ ]]; then
    echo "Duration must be a positive integer followed by s, m, or h." >&2
    exit 2
fi
duration_value="${DURATION%?}"
duration_unit="${DURATION: -1}"
case "$duration_unit" in
    s) duration_seconds="$duration_value" ;;
    m) duration_seconds="$((duration_value * 60))" ;;
    h) duration_seconds="$((duration_value * 3600))" ;;
esac
if (( duration_seconds > 86400 )); then
    echo "Duration cannot exceed 24 hours." >&2
    exit 2
fi

cleanup() {
    docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
    rm -rf "$RUN_ROOT/data"
}
trap cleanup EXIT

mkdir -p "$RUN_ROOT/data"
started_utc="$(date -u +%FT%TZ)"
docker build -t "$IMAGE_NAME" -f "$REPO_ROOT/src/HVO.SkyMonitor.CameraAgent/Dockerfile" "$REPO_ROOT"

set +e
timeout --signal=TERM --kill-after=30s "$DURATION" docker run --rm --name "$CONTAINER_NAME" \
    --network none \
    --mount "type=bind,src=$RUN_ROOT/data,dst=/workspaces/HVO.SkyMonitor/data" \
    -e ASPNETCORE_ENVIRONMENT=Development \
    "$IMAGE_NAME" >"$RUN_ROOT/cameraagent.log" 2>&1
status=$?
set -e

if [[ $status -ne 124 ]]; then
    echo "CameraAgent soak failed with exit code $status."
    [[ $status -eq 0 ]] && exit 1
    exit "$status"
fi

payload_files="$(find "$RUN_ROOT/data" -type f -name '*.bin' | wc -l)"
metadata_files="$(find "$RUN_ROOT/data" -type f -path '*/frames/*' -name '*.json' | wc -l)"
index_entries="$(find "$RUN_ROOT/data" -type f -name '*.jsonl' -exec cat {} + | wc -l)"
outbox_files="$(find "$RUN_ROOT/data" -type f -path '*/outbox/*' -name '*.json' | wc -l)"
temporary_files="$(find "$RUN_ROOT/data" -type f -name '*.tmp' | wc -l)"
storage_bytes="$(du -sb "$RUN_ROOT/data" | cut -f1)"
jq -n \
    --arg startedUtc "$started_utc" \
    --arg completedUtc "$(date -u +%FT%TZ)" \
    --arg duration "$DURATION" \
    --argjson payloadFiles "$payload_files" \
    --argjson metadataFiles "$metadata_files" \
    --argjson indexEntries "$index_entries" \
    --argjson outboxFiles "$outbox_files" \
    --argjson temporaryFiles "$temporary_files" \
    --argjson storageBytes "$storage_bytes" \
    '{startedUtc:$startedUtc,completedUtc:$completedUtc,requestedDuration:$duration,payloadFiles:$payloadFiles,metadataFiles:$metadataFiles,indexEntries:$indexEntries,outboxFiles:$outboxFiles,temporaryFiles:$temporaryFiles,storageBytes:$storageBytes}' \
    > "$RUN_ROOT/report.json"

jq -e '.payloadFiles > 0 and .payloadFiles == .metadataFiles and .payloadFiles == .indexEntries and .temporaryFiles == 0' \
    "$RUN_ROOT/report.json" >/dev/null
cleanup
trap - EXIT
echo "CameraAgent soak completed: $RUN_ROOT"
