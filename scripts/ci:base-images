#!/usr/bin/env python3
"""Check repository Dockerfile base images offline; no Docker or registry calls."""
import argparse
import json
import pathlib
import re
import shlex
import subprocess
import sys

VARIABLE = re.compile(r"\$(?:\{([A-Za-z_][A-Za-z_0-9]*)\}|([A-Za-z_][A-Za-z_0-9]*))")
PIN = re.compile(r"([^@\s]+)@sha256:([0-9a-f]{64})")
VERSION = re.compile(r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)")
SDK = "mcr.microsoft.com/dotnet/sdk"
INSTRUCTIONS = set("ADD ARG CMD COPY ENTRYPOINT ENV EXPOSE FROM HEALTHCHECK LABEL MAINTAINER ONBUILD RUN SHELL STOPSIGNAL USER VOLUME WORKDIR".split())


def discover_dockerfiles(root):
    """One inventory for the guard and its Dependabot coverage contract."""
    paths = subprocess.check_output(
        ["git", "-C", str(root), "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
        stderr=subprocess.PIPE,
    ).decode().split("\0")
    def matches(path):
        name = pathlib.PurePosixPath(path).name.lower()
        return not name.endswith(".dockerignore") and any(
            name == kind or name.startswith(kind + ".") or name.endswith("." + kind)
            for kind in ("dockerfile", "containerfile"))
    return sorted({p for p in paths if p and matches(p)})


def logical_lines(path):
    pending = ""
    start = 0
    # Decode the BOM before both parser-directive and instruction handling.
    for number, line in enumerate(path.read_bytes().decode("utf-8-sig").split("\n"), 1):
        # Normal CRLF line endings are supported; embedded CR and terminal controls
        # fail closed before splitting or shlex can reinterpret them.
        line = line.removesuffix("\r")
        if any(ord(c) < 32 and c != "\t" or 127 <= ord(c) <= 159 for c in line):
            raise ValueError(f"line {number}: control character in Dockerfile")
        if not line.strip() or line.lstrip().startswith("#"):
            if re.match(r"\s*#\s*escape\s*=\s*`", line, re.I):
                raise ValueError("unsupported Dockerfile escape directive")
            continue
        if not pending:
            start = number
        pending += line.strip()
        if pending.endswith("\\"):
            pending = pending[:-1] + " "
            continue
        yield start, pending
        pending = ""
    if pending:
        raise ValueError(f"line {start}: unfinished continuation")


def expand(value, arguments):
    def replace(match):
        name = match[1] or match[2]
        if name not in arguments or arguments[name] is None:
            raise ValueError(f"unresolved FROM argument: {ascii(name)}")
        return arguments[name]
    value = VARIABLE.sub(replace, value)
    if "$" in value:
        raise ValueError("unresolved FROM argument or unsupported expansion")
    return value


def normalize_reference(reference):
    """Normalize registry aliases without changing repository paths or tag case."""
    first, slash, rest = reference.partition("/")
    if slash and ("." in first or ":" in first or first.lower() == "localhost"):
        host, repository = first.lower(), rest
        if host.rpartition(":")[2] in ("80", "443"):
            host = host.rpartition(":")[0]
    else:
        host, repository = "docker.io", reference
    if host in ("index.docker.io", "registry-1.docker.io"):
        host = "docker.io"
    if host == "docker.io" and "/" not in repository:
        repository = "library/" + repository
    normalized = host + "/" + repository
    # A registry port is not an image tag. Digest-only references have no tag.
    tag = normalized.rsplit(":", 1)[1] if normalized.rfind(":") > normalized.rfind("/") else None
    name = normalized.rsplit(":", 1)[0] if tag is not None else normalized
    return normalized, name, tag


def check(root):
    sdk = json.loads((root / "global.json").read_text(encoding="utf-8"))["sdk"]["version"]
    if not isinstance(sdk, str) or not VERSION.fullmatch(sdk):
        raise ValueError(f"invalid global.json sdk.version: {ascii(sdk)}; use a stable major.minor.patch version")
    dockerfiles = discover_dockerfiles(root)
    if not dockerfiles:
        raise ValueError("no Dockerfiles found")
    digests = {}
    errors = []
    external_count = 0
    for name in dockerfiles:
        arguments, stages = {}, set()
        found_from = False
        location = name
        try:
            for number, line in logical_lines(root / name):
                location = f"{name}:{number}"
                words = line.split(None, 1)
                instruction = words[0].upper()
                value = words[1] if len(words) > 1 else ""
                if instruction not in INSTRUCTIONS:
                    raise ValueError(f"unknown Dockerfile instruction: {ascii(instruction)}")
                if "<<" in value:
                    raise ValueError("heredoc unsupported; use a separate COPY source or a non-heredoc instruction")
                if instruction == "ARG" and not found_from:
                    key, separator, default = value.partition("=")
                    arguments[key] = expand(default, arguments) if separator else None
                if instruction != "FROM":
                    continue
                found_from = True
                tokens = shlex.split(value)
                if tokens and tokens[0].startswith("--platform="):
                    tokens.pop(0)
                if not (len(tokens) == 1 or (len(tokens) == 3 and tokens[1].upper() == "AS")):
                    raise ValueError("unsupported FROM syntax")
                image = expand(tokens[0], arguments)
                # scratch has no base. Earlier stages inherit their checked base.
                if image.lower() != "scratch" and image.lower() not in stages:
                    match = PIN.fullmatch(image)
                    if not match:
                        raise ValueError(f"FROM must be pinned by sha256 digest: {ascii(image)}")
                    reference, digest = match.groups()
                    normalized, repository, tag = normalize_reference(reference)
                    if repository == SDK and tag is not None and tag != sdk:
                        raise ValueError(f"SDK tag must equal global.json ({ascii(sdk)}): {ascii(reference)}")
                    if tag is not None:
                        if normalized in digests and digests[normalized][0] != digest:
                            raise ValueError(f"conflicting digests for {ascii(normalized)}; first seen at {ascii(digests[normalized][1])}")
                        digests.setdefault(normalized, (digest, location))
                    external_count += 1
                if len(tokens) == 3:
                    alias = tokens[2].lower()
                    if alias in stages:
                        raise ValueError(f"duplicate stage alias: {ascii(alias)}")
                    stages.add(alias)
            if not found_from:
                raise ValueError("no FROM instructions")
        except ValueError as error:
            errors.append(f"{ascii(location)}: {error}")
    if errors:
        raise ValueError("\n".join(errors))
    print(f"Base-image check passed: {len(dockerfiles)} Dockerfiles, {external_count} external FROMs, SDK {ascii(sdk)}.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("root", nargs="?", type=pathlib.Path, default=pathlib.Path(__file__).resolve().parent.parent)
    args = parser.parse_args()
    try:
        check(args.root.resolve())
    except (OSError, ValueError, KeyError, TypeError, subprocess.CalledProcessError) as error:
        # Escape even exception text (including filenames supplied by the OS).
        print(f"Base-image check failed: {ascii(str(error))}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
