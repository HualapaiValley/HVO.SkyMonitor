#!/usr/bin/env python3
"""Check repository Dockerfile base images offline; no Docker or registry calls."""
import argparse
import json
import pathlib
import re
import shlex
import subprocess
import sys


VARIABLE = re.compile(r"\$(?:\{([A-Za-z_][A-Za-z_0-9]*)\}|([A-Za-z_][A-Za-z_0-9]*))")
PIN = re.compile(r"([^@\s]+)@sha256:([0-9a-f]{64})")
SDK = "mcr.microsoft.com/dotnet/sdk"
DEVCONTAINER = "mcr.microsoft.com/devcontainers/base"
INSTRUCTIONS = set("ADD ARG CMD COPY ENTRYPOINT ENV EXPOSE FROM HEALTHCHECK LABEL MAINTAINER ONBUILD RUN SHELL STOPSIGNAL USER VOLUME WORKDIR".split())


class DockerfileSyntaxError(ValueError):
    def __init__(self, line, message):
        super().__init__(message)
        self.line = line


def discover_dockerfiles(root):
    """One inventory for the guard and its Dependabot coverage contract."""
    paths = subprocess.check_output(
        ["git", "-C", str(root), "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
    ).decode().split("\0")
    def matches(path):
        name = pathlib.PurePosixPath(path).name.lower()
        return not name.endswith(".dockerignore") and any(
            name == kind or name.startswith(kind + ".") or name.endswith("." + kind)
            for kind in ("dockerfile", "containerfile"))
    return sorted({p for p in paths if p and matches(p)})


def heredoc_words(value):
    """Split raw shell words, retaining quotes/escapes and whitespace after <<.

    BuildKit discovers heredocs from whole words, not shell redirection operators:
    cat<<EOF and "<<EOF" do not introduce bodies, but 3<<'EOF' does.
    """
    word, quote = "", ""
    position = 0
    while position < len(value):
        char = value[position]
        if char == "\\" and quote != "'":
            if position + 1 == len(value):
                raise ValueError("unsupported heredoc escape")
            word += value[position:position + 2]
            position += 2
            continue
        if quote:
            word += char
            if char == quote:
                quote = ""
        elif char in "\"'":
            quote = char
            word += char
        elif char.isspace():
            # BuildKit's shell lexer keeps whitespace immediately after <<.
            if word.endswith("<<"):
                while position < len(value) and value[position].isspace():
                    word += value[position]
                    position += 1
                continue
            if word:
                yield word
                word = ""
        else:
            word += char
        position += 1
    if quote:
        raise ValueError("unterminated heredoc quote")
    if word:
        yield word


def heredocs(line):
    words = line.split(None, 1)
    if not words:
        raise ValueError("unsupported Dockerfile whitespace")
    instruction, value = words[0].upper(), words[1] if len(words) > 1 else ""
    if instruction == "ONBUILD":
        child = value.split(None, 1)
        if child and child[0].upper() == "ONBUILD":
            raise ValueError("unsupported nested ONBUILD")
        return heredocs(value) if value else []
    if instruction not in {"RUN", "COPY", "ADD"} or "<<" not in value:
        return []
    # Flags precede the shell/JSON argument. JSON arguments cannot own heredocs.
    argument = re.sub(r"^(?:--\S+\s+)*", "", value)
    if argument.startswith("["):
        try:
            array = json.loads(argument)
        except ValueError as error:
            raise ValueError("unsupported heredoc JSON form") from error
        if not isinstance(array, list) or not all(isinstance(item, str) for item in array):
            raise ValueError("unsupported heredoc JSON form")
        return []
    if "${" in value:
        raise ValueError("unsupported expansion in heredoc instruction")
    result = []
    for word in heredoc_words(value):
        if not re.match(r"^[0-9]*<<", word):
            continue
        # Match an empty tail first so a bare <<- cannot backtrack into a
        # delimiter named '-'. Unsupported operators must not consume bodies.
        match = re.fullmatch(r"[0-9]*<<(-?)\s*([^<]*)", word)
        if not match or not match[2].strip():
            raise ValueError("unsupported heredoc syntax")
        delimiter = match[2]
        # Expansion syntax has a different shell lexer; do not guess a boundary.
        if "$" in delimiter or "`" in delimiter:
            raise ValueError("unsupported heredoc delimiter expansion")
        lexer = shlex.shlex(delimiter, posix=True)
        lexer.whitespace += "".join(char for char in delimiter if char.isspace())
        lexer.whitespace_split = True
        lexer.commenters = ""
        names = list(lexer)
        if len(names) != 1 or not names[0]:
            raise ValueError("unsupported heredoc delimiter")
        result.append((names[0], bool(match[1])))
    return result


def logical_lines(path):
    pending = ""
    start = 0
    lines = iter(enumerate(path.read_bytes().decode("utf-8-sig").split("\n"), 1))
    for number, line in lines:
        line = line.removesuffix("\r")
        if not line.strip(" \t") or line.lstrip(" \t").startswith("#"):
            if re.match(r"\s*#\s*escape\s*=\s*`", line, re.I):
                raise DockerfileSyntaxError(number, "unsupported Dockerfile escape directive")
            continue
        if not start:
            start = number
        continuation = re.search(r"(?:^|[^\\])\\[ \t]*$", line)
        # Concatenate exactly: an escape can split even a heredoc delimiter.
        pending += re.sub(r"\\[ \t]*$", "", line) if continuation else line
        if continuation:
            continue
        try:
            bodies = heredocs(pending)
        except ValueError as error:
            raise DockerfileSyntaxError(start, str(error)) from error
        for delimiter, chomp in bodies:
            for _, payload in lines:
                terminator = payload.rstrip("\r")
                if chomp:
                    terminator = terminator.lstrip("\t")
                if terminator == delimiter:
                    break
            else:
                raise DockerfileSyntaxError(start, f"unterminated heredoc: {delimiter}")
        yield start, pending
        pending = ""
        start = 0
    if start:
        raise DockerfileSyntaxError(start, "unfinished continuation")


def expand(value, arguments):
    def replace(match):
        name = match[1] or match[2]
        if name not in arguments or arguments[name] is None:
            raise ValueError(f"unresolved FROM argument: {name}")
        return arguments[name]
    value = VARIABLE.sub(replace, value)
    if "$" in value:
        raise ValueError("unresolved FROM argument or unsupported expansion")
    return value


def normalized_name(name):
    # Compare Docker Hub's short forms and the default HTTPS registry port equally.
    host, slash, rest = name.partition("/")
    if slash and ("." in host or ":" in host or host.lower() == "localhost"):
        host = host.lower().removesuffix(":443")
        if host in ("docker.io", "index.docker.io"):
            return rest.removeprefix("library/")
        return host + "/" + rest
    return name.removeprefix("library/")


def check(root):
    sdk = json.loads((root / "global.json").read_text())["sdk"]["version"]
    if not isinstance(sdk, str) or not re.fullmatch(r"[1-9][0-9]*\.[0-9]+\.[0-9]+", sdk):
        raise ValueError("invalid stable SDK version in global.json")
    dockerfiles = discover_dockerfiles(root)
    if not dockerfiles:
        raise ValueError("no Dockerfiles found")
    digests = {}
    errors = []
    external_count = 0
    for name in dockerfiles:
        arguments, stages = {}, set()
        found_from = False
        location = name
        try:
            for number, line in logical_lines(root / name):
                location = f"{name}:{number}"
                # Split on all whitespace, including a tab after the instruction.
                words = line.split(None, 1)
                instruction = words[0].upper()
                value = words[1] if len(words) > 1 else ""
                if instruction not in INSTRUCTIONS:
                    raise ValueError(f"unknown Dockerfile instruction: {instruction}")
                if instruction == "ARG" and not found_from:
                    key, separator, default = value.partition("=")
                    arguments[key] = expand(default, arguments) if separator else None
                if instruction != "FROM":
                    continue
                found_from = True
                tokens = shlex.split(value)
                if tokens and tokens[0].startswith("--platform="):
                    tokens.pop(0)
                if not (len(tokens) == 1 or (len(tokens) == 3 and tokens[1].upper() == "AS")):
                    raise ValueError("unsupported FROM syntax")
                image = expand(tokens[0], arguments)
                # Stage references inherit the checked, pinned base. Only earlier
                # aliases are allowed; a forward reference remains an external image.
                if image.lower() not in stages and image != "scratch":
                    match = PIN.fullmatch(image)
                    if not match:
                        raise ValueError(f"FROM must be pinned by sha256 digest: {image}")
                    tag, digest = match.groups()
                    tag = normalized_name(tag)
                    if tag == SDK or tag.startswith(SDK + ":"):
                        if tag != f"{SDK}:{sdk}":
                            raise ValueError(f"SDK tag must equal global.json ({sdk}): {tag}")
                    if tag == DEVCONTAINER or tag.startswith(DEVCONTAINER + ":"):
                        # The Ubuntu suffix can change without a semver-major bump.
                        if not re.fullmatch(re.escape(DEVCONTAINER) + r":3\.[0-9]+\.[0-9]+-ubuntu24\.04", tag):
                            raise ValueError(f"devcontainers/base must use a stable 3.x.y-ubuntu24.04 tag; "
                                             f"major or OS upgrades require a reviewed policy change: {tag}")
                    # Digest-only references pin different content without asserting a shared tag.
                    tagged = ":" in tag.rsplit("/", 1)[-1]
                    if tagged and tag in digests and digests[tag][0] != digest:
                        raise ValueError(f"conflicting digests for {tag}; first seen at {digests[tag][1]}")
                    if tagged:
                        digests.setdefault(tag, (digest, location))
                    external_count += 1
                if len(tokens) == 3:
                    alias = tokens[2].lower()
                    if alias in stages:
                        raise ValueError(f"duplicate stage alias: {alias}")
                    stages.add(alias)
            if not found_from:
                raise ValueError("no FROM instructions")
        except DockerfileSyntaxError as error:
            errors.append(f"{name}:{error.line}: {error}")
        except ValueError as error:
            errors.append(f"{location}: {error}")
    if errors:
        raise ValueError("\n".join(errors))
    print(f"Base-image check passed: {len(dockerfiles)} Dockerfiles, {external_count} external FROMs, SDK {sdk}.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("root", nargs="?", type=pathlib.Path, default=pathlib.Path(__file__).resolve().parent.parent)
    args = parser.parse_args()
    try:
        check(args.root.resolve())
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print(f"Base-image check failed: {ascii(str(error))}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
