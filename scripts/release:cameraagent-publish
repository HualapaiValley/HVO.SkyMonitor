#!/usr/bin/env bash
# Shared restore/publish arguments for the release image; ordinary builds retain IL defaults.
set -euo pipefail
phase="${1:-}"
case "$phase" in restore | publish) shift ;; *) echo 'Expected restore or publish.' >&2; exit 64 ;; esac
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
arguments=()
# Static endpoint dates are file CONTENT, so exporter mtime rewriting cannot repair them.
# HVO_CREATED remains the release label/input; a development image only uses the source date internally.
asset_created="${HVO_CREATED:-}"
if [[ -n "${SOURCE_DATE_EPOCH:-}" ]]; then
    [[ "$SOURCE_DATE_EPOCH" =~ ^[0-9]+$ ]] || { echo 'SOURCE_DATE_EPOCH must be Unix seconds.' >&2; exit 64; }
    asset_created="${asset_created:-$(date -u -d "@$SOURCE_DATE_EPOCH" +%Y-%m-%dT%H:%M:%SZ)}"
fi
case "${HVO_READY_TO_RUN:-false}" in
    false) ;;
    true)
        case "${TARGETARCH:-}" in
            amd64) rid=linux-x64 ;;
            arm64) rid=linux-arm64 ;;
            *) echo 'ReadyToRun requires TARGETARCH=amd64 or arm64.' >&2; exit 64 ;;
        esac
        # Release gates already supply the source commit's UTC creation time as HVO_CREATED.
        # Reject property separators and ambiguous/local dates before passing it to MSBuild.
        if [[ ! "${HVO_CREATED:-}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ||
            [[ "$(LC_ALL=C date -u -d "$HVO_CREATED" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" != "$HVO_CREATED" ]]; then
            echo 'ReadyToRun requires HVO_CREATED as a valid UTC yyyy-MM-ddTHH:mm:ssZ release input.' >&2
            exit 64
        fi
        arguments=(-r "$rid" -p:SelfContained=false -p:PublishReadyToRun=true -p:PublishReadyToRunComposite=false)
        ;;
    *) echo 'HVO_READY_TO_RUN must be true or false.' >&2; exit 64 ;;
esac
if [[ "${HVO_READY_TO_RUN:-false}" == true || -n "${SOURCE_DATE_EPOCH:-}" ]]; then
    if [[ ! "$asset_created" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ||
        [[ "$(LC_ALL=C date -u -d "$asset_created" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" != "$asset_created" ]]; then
        echo 'Image asset dates require a valid UTC yyyy-MM-ddTHH:mm:ssZ input.' >&2; exit 64
    fi
    arguments+=("-p:CustomAfterMicrosoftCommonTargets=$root/scripts/cameraagent-release.targets"
        "-p:HvoReleaseCreatedUtc=$asset_created")
fi
if [[ "$phase" == publish ]]; then
    arguments+=(--no-restore)
    [[ "${HVO_READY_TO_RUN:-false}" != true ]] || arguments+=(--self-contained false)
fi
exec dotnet "$phase" "$root/src/HVO.SkyMonitor.CameraAgent/HVO.SkyMonitor.CameraAgent.csproj" "${arguments[@]}" "$@"
