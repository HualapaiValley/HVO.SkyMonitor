#!/usr/bin/env bash
# Run the opt-in full-resolution production-catalog standalone smoke.

set -euo pipefail
export LC_ALL=C

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=lib/catalog-perf-root.sh
source "$SCRIPT_DIR/lib/catalog-perf-root.sh"
readonly PROJECT="$REPO_ROOT/tests/HVO.SkyMonitor.CameraAgent.AcceptanceTests/HVO.SkyMonitor.CameraAgent.AcceptanceTests.csproj"
readonly PROCESSING_PROJECT="$REPO_ROOT/tests/HVO.SkyMonitor.Processing.Tests/HVO.SkyMonitor.Processing.Tests.csproj"
readonly CAMERA_PROJECT="$REPO_ROOT/tests/HVO.SkyMonitor.CameraAgent.Tests/HVO.SkyMonitor.CameraAgent.Tests.csproj"
readonly PUBLISHED_RESULTS="$REPO_ROOT/TestResults/issue-171/production-smoke"
readonly ATOMIC_DIRECTORY_PUBLISH="$REPO_ROOT/scripts/lib/atomic-directory-publish.py"

if [[ $# -ne 0 || -z "${HVO_CATALOG_PERF_ROOT:-}" ]]; then
    printf 'Usage: HVO_CATALOG_PERF_ROOT=INSTALLED_PRODUCTION_CATALOG_ROOT %s\n' "${0##*/}" >&2
    exit 2
fi
# The root must have the shape the container will demand, not merely be a readable
# directory: the catalog version directory is also readable, and admitting it here is how a
# startup failure becomes a login-endpoint timeout five minutes later (#735).
require_catalog_installation_root "$HVO_CATALOG_PERF_ROOT" || exit 2
for command in awk date dotnet git jq nproc python3 sha256sum sleep stat; do
    command -v "$command" >/dev/null 2>&1 || { printf 'Required command is unavailable: %s\n' "$command" >&2; exit 2; }
done
[[ -f "$ATOMIC_DIRECTORY_PUBLISH" ]] || { printf 'Atomic directory publication helper is unavailable: %s\n' "$ATOMIC_DIRECTORY_PUBLISH" >&2; exit 2; }

# The five-second arrival budget is a cadence contract measured as wall-clock module-start
# intervals, so it is only meaningful on a quiescent host: on a shared build host the
# runner's post-deadline work (schedule confirmation, admission, timer wake-up) competes with
# other processes and the budget trips without any runtime change. Each trial therefore
# requires the one-minute load average to be at or below HVO_SMOKE_MAX_LOAD1 (default half
# the processor count), optionally waiting up to HVO_SMOKE_QUIESCENCE_WAIT_SECONDS for the
# host to settle. The trial itself records the load averages it observed in its evidence.
SMOKE_PROCESSOR_COUNT="$(nproc)"
readonly SMOKE_PROCESSOR_COUNT
SMOKE_MAX_LOAD1="${HVO_SMOKE_MAX_LOAD1:-$(awk -v processors="$SMOKE_PROCESSOR_COUNT" 'BEGIN { printf "%.2f", processors / 2 }')}"
readonly SMOKE_MAX_LOAD1
readonly SMOKE_QUIESCENCE_WAIT_SECONDS="${HVO_SMOKE_QUIESCENCE_WAIT_SECONDS:-0}"
if ! [[ "$SMOKE_MAX_LOAD1" =~ ^[0-9]+([.][0-9]+)?$ && "$SMOKE_QUIESCENCE_WAIT_SECONDS" =~ ^[0-9]+$ ]]; then
    printf 'HVO_SMOKE_MAX_LOAD1 must be a non-negative decimal and HVO_SMOKE_QUIESCENCE_WAIT_SECONDS a non-negative integer.\n' >&2
    exit 2
fi
read_load1() {
    local load1
    read -r load1 _ < /proc/loadavg || return 1
    [[ "$load1" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
    printf '%s' "$load1"
}
read_monotonic_seconds() {
    local seconds
    read -r seconds _ < /proc/uptime || return 1
    [[ "$seconds" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
    printf '%s' "$seconds"
}
# Prints "over" or "under"; any other outcome (unreadable or non-numeric load, awk failure) is a refusal, never an admission.
load_verdict() {
    local load1="$1"
    awk -v current="$load1" -v limit="$SMOKE_MAX_LOAD1" 'BEGIN { if (current + 0 > limit + 0) print "over"; else print "under" }' 2>/dev/null
}
require_quiescent_host() {
    local trial="$1" load1 verdict started_monotonic deadline_monotonic now_monotonic
    local timing elapsed remaining boundary wait_state sleep_seconds initial_observation=true
    if ! started_monotonic="$(read_monotonic_seconds)"; then
        printf 'Trial %s refused: unable to read the monotonic clock from /proc/uptime; the quiescence precondition fails closed.\n' "$trial" >&2
        exit 3
    fi
    if ! deadline_monotonic="$(awk -v started="$started_monotonic" -v window="$SMOKE_QUIESCENCE_WAIT_SECONDS" \
        'BEGIN { printf "%.9f", started + window }')" ||
       ! [[ "$deadline_monotonic" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        printf 'Trial %s refused: could not calculate the monotonic quiescence deadline; the precondition fails closed.\n' "$trial" >&2
        exit 3
    fi
    while :; do
        if ! load1="$(read_load1)"; then
            printf 'Trial %s refused: unable to read a numeric 1-minute load average from /proc/loadavg; the quiescence precondition fails closed.\n' "$trial" >&2
            exit 3
        fi
        if ! verdict="$(load_verdict "$load1")"; then
            printf 'Trial %s refused: could not evaluate load average %s against limit %s; the quiescence precondition fails closed.\n' \
                "$trial" "$load1" "$SMOKE_MAX_LOAD1" >&2
            exit 3
        fi
        if ! now_monotonic="$(read_monotonic_seconds)"; then
            printf 'Trial %s refused: unable to read the monotonic clock from /proc/uptime; the quiescence precondition fails closed.\n' "$trial" >&2
            exit 3
        fi
        if ! timing="$(awk -v started="$started_monotonic" -v deadline="$deadline_monotonic" -v now="$now_monotonic" '
            BEGIN {
                elapsed = now - started
                remaining = deadline - now
                printf "%.3f %.6f %s %s %.6f", elapsed, remaining,
                    (now <= deadline ? "within" : "late"),
                    (remaining > 0 ? "wait" : "expired"),
                    (remaining < 10 ? remaining : 10)
            }')" ||
           ! read -r elapsed remaining boundary wait_state sleep_seconds <<< "$timing" ||
           ! [[ "$elapsed" =~ ^[0-9]+([.][0-9]+)?$ &&
                "$remaining" =~ ^-?[0-9]+([.][0-9]+)?$ &&
                "$sleep_seconds" =~ ^-?[0-9]+([.][0-9]+)?$ &&
                "$boundary" =~ ^(within|late)$ && "$wait_state" =~ ^(wait|expired)$ ]]; then
            printf 'Trial %s refused: could not evaluate the monotonic quiescence deadline; the precondition fails closed.\n' "$trial" >&2
            exit 3
        fi
        case "$verdict" in
            under)
                # The initial observation is always eligible. After any wait, the load comparison and
                # final monotonic observation must complete at or before the inclusive deadline.
                if [[ "$initial_observation" == false && "$boundary" != within ]]; then
                    printf 'Trial %s refused: the host became quiescent only after the inclusive %ss wait deadline (elapsed %ss); the precondition fails closed.\n' \
                        "$trial" "$SMOKE_QUIESCENCE_WAIT_SECONDS" "$elapsed" >&2
                    exit 3
                fi
                break
                ;;
            over) ;;
            *)
                printf 'Trial %s refused: could not evaluate load average %s against limit %s; the quiescence precondition fails closed.\n' \
                    "$trial" "$load1" "$SMOKE_MAX_LOAD1" >&2
                exit 3
                ;;
        esac
        if [[ "$wait_state" == expired ]]; then
            printf 'Trial %s refused: host is not quiescent (1-minute load average %s exceeds %s on %s processors after %ss elapsed against the inclusive %ss wait deadline). The arrival budget is a cadence contract, not a load test; rerun when the host is quiet, raise HVO_SMOKE_QUIESCENCE_WAIT_SECONDS, or set HVO_SMOKE_MAX_LOAD1 deliberately.\n' \
                "$trial" "$load1" "$SMOKE_MAX_LOAD1" "$SMOKE_PROCESSOR_COUNT" "$elapsed" "$SMOKE_QUIESCENCE_WAIT_SECONDS" >&2
            exit 3
        fi
        sleep "$sleep_seconds"
        initial_observation=false
    done
    printf 'Trial %s admitted: host 1-minute load average %s (limit %s on %s processors, elapsed %ss against the inclusive %ss wait deadline)\n' \
        "$trial" "$load1" "$SMOKE_MAX_LOAD1" "$SMOKE_PROCESSOR_COUNT" "$elapsed" "$SMOKE_QUIESCENCE_WAIT_SECONDS" >&2
    if [[ -n "${QUIESCENCE_LOG:-}" ]]; then
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$trial" "$load1" "$SMOKE_MAX_LOAD1" "$SMOKE_PROCESSOR_COUNT" "$elapsed" >> "$QUIESCENCE_LOG"
    fi
}
if [[ "${HVO_SMOKE_QUIESCENCE_CHECK_ONLY:-0}" == 1 ]]; then
    require_quiescent_host precheck
    exit 0
fi

PUBLISHED_RESULTS_PARENT="$(dirname "$PUBLISHED_RESULTS")"
readonly PUBLISHED_RESULTS_PARENT
mkdir -p "$PUBLISHED_RESULTS_PARENT"
python3 "$ATOMIC_DIRECTORY_PUBLISH" probe "$PUBLISHED_RESULTS_PARENT"

# Evidence is produced in a fresh staging directory and published to RESULTS only after every
# gate passes, so a refusal or a failed trial never destroys the previously published run.
RESULTS="$PUBLISHED_RESULTS.staging-$(date -u '+%Y%m%dT%H%M%SZ')-$$"
readonly RESULTS
mkdir -p "$RESULTS"
readonly QUIESCENCE_LOG="$RESULTS/quiescence-log.tsv"
printf 'observedUtc\ttrial\tloadAverageOneMinute\tlimit\tprocessors\telapsedSeconds\n' > "$QUIESCENCE_LOG"
printf 'Staging evidence in %s; it is published to %s only after every gate passes.\n' "$RESULTS" "$PUBLISHED_RESULTS" >&2
export HVO_ISSUE_171_FIXED_UTC="$(date -u '+%Y-%m-%dT%H:%M:00Z')"
export HVO_ISSUE_171_REVISION="$(git -C "$REPO_ROOT" rev-parse HEAD)"
export HVO_ISSUE_171_BRANCH="$(git -C "$REPO_ROOT" branch --show-current)"
export HVO_ISSUE_171_DIRTY_SHA256="$(
    {
        git -C "$REPO_ROOT" status --porcelain=v1
        git -C "$REPO_ROOT" diff --binary
        while IFS= read -r path; do
            sha256sum "$REPO_ROOT/$path"
        done < <(git -C "$REPO_ROOT" ls-files --others --exclude-standard)
    } | sha256sum | { read -r hash _; printf '%s' "$hash"; }
)"
export HVO_ISSUE_171_SDK_VERSION="$(dotnet --version)"
export HVO_ISSUE_171_STORAGE_TYPE="$(stat -f -c %T "$RESULTS")"
dotnet build "$PROJECT" --configuration Release -warnaserror
expected_jpeg_sha256=""
for trial in 1 2 3 4 5; do
    export HVO_ISSUE_171_TRIAL="trial-$trial"
    export HVO_ISSUE_171_EVIDENCE_ROOT="$RESULTS/$HVO_ISSUE_171_TRIAL/evidence"
    require_quiescent_host "$HVO_ISSUE_171_TRIAL"
    started_epoch="$(date +%s)"
    dotnet test "$PROJECT" \
        --no-build \
        --configuration Release \
        --filter "FullyQualifiedName~FullResolutionProductionCatalogStandaloneSmokeTests.FullResolutionProductionCatalogStandaloneSmokeAsync" \
        --results-directory "$RESULTS/$HVO_ISSUE_171_TRIAL" \
        --logger "trx;LogFileName=issue-171-standalone-smoke.trx" \
        --logger "console;verbosity=normal"
    for evidence in issue-171-standalone-smoke.json issue-171-full-resolution-annotated.jpg; do
        evidence_path="$HVO_ISSUE_171_EVIDENCE_ROOT/$evidence"
        if [[ ! -s "$evidence_path" || "$(stat -c %Y "$evidence_path")" -lt "$started_epoch" ]]; then
            printf 'Trial %s did not produce current evidence: %s\n' "$trial" "$evidence_path" >&2
            exit 1
        fi
    done
    jq --exit-status \
        --arg trial "$HVO_ISSUE_171_TRIAL" \
        --arg revision "$HVO_ISSUE_171_REVISION" \
        --arg dirtySha256 "$HVO_ISSUE_171_DIRTY_SHA256" \
        '.trial == $trial and .revision.commit == $revision and .revision.dirtyStateSha256 == $dirtySha256' \
        "$HVO_ISSUE_171_EVIDENCE_ROOT/issue-171-standalone-smoke.json" >/dev/null
    read -r jpeg_sha256 _ < <(sha256sum "$HVO_ISSUE_171_EVIDENCE_ROOT/issue-171-full-resolution-annotated.jpg")
    if [[ -z "$expected_jpeg_sha256" ]]; then
        expected_jpeg_sha256="$jpeg_sha256"
    elif [[ "$jpeg_sha256" != "$expected_jpeg_sha256" ]]; then
        printf 'Trial %s fixed-scene JPEG SHA-256 changed: expected %s, got %s\n' \
            "$trial" "$expected_jpeg_sha256" "$jpeg_sha256" >&2
        exit 1
    fi
done

jq -s \
    --arg revision "$HVO_ISSUE_171_REVISION" \
    --arg branch "$HVO_ISSUE_171_BRANCH" \
    --arg dirtySha256 "$HVO_ISSUE_171_DIRTY_SHA256" '
    def stats: sort | { minimum: .[0], median: .[2], maximum: .[4] };
    {
      schemaVersion: "issue-171-five-trial-summary-v1",
      revision: $revision,
      branch: $branch,
      dirtyStateSha256: $dirtySha256,
      trialCount: length,
      measuredCadenceCaptureCount: (map(.workload.preRestartCaptures) | unique | if length == 1 then .[0] else error("measured capture count changed across trials") end),
      fixedSceneUtc: (map(.workload.fixedSceneUtc) | unique | if length == 1 then .[0] else error("scene UTC changed across trials") end),
      annotatedJpegSha256: (map(.retainedAnnotatedJpeg.sha256) | unique | if length == 1 then .[0] else error("JPEG SHA-256 changed across trials") end),
      elapsedMilliseconds: (map(.performance.elapsedMilliseconds) | stats),
      cpuMilliseconds: (map(.performance.cpuMilliseconds) | stats),
      allocationsBytes: (map(.performance.allocationsBytes) | stats),
      peakObservedRssBytes: (map(.performance.peakObservedRssBytes) | stats),
      maximumObservedLohSizeAfterGcBytes: (map(.performance.maximumObservedLohSizeAfterGcBytes) | stats),
      storageBytesWritten: (map(.performance.processIo.storageBytesWritten) | stats),
      retainedFilesystemBytes: (map(.performance.retainedFilesystemBytes) | stats),
      workflowThroughputCapturesPerSecond: (map(.performance.workflowThroughputCapturesPerSecond) | stats),
      sustainedCadenceCapturesPerSecond: (map(.performance.sustainedCadenceCapturesPerSecond) | stats),
      maximumStartIntervalMilliseconds: (map(.performance.captureStartIntervalMilliseconds | max) | stats),
      maximumMonotonicStartJitterMilliseconds: (map(.performance.monotonicStartJitterMilliseconds | max) | stats),
      hostLoadAverageOneMinuteAtStart: (map(.environment.hostLoadAverageAtStart.oneMinute) | if all(. != null) then stats else { unavailableTrials: (map(select(. == null)) | length) } end),
      outOfBudgetCaptureIndexes: (map(.performance.cadenceDiagnostic.outOfBudgetCaptureIndexes) | add),
      structuralViolations: (map(.performance.cadenceDiagnostic.structuralViolations) | add),
      garbageCollectorPauseMilliseconds: (map(.performance.cadenceDiagnostic.garbageCollectorPauseMilliseconds) | stats),
      maximumCompletionLatencyMilliseconds: (map(.performance.completionLatencyMilliseconds | max) | stats),
      maximumLaneBacklogCount: (map(.performance.peakLaneBacklog) | max),
      maximumLaneBacklogBytes: (map(.performance.peakLaneBacklogBytes) | max),
      maximumLaneBacklogAgeMilliseconds: (map(.performance.maximumObservedLaneBacklogAgeMilliseconds) | max),
      allDrained: (all(.performance.drained)),
      allSustainedArrivalBudget: (all(.result.sustainedArrivalBudget)),
      minimumPendingDurableWorkBeforeRestart: (map(.restart.pendingDurableWorkBeforeRestart) | min),
      duplicateLogicalOutputs: (map(.restart.duplicateLogicalOutputs) | add),
      centralTrafficAttempts: (map(.centralTrafficAttempts) | add)
    }
    ' "$RESULTS"/trial-{1,2,3,4,5}/evidence/issue-171-standalone-smoke.json \
    > "$RESULTS/five-trial-summary.json"

for workload in W1 W2; do
    output="$RESULTS/reference-calibration-$workload"
    started_epoch="$(date +%s)"
    HVO_PERF_WORKLOAD="$workload" \
    HVO_PERF_RECIPE=reference-calibration \
    HVO_PERF_OUTPUT="$output" \
    HVO_PERF_REVISION="$HVO_ISSUE_171_REVISION" \
    HVO_PERF_TRIAL=issue-171-candidate \
        dotnet test "$PROCESSING_PROJECT" \
        --configuration Release \
        --filter "FullyQualifiedName~ProcessingRecipePerformanceTests.WarmSelectedRecipeEvidence" \
        --logger "console;verbosity=normal"
    output_file="$output/processing-performance-$workload-reference-calibration.json"
    if [[ ! -s "$output_file" || "$(stat -c %Y "$output_file")" -lt "$started_epoch" ]]; then
        printf '%s reference-calibration gate did not produce current evidence: %s\n' "$workload" "$output_file" >&2
        exit 1
    fi
done

local_graph_started_epoch="$(date +%s)"
HVO_ISSUE96_EVIDENCE_ROOT="$RESULTS/local-graph" \
HVO_EVIDENCE_REVISION="$HVO_ISSUE_171_REVISION" \
    dotnet test "$CAMERA_PROJECT" \
    --configuration Release \
    --filter "FullyQualifiedName~CaptureProcessingGraphPerformanceTests.WritesIssue96PerformanceAndRuntimeEvidence" \
    --logger "console;verbosity=normal"
for evidence in local-processing-performance.json fault-recovery.json runtime-signals.json; do
    evidence_path="$RESULTS/local-graph/$evidence"
    if [[ ! -s "$evidence_path" || "$(stat -c %Y "$evidence_path")" -lt "$local_graph_started_epoch" ]]; then
        printf 'Local-graph gate did not produce current evidence: %s\n' "$evidence_path" >&2
        exit 1
    fi
done

# Every gate passed: one Linux renameat2 operation either installs the first run without
# replacement or exchanges the staged and published directories. The canonical path therefore
# always names the old or new complete tree, including if the runner is interrupted. After an
# exchange RESULTS names the previous tree and is removed only after the new name is durable.
publication_mode="$(python3 "$ATOMIC_DIRECTORY_PUBLISH" publish "$RESULTS" "$PUBLISHED_RESULTS")"
case "$publication_mode" in
    installed) ;;
    exchanged) rm -rf -- "$RESULTS" ;;
    *) printf 'Atomic directory publication returned an invalid mode: %s\n' "$publication_mode" >&2; exit 1 ;;
esac
printf 'Published five-trial evidence to %s\n' "$PUBLISHED_RESULTS" >&2
