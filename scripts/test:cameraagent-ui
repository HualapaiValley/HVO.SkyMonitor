#!/usr/bin/env bash
# Run the opt-in CameraAgent UI acceptance and performance evidence.

set -euo pipefail
export LC_ALL=C

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly PROJECT="$REPO_ROOT/tests/HVO.SkyMonitor.CameraAgent.AcceptanceTests/HVO.SkyMonitor.CameraAgent.AcceptanceTests.csproj"
readonly CONFIGURATION="Release"
readonly OUTPUT="$REPO_ROOT/tests/HVO.SkyMonitor.CameraAgent.AcceptanceTests/bin/$CONFIGURATION/net10.0"
readonly RESULTS="$REPO_ROOT/TestResults/cameraagent-ui"
readonly RESULT_FILE='cameraagent-ui.trx'
readonly TRX="$RESULTS/$RESULT_FILE"
install_browser=false

for argument in "$@"; do
    case "$argument" in
        --install-browser)
            install_browser=true
            ;;
        *)
            printf 'Usage: %s [--install-browser]\n' "${0##*/}" >&2
            exit 2
            ;;
    esac
done

dotnet build "$PROJECT" --configuration "$CONFIGURATION" -warnaserror

if [[ "$install_browser" == true ]]; then
    PLAYWRIGHT_DRIVER_SEARCH_PATH="$OUTPUT" dotnet exec \
        --runtimeconfig "$OUTPUT/HVO.SkyMonitor.CameraAgent.AcceptanceTests.runtimeconfig.json" \
        --depsfile "$OUTPUT/HVO.SkyMonitor.CameraAgent.AcceptanceTests.deps.json" \
        "$OUTPUT/Microsoft.Playwright.dll" install chromium
fi

mkdir -p "$RESULTS"
rm -f "$TRX"
dotnet test "$PROJECT" \
    --no-build \
    --configuration "$CONFIGURATION" \
    --filter "FullyQualifiedName~CameraAgentBrowserAcceptanceTests|FullyQualifiedName~CameraAgentGalleryPerformanceTests|FullyQualifiedName~CameraAgentArchivePerformanceTests" \
    --results-directory "$RESULTS" \
    --logger "trx;LogFileName=$RESULT_FILE" \
    --logger "console;verbosity=normal"

# Every browser-gated case guards itself with Assert.Inconclusive, and a skipped MSTest returns exit 0,
# so the command above succeeding proves only that nothing failed, not that anything ran. The result
# summary cannot settle it either: a run whose cases all skipped records notExecuted="0" and
# inconclusive="0", so both "no failures" and "no not-executed results" are true of a run that executed
# nothing. Only the per-result outcome attribute is load-bearing. Refuse anything that is not Passed,
# as scripts/test:cameraagent-arm64-ci does for the same reason.
[[ -s "$TRX" ]] || { printf 'No results file was written to %s.\n' "$TRX" >&2; exit 1; }
recorded="$(grep -c '<UnitTestResult ' "$TRX")" || recorded=0
if ((recorded == 0)); then
    printf 'The UI selection recorded no results; the filter no longer matches the assembly.\n' >&2
    exit 1
fi
if grep '<UnitTestResult ' "$TRX" | grep -vq 'outcome="Passed"'; then
    printf 'The UI evidence contains a result that is not Passed, so this run proved nothing.\n' >&2
    grep -o '<UnitTestResult [^>]*' "$TRX" | grep -v 'outcome="Passed"' \
        | sed -E 's/.*testName="([^"]*)".*outcome="([^"]*)".*/  \1: \2/' >&2
    # An Assert.Inconclusive message is one line but a failing assertion wraps across lines, so
    # close the element explicitly instead of matching a line or a sed range. A sed range is wrong
    # here: when the open and close tags share a line the end address is only sought on later
    # lines, so each range would run to the next message and swallow the captured output between.
    reasons="$(awk '
        /<Message>/ { sub(/.*<Message>/, ""); open = 1 }
        open {
            if (/<\/Message>/) { sub(/<\/Message>.*/, ""); open = 0 }
            print "  " $0
        }' "$TRX" | sort -u)" || reasons=''
    if [[ -n "${reasons//[[:space:]]/}" ]]; then
        printf 'Reasons recorded by the tests themselves:\n' >&2
        printf '%s\n' "$reasons" >&2
    fi
    exit 1
fi
printf '%s: %s results, every one Passed.\n' "${0##*/}" "$recorded"
