#!/usr/bin/env bash
# infra:reset - Reset infrastructure and application service data
# Usage: ./scripts/infra:reset [all|SERVICE...]
# Examples:
#   ./scripts/infra:reset all              # Reset all services
#   ./scripts/infra:reset postgres minio   # Reset specific services

set -euo pipefail

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Change to repo root
cd "$REPO_ROOT"

# Load environment variables
if [ -f .env ]; then
    set -a
    source .env
    set +a
fi

# Define all available services
readonly INFRA_SERVICES=(postgres minio redis smtp)
readonly APP_SERVICES=(logichost cameraagent)
readonly ALL_SERVICES=("${INFRA_SERVICES[@]}" "${APP_SERVICES[@]}")

# Parse arguments
RESET_SERVICES=()

if [[ $# -eq 0 ]]; then
    echo -e "${RED}Error: No services specified${NC}"
    echo "Usage: $0 [all|SERVICE...]"
    echo "Available services: ${ALL_SERVICES[*]}"
    exit 1
fi

for arg in "$@"; do
    if [[ "$arg" == "all" ]]; then
        RESET_SERVICES=("${ALL_SERVICES[@]}")
    else
        RESET_SERVICES+=("$arg")
    fi
done

# Function to get docker context for a service
get_docker_context() {
    local service="$1"
    local context_var=""
    
    case "$service" in
        postgres)
            context_var="${POSTGRES_DOCKER_CONTEXT:-default}"
            ;;
        minio)
            context_var="${MINIO_DOCKER_CONTEXT:-default}"
            ;;
        redis)
            context_var="${REDIS_DOCKER_CONTEXT:-default}"
            ;;
        smtp)
            context_var="${SMTP_DOCKER_CONTEXT:-default}"
            ;;
        logichost)
            context_var="${LOGICHOST_DOCKER_CONTEXT:-default}"
            ;;
        cameraagent)
            context_var="${CAMERAAGENT_DOCKER_CONTEXT:-default}"
            ;;
        
        *)
            context_var="default"
            ;;
    esac
    
    echo "$context_var"
}

get_compose_file() {
    local service="$1"
    case "$service" in
        postgres|minio|redis|smtp) echo "docker-compose.infrastructure.yml" ;;
        logichost|cameraagent) echo "docker-compose.apps.yml" ;;
        *) echo "docker-compose.apps.yml" ;;
    esac
}

get_service_host_var() {
    local service="$1"
    case "$service" in
        postgres) echo "POSTGRES_HOST" ;;
        minio) echo "MINIO_HOST" ;;
        redis) echo "REDIS_HOST" ;;
        smtp) echo "SMTP_HOST" ;;
        *) echo "" ;;
    esac
}

get_service_data_dir_var() {
    local service="$1"
    case "$service" in
        postgres) echo "POSTGRES_DATA_DIR" ;;
        minio) echo "MINIO_DATA_DIR" ;;
        redis) echo "REDIS_DATA_DIR" ;;
        *) echo "" ;;
    esac
}

get_service_data_dir_default() {
    local service="$1"
    case "$service" in
        postgres) echo "./data/postgres" ;;
        minio) echo "./data/minio" ;;
        redis) echo "./data/redis" ;;
        *) echo "" ;;
    esac
}

resolve_data_dir_path() {
    local raw_path="$1"
    if [[ -z "$raw_path" ]]; then
        printf '%s' ""
        return
    fi

    case "$raw_path" in
        ~)
            printf '%s' "$HOME"
            return
            ;;
        ~/*)
            printf '%s' "$HOME/${raw_path#~/}"
            return
            ;;
        /*)
            printf '%s' "$raw_path"
            return
            ;;
    esac

    local trimmed="$raw_path"
    trimmed="${trimmed#./}"
    printf '%s' "$REPO_ROOT/$trimmed"
}

get_resolved_data_dir() {
    local service="$1"
    local dir_var
    dir_var="$(get_service_data_dir_var "$service")"
    if [[ -z "$dir_var" ]]; then
        printf '%s' ""
        return
    fi

    local configured_path
    configured_path="${!dir_var:-}"
    if [[ -z "$configured_path" ]]; then
        configured_path="$(get_service_data_dir_default "$service")"
    fi

    if [[ -z "$configured_path" ]]; then
        printf '%s' ""
        return
    fi

    resolve_data_dir_path "$configured_path"
}

ensure_local_data_dir() {
    local service="$1"
    local context="$2"

    if [[ "$context" != "default" ]]; then
        return
    fi

    local resolved
    resolved="$(get_resolved_data_dir "$service")"
    if [[ -z "$resolved" ]]; then
        return
    fi

    if [[ ! -d "$resolved" ]]; then
        mkdir -p "$resolved"
        echo -e "${GREEN}Created data directory for ${service}: ${resolved}${NC}"
    fi
}

ensure_local_data_dir() {
    local service="$1"
    local context="$2"

    if [[ "$context" != "default" ]]; then
        return
    fi

    local dir_var
    dir_var="$(get_service_data_dir_var "$service")"
    if [[ -z "$dir_var" ]]; then
        return
    fi

    local configured_path
    configured_path="${!dir_var:-}"
    if [[ -z "$configured_path" ]]; then
        configured_path="$(get_service_data_dir_default "$service")"
    fi

    if [[ -z "$configured_path" ]]; then
        return
    fi

    local resolved
    resolved="$(resolve_data_dir_path "$configured_path")"
    if [[ -z "$resolved" ]]; then
        return
    fi

    if [[ ! -d "$resolved" ]]; then
        mkdir -p "$resolved"
        echo -e "${GREEN}Created data directory for ${service}: ${resolved}${NC}"
    fi
}

ensure_remote_host_binding() {
    local service="$1"
    local context="$2"
    local host_var
    host_var="$(get_service_host_var "$service")"

    if [[ -z "$host_var" ]] || [[ "$context" == "default" ]]; then
        return
    fi

    local host_value="${!host_var:-}"
    if [[ -z "$host_value" ]]; then
        echo -e "${RED}Service '$service' uses docker context '$context' but ${host_var} is not set.${NC}"
        echo -e "${YELLOW}Set ${host_var} to the reachable host (e.g., 192.168.2.104) before continuing.${NC}"
        exit 1
    fi

    case "$host_value" in
        localhost|127.0.0.1|0.0.0.0)
            echo -e "${RED}${host_var}=${host_value} cannot reach remote context '$context'.${NC}"
            echo -e "${YELLOW}Update ${host_var} to the remote host address and retry.${NC}"
            exit 1
            ;;
    esac
}

# Function to reset service data
reset_service() {
    local service="$1"
    local context
    context="$(get_docker_context "$service")"
    local compose_file
    compose_file="$(get_compose_file "$service")"

    ensure_remote_host_binding "$service" "$context"

    echo -e "${YELLOW}Resetting $service data...${NC}"

    case "$service" in
        postgres|minio|redis)
            # Stop the service if running
            docker --context "$context" compose -f "$compose_file" stop "$service" 2>/dev/null || true
            
            # Remove the container
            docker --context "$context" compose -f "$compose_file" rm -f "$service" 2>/dev/null || true
            
            # Remove the volume
            local volume_name="skymonitor-${service}-data"
            if docker --context "$context" volume ls --format '{{.Name}}' | grep -q "^${volume_name}$"; then
                docker --context "$context" volume rm "$volume_name"
                echo -e "${GREEN}✓ Removed volume: $volume_name${NC}"
            else
                echo -e "${BLUE}ℹ Volume not found: $volume_name${NC}"
            fi
            
            echo -e "${GREEN}✓ Reset $service data${NC}"
            ensure_local_data_dir "$service" "$context"
            ;;
        smtp)
            # Mailpit doesn't persist data, just remove and restart
            docker --context "$context" compose -f "$compose_file" rm -f "$service" 2>/dev/null || true
            echo -e "${GREEN}✓ Reset $service (removed container)${NC}"
            ;;
        logichost|cameraagent)
            # Application containers - remove container and rebuild
            docker --context "$context" compose -f "$compose_file" rm -f "$service" 2>/dev/null || true
            docker --context "$context" compose -f "$compose_file" build "$service"
            echo -e "${GREEN}✓ Reset $service (removed container and rebuilt image)${NC}"
            ;;
        *)
            echo -e "${RED}Unknown service: $service${NC}"
            return 1
            ;;
    esac
}

# Confirm action
echo -e "${YELLOW}This will reset the following services:${NC}"
for service in "${RESET_SERVICES[@]}"; do
    echo "  - $service"
done
echo ""
read -p "Are you sure? (y/N) " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo -e "${BLUE}Reset cancelled${NC}"
    exit 0
fi

# Reset services
echo -e "${BLUE}=== Resetting Services ===${NC}"
for service in "${RESET_SERVICES[@]}"; do
    reset_service "$service"
done

echo ""
echo -e "${GREEN}=== Reset Complete ===${NC}"
echo "Use './scripts/infra:start' to start the services again"
