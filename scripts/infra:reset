#!/usr/bin/env bash
# infra:reset - Reset infrastructure and application service data
# Usage: ./scripts/infra:reset [all|SERVICE...]
# Examples:
#   ./scripts/infra:reset all              # Reset all services
#   ./scripts/infra:reset postgres minio   # Reset specific services

set -euo pipefail

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Change to repo root
cd "$REPO_ROOT"

# Load environment variables
if [ -f .env ]; then
    set -a
    source .env
    set +a
fi

# Define all available services
readonly INFRA_SERVICES=(postgres minio redis smtp)
readonly APP_SERVICES=(logichost cameraagent)
readonly ALL_SERVICES=("${INFRA_SERVICES[@]}" "${APP_SERVICES[@]}")

clean_cameraagent_data() {
    mkdir -p data/cameraagent/identity data/cameraagent/dataprotection
    rm -f data/cameraagent/identity/* 2>/dev/null || true
    rm -f data/cameraagent/dataprotection/* 2>/dev/null || true
}

# Parse arguments
RESET_SERVICES=()

if [[ $# -eq 0 ]]; then
    echo -e "${RED}Error: No services specified${NC}"
    echo "Usage: $0 [all|SERVICE...]"
    echo "Available services: ${ALL_SERVICES[*]}"
    exit 1
fi

for arg in "$@"; do
    if [[ "$arg" == "all" ]]; then
        RESET_SERVICES=("${ALL_SERVICES[@]}")
    else
        RESET_SERVICES+=("$arg")
    fi
done

# Function to get docker context for a service
get_docker_context() {
    local service="$1"
    local context_var=""
    
    case "$service" in
        postgres)
            context_var="${POSTGRES_DOCKER_CONTEXT:-proxmox-home}"
            ;;
        minio)
            context_var="${MINIO_DOCKER_CONTEXT:-proxmox-home}"
            ;;
        redis)
            context_var="${REDIS_DOCKER_CONTEXT:-proxmox-home}"
            ;;
        smtp)
            context_var="${SMTP_DOCKER_CONTEXT:-proxmox-home}"
            ;;
        logichost)
            context_var="${LOGICHOST_DOCKER_CONTEXT:-default}"
            ;;
        cameraagent)
            context_var="${CAMERAAGENT_DOCKER_CONTEXT:-default}"
            ;;
        
        *)
            context_var="default"
            ;;
    esac
    
    echo "$context_var"
}

get_compose_file() {
    local service="$1"
    case "$service" in
        postgres|minio|redis|smtp) echo "docker-compose.infrastructure.yml" ;;
        logichost|cameraagent) echo "docker-compose.apps.yml" ;;
        *) echo "docker-compose.infrastructure.yml" ;;
    esac
}

sanitize_context_name() {
    local context="${1:-default}"
    context="${context^^}"
    context="${context//[^A-Z0-9]/_}"
    if [[ -z "$context" ]]; then
        context="DEFAULT"
    fi
    printf '%s' "$context"
}

resolve_context_value() {
    local base_key="$1"
    local context="$2"
    local default_value="${3:-}"

    local sanitized_context
    sanitized_context="$(sanitize_context_name "$context")"
    local context_key="${base_key}_${sanitized_context}"

    if [[ -n "${!context_key:-}" ]]; then
        printf '%s' "${!context_key}"
        return
    fi

    if [[ -n "${!base_key:-}" ]]; then
        printf '%s' "${!base_key}"
        return
    fi

    if [[ -n "$default_value" ]]; then
        printf '%s' "$default_value"
        return
    fi

    printf '%s' ""
}

ensure_cameraagent_networking() {
    local context="${1:-default}"
    export CAMERA_AGENT_LOGIC_BASEURL
    export CAMERA_AGENT_IDENTITY_URL

    CAMERA_AGENT_LOGIC_BASEURL="$(resolve_context_value "CAMERA_AGENT_LOGIC_BASEURL" "$context" "http://logichost:8080")"
    CAMERA_AGENT_IDENTITY_URL="$(resolve_context_value "CAMERA_AGENT_IDENTITY_URL" "$context" "http://logichost:8080")"
}

# Function to reset service data
reset_service() {
    local service="$1"
    local context
    local compose_file
    context="$(get_docker_context "$service")"
    compose_file="$(get_compose_file "$service")"
    
    echo -e "${YELLOW}Resetting $service data...${NC}"
    
    case "$service" in
        postgres|minio|redis)
            docker --context "$context" compose -f "$compose_file" stop "$service" 2>/dev/null || true
            docker --context "$context" compose -f "$compose_file" rm -f "$service" 2>/dev/null || true
            
            # Remove the volume
            local volume_name="skymonitor-${service}-data"
            if docker --context "$context" volume ls --format '{{.Name}}' | grep -q "^${volume_name}$"; then
                docker --context "$context" volume rm "$volume_name"
                echo -e "${GREEN}✓ Removed volume: $volume_name${NC}"
            else
                echo -e "${BLUE}ℹ Volume not found: $volume_name${NC}"
            fi
            
            echo -e "${GREEN}✓ Reset $service data${NC}"
            ;;
        smtp)
            docker --context "$context" compose -f "$compose_file" rm -f "$service" 2>/dev/null || true
            echo -e "${GREEN}✓ Reset $service (removed container)${NC}"
            ;;
        logichost|cameraagent)
            docker --context "$context" compose -f "$compose_file" rm -f "$service" 2>/dev/null || true
            if [[ "$service" == "cameraagent" ]]; then
                ensure_cameraagent_networking "$context"
                clean_cameraagent_data
            fi
            docker --context "$context" compose -f "$compose_file" build "$service"
            echo -e "${GREEN}✓ Reset $service (removed container and rebuilt image)${NC}"
            ;;
        *)
            echo -e "${RED}Unknown service: $service${NC}"
            return 1
            ;;
    esac
}

# Confirm action
echo -e "${YELLOW}This will reset the following services:${NC}"
for service in "${RESET_SERVICES[@]}"; do
    echo "  - $service"
done
echo ""
read -p "Are you sure? (y/N) " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo -e "${BLUE}Reset cancelled${NC}"
    exit 0
fi

# Reset services
echo -e "${BLUE}=== Resetting Services ===${NC}"
for service in "${RESET_SERVICES[@]}"; do
    reset_service "$service"
done

echo ""
echo -e "${GREEN}=== Reset Complete ===${NC}"
echo "Use './scripts/infra:start' to start the services again"
