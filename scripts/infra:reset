#!/usr/bin/env bash
# infra:reset - Reset infrastructure and application service data
# Usage: ./scripts/infra:reset [all|SERVICE...]
# Examples:
#   ./scripts/infra:reset all              # Reset all services
#   ./scripts/infra:reset postgres minio   # Reset specific services

set -euo pipefail

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Change to repo root
cd "$REPO_ROOT"

# Load environment variables
if [ -f .env ]; then
    set -a
    source .env
    set +a
fi

# Define all available services
readonly INFRA_SERVICES=(postgres minio redis smtp)
readonly APP_SERVICES=(skymonitor cameraagent-sim cameraagent-zwo)
readonly ALL_SERVICES=("${INFRA_SERVICES[@]}" "${APP_SERVICES[@]}")

# Parse arguments
RESET_SERVICES=()

if [[ $# -eq 0 ]]; then
    echo -e "${RED}Error: No services specified${NC}"
    echo "Usage: $0 [all|SERVICE...]"
    echo "Available services: ${ALL_SERVICES[*]}"
    exit 1
fi

for arg in "$@"; do
    if [[ "$arg" == "all" ]]; then
        RESET_SERVICES=("${ALL_SERVICES[@]}")
    else
        RESET_SERVICES+=("$arg")
    fi
done

# Function to get docker context for a service
get_docker_context() {
    local service="$1"
    local context_var=""
    
    case "$service" in
        postgres)
            context_var="${POSTGRES_DOCKER_CONTEXT:-default}"
            ;;
        minio)
            context_var="${MINIO_DOCKER_CONTEXT:-default}"
            ;;
        redis)
            context_var="${REDIS_DOCKER_CONTEXT:-default}"
            ;;
        smtp)
            context_var="${SMTP_DOCKER_CONTEXT:-default}"
            ;;
        skymonitor)
            context_var="${SKYMONITOR_DOCKER_CONTEXT:-default}"
            ;;
        cameraagent-sim)
            context_var="${CAMERAAGENT_SIM_DOCKER_CONTEXT:-default}"
            ;;
        cameraagent-zwo)
            context_var="${CAMERAAGENT_ZWO_DOCKER_CONTEXT:-default}"
            ;;
        *)
            context_var="default"
            ;;
    esac
    
    echo "$context_var"
}

# Function to reset service data
reset_service() {
    local service="$1"
    local context
    context="$(get_docker_context "$service")"
    
    echo -e "${YELLOW}Resetting $service data...${NC}"
    
    case "$service" in
        postgres|minio|redis)
            # Stop the service if running
            docker --context "$context" compose -f docker-compose.dev.yml stop "$service" 2>/dev/null || true
            
            # Remove the container
            docker --context "$context" compose -f docker-compose.dev.yml rm -f "$service" 2>/dev/null || true
            
            # Remove the volume
            local volume_name="skymonitor-${service}-data"
            if docker --context "$context" volume ls --format '{{.Name}}' | grep -q "^${volume_name}$"; then
                docker --context "$context" volume rm "$volume_name"
                echo -e "${GREEN}✓ Removed volume: $volume_name${NC}"
            else
                echo -e "${BLUE}ℹ Volume not found: $volume_name${NC}"
            fi
            
            echo -e "${GREEN}✓ Reset $service data${NC}"
            ;;
        smtp)
            # MailHog doesn't persist data, just remove and restart
            docker --context "$context" compose -f docker-compose.dev.yml rm -f "$service" 2>/dev/null || true
            echo -e "${GREEN}✓ Reset $service (removed container)${NC}"
            ;;
        skymonitor|cameraagent-sim|cameraagent-zwo)
            # Application containers - remove container and rebuild
            docker --context "$context" compose -f docker-compose.dev.yml rm -f "$service" 2>/dev/null || true
            echo -e "${GREEN}✓ Reset $service (removed container)${NC}"
            ;;
        *)
            echo -e "${RED}Unknown service: $service${NC}"
            return 1
            ;;
    esac
}

# Confirm action
echo -e "${YELLOW}This will reset the following services:${NC}"
for service in "${RESET_SERVICES[@]}"; do
    echo "  - $service"
done
echo ""
read -p "Are you sure? (y/N) " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo -e "${BLUE}Reset cancelled${NC}"
    exit 0
fi

# Reset services
echo -e "${BLUE}=== Resetting Services ===${NC}"
for service in "${RESET_SERVICES[@]}"; do
    reset_service "$service"
done

echo ""
echo -e "${GREEN}=== Reset Complete ===${NC}"
echo "Use './scripts/infra:start' to start the services again"
