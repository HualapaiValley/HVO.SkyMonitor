#!/usr/bin/env bash
set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly HARNESS="$SCRIPT_DIR/test:deploy-environment"
WORK_ROOT="$(mktemp -d -t hvo-deploy-cli-test.XXXXXX)"
readonly WORK_ROOT
trap 'rm -rf "$WORK_ROOT"' EXIT

expected_shards=$'preflight\nprepare-images\nexisting-catalog-up\nbootstrap-authority\nbootstrap-credentials\nsmoke\nmeasure\nexisting-down\ndeploy-services'
actual_shards="$($HARNESS --list-shards)"
[[ "$actual_shards" == "$expected_shards" ]] || {
    printf 'Deployment shard listing did not match the closed contract.\n' >&2
    exit 1
}

for arguments in '--unknown' '--list-shards extra' '--parallel extra' '--shard' '--shard unknown' '--shard preflight extra' '--shard preflight --shard preflight'; do
    read -r -a fields <<< "$arguments"
    if "$HARNESS" "${fields[@]}" > "$WORK_ROOT/invalid.log" 2>&1; then
        printf 'Deployment harness accepted invalid arguments: %s\n' "$arguments" >&2
        exit 1
    fi
done

for invalid_limit in 0 9 -1 1.5 unlimited; do
    if DEPLOY_TEST_MAX_PARALLEL="$invalid_limit" "$HARNESS" --parallel > "$WORK_ROOT/invalid-limit.log" 2>&1; then
        printf 'Deployment coordinator accepted invalid worker limit: %s\n' "$invalid_limit" >&2
        exit 1
    fi
done

started_at=$SECONDS
if DEPLOY_TEST_LOG_DIR="$WORK_ROOT/hang-logs" DEPLOY_TEST_MAX_PARALLEL=2 DEPLOY_TEST_TERM_GRACE_SECONDS=1 \
    DEPLOY_TEST_COORDINATOR_HANG_SHARD=prepare-images DEPLOY_TEST_COORDINATOR_FAIL_SHARD=preflight \
    DEPLOY_TEST_EARLY_FAIL_DELAY_SECONDS=1 "$HARNESS" --parallel > "$WORK_ROOT/coordinator.log" 2>&1; then
    printf 'Deployment shard coordinator accepted an injected child failure.\n' >&2
    exit 1
else
    status=$?
fi
[[ "$status" -eq 97 ]]
(( SECONDS - started_at <= 10 )) || { printf 'Deployment coordinator did not return boundedly.\n' >&2; exit 1; }
run_dirs=("$WORK_ROOT/hang-logs"/*)
[[ "${#run_dirs[@]}" -eq 1 && -d "${run_dirs[0]}" ]]
run_dir="${run_dirs[0]}"
grep -Fq 'Injected early failure for deployment contract shard preflight.' "$WORK_ROOT/coordinator.log"
grep -Fq 'Deployment contract shards failed' "$WORK_ROOT/coordinator.log"
grep -Eq '^failed elapsed_seconds=[0-9]+$' "$run_dir/preflight.status"
grep -Eq '^terminated elapsed_seconds=[0-9]+$' "$run_dir/prepare-images.status"
for shard in existing-catalog-up bootstrap-authority bootstrap-credentials smoke measure existing-down deploy-services; do
    grep -Eq '^not-started elapsed_seconds=[0-9]+$' "$run_dir/$shard.status"
    grep -Fq 'Shard was not started because another shard failed.' "$run_dir/$shard.log"
done
hang_leader="$(<"$run_dir/prepare-images.leader.pid")"
hang_descendant="$(<"$run_dir/prepare-images.descendant.pid")"
if kill -0 "$hang_leader" 2>/dev/null || kill -0 -- "-$hang_leader" 2>/dev/null || kill -0 "$hang_descendant" 2>/dev/null; then
    printf 'Deployment coordinator left a shard leader or descendant running.\n' >&2
    exit 1
fi

isolation_pids=()
for invocation in first second; do
    DEPLOY_TEST_LOG_DIR="$WORK_ROOT/isolation-logs" DEPLOY_TEST_MAX_PARALLEL=1 DEPLOY_TEST_TERM_GRACE_SECONDS=1 \
        DEPLOY_TEST_COORDINATOR_FAIL_SHARD=preflight "$HARNESS" --parallel > "$WORK_ROOT/$invocation.log" 2>&1 &
    isolation_pids+=("$!")
done
for isolation_pid in "${isolation_pids[@]}"; do
    if wait "$isolation_pid"; then
        printf 'Concurrent deployment coordinator accepted an injected failure.\n' >&2
        exit 1
    else
        [[ "$?" -eq 97 ]]
    fi
done
isolation_dirs=("$WORK_ROOT/isolation-logs"/*)
[[ "${#isolation_dirs[@]}" -eq 2 ]]
[[ "${isolation_dirs[0]}" != "${isolation_dirs[1]}" ]]
for isolation_dir in "${isolation_dirs[@]}"; do
    grep -Eq '^failed elapsed_seconds=[0-9]+$' "$isolation_dir/preflight.status"
    grep -Fq 'Injected early failure for deployment contract shard preflight.' "$isolation_dir/preflight.log"
done

printf 'Deployment contract CLI and coordinator tests passed.\n'
