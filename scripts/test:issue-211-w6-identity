    fail 'terminal verifier accepted evidence mutated after replay final'

cp -R "$WORK/terminal-control" "$WORK/terminal-missing-manifest"
jq 'del(.retainedOutputs[] | select(.path == ".unrelated-retained.txt")) |
    .totalBytes = ([.retainedOutputs[].bytes] | add // 0)' \
