campaign_contract "$WORK/campaign" && fail 'campaign accepted LocalRunner scan demanding a first deployment-location write'
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
sed -i 's/            . == (if $replayProfile == "LocalRunner" then 7302 else 7301 end))}/            . == 7302)}/' "$WORK/campaign"
campaign_contract "$WORK/campaign" && fail 'campaign accepted InProcess scan without the first deployment-location write'
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
