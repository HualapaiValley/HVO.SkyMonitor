campaign_contract "$WORK/campaign" && fail 'campaign accepted missing replay runtime health evidence'
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
sed -i '/issue-719-replay-process-snapshot-v1/d' "$WORK/campaign"
campaign_contract "$WORK/campaign" && fail 'campaign accepted missing replay process snapshot evidence'
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
sed -i '/replay_process_containers+=("hvo211-\$suffix-replay")/d' "$WORK/campaign"
campaign_contract "$WORK/campaign" && fail 'campaign accepted LocalRunner process snapshot without replay runner'
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
sed -i '/replay_stats=.*docker stats/d' "$WORK/campaign"
campaign_contract "$WORK/campaign" && fail 'campaign accepted docker stats sampling only CameraAgent'
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
sed -i '/rm -f "$trial_result\/evidence\/.process-names"/d' "$WORK/campaign"
campaign_contract "$WORK/campaign" && fail 'campaign accepted process snapshot temporary files in retained evidence'
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
sed -i 's/if (($# != 15)); then/if (($# < 14)); then/' "$WORK/campaign"
campaign_contract "$WORK/campaign" && fail 'campaign accepted removal of the exact 15-argument boundary'
run_profile_trial_boundary_matches "$WORK/campaign" &&
    fail 'behavioral boundary guard accepted removal of the exact 15-argument check'
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
sed -i "/'replay-localrunner'/,/    'replay'$/ { /    'replay'$/d; }" "$WORK/campaign"
campaign_contract "$WORK/campaign" && fail 'campaign accepted removal of argument 15 from a call'
# LocalRunner telemetry scan mutations (#959): dropping the runner scope, its job counter, the
# transfer unit, the profile-keyed deployment-location event, or the InProcess capture path.
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
sed -i 's/"HVO.SkyMonitor.CameraAgent.ProcessingGraph", "HVO.SkyMonitor.CameraAgent.ReplayRunner"\]/"HVO.SkyMonitor.CameraAgent.ProcessingGraph"]/' "$WORK/campaign"
campaign_contract "$WORK/campaign" && fail 'campaign accepted LocalRunner scan without the replay runner scope'
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
sed -i 's/            "camera_agent.replay_runner.jobs", "camera_agent.replay_runner.dispatch.duration",/            "camera_agent.replay_runner.dispatch.duration",/' "$WORK/campaign"
campaign_contract "$WORK/campaign" && fail 'campaign accepted LocalRunner scan without the replay runner job counter'
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
sed -i '/         "camera_agent.replay_runner.transfer.bytes": "By"$/d' "$WORK/campaign"
sed -i 's/         "camera_agent.replay_runner.execution.duration": "s",$/         "camera_agent.replay_runner.execution.duration": "s"/' "$WORK/campaign"
campaign_contract "$WORK/campaign" && fail 'campaign accepted LocalRunner scan without the transfer byte unit'
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
