campaign_contract "$WORK/campaign" && fail 'campaign accepted the LocalRunner requirement set applied to InProcess'
for dead_condition in 'false' '((0))' '((1 == 0))' '[ 0 -eq 1 ]' '[[ 0 == 1 ]]' '[[ "$trial" == never ]]'; do
    cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
    sed -i "/replay_profile_post_test_gate /i\\        if $dead_condition; then" "$WORK/campaign"
    sed -i "/replay_profile_post_test_gate /a\\        fi" "$WORK/campaign"
    campaign_contract "$WORK/campaign" &&
        fail "campaign accepted replay post-test gate wrapped in if $dead_condition"

    cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
    sed -i "/^        emit_replay_pair_summary \\\\/i\\        if $dead_condition; then" "$WORK/campaign"
    sed -i "/replay_atomic_copy \"\$pair_summary\"/a\\        fi" "$WORK/campaign"
    campaign_contract "$WORK/campaign" &&
        fail "campaign accepted replay pair publication wrapped in if $dead_condition"
done

# Source reachability is only the first layer: a skipped post-test emitter leaves no receipt,
# and the artifact-level terminal gate above proves that state cannot reach acceptance.
cp -R "$WORK/terminal-control" "$WORK/terminal-dead-emitter-effect"
rm -f -- "$WORK/terminal-dead-emitter-effect/replay-inprocess/evidence/replay-profile-gate.json"
terminal_replay_gate "$WORK/terminal-dead-emitter-effect" >/dev/null 2>&1 &&
    fail 'terminal verifier accepted the artifact effect of a dead-wrapped profile emitter'
printf 'Replay evidence and driver contract: controls accepted, all mutations refused.\n'
