sed -i "/'replay-inprocess'/,/'replay-localrunner'/ s/    'SWAPPED'/    'replay'/" "$WORK/campaign"
campaign_contract "$WORK/campaign" && fail 'campaign accepted swapped retain-state/trial-kind arguments'
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
sed -i "/'replay-localrunner'/,/    'replay'$/ s/    'LocalRunner'/    'InProcess'/" "$WORK/campaign"
campaign_contract "$WORK/campaign" && fail 'campaign accepted wrong LocalRunner profile argument'
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
sed -i '/rm -rf -- "$trial_local\/telemetry"/d' "$WORK/campaign"
campaign_contract "$WORK/campaign" && fail 'campaign accepted missing telemetry isolation reset'
cp "$CAMPAIGN_SCRIPT" "$WORK/campaign"
