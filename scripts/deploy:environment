#!/usr/bin/env bash
# Split-host deployment entry point.

set -euo pipefail
export LC_ALL=C

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly REPO_ROOT
# shellcheck source=scripts/deploy/common.sh
. "$SCRIPT_DIR/deploy/common.sh"
# shellcheck source=scripts/deploy/inventory.sh
. "$SCRIPT_DIR/deploy/inventory.sh"
# shellcheck source=scripts/deploy/transport.sh
. "$SCRIPT_DIR/deploy/transport.sh"
# shellcheck source=scripts/deploy/run-state.sh
. "$SCRIPT_DIR/deploy/run-state.sh"
# shellcheck source=scripts/deploy/preflight.sh
. "$SCRIPT_DIR/deploy/preflight.sh"
# shellcheck source=scripts/deploy/prepare.sh
. "$SCRIPT_DIR/deploy/prepare.sh"
# shellcheck source=scripts/deploy/images.sh
. "$SCRIPT_DIR/deploy/images.sh"
# shellcheck source=scripts/deploy/catalog.sh
. "$SCRIPT_DIR/deploy/catalog.sh"
# shellcheck source=scripts/deploy/up.sh
. "$SCRIPT_DIR/deploy/up.sh"
# shellcheck source=scripts/deploy/bootstrap.sh
. "$SCRIPT_DIR/deploy/bootstrap.sh"
# shellcheck source=scripts/deploy/smoke.sh
. "$SCRIPT_DIR/deploy/smoke.sh"
# shellcheck source=scripts/deploy/down.sh
. "$SCRIPT_DIR/deploy/down.sh"
# shellcheck source=scripts/deploy/measure.sh
. "$SCRIPT_DIR/deploy/measure.sh"
# shellcheck source=scripts/deploy/acceptance.sh
. "$SCRIPT_DIR/deploy/acceptance.sh"
# shellcheck source=scripts/deploy/acceptance-campaign.sh
. "$SCRIPT_DIR/deploy/acceptance-campaign.sh"

usage() {
    printf 'Usage: %s <preflight|prepare|images|catalog|up|bootstrap|smoke|measure|acceptance-init|acceptance-record|acceptance-run|down> --inventory <file> --mode <isolated|persistent> [--run-id <id>] [--state-root <absolute-path>] [--evidence-root <absolute-path>] [--workload <W1|W2>] [--scenario <id>] [--artifact <absolute-json-path>] [--preserve-state | --delete-state --confirm <run-id>]\n' "${0##*/}" >&2
    printf '       acceptance-record requires --scenario and --artifact; acceptance-run requires --scenario and forbids --artifact.\n' >&2
    exit 2
}

phase="${1:-}"
[[ "$phase" == preflight || "$phase" == prepare || "$phase" == images || "$phase" == catalog || "$phase" == up || "$phase" == bootstrap || "$phase" == smoke || "$phase" == measure || "$phase" == acceptance-init || "$phase" == acceptance-record || "$phase" == acceptance-run || "$phase" == down ]] || usage
shift
inventory="" mode="" run_id="" state_root="" evidence_root="" down_policy="" confirm="" workload="" scenario="" artifact=""
while (( $# > 0 )); do
    case "$1" in
        --inventory) (( $# >= 2 )) || usage; inventory="$2"; shift 2 ;;
        --mode) (( $# >= 2 )) || usage; mode="$2"; shift 2 ;;
        --run-id) (( $# >= 2 )) || usage; run_id="$2"; shift 2 ;;
        --state-root) (( $# >= 2 )) || usage; state_root="$2"; shift 2 ;;
        --evidence-root) (( $# >= 2 )) || usage; evidence_root="$2"; shift 2 ;;
        --preserve-state) [[ -z "$down_policy" ]] || usage; down_policy=preserve; shift ;;
        --delete-state) [[ -z "$down_policy" ]] || usage; down_policy=delete; shift ;;
        --confirm) (( $# >= 2 )) || usage; confirm="$2"; shift 2 ;;
        --workload) (( $# >= 2 )) || usage; workload="$2"; shift 2 ;;
        --scenario) (( $# >= 2 )) || usage; scenario="$2"; shift 2 ;;
        --artifact) (( $# >= 2 )) || usage; artifact="$2"; shift 2 ;;
        *) usage ;;
    esac
done
[[ -n "$inventory" && ( "$mode" == isolated || "$mode" == persistent ) ]] || usage
if [[ "$phase" == down ]]; then [[ -n "$down_policy" ]] || usage; else [[ -z "$down_policy" && -z "$confirm" ]] || usage; fi
if [[ "$phase" == measure ]]; then [[ "$workload" == W1 || "$workload" == W2 ]] || usage; else [[ -z "$workload" ]] || usage; fi
if [[ "$phase" == acceptance-record || "$phase" == acceptance-run ]]; then
    deploy_is_safe_name "$scenario" || usage
    if [[ "$phase" == acceptance-record ]]; then [[ -n "$artifact" ]] || usage; else [[ -z "$artifact" ]] || usage; fi
else
    [[ -z "$scenario" && -z "$artifact" ]] || usage
fi

# Target selection and credentials must come only from the validated inventory contract.
for ambient_name in ${!DEPLOY_@} ${!SMOKETEST_@}; do
    [[ "$ambient_name" == DEPLOY_TEST_FAILPOINT || "$ambient_name" == DEPLOY_TEST_POLL_SECONDS ]] || unset "$ambient_name"
done
unset DOCKER_HOST DOCKER_CONTEXT SSH_HOST SSH_CONFIG 2>/dev/null || true
unset ambient_name

deploy_require_commands jq git sha256sum stat id realpath dirname mktemp install flock ssh timeout date grep cut awk wc || exit 1
[[ "$phase" == prepare || "$phase" == catalog || "$phase" == acceptance-init || "$phase" == acceptance-record ]] || deploy_require_commands docker || exit 1
[[ "$phase" != images ]] || deploy_require_commands tar mv rm || exit 1
[[ "$phase" != catalog && "$phase" != up && "$phase" != bootstrap && "$phase" != smoke && "$phase" != acceptance-run ]] || deploy_require_commands scp curl sqlite3 wc || exit 1
inventory="$(realpath -e -- "$inventory" 2>/dev/null)" || deploy_fail validate inventory "inventory-not-found"
deploy_validate_inventory "$inventory" "$mode"
deploy_validate_secret_references "$inventory"
expected_revision="$(jq -r '.source.revision' "$inventory")"
actual_revision="$(git -C "$REPO_ROOT" rev-parse HEAD)"
[[ "$actual_revision" == "$expected_revision" ]] || deploy_fail validate source "source-revision-mismatch"
dirty_disposition="$(jq -r '.source.dirtyDisposition' "$inventory")"
worktree_state=clean
[[ -z "$(git -C "$REPO_ROOT" status --porcelain)" ]] || worktree_state=dirty
[[ "$dirty_disposition" == allow-dirty || "$worktree_state" == clean ]] || deploy_fail validate source "dirty-worktree-rejected"
source_tree="$(git -C "$REPO_ROOT" rev-parse "${actual_revision}^{tree}")"
[[ "$source_tree" =~ ^[0-9a-f]{40,64}$ ]] || deploy_fail validate source "source-tree-invalid"
[[ "$phase" != images || "$worktree_state" == clean ]] || deploy_fail validate source "images-require-clean-source"
inventory_hash="$(jq -S -c . "$inventory" | sha256sum)"; inventory_hash="${inventory_hash%% *}"
if [[ -z "$run_id" ]]; then
    [[ "$phase" == preflight ]] || deploy_fail validate run-id "phase-requires-run-id"
    run_id="preflight-$(date -u +%Y%m%dt%H%M%Sz)"
fi
deploy_is_safe_name "$run_id" || deploy_fail validate run-id "unsafe-run-id"
state_root="${state_root:-$REPO_ROOT/TestResults/deploy/$run_id/state}"
evidence_root="${evidence_root:-$REPO_ROOT/TestResults/deploy/$run_id/evidence}"
deploy_prepare_run_state "$state_root" "$evidence_root"
deploy_transport_initialize_private_upload_registry "$state_root/private-upload-registry.json" "$inventory" "$phase" ||
  deploy_fail state private-upload-registry invalid

if [[ "$phase" == prepare ]]; then
    # shellcheck disable=SC2317 # Invoked indirectly by the ERR trap.
    deploy_prepare_mark_failed() {
        local status="${1:-$?}" now
        trap - ERR
        now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        if [[ -n "${DEPLOY_PREPARE_LEDGER_JSON:-}" && -n "${DEPLOY_PREPARE_LEDGER:-}" ]]; then
            DEPLOY_PREPARE_LEDGER_JSON="$(jq -c --arg now "$now" '.phaseStatus="failed" | .updatedAt=$now' <<< "$DEPLOY_PREPARE_LEDGER_JSON")"
            deploy_publish_json "$DEPLOY_PREPARE_LEDGER" "$DEPLOY_PREPARE_LEDGER_JSON" >/dev/null 2>&1 || true
        fi
        if [[ -n "${DEPLOY_PREPARE_MANIFEST_JSON:-}" && -n "${DEPLOY_PREPARE_MANIFEST:-}" ]]; then
            DEPLOY_PREPARE_MANIFEST_JSON="$(jq -c --arg now "$now" '.phaseStatus="failed" | .updatedAt=$now' <<< "$DEPLOY_PREPARE_MANIFEST_JSON")"
            [[ -z "${DEPLOY_PREPARE_EVIDENCE:-}" ]] || deploy_publish_json "$DEPLOY_PREPARE_EVIDENCE" "$(deploy_prepare_evidence_json "$DEPLOY_PREPARE_MANIFEST_JSON")" >/dev/null 2>&1 || true
            deploy_publish_json "$DEPLOY_PREPARE_MANIFEST" "$DEPLOY_PREPARE_MANIFEST_JSON" >/dev/null 2>&1 || true
        fi
        exit "$status"
    }
    trap deploy_prepare_mark_failed ERR
    if ! deploy_run_prepare "$inventory" "$run_id" "$mode" "$inventory_hash" "$actual_revision" "$worktree_state"; then
        deploy_prepare_mark_failed 1
    fi
    trap - ERR
    deploy_status prepare complete passed prepared
    exit 0
fi

if [[ "$phase" == images ]]; then
    # shellcheck disable=SC2317 # Invoked indirectly by the ERR trap.
    deploy_images_mark_failed() {
        local status="${1:-$?}" now
        trap - ERR
        now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        if [[ "${DEPLOY_IMAGES_STATE_ACCEPTED:-false}" == true && -n "${DEPLOY_IMAGES_LEDGER_JSON:-}" && -n "${DEPLOY_IMAGES_LEDGER:-}" ]]; then
            DEPLOY_IMAGES_LEDGER_JSON="$(jq -c --arg now "$now" '.phaseStatus="failed" | .updatedAt=$now | del(.completedAt)' <<< "$DEPLOY_IMAGES_LEDGER_JSON")"
            [[ -z "${DEPLOY_IMAGES_EVIDENCE:-}" ]] || deploy_publish_json "$DEPLOY_IMAGES_EVIDENCE" \
              "$(jq -c '{schemaVersion,runId,mode,inventorySha256,sourceRevision,sourceTree,builder,distributionMode,phaseStatus,startedAt,updatedAt,
                images:[.images[] | del(.archivePath)],targets}' <<< "$DEPLOY_IMAGES_LEDGER_JSON")" >/dev/null 2>&1 || true
            deploy_publish_json "$DEPLOY_IMAGES_LEDGER" "$DEPLOY_IMAGES_LEDGER_JSON" >/dev/null 2>&1 || true
            [[ -z "${DEPLOY_IMAGES_MANIFEST:-}" ]] || deploy_publish_json "$DEPLOY_IMAGES_MANIFEST" "$DEPLOY_IMAGES_LEDGER_JSON" >/dev/null 2>&1 || true
        fi
        exit "$status"
    }
    trap deploy_images_mark_failed ERR
    if ! deploy_run_images "$inventory" "$run_id" "$mode" "$inventory_hash" "$actual_revision" "$worktree_state" "$source_tree"; then
        deploy_images_mark_failed 1
    fi
    trap - ERR
    deploy_status images complete passed distributed
    exit 0
fi

if [[ "$phase" == catalog ]]; then
    trap 'deploy_catalog_mark_failed $?' ERR
    if ! deploy_run_catalog "$inventory" "$run_id" "$mode" "$inventory_hash" "$actual_revision" "$worktree_state"; then
        deploy_catalog_mark_failed 1
        exit 1
    fi
    trap - ERR
    deploy_status catalog complete passed installed
    exit 0
fi

if [[ "$phase" == up ]]; then
    trap 'deploy_up_mark_failed $?' ERR
    if ! deploy_run_up "$inventory" "$run_id" "$mode" "$inventory_hash" "$actual_revision" "$worktree_state"; then
        deploy_up_mark_failed 1
        exit 1
    fi
    deploy_transport_reconcile_private_uploads strict
    trap - ERR
    deploy_status up complete passed ready
    exit 0
fi

if [[ "$phase" == bootstrap ]]; then
    trap 'deploy_bootstrap_mark_failed $?' ERR
    if ! deploy_run_bootstrap "$inventory" "$run_id" "$mode" "$inventory_hash" "$actual_revision" "$worktree_state"; then
        deploy_bootstrap_mark_failed 1
        exit 1
    fi
    trap - ERR
    deploy_status bootstrap complete passed ready
    exit 0
fi

if [[ "$phase" == smoke ]]; then
    trap 'deploy_smoke_mark_failed $?' ERR
    if ! deploy_run_smoke "$inventory" "$run_id" "$mode" "$inventory_hash" "$actual_revision" "$worktree_state"; then
        deploy_smoke_mark_failed 1
        exit 1
    fi
    trap - ERR
    deploy_status smoke complete passed converged
    exit 0
fi

if [[ "$phase" == down ]]; then
    trap 'deploy_down_mark_failed $?' ERR
    if ! deploy_run_down "$inventory" "$run_id" "$mode" "$inventory_hash" "$actual_revision" "$worktree_state" "$down_policy" "$confirm"; then
        deploy_down_mark_failed 1
        exit 1
    fi
    trap - ERR
    deploy_status down complete passed "$down_policy"
    exit 0
fi

if [[ "$phase" == measure ]]; then
    trap 'deploy_measure_mark_failed $?' ERR
    if ! deploy_run_measure "$inventory" "$run_id" "$mode" "$inventory_hash" "$actual_revision" "$worktree_state" "$workload"; then
        deploy_measure_mark_failed 1
        exit 1
    fi
    trap - ERR
    deploy_status measure complete passed "$workload"
    exit 0
fi

if [[ "$phase" == acceptance-init ]]; then
    if ! deploy_run_acceptance "$inventory" "$run_id" "$mode" "$inventory_hash" "$actual_revision" "$worktree_state" "$source_tree"; then
        exit 1
    fi
    deploy_status acceptance-init complete passed campaign-index-initialized
    exit 0
fi

if [[ "$phase" == acceptance-record ]]; then
    [[ ! -L "$artifact" ]] || deploy_fail validate artifact artifact-symlink-rejected
    artifact="$(realpath -e -- "$artifact" 2>/dev/null)" || deploy_fail validate artifact artifact-not-found
    if ! deploy_run_acceptance_record "$inventory" "$run_id" "$mode" "$inventory_hash" "$actual_revision" "$worktree_state" "$source_tree" "$scenario" "$artifact"; then
        exit 1
    fi
    deploy_status acceptance-record "$scenario" passed artifact-recorded
    exit 0
fi

if [[ "$phase" == acceptance-run ]]; then
    trap 'deploy_acceptance_campaign_mark_failed $?' ERR
    trap 'deploy_acceptance_campaign_mark_failed 130; exit 130' INT TERM
    if ! deploy_run_acceptance_campaign "$inventory" "$run_id" "$mode" "$inventory_hash" "$actual_revision" "$worktree_state" "$source_tree" "$scenario"; then
        deploy_acceptance_campaign_mark_failed 1
        exit 1
    fi
    trap - ERR INT TERM
    deploy_status acceptance-run "$scenario" passed converged
    exit 0
fi

started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
old_manifest=""
if [[ -e "$DEPLOY_MANIFEST" || -L "$DEPLOY_MANIFEST" ]]; then
    [[ -f "$DEPLOY_MANIFEST" && ! -L "$DEPLOY_MANIFEST" && "$(stat -c '%u' "$DEPLOY_MANIFEST" 2>/dev/null)" == "$(id -u)" && "$(stat -c '%h' "$DEPLOY_MANIFEST" 2>/dev/null)" == 1 &&
       "$(stat -c '%a' "$DEPLOY_MANIFEST" 2>/dev/null)" == 600 ]] ||
        deploy_fail state manifest "unsafe-existing-manifest"
    previous_manifest="$(jq -c . "$DEPLOY_MANIFEST" 2>/dev/null)" || deploy_fail state manifest "invalid-existing-manifest"
    deploy_require_resume_match "$DEPLOY_MANIFEST" "$run_id" "$mode" "$inventory_hash" "$actual_revision" "$worktree_state"
    deploy_require_completed_evidence_match "$previous_manifest" "$DEPLOY_EVIDENCE"
    if [[ "$(jq -r '.phaseStatus' <<< "$previous_manifest")" == passed ]]; then old_manifest="$previous_manifest"; fi
    DEPLOY_MANIFEST_JSON="$(jq -c '.phaseStatus="running" | .checks=[] | .targets=[] | del(.completedAt)' <<< "$previous_manifest")"
else
    DEPLOY_MANIFEST_JSON="$(deploy_initial_manifest "$run_id" "$mode" "$inventory_hash" "$actual_revision" "$dirty_disposition" "$started")"
    DEPLOY_MANIFEST_JSON="$(jq -c --arg state "$worktree_state" '.source.worktreeState=$state' <<< "$DEPLOY_MANIFEST_JSON")"
fi
deploy_publish_json "$DEPLOY_MANIFEST" "$DEPLOY_MANIFEST_JSON" || deploy_fail state manifest "atomic-publication-failed"
deploy_clear_evidence
deploy_mark_failed() {
    local status=$?
    trap - ERR
    DEPLOY_MANIFEST_JSON="$(jq -c --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.phaseStatus="failed" | .updatedAt=$now' <<< "$DEPLOY_MANIFEST_JSON")"
    deploy_publish_json "$DEPLOY_EVIDENCE" "$(deploy_evidence_json "$DEPLOY_MANIFEST_JSON")" >/dev/null 2>&1 || true
    deploy_publish_json "$DEPLOY_MANIFEST" "$DEPLOY_MANIFEST_JSON" >/dev/null 2>&1 || true
    exit "$status"
}
trap deploy_mark_failed ERR
deploy_run_preflight "$inventory" "$mode" "$old_manifest"
trap - ERR
deploy_status preflight complete passed read-only
