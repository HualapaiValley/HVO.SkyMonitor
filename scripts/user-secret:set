#!/usr/bin/env bash
# Prompt for one .NET User Secret without placing its value in process arguments.

set -euo pipefail
umask 077

[[ $# -eq 2 ]] || {
    printf 'Usage: %s PROJECT_PATH CONFIGURATION_KEY\n' "$0" >&2
    exit 1
}
command -v jq >/dev/null || {
    printf 'jq is required.\n' >&2
    exit 1
}

readonly PROJECT_PATH="$1"
readonly CONFIGURATION_KEY="$2"
secret_file="$(mktemp -t hvo-user-secret.XXXXXX)"

cleanup() {
    rm -f "$secret_file"
}
trap cleanup EXIT

read -rsp "Value for $CONFIGURATION_KEY: " secret_value
printf '\n'
printf '%s' "$secret_value" > "$secret_file"
unset secret_value

jq -Rn --rawfile value "$secret_file" --arg key "$CONFIGURATION_KEY" \
    '{($key): $value}' | dotnet user-secrets set --project "$PROJECT_PATH"
