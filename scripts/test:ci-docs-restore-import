#!/usr/bin/env bash
set -euo pipefail

# Offline reproduction of restore-generated package imports. Run under the
# shared heavy-gate lock; the package source and all runtime state are local.
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
probe_tmp_dir="${TMPDIR:-/tmp}"
fixture="$(mktemp -d "$probe_tmp_dir/hvo-docs-restore.XXXXXXXX")"
trap 'rm -rf "$fixture"' EXIT
mkdir -p "$fixture/tests/Example" "$fixture/docs/runbooks" "$fixture/packages" "$fixture/scripts" "$fixture/home" "$fixture/xdg" "$fixture/tmp" "$fixture/nuget"
chmod 700 "$fixture" "$fixture/home" "$fixture/xdg" "$fixture/tmp" "$fixture/nuget"
export HOME="$fixture/home" XDG_CONFIG_HOME="$fixture/xdg" TMPDIR="$fixture/tmp" NUGET_PACKAGES="$fixture/nuget"
export MSBUILDDISABLENODEREUSE=1 DOTNET_CLI_USE_MSBUILD_SERVER=0 DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
cp "$repo_root/global.json" "$fixture/global.json"
printf '<Solution><Project Path="tests/Example/Example.csproj" /></Solution>\n' > "$fixture/HVO.SkyMonitor.v9.slnx"
printf '<Project />\n' > "$fixture/tests/Example/Example.csproj"
printf 'restore import fixture\n' > "$fixture/docs/runbooks/releases.md"
cat > "$fixture/NuGet.Config" <<'CONFIG'
<configuration><packageSources><clear /><add key="fixture" value="./packages" /></packageSources><auditSources><clear /></auditSources></configuration>
CONFIG
python3 - "$fixture/packages/Hvo.RestoreFixture.1.0.0.nupkg" <<'PY_PACKAGE'
import sys, zipfile
nuspec = '''<?xml version="1.0"?><package><metadata><id>Hvo.RestoreFixture</id><version>1.0.0</version><authors>fixture</authors><description>Offline fixture</description></metadata></package>'''
targets = '''<Project><ItemGroup><None Include="$(MSBuildProjectDirectory)/../../docs/runbooks/releases.md" Link="fixture-runbook.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup></Project>'''
with zipfile.ZipFile(sys.argv[1], 'w') as archive:
    archive.writestr('Hvo.RestoreFixture.nuspec', nuspec)
    archive.writestr('build/Hvo.RestoreFixture.targets', targets)
PY_PACKAGE
git -C "$fixture" init -q
git -C "$fixture" config user.name 'CI fixture'
git -C "$fixture" config user.email fixture@example.invalid
git -C "$fixture" add global.json NuGet.Config HVO.SkyMonitor.v9.slnx tests/Example/Example.csproj docs/runbooks/releases.md
git -C "$fixture" commit -qm base
(cd "$fixture" && "$repo_root/scripts/ci:classify" --print-docs-inventory HEAD) > "$fixture/scripts/ci:docs-inventory"
git -C "$fixture" add scripts/ci:docs-inventory && git -C "$fixture" commit -qm certificate
printf '<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup><ItemGroup><PackageReference Include="Hvo.RestoreFixture" Version="1.0.0" /></ItemGroup></Project>\n' > "$fixture/tests/Example/Example.csproj"
git -C "$fixture" add tests/Example/Example.csproj && git -C "$fixture" commit -qm package
base="$(git -C "$fixture" rev-parse HEAD)"
if (cd "$fixture" && "$repo_root/scripts/ci:classify" --print-docs-inventory "$base") > "$fixture/unsafe" 2> "$fixture/audit-error"; then
  printf 'Restore-generated package import was certified.\n' >&2; exit 1
fi
grep -Fxq 'docs inventory audit: restore generated package imports are uncertified' "$fixture/audit-error"
printf 'changed by documentation PR\n' >> "$fixture/docs/runbooks/releases.md"
git -C "$fixture" add docs/runbooks/releases.md && git -C "$fixture" commit -qm doc
head="$(git -C "$fixture" rev-parse HEAD)"
output="$(cd "$fixture" && "$repo_root/scripts/ci:classify" pull_request "$base" "$head" docs-fast-only)"
grep -Fxq 'docs_fast_path=false' <<< "$output"
grep -Fxq 'docs_fast_path_reason=project inventory unavailable' <<< "$output"
(cd "$fixture" && dotnet restore HVO.SkyMonitor.v9.slnx > "$fixture/restore.log" 2>&1)
grep -Fq 'Hvo.RestoreFixture.targets' "$fixture/tests/Example/obj/Example.csproj.nuget.g.targets"
(cd "$fixture" && dotnet build tests/Example/Example.csproj --disable-build-servers --no-restore --configuration Release > "$fixture/build.log" 2>&1)
cmp "$fixture/docs/runbooks/releases.md" "$fixture/tests/Example/bin/Release/net10.0/fixture-runbook.md"
printf 'Offline restore-import regression passed: local package imported and copied the runbook; classifier selected full validation.\n'

# Replace the unsafe package with a benign import under the same identity. A
# fresh cache per replay makes the repository-local source the only package feed.
package=packages/Hvo.RestoreFixture.1.0.0.nupkg
python3 - "$fixture/$package" <<'PY'
import sys
from zipfile import ZipFile

path = sys.argv[1]
with ZipFile(path) as archive:
    nuspec = archive.read("Hvo.RestoreFixture.nuspec")
with ZipFile(path, "w") as archive:
    archive.writestr("Hvo.RestoreFixture.nuspec", nuspec)
    archive.writestr("build/Hvo.RestoreFixture.targets", '<Project><PropertyGroup><FixtureImported>true</FixtureImported></PropertyGroup></Project>')
PY
mkdir -p "$fixture/scripts/ci"
cp "$repo_root/scripts/ci/restore-imports.py" "$fixture/scripts/ci/restore-imports.py"
cp "$repo_root/scripts/ci:classify" "$fixture/scripts/ci:classify"
git -C "$fixture" add -- "$package" scripts/ci/restore-imports.py scripts/ci:classify
git -C "$fixture" commit -qm 'benign package and trusted proof code'

certificate=scripts/ci:restore-import-certificate.json
run_fresh() {
  local cache
  cache="$(mktemp -d "$fixture/cache.XXXXXXXX")"
  (cd "$fixture" && TMPDIR="$probe_tmp_dir" NUGET_PACKAGES="$cache${fixture_cache_suffix:-}" "$@")
}
classify() {
  (cd "$fixture" && bash scripts/ci:classify "$@")
}
classify --print-docs-restore-source HEAD > "$fixture/scripts/ci:docs-inventory"
source_hash="$(sha256sum < "$fixture/scripts/ci:docs-inventory")"
run_fresh python3 -I scripts/ci/restore-imports.py capture HEAD "${source_hash%% *}" > "$fixture/$certificate"
git -C "$fixture" add -- "$certificate" scripts/ci:docs-inventory
git -C "$fixture" commit -qm 'certify the benign restore graph'
reviewed="$(git -C "$fixture" rev-parse HEAD)"
grep -Fxq 'Documentation CI build inventory is current and audited.' <<< "$(classify --check-docs-inventory "$reviewed")"
printf 'safe edit\n' >> "$fixture/docs/runbooks/releases.md"
git -C "$fixture" commit -qam 'safe certified documentation edit'
doc="$(git -C "$fixture" rev-parse HEAD)"
grep -Fxq 'docs_fast_path=verify-restore' <<< "$(classify pull_request "$reviewed" "$doc" docs-fast-only)"
grep -Fxq 'docs_fast_path=false' <<< "$(classify pull_request "$reviewed" "$doc")"
tree="$(git -C "$fixture" rev-parse "$doc^{tree}")"
merge="$(git -C "$fixture" commit-tree "$tree" -p "$reviewed" -p "$doc" -m 'fixture merge')"
git -C "$fixture" checkout -q --detach "$merge"
python3 - "$repo_root/.github/workflows/development-v1.yml" "$fixture/workflow" <<'PY'
import pathlib
import sys
import textwrap

workflow = pathlib.Path(sys.argv[1]).read_text()
step = workflow.split("      - name: Select Build and Unit workload\n", 1)[1].split("\n      - name:", 1)[0]
pathlib.Path(sys.argv[2]).write_text(textwrap.dedent(step.split("        run: |\n", 1)[1]))
PY
mkdir -p "$fixture/evidence"
fixture_cache_suffix=/ DEV_V1_EVIDENCE_ROOT="$fixture/evidence" GITHUB_OUTPUT="$fixture/decision" EVENT_NAME=pull_request \
  GITHUB_ENV="$fixture/workload-env" DEV_V1_DEADLINE_EPOCH=2000 RUNNER_TEMP="$probe_tmp_dir" \
  GITHUB_SHA="$merge" PR_HEAD_SHA="$doc" run_fresh bash -euo pipefail "$fixture/workflow" > "$fixture/workflow.log"
grep -Fxq 'run_full=false' "$fixture/decision"
grep -Fxq 'restore_imports_verified=true' "$fixture/evidence/restore-import-proof.txt"

if DOTNET_INSTALL_DIR="$fixture/missing-dotnet" run_fresh bash scripts/ci:classify --verify-docs-restore "$reviewed" \
    > "$fixture/proof" 2> "$fixture/drift-error"; then
  printf 'The restore proof succeeded without a dotnet executable.\n' >&2
  exit 1
fi
[[ ! -s "$fixture/proof" ]]
grep -Fxq 'docs inventory audit: dotnet executable unavailable' "$fixture/drift-error"

# Break the certificate without changing the project's committed declarations.
# Admission may start the restore proof, but no failed proof can report success.
for drift in archive source imports missing-package unexpected-package sdk; do
  git -C "$fixture" reset -q --hard "$reviewed"
  python3 - "$fixture/$certificate" "$drift" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
manifest = json.loads(path.read_text())
package = manifest["packages"]["hvo.restorefixture/1.0.0"]
match sys.argv[2]:
    case "archive": package["archiveSha256"] = "0" * 64
    case "source": package["source"] = "https://unexpected.example/index.json"
    case "imports": manifest["projects"]["tests/Example/Example.csproj"]["targets"]["imports"] = []
    case "missing-package": manifest["packages"].clear()
    case "unexpected-package": manifest["packages"]["extra/1.0.0"] = package
    case "sdk": manifest["sdk"]["sha256"] = "0" * 64
path.write_text(json.dumps(manifest))
PY
  git -C "$fixture" commit -qam "drift $drift"
  if run_fresh bash scripts/ci:classify --verify-docs-restore HEAD > "$fixture/proof" 2> "$fixture/drift-error"; then
    printf 'Unreviewed restore %s qualified.\n' "$drift" >&2
    exit 1
  fi
  [[ ! -s "$fixture/proof" ]]
  case "$drift" in
    archive) grep -Fxq 'docs inventory audit: resolved package content or source differs' "$fixture/drift-error" ;;
    sdk) grep -Fxq 'docs inventory audit: installed SDK differs from the restore import certificate' "$fixture/drift-error" ;;
    *) grep -Fq 'docs inventory audit:' "$fixture/drift-error" ;;
  esac
done

git -C "$fixture" reset -q --hard "$reviewed"
python3 - "$fixture/$package" <<'PY'
import sys
from zipfile import ZipFile

with ZipFile(sys.argv[1], "a") as archive:
    archive.writestr("new-package-file.txt", "Different bytes under the same package identity")
PY
git -C "$fixture" commit -qam 'same-version feed content drift'
if run_fresh bash scripts/ci:classify --verify-docs-restore HEAD > "$fixture/proof" 2> "$fixture/drift-error"; then
  printf 'Changed archive bytes under the reviewed package identity qualified.\n' >&2
  exit 1
fi
[[ ! -s "$fixture/proof" ]]
grep -Fq 'resolved package content or source differs' "$fixture/drift-error"

for drift in missing malformed config inventory; do
  git -C "$fixture" reset -q --hard "$reviewed"
  case "$drift" in
    missing) git -C "$fixture" rm -q -- "$certificate" ;;
    malformed) printf '{"version":1}\n' > "$fixture/$certificate" ;;
    config) printf '\n<!-- changed NuGet configuration -->\n' >> "$fixture/NuGet.Config" ;;
    inventory) printf "100644 blob 0000000000000000000000000000000000000000 b'drifted.csproj'\n" >> "$fixture/scripts/ci:docs-inventory" ;;
  esac
  git -C "$fixture" commit -qam "invalidate $drift"
  stale="$(git -C "$fixture" rev-parse HEAD)"
  printf 'safe edit\n' >> "$fixture/docs/runbooks/releases.md"
  git -C "$fixture" commit -qam 'doc edit against stale base'
  grep -Fxq 'docs_fast_path=false' <<< "$(classify pull_request "$stale" HEAD docs-fast-only)"
  if classify --check-docs-inventory "$stale" > "$fixture/check-out" 2> "$fixture/check-err"; then
    printf 'Mandatory docs certificate gate accepted stale %s base.\n' "$drift" >&2
    exit 1
  fi
  grep -Fq '::error::Documentation CI build inventory is stale or unsafe; refresh scripts/ci:docs-inventory and scripts/ci:restore-import-certificate.json:' "$fixture/check-err"
done

# Verify live .NET SDK slnx <Folder Name="..."> parity between dotnet sln list
# and restore-imports.py (reserved device names, DEL/C1 controls, OrdinalIgnoreCase).
git -C "$fixture" reset -q --hard "$reviewed"
mkdir -p "$fixture/tests/Second"
cp "$fixture/tests/Example/Example.csproj" "$fixture/tests/Second/Second.csproj"
python3 - "$fixture" <<'PY'
import importlib.util
import pathlib
import subprocess
import sys

root = pathlib.Path(sys.argv[1])
spec = importlib.util.spec_from_file_location("restore_imports", root / "scripts/ci/restore-imports.py")
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

cases = [
    ("valid-single", ["/Tests/"]),
    ("valid-multi", ["/Tests/Sub/"]),
    ("valid-com0", ["/COM0/"]),
    ("valid-lpt0", ["/LPT0/"]),
    ("valid-strasse-pair", ["/Stra\u00dfe/", "/STRASSE/"]),
    ("invalid-no-slashes", ["Tests"]),
    ("invalid-empty-seg", ["/A//B/"]),
    ("invalid-dup-case", ["/Tests/", "/tests/"]),
    ("invalid-con", ["/CON/"]),
    ("invalid-con-txt", ["/con.txt/"]),
    ("invalid-prn", ["/PRN/"]),
    ("invalid-aux", ["/AUX/"]),
    ("invalid-nul", ["/NUL/"]),
    ("invalid-com1", ["/COM1/"]),
    ("invalid-lpt1", ["/LPT1/"]),
    ("invalid-clock", ["/CLOCK$/"]),
    ("invalid-del", ["/A\x7fB/"]),
    ("invalid-c1-80", ["/A\x80B/"]),
    ("invalid-c1-9f", ["/A\x9fB/"]),
]
projects = ["tests/Example/Example.csproj", "tests/Second/Second.csproj"]
slnx = root / "parity.slnx"
for label, names in cases:
    folders = "".join(f'<Folder Name="{n}"><Project Path="{projects[i]}" /></Folder>' for i, n in enumerate(names))
    blob = f"<Solution>{folders}</Solution>\n".encode("utf-8")
    slnx.write_bytes(blob)
    dotnet_ok = subprocess.run(
        ["dotnet", "sln", str(slnx), "list"],
        cwd=root, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ).returncode == 0
    try:
        mod.solution_projects(blob)
        py_ok = True
    except mod.ProofError:
        py_ok = False
    if dotnet_ok != py_ok:
        raise SystemExit(f"slnx folder parity mismatch on {label}: dotnet={dotnet_ok} py={py_ok}")
PY
printf 'Offline restore certificate passed: valid base, seven replay drift cases, missing dotnet, four mandatory-failure fallback cases and 19 live slnx folder parity cases.\n'
