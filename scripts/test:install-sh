  without tar sha256sum
  install_sh -- --check

  assert_status 1
  assert_output_contains "FAIL  These commands are missing: tar sha256sum. Install them (sudo apt-get install tar coreutils)"
}

test_without_curl_nothing_more_is_checked() {
  without curl
  install_sh -- --check

  assert_status 1
  assert_output_contains "These commands are missing: curl."
  assert_output_contains "Without curl nothing more can be checked"
  assert_not_called "docker"
}

