# --- 1. Online: the release's small files, checked, and the image pulled by its digest -------------------------------

# release_folder_arg: the --release argument install.sh hands over online, its own download folder's release/.
release_folder_arg() {
  printf '\\[--release\\]\\[%s/hvo-sky-install\\.[A-Za-z0-9]{8}/release\\]' "$(re "${WORK}/tmp")"
}

# No installer arguments is an install: online, cameraagent install with the release's files and catalog, as when it is
# named.
test_online_without_arguments_installs() {
  install_sh

  assert_status 0
  assert_output_contains "ok    docker buildx 0.37"
  assert_called "${RELEASE_URL}/release.json"
  assert_called "${RELEASE_URL}/${CATALOG}.tar.gz"
  assert_not_called ".oci.tar"
  assert_installer_matches "^args=\\[cameraagent\\]\\[install\\]$(release_folder_arg)\\[--image-source\\]\\[registry\\]\\[--catalog-bundle\\]\\[$(re "${CATALOG_DIR}")\\]$"
  assert_installer "release-files=SHA256SUMS ${CATALOG}.tar.gz release.json "
  assert_installer "catalog-files=hyg_v42.sqlite manifest.json "
}

test_online_an_install_gets_the_release_s_small_files_and_never_its_image_archive() {
  install_sh -- cameraagent install --port 5130

  assert_status 0
  assert_called "${RELEASE_URL}/SHA256SUMS"
  assert_called "${RELEASE_URL}/hvo-sky-install-linux-arm64"
  assert_called "${RELEASE_URL}/release.json"
  assert_called "${RELEASE_URL}/${CATALOG}.tar.gz"
  assert_not_called ".oci.tar"
  assert_installer_matches "^args=\\[cameraagent\\]\\[install\\]\\[--port\\]\\[5130\\]$(release_folder_arg)\\[--image-source\\]\\[registry\\]\\[--catalog-bundle\\]\\[$(re "${CATALOG_DIR}")\\]$"
  assert_installer "release-files=SHA256SUMS ${CATALOG}.tar.gz release.json "
  assert_installer "catalog-files=hyg_v42.sqlite manifest.json "
  assert_no_download_folder_left
}

test_online_an_upgrade_gets_the_release_and_no_catalog() {
  install_sh -- cameraagent upgrade --instance-id 1

  assert_status 0
  assert_called "${RELEASE_URL}/release.json"
  assert_not_called "${CATALOG}.tar.gz"
  assert_not_called ".oci.tar"
  assert_installer_matches "^args=\\[cameraagent\\]\\[upgrade\\]\\[--instance-id\\]\\[1\\]$(release_folder_arg)\\[--image-source\\]\\[registry\\]$"
  assert_installer "release-files=SHA256SUMS release.json "
}

