  assert_installer_did_not_run
}

test_online_sha256sums_with_two_catalogs_starts_nothing() {
  sed -n "s/  ${CATALOG}.tar.gz$/  hyg-v4.4-p1-s1-r1.bundle.tar.gz/p" "${WORK}/release/SHA256SUMS" >"${WORK}/another"
  cat "${WORK}/another" >>"${WORK}/release/SHA256SUMS"
  install_sh -- cameraagent install

  assert_status 3
  assert_output_contains "SHA256SUMS does not list one catalog"
  assert_installer_did_not_run
}

