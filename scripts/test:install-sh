  install_sh FAKE_CLOCK_SKEW=-3600 -- cameraagent install

  assert_stopped_by_checks
  assert_output_contains "FAIL  This machine's clock is 60 minutes out"
  assert_output_contains "(sudo timedatectl set-ntp true)"
}

