# For tests only, the release's files can be served from elsewhere, still over HTTPS alone.
test_the_release_url_can_be_another_for_tests() {
  install_sh HVO_SKY_INSTALL_TEST_RELEASE_URL=https://127.0.0.1:8443/release FAKE_RELEASE_URL=https://127.0.0.1:8443/release \
    -- cameraagent install

  assert_status 0
  assert_called "curl -fsSL --proto =https --tlsv1.2 --retry 3 --connect-timeout 15 --max-time 600 -o ${WORK}/tmp/hvo-sky-install."
  assert_called "https://127.0.0.1:8443/release/release.json"
  assert_not_called "${RELEASE_URL}"
}

# --- 5. The catalog: from the folder or downloaded, checked, and unpacked where a second run finds it ---------------

test_from_a_folder_a_catalog_that_is_not_the_release_s_starts_nothing() {
  printf 'tampered\n' >>"${WORK}/release/${CATALOG}.tar.gz"
  install_sh -- --from "${WORK}/release" cameraagent install

  assert_status 3
  assert_output_contains "install.sh: ${CATALOG}.tar.gz's SHA-256 is"
  assert_installer_did_not_run
  assert_nothing_downloaded
}

test_check_from_a_folder_without_its_catalog_fails() {
  rm "${WORK}/release/${CATALOG}.tar.gz"
  install_sh -- --from "${WORK}/release" --check

  assert_stopped_by_checks
  assert_output_contains "FAIL  ${WORK}/release does not have ${CATALOG}.tar.gz: download it from"
}

test_a_catalog_holding_anything_outside_its_folder_starts_nothing() {
  printf 'stray\n' >"${SUITE}/catalog-source/stray-${BASHPID}"
  catalog_archive "${WORK}/release/${CATALOG}.tar.gz" "${CATALOG}/manifest.json" "stray-${BASHPID}"
  rm -f "${SUITE}/catalog-source/stray-${BASHPID}"
  (cd "${WORK}/release" && rm SHA256SUMS && sha256sum -- * >../sums && mv ../sums SHA256SUMS)
  install_sh -- cameraagent install

  assert_status 3
  assert_output_contains "install.sh: ${CATALOG}.tar.gz holds stray-${BASHPID}, which is not a file in its folder ${CATALOG}"
  assert_installer_did_not_run
  [ ! -e "${CATALOG_DIR}" ] || fail_test "the catalog was unpacked"
}

test_a_catalog_holding_a_link_starts_nothing() {
  local source="${WORK}/link-source"
  mkdir -p "${source}/${CATALOG}"
  printf '{}\n' >"${source}/${CATALOG}/manifest.json"
  ln -s /etc/passwd "${source}/${CATALOG}/passwd"
  tar -czf "${WORK}/release/${CATALOG}.tar.gz" -C "${source}" "${CATALOG}/manifest.json" "${CATALOG}/passwd"
  (cd "${WORK}/release" && rm SHA256SUMS && sha256sum -- * >../sums && mv ../sums SHA256SUMS)
  install_sh -- cameraagent install

  assert_status 3
  assert_output_contains "holds something other than files"
  assert_installer_did_not_run
}

# The installer binds an install to the catalog folder it is given, so a second run, or a --resume, must name the same
# one: the catalog is unpacked in the same place each time, afresh.
test_the_catalog_is_unpacked_where_a_second_run_finds_it_again() {
  install_sh -- cameraagent install
  assert_status 0
  assert_installer "catalog-files=hyg_v42.sqlite manifest.json "
  printf 'left by hand\n' >"${CATALOG_DIR}/stray"
  chmod 0500 "${CATALOG_DIR}"

  rm -f "${FAKE_STATE_DIR}/installer.log"
  install_sh -- cameraagent install
  assert_status 0
  assert_installer_matches "\\[--catalog-bundle\\]\\[$(re "${CATALOG_DIR}")\\]$"
  assert_installer "catalog-files=hyg_v42.sqlite manifest.json "
  [ -z "$(find "${WORK}/home/.cache/hvo-sky/catalogs" -mindepth 1 -maxdepth 1 -name '.*')" ] || fail_test "a staging folder was left"
}

test_xdg_cache_home_moves_the_catalog() {
  mkdir -m 0700 "${WORK}/cache"
  install_sh XDG_CACHE_HOME="${WORK}/cache" -- cameraagent install

  assert_status 0
  assert_installer_matches "\\[--catalog-bundle\\]\\[$(re "${WORK}/cache/hvo-sky/catalogs/${CATALOG}")\\]$"
}

test_a_catalog_location_others_can_change_fails() {
  chmod 0777 "${WORK}/home"
  install_sh -- cameraagent install

  assert_stopped_by_checks
  assert_output_contains "FAIL  ${WORK}/home is not a folder only you and root can change, and the catalog is unpacked in ${WORK}/home/.cache/hvo-sky/catalogs"
}

# --- 2. Exit codes ---------------------------------------------------------------------------------------------------

# Interrupted (here while gh checks its sign-in), it exits 130 and removes its download folder.
test_an_interruption_exits_130() {
  install_sh FAKE_GH_INTERRUPT=1 -- cameraagent install

  assert_status 130
  assert_installer_did_not_run
  assert_no_download_folder_left
}

# --- Review PR-1356-R1 -----------------------------------------------------------------------------------------------

# F1: the installer reads release.json, SHA256SUMS and the image archive from --from's folder after install.sh has checked
# them, so only you and root may be able to change them. Someone else's replacement after verification is the attack: a
# folder others can write to is refused before anything is checked, so it cannot happen.
test_from_a_folder_others_can_change_is_refused_before_verification() {
  chmod g+w "${WORK}/release"
  install_sh FAKE_GH_REPLACE="${WORK}/release/release.json" -- --from "${WORK}/release" cameraagent install

  assert_status 3
  assert_output_contains "${WORK}/release is not a folder only you and root can change"
  assert_not_called "gh attestation verify"
  assert_installer_did_not_run
  [ "$(cat "${WORK}/release/release.json")" = "{}" ] || fail_test "release.json was replaced"
}

test_check_from_a_folder_others_can_change_fails() {
  chmod o+w "${WORK}/release"
  install_sh -- --from "${WORK}/release" --check

  assert_stopped_by_checks
  assert_output_contains "FAIL  ${WORK}/release is not a folder only you and root can change"
}

# The quick paths (help, version) take the installer from the folder too, without the checks: still refused.
test_from_a_folder_others_can_change_starts_not_even_the_installer_s_version() {
  chmod g+w "${WORK}/release"
  install_sh -- --from "${WORK}/release" --version

  assert_status 3
  assert_output_contains "is not a folder only you and root can change"
  assert_output_not_contains "${VERSION}+${COMMIT}"
}

test_from_a_release_file_others_can_change_is_refused() {
  chmod o+w "${WORK}/release/release.json" "${WORK}/release/SHA256SUMS"
  install_sh -- --from "${WORK}/release" --check
  assert_stopped_by_checks
  assert_output_contains "FAIL  In ${WORK}/release, SHA256SUMS and release.json are a link, or someone else's, or writable by others"

  install_sh -- --from "${WORK}/release" --version
  assert_status 3
  assert_output_contains "${WORK}/release/SHA256SUMS is a link, or someone else's, or writable by others"
  assert_output_not_contains "${VERSION}+${COMMIT}"
}

test_from_a_linked_release_file_is_refused() {
  mv "${WORK}/release/release.json" "${WORK}/release.json"
  ln -s "${WORK}/release.json" "${WORK}/release/release.json"
  install_sh -- --from "${WORK}/release" cameraagent install

  assert_stopped_by_checks
  assert_output_contains "FAIL  In ${WORK}/release, release.json is a link, or someone else's, or writable by others"
}

test_from_a_linked_folder_is_handed_over_by_its_physical_path() {
  ln -s "${WORK}/release" "${WORK}/release-link"
  install_sh -- --from "${WORK}/release-link" cameraagent upgrade --instance-id 1

  assert_status 0
  assert_installer "args=[cameraagent][upgrade][--instance-id][1][--release][${WORK}/release][--no-download]"
}

# F2: the installer is never started, not even for its help or version, before its and SHA256SUMS' attestations are
# checked, and never as root.
test_the_installer_s_help_is_not_started_when_its_attestation_fails() {
  install_sh FAKE_ATTESTATION_FAILS=hvo-sky-install -- cameraagent install --help

  assert_status 3
  assert_output_contains "install.sh: hvo-sky-install-linux-arm64's attestation did not verify"
  assert_output_not_contains "hvo-sky-install ran"
  assert_installer_did_not_run
}

test_the_installer_s_version_is_not_started_when_sha256sums_attestation_fails() {
  install_sh FAKE_ATTESTATION_FAILS=SHA256SUMS -- --version

  assert_status 3
  assert_output_contains "install.sh: SHA256SUMS's attestation did not verify"
  assert_output_not_contains "${VERSION}+${COMMIT}"
}

test_the_quick_paths_check_the_attestations() {
  install_sh -- cameraagent install --help

  assert_status 0
  assert_called "gh attestation verify ${WORK}/tmp/hvo-sky-install."
  assert_called "/SHA256SUMS --repo HualapaiValley/HVO.SkyMonitor"
  assert_installer "args=[cameraagent][install][--help]"
}

test_root_is_refused_before_the_installer_s_help_or_version() {
  install_sh FAKE_UID=0 -- --version
  assert_status 3
  assert_output_contains "hvo-sky-install runs as the user that runs CameraAgent's Docker containers, not as root"
  assert_output_not_contains "${VERSION}+${COMMIT}"
  assert_nothing_downloaded

  install_sh FAKE_UID=0 -- cameraagent install --help
  assert_status 3
  assert_installer_did_not_run
}

# F3: the test-only URL must be an absolute https:// URL with a host; anything else, an option for curl included, is
# refused before any command runs.
test_a_release_url_that_is_not_an_https_url_with_a_host_is_refused() {
  local url
  for url in "-K${WORK}/curlrc" "--proto=file" "file:///etc/passwd" "http://127.0.0.1:8080/release" "https:///release" \
    "https://" "https://-K/release" "" " https://127.0.0.1/release"; do
    : >"${FAKE_STATE_DIR}/calls.log"
    install_sh HVO_SKY_INSTALL_TEST_RELEASE_URL="${url}" -- cameraagent install
    [ "${STATUS}" = 2 ] || fail_test "'${url}' was not refused as a usage error (exit ${STATUS})"
    [[ "${OUTPUT}" == *"HVO_SKY_INSTALL_TEST_RELEASE_URL is '${url}', not an absolute https:// URL with a host"* ]] ||
      fail_test "'${url}' was not named"
    [ ! -s "${FAKE_STATE_DIR}/calls.log" ] || fail_test "'${url}' ran commands: $(head -n 1 "${FAKE_STATE_DIR}/calls.log")"
  done
}

# A URL is curl's --url, never an argument that could be read as an option.
test_every_url_is_given_to_curl_with_url() {
  install_sh HVO_SKY_INSTALL_TEST_RELEASE_URL=https://127.0.0.1:8443/release FAKE_RELEASE_URL=https://127.0.0.1:8443/release \
    -- cameraagent install

  assert_status 0
  assert_called "--url https://github.com"
  assert_called "--url https://ghcr.io/v2/"
  assert_called "--url https://127.0.0.1:8443/release/SHA256SUMS"
  assert_called "--url https://127.0.0.1:8443/release/release.json"
}

test_the_release_url_is_announced_in_every_path() {
  local notice="install.sh: HVO_SKY_INSTALL_TEST_RELEASE_URL is set, for tests only: the release's files come from https://127.0.0.1:8443/release, not from GitHub."
  local arguments
  for arguments in "--version" "cameraagent install --help" "--check" "--help"; do
    # shellcheck disable=SC2086 # each case is its words
    install_sh HVO_SKY_INSTALL_TEST_RELEASE_URL=https://127.0.0.1:8443/release/ FAKE_RELEASE_URL=https://127.0.0.1:8443/release \
      -- ${arguments}
    [ "${STATUS}" = 0 ] || fail_test "'${arguments}' exited ${STATUS}"
    [[ "${OUTPUT}" == *"${notice}"* ]] || fail_test "'${arguments}' did not announce the test-only URL"
  done
}

# F4: the installer's --version must succeed, not only print the release's identity.
test_an_installer_whose_version_fails_is_not_started() {
  install_sh FAKE_INSTALLER_VERSION_EXIT=1 -- cameraagent install

  assert_status 3
  assert_output_contains "install.sh: hvo-sky-install-linux-arm64 --version failed (exit 1, saying '${VERSION}+${COMMIT}')"
  assert_installer_did_not_run
}

# --- Review PR-1356-R2 -----------------------------------------------------------------------------------------------

# R2-F1a: the release's own folder must be writable by no one but its owner, sticky or not: the sticky exception is for
# the folders above it, such as /tmp, where it keeps others from replacing what you own.
test_a_sticky_release_folder_others_can_write_to_is_refused() {
  local mode arguments
  for mode in 1775 1777; do
    chmod "${mode}" "${WORK}/release"
    for arguments in "--check" "--version" "cameraagent install"; do
      rm -f "${FAKE_STATE_DIR}/installer.log"
      # shellcheck disable=SC2086 # each case is its words
      install_sh -- --from "${WORK}/release" ${arguments}
      [ "${STATUS}" = 3 ] || fail_test "mode ${mode}, ${arguments}: exit ${STATUS}, not 3"
      [[ "${OUTPUT}" == *"${WORK}/release is not a folder only you and root can change"* ]] ||
        fail_test "mode ${mode}, ${arguments}: the folder was not refused"
      [[ "${OUTPUT}" != *"${VERSION}+${COMMIT}"* ]] || fail_test "mode ${mode}, ${arguments}: the installer said its version"
      [ ! -e "${FAKE_STATE_DIR}/installer.log" ] || fail_test "mode ${mode}, ${arguments}: the installer ran"
    done
  done
}

# R2-F1b: --from is resolved to its physical path once, when the command line is read. Someone pointing the link at
# another release while the machine is checked (here, during docker info) changes nothing: the files checked are the
# files used, and nothing is taken from the new target.
test_a_folder_link_pointed_elsewhere_during_the_checks_changes_nothing() {
  cp -a "${WORK}/release" "${WORK}/other"
  chmod o+w "${WORK}/other/release.json"
  : >"${WORK}/other/from-the-new-target"
  ln -s "${WORK}/release" "${WORK}/release-link"
  install_sh FAKE_RETARGET_LINK="${WORK}/release-link" FAKE_RETARGET_TO="${WORK}/other" \
    -- --from "${WORK}/release-link" cameraagent install

  [ "$(readlink "${WORK}/release-link")" = "${WORK}/other" ] || fail_test "the probe did not point the link elsewhere"
  assert_status 0
  assert_installer "args=[cameraagent][install][--release][${WORK}/release][--no-download][--catalog-bundle][${CATALOG_DIR}]"
  ! grep -q "from-the-new-target" "${FAKE_STATE_DIR}/installer.log" || fail_test "the installer was given the new target"
  assert_output_not_contains "${WORK}/other"
  assert_installer "catalog-files=hyg_v42.sqlite manifest.json "
}

# The resolved path itself turned into a link while the machine is checked (the folder moved away, a link to another
# release in its place) no longer resolves to itself: refused before anything is taken from it.
test_a_release_folder_replaced_by_a_link_during_the_checks_is_refused() {
  cp -a "${WORK}/release" "${WORK}/other"
  : >"${WORK}/other/from-the-new-target"
  install_sh FAKE_REPLACE_FOLDER="${WORK}/release" FAKE_REPLACE_WITH="${WORK}/other" \
    -- --from "${WORK}/release" cameraagent install

  [ -L "${WORK}/release" ] || fail_test "the probe did not replace the folder"
  assert_status 3
  assert_output_contains "install.sh: ${WORK}/release is not a folder only you and root can change"
  assert_installer_did_not_run
}

# --- 4. Verification and the hand-over --------------------------------------------------------------------------------

test_a_download_that_is_not_the_release_s_is_not_started() {
  printf 'tampered\n' >>"${WORK}/release/hvo-sky-install-linux-arm64"
  install_sh -- cameraagent install

  assert_status 3
  assert_output_contains "hvo-sky-install-linux-arm64's SHA-256 is"
  assert_output_contains "it is not the release's, and nothing was installed."
  assert_installer_did_not_run
  assert_no_download_folder_left
}

test_sha256sums_without_the_installer_is_refused() {
  grep -v 'hvo-sky-install-linux-arm64$' "${WORK}/release/SHA256SUMS" >"${WORK}/sums" && mv "${WORK}/sums" "${WORK}/release/SHA256SUMS"
  install_sh -- cameraagent install

  assert_status 3
  assert_output_contains "SHA256SUMS does not list hvo-sky-install-linux-arm64 once, so it cannot be checked"
  assert_installer_did_not_run
}

test_sha256sums_listing_the_installer_twice_is_refused() {
  grep 'hvo-sky-install-linux-arm64$' "${WORK}/release/SHA256SUMS" >"${WORK}/again"
  cat "${WORK}/again" >>"${WORK}/release/SHA256SUMS"
  install_sh -- cameraagent install

  assert_status 3
  assert_output_contains "SHA256SUMS does not list hvo-sky-install-linux-arm64 once"
  assert_installer_did_not_run
}

test_sha256sums_in_binary_mode_is_read() {
  sed -i 's/  / */' "${WORK}/release/SHA256SUMS"
  install_sh -- cameraagent install

  assert_status 0
  assert_installer_matches "^args=\[cameraagent\]\[install\]\[--release\].*\[--catalog-bundle\]"
}

test_a_download_that_fails_names_the_problem() {
  install_sh FAKE_DOWNLOAD_FAILS=hvo-sky-install-linux-arm64 FAKE_DOWNLOAD_EXIT=28 -- cameraagent install

  assert_status 1
  assert_output_contains "hvo-sky-install-linux-arm64 could not be downloaded from ${RELEASE_URL}: it did not answer in time."
  assert_installer_did_not_run
  assert_no_download_folder_left
}

# The attestations name the release's workflow at its tag: prerelease.yml for an integration pre-release.
test_the_attestations_name_the_pre_release_workflow_at_its_tag() {
  install_sh -- cameraagent install

  assert_status 0
  assert_called "gh attestation verify ${WORK}/tmp/hvo-sky-install."
  assert_called "/SHA256SUMS --repo HualapaiValley/HVO.SkyMonitor --cert-identity https://github.com/HualapaiValley/HVO.SkyMonitor/.github/workflows/prerelease.yml@refs/tags/v${VERSION} --source-ref refs/tags/v${VERSION} --deny-self-hosted-runners"
  assert_called "/hvo-sky-install --repo HualapaiValley/HVO.SkyMonitor --cert-identity https://github.com/HualapaiValley/HVO.SkyMonitor/.github/workflows/prerelease.yml@refs/tags/v${VERSION} --source-ref refs/tags/v${VERSION} --deny-self-hosted-runners"
}

