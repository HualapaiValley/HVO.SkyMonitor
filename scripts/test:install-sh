# The remaining arguments go to the installer as they are, after --, and its exit status is install.sh's.
test_the_installer_gets_the_remaining_arguments_and_gives_its_status() {
  install_sh FAKE_INSTALLER_EXIT=7 -- -- cameraagent install --friendly-name "--check" --json

  assert_status 7
  assert_installer_matches "^args=\[cameraagent\]\[install\]\[--friendly-name\]\[--check\]\[--json\]\[--release\]"
}

# install.sh's own output is on standard error, so standard output is the installer's alone, as its --json needs.
test_standard_output_is_the_installer_s_alone() {
  build_command -- cameraagent install --json
  OUTPUT=$(setsid -w "${RUN_CMD[@]}" 2>/dev/null </dev/null)
  STATUS=$?

  assert_status 0
  [ "${OUTPUT}" = "hvo-sky-install ran" ] || fail_test "standard output is not the installer's alone"
}

test_help_is_on_standard_output() {
  build_command -- --help
  OUTPUT=$(setsid -w "${RUN_CMD[@]}" 2>/dev/null </dev/null)
  STATUS=$?

  assert_status 0
  assert_output_contains "install.sh for HVO SkyMonitor ${VERSION}"
}

test_the_installer_runs_with_your_umask() {
  build_command -- cameraagent install
  OUTPUT=$(umask 0027 && setsid -w "${RUN_CMD[@]}" 2>&1 </dev/null)
  STATUS=$?

  assert_status 0
  assert_installer "umask=0027"
}

test_the_installer_s_help_skips_the_checks() {
  install_sh FAKE_DOCKER_ENGINE=down -- cameraagent install --help

  assert_status 0
  assert_output_not_contains "Checking this machine"
  assert_not_called "docker"
  assert_installer "args=[cameraagent][install][--help]"
}

test_the_installer_s_version_skips_the_checks() {
  install_sh FAKE_DOCKER_ENGINE=down -- --version

  assert_status 0
  assert_output_contains "${VERSION}+${COMMIT}"
  assert_not_called "docker"
}

test_on_a_terminal_the_installer_reads_the_terminal() {
  install_sh_on_terminal -- cameraagent install

  assert_status 0
  assert_installer "terminal=yes"
  assert_output_contains "hvo-sky-install ran"
}

# ---------------------------------------------------------------------------------------------------------------------
# Runner

if (($# > 0)); then
  tests=("$@")
else
  # The longest first, so the rest run beside it.
  mapfile -t tests < <(declare -F | awk '$3 ~ /^test_/ { print $3 }' | sort)
  tests=(test_a_download_cut_short_anywhere_runs_nothing "${tests[@]/test_a_download_cut_short_anywhere_runs_nothing/}")
fi

jobs=${INSTALL_SH_TEST_JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)}
((jobs >= 1)) || jobs=1
((jobs <= 8)) || jobs=8
RESULTS="${SUITE}/results"
mkdir "${RESULTS}"
echo "install.sh tests (${VERSION}, ${jobs} at a time)"
running=0
index=0
for name in "${tests[@]}"; do
  [ -n "${name}" ] || continue
  index=$((index + 1))
  (run_one "${name}" >"${RESULTS}/${index}.out" 2>&1; echo $? >"${RESULTS}/${index}.status") &
  running=$((running + 1))
  if ((running >= jobs)); then
    wait -n
    running=$((running - 1))
  fi
done
wait

passed=0
failed=0
failures=()
for ((n = 1; n <= index; n++)); do
  cat "${RESULTS}/${n}.out"
  if [ "$(cat "${RESULTS}/${n}.status" 2>/dev/null)" = 0 ]; then
    passed=$((passed + 1))
  else
    failed=$((failed + 1))
    failures+=("$(head -n 1 "${RESULTS}/${n}.out" | sed 's/^ *//')")
  fi
done

echo ""
echo "install.sh tests: ${passed} passed, ${failed} failed"
if ((failed > 0)); then
  printf '  %s\n' "${failures[@]}"
  exit 1
fi
