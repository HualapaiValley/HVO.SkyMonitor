# Raspberry Pi OS boots with cgroup_disable=memory: Docker cannot limit memory, and the remedy is named.
test_a_pi_whose_docker_cannot_limit_memory_names_cgroup_enable_memory() {
  install_sh FAKE_DOCKER_LIMITS=false,true,true,4,8589934592 -- cameraagent install

  assert_stopped_by_checks
  assert_output_contains "FAIL  Docker does not enforce memory limits (docker info: MemoryLimit false, CPUCfsQuota true, PidsLimit true)"
  assert_output_contains "add a space and cgroup_enable=memory to the end of the single line in /boot/firmware/cmdline.txt, and reboot"
}

test_docker_that_cannot_limit_cpu_or_processes_fails() {
  not_a_pi
  install_sh FAKE_DOCKER_LIMITS=true,false,false,4,8589934592 -- cameraagent install

  assert_stopped_by_checks
  assert_output_contains "FAIL  Docker does not enforce CPU and process limits"
  assert_output_contains "give the Docker daemon the memory, cpu and pids cgroup controllers"
  assert_output_not_contains "cgroup_enable=memory"
}

test_docker_with_one_cpu_fails() {
  install_sh FAKE_DOCKER_LIMITS=true,true,true,1,8589934592 -- cameraagent install

  assert_stopped_by_checks
  assert_output_contains "FAIL  Docker has 1 CPU, and CameraAgent's container is limited to at least 2"
}

test_less_memory_than_the_limit_is_only_noted() {
  install_sh FAKE_DOCKER_LIMITS=true,true,true,4,4022337536 -- cameraagent install

  assert_status 0
  assert_output_contains "note  This machine has 3.7 GB of memory, less than CameraAgent's 4 GiB limit"
  assert_installer "args=[cameraagent][install]"
}

test_docker_info_that_fails_fails() {
  install_sh FAKE_DOCKER_INFO=fails -- cameraagent install

  assert_stopped_by_checks
  assert_output_contains "FAIL  Docker did not say which limits it enforces (docker info)"
}

test_an_upgrade_checks_docker_and_its_limits() {
  install_sh FAKE_DOCKER_LIMITS=false,true,true,4,8589934592 -- cameraagent upgrade --instance-id 1

  assert_stopped_by_checks
  assert_output_contains "FAIL  Docker does not enforce memory limits"
}

# A command that starts no CameraAgent checks what it needs itself: a machine that lost Docker's limits can still be
# looked at, rolled back or uninstalled.
test_a_command_that_starts_nothing_checks_no_docker() {
  install_sh FAKE_DOCKER_LIMITS=false,false,false,1,1 FAKE_GHCR_EXIT=7 -- cameraagent rollback --instance-id 1

  assert_status 0
  assert_not_called "docker"
  assert_not_called "ghcr.io"
  assert_installer "args=[cameraagent][rollback][--instance-id][1]"
}

test_failures_are_counted() {
  install_sh FAKE_GHCR_EXIT=7 FAKE_COMPOSE=missing -- cameraagent install

  assert_stopped_by_checks
  assert_output_contains "install.sh: 2 checks failed, and nothing was downloaded or installed."
}

# --- 3. Options -------------------------------------------------------------------------------------------------------

# --check alone checks for an install: an install is what no command is.
test_check_checks_everything_and_downloads_and_changes_nothing() {
  install_sh -- --check

  assert_status 0
  assert_output_contains "ok    ghcr.io answers"
  assert_output_contains "ok    Docker enforces memory, CPU and process limits"
  assert_output_contains "This machine is ready for hvo-sky-install ${VERSION}."
  assert_nothing_downloaded
  assert_installer_did_not_run
  assert_no_download_folder_left
}

test_check_with_the_installer_s_help_still_downloads_nothing() {
  install_sh -- --check cameraagent install --help

  assert_status 0
  assert_output_contains "This machine is ready"
  assert_nothing_downloaded
  assert_installer_did_not_run
}

# Offline: nothing comes from GitHub or ghcr.io, and the installer takes the release, and its image, from the folder.
test_from_a_folder_works_offline_and_never_asks_ghcr() {
  install_sh FAKE_GITHUB_EXIT=6 FAKE_GHCR_EXIT=6 FAKE_GH_AUTH=no -- --from "${WORK}/release" cameraagent install --port 5130

  assert_status 0
  assert_output_contains "note  github.com did not answer (its name did not resolve (DNS)): the release's files come from ${WORK}/release"
  assert_output_contains "ok    ${WORK}/release has the release's files, and skymonitor-cameraagent-${VERSION}-linux-arm64.oci.tar: the installer loads CameraAgent's image from it, and pulls nothing from ghcr.io"
  assert_output_contains "Taking hvo-sky-install ${VERSION} for linux-arm64 from ${WORK}/release"
  assert_output_contains "note  the attestations were not checked: gh is not signed in"
  assert_not_called "ghcr.io"
  assert_nothing_downloaded
  assert_installer "args=[cameraagent][install][--port][5130][--release][${WORK}/release][--no-download]"
}

test_check_from_a_folder_without_the_image_archive_fails() {
  rm "${WORK}/release/skymonitor-cameraagent-${VERSION}-linux-arm64.oci.tar"
  install_sh -- --from "${WORK}/release" --check

  assert_stopped_by_checks
  assert_output_contains "FAIL  ${WORK}/release does not have skymonitor-cameraagent-${VERSION}-linux-arm64.oci.tar: download it from https://github.com/HualapaiValley/HVO.SkyMonitor/releases/tag/v${VERSION} into ${WORK}/release"
  assert_not_called "ghcr.io"
}

test_check_from_a_folder_names_every_file_it_lacks() {
  rm "${WORK}/release/hvo-sky-install-linux-arm64" "${WORK}/release/release.json"
  install_sh -- --from "${WORK}/release" --check

  assert_stopped_by_checks
  assert_output_contains "does not have hvo-sky-install-linux-arm64 and release.json: download them from"
}

test_from_a_folder_on_x86_64_needs_the_amd64_archive() {
  not_a_pi
  rm "${WORK}/release/skymonitor-cameraagent-${VERSION}-linux-amd64.oci.tar"
  install_sh FAKE_MACHINE=x86_64 -- --from "${WORK}/release" --check

  assert_stopped_by_checks
  assert_output_contains "does not have skymonitor-cameraagent-${VERSION}-linux-amd64.oci.tar"
}

test_an_upgrade_from_a_folder_reads_the_release_from_it() {
  install_sh -- --from "${WORK}/release" cameraagent upgrade --instance-id 1

  assert_status 0
  assert_installer "args=[cameraagent][upgrade][--instance-id][1][--release][${WORK}/release][--no-download]"
}

test_from_a_folder_with_its_own_release_or_image_still_pulls_nothing() {
  install_sh -- --from "${WORK}/release" cameraagent install --image-ref sha256:0000 --no-download

  assert_status 0
  assert_installer "args=[cameraagent][install][--image-ref][sha256:0000][--no-download]"
  assert_output_contains "ok    ${WORK}/release has the release's files"
}

test_from_a_folder_adds_nothing_to_a_command_that_reads_no_release() {
  install_sh -- --from "${WORK}/release" status --json

  assert_status 0
  assert_installer "args=[status][--json]"
}

test_from_a_relative_folder_is_given_by_its_absolute_path() {
  # Each test runs in a process of its own, so it can start install.sh from its own folder.
  cd "${WORK}" || return
  install_sh -- --from=release cameraagent install

  assert_status 0
  assert_installer "args=[cameraagent][install][--release][${WORK}/release][--no-download]"
}

# --- 4. Verification and the hand-over --------------------------------------------------------------------------------

test_a_download_that_is_not_the_release_s_is_not_started() {
  printf 'tampered\n' >>"${WORK}/release/hvo-sky-install-linux-arm64"
  install_sh -- cameraagent install

  assert_status 1
  assert_output_contains "hvo-sky-install-linux-arm64's SHA-256 is"
  assert_output_contains "the download is not the release's, and nothing was installed."
  assert_installer_did_not_run
  assert_no_download_folder_left
}

test_sha256sums_without_the_installer_is_refused() {
  grep -v 'hvo-sky-install-linux-arm64$' "${WORK}/release/SHA256SUMS" >"${WORK}/sums" && mv "${WORK}/sums" "${WORK}/release/SHA256SUMS"
  install_sh -- cameraagent install

  assert_status 1
  assert_output_contains "SHA256SUMS does not list hvo-sky-install-linux-arm64 once, so the download cannot be checked"
  assert_installer_did_not_run
}

test_sha256sums_listing_the_installer_twice_is_refused() {
  grep 'hvo-sky-install-linux-arm64$' "${WORK}/release/SHA256SUMS" >"${WORK}/again"
  cat "${WORK}/again" >>"${WORK}/release/SHA256SUMS"
  install_sh -- cameraagent install

  assert_status 1
  assert_output_contains "SHA256SUMS does not list hvo-sky-install-linux-arm64 once"
  assert_installer_did_not_run
}

test_sha256sums_in_binary_mode_is_read() {
  sed -i 's/  hvo-sky-install/ *hvo-sky-install/' "${WORK}/release/SHA256SUMS"
  install_sh -- cameraagent install

  assert_status 0
  assert_installer "args=[cameraagent][install]"
}

test_a_download_that_fails_names_the_problem() {
  install_sh FAKE_DOWNLOAD_FAILS=hvo-sky-install-linux-arm64 FAKE_DOWNLOAD_EXIT=28 -- cameraagent install

  assert_status 1
  assert_output_contains "hvo-sky-install-linux-arm64 could not be downloaded from ${RELEASE_URL}: it did not answer in time."
  assert_installer_did_not_run
  assert_no_download_folder_left
}

# The attestations name the release's workflow at its tag: prerelease.yml for an integration pre-release.
test_the_attestations_name_the_pre_release_workflow_at_its_tag() {
  install_sh -- cameraagent install

  assert_status 0
  assert_called "gh attestation verify ${WORK}/tmp/hvo-sky-install."
  assert_called "/SHA256SUMS --repo HualapaiValley/HVO.SkyMonitor --cert-identity https://github.com/HualapaiValley/HVO.SkyMonitor/.github/workflows/prerelease.yml@refs/tags/v${VERSION} --source-ref refs/tags/v${VERSION} --deny-self-hosted-runners"
  assert_called "/hvo-sky-install --repo HualapaiValley/HVO.SkyMonitor --cert-identity https://github.com/HualapaiValley/HVO.SkyMonitor/.github/workflows/prerelease.yml@refs/tags/v${VERSION} --source-ref refs/tags/v${VERSION} --deny-self-hosted-runners"
}

test_a_final_release_s_attestations_name_the_release_workflow() {
  SCRIPT_UNDER_TEST=${FINAL_SCRIPT}
  RUN_VERSION=${FINAL_VERSION}
  install_sh -- status

  assert_status 0
  assert_called "--cert-identity https://github.com/HualapaiValley/HVO.SkyMonitor/.github/workflows/release.yml@refs/tags/v${FINAL_VERSION} --source-ref refs/tags/v${FINAL_VERSION}"
  assert_installer "args=[status]"
}

test_an_installer_whose_attestation_does_not_verify_is_not_started() {
  install_sh FAKE_ATTESTATION_FAILS=hvo-sky-install -- cameraagent install

  assert_status 1
  assert_output_contains "X Verification failed"
  assert_output_contains "install.sh: hvo-sky-install-linux-arm64's attestation did not verify, so it may not be the release's: nothing was installed."
  assert_installer_did_not_run
}

test_sha256sums_whose_attestation_does_not_verify_starts_nothing() {
  install_sh FAKE_ATTESTATION_FAILS=SHA256SUMS -- cameraagent install

  assert_status 1
  assert_output_contains "install.sh: SHA256SUMS's attestation did not verify, so it may not be the release's: nothing was installed."
  assert_installer_did_not_run
}

test_without_gh_the_attestations_are_only_noted() {
  without gh
  install_sh -- cameraagent install

  assert_status 0
  assert_output_contains "note  the attestations were not checked: gh (GitHub's CLI, https://cli.github.com) is not installed"
  assert_installer "args=[cameraagent][install]"
}

test_an_installer_of_another_release_is_not_started() {
  install_sh FAKE_INSTALLER_VERSION="1.1.0+${COMMIT}" -- cameraagent install

  assert_status 1
  assert_output_contains "hvo-sky-install-linux-arm64 says its version is '1.1.0+${COMMIT}', and this is release ${VERSION}: nothing was installed."
  assert_installer_did_not_run
}

test_an_installer_without_its_commit_is_not_started() {
  install_sh FAKE_INSTALLER_VERSION="${VERSION}+unknown" -- cameraagent install

  assert_status 1
  assert_output_contains "says its version is '${VERSION}+unknown'"
  assert_installer_did_not_run
}

test_a_tmpdir_where_programs_cannot_run_is_named() {
  install_sh FAKE_INSTALLER_NOEXEC=1 -- cameraagent install

  assert_status 1
  assert_output_contains "Programs cannot run from ${WORK}/tmp (it is mounted noexec)"
}

test_a_tmpdir_others_can_change_is_refused() {
  chmod 0777 "${WORK}/tmp"
  install_sh -- cameraagent install

  assert_status 1
  assert_output_contains "TMPDIR (${WORK}/tmp) is not a folder only you and root can change"
  assert_installer_did_not_run
}

# The remaining arguments go to the installer as they are, after --, and its exit status is install.sh's.
test_the_installer_gets_the_remaining_arguments_and_gives_its_status() {
  install_sh FAKE_INSTALLER_EXIT=3 -- -- cameraagent install --friendly-name "--check" --json

  assert_status 3
  assert_installer "args=[cameraagent][install][--friendly-name][--check][--json]"
}

test_the_installer_runs_with_your_umask() {
  build_command -- cameraagent install
  OUTPUT=$(umask 0027 && setsid -w "${RUN_CMD[@]}" 2>&1 </dev/null)
  STATUS=$?

  assert_status 0
  assert_installer "umask=0027"
}

test_the_installer_s_help_skips_the_checks() {
  install_sh FAKE_DOCKER_ENGINE=down -- cameraagent install --help

  assert_status 0
  assert_output_not_contains "Checking this machine"
  assert_not_called "docker"
  assert_installer "args=[cameraagent][install][--help]"
}

test_the_installer_s_version_skips_the_checks() {
  install_sh FAKE_UID=0 -- --version

  assert_status 0
  assert_output_contains "${VERSION}+${COMMIT}"
}

test_on_a_terminal_the_installer_reads_the_terminal() {
  install_sh_on_terminal -- cameraagent install

  assert_status 0
  assert_installer "terminal=yes"
  assert_output_contains "hvo-sky-install ran"
}

# ---------------------------------------------------------------------------------------------------------------------
# Runner

if (($# > 0)); then
  tests=("$@")
else
  # The longest first, so the rest run beside it.
  mapfile -t tests < <(declare -F | awk '$3 ~ /^test_/ { print $3 }' | sort)
  tests=(test_a_download_cut_short_anywhere_runs_nothing "${tests[@]/test_a_download_cut_short_anywhere_runs_nothing/}")
fi

jobs=${INSTALL_SH_TEST_JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)}
((jobs >= 1)) || jobs=1
((jobs <= 8)) || jobs=8
RESULTS="${SUITE}/results"
mkdir "${RESULTS}"
echo "install.sh tests (${VERSION}, ${jobs} at a time)"
running=0
index=0
for name in "${tests[@]}"; do
  [ -n "${name}" ] || continue
  index=$((index + 1))
  (run_one "${name}" >"${RESULTS}/${index}.out" 2>&1; echo $? >"${RESULTS}/${index}.status") &
  running=$((running + 1))
  if ((running >= jobs)); then
    wait -n
    running=$((running - 1))
  fi
done
wait

passed=0
failed=0
failures=()
for ((n = 1; n <= index; n++)); do
  cat "${RESULTS}/${n}.out"
  if [ "$(cat "${RESULTS}/${n}.status" 2>/dev/null)" = 0 ]; then
    passed=$((passed + 1))
  else
    failed=$((failed + 1))
    failures+=("$(head -n 1 "${RESULTS}/${n}.out" | sed 's/^ *//')")
  fi
done

echo ""
echo "install.sh tests: ${passed} passed, ${failed} failed"
if ((failed > 0)); then
  printf '  %s\n' "${failures[@]}"
  exit 1
fi
