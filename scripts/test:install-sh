#!/usr/bin/env bash
# Tests src/HVO.SkyMonitor.Deployment.Cli/install.sh as a release publishes it, with its version written in as the
# release tool's create-release writes it (#1311, install contract section 5). It runs as `curl ... | bash -s -- ...` runs
# it, piped into bash, with a PATH of fake commands (tests/fixtures/install-sh/fake-command: uname, curl, docker, gh, df
# and the rest) and the few real ones it uses, so no network, Docker, Pi or GitHub sign-in is needed. The files it reads
# (/etc/os-release and /proc/device-tree/model) are in a folder of the test's own. Linux and bash 5.1 or later; python3
# for the one test that gives install.sh a terminal. scripts/test:release-scripts runs it.
#
#   scripts/test:install-sh [test-name ...]
#
# The tests run in parallel (INSTALL_SH_TEST_JOBS at a time, default the CPUs, at most 8), each in a folder of its own.
set -uo pipefail

REPOSITORY=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
SOURCE="${REPOSITORY}/src/HVO.SkyMonitor.Deployment.Cli/install.sh"
FAKES_DIR="${REPOSITORY}/tests/fixtures/install-sh"
VERSION="1.2.0-dev.3"
FINAL_VERSION="1.2.0"
COMMIT="0123456789abcdef0123456789abcdef01234567"
RELEASE_URL="https://github.com/HualapaiValley/HVO.SkyMonitor/releases/download/v${VERSION}"
PI_DESCRIPTION="Linux on aarch64, Debian GNU/Linux 12 (bookworm), Raspberry Pi 5 Model B Rev 1.0 (linux-arm64)"
# The real commands install.sh and the fakes use; everything else on the PATH is a fake, or missing.
REAL_TOOLS="cat tr awk sed grep tail head dirname mktemp rm rmdir cp mv chmod mkdir ln wc find date"
# The fakes (tests/fixtures/install-sh/fake-command, linked under each name).
FAKES="uname getconf ldd id curl docker df timedatectl tar sha256sum gh"

for tool in setsid python3 sha256sum ${REAL_TOOLS}; do
  command -v "${tool}" >/dev/null || { echo "test:install-sh: ${tool} is required." >&2; exit 1; }
done

# ---------------------------------------------------------------------------------------------------------------------
# Harness

# What every test starts from, made once: install.sh as two releases publish it, the fakes, the real tools, and a
# release's files.
SUITE=$(mktemp -d)
trap 'rm -rf "${SUITE}"' EXIT
SCRIPT="${SUITE}/install.sh"
FINAL_SCRIPT="${SUITE}/install-final.sh"

# bake <version> <file>: install.sh as create-release writes it for that release: its one release_version line names the
# release (tools/HVO.SkyMonitor.Deployment.ReleaseTool, Program.Release.cs, StampInstallScript).
bake() {
  local count
  count=$(grep -cE "^  local release_version=''(  #.*)?$" "${SOURCE}")
  [ "${count}" = 1 ] || { echo "test:install-sh: ${SOURCE} must name its release on one line, and has ${count}." >&2; exit 1; }
  sed -E "s/^  local release_version=''(  #.*)?$/  local release_version='$1'/" "${SOURCE}" >"$2"
}
bake "${VERSION}" "${SCRIPT}"
bake "${FINAL_VERSION}" "${FINAL_SCRIPT}"

mkdir -p "${SUITE}/fakebin" "${SUITE}/realbin" "${SUITE}/release" "${SUITE}/root/etc" "${SUITE}/root/proc/device-tree"
for name in ${FAKES}; do
  ln -s "${FAKES_DIR}/fake-command" "${SUITE}/fakebin/${name}"
done
for name in ${REAL_TOOLS}; do
  ln -s "$(command -v "${name}")" "${SUITE}/realbin/${name}"
done
ln -s "$(command -v bash)" "${SUITE}/realbin/bash"
printf 'PRETTY_NAME="Debian GNU/Linux 12 (bookworm)"\nNAME="Debian GNU/Linux"\nVERSION_CODENAME=bookworm\nID=debian\n' \
  >"${SUITE}/root/etc/os-release"
printf 'Raspberry Pi 5 Model B Rev 1.0\0' >"${SUITE}/root/proc/device-tree/model"
for name in linux-arm64 linux-x64; do
  cp "${FAKES_DIR}/hvo-sky-install" "${SUITE}/release/hvo-sky-install-${name}"
done
# The release's offline image archives and release.json: install.sh checks only that the ones it needs are there.
: >"${SUITE}/release/skymonitor-cameraagent-${VERSION}-linux-amd64.oci.tar"
: >"${SUITE}/release/skymonitor-cameraagent-${VERSION}-linux-arm64.oci.tar"
printf '{}\n' >"${SUITE}/release/release.json"
(cd "${SUITE}/release" && sha256sum -- * >SHA256SUMS)

# A Raspberry Pi 5 with the 64-bit Raspberry Pi OS and Docker, run by a person in the docker group, and the release's
# files.
setup() {
  WORK=$(mktemp -d)
  FAKE_STATE_DIR="${WORK}/state"
  SCRIPT_UNDER_TEST=${SCRIPT}
  RUN_VERSION=${VERSION}
  mkdir -p "${FAKE_STATE_DIR}" "${WORK}/tmp" "${WORK}/home" "${WORK}/docker"
  : >"${FAKE_STATE_DIR}/calls.log"
  # TMPDIR is a folder only this user can change, whatever the umask: install.sh downloads only into such a one.
  chmod 0700 "${WORK}/tmp"
  cp -a "${SUITE}/fakebin" "${SUITE}/release" "${SUITE}/root" "${WORK}/"
}

teardown() {
  rm -rf "${WORK}"
}

# without <command>...: those commands are not installed.
without() {
  local name
  for name in "$@"; do
    rm "${WORK}/fakebin/${name}"
  done
}

# not_a_pi: a Linux machine that is not a Raspberry Pi.
not_a_pi() {
  rm -f "${WORK}/root/proc/device-tree/model"
}

# build_command [NAME=value...] [-- install.sh args...]: sets RUN_CMD to pipe SCRIPT_UNDER_TEST into bash, as
# `curl ... | bash -s -- args` does, with the test's PATH and files plus the given variables.
build_command() {
  local env_pairs=()
  while (($# > 0)) && [ "$1" != "--" ]; do
    env_pairs+=("$1")
    shift
  done
  [ "${1:-}" != "--" ] || shift

  # shellcheck disable=SC2016 # expanded by the inner shell
  RUN_CMD=(env -i
    PATH="${WORK}/fakebin:${SUITE}/realbin" HOME="${WORK}/home" TMPDIR="${WORK}/tmp"
    HVO_SKY_INSTALL_TEST_ROOT="${WORK}/root" FAKE_STATE_DIR="${FAKE_STATE_DIR}"
    FAKE_RELEASE_DIR="${WORK}/release" FAKE_DOCKER_ROOT="${WORK}/docker"
    FAKE_REAL_SHA256SUM="$(command -v sha256sum)"
    FAKE_RELEASE_VERSION="${RUN_VERSION}" FAKE_INSTALLER_VERSION="${RUN_VERSION}+${COMMIT}"
    ${env_pairs[@]+"${env_pairs[@]}"}
    "${SUITE}/realbin/bash" -c 'cat "$1" | "$2" -s -- "${@:3}"' install-sh "${SCRIPT_UNDER_TEST}" "${SUITE}/realbin/bash"
    "$@")
}

# Runs install.sh in a session of its own with no controlling terminal, as from cron, CI or `ssh host 'curl | bash'`:
# /dev/tty cannot be opened even when these tests run in a terminal. Sets OUTPUT (stdout and stderr) and STATUS.
install_sh() {
  build_command "$@"
  OUTPUT=$(setsid -w "${RUN_CMD[@]}" 2>&1 </dev/null)
  STATUS=$?
}

# As install_sh, on a pseudo-terminal of its own, as someone running it in a terminal window or over ssh -t would.
install_sh_on_terminal() {
  build_command "$@"
  OUTPUT=$(python3 -c '
import os, select, sys
pid, fd = os.forkpty()
if pid == 0:
    os.execvp(sys.argv[1], sys.argv[1:])
output = b""
while select.select([fd], [], [], 30)[0]:
    try:
        data = os.read(fd, 4096)
    except OSError:
        break
    if not data:
        break
    output += data
_, status = os.waitpid(pid, 0)
sys.stdout.write(output.decode(errors="replace").replace("\r", ""))
sys.exit(os.waitstatus_to_exitcode(status))
' "${RUN_CMD[@]}" </dev/null)
  STATUS=$?
}

fail_test() {
  CURRENT_FAILED=true
  echo "    FAIL: $*"
}

assert_status() {
  [[ "${STATUS}" == "$1" ]] || fail_test "expected exit status $1, got ${STATUS}"
}

assert_output_contains() {
  [[ "${OUTPUT}" == *"$1"* ]] || fail_test "output does not contain: $1"
}

assert_output_not_contains() {
  [[ "${OUTPUT}" != *"$1"* ]] || fail_test "output contains: $1"
}

# assert_called <text>: a fake command's call (its line in calls.log: "name args") contains the text.
assert_called() {
  grep -qF -- "$1" "${FAKE_STATE_DIR}/calls.log" || fail_test "no call contains: $1"
}

assert_not_called() {
  local call
  call=$(grep -F -- "$1" "${FAKE_STATE_DIR}/calls.log" | head -n 1)
  [ -z "${call}" ] || fail_test "a call contains '$1': ${call}"
}

# assert_installer <line>: the installer ran, and its log has the line (terminal=, umask=, args= or stdin=).
assert_installer() {
  if [ ! -f "${FAKE_STATE_DIR}/installer.log" ]; then
    fail_test "the installer did not run"
  elif ! grep -qxF -- "$1" "${FAKE_STATE_DIR}/installer.log"; then
    fail_test "the installer's log has no line '$1': $(tr '\n' ' ' <"${FAKE_STATE_DIR}/installer.log")"
  fi
}

assert_installer_did_not_run() {
  [ ! -e "${FAKE_STATE_DIR}/installer.log" ] || fail_test "the installer ran: $(tr '\n' ' ' <"${FAKE_STATE_DIR}/installer.log")"
}

# assert_nothing_downloaded: no request for the release's files.
assert_nothing_downloaded() {
  assert_not_called "/releases/download/"
}

# assert_no_download_folder_left: the folder install.sh downloaded into, if it made one, is gone.
assert_no_download_folder_left() {
  local left
  left=$(find "${WORK}/tmp" -mindepth 1 -maxdepth 1 -print -quit)
  [ -z "${left}" ] || fail_test "TMPDIR still holds ${left}"
}

# The checks failed, and install.sh stopped before downloading anything.
assert_stopped_by_checks() {
  assert_status 1
  assert_output_contains "nothing was downloaded or installed."
  assert_nothing_downloaded
  assert_installer_did_not_run
}

# Runs one test in its own folder; prints its name, and its failures and install.sh's output when it fails. Exits 1
# when it failed.
run_one() {
  local name=$1
  CURRENT_FAILED=false
  OUTPUT=""
  echo "  ${name}"
  if ! declare -F "${name}" >/dev/null; then
    echo "    FAIL: no such test"
    return 1
  fi
  setup
  "${name}"
  teardown
  if [[ "${CURRENT_FAILED}" == "true" ]]; then
    echo "    --- script output ---"
    while IFS= read -r line; do
      echo "    | ${line}"
    done <<<"${OUTPUT:-}"
    return 1
  fi
  return 0
}

# ---------------------------------------------------------------------------------------------------------------------
# Tests

# --- 1. Download safety -----------------------------------------------------------------------------------------------

test_the_repository_s_copy_installs_nothing() {
  SCRIPT_UNDER_TEST=${SOURCE}
  install_sh -- cameraagent install

  assert_status 1
  assert_output_contains "This is the repository's copy of install.sh, which names no release: use a release's copy."
  assert_output_contains "releases/latest/download/install.sh | bash"
  [ ! -s "${FAKE_STATE_DIR}/calls.log" ] || fail_test "it ran commands: $(head -n 1 "${FAKE_STATE_DIR}/calls.log")"
}

test_the_repository_s_copy_has_help() {
  SCRIPT_UNDER_TEST=${SOURCE}
  install_sh -- --help

  assert_status 0
  assert_output_contains "install.sh for HVO SkyMonitor (the repository's copy, which installs nothing)"
}

test_help_names_the_release_and_runs_nothing() {
  install_sh -- --help

  assert_status 0
  assert_output_contains "install.sh for HVO SkyMonitor ${VERSION}"
  assert_output_contains "downloads hvo-sky-install ${VERSION} for it"
  assert_output_contains "releases/download/v${VERSION}/install.sh | bash -s --"
  assert_output_contains "--from DIR"
  assert_output_contains "--check"
  [ ! -s "${FAKE_STATE_DIR}/calls.log" ] || fail_test "it ran commands: $(head -n 1 "${FAKE_STATE_DIR}/calls.log")"
}

# Cut short anywhere before the end of its last line's call, the download runs no command at all: inside the function
# bash finds it unfinished, and in the last line the call is not made, or is refused without its end marker. Cuts at
# sampled offsets through the script, and at every byte of its last line. (Without its last argument, the call would
# still run the checks.)
test_a_download_cut_short_anywhere_runs_nothing() {
  local size last call complete n refused=0 cuts=0 ran="" marker='"end of install.sh"'
  SCRIPT_UNDER_TEST="${WORK}/cut.sh"
  # The script is ASCII, so its characters are its bytes: the call is its last line, and is complete after the marker.
  size=$(wc -c <"${SCRIPT}")
  last=$(tail -n 1 "${SCRIPT}")
  call=$((size - ${#last} - 1))
  complete=${last%%"${marker}"*}
  complete=$((call + ${#complete} + ${#marker}))
  build_command -- cameraagent install
  for ((n = 0; n <= size; n += (n + 97 < call - 40 ? 97 : 1))); do
    head -c "${n}" "${SCRIPT}" >"${SCRIPT_UNDER_TEST}"
    : >"${FAKE_STATE_DIR}/calls.log"
    rm -f "${FAKE_STATE_DIR}/installer.log"
    OUTPUT=$(setsid -w "${RUN_CMD[@]}" 2>&1 </dev/null)
    cuts=$((cuts + 1))
    [[ "${OUTPUT}" != *"the download was cut short, and nothing was done"* ]] || refused=$((refused + 1))
    if ((n < complete)) && { [ -s "${FAKE_STATE_DIR}/calls.log" ] || [ -e "${FAKE_STATE_DIR}/installer.log" ]; }; then
      ran="${ran} ${n}"
    fi
  done
  OUTPUT="${cuts} cuts; ${refused} refused for their missing end marker"

  [ -z "${ran}" ] || fail_test "a download cut short at these bytes ran something:${ran}"
  ((refused > 0)) || fail_test "no cut was refused for its missing end marker"
  [ -e "${FAKE_STATE_DIR}/installer.log" ] || fail_test "the whole script did not run the installer"
}

# Its standard input is the download, so neither it nor the installer reads what follows it there.
test_nothing_reads_the_download_after_the_script() {
  {
    cat "${SCRIPT}"
    # shellcheck disable=SC2016 # expanded by the bash running the download
    printf 'echo "the line after the script ran" >>"${FAKE_STATE_DIR}/calls.log"\nyes\n'
  } >"${WORK}/longer.sh"
  SCRIPT_UNDER_TEST="${WORK}/longer.sh"
  install_sh -- cameraagent install

  assert_status 0
  assert_installer "terminal=no"
  assert_installer "stdin=0"
  assert_not_called "the line after the script ran"
}

# --- The command line -------------------------------------------------------------------------------------------------

test_an_option_without_its_value_is_a_usage_error() {
  install_sh -- --from

  assert_status 2
  assert_output_contains "install.sh: --from needs a value."
  assert_output_contains "install.sh --help lists its options."
  [ ! -s "${FAKE_STATE_DIR}/calls.log" ] || fail_test "it ran commands: $(head -n 1 "${FAKE_STATE_DIR}/calls.log")"
}

test_from_a_folder_that_is_not_there_is_a_usage_error() {
  install_sh -- --from "${WORK}/no-such-folder" cameraagent install

  assert_status 2
  assert_output_contains "--from ${WORK}/no-such-folder: there is no such folder."
}

# --- 2. Checks before any change: the platform ------------------------------------------------------------------------

test_another_kernel_is_refused() {
  install_sh FAKE_KERNEL=Darwin -- --check

  assert_status 1
  assert_output_contains "This machine runs Darwin: SkyMonitor's installer and CameraAgent run on Linux (64-bit ARM or x86-64)."
  assert_nothing_downloaded
}

test_32_bit_arm_is_refused() {
  install_sh FAKE_MACHINE=armv7l -- --check

  assert_status 1
  assert_output_contains "This machine runs 32-bit ARM (armv7l), and SkyMonitor's programs are 64-bit"
}

test_a_32_bit_system_on_a_64_bit_kernel_is_refused() {
  install_sh FAKE_LONG_BIT=32 -- --check

  assert_status 1
  assert_output_contains "This machine has a 64-bit kernel and a 32-bit system"
}

test_another_processor_is_refused() {
  install_sh FAKE_MACHINE=riscv64 -- --check

  assert_status 1
  assert_output_contains "This machine's processor is riscv64"
}

test_musl_is_refused() {
  install_sh FAKE_LIBC=musl -- --check

  assert_status 1
  assert_output_contains "This Linux has musl (as Alpine does)"
}

# The whole run on a Pi: every check, the download, its checks, and the hand-over, as you and with your arguments.
test_a_pi_is_checked_and_the_installer_downloaded_verified_and_started() {
  install_sh FAKE_INSTALLER_EXIT=0 -- cameraagent install --friendly-name "North sky" --port 5130

  assert_status 0
  assert_output_contains "HVO SkyMonitor ${VERSION}: install.sh"
  assert_output_contains "ok    ${PI_DESCRIPTION}"
  assert_output_contains "ok    curl, tar and sha256sum"
  assert_output_contains "free on ${WORK}/tmp for the installer's download (TMPDIR)"
  assert_output_contains "ok    github.com answers"
  assert_output_contains "ok    the clock is within"
  assert_output_contains "ok    the clock is synchronised"
  assert_output_contains "ok    ghcr.io answers (HTTP 401)"
  assert_output_contains "ok    Docker 27.3.1, with Compose 2.29.7"
  assert_output_contains "ok    Docker enforces memory, CPU and process limits"
  assert_output_contains "free on ${WORK}/docker for Docker's images"
  assert_output_contains "Downloading hvo-sky-install ${VERSION} for linux-arm64"
  assert_output_contains "ok    hvo-sky-install-linux-arm64's SHA-256 is the one SHA256SUMS lists"
  assert_output_contains "ok    SHA256SUMS's attestation says HualapaiValley/HVO.SkyMonitor's prerelease.yml built it for v${VERSION}"
  assert_output_contains "ok    hvo-sky-install-linux-arm64's attestation says"
  assert_output_contains "ok    hvo-sky-install-linux-arm64 says it is ${VERSION}+${COMMIT}"
  assert_output_contains "Starting hvo-sky-install ${VERSION}"
  assert_output_contains "hvo-sky-install ran"
  assert_called "curl -fsSL --proto =https --tlsv1.2 --retry 3 --connect-timeout 15 --max-time 600 -o"
  assert_called "${RELEASE_URL}/SHA256SUMS"
  assert_called "${RELEASE_URL}/hvo-sky-install-linux-arm64"
  assert_installer "args=[cameraagent][install][--friendly-name][North sky][--port][5130]"
  assert_installer "terminal=no"
  assert_no_download_folder_left
}

test_x86_64_gets_the_x64_installer() {
  not_a_pi
  install_sh FAKE_MACHINE=x86_64 -- status

  assert_status 0
  assert_output_contains "ok    Linux on x86_64, Debian GNU/Linux 12 (bookworm) (linux-x64)"
  assert_called "${RELEASE_URL}/hvo-sky-install-linux-x64"
  assert_installer "args=[status]"
}

test_root_is_refused_before_anything_changes() {
  install_sh FAKE_UID=0 -- cameraagent install

  assert_status 1
  assert_output_contains "hvo-sky-install runs as the user that runs CameraAgent's Docker containers, not as root"
  assert_not_called "docker"
  assert_nothing_downloaded
  assert_installer_did_not_run
}

# --- The commands it needs --------------------------------------------------------------------------------------------

