# Offline: nothing comes from GitHub or ghcr.io, and the installer takes the release, and its image, from the folder.
test_from_a_folder_works_offline_and_never_asks_ghcr() {
  install_sh FAKE_GITHUB_EXIT=6 FAKE_GHCR_EXIT=6 FAKE_GH_AUTH=no -- --from "${WORK}/release" cameraagent install --port 5130

  assert_status 0
  assert_output_contains "note  github.com did not answer (its name did not resolve (DNS)): the release's files come from ${WORK}/release"
  assert_output_contains "ok    ${WORK}/release has the release's files, and skymonitor-cameraagent-${VERSION}-linux-arm64.oci.tar: the installer loads CameraAgent's image from it, and pulls nothing from ghcr.io"
  assert_output_contains "Taking hvo-sky-install ${VERSION} for linux-arm64 from ${WORK}/release"
  assert_output_contains "note  the attestations were not checked: gh is not signed in"
  assert_not_called "ghcr.io"
  assert_nothing_downloaded
  assert_installer "args=[cameraagent][install][--port][5130][--release][${WORK}/release][--no-download][--catalog-bundle][${CATALOG_DIR}]"
  assert_installer "catalog-files=hyg_v42.sqlite manifest.json "
  assert_output_contains "ok    ${CATALOG}.tar.gz's SHA-256 is the one SHA256SUMS lists"
}

