#!/usr/bin/env bash
# Validate and safely extract an application-state archive without exposing member names.

set -euo pipefail
export LC_ALL=C

[[ $# -eq 2 || $# -eq 3 ]] || {
    printf 'Usage: %s ARCHIVE EXTRACT_DIRECTORY [EXPECTED_INVENTORY]\n' "$0" >&2
    exit 2
}

exec perl - "$1" "$2" "${3:-}" <<'PERL'
use strict;
use warnings;
use bytes;
use Digest::SHA qw(sha256_hex);
use Fcntl qw(:DEFAULT :mode);
use File::Basename qw(dirname);
use File::Find;
use IO::Uncompress::Gunzip qw($GunzipError);

my ($archive, $extract_root, $expected_inventory) = @ARGV;
my $product_identity = 'HVO.SkyMonitor';
my $expected_uid = $<;
my $expected_gid = $(;
$expected_gid =~ s/\s.*//;
my @supported = qw(
    logichost/dataprotection
    logichost/home
    cameraagent/identity
    cameraagent/dataprotection
    cameraagent/provisioning
    agent
    archive
);

sub reject {
    my ($reason, $count) = @_;
    $count //= 1;
    print STDERR "Application-state archive rejected: $reason (count: $count).\n";
    exit 1;
}

sub read_exact {
    my ($stream, $length) = @_;
    my $value = '';
    while (length($value) < $length) {
        my $read = $stream->read(my $chunk, $length - length($value));
        reject('truncated archive', 1) if !defined($read) || $read == 0;
        $value .= $chunk;
    }
    return $value;
}

sub octal_field {
    my ($value, $label) = @_;
    $value =~ s/\0.*//s;
    $value =~ s/^\s+|\s+$//g;
    reject("invalid $label", 1) unless $value =~ /^[0-7]+$/;
    return oct($value);
}

sub canonical_name {
    my ($raw, $type) = @_;
    $raw =~ s/\0.*//s;
    reject('control characters in paths', 1) if $raw =~ /[\x00-\x1f\x7f]/;
    if ($type eq '5') {
        reject('path aliases', 1) if $raw =~ m{//+$};
        $raw =~ s{/$}{};
    } else {
        reject('path aliases', 1) if $raw =~ m{/$};
    }
    reject('path aliases', 1) if $raw eq '' || $raw eq '.' || $raw =~ m{//} || $raw =~ m{(?:^|/)\.(?:/|$)};
    reject('unsafe paths', 1) if $raw =~ m{^/} || $raw =~ m{(?:^|/)\.\.(?:/|$)};
    return $raw;
}

sub component_for_path {
    my ($path) = @_;
    return 'logicHost' if index($path, 'logichost/') == 0;
    return 'cameraAgent' if index($path, 'cameraagent/') == 0 || $path eq 'agent' ||
        index($path, 'agent/') == 0 || $path eq 'archive' || index($path, 'archive/') == 0;
    return '';
}

sub supported_path {
    my ($path) = @_;
    for my $root (@supported) {
        return 1 if $path eq $root || index($path, "$root/") == 0;
    }
    return 0;
}

sub parse_inventory {
    my ($content) = @_;
    reject('oversized internal inventory', 1) if length($content) > 16 * 1024 * 1024;
    my @lines = split(/\n/, $content, -1);
    pop @lines if @lines && $lines[-1] eq '';
    reject('missing inventory header', 1) unless @lines;
    my $header = shift @lines;
    reject('unsupported inventory identity or version', 1)
        unless $header eq "HVO-APPLICATION-STATE-INVENTORY\t1\t$product_identity";
    my %inventory;
    my $previous = '';
    my $invalid = 0;
    for my $line (@lines) {
        my @field = split(/\t/, $line, -1);
        if (@field != 8 || $field[0] !~ /^[DF]$/ || $field[1] !~ /^(?:logicHost|cameraAgent)$/ ||
            $field[2] !~ /^(?:0|[1-9][0-9]*)$/ || $field[3] !~ /^(?:0|[1-9][0-9]*)$/ ||
            $field[4] !~ /^0[0-7]{3}$/ || $field[7] !~ /^(?:[0-9a-f]{2})+$/) {
            $invalid++;
            next;
        }
        my $path = pack('H*', $field[7]);
        my $canonical = eval { canonical_name($path, $field[0] eq 'D' ? '5' : '0') };
        if (!$canonical || !supported_path($canonical) || exists $inventory{$canonical} ||
            ($previous ne '' && $canonical le $previous) || $field[1] ne component_for_path($canonical) ||
            $field[2] != $expected_uid || $field[3] != $expected_gid) {
            $invalid++;
            next;
        }
        if ($field[0] eq 'D') {
            $invalid++ unless $field[5] eq '-' && $field[6] eq '-';
        } else {
            $invalid++ unless $field[5] =~ /^(?:0|[1-9][0-9]*)$/ && $field[6] =~ /^[0-9a-f]{64}$/;
        }
        $inventory{$canonical} = {
            type => $field[0], component => $field[1], uid => 0 + $field[2], gid => 0 + $field[3],
            mode => oct($field[4]), size => $field[5], digest => $field[6]
        };
        $previous = $canonical;
    }
    reject('invalid inventory entries', $invalid) if $invalid;
    reject('empty internal inventory', 1) unless keys %inventory;
    for my $required (@supported) {
        reject('missing or unsafe required inventory entries', 1)
            unless exists $inventory{$required} && $inventory{$required}{type} eq 'D' &&
                $inventory{$required}{mode} == 0700;
    }
    return \%inventory;
}

sub safe_parent_dirs {
    my ($path) = @_;
    my $parent = dirname($path);
    return if $parent eq '.';
    my $current = $extract_root;
    for my $component (split m{/}, $parent) {
        $current .= "/$component";
        if (!lstat($current)) {
            mkdir($current, 0700) or reject('safe extraction failure', 1);
        } else {
            reject('extraction path collision', 1) unless S_ISDIR((lstat(_))[2]) && !S_ISLNK((lstat(_))[2]);
        }
    }
}

reject('unsafe extraction directory', 1) unless -d $extract_root && !-l $extract_root;
opendir(my $root_handle, $extract_root) or reject('unsafe extraction directory', 1);
reject('nonempty extraction directory', 1) if grep { $_ ne '.' && $_ ne '..' } readdir($root_handle);
closedir($root_handle);

open(my $archive_handle, '<:raw', $archive) or reject('unreadable archive', 1);
my $compressed_trailing = '';
my $gzip = IO::Uncompress::Gunzip->new(
    $archive_handle, Transparent => 0, MultiStream => 0, Strict => 1)
    or reject('unreadable archive', 1);
my %entries;
my %directory_modes;
my $manifest_content;
my $zero_blocks = 0;
my $pending_long_name;
while (1) {
    my $header = read_exact($gzip, 512);
    if ($header eq "\0" x 512) {
        $zero_blocks++;
        if ($zero_blocks == 2) {
            reject('orphan GNU long-name record', 1) if defined $pending_long_name;
            last;
        }
        next;
    }
    reject('malformed archive terminator', 1) if $zero_blocks;
    my $stored_checksum = octal_field(substr($header, 148, 8), 'header checksum');
    my $checksum_header = $header;
    substr($checksum_header, 148, 8) = ' ' x 8;
    my $computed_checksum = 0;
    $computed_checksum += $_ for unpack('C*', $checksum_header);
    reject('header checksum mismatch', 1) unless $stored_checksum == $computed_checksum;

    my $type = substr($header, 156, 1);
    $type = '0' if $type eq "\0";
    my $size = octal_field(substr($header, 124, 12), 'entry size');
    my $mode = octal_field(substr($header, 100, 8), 'entry mode') & 07777;
    my $uid = octal_field(substr($header, 108, 8), 'entry uid');
    my $gid = octal_field(substr($header, 116, 8), 'entry gid');
    if ($type eq 'L') {
        reject('nested GNU long-name records', 1) if defined $pending_long_name;
        reject('invalid GNU long-name length', 1) if $size < 2 || $size > 4096;
        my $long_name = read_exact($gzip, $size);
        my $padding = (512 - ($size % 512)) % 512;
        read_exact($gzip, $padding) if $padding;
        reject('invalid GNU long-name record', 1) unless substr($long_name, -1, 1) eq "\0";
        chop($long_name);
        reject('invalid GNU long-name record', 1) if $long_name eq '' || $long_name =~ /\0/;
        $pending_long_name = $long_name;
        next;
    }
    reject('link, extension, or special entries', 1) unless $type eq '0' || $type eq '5';
    reject('archive ownership mismatch', 1) unless $uid == $expected_uid && $gid == $expected_gid;
    my $name = substr($header, 0, 100);
    my $prefix = substr($header, 345, 155);
    $name =~ s/\0.*//s;
    $prefix =~ s/\0.*//s;
    my $raw_name = defined($pending_long_name) ? $pending_long_name : ($prefix ne '' ? "$prefix/$name" : $name);
    undef $pending_long_name;
    my $canonical = canonical_name($raw_name, $type);
    reject('directory with payload', 1) if $type eq '5' && $size != 0;

    reject('duplicate canonical paths', 1) if exists $entries{$canonical};
    safe_parent_dirs($canonical);
    my $target = "$extract_root/$canonical";
    my $digest = '-';
    if ($type eq '5') {
        if (lstat($target)) {
            reject('extraction path collision', 1) unless S_ISDIR((lstat(_))[2]) && !S_ISLNK((lstat(_))[2]);
        } else {
            mkdir($target, 0700) or reject('safe extraction failure', 1);
        }
        $directory_modes{$target} = $mode;
    } else {
        sysopen(my $file, $target, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) or reject('extraction path collision', 1);
        binmode($file);
        my $sha = Digest::SHA->new(256);
        my $remaining = $size;
        my $capture_manifest = $canonical eq '.hvo-application-state-inventory';
        $manifest_content = '' if $capture_manifest;
        while ($remaining > 0) {
            my $length = $remaining > 1024 * 1024 ? 1024 * 1024 : $remaining;
            my $chunk = read_exact($gzip, $length);
            $sha->add($chunk);
            print {$file} $chunk or reject('safe extraction failure', 1);
            if ($capture_manifest) {
                reject('oversized internal inventory', 1) if length($manifest_content) + length($chunk) > 16 * 1024 * 1024;
                $manifest_content .= $chunk;
            }
            $remaining -= $length;
        }
        close($file) or reject('safe extraction failure', 1);
        chmod($mode, $target) == 1 or reject('safe extraction failure', 1);
        $digest = $sha->hexdigest;
    }
    my $padding = (512 - ($size % 512)) % 512;
    read_exact($gzip, $padding) if $padding;
    $entries{$canonical} = {
        type => $type eq '5' ? 'D' : 'F', mode => $mode, uid => $uid, gid => $gid,
        size => $size, digest => $digest
    };
}
while (1) {
    my $read = $gzip->read(my $trailing, 1024 * 1024);
    reject('unreadable archive', 1) unless defined $read;
    last if $read == 0;
    reject('nonzero data after archive terminator', 1) if $trailing =~ /[^\0]/;
}
$compressed_trailing = $gzip->trailingData();
$gzip->close() or reject('unreadable archive', 1);
while (1) {
    my $read = read($archive_handle, my $raw_trailing, 1024 * 1024);
    reject('unreadable archive', 1) unless defined $read;
    last if $read == 0;
    $compressed_trailing .= $raw_trailing;
}
close($archive_handle) or reject('unreadable archive', 1);
reject('data after compressed archive', 1) if length($compressed_trailing);

reject('required internal inventory is missing', 1) unless defined $manifest_content;
my $inventory = parse_inventory($manifest_content);
if ($expected_inventory ne '') {
    open(my $expected, '<:raw', $expected_inventory) or reject('unreadable expected inventory', 1);
    local $/;
    my $content = <$expected>;
    close($expected);
    reject('internal inventory content mismatch', 1) unless $content eq $manifest_content;
}
my $inventory_entry = $entries{'.hvo-application-state-inventory'};
reject('invalid internal inventory metadata', 1)
    unless defined($inventory_entry) && $inventory_entry->{type} eq 'F' && $inventory_entry->{mode} == 0600 &&
        $inventory_entry->{uid} == $expected_uid && $inventory_entry->{gid} == $expected_gid;
my $expected_count = scalar(keys %$inventory) + 1;
reject('archive/inventory entry-count mismatch', abs(scalar(keys %entries) - $expected_count) || 1)
    unless scalar(keys %entries) == $expected_count;
for my $path (keys %entries) {
    next if $path eq '.hvo-application-state-inventory';
    reject('extra archived entries', 1) unless exists $inventory->{$path};
    my $actual = $entries{$path};
    my $wanted = $inventory->{$path};
    reject('inventory type mismatch', 1) unless $actual->{type} eq $wanted->{type};
    reject('inventory mode mismatch', 1) unless $actual->{mode} == $wanted->{mode};
    reject('inventory ownership mismatch', 1)
        unless $actual->{uid} == $wanted->{uid} && $actual->{gid} == $wanted->{gid};
    if ($actual->{type} eq 'F') {
        reject('inventory size mismatch', 1) unless $actual->{size} eq $wanted->{size};
        reject('inventory digest mismatch', 1) unless $actual->{digest} eq $wanted->{digest};
    }
}

for my $path (sort { length($b) <=> length($a) } keys %directory_modes) {
    chmod($directory_modes{$path}, $path) == 1 or reject('safe extraction failure', 1);
}

my %walked;
find({
    no_chdir => 1,
    wanted => sub {
        return if $File::Find::name eq $extract_root;
        my $relative = substr($File::Find::name, length($extract_root) + 1);
        my @stat = lstat($File::Find::name);
        reject('post-extraction filesystem entry', 1) unless @stat && (S_ISREG($stat[2]) || S_ISDIR($stat[2]));
        reject('post-extraction duplicate path', 1) if $walked{$relative}++;
        if (supported_path($relative)) {
            reject('post-extraction unlisted inventory item', 1) unless exists $inventory->{$relative};
            my $wanted = $inventory->{$relative};
            reject('post-extraction inventory type mismatch', 1)
                unless ($wanted->{type} eq 'D' && S_ISDIR($stat[2])) || ($wanted->{type} eq 'F' && S_ISREG($stat[2]));
            reject('post-extraction inventory mode mismatch', 1) unless ($stat[2] & 07777) == $wanted->{mode};
            reject('post-extraction inventory ownership mismatch', 1)
                unless $stat[4] == $wanted->{uid} && $stat[5] == $wanted->{gid};
        }
        if (exists $entries{$relative}) {
            my $entry = $entries{$relative};
            reject('post-extraction type mismatch', 1)
                unless ($entry->{type} eq 'D' && S_ISDIR($stat[2])) || ($entry->{type} eq 'F' && S_ISREG($stat[2]));
            reject('post-extraction mode mismatch', 1) unless ($stat[2] & 07777) == $entry->{mode};
            reject('post-extraction ownership mismatch', 1)
                unless $stat[4] == $entry->{uid} && $stat[5] == $entry->{gid};
            if ($entry->{type} eq 'F') {
                reject('post-extraction size mismatch', 1) unless $stat[7] == $entry->{size};
                open(my $verify, '<:raw', $File::Find::name) or reject('post-extraction read failure', 1);
                my $sha = Digest::SHA->new(256);
                $sha->addfile($verify);
                close($verify);
                reject('post-extraction digest mismatch', 1) unless $sha->hexdigest eq $entry->{digest};
            }
        }
    }
}, $extract_root);
for my $path (keys %entries) {
    reject('post-extraction missing entry', 1) unless $walked{$path};
}
for my $path (keys %$inventory) {
    reject('post-extraction missing inventory item', 1) unless $walked{$path};
}

print "inventory-v1\n";
PERL
