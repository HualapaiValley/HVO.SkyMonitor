#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

# Enforce ShellCheck error diagnostics over exactly the shell-file set owned by
# scripts/ci:shell-syntax. Warnings remain a separately recorded backlog.

readonly SHELLCHECK_VERSION='0.9.0'
readonly SHELLCHECK_ARCHIVE='shellcheck-v0.9.0.linux.x86_64.tar.xz'
readonly SHELLCHECK_SHA256='700324c6dd0ebea0117591c6cc9d7350d9c7c5c287acbad7630fa17b1d4d9e2f'
readonly SHELLCHECK_URL="https://github.com/koalaman/shellcheck/releases/download/v${SHELLCHECK_VERSION}/${SHELLCHECK_ARCHIVE}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly REPO_ROOT

targets_file=''
if [[ "${1-}" == '--targets-from' ]]; then
    (($# == 2)) || { printf 'Usage: %s [--targets-from FILE]\n' "${0##*/}" >&2; exit 2; }
    targets_file="$2"
elif (($# > 0)); then
    printf 'Usage: %s [--targets-from FILE]\n' "${0##*/}" >&2
    exit 2
fi

shellcheck_bin="${HVO_SHELLCHECK_BIN-}"
cleanup_root=''
cleanup() {
    [[ -z "$cleanup_root" ]] || rm -rf "$cleanup_root"
}
trap cleanup EXIT

if [[ -z "$shellcheck_bin" ]]; then
    [[ "$(uname -s)" == 'Linux' && "$(uname -m)" == 'x86_64' ]] || {
        printf '%s supports its pinned release artifact on Linux x86_64; set HVO_SHELLCHECK_BIN to a verified ShellCheck %s binary on this host.\n' \
            "${0##*/}" "$SHELLCHECK_VERSION" >&2
        exit 1
    }
    for command in curl mktemp sha256sum tar; do
        command -v "$command" >/dev/null 2>&1 || { printf '%s requires %s.\n' "${0##*/}" "$command" >&2; exit 1; }
    done
    cleanup_root="$(mktemp -d)"
    archive="$cleanup_root/$SHELLCHECK_ARCHIVE"
    if [[ -n "${HVO_SHELLCHECK_ARCHIVE_PATH-}" ]]; then
        [[ -f "$HVO_SHELLCHECK_ARCHIVE_PATH" ]] || {
            printf 'ShellCheck archive cache is not a regular file: %s\n' "$HVO_SHELLCHECK_ARCHIVE_PATH" >&2
            exit 1
        }
        cp "$HVO_SHELLCHECK_ARCHIVE_PATH" "$archive"
    else
        curl -fsSL -o "$archive" "$SHELLCHECK_URL"
    fi
    printf '%s  %s\n' "$SHELLCHECK_SHA256" "$archive" | sha256sum --check --status || {
        printf 'ShellCheck %s archive checksum verification failed.\n' "$SHELLCHECK_VERSION" >&2
        exit 1
    }
    tar -xJf "$archive" -C "$cleanup_root"
    shellcheck_bin="$cleanup_root/shellcheck-v${SHELLCHECK_VERSION}/shellcheck"
fi

[[ -x "$shellcheck_bin" ]] || { printf 'ShellCheck binary is not executable: %s\n' "$shellcheck_bin" >&2; exit 1; }
actual_version="$($shellcheck_bin --version | awk '$1 == "version:" { print $2 }')"
if [[ "$actual_version" != "$SHELLCHECK_VERSION" ]]; then
    printf 'Expected ShellCheck %s, got %s from %s.\n' \
        "$SHELLCHECK_VERSION" "${actual_version:-<unreadable>}" "$shellcheck_bin" >&2
    exit 1
fi

targets=()
if [[ -n "$targets_file" ]]; then
    [[ -f "$targets_file" ]] || { printf 'ShellCheck target file does not exist: %s\n' "$targets_file" >&2; exit 1; }
    mapfile -t targets < "$targets_file"
else
    mapfile -t targets < <("$BASH" "$SCRIPT_DIR/ci:shell-syntax" --list)
fi

if ((${#targets[@]} == 0)); then
    printf 'No shell files selected for ShellCheck.\n' >&2
    exit 1
fi

resolved=()
for target in "${targets[@]}"; do
    [[ -n "$target" ]] || { printf 'ShellCheck target set contains an empty record.\n' >&2; exit 1; }
    if [[ "$target" == /* ]]; then
        path="$target"
    else
        path="$REPO_ROOT/$target"
    fi
    [[ -f "$path" ]] || {
        printf 'ShellCheck target is not a regular file: %s\n' "$target" >&2
        printf 'The line-delimited selector contract therefore refuses paths containing newlines.\n' >&2
        exit 1
    }
    resolved+=("$path")
done

"$shellcheck_bin" -x --severity=error "${resolved[@]}"
printf 'ShellCheck %s error enforcement passed for %d derived shell file(s).\n' \
    "$SHELLCHECK_VERSION" "${#resolved[@]}"
