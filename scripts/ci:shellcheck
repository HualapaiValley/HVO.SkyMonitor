#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

# Enforce ShellCheck error diagnostics over exactly the shell-file set owned by
# scripts/ci:shell-syntax. Warnings remain a separately recorded backlog.

readonly SHELLCHECK_VERSION='0.9.0'
readonly SHELLCHECK_ARCHIVE='shellcheck-v0.9.0.linux.x86_64.tar.xz'
readonly SHELLCHECK_SHA256='700324c6dd0ebea0117591c6cc9d7350d9c7c5c287acbad7630fa17b1d4d9e2f'
readonly SHELLCHECK_URL="https://github.com/koalaman/shellcheck/releases/download/v${SHELLCHECK_VERSION}/${SHELLCHECK_ARCHIVE}"
for command in awk dirname mktemp od realpath rm tail tr uname; do
    command -v "$command" >/dev/null 2>&1 || { printf '%s requires %s.\n' "${0##*/}" "$command" >&2; exit 1; }
done
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="${HVO_SHELLCHECK_REPO_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
REPO_ROOT="$(realpath -e -- "$REPO_ROOT")"
readonly REPO_ROOT

targets_file=''
if [[ "${1-}" == '--targets-from0' ]]; then
    (($# == 2)) || { printf 'Usage: %s [--targets-from0 FILE]\n' "${0##*/}" >&2; exit 2; }
    targets_file="$2"
elif (($# > 0)); then
    printf 'Usage: %s [--targets-from0 FILE]\n' "${0##*/}" >&2
    exit 2
fi

shellcheck_bin="${HVO_SHELLCHECK_BIN-}"
cleanup_root=''
selector_output=''
cleanup_files=()
cleanup() {
    [[ -z "$cleanup_root" ]] || rm -rf "$cleanup_root"
    ((${#cleanup_files[@]} == 0)) || rm -f -- "${cleanup_files[@]}"
}
trap cleanup EXIT

if [[ -z "$shellcheck_bin" ]]; then
    [[ "$(uname -s)" == 'Linux' && "$(uname -m)" == 'x86_64' ]] || {
        printf '%s supports its pinned release artifact on Linux x86_64; set HVO_SHELLCHECK_BIN to a verified ShellCheck %s binary on this host.\n' \
            "${0##*/}" "$SHELLCHECK_VERSION" >&2
        exit 1
    }
    for command in cp curl sha256sum tar; do
        command -v "$command" >/dev/null 2>&1 || { printf '%s requires %s.\n' "${0##*/}" "$command" >&2; exit 1; }
    done
    cleanup_root="$(mktemp -d)"
    archive="$cleanup_root/$SHELLCHECK_ARCHIVE"
    if [[ -n "${HVO_SHELLCHECK_ARCHIVE_PATH-}" ]]; then
        [[ -f "$HVO_SHELLCHECK_ARCHIVE_PATH" ]] || {
            printf 'ShellCheck archive cache is not a regular file: %s\n' "$HVO_SHELLCHECK_ARCHIVE_PATH" >&2
            exit 1
        }
        cp "$HVO_SHELLCHECK_ARCHIVE_PATH" "$archive"
    else
        curl -fsSL -o "$archive" "$SHELLCHECK_URL"
    fi
    printf '%s  %s\n' "$SHELLCHECK_SHA256" "$archive" | sha256sum --check --status || {
        printf 'ShellCheck %s archive checksum verification failed.\n' "$SHELLCHECK_VERSION" >&2
        exit 1
    }
    tar -xJf "$archive" -C "$cleanup_root"
    shellcheck_bin="$cleanup_root/shellcheck-v${SHELLCHECK_VERSION}/shellcheck"
fi

[[ -x "$shellcheck_bin" ]] || { printf 'ShellCheck binary is not executable: %s\n' "$shellcheck_bin" >&2; exit 1; }
actual_version="$($shellcheck_bin --version | awk '$1 == "version:" { print $2 }')"
if [[ "$actual_version" != "$SHELLCHECK_VERSION" ]]; then
    printf 'Expected ShellCheck %s, got %s from %s.\n' \
        "$SHELLCHECK_VERSION" "${actual_version:-<unreadable>}" "$shellcheck_bin" >&2
    exit 1
fi

targets=()
if [[ -n "$targets_file" ]]; then
    [[ -f "$targets_file" ]] || { printf 'ShellCheck target file does not exist: %s\n' "$targets_file" >&2; exit 1; }
    selector_output="$targets_file"
else
    selector="${HVO_SHELL_SELECTOR:-$SCRIPT_DIR/ci:shell-syntax}"
    selector_output="$(mktemp)"
    cleanup_files+=("$selector_output")
    if ! "$BASH" "$selector" --list0 > "$selector_output"; then
        printf 'Shell file selector failed; refusing partial output from %s.\n' "$selector" >&2
        exit 1
    fi
fi

if [[ -s "$selector_output" ]]; then
    final_byte="$(tail -c 1 "$selector_output" | od -An -tu1 | tr -d '[:space:]')"
    [[ "$final_byte" == 0 ]] || {
        printf 'Shell file selector output is not terminated by a NUL record delimiter.\n' >&2
        exit 1
    }
fi
mapfile -d '' -t targets < "$selector_output"

if ((${#targets[@]} == 0)); then
    printf 'No shell files selected for ShellCheck.\n' >&2
    exit 1
fi

resolved=()
declare -A seen=()
resolution_output="$(mktemp)"
cleanup_files+=("$resolution_output")
resolve_one() {
    local variable="$1"
    shift
    local -a records
    if ! realpath -z "$@" > "$resolution_output"; then
        return 1
    fi
    mapfile -d '' -t records < "$resolution_output"
    ((${#records[@]} == 1)) || return 1
    printf -v "$variable" '%s' "${records[0]}"
}
for target in "${targets[@]}"; do
    [[ -n "$target" ]] || { printf 'ShellCheck target set contains an empty record.\n' >&2; exit 1; }
    [[ "$target" != /* ]] || {
        printf 'ShellCheck target must be a normalized repository-relative path: %s\n' "$target" >&2
        exit 1
    }
    resolve_one lexical -m -s --relative-to="$REPO_ROOT" -- "$REPO_ROOT/$target" || {
        printf 'Unable to canonicalize ShellCheck target: %s\n' "$target" >&2
        exit 1
    }
    [[ "$lexical" == "$target" && "$lexical" != '..' && "$lexical" != ../* ]] || {
        printf 'ShellCheck target must be a normalized repository-relative path: %s\n' "$target" >&2
        exit 1
    }
    path="$REPO_ROOT/$target"
    [[ -f "$path" ]] || {
        printf 'ShellCheck target is not a regular file: %s\n' "$target" >&2
        printf 'The target set is therefore incomplete or references a missing worktree path.\n' >&2
        exit 1
    }
    resolve_one canonical -e -- "$path" || {
        printf 'Unable to resolve ShellCheck target: %s\n' "$target" >&2
        exit 1
    }
    [[ "$canonical" == "$REPO_ROOT/"* ]] || {
        printf 'ShellCheck target resolves outside the repository: %s -> %s\n' "$target" "$canonical" >&2
        exit 1
    }
    [[ -z "${seen[$canonical]+x}" ]] || {
        printf 'ShellCheck target resolves to a duplicate file: %s -> %s\n' "$target" "$canonical" >&2
        exit 1
    }
    seen[$canonical]=1
    resolved+=("$path")
done

"$shellcheck_bin" -x --severity=error "${resolved[@]}"
printf 'ShellCheck %s error enforcement passed for %d derived shell file(s).\n' \
    "$SHELLCHECK_VERSION" "${#resolved[@]}"
