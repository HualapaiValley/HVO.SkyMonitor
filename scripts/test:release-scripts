    '200:{"attestations":[{}]}{"attestations":[{}]}' "$attestations_read (200, but not one JSON document)" attested "$image_digest"
expect_check_read_refusal "an attestations read cut short" "${repo}_attestations_$image_digest" \
    '200/1:{"attestations":[{}]}' "$attestations_read (200, but gh failed)" attested "$image_digest"
expect_check_read_refusal "attestations GitHub does not have" "${repo}_attestations_$image_digest" '404:{"message":"Not Found"}' \
    "$attestations_read (404)" attested "$image_digest"

# The push script: a release version alone, through skopeo, and the digest read back must be the archive's.
index_digest="sha256:$(printf 'index' | sha256sum | cut -d ' ' -f 1)"
mkdir "$test_root/layout"
printf '{"schemaVersion":2,"manifests":[{"mediaType":"application/vnd.oci.image.index.v1+json","digest":"%s","size":5}]}\n' \
    "$index_digest" >"$test_root/layout/index.json"
tar -cf "$test_root/image.oci.tar" -C "$test_root/layout" index.json
# A fake skopeo whose registry has the tag only once something was copied there, unless a case says it had it already
# (FAKE_SKOPEO_EXISTING) or cannot be read (FAKE_SKOPEO_INSPECT_ERROR); after a copy it serves FAKE_SKOPEO_SERVED.
cat >"$fake_bin/skopeo" <<'FAKE_SKOPEO'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"$FAKE_SKOPEO_LOG"
case "$1" in
    copy)
        status="${FAKE_SKOPEO_COPY_STATUS:-0}"
        [[ "$status" != 0 ]] || : >"$FAKE_SKOPEO_LOG.copied"
        exit "$status"
        ;;
    inspect)
        if [[ -e "$FAKE_SKOPEO_LOG.copied" ]]; then
            printf '%s' "${FAKE_SKOPEO_SERVED:-index}"
        elif [[ -n "${FAKE_SKOPEO_INSPECT_ERROR:-}" ]]; then
            printf 'time="x" level=fatal msg="%s"\n' "$FAKE_SKOPEO_INSPECT_ERROR" >&2
            exit 1
        elif [[ -n "${FAKE_SKOPEO_EXISTING:-}" ]]; then
            printf '%s' "$FAKE_SKOPEO_EXISTING"
        else
            printf 'time="x" level=fatal msg="reading manifest 1.2.0-dev.3: manifest unknown"\n' >&2
            exit 1
        fi
        ;;
    *) exit 90 ;;
esac
FAKE_SKOPEO
chmod +x "$fake_bin/skopeo"
export FAKE_SKOPEO_LOG="$test_root/skopeo.log"
reset_registry() {
    : >"$FAKE_SKOPEO_LOG"
    rm -f "$FAKE_SKOPEO_LOG.copied"
}
reset_registry

pushed="$("$repo_root/scripts/release:push-image" "$test_root/image.oci.tar" ghcr.io/hualapaivalley/skymonitor-cameraagent:1.2.0-dev.3)"
[[ "$pushed" == "$index_digest" ]] || fail "the push printed $pushed, not the archive's digest."
grep -Fxq "copy --dest-tls-verify=true --retry-times 3 --all --preserve-digests oci-archive:$test_root/image.oci.tar docker://ghcr.io/hualapaivalley/skymonitor-cameraagent:1.2.0-dev.3" \
    "$FAKE_SKOPEO_LOG" || fail "the push did not copy every platform with its digests."

expect_push_refusal() {
    local label="$1" message="$2"
    shift 2
    if "$repo_root/scripts/release:push-image" "$@" >/dev/null 2>"$test_root/push.err"; then
        fail "the push admitted $label."
    fi
    grep -Fq -- "$message" "$test_root/push.err" || { cat "$test_root/push.err" >&2; fail "the push refused $label without saying: $message"; }
}
reset_registry
expect_push_refusal "latest" "is not a release version" "$test_root/image.oci.tar" ghcr.io/hualapaivalley/skymonitor-cameraagent:latest
expect_push_refusal "an untagged repository" "is not <repository>:<tag>" "$test_root/image.oci.tar" ghcr.io/hualapaivalley/skymonitor-cameraagent
expect_push_refusal "--insecure to a remote registry" "--insecure is only for a registry on this host" \
    --insecure "$test_root/image.oci.tar" ghcr.io/hualapaivalley/skymonitor-cameraagent:1.2.0-dev.3
[[ ! -s "$FAKE_SKOPEO_LOG" ]] || fail "a refused push reached skopeo."

# A version tag the registry has for another image is never moved, and nothing is copied.
FAKE_SKOPEO_EXISTING=other expect_push_refusal "a tag the registry has for another image" "a version tag is never moved" \
    "$test_root/image.oci.tar" ghcr.io/hualapaivalley/skymonitor-cameraagent:1.2.0-dev.3
! grep -q '^copy' "$FAKE_SKOPEO_LOG" || fail "the push copied over a tag that names another image."
reset_registry
FAKE_SKOPEO_INSPECT_ERROR="unauthorized: authentication required" expect_push_refusal "a registry it cannot read" \
    "cannot tell whether" "$test_root/image.oci.tar" ghcr.io/hualapaivalley/skymonitor-cameraagent:1.2.0-dev.3
! grep -q '^copy' "$FAKE_SKOPEO_LOG" || fail "the push copied to a registry it could not read."
# Only the registry's own "no such tag or repository" counts as absent; a failure that merely says "not found" does not.
reset_registry
FAKE_SKOPEO_INSPECT_ERROR="received unexpected HTTP status: 503 Service Unavailable (upstream not found)" \
    expect_push_refusal "a registry failing with a message that says not found" \
    "cannot tell whether" "$test_root/image.oci.tar" ghcr.io/hualapaivalley/skymonitor-cameraagent:1.2.0-dev.3
! grep -q '^copy' "$FAKE_SKOPEO_LOG" || fail "the push copied after a failed read that said not found."
# A rerun pushes the same image to the tag again.
reset_registry
rerun="$(FAKE_SKOPEO_EXISTING=index "$repo_root/scripts/release:push-image" "$test_root/image.oci.tar" \
    ghcr.io/hualapaivalley/skymonitor-cameraagent:1.2.0-dev.3)"
[[ "$rerun" == "$index_digest" ]] || fail "a rerun of the same image was not admitted."

reset_registry
FAKE_SKOPEO_SERVED=other expect_push_refusal "a registry serving another image" "not $index_digest, the image the archive holds" \
    "$test_root/image.oci.tar" ghcr.io/hualapaivalley/skymonitor-cameraagent:1.2.0-dev.3
reset_registry
FAKE_SKOPEO_COPY_STATUS=1 expect_push_refusal "a failed copy" "cannot push" \
    "$test_root/image.oci.tar" ghcr.io/hualapaivalley/skymonitor-cameraagent:1.2.0-dev.3
reset_registry
"$repo_root/scripts/release:push-image" --insecure "$test_root/image.oci.tar" localhost:5000/hualapaivalley/skymonitor-cameraagent:1.2.0-dev.3 >/dev/null
grep -Fq -- "--dest-tls-verify=false" "$FAKE_SKOPEO_LOG" || fail "--insecure did not reach skopeo for a registry on this host."

# The image check: the archive holds the image release.json names, an image for each of its platforms, each labelled as
# the release's CameraAgent with its version, commit, created time and state contract (install contract sections 1, 6).
labels_root="$test_root/labels"
state_contract='{"identity":{"writes":1,"reads":{"min":1,"max":1}},"rawIngress":{"writes":15,"reads":{"min":13,"max":15}}}'
release_labels="$(jq -cn --arg commit "$commit" --arg contract "$state_contract" '{
    "io.hvo.skymonitor.component": "CameraAgent", "org.opencontainers.image.version": "1.2.0-dev.3",
    "org.opencontainers.image.revision": $commit, "org.opencontainers.image.created": "2026-10-17T18:00:00Z",
    "io.hvo.skymonitor.state-contracts": $contract}')"
# Stores stdin as a blob of the OCI layout in $1 and prints its digest.
add_blob() {
    local file="$1/blob.tmp" digest
    cat >"$file"
    digest="$(sha256sum "$file" | cut -d ' ' -f 1)"
    mv "$file" "$1/blobs/sha256/$digest"
    printf 'sha256:%s' "$digest"
}
# Writes $1/image.oci.tar, a two-platform image whose amd64 configuration carries the labels $2 and whose arm64 one
# carries $3 (by default $2), and $1/release.json naming it, changed by the jq filter $4.
write_labelled_release() {
    local dir="$1" amd64_labels="$2" arm64_labels="${3:-$2}" change="${4:-.}" entries=() architecture labels config manifest
    rm -rf "$dir"
    mkdir -p "$dir/oci/blobs/sha256"
    for architecture in amd64 arm64; do
        labels="$amd64_labels"
        [[ "$architecture" == amd64 ]] || labels="$arm64_labels"
        config="$(jq -cn --arg architecture "$architecture" --argjson labels "$labels" \
            '{architecture: $architecture, os: "linux", config: {Labels: $labels}}' | add_blob "$dir/oci")"
        manifest="$(jq -cn --arg config "$config" '{schemaVersion: 2, mediaType: "application/vnd.oci.image.manifest.v1+json",
            config: {mediaType: "application/vnd.oci.image.config.v1+json", digest: $config, size: 1}, layers: []}' | add_blob "$dir/oci")"
        entries+=("$(jq -cn --arg manifest "$manifest" --arg architecture "$architecture" '{mediaType: "application/vnd.oci.image.manifest.v1+json",
            digest: $manifest, size: 1, platform: {architecture: $architecture, os: "linux"}}')")
    done
    index="$(printf '%s\n' "${entries[@]}" | jq -cs '{schemaVersion: 2, mediaType: "application/vnd.oci.image.index.v1+json", manifests: .}' |
        add_blob "$dir/oci")"
    jq -cn --arg index "$index" '{schemaVersion: 2, manifests: [{mediaType: "application/vnd.oci.image.index.v1+json", digest: $index, size: 1}]}' \
        >"$dir/oci/index.json"
    printf '{"imageLayoutVersion":"1.0.0"}' >"$dir/oci/oci-layout"
    tar -cf "$dir/image.oci.tar" -C "$dir/oci" oci-layout index.json blobs
    jq -n --arg index "$index" --arg commit "$commit" --argjson contract "$state_contract" '{version: "1.2.0-dev.3", commit: $commit,
        created: "2026-10-17T18:00:00Z", images: {cameraAgent: {digest: $index, platforms: ["linux/amd64", "linux/arm64"]}},
        stateContracts: {cameraAgent: $contract}}' | jq "$change" >"$dir/release.json"
}
check_labels() {
    "$repo_root/scripts/release:check-image-labels" "$1/image.oci.tar" "$1/release.json"
}
expect_labels_refusal() {
    local label="$1" message="$2"
    shift 2
    write_labelled_release "$labels_root/refused" "$@"
    if check_labels "$labels_root/refused" >/dev/null 2>"$labels_root/refused.err"; then
        fail "the image check admitted $label."
    fi
    grep -Fq -- "$message" "$labels_root/refused.err" ||
        { cat "$labels_root/refused.err" >&2; fail "the image check refused $label without saying: $message"; }
}
mkdir "$labels_root"
write_labelled_release "$labels_root/release" "$release_labels"
check_labels "$labels_root/release" >"$labels_root/release.out" || fail "the image check refused the release's own image."
[[ "$(cat "$labels_root/release.out")" == "linux/amd64: CameraAgent 1.2.0-dev.3, commit $commit, created 2026-10-17T18:00:00Z
linux/arm64: CameraAgent 1.2.0-dev.3, commit $commit, created 2026-10-17T18:00:00Z" ]] ||
    { cat "$labels_root/release.out" >&2; fail "the image check did not name each platform image it checked."; }
expect_labels_refusal "an image without a created label" \
    "linux/arm64: its created label (org.opencontainers.image.created) is absent, not release.json's created time 2026-10-17T18:00:00Z." \
    "$release_labels" "$(jq -c 'del(.["org.opencontainers.image.created"])' <<<"$release_labels")"
expect_labels_refusal "an image created at another time" \
    "linux/amd64: its created label (org.opencontainers.image.created) is \"2026-10-17T18:00:00+00:00\", not release.json's created time 2026-10-17T18:00:00Z." \
    "$(jq -c '.["org.opencontainers.image.created"] = "2026-10-17T18:00:00+00:00"' <<<"$release_labels")"
expect_labels_refusal "a release.json created at another time" \
    "linux/amd64: its created label (org.opencontainers.image.created) is \"2026-10-17T18:00:00Z\", not release.json's created time 2026-10-17T18:00:01Z." \
    "$release_labels" "$release_labels" '.created = "2026-10-17T18:00:01Z"'
expect_labels_refusal "an image without a state contract" \
    "linux/arm64: its state contract label (io.hvo.skymonitor.state-contracts) is not release.json's stateContracts.cameraAgent." \
    "$release_labels" "$(jq -c 'del(.["io.hvo.skymonitor.state-contracts"])' <<<"$release_labels")"
expect_labels_refusal "a state contract other than release.json's" \
    "linux/amd64: its state contract label (io.hvo.skymonitor.state-contracts) is not release.json's stateContracts.cameraAgent." \
    "$release_labels" "$release_labels" '.stateContracts.cameraAgent.identity = {writes: 2, reads: {min: 1, max: 2}}'
expect_labels_refusal "a release.json without stateContracts" "has no stateContracts.cameraAgent." \
    "$release_labels" "$release_labels" 'del(.stateContracts)'
expect_labels_refusal "a release.json whose stateContracts is not a state contract" \
    "stateContracts.cameraAgent is not a state contract" "$release_labels" "$release_labels" \
    '.stateContracts.cameraAgent.rawIngress.reads.min = 16'
expect_labels_refusal "a release.json that keys its image by the image's name" "has no cameraAgent image." \
    "$release_labels" "$release_labels" '.images = {"skymonitor-cameraagent": .images.cameraAgent}'
expect_labels_refusal "an image of another version" \
    "linux/amd64: the image is not labelled as CameraAgent 1.2.0-dev.3 from commit $commit." \
    "$(jq -c '.["org.opencontainers.image.version"] = "1.2.0-dev.4"' <<<"$release_labels")"
expect_labels_refusal "an archive of another image" "not the image sha256:$(printf '0%.0s' {1..64}) that" \
    "$release_labels" "$release_labels" ".images.cameraAgent.digest = \"sha256:$(printf '0%.0s' {1..64})\""
expect_labels_refusal "an archive with an image for a platform the release does not list" \
    "holds images for linux/amd64,linux/arm64, not linux/amd64." "$release_labels" "$release_labels" \
    '.images.cameraAgent.platforms = ["linux/amd64"]'
# Each value is compared whole, as JSON gives it: a shell copy would drop a trailing LF and pass it (PR-1364-R1 F1).
# release.json's own values must be whole and valid, so a matching label cannot make an invalid one pass.
expect_labels_refusal "an image whose created label ends in LF" \
    "linux/arm64: its created label (org.opencontainers.image.created) is \"2026-10-17T18:00:00Z\\n\", not release.json's created time 2026-10-17T18:00:00Z." \
    "$release_labels" "$(jq -c '.["org.opencontainers.image.created"] += "\n"' <<<"$release_labels")"
expect_labels_refusal "an image whose created label is empty" \
    "linux/amd64: its created label (org.opencontainers.image.created) is \"\", not release.json's created time 2026-10-17T18:00:00Z." \
    "$(jq -c '.["org.opencontainers.image.created"] = ""' <<<"$release_labels")"
expect_labels_refusal "a release.json whose created time ends in LF" \
    "has no created time, an RFC 3339 UTC time such as 2026-10-17T18:00:00Z." \
    "$release_labels" "$release_labels" '.created += "\n"'
expect_labels_refusal "an empty created time and images without the label" \
    "has no created time, an RFC 3339 UTC time such as 2026-10-17T18:00:00Z." \
    "$(jq -c 'del(.["org.opencontainers.image.created"])' <<<"$release_labels")" "" '.created = ""'
expect_labels_refusal "a created time that is no time, matched by the label" \
    "has no created time, an RFC 3339 UTC time such as 2026-10-17T18:00:00Z." \
    "$(jq -c '.["org.opencontainers.image.created"] = "not-a-time"' <<<"$release_labels")" "" '.created = "not-a-time"'
expect_labels_refusal "a created time that is no date, matched by the label" \
    "has no created time, an RFC 3339 UTC time such as 2026-10-17T18:00:00Z." \
    "$(jq -c '.["org.opencontainers.image.created"] = "2026-02-30T18:00:00Z"' <<<"$release_labels")" "" \
    '.created = "2026-02-30T18:00:00Z"'
expect_labels_refusal "an image whose version label ends in LF" \
    "linux/arm64: the image is not labelled as CameraAgent 1.2.0-dev.3 from commit $commit." \
    "$release_labels" "$(jq -c '.["org.opencontainers.image.version"] += "\n"' <<<"$release_labels")"
expect_labels_refusal "an image whose revision label ends in LF" \
    "linux/arm64: the image is not labelled as CameraAgent 1.2.0-dev.3 from commit $commit." \
    "$release_labels" "$(jq -c '.["org.opencontainers.image.revision"] += "\n"' <<<"$release_labels")"
expect_labels_refusal "an image whose component label ends in LF" \
    "linux/arm64: the image is not labelled as CameraAgent 1.2.0-dev.3 from commit $commit." \
    "$release_labels" "$(jq -c '.["io.hvo.skymonitor.component"] += "\n"' <<<"$release_labels")"
expect_labels_refusal "an image whose state contract label ends in LF" \
    "linux/arm64: its state contract label (io.hvo.skymonitor.state-contracts) is not release.json's stateContracts.cameraAgent." \
    "$release_labels" "$(jq -c '.["io.hvo.skymonitor.state-contracts"] += "\n"' <<<"$release_labels")"
expect_labels_refusal "a release.json whose version ends in LF" "has no version, a release version such as 1.2.0-dev.3." \
    "$release_labels" "$release_labels" '.version += "\n"'
expect_labels_refusal "a release.json whose commit ends in LF" "has no commit, a 40-character lowercase commit ID." \
    "$release_labels" "$release_labels" '.commit += "\n"'
expect_labels_refusal "a release.json whose image digest ends in LF" "has no cameraAgent image." \
    "$release_labels" "$release_labels" '.images.cameraAgent.digest += "\n"'
expect_labels_refusal "a release.json whose last platform ends in LF" "has no cameraAgent image platforms" \
    "$release_labels" "$release_labels" '.images.cameraAgent.platforms[1] += "\n"'

# The final-release scripts (#1310) read the checkout they run in: its VersionPrefix, CHANGELOG.md and upgrade notes.
# They run here from a copy of themselves in a repository of their own, whose product version is 2.5.0.
final_repo="$test_root/final-repo"
mkdir -p "$final_repo/scripts/lib" "$final_repo/docs/upgrade-notes"
for script in release:version release:notes release:check-environment release:gate release:publish release:tag-latest; do
    cp "$repo_root/scripts/$script" "$final_repo/scripts/$script"
done
cp "$repo_root/scripts/lib/github-api.sh" "$repo_root/scripts/lib/releases.sh" "$final_repo/scripts/lib/"
printf '<Project>\n  <PropertyGroup>\n    <VersionPrefix>2.5.0</VersionPrefix>\n  </PropertyGroup>\n</Project>\n' \
    >"$final_repo/Directory.Build.props"
# The release PR's notes: 2.5.0's CHANGELOG section and its upgrade notes.
final_notes() {
    cat >"$final_repo/CHANGELOG.md" <<'CHANGELOG'
# Changelog

## [Unreleased]

## [2.5.0] - 2026-11-02

### Added

- Final releases.

## [2.4.0] - 2026-10-01

- Older.

[Unreleased]: https://github.com/HualapaiValley/HVO.SkyMonitor/compare/v2.5.0...HEAD
[2.5.0]: https://github.com/HualapaiValley/HVO.SkyMonitor/releases/tag/v2.5.0
CHANGELOG
    printf 'Nothing to do by hand.\n' >"$final_repo/docs/upgrade-notes/2.5.0.md"
}
final_notes

# A final release needs its CHANGELOG section and upgrade notes; a release candidate needs neither.
"$final_repo/scripts/release:notes" --check 2.5.0 || fail "release:notes refused 2.5.0's notes."
[[ "$("$final_repo/scripts/release:notes" --body 2.5.0)" == $'## Changes\n\n### Added\n\n- Final releases.\n\n## Upgrade notes\n\nNothing to do by hand.' ]] ||
    fail "release:notes --body printed: $("$final_repo/scripts/release:notes" --body 2.5.0)"
expect_notes_refusal() {
    local label="$1" message="$2" version="${3:-2.5.0}"
    if "$final_repo/scripts/release:notes" --check "$version" >/dev/null 2>"$test_root/notes.err"; then
        fail "release:notes admitted $label."
    fi
    grep -Fq -- "$message" "$test_root/notes.err" || { cat "$test_root/notes.err" >&2; fail "release:notes refused $label without saying: $message"; }
}
rm "$final_repo/docs/upgrade-notes/2.5.0.md"
"$final_repo/scripts/release:notes" --check 2.5.0-rc.1 || fail "release:notes required notes of a release candidate."
expect_notes_refusal "a release without upgrade notes" "docs/upgrade-notes/2.5.0.md is missing or empty"
printf ' \n\t\n' >"$final_repo/docs/upgrade-notes/2.5.0.md"
expect_notes_refusal "a release whose upgrade notes are blank" "docs/upgrade-notes/2.5.0.md is missing or empty"
final_notes
sed -i 's/^## \[2\.5\.0\] - 2026-11-02$/## [Unreleased 2.5.0]/' "$final_repo/CHANGELOG.md"
expect_notes_refusal "a release without its CHANGELOG section" "CHANGELOG.md has no '## [2.5.0]' section with text"
final_notes
sed -i '/^### Added$/d; /^- Final releases\.$/d' "$final_repo/CHANGELOG.md"
expect_notes_refusal "a release whose CHANGELOG section is empty" "CHANGELOG.md has no '## [2.5.0]' section with text"
final_notes
sed -i 's/^## \[2\.5\.0\] - 2026-11-02$/## [2.5.0]-rc - 2026-11-02/' "$final_repo/CHANGELOG.md"
expect_notes_refusal "a CHANGELOG heading for another version" "CHANGELOG.md has no '## [2.5.0]' section with text"
final_notes

# The publish job's environment must require a reviewer, or GitHub would run it unapproved.
environment_key="${repo}_environments_production-release"
protected_environment='{"name":"production-release","can_admins_bypass":false,"protection_rules":[{"id":1,"type":"required_reviewers","prevent_self_review":false,"reviewers":[{"type":"User","reviewer":{"login":"RoySalisbury","id":1}}]},{"id":2,"type":"branch_policy"}]}'
environment_case() {
    export FAKE_GH="$test_root/gh-environment-$1"
    rm -rf "$FAKE_GH"
    mkdir -p "$FAKE_GH"
    printf '%s\n' "$protected_environment" >"$FAKE_GH/$environment_key.json"
}
run_environment() {
    GITHUB_REPOSITORY=HualapaiValley/HVO.SkyMonitor "$final_repo/scripts/release:check-environment" production-release \
        >"$test_root/environment.out" 2>"$test_root/environment.err"
}
expect_environment_refusal() {
    local label="$1" message="$2"
    if run_environment; then
        fail "the environment check passed $label."
    fi
    grep -Fq -- "$message" "$test_root/environment.err" ||
        { cat "$test_root/environment.err" >&2; fail "the environment check refused $label without saying: $message"; }
}
environment_case protected
run_environment || { cat "$test_root/environment.err" >&2; fail "the environment check refused a protected environment."; }
[[ "$(cat "$test_root/environment.out")" == $'The environment production-release requires a reviewer: RoySalisbury.\nPrevent self-review: false; administrators may bypass: false.' ]] ||
    fail "the environment check printed: $(cat "$test_root/environment.out")"
environment_case team
printf '%s\n' '{"name":"production-release","protection_rules":[{"type":"required_reviewers","reviewers":[{"type":"Team","reviewer":{"slug":"release-owners","id":2}}]}]}' \
    >"$FAKE_GH/$environment_key.json"
run_environment && grep -Fq "requires a reviewer: release-owners." "$test_root/environment.out" ||
    fail "the environment check did not admit a team as the required reviewer."
for rules in '[]' '[{"type":"wait_timer","wait_timer":30}]' '[{"type":"required_reviewers","reviewers":[]}]' '[{"type":"branch_policy"}]'; do
    environment_case "unprotected"
    printf '{"name":"production-release","protection_rules":%s}\n' "$rules" >"$FAKE_GH/$environment_key.json"
    expect_environment_refusal "an environment with the rules $rules" "The environment production-release requires no reviewer"
done
environment_case missing
rm "$FAKE_GH/$environment_key.json"
expect_environment_refusal "a missing environment" "The environment production-release does not exist"
environment_case unreadable
printf '503' >"$FAKE_GH/$environment_key.status"
expect_environment_refusal "an environment GitHub failed to read" "cannot read the environment production-release (503)"
environment_case cut-short
script_answers "$environment_key" "200/1:$protected_environment"
expect_environment_refusal "an environment read cut short" "cannot read the environment production-release (200, but gh failed)"
environment_case malformed
script_answers "$environment_key" '200:{"name":"production-release"}'
expect_environment_refusal "an environment answered without its rules" "cannot read the environment production-release (200, but not the expected answer)"

# The release gate: an annotated vX.Y.Z or vX.Y.Z-rc.N tag naming the product version, on main, with a final release's
# notes, not yet released, and publishing held for approval.
final_gate_case() {
    export FAKE_GH="$test_root/gh-final-gate-$1"
    rm -rf "$FAKE_GH"
    mkdir -p "$FAKE_GH"
    local tag
    for tag in v2.5.0 v2.5.0-rc.1 v2.6.0 v2.5.0-dev.1; do
        printf '{"object":{"type":"tag","sha":"%s"}}\n' "$tag_object" >"$FAKE_GH/${repo}_git_ref_tags_$tag.json"
    done
    printf '{"object":{"type":"commit","sha":"%s"}}\n' "$commit" >"$FAKE_GH/${repo}_git_tags_$tag_object.json"
    printf '{"status":"behind"}\n' >"$FAKE_GH/${repo}_compare_main...$commit.json"
    printf '[{"tag_name":"v2.4.0","draft":false,"prerelease":false},{"tag_name":"v2.5.0-dev.4","draft":false,"prerelease":true}]\n' \
        >"$FAKE_GH/${repo}_releases.json"
    printf '%s\n' "$protected_environment" >"$FAKE_GH/$environment_key.json"
    printf '{"commit":{"committer":{"date":"2026-11-02T18:00:00Z"}}}\n' >"$FAKE_GH/${repo}_commits_$commit.json"
    final_notes
}
run_final_gate() {
    GITHUB_REPOSITORY=HualapaiValley/HVO.SkyMonitor "$final_repo/scripts/release:gate" "$1" "${2:-$commit}" \
        >"$test_root/final-gate.out" 2>"$test_root/final-gate.err"
}
expect_final_gate_refusal() {
    local label="$1" message="$2"
    if run_final_gate "${3:-v2.5.0}" "${4:-$commit}"; then
        fail "the release gate admitted $label."
    fi
    grep -Fq -- "$message" "$test_root/final-gate.err" ||
        { cat "$test_root/final-gate.err" >&2; fail "the release gate refused $label without saying: $message"; }
}
final_gate_case admitted
run_final_gate v2.5.0 || { cat "$test_root/final-gate.err" >&2; fail "the release gate refused v2.5.0."; }
[[ "$(cat "$test_root/final-gate.out")" == $'version=2.5.0\ntag=v2.5.0\ncommit='"$commit"$'\ncreated=2026-11-02T18:00:00Z\nprerelease=false' ]] ||
    fail "the release gate's outputs are wrong: $(cat "$test_root/final-gate.out")"
grep -Fq "requires a reviewer: RoySalisbury." "$test_root/final-gate.err" || fail "the release gate did not report the environment's reviewer."
final_gate_case release-candidate
rm "$final_repo/docs/upgrade-notes/2.5.0.md"
run_final_gate v2.5.0-rc.1 || { cat "$test_root/final-gate.err" >&2; fail "the release gate refused v2.5.0-rc.1 without notes."; }
grep -Fxq "prerelease=true" "$test_root/final-gate.out" || fail "the release gate did not mark v2.5.0-rc.1 a pre-release."
final_gate_case other-version
expect_final_gate_refusal "a tag for another version" "the tag 'v2.6.0' is for 2.6.0, but Directory.Build.props holds 2.5.0" v2.6.0
for tag in v2.5.0-dev.1 v2.5 v2.5.0-rc.0 2.5.0 v2.5.0+build; do
    expect_final_gate_refusal "the tag $tag" "the tag '$tag' is not a release tag" "$tag"
done
expect_final_gate_refusal "a short commit" "is not a 40-character commit ID." v2.5.0 0123456
final_gate_case lightweight
printf '{"object":{"type":"commit","sha":"%s"}}\n' "$commit" >"$FAKE_GH/${repo}_git_ref_tags_v2.5.0.json"
expect_final_gate_refusal "a lightweight tag" "v2.5.0 is a lightweight tag"
final_gate_case retargeted
printf '{"object":{"type":"commit","sha":"%s"}}\n' "$other" >"$FAKE_GH/${repo}_git_tags_$tag_object.json"
expect_final_gate_refusal "a tag naming another commit" "v2.5.0 names $other, not the commit $commit"
final_gate_case missing-tag
rm "$FAKE_GH/${repo}_git_ref_tags_v2.5.0.json"
expect_final_gate_refusal "a deleted tag" "The tag v2.5.0 does not exist."
final_gate_case unreadable-tag
printf '503' >"$FAKE_GH/${repo}_git_ref_tags_v2.5.0.status"
expect_final_gate_refusal "a tag GitHub failed to read" "cannot read the tag v2.5.0 (503)"
for status in diverged ahead; do
    final_gate_case "$status"
    printf '{"status":"%s"}\n' "$status" >"$FAKE_GH/${repo}_compare_main...$commit.json"
    expect_final_gate_refusal "a commit $status from main" "is not on main (compared with it, it is $status)"
done
final_gate_case no-changelog
sed -i 's/^## \[2\.5\.0\] - 2026-11-02$/## [Unreleased 2.5.0]/' "$final_repo/CHANGELOG.md"
expect_final_gate_refusal "a final release without its CHANGELOG section" "CHANGELOG.md has no '## [2.5.0]' section with text"
final_gate_case no-notes
rm "$final_repo/docs/upgrade-notes/2.5.0.md"
expect_final_gate_refusal "a final release without its upgrade notes" "docs/upgrade-notes/2.5.0.md is missing or empty"
final_gate_case released
printf '[{"tag_name":"v2.5.0","draft":false,"prerelease":false}]\n' >"$FAKE_GH/${repo}_releases.json"
expect_final_gate_refusal "a tag already released" "A release for v2.5.0 already exists"
final_gate_case unreadable-releases
printf '503' >"$FAKE_GH/${repo}_releases.status"
expect_final_gate_refusal "a releases list GitHub failed to read" "cannot read the releases of HualapaiValley/HVO.SkyMonitor (503)"
final_gate_case unprotected
printf '{"name":"production-release","protection_rules":[]}\n' >"$FAKE_GH/$environment_key.json"
expect_final_gate_refusal "an environment that requires no reviewer" "The environment production-release requires no reviewer"
final_gate_case no-environment
rm "$FAKE_GH/$environment_key.json"
expect_final_gate_refusal "a missing environment" "The environment production-release does not exist"
final_gate_case no-time
printf '{"commit":{"committer":{"date":"yesterday"}}}\n' >"$FAKE_GH/${repo}_commits_$commit.json"
expect_final_gate_refusal "a commit without a committer time" "has no committer time."

# Publishing: latest moves only for the newest final release, by version, and is read for certain before and after.
final_publish_case() {
    export FAKE_GH="$test_root/gh-final-publish-$1"
    rm -rf "$FAKE_GH"
    mkdir -p "$FAKE_GH"
    printf '%s\n' "${2:-[]}" >"$FAKE_GH/${repo}_releases.json"
    shift "$(( $# < 2 ? $# : 2 ))"
    script_answers "${repo}_releases_latest" "$@"
}
run_final_publish() {
    GITHUB_REPOSITORY=HualapaiValley/HVO.SkyMonitor "$final_repo/scripts/release:publish" "${1:-v2.5.0}" \
        >"$test_root/final-publish.out" 2>"$test_root/final-publish.err"
}
expect_final_published() {
    local label="$1" moved="$2" edit="$3" tag="${4:-v2.5.0}"
    run_final_publish "$tag" || { cat "$test_root/final-publish.err" >&2; fail "the publish failed for $label."; }
    [[ "$(cat "$test_root/final-publish.out")" == "moved=$moved" ]] ||
        fail "the publish printed $(cat "$test_root/final-publish.out") for $label, not moved=$moved."
    grep -Fxq -- "release edit $tag --repo HualapaiValley/HVO.SkyMonitor $edit" "$FAKE_GH/edits.log" ||
        { cat "$FAKE_GH/edits.log" >&2; fail "the publish did not publish $label with $edit."; }
}
expect_final_publish_refusal() {
    local label="$1" message="$2" edited="$3"
    if run_final_publish "${4:-v2.5.0}"; then
        fail "the publish succeeded for $label."
    fi
    grep -Fq -- "$message" "$test_root/final-publish.err" ||
        { cat "$test_root/final-publish.err" >&2; fail "the publish refused $label without saying: $message"; }
    if [[ "$edited" == edited ]]; then
        [[ -s "$FAKE_GH/edits.log" ]] || fail "the publish of $label did not reach the edit."
    else
        [[ ! -e "$FAKE_GH/edits.log" ]] || fail "the publish of $label edited the draft before it should."
    fi
}
draft_final='{"tag_name":"v2.5.0","draft":true,"prerelease":false}'
published_final='{"tag_name":"v2.5.0","draft":false,"prerelease":false}'
latest_is() { printf '200:{"tag_name":"%s"}' "$1"; }
final_publish_case newest "[{\"tag_name\":\"v2.4.0\",\"draft\":false,\"prerelease\":false},$draft_final]" "$(latest_is v2.4.0)" "$(latest_is v2.5.0)"
expect_final_published "the newest final release" true "--draft=false --prerelease=false --latest=true"
final_publish_case first "[$draft_final]" "$not_found" "$(latest_is v2.5.0)"
expect_final_published "the first final release" true "--draft=false --prerelease=false --latest=true"
final_publish_case by-number "[{\"tag_name\":\"v2.4.10\",\"draft\":false,\"prerelease\":false},$draft_final]" "$(latest_is v2.4.10)" "$(latest_is v2.5.0)"
expect_final_published "a release newer than 2.4.10" true "--draft=false --prerelease=false --latest=true"
final_publish_case older-line "[{\"tag_name\":\"v2.10.0\",\"draft\":false,\"prerelease\":false},$draft_final]" "$(latest_is v2.10.0)" "$(latest_is v2.10.0)"
expect_final_published "a fix to an older version than 2.10.0" false "--draft=false --prerelease=false --latest=false"
final_publish_case newer-draft "[{\"tag_name\":\"v3.0.0\",\"draft\":true,\"prerelease\":false},{\"tag_name\":\"v3.1.0\",\"draft\":false,\"prerelease\":true},{\"tag_name\":\"v2.4.0\",\"draft\":false,\"prerelease\":false},$draft_final]" \
    "$(latest_is v2.4.0)" "$(latest_is v2.5.0)"
expect_final_published "a release older only than a draft and a pre-release" true "--draft=false --prerelease=false --latest=true"
final_publish_case candidate "[{\"tag_name\":\"v2.4.0\",\"draft\":false,\"prerelease\":false},{\"tag_name\":\"v2.5.0-rc.1\",\"draft\":true,\"prerelease\":true}]" \
    "$(latest_is v2.4.0)" "$(latest_is v2.4.0)"
expect_final_published "a release candidate" false "--draft=false --prerelease=true --latest=false" v2.5.0-rc.1
final_publish_case already-published "[$published_final]"
expect_final_publish_refusal "a release already published" "The release for v2.5.0 is not the draft it should be (draft=false prerelease=false" unedited
final_publish_case marked-prerelease '[{"tag_name":"v2.5.0","draft":true,"prerelease":true}]'
expect_final_publish_refusal "a final release's draft marked a pre-release" "is not the draft it should be (draft=true prerelease=true, not draft=true prerelease=false)" unedited
final_publish_case unmarked-candidate '[{"tag_name":"v2.5.0-rc.1","draft":true,"prerelease":false}]'
expect_final_publish_refusal "a release candidate's draft not marked a pre-release" "not draft=true prerelease=true" unedited v2.5.0-rc.1
final_publish_case gone '[{"tag_name":"v2.4.0","draft":false,"prerelease":false}]'
expect_final_publish_refusal "a draft that is gone" "No release or draft has v2.5.0; the tested draft is gone." unedited
final_publish_case two "[$draft_final,$draft_final]"
expect_final_publish_refusal "two drafts with the tag" "2 releases have the tag v2.5.0" unedited
final_publish_case other-version '[{"tag_name":"v2.6.0","draft":true,"prerelease":false}]'
expect_final_publish_refusal "a tag for another version" "is for 2.6.0, but Directory.Build.props holds 2.5.0" unedited v2.6.0
final_publish_case unread-before "[$draft_final]" '503:{"message":"Service Unavailable"}'
expect_final_publish_refusal "a latest release that cannot be read before" "cannot read the latest release (503)" unedited
final_publish_case unread-after "[$draft_final]" "$not_found" '503:{"message":"Service Unavailable"}'
expect_final_publish_refusal "a latest release that cannot be read after" "cannot be read back to show where it is" edited
final_publish_case not-moved "[{\"tag_name\":\"v2.4.0\",\"draft\":false,\"prerelease\":false},$draft_final]" "$(latest_is v2.4.0)" "$(latest_is v2.4.0)"
expect_final_publish_refusal "a newest final release GitHub does not make latest" "the latest release is v2.4.0, not v2.5.0" edited
final_publish_case moved "[{\"tag_name\":\"v2.10.0\",\"draft\":false,\"prerelease\":false},$draft_final]" "$(latest_is v2.10.0)" "$(latest_is v2.5.0)"
expect_final_publish_refusal "an older version's fix GitHub makes latest" "Publishing v2.5.0 moved the latest release from v2.10.0 to v2.5.0" edited
final_publish_case edit-fails "[$draft_final]" "$not_found"
FAKE_GH_EDIT_STATUS=1 expect_final_publish_refusal "a publish GitHub refuses" "cannot publish v2.5.0" edited
final_publish_case unreadable-releases
printf '503' >"$FAKE_GH/${repo}_releases.status"
expect_final_publish_refusal "a releases list that cannot be read" "cannot read the releases of HualapaiValley/HVO.SkyMonitor (503)" unedited

# The image's latest tag follows the newest final release, from the digest its version tag still names.
latest_releases="[{\"tag_name\":\"v2.4.0\",\"draft\":false,\"prerelease\":false},$published_final]"
latest_case() {
    export FAKE_GH="$test_root/gh-tag-latest-$1"
    rm -rf "$FAKE_GH"
    mkdir -p "$FAKE_GH"
    printf '%s\n' "${2:-$latest_releases}" >"$FAKE_GH/${repo}_releases.json"
    printf '{"tag_name":"%s"}\n' "${3:-v2.5.0}" >"$FAKE_GH/${repo}_releases_latest.json"
    reset_registry
}
run_tag_latest() {
    GITHUB_REPOSITORY=HualapaiValley/HVO.SkyMonitor "$final_repo/scripts/release:tag-latest" \
        ghcr.io/hualapaivalley/skymonitor-cameraagent "${1:-v2.5.0}" "${2:-$index_digest}" \
        >"$test_root/tag-latest.out" 2>"$test_root/tag-latest.err"
}
expect_latest_kept() {
    local label="$1" message="$2"
    run_tag_latest "${3:-v2.5.0}" || { cat "$test_root/tag-latest.err" >&2; fail "the latest tag failed for $label."; }
    grep -Fq -- "$message" "$test_root/tag-latest.out" || fail "the latest tag did not say for $label: $message"
    [[ ! -s "$FAKE_SKOPEO_LOG" ]] || fail "the latest tag reached the registry for $label."
}
expect_latest_refusal() {
    local label="$1" message="$2"
    if run_tag_latest; then
        fail "the latest tag moved for $label."
    fi
    grep -Fq -- "$message" "$test_root/tag-latest.err" || { cat "$test_root/tag-latest.err" >&2; fail "the latest tag refused $label without saying: $message"; }
}
latest_case moved
FAKE_SKOPEO_EXISTING=index run_tag_latest || { cat "$test_root/tag-latest.err" >&2; fail "the latest tag did not move to the newest final release."; }
grep -Fxq "copy --dest-tls-verify=true --retry-times 3 --all --preserve-digests docker://ghcr.io/hualapaivalley/skymonitor-cameraagent@$index_digest docker://ghcr.io/hualapaivalley/skymonitor-cameraagent:latest" \
    "$FAKE_SKOPEO_LOG" || fail "the latest tag was not copied from the release's digest with every platform."
grep -Fq "skymonitor-cameraagent:latest is $index_digest, the image of v2.5.0" "$test_root/tag-latest.out" ||
    fail "the latest tag did not report where it moved."
latest_case candidate "[{\"tag_name\":\"v2.5.0-rc.1\",\"draft\":false,\"prerelease\":true}]" v2.4.0
expect_latest_kept "a release candidate" "v2.5.0-rc.1 is a release candidate: the image latest tag stays where it is." v2.5.0-rc.1
latest_case older-line "[{\"tag_name\":\"v2.10.0\",\"draft\":false,\"prerelease\":false},$published_final]" v2.10.0
expect_latest_kept "a fix to an older version" "v2.5.0 is not the newest final release (2.10.0 is): the image latest tag stays where it is."
latest_case draft "[$draft_final]"
expect_latest_refusal "a release still a draft" "The release for v2.5.0 is not one published final release (draft=true prerelease=false)"
latest_case github-latest-elsewhere "" v2.4.0
expect_latest_refusal "a newest final release GitHub does not mark latest" "but GitHub's latest release is v2.4.0"
latest_case other-image
FAKE_SKOPEO_EXISTING=other expect_latest_refusal "a version tag naming another image" "is not $index_digest in the registry"
! grep -q '^copy' "$FAKE_SKOPEO_LOG" || fail "the latest tag copied an image its version tag does not name."
latest_case copy-fails
FAKE_SKOPEO_EXISTING=index FAKE_SKOPEO_COPY_STATUS=1 expect_latest_refusal "a copy the registry refuses" "cannot tag ghcr.io/hualapaivalley/skymonitor-cameraagent:latest."
latest_case served-other
FAKE_SKOPEO_EXISTING=index FAKE_SKOPEO_SERVED=other expect_latest_refusal "a latest tag the registry serves as another image" "after it was tagged"
latest_case unreadable-releases
printf '503' >"$FAKE_GH/${repo}_releases.status"
expect_latest_refusal "a releases list that cannot be read" "cannot read the releases of HualapaiValley/HVO.SkyMonitor (503)"

# The asset script refuses bad arguments before it builds anything.
cat >"$fake_bin/docker" <<'FAKE_DOCKER'
#!/usr/bin/env bash
printf 'the asset script ran docker before refusing its arguments\n' >&2
exit 90
FAKE_DOCKER
chmod +x "$fake_bin/docker"
cp "$fake_bin/docker" "$fake_bin/dotnet"
expect_assets_refusal() {
    local message="$1"
    shift
    if "$repo_root/scripts/release:assets" "$@" >/dev/null 2>"$test_root/assets.err"; then
        fail "the asset script admitted $*."
    fi
    grep -Fq -- "$message" "$test_root/assets.err" || { cat "$test_root/assets.err" >&2; fail "the asset script refused $* without saying: $message"; }
}
expect_assets_refusal "must be a release version" --version 1.2.0+build --output "$test_root/out" --image-oci "$test_root/out.tar"
expect_assets_refusal "must be a release version" --version v1.2.0 --output "$test_root/out" --image-oci "$test_root/out.tar"
expect_assets_refusal "already exists" --version 1.2.0-dev.3 --output "$test_root" --image-oci "$test_root/out.tar"
expect_assets_refusal "--platforms must be" --version 1.2.0-dev.3 --output "$test_root/out" --image-oci "$test_root/out.tar" --platforms linux/386
expect_assets_refusal "Usage:" --version 1.2.0-dev.3 --output "$test_root/out"
expect_assets_refusal "is not this checkout's HEAD" --version 1.2.0-dev.3 --output "$test_root/out" --image-oci "$test_root/out.tar" \
    --commit "$other"

# One product version (#1310): scripts/release:version reads Directory.Build.props's VersionPrefix, and the release
# scripts take no other version.
prefix="$("$repo_root/scripts/release:version")"
[[ "$prefix" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || fail "release:version printed '$prefix', not a release version."
[[ "$(sed -n 's:^[[:space:]]*<VersionPrefix>\([^<]*\)</VersionPrefix>[[:space:]]*$:\1:p' "$repo_root/Directory.Build.props")" == "$prefix" ]] ||
    fail "release:version printed $prefix, which is not Directory.Build.props's VersionPrefix."
other_version="$((${prefix%%.*} + 1)).0.0"
[[ "$("$repo_root/scripts/release:version" --dev)" == "$prefix-dev" ]] || fail "release:version --dev is not $prefix-dev."
[[ "$("$repo_root/scripts/release:version" --tag "v$prefix")" == "$prefix" ]] || fail "release:version --tag v$prefix is not $prefix."
[[ "$("$repo_root/scripts/release:version" --tag "v$prefix-rc.2")" == "$prefix-rc.2" ]] ||
    fail "release:version --tag v$prefix-rc.2 is not $prefix-rc.2."
for version in "$prefix" "$prefix-rc.1" "$prefix-dev.3"; do
    "$repo_root/scripts/release:version" --check "$version" || fail "release:version refused $version."
done
expect_version_refusal() {
    local message="$1" output
    shift
    if output="$("$repo_root/scripts/release:version" "$@" 2>&1)"; then
        fail "release:version admitted $*."
    fi
    grep -Fq -- "$message" <<<"$output" || { printf '%s\n' "$output" >&2; fail "release:version refused $* without saying: $message"; }
}
expect_version_refusal "is for $other_version, but Directory.Build.props holds $prefix" --check "$other_version"
expect_version_refusal "is for $other_version, but Directory.Build.props holds $prefix" --check "$other_version-dev.1"
expect_version_refusal "is not a release version" --check "$prefix+build"
expect_version_refusal "is not a release version" --check "v$prefix"
expect_version_refusal "is not a release version" --check "$prefix-"
expect_version_refusal "is not a release tag" --tag "v$prefix-dev.1"
expect_version_refusal "is not a release tag" --tag "$prefix"
