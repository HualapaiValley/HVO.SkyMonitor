    { cat "$test_root/assets.err" >&2; fail "the asset script refused a final release without its notes without saying so."; }

# test:release-install leaves nothing behind, however far it gets: an install that fails after loading the release's
# image, and a stand-in image that fails to be created or committed. A fake Docker keeps its images and containers as
# files under $FAKE_DOCKER, and a fake installer loads the release's image the way the real one does before it can fail.
cat >"$fake_bin/docker" <<'FAKE_DOCKER'
#!/usr/bin/env bash
set -euo pipefail
state="$FAKE_DOCKER"
printf '%s\n' "$*" >>"$state/calls.log"
image_file() {
    local name="$1" file
    for file in "$state"/images/*; do
        [[ -e "$file" ]] || continue
        if grep -Fxq -- "$name" "$file"; then
            printf '%s\n' "$file"
            return 0
        fi
    done
    return 1
}
case "$1 ${2:-}" in
    "image ls")
        for file in "$state"/images/*; do [[ -e "$file" ]] && head -n 1 "$file"; done
        exit 0
        ;;
    "image inspect")
        reference="${!#}"
        file="$(image_file "$reference")" || { printf 'Error: No such image: %s\n' "$reference" >&2; exit 1; }
        head -n 1 "$file"
        exit 0
        ;;
    "image rm")
        reference="${!#}"
        file="$(image_file "$reference")" || { printf 'Error: No such image: %s\n' "$reference" >&2; exit 1; }
        rm -f "$file"
        exit 0
        ;;
    "network rm")
        exit 1
        ;;
    "create --name")
        [[ "${FAKE_DOCKER_FAIL:-}" != create ]] || exit 1
        file="$(image_file "$4")" || exit 1
        head -n 1 "$file" >"$state/containers/$3"
        exit 0
        ;;
    "commit --change")
        [[ "${FAKE_DOCKER_FAIL:-}" != commit ]] || exit 1
        [[ -f "$state/containers/$4" ]] || exit 1
        id="sha256:$(printf '%s' "$5" | sha256sum | cut -d ' ' -f 1)"
        printf '%s\n%s\n' "$id" "$5" >"$state/images/${id#sha256:}"
        exit 0
        ;;
esac
if [[ "$1" == rm ]]; then
    shift
    [[ "${1:-}" != --force ]] || shift
    for name in "$@"; do rm -f "$state/containers/$name"; done
    exit 0
fi
printf 'fake docker: unexpected %s\n' "$*" >&2
exit 90
FAKE_DOCKER
chmod +x "$fake_bin/docker"

release_version=1.2.0-dev.3
index_id="sha256:$(printf 'index' | sha256sum | cut -d ' ' -f 1)"
manifest_id="sha256:$(printf 'manifest' | sha256sum | cut -d ' ' -f 1)"
config_id="sha256:$(printf 'config' | sha256sum | cut -d ' ' -f 1)"
unrelated_id="sha256:$(printf 'unrelated' | sha256sum | cut -d ' ' -f 1)"
fake_release="$test_root/fake-release"
mkdir -p "$fake_release" "$test_root/catalog/hyg-test.bundle"
jq -n --arg version "$release_version" --arg commit "$commit" --arg index "$index_id" --arg manifest "$manifest_id" \
    --arg config "$config_id" '{
        version: $version, commit: $commit,
        images: {cameraAgent: {repository: "ghcr.io/hualapaivalley/skymonitor-cameraagent", digest: $index,
            offlineArchives: [
                {platform: "linux/amd64", manifestDigest: $manifest, configDigest: $config},
                {platform: "linux/arm64", manifestDigest: $manifest, configDigest: $config}]}},
        assets: [{name: "hyg-test.bundle.tar.gz", kind: "catalog"}]}' >"$fake_release/release.json"
tar -czf "$fake_release/hyg-test.bundle.tar.gz" -C "$test_root/catalog" hyg-test.bundle
cat >"$fake_release/hvo-sky-install-linux-x64" <<'FAKE_INSTALLER'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$1" == --version ]]; then
    printf '%s\n' "$FAKE_RELEASE_IDENTITY"
    exit 0
fi
command=("$1" "${2:-}")
instance="" product=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --instance-id) instance="$2"; shift 2 ;;
        --product-root) product="$2"; shift 2 ;;
        *) shift ;;
    esac
done
case "${command[0]} ${command[1]}" in
    "cameraagent install")
        # The real installer loads the release's image before anything can still fail.
        printf '%s\n%s\n' "$FAKE_IMAGE_ID" "ghcr.io/hualapaivalley/skymonitor-cameraagent:$FAKE_VERSION" \
            >"$FAKE_DOCKER/images/${FAKE_IMAGE_ID#sha256:}"
        if [[ "${FAKE_INSTALL:-}" == fail ]]; then
            printf '{"schemaVersion":1,"errorCode":"installation-failed","message":"injected"}\n' >&2
            exit 1
        fi
        mkdir -p "$product/cameraagents/$instance/state/deployment"
        printf '{"releaseVersion":"%s","source":"archive"}\n' "$FAKE_VERSION" \
            >"$product/cameraagents/$instance/state/deployment/image-distribution.json"
        printf '%s' "$FAKE_IMAGE_ID" >"$FAKE_DOCKER/active"
        printf '{"image":{"imageId":"%s","source":"archive"},"healthy":true}\n' "$FAKE_IMAGE_ID"
        ;;
    "status --instance-id")
        printf '{"outcome":"status","image":{"imageId":"%s"},"running":true,"healthy":true}\n' "$(cat "$FAKE_DOCKER/active")"
        ;;
    *)
        exit 1
        ;;
esac
FAKE_INSTALLER
chmod +x "$fake_release/hvo-sky-install-linux-x64"
cp "$fake_release/hvo-sky-install-linux-x64" "$fake_release/hvo-sky-install-linux-arm64"
(cd "$fake_release" && sha256sum release.json hyg-test.bundle.tar.gz hvo-sky-install-linux-x64 hvo-sky-install-linux-arm64 >SHA256SUMS)
export FAKE_RELEASE_IDENTITY="$release_version+$commit" FAKE_VERSION="$release_version" FAKE_IMAGE_ID="$config_id"

# Runs test:release-install against the fake release and requires it to fail with Docker and TMPDIR as they began.
# Pass "held" to start with the release's image already in Docker, which the run must then leave there.
expect_install_cleanup() {
    local label="$1" held="${2:-}"
    export FAKE_DOCKER="$test_root/docker-$label"
    rm -rf "$FAKE_DOCKER" "$test_root/tmp-$label"
    mkdir -p "$FAKE_DOCKER/images" "$FAKE_DOCKER/containers" "$test_root/tmp-$label"
    printf '%s\n' "$unrelated_id" >"$FAKE_DOCKER/images/${unrelated_id#sha256:}"
    if [[ "$held" == held ]]; then
        printf '%s\n' "$config_id" >"$FAKE_DOCKER/images/${config_id#sha256:}"
    fi
    local before
    before="$(ls "$FAKE_DOCKER/images")"
    if TMPDIR="$test_root/tmp-$label" "$repo_root/scripts/test:release-install" --release "$fake_release" --upgrade-source archive \
        >"$test_root/install-$label.out" 2>"$test_root/install-$label.err"; then
        fail "test:release-install passed although $label."
    fi
    [[ "$(ls "$FAKE_DOCKER/images")" == "$before" ]] || {
        cat "$FAKE_DOCKER/calls.log" >&2
        fail "test:release-install left Docker's images changed after $label: $(ls "$FAKE_DOCKER/images" | tr '\n' ' ')"
    }
    [[ -z "$(ls "$FAKE_DOCKER/containers")" ]] || fail "test:release-install left a container after $label."
    [[ -z "$(ls "$test_root/tmp-$label")" ]] || fail "test:release-install left its temporary root after $label."
}
FAKE_INSTALL=fail expect_install_cleanup "the install failed after loading the image"
FAKE_DOCKER_FAIL=create expect_install_cleanup "the stand-in container could not be created"
FAKE_DOCKER_FAIL=commit expect_install_cleanup "the stand-in image could not be committed"
FAKE_INSTALL=fail expect_install_cleanup "the install failed with the image already held" held
grep -Fq -- "${config_id}" "$test_root/docker-the install failed with the image already held/images/${config_id#sha256:}" ||
    fail "test:release-install removed an image Docker held before it began."

# The release workflow's shape (#1310), which actionlint does not check: CI qualifies the commit before anything is built,
# both platforms install from the draft, publishing waits for production-release's approval and checks its rule first,
# only the draft, publish and latest jobs can write, and latest moves only after publishing moved it.
python3 - "$repo_root" <<'PY' || fail "the release workflow's shape is wrong."
import pathlib
import re
import sys

root = pathlib.Path(sys.argv[1])
release = (root / ".github/workflows/release.yml").read_text()
ci = (root / ".github/workflows/ci.yml").read_text()
errors = []


def job(name):
    match = re.search(rf"^  {re.escape(name)}:\n(.*?)(?=^  [\w-]+:\n|\Z)", release, re.M | re.S)
    if not match:
        errors.append(f"release.yml has no {name} job")
        return ""
    return match.group(1)


def require(condition, message):
    if not condition:
        errors.append(message)


on = re.search(r"^on:\n(.*?)(?=^\S)", release, re.M | re.S).group(1)
require(on.strip().splitlines()[0].strip() == "push:" and "workflow_dispatch" not in on and "pull_request" not in on,
        "release.yml runs on anything but a tag push")
require(re.findall(r"^      - '(.*)'$", on, re.M) == ["v[0-9]+.[0-9]+.[0-9]+", "v[0-9]+.[0-9]+.[0-9]+-rc.[0-9]+"],
        "release.yml runs on tags other than vX.Y.Z and vX.Y.Z-rc.N")
require(re.search(r"^on:\n(?:.*\n)*?  workflow_call:\n", ci, re.M) is not None, "ci.yml cannot be called")
jobs = re.findall(r"^  ([\w-]+):\n", release.split("\njobs:\n", 1)[1], re.M)
require(jobs == ["gate", "ci", "build", "draft", "install-test", "publish", "latest"], f"release.yml's jobs are {jobs}")
require("uses: ./.github/workflows/ci.yml" in job("ci"), "the ci job does not call ci.yml")
require("needs: [gate, ci]" in job("build"), "the build job does not wait for CI")
install = job("install-test")
require("platform: linux-x64" in install and "platform: linux-arm64" in install and "fail-fast: false" in install,
        "the install test does not run on linux-x64 and linux-arm64 alike")
require("needs: [gate, draft]" in install and "./scripts/test:release-install --release" in install,
        "the install test does not install from the draft")
publish = job("publish")
require("needs: [gate, draft, install-test]" in publish, "the publish job does not wait for both install tests")
check = publish.find("./scripts/release:check-environment production-release")
published = publish.find("./scripts/release:publish ")
require(0 <= check < published, "the publish job does not check the environment's approval rule before publishing")
for name in jobs:
    environment = re.findall(r"^    environment: (.*)$", job(name), re.M)
    require(environment == (["production-release"] if name == "publish" else []), f"the {name} job's environment is {environment}")
    writes = re.findall(r"^      ([\w-]+): write$", job(name), re.M)
    allowed = {"draft": ["contents", "packages", "id-token", "attestations"], "publish": ["contents"], "latest": ["packages"]}
    require(writes == allowed.get(name, []), f"the {name} job can write {writes}")
latest = job("latest")
require("needs: [gate, draft, publish]" in latest and "if: needs.publish.outputs.moved == 'true'" in latest,
        "the latest job runs without publishing having moved the latest release")
if errors:
    print("\n".join(errors), file=sys.stderr)
    sys.exit(1)
PY

# install.sh's tests bring their own fake commands, so they run on the PATH this script was given.
PATH="${PATH#"$fake_bin:"}" "$repo_root/scripts/test:install-sh" || fail "the install.sh tests failed."

printf 'Release script tests passed.\n'
