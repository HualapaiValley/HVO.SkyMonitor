git -C "$assets_repo" -c user.name=test -c user.email=test@example.test commit -q --allow-empty -m test
if "$assets_repo/scripts/release:assets" --version 2.5.0 --output "$test_root/out" --image-oci "$test_root/out.tar" --allow-dirty \
    >/dev/null 2>"$test_root/assets.err"; then
