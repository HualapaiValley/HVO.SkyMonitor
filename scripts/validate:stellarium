#!/usr/bin/env bash
# Run the external Stellarium geometry oracle and retain diagnostics in TestResults.

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly MANIFEST="$REPO_ROOT/tests/fixtures/stellarium/hualapai-fisheye-v1.json"
readonly VALIDATOR="$REPO_ROOT/tests/fixtures/stellarium/validate.jq"
readonly PARSER="$REPO_ROOT/tests/fixtures/stellarium/parse-output.jq"
readonly SSC="$REPO_ROOT/scripts/stellarium/hualapai-fisheye.ssc"
readonly TOPOLOGY="$REPO_ROOT/src/HVO.SkyMonitor.Astronomy/Data/d3-celestial-v0.7.32-topology.tsv"
readonly EXPECTED_VERSION="23.4-2build3"
readonly EXPECTED_EXECUTABLE_VERSION="Stellarium 24.4"
readonly STELLARIUM_BIN="/usr/bin/stellarium"
readonly REQUIRED_PACKAGES=(stellarium stellarium-data xvfb xauth libgl1-mesa-dri imagemagick jq)
readonly RESULTS_ROOT="${STELLARIUM_RESULTS_ROOT:-$REPO_ROOT/TestResults/stellarium}"

missing=()
wrong_versions=()
for package in "${REQUIRED_PACKAGES[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q '^install ok installed$'; then
        missing+=("$package")
    fi
done

for package in stellarium stellarium-data; do
    if installed="$(dpkg-query -W -f='${Version}' "$package" 2>/dev/null)" && [[ "$installed" != "$EXPECTED_VERSION" ]]; then
        wrong_versions+=("${package}=${installed} (expected ${EXPECTED_VERSION})")
    fi
done

if [[ ${#missing[@]} -gt 0 || ${#wrong_versions[@]} -gt 0 ]]; then
    [[ ${#missing[@]} -eq 0 ]] || echo "Missing Stellarium validation packages: ${missing[*]}" >&2
    [[ ${#wrong_versions[@]} -eq 0 ]] || echo "Incorrect pinned package versions: ${wrong_versions[*]}" >&2
    echo "Run ./scripts/validate:stellarium-container for the preferred pinned environment." >&2
    echo "For host debugging on Ubuntu 24.04, install dependencies with: ./scripts/setup:stellarium" >&2
    echo "Required apt packages: stellarium=${EXPECTED_VERSION} stellarium-data=${EXPECTED_VERSION} xvfb xauth libgl1-mesa-dri imagemagick jq" >&2
    exit 2
fi

for command in xvfb-run timeout jq convert; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "Package validation passed, but required command '$command' is not on PATH. Reinstall with ./scripts/setup:stellarium." >&2
        exit 2
    fi
done
if [[ ! -x "$STELLARIUM_BIN" ]]; then
    echo "Pinned Stellarium executable is unavailable at $STELLARIUM_BIN. Reinstall with ./scripts/setup:stellarium." >&2
    exit 2
fi

jq -e '
    .schemaVersion == 1 and
    .stellarium.packageVersion == "23.4-2build3" and
    .stellarium.runtimeVersion == "Stellarium 24.4" and
    .stellarium.viewportWidth == 1024 and
    .stellarium.viewportHeight == 1024 and
    .sensor.imageCircleRadiusPixels == (0.98 * ([.sensor.width, .sensor.height] | min) / 2) and
    (.landmarks | length) == 5 and
    (.stars | length) > 0
' "$MANIFEST" >/dev/null
expected_topology_sha256="$(jq -r '.constellationValidation.embeddedTopologySha256' "$MANIFEST")"
actual_topology_sha256="$(sha256sum "$TOPOLOGY" | cut -d ' ' -f 1)"
if [[ "$actual_topology_sha256" != "$expected_topology_sha256" ]]; then
    echo "Embedded D3-Celestial topology checksum mismatch: $actual_topology_sha256." >&2
    exit 2
fi

run_id="${STELLARIUM_RUN_ID:-$(date -u +%Y%m%dT%H%M%S%NZ)-$$}"
run_dir="$RESULTS_ROOT/$run_id"
user_dir="$(mktemp -d -t hvo-stellarium-user.XXXXXX)"
mkdir -p "$run_dir" "$HOME"

cleanup() {
    rm -rf "$user_dir"
}
trap cleanup EXIT

version_output="$(TZ=UTC LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe QT_SCALE_FACTOR=1 LC_ALL=C.UTF-8 \
    xvfb-run -a -s "-screen 0 1024x1024x24 -nolisten tcp" "$STELLARIUM_BIN" --version 2>&1)"
version="$(grep -oE 'Stellarium [0-9]+(\.[0-9]+)+' <<<"$version_output" | tail -n 1)"
if [[ "$version" != "$EXPECTED_EXECUTABLE_VERSION" ]]; then
    echo "Incorrect Stellarium executable version in '$version_output' (expected '$EXPECTED_EXECUTABLE_VERSION')." >&2
    exit 2
fi
dpkg-query -W -f='${Package}\t${Version}\n' | sort > "$run_dir/packages.txt"
{
    echo "stellarium_version=$version"
    echo "stellarium_package_version=$(dpkg-query -W -f='${Version}' stellarium)"
    echo "stellarium_data_package_version=$(dpkg-query -W -f='${Version}' stellarium-data)"
    echo "utc=2025-01-15T08:00:00Z"
    echo "observer=Hualapai Valley Observatory; latitude=35.347; longitude=-113.878; elevation=0"
    echo "projection=ProjectionFisheye; fov=180; viewport=1024x1024; disk=true; mount=azimuthal; flips=false,false"
    echo "environment=TZ=UTC LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe QT_SCALE_FACTOR=1 LC_ALL=C.UTF-8"
    echo "manifest=$MANIFEST"
    echo "startup_script=$SSC"
} > "$run_dir/settings.txt"
jq -n \
    --arg runtimeVersion "$version" \
    --arg packageVersion "$(dpkg-query -W -f='${Version}' stellarium)" \
    --arg dataPackageVersion "$(dpkg-query -W -f='${Version}' stellarium-data)" \
    --arg manifest "$MANIFEST" \
    --arg startupScript "$SSC" \
    '{
      runtimeVersion: $runtimeVersion,
      packageVersion: $packageVersion,
      dataPackageVersion: $dataPackageVersion,
      utc: "2025-01-15T08:00:00Z",
      observer: {name:"Hualapai Valley Observatory",latitudeDegrees:35.347,longitudeDegrees:-113.878,elevationMeters:0},
      projection: {model:"ProjectionFisheye",fieldOfViewDegrees:180,viewport:[1024,1024],diskViewport:true,mount:"azimuthal",horizontalFlip:false,verticalFlip:false},
      environment: {TZ:"UTC",LIBGL_ALWAYS_SOFTWARE:"1",GALLIUM_DRIVER:"llvmpipe",QT_SCALE_FACTOR:"1",LC_ALL:"C.UTF-8"},
      manifest: $manifest,
      startupScript: $startupScript
    }' > "$run_dir/settings.json"

set +e
TZ=UTC \
LIBGL_ALWAYS_SOFTWARE=1 \
GALLIUM_DRIVER=llvmpipe \
QT_SCALE_FACTOR=1 \
LC_ALL=C.UTF-8 \
xvfb-run -a -s "-screen 0 1024x1024x24 -nolisten tcp" \
    timeout --signal=TERM --kill-after=10s 45s \
    "$STELLARIUM_BIN" \
        --user-dir "$user_dir" \
        --startup-script "$SSC" \
        --screenshot-dir "$run_dir" \
        --full-screen yes \
        --dump-opengl-details \
        >"$run_dir/console.log" 2>&1
status=$?
set -e

[[ ! -f "$user_dir/log.txt" ]] || cp "$user_dir/log.txt" "$run_dir/stellarium.log"
[[ ! -f "$user_dir/stellarium-output.txt" ]] || cp "$user_dir/stellarium-output.txt" "$run_dir/stellarium-output.txt"

if [[ $status -eq 124 || $status -eq 137 ]]; then
    echo "Stellarium timed out after 45 seconds. Inspect $run_dir/console.log and stellarium.log." >&2
    exit 1
fi
if [[ $status -ne 0 ]]; then
    echo "Stellarium exited with status $status. Inspect diagnostics under $run_dir." >&2
    exit 1
fi
if [[ ! -s "$run_dir/stellarium-output.txt" ]] || ! grep -qx 'COMPLETE' "$run_dir/stellarium-output.txt"; then
    echo "Stellarium did not produce a complete coordinate record. Inspect diagnostics under $run_dir." >&2
    exit 1
fi
if [[ ! -s "$run_dir/hualapai-fisheye.png" ]]; then
    echo "Stellarium did not produce the diagnostic PNG. Check screenshot permissions in $run_dir/stellarium.log." >&2
    exit 1
fi

jq -Rn -f "$PARSER" "$run_dir/stellarium-output.txt" > "$run_dir/actual.json"

jq -n --slurpfile m "$MANIFEST" --slurpfile a "$run_dir/actual.json" -f "$VALIDATOR" > "$run_dir/report.json"

if ! jq -e '.passed' "$run_dir/report.json" >/dev/null; then
    echo "Stellarium coordinate validation failed. Inspect $run_dir/report.json and hualapai-fisheye.png." >&2
    exit 1
fi

echo "Stellarium validation passed: $run_dir/report.json"
echo "Diagnostic screenshot (not for golden comparison): $run_dir/hualapai-fisheye.png"
