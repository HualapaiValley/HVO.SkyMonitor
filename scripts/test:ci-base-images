#!/usr/bin/env python3
"""Offline controls for the base-image guard and Dependabot inventory."""
import json
import pathlib
import re
import runpy
import subprocess
import tempfile
import unittest

ROOT = pathlib.Path(__file__).resolve().parent.parent
CHECK = ROOT / "scripts/ci:base-images"
SDK = "10.0.402"
A = "a" * 64
B = "b" * 64


class BaseImages(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        self.root = pathlib.Path(self.temp.name)
        subprocess.run(["git", "init", "--quiet", self.root], check=True)
        (self.root / "global.json").write_text(json.dumps({"sdk": {"version": SDK}}))

    def dockerfile(self, path, text):
        target = self.root / path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text)
        # Fixtures also exercise the tracked-file inventory used in CI.
        subprocess.run(["git", "-C", self.root, "add", path], check=True)

    def check(self, error=None):
        result = subprocess.run([CHECK, self.root], capture_output=True, text=True)
        if error is None:
            self.assertEqual(result.returncode, 0, result.stderr)
        else:
            self.assertNotEqual(result.returncode, 0, result.stdout)
            self.assertIn(error, result.stderr)

    def test_sdk_mismatch_then_aligned(self):
        self.dockerfile("src/A/Dockerfile", f"FROM mcr.microsoft.com/dotnet/sdk:10.0.401@sha256:{A}\n")
        self.check("SDK tag must equal global.json")
        self.dockerfile("src/A/Dockerfile", f"FROM mcr.microsoft.com/dotnet/sdk:{SDK}@sha256:{A}\n")
        self.check()

    def test_shared_tag_mismatch_then_aligned(self):
        self.dockerfile("src/A/Dockerfile", f"FROM ubuntu:24.04@sha256:{A}\n")
        self.dockerfile("tools/B/Dockerfile", f"FROM ubuntu:24.04@sha256:{B}\n")
        self.check("conflicting digests for ubuntu:24.04")
        self.dockerfile("tools/B/Dockerfile", f"FROM ubuntu:24.04@sha256:{A}\n")
        self.check()

    def test_unpinned_then_pinned(self):
        self.dockerfile(".devcontainer/Dockerfile", "FROM ubuntu:24.04\n")
        self.check("FROM must be pinned by sha256 digest")
        self.dockerfile(".devcontainer/Dockerfile", f"FROM ubuntu:24.04@sha256:{A}\n")
        self.check()

    def test_platform_continuation_case_and_alias_defaults(self):
        self.dockerfile("Dockerfile", f"""ARG SDK_IMAGE=dotnet-sdk
from --platform=$BUILDPLATFORM \\
    mcr.microsoft.com/dotnet/sdk:{SDK}@sha256:{A} as dotnet-sdk
FROM ${{SDK_IMAGE}} AS build
FROM build AS final
""")
        self.check()

    def test_unpinned_argument_then_pinned(self):
        self.dockerfile("Dockerfile", "ARG BASE=ubuntu:24.04\nFROM $BASE\n")
        self.check("FROM must be pinned by sha256 digest")
        self.dockerfile("Dockerfile", f"ARG BASE=ubuntu:24.04@sha256:{A}\nFROM $BASE\n")
        self.check()

    def test_sdk_argument_is_checked(self):
        self.dockerfile("Dockerfile", f"ARG BASE=mcr.microsoft.com/dotnet/sdk:wrong@sha256:{A}\nFROM $BASE\n")
        self.check("SDK tag must equal global.json")

    def test_unresolved_argument_fails(self):
        self.dockerfile("Dockerfile", "ARG BASE\nFROM ${BASE}\n")
        self.check("unresolved FROM argument")

    def test_malformed_digest_fails(self):
        self.dockerfile("Dockerfile", "FROM ubuntu:24.04@sha256:abc\n")
        self.check("FROM must be pinned by sha256 digest")

    def test_different_tags_can_have_different_digests(self):
        self.dockerfile("Dockerfile", f"FROM ubuntu:24.04@sha256:{A} AS noble\nFROM ubuntu:22.04@sha256:{B}\n")
        self.check()

    def test_named_dockerfiles_are_checked(self):
        self.dockerfile("docker/Dockerfile.test", "FROM ubuntu:24.04\n")
        self.check("FROM must be pinned by sha256 digest")
        self.dockerfile("docker/Dockerfile.test", f"FROM ubuntu:24.04@sha256:{A}\n")
        self.dockerfile("tools/test.Dockerfile", "FROM ubuntu:24.04\n")
        self.check("FROM must be pinned by sha256 digest")

    def test_empty_inventory_fails(self):
        self.check("no Dockerfiles found")

    def test_dockerfile_without_from_fails(self):
        self.dockerfile("Dockerfile", "# no build stages\n")
        self.check("no FROM instructions")

    def test_control_characters_are_escaped_and_sdk_is_strict(self):
        self.dockerfile("bad\n::error title=forged/Dockerfile", "FROM unpinned\x1b]0;title\x07\n")
        result = subprocess.run([CHECK, self.root], capture_output=True, text=True)
        self.assertNotEqual(result.returncode, 0)
        self.assertFalse(any(line.startswith("::") for line in result.stderr.splitlines()))
        self.assertNotIn("\x1b", result.stderr)
        (self.root / "global.json").write_text(json.dumps({"sdk": {"version": SDK + "\n::error forged"}}))
        self.check("invalid stable SDK version")

    def test_registry_spelling_cannot_hide_sdk_mismatch(self):
        self.dockerfile("Dockerfile", f"FROM MCR.MICROSOFT.COM:443/dotnet/sdk:wrong@sha256:{A}\n")
        self.check("SDK tag must equal global.json")

    def test_docker_hub_spelling_cannot_hide_digest_conflict(self):
        for first, second in (("ubuntu:24.04", "docker.io/library/ubuntu:24.04"),
                              ("org/image:1", "DOCKER.IO:443/org/image:1")):
            with self.subTest(first=first):
                self.dockerfile("Dockerfile", f"FROM {first}@sha256:{A}\nFROM {second}@sha256:{B}\n")
                self.check("conflicting digests")

    def test_scratch_and_digest_only_references(self):
        self.dockerfile("Dockerfile", f"FROM scratch AS empty\nFROM ubuntu@sha256:{A}\nFROM ubuntu@sha256:{B}\n")
        self.check()

    def test_conflict_names_first_location(self):
        self.dockerfile("Dockerfile", f"FROM ubuntu:24.04@sha256:{A}\nFROM ubuntu:24.04@sha256:{A}\nFROM ubuntu:24.04@sha256:{B}\n")
        self.check("first seen at Dockerfile:1")

    def test_buildkit_continuation_grammar(self):
        for suffix in ("\\\u00a0", "\\\f", "\\\\"):
            with self.subTest(suffix=repr(suffix)):
                self.dockerfile("Dockerfile", f"FROM ubuntu:24.04@sha256:{A} AS base\nRUN echo hello {suffix}\nFROM unpinned\n")
                self.check("FROM must be pinned")
        self.dockerfile("Dockerfile", f"FROM \\ \t\r\n ubuntu:24.04@sha256:{A}\r\n")
        self.check()

    def test_heredoc_payload_is_not_an_instruction(self):
        for instruction in ("RUN", "COPY", "ADD", "ONBUILD RUN"):
            for marker in ("EOF", "'EOF'", '"EOF"', 'E"O"F', r"E\OF"):
                with self.subTest(instruction=instruction, marker=marker):
                    destination = " /payload" if instruction in ("COPY", "ADD") else ""
                    self.dockerfile("Dockerfile", "FROM scratch\n"
                                    f"{instruction} <<{marker}{destination}\n"
                                    "FROM unpinned\n# escape=`\nFR0M payload\\\n\nEOF\n")
                    self.check()

    def test_multiple_heredocs_tabs_crlf_and_later_from_location(self):
        self.dockerfile("Dockerfile", "FROM scratch\r\nRUN cat 3<<'FIRST' <<-SECOND\r\n"
                        "FROM payload-one\r\nFIRST\r\n\tFROM payload-two\r\n\tSECOND\r\n"
                        "FROM unpinned\r\n")
        self.check("Dockerfile:7: FROM must be pinned")

    def test_heredoc_continuation_and_empty_body(self):
        self.dockerfile("Dockerfile", "FROM scratch\nRUN <<E\\\nOF\nEOF\n"
                        "COPY \\\n <<-END /payload\n\tFROM payload\n\tEND\n")
        self.check()

    def test_payload_stage_alias_cannot_exempt_a_real_from(self):
        self.dockerfile("Dockerfile", "FROM scratch\nRUN <<EOF\n"
                        "FROM scratch AS imaginary\nEOF\nFROM imaginary\n")
        self.check("Dockerfile:5: FROM must be pinned")

    def test_heredoc_terminators_are_exact(self):
        for near_miss in (" EOF", "EOF ", "\tEOF", "EOF\\", "# EOF"):
            with self.subTest(near_miss=repr(near_miss)):
                self.dockerfile("Dockerfile", "FROM scratch\nRUN <<EOF\n"
                                f"{near_miss}\nFROM payload\nEOF\nFROM unpinned\n")
                self.check("Dockerfile:6: FROM must be pinned")

    def test_unterminated_heredoc_fails_at_opener(self):
        for opener in ("RUN <<EOF", "COPY <<'EOF' /payload", "RUN <<A <<B"):
            with self.subTest(opener=opener):
                self.dockerfile("Dockerfile", f"FROM scratch\n{opener}\nFROM payload\nA\n")
                self.check("Dockerfile:2: unterminated heredoc")

    def test_quoted_json_and_ineligible_heredoc_text_cannot_hide_from(self):
        for line in ('RUN echo "<<EOF"', r"RUN echo \<<EOF", 'RUN ["echo", "<<EOF"]',
                     'COPY ["<<EOF", "/payload"]', "ENV TEXT=<<EOF", "RUN cat<<EOF"):
            with self.subTest(line=line):
                self.dockerfile("Dockerfile", f"FROM scratch\n{line}\nFROM unpinned\n")
                self.check("Dockerfile:3: FROM must be pinned")

    def test_malformed_or_unsupported_heredoc_fails_safely(self):
        for line in ("RUN <<'EOF", "RUN <<", "RUN <<<EOF", "RUN <<${END:-EOF}",
                     "RUN echo ${X:- <<EOF}", "ONBUILD onbuild RUN <<EOF"):
            with self.subTest(line=line):
                self.dockerfile("Dockerfile", f"FROM scratch\n{line}\nFROM unpinned\nEOF\n")
                self.check("Dockerfile:2:")

    def test_continuation_retains_first_physical_source_line(self):
        self.dockerfile("Dockerfile", "FROM scratch\n\\\nRUN <<EOF\nFROM payload\n")
        self.check("Dockerfile:2: unterminated heredoc")
        self.dockerfile("Dockerfile", "FROM scratch\n\\\n")
        self.check("Dockerfile:2: unfinished continuation")

    def test_independent_buildkit_parser_fixtures(self):
        parse = runpy.run_path(str(CHECK))["logical_lines"]
        cases = json.loads((ROOT / "tests/fixtures/ci-base-images-buildkit/cases.json").read_text())
        for case in cases:
            with self.subTest(case=case["name"]):
                self.dockerfile("Dockerfile", case["dockerfile"])
                if case["instructions"] is None:
                    with self.assertRaisesRegex(ValueError, "unterminated heredoc"):
                        list(parse(self.root / "Dockerfile"))
                else:
                    actual = [[number, line.split()[0].upper()]
                              for number, line in parse(self.root / "Dockerfile")]
                    self.assertEqual(actual, case["instructions"])

    def test_runtime_deps_major_upgrade_is_ignored(self):
        config = (ROOT / ".github/dependabot.yml").read_text()
        self.assertRegex(config, r'dependency-name: "dotnet/runtime-deps"\n        update-types:\n          - "version-update:semver-major"')

    def test_real_repository_and_dependabot_coverage(self):
        result = subprocess.run([CHECK], capture_output=True, text=True)
        self.assertEqual(result.returncode, 0, result.stderr)
        dockerfiles = runpy.run_path(str(CHECK))["discover_dockerfiles"](ROOT)
        config = (ROOT / ".github/dependabot.yml").read_text()
        docker = config.split('  - package-ecosystem: "docker"\n', 1)[1].split('  - package-ecosystem:', 1)[0]
        directories = set(re.findall(r'^      - "(/[^"*]*)"$', docker, re.M))
        for path in dockerfiles:
            parent = str(pathlib.PurePosixPath(path).parent)
            directory = "/" if parent == "." else "/" + parent
            self.assertIn(directory, directories, f"Dependabot does not cover {path}")
        self.assertTrue(dockerfiles)


    def test_F1_bom_unpinned_first_from(self):
        self.dockerfile("Dockerfile", f"\ufeffFROM alpine:3.22 AS first\nFROM ubuntu:24.04@sha256:{A}\n")
        self.check("FROM must be pinned")

    def test_F1_bom_escape_directive(self):
        self.dockerfile("Dockerfile", f"\ufeff# escape=`\nRUN echo hello \\\nFROM alpine:3.22\nFROM ubuntu:24.04@sha256:{A}\n")
        self.check("unsupported Dockerfile escape directive")

    def test_F1_unknown_instruction(self):
        self.dockerfile("Dockerfile", f"FROM ubuntu:24.04@sha256:{A}\nFR0M alpine:3.22\n")
        self.check("unknown Dockerfile instruction")

    def test_F3_discovery_variants(self):
        for name in ("dockerfile", "Containerfile", "build.dockerfile", "containerfile.test", "build.CONTAINERFILE"):
            with self.subTest(name=name):
                self.dockerfile(name + "/" + name, "FROM ubuntu:24.04\n")
                self.check("FROM must be pinned")
                self.dockerfile(name + "/" + name, f"FROM ubuntu:24.04@sha256:{A}\n")

    def test_F3_shared_discovery(self):
        discover = runpy.run_path(str(CHECK))["discover_dockerfiles"]
        expected = ["a/dockerfile", "b/Containerfile", "c/build.dockerfile"]
        for name in expected:
            self.dockerfile(name, f"FROM ubuntu:24.04@sha256:{A}\n")
        self.dockerfile("Dockerfile.dockerignore", "not a Dockerfile\n")
        self.assertEqual(discover(self.root), expected)


if __name__ == "__main__":
    unittest.main(verbosity=2)
