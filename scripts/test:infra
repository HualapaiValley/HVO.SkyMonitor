grep -Fqx $'phase\trecovery-removing-displaced' "$TEMP_DIR/.hvo-application-state-restore.transaction"
test ! -e "$recovery_displaced"

expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" after-recovery-displaced-removal
grep -Fqx $'phase\trecovery-displaced-removed' "$TEMP_DIR/.hvo-application-state-restore.transaction"
test ! -e "$recovery_displaced"

expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" before-recovery-staging-removal
grep -Fqx $'phase\trecovery-removing-staging' "$TEMP_DIR/.hvo-application-state-restore.transaction"
test -d "$recovery_staging"
test -f "$recovery_staging.transaction"

expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" after-recovery-staging-tree-removal
grep -Fqx $'phase\trecovery-removing-staging' "$TEMP_DIR/.hvo-application-state-restore.transaction"
test ! -e "$recovery_staging"
test -f "$recovery_staging.transaction"

expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" after-recovery-staging-control-removal
grep -Fqx $'phase\trecovery-removing-staging' "$TEMP_DIR/.hvo-application-state-restore.transaction"
test ! -e "$recovery_staging"
test ! -e "$recovery_staging.transaction"

expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" after-recovery-staging-removal-before-journal
grep -Fqx $'phase\trecovery-removing-staging' "$TEMP_DIR/.hvo-application-state-restore.transaction"
test ! -e "$recovery_staging"
test ! -e "$recovery_staging.transaction"

expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" after-recovery-staging-removal
grep -Fqx $'phase\trecovery-staging-removed' "$TEMP_DIR/.hvo-application-state-restore.transaction"

expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" before-recovery-marker-removal
