test ! -e "$TEMP_DIR/.hvo-restore-displaced.$no_old_transaction"
test ! -e "$TEMP_DIR/.hvo-application-state-restore.transaction"
mv -T "$TEMP_DIR/saved-runtime-before-no-old-recovery" "$RUNTIME_ROOT"

# Abandoned staging cleanup remains authenticated and resumable independently of a restore marker.
