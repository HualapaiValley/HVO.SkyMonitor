test ! -e "$TEMP_DIR/.hvo-application-state-restore.transaction"
test ! -e "$TEMP_DIR/.hvo-restore.$committed_transaction"
test ! -e "$TEMP_DIR/.hvo-restore.$committed_transaction.transaction"
test "$(<"$RUNTIME_ROOT/agent/frame.bin")" = payload-v1
