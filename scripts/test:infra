    fail 'Recovery marker removal did not retain the exact old tree.'

restore_archive "$VALID_ARCHIVE" env HVO_SKIP_RUNTIME_HEALTHCHECK=true HVO_ENABLE_TEST_FAILPOINTS=true \
    HVO_RESTORE_TEST_TRANSACTION_ID="$recovery_transaction" >/dev/null
test "$(<"$RUNTIME_ROOT/agent/frame.bin")" = payload-v1
rm -rf -- "$recovery_rollback"

# Authenticated staging cleanup accepts preserved target-only filesystem content.
preserved_staging_transaction=77777777777777777777777777777778
mkdir -m 0777 "$RUNTIME_ROOT/writable-preserved"
