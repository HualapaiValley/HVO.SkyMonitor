tar -xzf "$VALID_ARCHIVE" -C "$TEMP_DIR/mutations/owner"
foreign_gid="$(( $(id -g) + 1 ))"
FOREIGN_GID="$foreign_gid" perl -pi -e \
    'if ($. == 2) { s/^(D|F)\t([^\t]+)\t([0-9]+)\t[0-9]+\t/$1\t$2\t$3\t$ENV{FOREIGN_GID}\t/ }' \
    "$TEMP_DIR/mutations/owner/.hvo-application-state-inventory"
