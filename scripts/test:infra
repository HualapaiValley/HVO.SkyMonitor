#!/usr/bin/env bash
# Exercise infrastructure script selection without invoking Docker.

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly TEMP_DIR="$(mktemp -d -t hvo-infra-test.XXXXXX)"

cleanup() {
    rm -rf "$TEMP_DIR"
}
trap cleanup EXIT

bash -n "$REPO_ROOT/scripts/run:cameraagent-soak"

cat > "$TEMP_DIR/docker" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "${DOCKER_LOG:?}"
EOF
chmod +x "$TEMP_DIR/docker"

run_case() {
    : > "$TEMP_DIR/docker.log"
    PATH="$TEMP_DIR:$PATH" DOCKER_LOG="$TEMP_DIR/docker.log" "$REPO_ROOT/scripts/infra:start" "$@" >/dev/null
}

run_case --reset cameraagent
grep -Fqx 'compose -f docker-compose.apps.yml rm -sf cameraagent' "$TEMP_DIR/docker.log"
grep -Fqx 'compose -f docker-compose.apps.yml build cameraagent' "$TEMP_DIR/docker.log"
grep -Fqx 'compose -f docker-compose.apps.yml up -d cameraagent' "$TEMP_DIR/docker.log"
if grep -q logichost "$TEMP_DIR/docker.log"; then
    echo "A CameraAgent-only reset unexpectedly selected LogicHost." >&2
    exit 1
fi

run_case --rebuild logichost
grep -Fqx 'compose -f docker-compose.apps.yml build logichost' "$TEMP_DIR/docker.log"
grep -Fqx 'compose -f docker-compose.apps.yml up -d logichost' "$TEMP_DIR/docker.log"
if grep -q cameraagent "$TEMP_DIR/docker.log"; then
    echo "A LogicHost-only rebuild unexpectedly selected CameraAgent." >&2
    exit 1
fi

run_case --reset
grep -Fqx 'compose -f docker-compose.apps.yml build logichost cameraagent' "$TEMP_DIR/docker.log"
grep -Fqx 'compose -f docker-compose.apps.yml up -d logichost cameraagent' "$TEMP_DIR/docker.log"

echo "Infrastructure command contract passed."
