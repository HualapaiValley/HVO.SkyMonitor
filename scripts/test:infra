expect_restore_rejected_before_mutation "$TEMP_DIR/wrong-inventory-group.tgz" 'Wrong inventory group'

perl -pi -e 'if ($. == 2) { chomp; my @field = split(/\t/, $_, -1); $field[4] = "0755"; $_ = join("\t", @field) . "\n"; }' \
    "$TEMP_DIR/mutations/mode/.hvo-application-state-inventory"
repack_inventory_archive "$TEMP_DIR/mutations/mode" "$TEMP_DIR/invalid-mode.tgz"
expect_restore_rejected_before_mutation "$TEMP_DIR/invalid-mode.tgz" 'Invalid inventory mode'

tar --create --gzip --format=gnu --owner="$foreign_uid" --group="$(id -g)" \
    --file "$TEMP_DIR/wrong-header-owner.tgz" --directory "$TEMP_DIR/mutations/corrupt" \
    "${SUPPORTED_PATHS[@]}" .hvo-application-state-inventory
write_checksum "$TEMP_DIR/wrong-header-owner.tgz"
expect_restore_rejected_before_mutation "$TEMP_DIR/wrong-header-owner.tgz" 'Wrong archive ownership'
tar --create --gzip --format=gnu --owner="$(id -u)" --group="$foreign_gid" \
    --file "$TEMP_DIR/wrong-header-group.tgz" --directory "$TEMP_DIR/mutations/corrupt" \
    "${SUPPORTED_PATHS[@]}" .hvo-application-state-inventory
write_checksum "$TEMP_DIR/wrong-header-group.tgz"
expect_restore_rejected_before_mutation "$TEMP_DIR/wrong-header-group.tgz" 'Wrong archive group'

cp "$VALID_ARCHIVE" "$TEMP_DIR/duplicate-source.tgz"
gunzip "$TEMP_DIR/duplicate-source.tgz"
tar --append --file "$TEMP_DIR/duplicate-source.tar" --directory "$TEMP_DIR/mutations/corrupt" cameraagent/identity/identity.db
gzip "$TEMP_DIR/duplicate-source.tar"
mv "$TEMP_DIR/duplicate-source.tar.gz" "$TEMP_DIR/duplicate.tgz"
write_checksum "$TEMP_DIR/duplicate.tgz"
expect_restore_rejected_before_mutation "$TEMP_DIR/duplicate.tgz" 'Duplicate path'

cp "$VALID_ARCHIVE" "$TEMP_DIR/unsafe-source.tgz"
gunzip "$TEMP_DIR/unsafe-source.tgz"
printf 'unsafe\n' > "$TEMP_DIR/mutations/unsafe-entry"
tar --append --file "$TEMP_DIR/unsafe-source.tar" --directory "$TEMP_DIR/mutations" \
    --transform='s|^unsafe-entry$|../private-payload|' unsafe-entry
gzip "$TEMP_DIR/unsafe-source.tar"
mv "$TEMP_DIR/unsafe-source.tar.gz" "$TEMP_DIR/unsafe.tgz"
write_checksum "$TEMP_DIR/unsafe.tgz"
expect_restore_rejected_before_mutation "$TEMP_DIR/unsafe.tgz" 'Unsafe path'
if grep -Fq 'private-payload' "$TEMP_DIR/rejection.log"; then
    fail 'Archive rejection diagnostics exposed a payload path.'
fi

append_transformed_entry "$TEMP_DIR/repeated-slash.tgz" 'agent//alias-entry'
expect_restore_rejected_before_mutation "$TEMP_DIR/repeated-slash.tgz" 'Repeated-slash alias'
append_transformed_entry "$TEMP_DIR/dot-alias.tgz" 'agent/./alias-entry'
expect_restore_rejected_before_mutation "$TEMP_DIR/dot-alias.tgz" 'Dot-component alias'
append_transformed_entry "$TEMP_DIR/absolute.tgz" '/absolute-private-payload'
expect_restore_rejected_before_mutation "$TEMP_DIR/absolute.tgz" 'Absolute path'
tar --create --gzip --format=gnu --file "$TEMP_DIR/leading-dot.tgz" \
    --directory "$TEMP_DIR/mutations/corrupt" .
write_checksum "$TEMP_DIR/leading-dot.tgz"
expect_restore_rejected_before_mutation "$TEMP_DIR/leading-dot.tgz" 'Leading-dot alias'

tar --format=pax --create --gzip --file "$TEMP_DIR/pax.tgz" \
    --directory "$TEMP_DIR/mutations/corrupt" "${SUPPORTED_PATHS[@]}" .hvo-application-state-inventory
write_checksum "$TEMP_DIR/pax.tgz"
expect_restore_rejected_before_mutation "$TEMP_DIR/pax.tgz" 'PAX extension'

mkdir -p "$TEMP_DIR/special"
for path in "${SUPPORTED_PATHS[@]}"; do mkdir -p "$TEMP_DIR/special/$path"; done
mkfifo "$TEMP_DIR/special/agent/unsafe-fifo"
tar -czf "$TEMP_DIR/special.tgz" -C "$TEMP_DIR/special" "${SUPPORTED_PATHS[@]}"
write_checksum "$TEMP_DIR/special.tgz"
expect_restore_rejected_before_mutation "$TEMP_DIR/special.tgz" 'Special entry'
rm "$TEMP_DIR/special/agent/unsafe-fifo"
printf 'link-target\n' > "$TEMP_DIR/special/agent/link-target"
ln -s link-target "$TEMP_DIR/special/agent/unsafe-symlink"
tar -czf "$TEMP_DIR/symlink.tgz" -C "$TEMP_DIR/special" "${SUPPORTED_PATHS[@]}"
write_checksum "$TEMP_DIR/symlink.tgz"
expect_restore_rejected_before_mutation "$TEMP_DIR/symlink.tgz" 'Symbolic-link entry'
rm "$TEMP_DIR/special/agent/unsafe-symlink"
ln "$TEMP_DIR/special/agent/link-target" "$TEMP_DIR/special/agent/unsafe-hardlink"
tar -czf "$TEMP_DIR/hardlink.tgz" -C "$TEMP_DIR/special" "${SUPPORTED_PATHS[@]}"
write_checksum "$TEMP_DIR/hardlink.tgz"
expect_restore_rejected_before_mutation "$TEMP_DIR/hardlink.tgz" 'Hard-link entry'
rm "$TEMP_DIR/special/agent/unsafe-hardlink"
control_name=$'control\nprivate-name'
printf 'control\n' > "$TEMP_DIR/special/agent/$control_name"
tar -czf "$TEMP_DIR/control-path.tgz" -C "$TEMP_DIR/special" "${SUPPORTED_PATHS[@]}"
write_checksum "$TEMP_DIR/control-path.tgz"
expect_restore_rejected_before_mutation "$TEMP_DIR/control-path.tgz" 'Control-character path'
if grep -Fq 'private-name' "$TEMP_DIR/rejection.log"; then
    fail 'Control-path rejection diagnostics exposed a payload path.'
fi

# Replacing the selected archive after its private copy cannot change validated restore input.
cp "$VALID_ARCHIVE" "$TEMP_DIR/replaced-source.tgz"
write_checksum "$TEMP_DIR/replaced-source.tgz"
restore_archive "$TEMP_DIR/replaced-source.tgz" env HVO_SKIP_RUNTIME_HEALTHCHECK=true \
    HVO_TEST_REPLACE_ARCHIVE_SOURCE="$TEMP_DIR/replaced-source.tgz" \
    HVO_TEST_REPLACE_ARCHIVE_ONCE="$TEMP_DIR/replaced-source.once" >/dev/null
test -f "$TEMP_DIR/replaced-source.once"
test "$(<"$RUNTIME_ROOT/agent/frame.bin")" = payload-v1

# Restore the valid inventory archive and verify exact supported state plus target-only state.
printf 'catalog-target-preserved\n' > "$RUNTIME_ROOT/catalog/versions/installed/manifest.json"
printf 'target-only-preserved\n' > "$RUNTIME_ROOT/unmanaged.sentinel"
rm -rf "$RUNTIME_ROOT/agent" "$RUNTIME_ROOT/archive"
mkdir -p "$RUNTIME_ROOT/agent" "$RUNTIME_ROOT/archive"
printf 'replacement\n' > "$RUNTIME_ROOT/agent/frame.bin"
: > "$TEMP_DIR/docker.log"
: > "$TEMP_DIR/curl.log"
: > "$TEMP_DIR/lifecycle.log"
restore_archive "$VALID_ARCHIVE" env >/dev/null
grep -Fq 'http://localhost:5174/health' "$TEMP_DIR/curl.log"
grep -Fq 'http://localhost:5130/health' "$TEMP_DIR/curl.log"
if grep -Fq '/alive' "$TEMP_DIR/curl.log"; then fail 'Restore probed /alive instead of readiness.'; fi
logic_start_line="$(grep -nF 'compose -f docker-compose.apps.yml up -d logichost' "$TEMP_DIR/docker.log" | cut -d: -f1)"
camera_start_line="$(grep -nF 'compose -f docker-compose.apps.yml up -d cameraagent' "$TEMP_DIR/docker.log" | cut -d: -f1)"
(( logic_start_line < camera_start_line )) || fail 'CameraAgent started before LogicHost readiness.'
logic_start_line="$(grep -nF 'docker compose -f docker-compose.apps.yml up -d logichost' "$TEMP_DIR/lifecycle.log" | cut -d: -f1)"
logic_health_line="$(grep -nF 'curl --silent --show-error --fail --output /dev/null http://localhost:5174/health' "$TEMP_DIR/lifecycle.log" | cut -d: -f1)"
camera_start_line="$(grep -nF 'docker compose -f docker-compose.apps.yml up -d cameraagent' "$TEMP_DIR/lifecycle.log" | cut -d: -f1)"
camera_health_line="$(grep -nF 'curl --silent --show-error --fail --output /dev/null http://localhost:5130/health' "$TEMP_DIR/lifecycle.log" | cut -d: -f1)"
(( logic_start_line < logic_health_line && logic_health_line < camera_start_line && camera_start_line < camera_health_line )) || \
    fail 'Restore startup did not enforce LogicHost then CameraAgent readiness ordering.'
test "$(<"$RUNTIME_ROOT/catalog/versions/installed/manifest.json")" = catalog-target-preserved
test "$(<"$RUNTIME_ROOT/unmanaged.sentinel")" = target-only-preserved
test "$(stat -c '%a' "$RUNTIME_ROOT/cameraagent/identity/identity.db")" = 600
test "$(<"$RUNTIME_ROOT/agent/outbox/pending.json")" = pending-v1
test "$(<"$RUNTIME_ROOT/agent/quarantine/bad.json")" = quarantine-v1
test "$(<"$RUNTIME_ROOT/agent/valid-nested/deeper/payload.bin")" = nested-roundtrip-v1
test "$(stat -c '%a' "$RUNTIME_ROOT/agent/valid-nested")" = 711
test "$(stat -c '%a' "$RUNTIME_ROOT/agent/valid-nested/deeper")" = 711
test -f "$TEMP_DIR/shared-volume/database.sentinel"
snapshot_tree "$RUNTIME_ROOT" "$TEMP_DIR/after-roundtrip.snapshot" "${SUPPORTED_PATHS[@]}"
if ! cmp -s "$TEMP_DIR/before-backup.snapshot" "$TEMP_DIR/after-roundtrip.snapshot"; then
    diff -u "$TEMP_DIR/before-backup.snapshot" "$TEMP_DIR/after-roundtrip.snapshot" >&2 || true
    fail 'Supported application state did not round-trip exactly.'
fi

# Every durable restore boundary recovers exact old state after an uncatchable interruption.
interruption_index=0
for interruption in after-old-move after-new-install after-logichost-start after-cameraagent-start; do
    ((interruption_index += 1))
    transaction="8888888888884888888888888888888$interruption_index"
    rollback="$RUNTIME_ROOT.rollback.$transaction"
    printf 'pre-%s\n' "$interruption" > "$RUNTIME_ROOT/agent/frame.bin"
    snapshot_tree "$RUNTIME_ROOT" "$TEMP_DIR/pre-$interruption.snapshot"
    : > "$TEMP_DIR/docker.log"
    expect_restore_sigkill "$VALID_ARCHIVE" "$transaction" "$interruption" || \
        fail "$interruption interruption did not terminate with SIGKILL."
    test -f "$TEMP_DIR/.hvo-application-state-restore.transaction"
    case "$interruption" in
        after-old-move) expected_phase=old-moved; test ! -e "$RUNTIME_ROOT" ;;
        after-new-install) expected_phase=new-installed; test -d "$RUNTIME_ROOT" ;;
        after-logichost-start) expected_phase=logichost-started; grep -Fq 'up -d logichost' "$TEMP_DIR/docker.log" ;;
        after-cameraagent-start) expected_phase=cameraagent-started; grep -Fq 'up -d cameraagent' "$TEMP_DIR/docker.log" ;;
    esac
    grep -Fqx $'phase\t'"$expected_phase" "$TEMP_DIR/.hvo-application-state-restore.transaction"
    snapshot_tree "$rollback" "$TEMP_DIR/rollback-$interruption.snapshot"
    cmp -s "$TEMP_DIR/pre-$interruption.snapshot" "$TEMP_DIR/rollback-$interruption.snapshot" || \
        fail "$interruption did not retain exact rollback state."
    restore_archive "$VALID_ARCHIVE" env HVO_SKIP_RUNTIME_HEALTHCHECK=true HVO_ENABLE_TEST_FAILPOINTS=true \
        HVO_RESTORE_TEST_TRANSACTION_ID="$transaction" >/dev/null
    test ! -e "$TEMP_DIR/.hvo-application-state-restore.transaction"
    snapshot_tree "$rollback" "$TEMP_DIR/retry-rollback-$interruption.snapshot"
    cmp -s "$TEMP_DIR/pre-$interruption.snapshot" "$TEMP_DIR/retry-rollback-$interruption.snapshot" || \
        fail "$interruption retry did not recover exact old state before installation."
    test "$(<"$RUNTIME_ROOT/agent/frame.bin")" = payload-v1
    rm -rf -- "$rollback"
done

# Recovery is itself journaled, and every destructive boundary resumes without losing either tree.
recovery_transaction=77777777777777777777777777777777
recovery_rollback="$RUNTIME_ROOT.rollback.$recovery_transaction"
recovery_displaced="$TEMP_DIR/.hvo-restore-displaced.$recovery_transaction"
recovery_staging="$TEMP_DIR/.hvo-restore.$recovery_transaction"
printf 'pre-recovery-journal\n' > "$RUNTIME_ROOT/agent/frame.bin"
ln -s unmanaged.sentinel "$RUNTIME_ROOT/preserved-link"
snapshot_tree "$RUNTIME_ROOT" "$TEMP_DIR/pre-recovery-journal.snapshot"
expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" after-new-install || \
    fail 'Recovery journal setup did not terminate with SIGKILL.'
test -d "$RUNTIME_ROOT"
test -d "$recovery_rollback"
test -d "$recovery_staging"
test -f "$recovery_staging.transaction"

expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" before-recovery-displacement
grep -Fqx $'phase\trecovery-displacing' "$TEMP_DIR/.hvo-application-state-restore.transaction"
test -d "$RUNTIME_ROOT"
test ! -e "$recovery_displaced"

expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" after-recovery-displacement-before-journal
grep -Fqx $'phase\trecovery-displacing' "$TEMP_DIR/.hvo-application-state-restore.transaction"
test ! -e "$RUNTIME_ROOT"
test -d "$recovery_displaced"

expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" after-recovery-displacement
grep -Fqx $'phase\trecovery-displaced' "$TEMP_DIR/.hvo-application-state-restore.transaction"
test ! -e "$RUNTIME_ROOT"
test -d "$recovery_rollback"
test -d "$recovery_displaced"

expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" before-recovery-restoration
grep -Fqx $'phase\trecovery-restoring' "$TEMP_DIR/.hvo-application-state-restore.transaction"
test ! -e "$RUNTIME_ROOT"
test -d "$recovery_rollback"

expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" after-recovery-restoration-before-journal
grep -Fqx $'phase\trecovery-restoring' "$TEMP_DIR/.hvo-application-state-restore.transaction"
test -d "$RUNTIME_ROOT"
test ! -e "$recovery_rollback"
test -d "$recovery_displaced"

expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" after-recovery-restoration
grep -Fqx $'phase\trecovery-restored' "$TEMP_DIR/.hvo-application-state-restore.transaction"
test -d "$RUNTIME_ROOT"
test ! -e "$recovery_rollback"
test -d "$recovery_displaced"
snapshot_tree "$RUNTIME_ROOT" "$TEMP_DIR/restored-recovery-journal.snapshot"
cmp -s "$TEMP_DIR/pre-recovery-journal.snapshot" "$TEMP_DIR/restored-recovery-journal.snapshot" || \
    fail 'Journaled recovery did not restore the exact old tree.'

expect_restore_sigkill "$VALID_ARCHIVE" "$recovery_transaction" before-recovery-displaced-removal
grep -Fqx $'phase\trecovery-removing-displaced' "$TEMP_DIR/.hvo-application-state-restore.transaction"
test -d "$recovery_displaced"

