foreign_uid="$(( $(id -u) + 1 ))"
FOREIGN_UID="$foreign_uid" perl -pi -e \
    'if ($. == 2) { s/^(D|F)\t([^\t]+)\t[0-9]+\t/$1\t$2\t$ENV{FOREIGN_UID}\t/ }' \
    "$TEMP_DIR/mutations/owner/.hvo-application-state-inventory"
