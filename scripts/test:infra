    HVO_TEST_NONGROUP_PATH="$RUNTIME_ROOT/agent/frame.json" \
    "$REPO_ROOT/scripts/infra:backup-app-state" "$TEMP_DIR/nonowned-backup" >/dev/null 2>&1; then
    fail 'Backup accepted an application-state entry owned by another group.'
