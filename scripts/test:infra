cmp -s "$TEMP_DIR/pre-committed-marker-removal.snapshot" "$TEMP_DIR/committed-marker-rollback.snapshot" || \
    fail 'Post-commit marker interruption changed retained rollback state.'
rm -rf -- "$RUNTIME_ROOT.rollback.$committed_transaction"

