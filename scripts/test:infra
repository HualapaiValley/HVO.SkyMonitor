test ! -e "$TEMP_DIR/.hvo-restore.$preserved_staging_transaction.transaction"

# Commit-side staging cleanup is also resumable; marker removal remains the commit point.
commit_index=0
for commit_interruption in before-commit-staging-removal after-commit-staging-tree-removal \
    after-commit-staging-control-removal after-commit-staging-removal-before-journal \
    after-commit-staging-removal before-commit-marker-removal; do
    ((commit_index += 1))
    commit_transaction="$(printf '3%.0s' {1..31})$commit_index"
    printf 'pre-%s\n' "$commit_interruption" > "$RUNTIME_ROOT/agent/frame.bin"
    snapshot_tree "$RUNTIME_ROOT" "$TEMP_DIR/pre-$commit_interruption.snapshot"
    expect_restore_sigkill "$VALID_ARCHIVE" "$commit_transaction" "$commit_interruption"
    test -f "$TEMP_DIR/.hvo-application-state-restore.transaction"
    expect_restore_rejected "$TEMP_DIR/outer-corrupt.tgz" "Post-$commit_interruption recovery"
    snapshot_tree "$RUNTIME_ROOT" "$TEMP_DIR/post-$commit_interruption.snapshot"
    cmp -s "$TEMP_DIR/pre-$commit_interruption.snapshot" "$TEMP_DIR/post-$commit_interruption.snapshot" || \
        fail "$commit_interruption did not recover the exact old tree."
    test ! -e "$TEMP_DIR/.hvo-application-state-restore.transaction"
    test ! -e "$TEMP_DIR/.hvo-restore.$commit_transaction"
    test ! -e "$TEMP_DIR/.hvo-restore.$commit_transaction.transaction"
    test ! -e "$RUNTIME_ROOT.rollback.$commit_transaction"
done

committed_transaction=22222222222222222222222222222221
printf 'pre-committed-marker-removal\n' > "$RUNTIME_ROOT/agent/frame.bin"
