#!/usr/bin/env bash
set -uo pipefail

event_name="${1:-}"
base_sha="${2:-}"
head_sha="${3:-}"
summary_file="${GITHUB_STEP_SUMMARY:-}"

mode="full"
reason="non-pull-request events always run the full matrix"
deployment="true"
deployment_reason="non-pull-request events always run deployment contracts"
deployment_catalog="true"
deployment_shards="true"
deployment_installer="true"
complete="true"
complete_reason="non-pull-request events always run the complete solution matrix"
shared="true"
cameraagent="true"
logichost="true"
combined="true"
delivery="true"
secret_scan_contract="true"
release_scripts="true"
catalog_recipe="true"
path_count=0
docs_fast_path="false"
docs_fast_path_reason="non-pull-request events require full validation"

write_summary_header() {
  [[ -n "$summary_file" ]] || return 0
  printf '### CI change classification\n\nObserved paths:\n' >> "$summary_file"
}

write_summary_path() {
  [[ -n "$summary_file" ]] || return 0
  printf -- '- %q %q\n' "$1" "$2" >> "$summary_file"
}

finish() {
  if [[ -n "$summary_file" ]]; then
    printf '\nMode: **%s**  \nMode reason: %s  \nDeployment contracts: **%s**  \nDeployment reason: %s  \nExhaustive catalog: **%s**  \nExhaustive shards: **%s**  \nExhaustive installer: **%s**  \nComplete matrix: **%s**  \nComplete reason: %s  \nShared libraries: **%s**  \nCameraAgent: **%s**  \nLogicHost: **%s**  \nCombined: **%s**  \nDelivery: **%s**  \nSecret scan contract: **%s**  \nRelease scripts: **%s**  \nCatalog recipe: **%s**  \nPath count: %s\n' \
      "$mode" "$reason" "$deployment" "$deployment_reason" "$deployment_catalog" \
      "$deployment_shards" "$deployment_installer" "$complete" "$complete_reason" \
      "$shared" "$cameraagent" "$logichost" "$combined" "$delivery" "$secret_scan_contract" "$release_scripts" \
      "$catalog_recipe" "$path_count" >> "$summary_file"
  fi

  printf 'Docs fast path: %s; reason: %s\n' "$docs_fast_path" "$docs_fast_path_reason" >&2
  [[ -z "$summary_file" ]] || printf '\nDocs fast path: **%s**  \nDocs fast path reason: %s\n' "$docs_fast_path" "$docs_fast_path_reason" >> "$summary_file"
  printf 'CI classification: mode=%s deployment=%s complete=%s shared=%s cameraagent=%s logichost=%s combined=%s delivery=%s secret_scan_contract=%s release_scripts=%s catalog_recipe=%s reason=%s deployment-reason=%s complete-reason=%s paths=%s\n' \
    "$mode" "$deployment" "$complete" "$shared" "$cameraagent" "$logichost" "$combined" \
    "$delivery" "$secret_scan_contract" "$release_scripts" "$catalog_recipe" "$reason" "$deployment_reason" \
    "$complete_reason" "$path_count" >&2
  printf 'mode=%s\ndeployment=%s\ndeployment_catalog=%s\ndeployment_shards=%s\ndeployment_installer=%s\ncomplete=%s\nshared=%s\ncameraagent=%s\nlogichost=%s\ncombined=%s\ndelivery=%s\nsecret_scan_contract=%s\nrelease_scripts=%s\ncatalog_recipe=%s\n' \
    "$mode" "$deployment" "$deployment_catalog" "$deployment_shards" "$deployment_installer" \
    "$complete" "$shared" "$cameraagent" "$logichost" "$combined" "$delivery" "$secret_scan_contract" \
    "$release_scripts" "$catalog_recipe"
  printf 'docs_fast_path=%s\ndocs_fast_path_reason=%s\n' "$docs_fast_path" "$docs_fast_path_reason"
}

is_secret_scan_contract_path() {
  # The gitleaks version and archive checksums are pinned in ci:secret-scan.
  case "$1" in
    scripts/ci:secret-scan | scripts/test:ci-secret-scan | .gitleaks.toml | *.gitleaksignore | *.gitattributes | \
      .github/workflows/development-v1.yml | .github/workflows/ci.yml | scripts/ci:classify)
      return 0
      ;;
  esac
  return 1
}

is_release_scripts_path() {
  # scripts/test:release-scripts proves the pre-release and release scripts with fake gh, skopeo and docker commands,
  # and the release workflow's shape, and runs scripts/test:install-sh, which proves the release's install.sh with fake
  # commands of its own. It runs when those scripts, the libraries they source (test:release-install's, the strict
  # GitHub reads and the newest-release rule), install.sh or its fakes, either release workflow, the product version
  # (Directory.Build.props) or the release tool change, or the Preflight wiring that runs it. Its CameraAgent tests
  # (scripts/test:cameraagent-r2r) also prove the bundled time-data update's rollback with fake curl and dotnet,
  # and scripts/test:cameraagent-image-reproducibility protects the image build scripts and Dockerfile.
  case "$1" in
    scripts/build:cameraagent-image | scripts/test:cameraagent-image-reproducibility | scripts/release:check-cameraagent-image | \
      scripts/test:cameraagent-arm64-ci | src/HVO.SkyMonitor.CameraAgent/Dockerfile | \
    scripts/release:cameraagent-publish | scripts/release:check-cameraagent-publish | scripts/cameraagent-release.targets | scripts/test:cameraagent-r2r | \
    scripts/time-data:update | scripts/release:assets | scripts/release:combine-images | scripts/release:check-image-labels | scripts/release:push-image | \
      scripts/release:prerelease-gate | scripts/release:prerelease-check | scripts/release:publish-prerelease | \
      scripts/release:version | scripts/release:notes | scripts/release:gate | scripts/release:check-environment | \
      scripts/release:publish | scripts/release:tag-latest | \
      scripts/test:release-images | scripts/test:release-install | scripts/test:release-scripts | scripts/lib/deployment-installer-qualification.sh | \
      scripts/lib/github-api.sh | scripts/lib/releases.sh | \
      src/HVO.SkyMonitor.Deployment.Cli/install.sh | scripts/test:install-sh | tests/fixtures/install-sh/* | \
      .github/workflows/release-image.yml | .github/workflows/prerelease.yml | .github/workflows/release.yml | Directory.Build.props | \
      tools/HVO.SkyMonitor.Deployment.ReleaseTool/* | .github/workflows/development-v1.yml | scripts/ci:classify)
      return 0
      ;;
  esac
  return 1
}

is_catalog_recipe_path() {
  # The Catalog Reproducibility job (Refs #1774) rebuilds the approved HYG 4.4 and OpenNGC bytes, and the committed catalog
  # test fixtures, under both SQLite connection defaults. It runs when a build recipe, a pin or a fixture changes,
  # which is everything under these two directories and nothing else: scripts/catalog:* (the operator entry points)
  # and the job's own wiring do not select it on a pull request. Non-pull-request events always run it.
  case "$1" in
    scripts/catalog/* | tests/fixtures/catalog/*)
      return 0
      ;;
  esac
  return 1
}

is_reduced_path() {
  local path="$1"

  if [[ "$path" =~ ^\.agents/skills/[^/]+/SKILL\.md$ ]]; then
    return 0
  fi

  case "$path" in
    docs/catalog/hyg-v42-attribution.md | docs/catalog/hyg-v42-license.md | docs/catalog/hyg-v44-attribution.md | docs/catalog/hyg-v44-license.md)
      return 1
      ;;
  esac

  case "$path" in
    docs/* | .devcontainer/* | .vscode/* | .github/prompts/*)
      return 0
      ;;
    README.md | AGENTS.md | CLAUDE.md | CHANGELOG.md | THIRD-PARTY-NOTICES.md)
      return 0
      ;;
    .github/copilot-instructions.md | .github/pull_request_template.md)
      return 0
      ;;
    tools/asi-capture/README.md)
      return 0
      ;;
    tests/fixtures/catalog/SOURCE.md | tests/fixtures/stellarium/SIMBAD_ENDPOINTS.md)
      return 0
      ;;
    scripts/test:devcontainer)
      return 0
      ;;
  esac

  [[ "$path" =~ ^(src|tests)/[^/]+/README\.md$ ]]
}

is_fast_doc_path() {
  case "$1" in
    docs/catalog/* | docs/contracts/* | docs/validation/* | docs/evidence/* | docs/*/evidence/* | docs/generated/* | docs/*/generated/* | docs/images/* | docs/upgrade-notes/* | docs/runbooks/development-v1-merge-queue-drill/*) return 1 ;;
    docs/*.md | docs/*.markdown | docs/*.txt | README.md | AGENTS.md | CLAUDE.md) return 0 ;;
  esac
  return 1
}

# Query committed project files directly; an unavailable tree or failed search is
# uncertainty, not evidence that the document has no consumers.
fast_doc_link_state() {
  local matches status line attr_re value file remaining
  # References to excluded contracts/validation are known and cannot select
  # this path; unknown document references and dynamic includes fail closed.
  if matches="$(git grep -i -E 'docs[/\\]|\.(md|markdown|txt)([^[:alnum:]]|$)|Include[[:space:]]*=[[:space:]]*["'"'"'][^"'"'"']*\$\(' "$head_sha" -- ':(glob)**/*.csproj' ':(glob)**/*.props' ':(glob)**/*.targets')"; then
    while IFS= read -r line; do
      case "$line" in
        *'$(MSBuildThisFileDirectory)TestSettings/ConnectionPoolClearContract.cs'*) continue ;;
        *THIRD-PARTY-NOTICES.md* | *Fonts/DejaVu-LICENSE.txt*)
          case "$line" in *docs/* | *docs\\* | *'*'* | *'$('* ) return 0 ;; esac
          continue ;;
        *docs/contracts/* | *docs/validation/* | *docs\\validation\\*)
          case "$line" in *docs/contracts/*'..'* | *docs/validation/*'..'* | *docs\\validation\\*'..'* | *'*'* | *'$('* ) return 0 ;; esac
          continue ;;
        *) return 0 ;;
      esac
    done <<< "$matches"
  else
    status=$?
    [[ "$status" -eq 1 ]] || return 2
  fi
  # A wildcard without the word docs can nevertheless include it. Only the
  # established fixture and source-local globs are proven confined here.
  if matches="$(git grep -i -E '(Include|Update|Remove)[[:space:]]*=[[:space:]]*["'"'"'][^"'"'"']*\*' "$head_sha" -- ':(glob)**/*.csproj' ':(glob)**/*.props' ':(glob)**/*.targets')"; then
    attr_re="(Include|Update|Remove)[[:space:]]*=[[:space:]]*[\"']([^\"']*\*[^\"']*)[\"']"
    while IFS= read -r line; do
      [[ "$line" =~ $attr_re ]] || return 0
      value="${BASH_REMATCH[2]//\\//}"
      remaining="${line#*"${BASH_REMATCH[0]}"}"
      [[ ! "$remaining" =~ $attr_re ]] || return 0
      file="${line#*:}"; file="${file%%:*}"
      case "$value" in *'$('* | *';'* | *'/../'* | *'/..' ) return 0 ;; esac
      case "$file:$value" in
        tests/*/*.csproj:../fixtures/* | tests/*/*.csproj:Fixtures/* | \
        src/HVO.SkyMonitor.Deployment.Cli/HVO.SkyMonitor.Deployment.Cli.csproj:SplitHost/*.jq | \
        src/HVO.SkyMonitor.LogicHost/HVO.SkyMonitor.LogicHost.csproj:Components/Account/*.cs | \
        src/HVO.SkyMonitor.CameraAgent.Common/HVO.SkyMonitor.CameraAgent.Common.csproj:OrbitalPlanning/TimeData/*) continue ;;
        *) return 0 ;;
      esac
    done <<< "$matches"
  else
    status=$?
    [[ "$status" -eq 1 ]] || return 2
  fi
  return 1
}

is_deployment_path() {
  local path="$1"

  case "$path" in
    .github/workflows/ci.yml | .github/workflows/release-image.yml | .github/workflows/release.yml | .github/workflows/prerelease.yml | .dockerignore | .env.template | docker-compose.apps.yml | global.json)
      return 0
      ;;
    scripts/ci:* | scripts/test:ci-classification | scripts/release:* | scripts/test:release-images | scripts/test:release-install | scripts/test:release-scripts | scripts/test:cameraagent-r2r | scripts/cameraagent-release.targets | scripts/lib/*)
      return 0
      ;;
    scripts/deploy:environment | scripts/deploy/*)
      return 0
      ;;
    scripts/qualify:filesystem-object-store | scripts/test:deploy-environment | scripts/test:deploy-environment-cli | scripts/test:deployment-installer | scripts/test:deployment-installer-qualification | scripts/test:deployment-logichost-outage-contract | scripts/test:deployment-normal-flow-contract | scripts/test:filesystem-object-store-qualification)
      return 0
      ;;
    scripts/deploy-contracts/*)
      return 0
      ;;
    scripts/catalog:* | scripts/catalog/* | scripts/infra:operation-lock)
      return 0
      ;;
    deploy/*)
      return 0
      ;;
    tests/fixtures/catalog/hyg-v42-bright-stars.sqlite)
      return 0
      ;;
    src/HVO.SkyMonitor.CameraAgent/Dockerfile | src/HVO.SkyMonitor.LogicHost/Dockerfile)
      return 0
      ;;
    src/HVO.SkyMonitor.Deployment.Cli/* | src/HVO.SkyMonitor.Deployment.Contracts/* | tests/HVO.SkyMonitor.Deployment.Cli.Tests/* | tests/HVO.SkyMonitor.Deployment.Distribution.Tests/* | tools/HVO.SkyMonitor.Deployment.ReleaseTool/*)
      return 0
      ;;
    src/HVO.SkyMonitor.TerminalUi/*)
      # Compiled into the installer, whose published file the installer suite runs on a terminal (#1317).
      return 0
      ;;
    src/HVO.SkyMonitor.CameraAgent/cameraagent.sample.json)
      return 0
      ;;
    src/HVO.SkyMonitor.CameraAgent/virtual-asi174.full.json | src/HVO.SkyMonitor.CameraAgent/virtual-asi178mc.full.json)
      return 0
      ;;
  esac

  return 1
}

select_deployment_suites() {
  local path="$1"

  case "$path" in
    .github/workflows/ci.yml | global.json | scripts/ci:* | scripts/test:ci-classification)
      deployment_catalog="true"
      deployment_shards="true"
      deployment_installer="true"
      ;;
    scripts/catalog/catalog-common.sh | tests/fixtures/catalog/hyg-v42-bright-stars.sqlite)
      deployment_catalog="true"
      deployment_shards="true"
      ;;
    scripts/catalog:* | scripts/catalog/*)
      deployment_catalog="true"
      deployment_shards="true"
      ;;
    scripts/infra:operation-lock)
      deployment_catalog="true"
      deployment_shards="true"
      ;;
    scripts/deploy/common.sh | scripts/deploy/product-layout.sh)
      deployment_shards="true"
      ;;
    scripts/lib/deploy-test-lifecycle.sh)
      # Every shard body calls the runners and staging in this library (#875), so a
      # change here can break all ten shards without touching a file that names them.
      # A case takes the first match, so the installer suite scripts/lib/* always
      # selected is set here explicitly rather than relied on from the later arm.
      deployment_shards="true"
      deployment_installer="true"
      ;;
    .github/workflows/release-image.yml | .github/workflows/release.yml | .github/workflows/prerelease.yml)
      deployment_catalog="true"
      deployment_installer="true"
      ;;
    src/HVO.SkyMonitor.Deployment.Cli/SplitHost/Preflight*.cs | src/HVO.SkyMonitor.Deployment.Cli/SplitHost/SplitHostPreflight.cs | src/HVO.SkyMonitor.Deployment.Contracts/Preflight*.cs | tests/HVO.SkyMonitor.Deployment.Cli.Tests/Preflight*Tests.cs | tests/HVO.SkyMonitor.Deployment.Cli.Tests/PreflightFixture.cs | tests/HVO.SkyMonitor.Deployment.Cli.Tests/PreflightFixtures.json)
      # The preflight shard now executes these typed validators and fake-target contracts (#1593).
      deployment_shards="true"
      deployment_installer="true"
      ;;
    scripts/test:deployment-installer | scripts/test:deployment-installer-qualification | scripts/release:* | scripts/test:release-images | scripts/test:release-install | scripts/test:release-scripts | scripts/test:cameraagent-r2r | scripts/cameraagent-release.targets | scripts/lib/* | src/HVO.SkyMonitor.Deployment.Cli/* | src/HVO.SkyMonitor.Deployment.Contracts/* | src/HVO.SkyMonitor.TerminalUi/* | tests/HVO.SkyMonitor.Deployment.Cli.Tests/* | tests/HVO.SkyMonitor.Deployment.Distribution.Tests/* | tools/HVO.SkyMonitor.Deployment.ReleaseTool/*)
      deployment_installer="true"
      ;;
    scripts/qualify:filesystem-object-store | scripts/test:filesystem-object-store-qualification)
      # The Deployment Contracts job always runs this lightweight preflight fixture.
      ;;
    .dockerignore | src/HVO.SkyMonitor.CameraAgent/Dockerfile | src/HVO.SkyMonitor.LogicHost/Dockerfile)
      deployment_shards="true"
      deployment_installer="true"
      ;;
    .env.template | docker-compose.apps.yml | scripts/deploy:environment | scripts/deploy/* | scripts/test:deploy-environment | scripts/deploy-contracts/* | deploy/* | src/HVO.SkyMonitor.CameraAgent/cameraagent.sample.json | src/HVO.SkyMonitor.CameraAgent/virtual-asi174.full.json | src/HVO.SkyMonitor.CameraAgent/virtual-asi178mc.full.json)
      deployment_shards="true"
      ;;
  esac
}

select_all_deployment_suites() {
  deployment_catalog="true"
  deployment_shards="true"
  deployment_installer="true"
}

