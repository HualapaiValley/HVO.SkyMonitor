  complete="true"
  shared="true"
  cameraagent="true"
  logichost="true"
  combined="true"
  delivery="true"
}

select_shared_component() {
  shared="true"
  cameraagent="true"
  logichost="true"
  combined="true"
  delivery="true"
}

# A source can be compiled into a project outside its own directory through an
# MSBuild <Compile Include> link. The including project's component is derived
# from the checked-out project files rather than a hand-maintained list, so a new
# link cannot narrow the plan.
apply_linked_project() {
  local project="$1"

  # A host application project that compiles a source from elsewhere composes it
  # into that host's exported surface, so it selects combined coverage the same
  # way a direct seam change does. A test project keeps the narrow selection.
  case "$project" in
    HVO.SkyMonitor.CameraAgent | HVO.SkyMonitor.CameraAgent.Common | HVO.SkyMonitor.LogicHost)
      combined="true"
      ;;
  esac

  if contains_project "$project" "${shared_projects[@]}"; then
    select_shared_component
  elif contains_project "$project" "${cameraagent_projects[@]}"; then
    cameraagent="true"
  elif contains_project "$project" "${logichost_projects[@]}"; then
    logichost="true"
  elif contains_project "$project" "${combined_projects[@]}"; then
    combined="true"
    cameraagent="true"
    logichost="true"
  elif contains_project "$project" "${delivery_projects[@]}"; then
    delivery="true"
  else
    complete_reason="a linked source is compiled by a project outside every component boundary"
    select_complete_matrix
  fi
}

# List every project directory, other than the path's own, whose project file
# includes the path through a relative MSBuild item. Every project file in this
# repository lives at <top>/<project>/<name>.csproj, so a repository path is
# always reachable as ../../<path> and, for a sibling project, as
# ../<project>/<relative>. Both separators and every item type are matched, so a
# Compile link, a copied fixture, and an embedded resource all count.
list_linked_projects() {
  local path="$1" top rest project relative csproj including_project
  local patterns=()

  # A project reference is a component-graph relationship, not a link: it is
  # already modelled by the component map and the seam rules.
  [[ "$path" != *.csproj ]] || return 0

  patterns+=(-e "Include=\"../../${path}\"")
  patterns+=(-e "Include=\"..\\..\\${path//\//\\}\"")

  top="${path%%/*}"
  project=""
  case "$top" in
    src | tests | tools)
      rest="${path#"$top"/}"
      if [[ "$rest" == */* ]]; then
        project="${rest%%/*}"
        relative="${rest#"$project"/}"
        patterns+=(-e "Include=\"../${project}/${relative}\"")
        patterns+=(-e "Include=\"..\\${project}\\${relative//\//\\}\"")
      fi
      ;;
  esac

  while IFS= read -r csproj; do
    [[ -n "$csproj" ]] || continue
    including_project="${csproj#*/}"
    including_project="${including_project%%/*}"
    [[ -z "$project" || "$including_project" != "$project" ]] || continue
    printf '%s\n' "$including_project"
  done < <(grep -rlF --include='*.csproj' "${patterns[@]}" src tests tools scripts 2>/dev/null) | sort -u
}

select_components() {
  local path="$1" linked_projects="${2:-}" top rest project linked_project

  # A source that another project compiles or copies also selects that project's
  # component, wherever the source itself lives.
  while IFS= read -r linked_project; do
    [[ -n "$linked_project" ]] || continue
    apply_linked_project "$linked_project"
  done <<< "$linked_projects"

  # Deployment inputs that are not .NET project directories are intentionally not
  # mapped to the delivery component. Test code reads several of them from the
  # repository root at run time, which no project file records, so narrowing them
  # would silently drop the suites that assert them. They keep their independent
  # deployment-contract selection and otherwise fall through to the complete
  # matrix, exactly as before component scoping.

  top="${path%%/*}"
  rest="${path#"$top"/}"
  # A path outside every project directory always selects the complete matrix.
  # Test code reads repository-root files that no project file records, so link
  # derivation can widen such a path's plan but must never narrow it.
  if [[ "$top" != "src" && "$top" != "tests" && "$top" != "tools" ]] || [[ "$rest" != */* ]]; then
    complete_reason="at least one path is outside every component boundary"
    select_complete_matrix
    return 0
  fi

  project="${rest%%/*}"
  if contains_project "$project" "${shared_projects[@]}"; then
    select_shared_component
  elif contains_project "$project" "${cameraagent_projects[@]}"; then
    cameraagent="true"
    if ! is_host_private_path "$path"; then
      combined="true"
    fi
  elif contains_project "$project" "${logichost_projects[@]}"; then
    logichost="true"
    if ! is_host_private_path "$path"; then
      combined="true"
    fi
  elif contains_project "$project" "${combined_projects[@]}"; then
    combined="true"
    cameraagent="true"
    logichost="true"
  elif contains_project "$project" "${delivery_projects[@]}"; then
    delivery="true"
  else
    complete_reason="at least one path is outside every component boundary"
    select_complete_matrix
  fi
}

if [[ "$event_name" == "--print-docs-inventory" ]]; then
  fast_inventory_for_tree "$base_sha"
  exit $?
fi

if [[ "$event_name" == "--warn-docs-inventory" ]]; then
  warn_expected="$(mktemp)" || { printf '::warning::Documentation CI inventory check could not run.\n'; exit 0; }
  warn_actual="$(mktemp)" || { rm -f "$warn_expected"; printf '::warning::Documentation CI inventory check could not run.\n'; exit 0; }
  if ! git show "$base_sha:scripts/ci:docs-inventory" > "$warn_expected" 2>/dev/null ||
     ! fast_inventory_for_tree "$base_sha" > "$warn_actual" ||
     ! cmp -s "$warn_expected" "$warn_actual"; then
    printf '::warning::Documentation CI build inventory is stale or unsafe; full validation will run.\n'
  fi
  rm -f "$warn_expected" "$warn_actual"
  exit 0
fi

if [[ "$event_name" != "pull_request" ]]; then
  finish
  exit 0
fi

docs_fast_path_reason="base or head commit is unavailable"
reason="pull request contains only allowlisted documentation and developer-environment changes"
deployment="false"
deployment_reason="pull request does not change deployment-contract inputs"
deployment_catalog="false"
deployment_shards="false"
deployment_installer="false"
complete="false"
complete_reason="pull request changes only component-scoped paths"
shared="false"
cameraagent="false"
logichost="false"
combined="false"
delivery="false"

if ! git cat-file -e "${base_sha}^{commit}" 2>/dev/null \
  || ! git cat-file -e "${head_sha}^{commit}" 2>/dev/null; then
  deployment="true"
  select_all_deployment_suites
  select_complete_matrix
  reason="base or head commit is unavailable"
  deployment_reason="base or head commit is unavailable"
  complete_reason="base or head commit is unavailable"
  finish
  exit 0
fi

# This decision uses the exact two endpoint trees, not the merge-base range used
# by the component classifier. Every entry must be a regular, unlinked text doc.
fast_diff="$(mktemp)"
trap 'rm -f "$fast_diff" "${diff_file:-}"' EXIT
docs_fast_path_reason="exact diff failed or is empty"
if git diff --name-status --no-renames --ignore-submodules=none -z "$base_sha" "$head_sha" -- > "$fast_diff"; then
  fast_ok=true
  fast_count=0
  [[ -z "$summary_file" ]] || printf '\nExact base/head paths for docs fast path:\n' >> "$summary_file"
  while IFS= read -r -d '' fast_status || [[ -n "$fast_status" ]]; do
    if ! IFS= read -r -d '' fast_path || [[ -z "$fast_path" ]]; then
      fast_ok=false
      docs_fast_path_reason="malformed exact diff"
      break
    fi
    ((fast_count += 1))
    [[ -z "$summary_file" ]] || printf -- '- %q %q\n' "$fast_status" "$fast_path" >> "$summary_file"
    [[ "$fast_ok" == true ]] || continue
    if [[ "$fast_status" != A && "$fast_status" != M ]]; then
      fast_ok=false; docs_fast_path_reason="deleted or type-changed path in exact diff"
    elif ! fast_entry="$(git ls-tree "$head_sha" -- ":(literal)$fast_path")" \
      || [[ "${fast_entry%% *}" != 100644 ]]; then
      fast_ok=false; docs_fast_path_reason="non-regular or missing path in exact diff"
    elif [[ "$fast_status" == M ]] && { ! fast_base_entry="$(git ls-tree "$base_sha" -- ":(literal)$fast_path")" || [[ "${fast_base_entry%% *}" != 100644 ]]; }; then
      fast_ok=false; docs_fast_path_reason="non-regular or executable base path"
    elif ! is_fast_doc_path "$fast_path"; then
      fast_ok=false; docs_fast_path_reason="path outside documentation allowlist"
    elif ! git cat-file blob "$head_sha:$fast_path" | python3 -c 'import codecs, sys
text = codecs.getincrementaldecoder("utf-8")("strict")
try:
    while chunk := sys.stdin.buffer.read(65536):
        decoded = text.decode(chunk)
        if any((ord(c) < 32 and c not in "\t\r\n") or 127 <= ord(c) <= 159 for c in decoded): sys.exit(1)
    text.decode(b"", final=True)
except UnicodeError:
    sys.exit(1)' ; then
      fast_ok=false; docs_fast_path_reason="documentation is binary or unreadable"
    else
      if [[ -z "${fast_inventory_status:-}" ]]; then
        if fast_doc_link_state; then fast_inventory_status=changed; else
          fast_link_status=$?
          if [[ "$fast_link_status" -eq 1 ]]; then fast_inventory_status=clean; else fast_inventory_status=failed; fi
        fi
      fi
      case "$fast_inventory_status" in
        changed) fast_ok=false; docs_fast_path_reason="project inventory differs from certified baseline" ;;
        failed) fast_ok=false; docs_fast_path_reason="project inventory unavailable" ;;
      esac
    fi
    # Continue listing every path, even after a rejection.
    [[ "$fast_ok" == true ]] || continue
  done < "$fast_diff"
  [[ -z "$summary_file" ]] || printf '\nFast path paths examined: %s\n' "$fast_count" >> "$summary_file"
  if [[ "$fast_ok" == true && "$fast_count" -gt 0 ]]; then
    docs_fast_path=true
    docs_fast_path_reason="all exact base/head paths are safe documentation"
  fi
fi

if [[ "${4:-}" == "docs-fast-only" ]]; then
  finish
  exit 0
fi

diff_file="$(mktemp)"
trap 'rm -f "$diff_file" "$fast_diff"' EXIT

if ! git diff --name-status --no-renames -z "${base_sha}...${head_sha}" -- > "$diff_file"; then
  docs_fast_path=false
  docs_fast_path_reason="component diff failed"
  deployment="true"
  select_all_deployment_suites
  select_complete_matrix
  reason="git diff failed"
  deployment_reason="git diff failed"
  complete_reason="git diff failed"
  finish
  exit 0
fi

# Only a successfully read PR diff may opt out. Non-PR events keep full-mode
# coverage; missing commits, failed/malformed diffs and empty ranges keep it too.
secret_scan_contract="false"
release_scripts="false"
catalog_recipe="false"
mode="reduced"
write_summary_header

while IFS= read -r -d '' status || [[ -n "$status" ]]; do
  if ! IFS= read -r -d '' path || [[ -z "$path" ]]; then
    secret_scan_contract="true"
    release_scripts="true"
    catalog_recipe="true"
    mode="full"
    deployment="true"
    select_all_deployment_suites
    select_complete_matrix
    docs_fast_path=false
    docs_fast_path_reason="malformed component diff"
    reason="git diff returned malformed name-status data"
    deployment_reason="git diff returned malformed name-status data"
    complete_reason="git diff returned malformed name-status data"
    break
  fi

  ((path_count += 1))
  write_summary_path "$status" "$path"
  if is_secret_scan_contract_path "$path"; then
    secret_scan_contract="true"
  fi
  if is_release_scripts_path "$path"; then
    release_scripts="true"
  fi
  if is_catalog_recipe_path "$path"; then
    catalog_recipe="true"
  fi
  select_deployment_suites "$path"

  if [[ "$status" != "A" && "$status" != "M" ]]; then
    mode="full"
    deployment="true"
    select_complete_matrix
    reason="deleted, renamed, or type-changed paths require the full matrix"
    deployment_reason="deleted, renamed, or type-changed paths require deployment contracts"
    complete_reason="deleted, renamed, or type-changed paths require the complete solution matrix"
  elif ! tree_entry="$(git ls-tree "$head_sha" -- ":(literal)$path")" \
    || [[ "${tree_entry%% *}" != "100644" && "${tree_entry%% *}" != "100755" ]]; then
    secret_scan_contract="true"
    release_scripts="true"
    catalog_recipe="true"
    mode="full"
    deployment="true"
    select_complete_matrix
    reason="missing or non-regular paths require the full matrix"
    deployment_reason="missing or non-regular paths require deployment contracts"
    complete_reason="missing or non-regular paths require the complete solution matrix"
  else
    linked_projects="$(list_linked_projects "$path")"
    if [[ -n "$linked_projects" ]] || ! is_reduced_path "$path"; then
      mode="full"
      if [[ -n "$linked_projects" ]] && is_reduced_path "$path"; then
        reason="at least one otherwise-allowlisted path is compiled or copied into a project"
      else
        reason="at least one path is outside the reduced-mode allowlist"
      fi
      select_components "$path" "$linked_projects"
    fi
    if is_deployment_path "$path"; then
      mode="full"
      deployment="true"
      reason="pull request changes a deployment-contract input"
      deployment_reason="pull request changes a deployment-contract input"
    fi
  fi
done < "$diff_file"

if [[ "$path_count" -eq 0 ]]; then
  docs_fast_path=false
  docs_fast_path_reason="empty component diff"
  secret_scan_contract="true"
  release_scripts="true"
  catalog_recipe="true"
  mode="full"
  deployment="true"
  select_all_deployment_suites
  select_complete_matrix
  reason="empty change sets require the full matrix"
  deployment_reason="empty change sets require deployment contracts"
  complete_reason="empty change sets require the complete solution matrix"
fi

if [[ "$mode" == "full" && "$complete" == "false" ]] \
  && [[ "$shared" == "false" && "$cameraagent" == "false" && "$logichost" == "false" && "$combined" == "false" && "$delivery" == "false" ]]; then
  complete_reason="full mode selected no component lane"
  select_complete_matrix
fi

finish
