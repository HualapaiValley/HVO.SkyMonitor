#!/usr/bin/env bash
set -uo pipefail

event_name="${1:-}"
base_sha="${2:-}"
head_sha="${3:-}"
summary_file="${GITHUB_STEP_SUMMARY:-}"
classification_scope="${4:-}"

mode="full"
reason="non-pull-request events always run the full matrix"
deployment="true"
deployment_reason="non-pull-request events always run deployment contracts"
deployment_catalog="true"
deployment_installer="true"
complete="true"
complete_reason="non-pull-request events always run the complete solution matrix"
shared="true"
cameraagent="true"
delivery="true"
secret_scan_contract="true"
release_scripts="true"
catalog_recipe="true"
path_count=0
docs_fast_path="false"
docs_fast_path_reason="non-pull-request events require full validation"
restore_certificate_path='scripts/ci:restore-import-certificate.json'
docs_restore_required=false

write_summary_header() {
  [[ -n "$summary_file" ]] || return 0
  printf '### CI change classification\n\nObserved paths:\n' >> "$summary_file"
}

write_summary_path() {
  [[ -n "$summary_file" ]] || return 0
  printf -- '- %q %q\n' "$1" "$2" >> "$summary_file"
}

finish() {
  if [[ -n "$summary_file" && "${classification_scope:-}" != "docs-fast-only" ]]; then
    printf '\nMode: **%s**  \nMode reason: %s  \nDeployment contracts: **%s**  \nDeployment reason: %s  \nExhaustive catalog: **%s**  \nExhaustive installer: **%s**  \nComplete matrix: **%s**  \nComplete reason: %s  \nShared libraries: **%s**  \nCameraAgent: **%s**  \nDelivery: **%s**  \nSecret scan contract: **%s**  \nRelease scripts: **%s**  \nCatalog recipe: **%s**  \nPath count: %s\n' \
      "$mode" "$reason" "$deployment" "$deployment_reason" "$deployment_catalog" \
      "$deployment_installer" "$complete" "$complete_reason" \
      "$shared" "$cameraagent" "$delivery" "$secret_scan_contract" "$release_scripts" \
      "$catalog_recipe" "$path_count" >> "$summary_file"
  fi

  printf 'Docs fast path: %s; reason: %s\n' "$docs_fast_path" "$docs_fast_path_reason" >&2
  [[ -z "$summary_file" ]] || printf '\nDocs fast path: **%s**  \nDocs fast path reason: %s\n' "$docs_fast_path" "$docs_fast_path_reason" >> "$summary_file"
  if [[ "$classification_scope" == docs-fast-only ]]; then
    printf 'docs_fast_path=%s\ndocs_fast_path_reason=%s\n' "$docs_fast_path" "$docs_fast_path_reason"
    return
  fi
  printf 'CI classification: mode=%s deployment=%s complete=%s shared=%s cameraagent=%s delivery=%s secret_scan_contract=%s release_scripts=%s catalog_recipe=%s reason=%s deployment-reason=%s complete-reason=%s paths=%s\n' \
    "$mode" "$deployment" "$complete" "$shared" "$cameraagent" \
    "$delivery" "$secret_scan_contract" "$release_scripts" "$catalog_recipe" "$reason" "$deployment_reason" \
    "$complete_reason" "$path_count" >&2
  printf 'mode=%s\ndeployment=%s\ndeployment_catalog=%s\ndeployment_installer=%s\ncomplete=%s\nshared=%s\ncameraagent=%s\ndelivery=%s\nsecret_scan_contract=%s\nrelease_scripts=%s\ncatalog_recipe=%s\n' \
    "$mode" "$deployment" "$deployment_catalog" "$deployment_installer" \
    "$complete" "$shared" "$cameraagent" "$delivery" "$secret_scan_contract" \
    "$release_scripts" "$catalog_recipe"
  printf 'docs_fast_path=%s\ndocs_fast_path_reason=%s\n' "$docs_fast_path" "$docs_fast_path_reason"
}

is_secret_scan_contract_path() {
  # The gitleaks version and archive checksums are pinned in ci:secret-scan.
  case "$1" in
    scripts/ci:secret-scan | scripts/test:ci-secret-scan | .gitleaks.toml | *.gitleaksignore | *.gitattributes | \
      .github/workflows/development-v1.yml | .github/workflows/ci.yml | scripts/ci:classify)
      return 0
      ;;
  esac
  return 1
}

is_release_scripts_path() {
  # scripts/test:release-scripts proves the pre-release and release scripts with fake gh, skopeo and docker commands,
  # and the release workflow's shape, and runs scripts/test:install-sh, which proves the release's install.sh with fake
  # commands of its own. It runs when those scripts, the libraries they source (test:release-install's, the strict
  # GitHub reads and the newest-release rule), install.sh or its fakes, either release workflow, the product version
  # (Directory.Build.props) or the release tool change, or the Preflight wiring that runs it. Its CameraAgent tests
  # (scripts/test:cameraagent-r2r) also prove the bundled time-data update's rollback with fake curl and dotnet,
  # and scripts/test:cameraagent-image-reproducibility protects the image build scripts and Dockerfile.
  case "$1" in
    scripts/build:cameraagent-image | scripts/test:cameraagent-image-reproducibility | scripts/release:check-cameraagent-image | \
      scripts/test:cameraagent-arm64-ci | src/HVO.SkyMonitor.CameraAgent/Dockerfile | \
    scripts/release:cameraagent-publish | scripts/release:check-cameraagent-publish | scripts/cameraagent-release.targets | scripts/test:cameraagent-r2r | \
    scripts/time-data:update | scripts/release:assets | scripts/release:combine-images | scripts/release:check-image-labels | scripts/release:push-image | \
      scripts/release:prerelease-gate | scripts/release:prerelease-check | scripts/release:publish-prerelease | \
      scripts/release:version | scripts/release:notes | scripts/release:changelog | scripts/release:gate | scripts/release:check-environment | \
      scripts/release:publish | scripts/release:tag-latest | \
      scripts/test:release-images | scripts/test:release-install | scripts/test:release-scripts | scripts/lib/deployment-installer-qualification.sh | \
      scripts/lib/github-api.sh | scripts/lib/releases.sh | \
      src/HVO.SkyMonitor.Deployment.Cli/install.sh | scripts/test:install-sh | tests/fixtures/install-sh/* | \
      .github/workflows/release-image.yml | .github/workflows/prerelease.yml | .github/workflows/release.yml | Directory.Build.props | \
      tools/HVO.SkyMonitor.Deployment.ReleaseTool/* | .github/workflows/development-v1.yml | scripts/ci:classify)
      return 0
      ;;
  esac
  return 1
}

is_catalog_recipe_path() {
  # The Catalog Reproducibility job (Refs #1774) rebuilds the approved HYG 4.4 and OpenNGC bytes, and the committed catalog
  # test fixtures, under both SQLite connection defaults. It runs when a build recipe, a pin or a fixture changes,
  # which is everything under these two directories and nothing else: scripts/catalog:* (the operator entry points)
  # and the job's own wiring do not select it on a pull request. Non-pull-request events always run it.
  case "$1" in
    scripts/catalog/* | tests/fixtures/catalog/*)
      return 0
      ;;
  esac
  return 1
}

is_reduced_path() {
  local path="$1"

  if [[ "$path" =~ ^\.agents/skills/[^/]+/SKILL\.md$ ]]; then
    return 0
  fi
  if [[ "$path" =~ ^changelog\.d/[a-z0-9]+(-[a-z0-9]+)*\.(added|changed|deprecated|removed|fixed|security)\.md$ ]]; then
    return 0
  fi

  case "$path" in
    docs/catalog/hyg-v42-attribution.md | docs/catalog/hyg-v42-license.md | docs/catalog/hyg-v44-attribution.md | docs/catalog/hyg-v44-license.md)
      return 1
      ;;
  esac

  case "$path" in
    docs/* | .devcontainer/* | .vscode/* | .github/prompts/*)
      return 0
      ;;
    README.md | CONTRIBUTING.md | AGENTS.md | CLAUDE.md | CHANGELOG.md | THIRD-PARTY-NOTICES.md | changelog.d/README.md)
      return 0
      ;;
    .github/copilot-instructions.md | .github/pull_request_template.md)
      return 0
      ;;
    tools/asi-capture/README.md)
      return 0
      ;;
    tests/fixtures/catalog/SOURCE.md | tests/fixtures/stellarium/SIMBAD_ENDPOINTS.md)
      return 0
      ;;
    scripts/test:devcontainer)
      return 0
      ;;
  esac

  [[ "$path" =~ ^(src|tests)/[^/]+/README\.md$ ]]
}

is_fast_doc_path() {
  case "$1" in
    docs/catalog/* | docs/contracts/* | docs/validation/* | docs/evidence/* | docs/*/evidence/* | docs/generated/* | docs/*/generated/* | docs/images/* | docs/upgrade-notes/* | docs/runbooks/development-v1-merge-queue-drill/*) return 1 ;;
    docs/*.md | docs/*.markdown | docs/*.txt | README.md | AGENTS.md | CLAUDE.md) return 0 ;;
  esac
  return 1
}

# Certified inventory: the base-controlled manifest records every tracked
# MSBuild definition, XML input and resolved explicit import, including modes
# and blob identities. Changes disable the exemption until reviewed.
audit_fast_inventory() {
  python3 -I - "$1" "${2:-}" <<'PY_AUDIT'
import os, posixpath, re, subprocess, sys, xml.etree.ElementTree as ET

commit = sys.argv[1]
restore_source = sys.argv[2] == "restore-source"
def fail(message):
    print("docs inventory audit: " + message, file=sys.stderr)
    sys.exit(1)
def git(*args):
    try:
        return subprocess.run(["git", *args], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        fail("Git could not read the committed input tree")

def read_xml(name):
    raw = git("cat-file", "blob", commit + ":" + name)
    try:
        text = raw.decode("utf-8-sig")
    except UnicodeDecodeError:
        fail("build input is not UTF-8")
    if "\0" in text:
        fail("build input is not UTF-8")
    declaration = re.match(r"^<\?xml\s+([^?]*?)\?>", text)
    if declaration:
        declared_encoding = re.search(r"(?:^|\s)encoding\s*=\s*([\"'])([^\"']+)\1", declaration.group(1))
        if declared_encoding and declared_encoding.group(2).lower() != "utf-8":
            fail("XML declares a non-UTF-8 encoding")
    if "<!DOCTYPE" in text.upper() or "<!ENTITY" in text.upper():
        fail("document type declarations require manual review")
    if re.search(r"&#|%[0-9a-fA-F]{2}", text):
        fail("escaped build input requires manual review")
    try:
        return ET.fromstring(text)
    except (ET.ParseError, ValueError):
        fail("unparseable build input")

entries = {}
try:
    for entry in git("ls-tree", "-rz", commit).split(b"\0"):
        if not entry: continue
        meta, path = entry.split(b"\t", 1)
        name = path.decode("utf-8")
        entries[name] = (meta, path)
except (ValueError, UnicodeError):
    fail("unreadable tree entry")

restore_inputs = set()
for name, (metadata, _) in entries.items():
    if metadata.startswith(b"120000 "):
        fail("tracked symlink requires manual review")
    if metadata.startswith(b"160000 "):
        fail("tracked submodule requires manual review")
    lower = name.lower()
    if lower.endswith((".user", ".rsp")) or posixpath.basename(lower).startswith("directory.solution."):
        fail("tracked automatic MSBuild input requires manual review")
    if restore_source and (posixpath.basename(lower) in (
        "global.json", "nuget.config", "packages.config", "packages.lock.json", ".gitattributes", "dotnet-tools.json"
    )):
        restore_inputs.add(name)

# Certify the exact solution the workflow restores and builds. Unknown solution
# syntax or project paths cannot establish the exemption.
solution = "HVO.SkyMonitor.v9.slnx"
if solution not in entries or not entries[solution][0].startswith(b"100644 blob "):
    fail("solution is unavailable or non-regular")
solution_root = read_xml(solution)
if solution_root.tag != "Solution": fail("unknown solution format")
projects = set()
for node in solution_root.iter():
    if node.tag not in ("Solution", "Folder", "Project"):
        fail("unknown solution entry")
    if node.tag == "Project":
        value = node.attrib.get("Path", "").replace("\\", "/")
        if set(node.attrib) != {"Path"} or not value or any(c in value for c in ("$", "*", "?", ";")) or value.startswith("/"):
            fail("unresolved solution project")
        target = posixpath.normpath(value)
        if target == ".." or target.startswith("../") or target not in entries or target in projects:
            fail("solution project outside committed inventory")
        projects.add(target)
if not projects: fail("solution has no projects")
pending = [(n, True) for n in projects]
pending += [(n, n.lower().endswith(".csproj")) for n in entries if n.lower().endswith((".csproj", ".props", ".targets", ".xml"))]
seen = {solution} | restore_inputs
visited = set()
while pending:
    name, is_project = pending.pop()
    if (name, is_project) in visited: continue
    visited.add((name, is_project))
    seen.add(name)
    # SDK default items include the project subtree. A project rooted at the
    # repository or under docs can implicitly consume eligible documentation.
    project_dir = posixpath.dirname(name).lower()
    if is_project and (not project_dir or project_dir == "docs" or project_dir.startswith("docs/")):
        fail("project location permits implicit documentation items")
    meta, _ = entries[name]
    if not meta.startswith(b"100644 blob ") and not meta.startswith(b"100755 blob "):
        fail("non-regular build input")
    root = read_xml(name)
    sdk_uncertified = False
    for node in root.iter():
        tag = node.tag.rsplit("}", 1)[-1] if isinstance(node.tag, str) else ""
        sdk_keys = [key for key in node.attrib if key.rsplit("}", 1)[-1].lower() == "sdk"]
        if tag.lower() == "sdk" or sdk_keys:
            # Only the pinned SDK's built-in project entry points are covered.
            sdk_uncertified |= not (restore_source and is_project and node is root and
                tag == "Project" and sdk_keys == ["Sdk"] and
                node.attrib["Sdk"] in ("Microsoft.NET.Sdk", "Microsoft.NET.Sdk.Web"))
        if tag.lower() in ("packagereference", "globalpackagereference", "packagedownload") and not (
            restore_source and tag == "PackageReference"
        ):
            fail("restore generated package imports are uncertified")
        for text in list(node.attrib.values()) + ([node.text] if node.text else []):
            norm = text.replace("\\", "/")
            if re.search(r"(?i)(^|[^a-z0-9_])(README|AGENTS|CLAUDE)\.md([^a-z0-9_]|$)", norm):
                fail("build input references a root documentation name")
            for match in re.finditer(r"(?i)(?:^|/)docs/([^\s\"'<>;]+)", norm):
                part = match.group(1).lower()
                if ".." in part.split("/") or not part.startswith(("catalog/", "contracts/", "validation/", "images/", "upgrade-notes/", "evidence/", "generated/")):
                    fail("build input references eligible documentation")
        for attr in ("Include", "Update", "Remove"):
            value = node.attrib.get(attr)
            if not value or tag in ("PackageReference", "PackageVersion", "Reference", "Using", "InternalsVisibleTo"): continue
            for part in value.split(";"):
                part = part.strip().replace("\\", "/")
                if not part: fail("empty item specification")
                if "@(" in part or "%(" in part:
                    if name == "scripts/cameraagent-release.targets" and tag == "StaticWebAssetEndpoint" and part == "@(_HvoReleaseAssetEndpoints)":
                        continue
                    fail("unresolved item expression")
                token = "$(MSBuildThisFileDirectory)"
                if not is_project and not part.startswith(token):
                    if name == "scripts/cameraagent-release.targets" and tag == "_HvoReleaseAssetHeader" and part == "Replace":
                        continue
                    fail("relative item in imported build input")
                if "$(" in part:
                    token = "$(MSBuildThisFileDirectory)"
                    if not part.startswith(token): fail("unresolved item property")
                    part = part[len(token):]
                    if "$(" in part: fail("unresolved item property")
                resolved_part = posixpath.normpath(posixpath.join(posixpath.dirname(name), part))
                lower_part = resolved_part.lower()
                if resolved_part.startswith("/") or resolved_part == ".." or resolved_part.startswith("../"):
                    fail("item path escapes the committed tree")
                if lower_part in ("readme.md", "agents.md", "claude.md") or (
                    lower_part.startswith("docs/") and not lower_part.startswith(("docs/catalog/", "docs/contracts/", "docs/validation/", "docs/images/", "docs/upgrade-notes/", "docs/evidence/", "docs/generated/"))):
                    fail("item references eligible documentation")
                if "*" in part or "?" in part:
                    wildcard_tail = re.split(r"[?*]", part, 1)[1]
                    if ".." in wildcard_tail.split("/"):
                        fail("item path traverses after a wildcard")
                    prefix = re.split(r"[?*]", part, 1)[0]
                    # A partial component is not a directory boundary: d* can
                    # match docs. Confine only the complete preceding directory.
                    if not prefix.endswith("/"):
                        prefix = posixpath.dirname(prefix)
                    resolved = posixpath.normpath(posixpath.join(posixpath.dirname(name), prefix))
                    if resolved in ("", ".", "..") or resolved.startswith("../") or resolved == "docs" or resolved.startswith("docs/"):
                        fail("item glob may reach documentation")
        if tag == "ProjectReference":
            value = node.attrib.get("Include", "").replace("\\", "/")
            if not value or any(c in value for c in ("$", "*", "?", ";")) or value.startswith("/"):
                fail("unresolved project reference")
            target = posixpath.normpath(posixpath.join(posixpath.dirname(name), value))
            if target not in entries:
                fail("project reference outside committed inventory")
            pending.append((target, True))
        if tag == "Import":
            if "Sdk" in node.attrib: fail("SDK import requires manual review")
            value = node.attrib.get("Project", "").replace("\\", "/")
            if name == "tests/Directory.Build.props" and value == "$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))":
                target = "Directory.Build.props"
            else:
                token = "$(MSBuildThisFileDirectory)"
                if value.startswith(token): value = value[len(token):]
                if not value or any(c in value for c in ("$", "*", "?", ";")) or value.startswith("/"):
                    fail("unresolved MSBuild import")
                target = posixpath.normpath(posixpath.join(posixpath.dirname(name), value))
            if target not in entries:
                fail("MSBuild import outside committed inventory")
            pending.append((target, False))
    if sdk_uncertified:
        fail("SDK generated restore imports are uncertified")
for name in sorted(seen, key=lambda n: entries[n][1]):
    meta, path = entries[name]
    print(meta.decode("ascii") + " " + repr(path))
PY_AUDIT
}

restore_tool_from_base() (
  local command="$1" trust_sha="$2" source_hash="$3" tool
  tool="$(mktemp)" || return 1
  trap 'rm -f "$tool"' EXIT
  git show "$trust_sha:scripts/ci/restore-imports.py" > "$tool" || return 1
  python3 -I "$tool" "$command" "$trust_sha" "$source_hash"
)

fast_inventory_for_tree() {
  local commit="$1" trust_sha="$2" entry inventory checksum
  entry="$(git ls-tree "$trust_sha" -- "$restore_certificate_path")" || return 1
  if [[ -z "$entry" ]]; then
    audit_fast_inventory "$commit"
    return $?
  fi
  [[ "$entry" == '100644 blob '* ]] || return 1
  docs_restore_required=true
  inventory="$(audit_fast_inventory "$commit" restore-source)" || return 1
  checksum="$(printf '%s\n' "$inventory" | sha256sum)" || return 1
  restore_tool_from_base check-source "$trust_sha" "${checksum%% *}" || return 1
  printf '%s\n' "$inventory"
}

fast_doc_link_state() {
  local expected actual
  expected="$(mktemp)" || return 2
  actual="$(mktemp)" || { rm -f "$expected"; return 2; }
  if ! git show "$base_sha:scripts/ci:docs-inventory" > "$expected" ||
     ! fast_inventory_for_tree "$head_sha" "$base_sha" > "$actual"; then
    rm -f "$expected" "$actual"
    return 2
  fi
  if ! cmp -s "$expected" "$actual"; then
    if [[ -n "$summary_file" ]]; then
      printf '\nBuild inventory differs from the certified base inventory:\n```diff\n' >> "$summary_file"
      diff -u "$expected" "$actual" >> "$summary_file" || true
      printf '\n```\n' >> "$summary_file"
    fi
    rm -f "$expected" "$actual"
    return 0
  fi
  rm -f "$expected" "$actual"
  return 1
}

is_deployment_path() {
  local path="$1"

  case "$path" in
    .github/workflows/ci.yml | .github/workflows/release-image.yml | .github/workflows/release.yml | .github/workflows/prerelease.yml | .dockerignore | .env.template | docker-compose.apps.yml | global.json)
      return 0
      ;;
    scripts/ci:* | scripts/test:ci-classification | scripts/release:* | scripts/test:release-images | scripts/test:release-install | scripts/test:release-scripts | scripts/test:cameraagent-r2r | scripts/cameraagent-release.targets | scripts/lib/*)
      return 0
      ;;
    scripts/qualify:silo-runtime | scripts/test:silo-runtime-qualification | scripts/test:deployment-installer | scripts/test:deployment-installer-qualification | scripts/catalog:* | scripts/catalog/* | scripts/infra:operation-lock)
      return 0
      ;;
    deploy/*)
      return 0
      ;;
    tests/fixtures/catalog/hyg-v42-bright-stars.sqlite)
      return 0
      ;;
    src/HVO.SkyMonitor.CameraAgent/Dockerfile)
      return 0
      ;;
    src/HVO.SkyMonitor.Deployment.Cli/* | src/HVO.SkyMonitor.Deployment.Contracts/* | tests/HVO.SkyMonitor.Deployment.Cli.Tests/* | tests/HVO.SkyMonitor.Deployment.Distribution.Tests/* | tools/HVO.SkyMonitor.Deployment.ReleaseTool/*)
      return 0
      ;;
    src/HVO.SkyMonitor.TerminalUi/*)
      # Compiled into the installer, whose published file the installer suite runs on a terminal (#1317).
      return 0
      ;;
    src/HVO.SkyMonitor.CameraAgent/cameraagent.sample.json)
      return 0
      ;;
    src/HVO.SkyMonitor.CameraAgent/virtual-asi174.full.json | src/HVO.SkyMonitor.CameraAgent/virtual-asi178mc.full.json)
      return 0
      ;;
  esac

  return 1
}

select_deployment_suites() {
  local path="$1"

  case "$path" in
    .github/workflows/ci.yml | global.json | scripts/ci:* | scripts/test:ci-classification | .github/workflows/release-image.yml | .github/workflows/release.yml | .github/workflows/prerelease.yml)
      select_all_deployment_suites
      ;;
    scripts/catalog:* | scripts/catalog/* | tests/fixtures/catalog/hyg-v42-bright-stars.sqlite | scripts/infra:operation-lock)
      deployment_catalog="true"
      ;;
    .dockerignore | src/HVO.SkyMonitor.CameraAgent/Dockerfile | scripts/test:deployment-installer | scripts/test:deployment-installer-qualification | scripts/release:* | scripts/test:release-images | scripts/test:release-install | scripts/test:release-scripts | scripts/test:cameraagent-r2r | scripts/cameraagent-release.targets | scripts/lib/* | src/HVO.SkyMonitor.Deployment.Cli/* | src/HVO.SkyMonitor.Deployment.Contracts/* | src/HVO.SkyMonitor.TerminalUi/* | tests/HVO.SkyMonitor.Deployment.Cli.Tests/* | tests/HVO.SkyMonitor.Deployment.Distribution.Tests/* | tools/HVO.SkyMonitor.Deployment.ReleaseTool/*)
      deployment_installer="true"
      ;;
  esac
}

select_all_deployment_suites() {
  deployment_catalog="true"
  deployment_installer="true"
}

