#!/usr/bin/env bash
# Validate public identity surfaces and authentication boundaries without printing credentials.

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
if [[ -f "$REPO_ROOT/.env" ]]; then
    set -a
    source "$REPO_ROOT/.env"
    set +a
fi

base_url="${LOGIC_HOST_URL:-http://localhost:${LOGIC_HOST_HTTP_PORT:-5174}}"
base_url="${base_url%/}"
api_key_config=""

cleanup() {
    if [[ -n "$api_key_config" ]]; then
        rm -f "$api_key_config"
    fi
}
trap cleanup EXIT

probe() {
    local path="$1"
    local expected_status="$2"
    shift 2

    local actual_status
    actual_status="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' "$@" "$base_url$path")"
    if [[ "$actual_status" != "$expected_status" ]]; then
        printf 'Expected %s from %s, received %s.\n' "$expected_status" "$path" "$actual_status" >&2
        return 1
    fi
    printf '%s -> %s\n' "$path" "$actual_status"
}

probe "/alive" 200
probe "/health" 200
probe "/.well-known/openid-configuration" 200
probe "/api/v1.0/status" 200
probe "/api/v1.0/status/detailed" 401
probe "/api/v1.0/status/protected" 401

if [[ -n "${SKYMONITOR_API_KEY:-}" ]]; then
    api_key_config="$(mktemp -t hvo-identity-smoke.XXXXXX)"
    chmod 600 "$api_key_config"
    printf 'header = "X-API-Key: %s"\n' "$SKYMONITOR_API_KEY" > "$api_key_config"
    probe "/api/v1.0/status/detailed" 200 --config "$api_key_config"
else
    printf 'SKYMONITOR_API_KEY is unset; protected API-key success probe skipped.\n'
fi

printf 'Identity smoke checks passed.\n'
