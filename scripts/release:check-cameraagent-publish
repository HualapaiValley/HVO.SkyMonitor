#!/usr/bin/env python3
"""Check CameraAgent's release FDD/R2R layout and retain every published-file hash."""
import argparse
import hashlib
import json
from pathlib import Path
import struct
import sys

# CoreCLR v10.0.0 pedecoder.h: native-image machine = PE machine XOR Linux (0x7b79).
# https://github.com/dotnet/runtime/blob/v10.0.0/src/coreclr/inc/pedecoder.h
MACHINES = {'linux-x64': 0x8664 ^ 0x7B79, 'linux-arm64': 0xAA64 ^ 0x7B79}


def inspect_r2r(path, rid):
    data = path.read_bytes()

    def unpack(fmt, offset):
        if offset < 0 or offset + struct.calcsize(fmt) > len(data):
            raise ValueError(f'{path.name}: truncated PE/R2R header')
        return struct.unpack_from(fmt, data, offset)

    if data[:2] != b'MZ':
        raise ValueError(f'{path.name}: missing PE header')
    pe, = unpack('<I', 0x3c)
    if data[pe:pe + 4] != b'PE\0\0':
        raise ValueError(f'{path.name}: missing PE signature')
    machine, section_count = unpack('<HH', pe + 4)
    if machine != MACHINES[rid]:
        raise ValueError(f'{path.name}: machine 0x{machine:04x} is not {rid} R2R')
    optional_size, = unpack('<H', pe + 20)
    optional = pe + 24
    magic, = unpack('<H', optional)
    if magic != 0x20b or optional_size < 240:
        raise ValueError(f'{path.name}: expected PE32+ header')
    directories, = unpack('<I', optional + 108)
    if directories < 15:
        raise ValueError(f'{path.name}: no CLI directory')
    sections = [unpack('<IIII', optional + optional_size + i * 40 + 8)
                for i in range(section_count)]

    def rva_offset(rva, size):
        for _, address, raw_size, raw_offset in sections:
            if address <= rva and rva + size <= address + raw_size:
                offset = raw_offset + rva - address
                if offset + size <= len(data):
                    return offset
        raise ValueError(f'{path.name}: CLI/R2R RVA outside file sections')

    cli_rva, cli_size = unpack('<II', optional + 112 + 14 * 8)
    if cli_size < 72:
        raise ValueError(f'{path.name}: missing CLI header')
    cli = rva_offset(cli_rva, 72)
    cli_flags, = unpack('<I', cli + 16)
    native_rva, native_size = unpack('<II', cli + 64)
    if not cli_flags & 4 or not native_rva or native_size < 16:
        raise ValueError(f'{path.name}: not ReadyToRun (missing managed-native header)')
    native = rva_offset(native_rva, native_size)
    signature, major, minor, flags, count, entry_size, entry_type = unpack('<IHHIHBB', native)
    # ready to run header / flags: dotnet/runtime src/coreclr/inc/readytorun.h.
    if signature != 0x00525452 or not major or flags & (2 | 0x20):
        raise ValueError(f'{path.name}: missing or composite ReadyToRun header')
    if not count or entry_size != 12 or entry_type != 0 or 16 + count * entry_size > native_size:
        raise ValueError(f'{path.name}: invalid ReadyToRun section table')
    section_types = []
    for i in range(count):
        section_type, address, size = unpack('<III', native + 16 + i * entry_size)
        rva_offset(address, size)
        section_types.append(section_type)
    if 103 not in section_types:  # RuntimeFunctions proves native method bodies are present.
        raise ValueError(f'{path.name}: no ReadyToRun runtime functions')
    return {'assembly': path.name, 'rid': rid, 'machine': f'0x{machine:04x}',
            'r2rVersion': f'{major}.{minor}', 'flags': flags}


def inventory(root):
    records = []
    for path in sorted(root.rglob('*')):
        if path.is_symlink():
            raise ValueError(f'Unexpected published symlink: {path.relative_to(root)}')
        if path.is_file():
            with path.open('rb') as stream:
                digest = hashlib.file_digest(stream, 'sha256').hexdigest()
            records.append({'path': path.relative_to(root).as_posix(),
                            'bytes': path.stat().st_size, 'sha256': digest})
    if not records:
        raise ValueError('The published-file inventory is empty')
    return records


def check(root, rid):
    blazor = (root / 'wwwroot/_framework/blazor.web.js').read_bytes()
    if len(blazor) <= 10000 or b'window.Blazor' not in blazor:
        raise ValueError('blazor.web.js is missing or incomplete')
    config = json.loads((root / 'HVO.SkyMonitor.CameraAgent.runtimeconfig.json').read_text())['runtimeOptions']
    if not config.get('frameworks') or config.get('includedFrameworks'):
        raise ValueError('CameraAgent must be framework-dependent')
    deps = json.loads((root / 'HVO.SkyMonitor.CameraAgent.deps.json').read_text())
    if not deps['runtimeTarget']['name'].endswith('/' + rid):
        raise ValueError('CameraAgent dependency manifest has the wrong RID')
    forbidden = ('HVO.SkyMonitor.LogicHost', 'HVO.SkyMonitor.ProcessingRunner',
                 'HVO.SkyMonitor.CameraAgent.ReplayRunner', 'HVO.SkyMonitor.TestSupport',
                 'testhost', 'Microsoft.TestPlatform', 'MSTest', 'Microsoft.VisualStudio.TestPlatform')
    records = inventory(root)
    for name in [record['path'] for record in records] + list(deps['libraries']):
        if any(part.lower() in name.lower() for part in forbidden) or '.tests' in name.lower():
            raise ValueError(f'Forbidden published artifact: {name}')
    native_count = 0
    for record in records:
        path = root / record['path']
        with path.open('rb') as stream:
            header = stream.read(20)
        if header[:4] == b'\x7fELF':
            expected = 62 if rid == 'linux-x64' else 183
            if len(header) < 20 or header[4:6] != b'\x02\x01' or struct.unpack_from('<H', header, 18)[0] != expected:
                raise ValueError(f'{record["path"]}: native-library architecture mismatch for {rid}')
            native_count += 1
    assemblies = sorted(root.glob('HVO.*.dll'))
    if not (root / 'HVO.SkyMonitor.CameraAgent.dll').is_file() or not assemblies or not native_count:
        raise ValueError('CameraAgent assemblies or native dependencies are missing')
    return records, {'rid': rid, 'files': len(records), 'bytes': sum(r['bytes'] for r in records),
                     'nativeFiles': native_count, 'assemblies': [inspect_r2r(p, rid) for p in assemblies]}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('publish', type=Path)
    parser.add_argument('--rid', required=True, choices=MACHINES)
    parser.add_argument('--manifest', required=True, type=Path)
    parser.add_argument('--report', required=True, type=Path)
    args = parser.parse_args()
    try:
        records, report = check(args.publish, args.rid)
        args.manifest.write_text(json.dumps(records, indent=2) + '\n')
        args.report.write_text(json.dumps(report, indent=2) + '\n')
        print(json.dumps(report))
    except (ValueError, OSError, KeyError, struct.error) as error:
        print(f'CameraAgent publish check failed: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
