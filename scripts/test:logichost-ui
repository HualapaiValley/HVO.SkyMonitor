#!/usr/bin/env bash
# Run the opt-in LogicHost UI browser and evidence gate.

set -euo pipefail
export LC_ALL=C
umask 077

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
# shellcheck source=lib/trx-evidence.sh
source "$SCRIPT_DIR/lib/trx-evidence.sh"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly REPO_ROOT
readonly PROJECT="$REPO_ROOT/tests/HVO.SkyMonitor.LogicHost.IntegrationTests/HVO.SkyMonitor.LogicHost.IntegrationTests.csproj"
readonly PROCESSING_PROJECT="$REPO_ROOT/tests/HVO.SkyMonitor.Processing.Tests/HVO.SkyMonitor.Processing.Tests.csproj"
readonly CONFIGURATION="Release"
readonly OUTPUT="$REPO_ROOT/tests/HVO.SkyMonitor.LogicHost.IntegrationTests/bin/$CONFIGURATION/net10.0"
readonly MANIFEST="$REPO_ROOT/docs/validation/logichost-ui-runtime-signals.json"
readonly baseline_root="${HVO_LOGICHOST_UI_BASELINE_ROOT:-$REPO_ROOT/TestResults/issue-107/baseline-ed7f975}"
install_browser=false

for argument in "$@"; do
    case "$argument" in
        --install-browser)
            install_browser=true
            ;;
        *)
            printf 'Usage: %s [--install-browser]\n' "${0##*/}" >&2
            exit 2
            ;;
    esac
done

cd "$REPO_ROOT"
revision="$(git rev-parse HEAD)"
readonly revision
dirty_hash="$({ git status --porcelain=v1; git diff --no-ext-diff --binary; git ls-files --others --exclude-standard -z | xargs -0 -r sha256sum; } | sha256sum | cut -d' ' -f1)"
readonly dirty_hash
readonly fingerprint="${revision:0:12}-${dirty_hash:0:12}"
run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
readonly run_id
readonly evidence_root="$REPO_ROOT/TestResults/issue-107/$fingerprint/$run_id"
mkdir -p "$evidence_root"

dotnet build "$PROJECT" --configuration "$CONFIGURATION" -warnaserror
dotnet build "$PROCESSING_PROJECT" --configuration "$CONFIGURATION" -warnaserror

if [[ "$install_browser" == true ]]; then
    PLAYWRIGHT_DRIVER_SEARCH_PATH="$OUTPUT" dotnet exec \
        --runtimeconfig "$OUTPUT/HVO.SkyMonitor.LogicHost.IntegrationTests.runtimeconfig.json" \
        --depsfile "$OUTPUT/HVO.SkyMonitor.LogicHost.IntegrationTests.deps.json" \
        "$OUTPUT/Microsoft.Playwright.dll" install chromium
fi

export HVO_ISSUE_107_REVISION="$revision"
HVO_ISSUE_107_BRANCH="$(git branch --show-current)"
export HVO_ISSUE_107_BRANCH
export HVO_ISSUE_107_DIRTY_SHA256="$dirty_hash"
export HVO_ISSUE_107_EVIDENCE_ROOT="$evidence_root"

# ORDERING CONSTRAINT — read this before making the LogicHost UI tests resemble the CameraAgent ones.
#
# The CameraAgent acceptance tests guard the pinned browser with Assert.Inconclusive and skip when it
# is absent. The tests this script runs do not guard at all: LogicHostUiBrowserAcceptanceTests goes
# straight from Playwright.CreateAsync() to Chromium.LaunchAsync(), so on a host with no usable browser
# they throw, `set -e` stops here, and the failure carries Playwright's own message naming the cause.
# That inconsistency is visible and the obvious tidy-up is to make this side match the other.
#
# That tidy-up, done on its own, reintroduces the defect this family exists to remove. An
# Assert.Inconclusive guard turns a hard failure into a skip, and a skipped MSTest exits zero, so the
# runner would go from failing closed with an accurate cause to reporting success having executed none
# of its browser cases. That is #745 exactly, recreated here while making the first runner's shape
# consistent. So the order is a constraint and not a preference: the outcome assertions below must
# exist first, and only then may a browser guard be added to the tests, if consistency is still judged
# worth having. See #749, and #745 for the original.
#
# The assertion is per invocation rather than once at the end because attribution is the point: eleven
# runs at three sites across two projects write TRX files here, and a single check after the loop would say only
# that something in the campaign proved nothing.
dotnet test "$PROJECT" \
    --no-build \
    --no-restore \
    --configuration "$CONFIGURATION" \
    --filter "FullyQualifiedName~LogicHostUiBrowserAcceptanceTests|FullyQualifiedName~LogicHostDependencyOutageAcceptanceTests" \
    --results-directory "$evidence_root" \
    --logger "trx;LogFileName=logichost-ui-107.trx" \
    --logger "console;verbosity=normal"
trx_assert_executed_and_passed "$evidence_root/logichost-ui-107.trx" "${0##*/} browser and dependency-outage acceptance" || exit 1

export HVO_ISSUE_107_EVIDENCE_SET_ROOT="$evidence_root"
export HVO_ISSUE_107_BASELINE_ROOT="$baseline_root"
for trial in 1 2 3 4 5; do
    test -s "$baseline_root/home-trial-$(printf '%02d' "$trial").json"
    test -s "$baseline_root/encoding-trial-$(printf '%02d' "$trial")/processing-performance-W1-encoded-preview-jpeg.json"
done
for trial in 1 2 3 4 5; do
    trial_root="$evidence_root/candidate/trial-$(printf '%02d' "$trial")"
    mkdir -p "$trial_root"
    mkdir -p "$trial_root/encoding"
    HVO_PERF_WORKLOAD=W1 \
    HVO_PERF_RECIPE=encoded-preview-jpeg \
    HVO_PERF_WARMUPS=5 \
    HVO_PERF_REPETITIONS=30 \
    HVO_PERF_REVISION="$revision" \
    HVO_PERF_TRIAL="$trial" \
    HVO_PERF_OUTPUT="$trial_root/encoding" \
    dotnet test "$PROCESSING_PROJECT" \
        --no-build \
        --no-restore \
        --configuration "$CONFIGURATION" \
        --filter "FullyQualifiedName~ProcessingRecipePerformanceTests.WarmSelectedRecipeEvidence" \
        --results-directory "$trial_root/encoding" \
        --logger "trx;LogFileName=logichost-ui-107-encoding.trx" \
        --logger "console;verbosity=normal"
    trx_assert_executed_and_passed \
        "$trial_root/encoding/logichost-ui-107-encoding.trx" \
        "${0##*/} encoding trial $trial" || exit 1
    HVO_ISSUE_107_TRIAL="$trial" \
    HVO_ISSUE_107_EVIDENCE_ROOT="$trial_root" \
    dotnet test "$PROJECT" \
        --no-build \
        --no-restore \
        --configuration "$CONFIGURATION" \
        --filter "FullyQualifiedName~LogicHostUiPerformanceTests.Issue107_RouteMixesMeetDeclaredConcurrentSessionLatencyAndResourceGates" \
        --results-directory "$trial_root" \
        --logger "trx;LogFileName=logichost-ui-107-performance.trx" \
        --logger "console;verbosity=normal"
    trx_assert_executed_and_passed \
        "$trial_root/logichost-ui-107-performance.trx" \
        "${0##*/} performance trial $trial" || exit 1
done

readonly evidence_files=(
    browser-acceptance.json
    logs.jsonl
    metrics.json
    traces.jsonl
    health.json
    sql.json
    map-requests.json
    cardinality-leak-scan.json
    dependency-outages.json
    environment.json
    performance-candidate-summary.json
)
for evidence_file in "${evidence_files[@]}"; do
    test -s "$evidence_root/$evidence_file"
done
for trial in 1 2 3 4 5; do
    trial_root="$evidence_root/candidate/trial-$(printf '%02d' "$trial")"
    test -s "$trial_root/performance.json"
    test -s "$trial_root/process.csv"
    test -s "$trial_root/encoding/processing-performance-W1-encoded-preview-jpeg.json"
    # The two TRX files these trials write are no longer checked for existence here. Each is now
    # asserted at its own invocation above, and a non-empty file was the weaker claim of the two: a
    # TRX recording nothing but skips is non-empty.
done
rg -q '"Passed": true' "$evidence_root/cardinality-leak-scan.json"
performance_files=(
    "$evidence_root"/candidate/trial-*/performance.json
    "$evidence_root"/candidate/trial-*/process.csv
    "$evidence_root"/candidate/trial-*/logichost-ui-107-performance.trx
    "$evidence_root"/candidate/trial-*/encoding/processing-performance-W1-encoded-preview-jpeg.json
    "$evidence_root"/candidate/trial-*/encoding/logichost-ui-107-encoding.trx
)
leak_scan_files=(
    "${evidence_files[@]/#/$evidence_root/}"
    "$evidence_root"/candidate/trial-*/performance.json
    "$evidence_root"/candidate/trial-*/process.csv
    "$evidence_root"/candidate/trial-*/encoding/processing-performance-W1-encoded-preview-jpeg.json
)
sha256sum "$MANIFEST" "${evidence_files[@]/#/$evidence_root/}" "${performance_files[@]}" > "$evidence_root/evidence.sha256"
sha256sum "$baseline_root"/home-trial-*.json \
    "$baseline_root"/encoding-trial-*/processing-performance-W1-encoded-preview-jpeg.json \
    > "$evidence_root/baseline-evidence.sha256"

if rg -n -i \
    's3://|object://|minio://|connectionstrings:|password=|downloadtoken=|invitationtoken=|operator@skymonitor\.local|19\.812345|-155\.412345|/tmp/opencode/' \
    "${leak_scan_files[@]}"; then
    printf 'Issue #107 evidence leakage scan failed.\n' >&2
    exit 1
fi

printf 'Issue #107 evidence: %s\n' "$evidence_root"
