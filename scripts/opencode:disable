#!/usr/bin/env bash
# Stop this workspace's verified in-container OpenCode tmux session.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
readonly REPO_ROOT
# shellcheck source=.devcontainer/opencode-host.conf disable=SC1091
source "$REPO_ROOT/.devcontainer/opencode-host.conf"

readonly TMUX_SESSION="${OPENCODE_TMUX_SESSION:?OPENCODE_TMUX_SESSION is required}"
readonly CONTAINER_PORT="${OPENCODE_CONTAINER_PORT:?OPENCODE_CONTAINER_PORT is required}"
readonly LOCK_FILE="${OPENCODE_DATA_DIR:-$HOME/.local/share/opencode}/server-lifecycle.lock"

if [[ ! -f /.dockerenv ]]; then
    echo "Run this script inside the devcontainer." >&2
    exit 1
fi
for command_name in flock tmux; do
    command -v "$command_name" >/dev/null 2>&1 || {
        echo "Required command '$command_name' is not installed." >&2
        exit 1
    }
done
if [[ ! "$TMUX_SESSION" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "OPENCODE_TMUX_SESSION contains unsupported characters: '$TMUX_SESSION'." >&2
    exit 1
fi

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "Another OpenCode lifecycle operation is already running." >&2
    exit 1
fi
if ! tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    echo "OpenCode is not running in internal tmux session '$TMUX_SESSION'."
    exit 0
fi
if [[ "$(tmux show-options -v -t "$TMUX_SESSION" @hvo-opencode-repo 2>/dev/null || true)" != "$REPO_ROOT" ]] \
    || [[ "$(tmux show-options -v -t "$TMUX_SESSION" @hvo-opencode-port 2>/dev/null || true)" != "$CONTAINER_PORT" ]] \
    || [[ "$(tmux display-message -p -t "$TMUX_SESSION" '#{pane_dead}' 2>/dev/null || true)" == 1 ]] \
    || [[ "$(tmux display-message -p -t "$TMUX_SESSION" '#{pane_current_command}' 2>/dev/null || true)" != opencode ]]; then
    echo "tmux session '$TMUX_SESSION' does not match this workspace's OpenCode process; leaving it running." >&2
    exit 1
fi

tmux kill-session -t "$TMUX_SESSION"
echo "Stopped OpenCode internal tmux session '$TMUX_SESSION'."
