#!/usr/bin/env bash
# opencode:disable - Disable the Tailscale proxy and stop the OpenCode server.
# Usage: ./scripts/opencode:disable

set -euo pipefail

readonly OPENCODE_PID_FILE="${HVO_OPENCODE_PID_FILE:-/tmp/skymonitor-opencode.pid}"
readonly OPENCODE_PID_METADATA_FILE="${HVO_OPENCODE_PID_METADATA_FILE:-/tmp/skymonitor-opencode.pid.meta}"
readonly OPENCODE_PROCESS_METADATA_VERSION="1"

if ! command -v tailscale >/dev/null 2>&1; then
    echo "Could not disable the Tailscale proxy because the CLI is unavailable; leaving authenticated OpenCode running." >&2
    exit 1
fi
if ! pgrep -x tailscaled >/dev/null 2>&1; then
    echo "Could not disable the Tailscale proxy because the daemon is stopped; leaving authenticated OpenCode running." >&2
    exit 1
fi

# This dedicated devcontainer node reserves its Serve config for OpenCode.
if ! sudo tailscale serve reset; then
    echo "Could not disable the Tailscale proxy; leaving authenticated OpenCode running." >&2
    exit 1
fi
echo "Disabled the Tailscale OpenCode proxy."

if [[ -f "$OPENCODE_PID_FILE" ]]; then
    opencode_pid="$(<"$OPENCODE_PID_FILE")"
    if [[ "$opencode_pid" =~ ^[0-9]+$ ]] && [[ -f "$OPENCODE_PID_METADATA_FILE" ]]; then
        opencode_command="$(ps -p "$opencode_pid" -o args= 2>/dev/null || true)"
        opencode_start_time="$(ps -p "$opencode_pid" -o lstart= 2>/dev/null || true)"
        mapfile -t opencode_metadata < "$OPENCODE_PID_METADATA_FILE"
        if kill -0 "$opencode_pid" 2>/dev/null \
            && [[ "${opencode_metadata[0]:-}" == "$OPENCODE_PROCESS_METADATA_VERSION" ]] \
            && [[ "${opencode_metadata[1]:-}" == "$opencode_start_time" ]] \
            && [[ "$opencode_command" == *"opencode serve"* ]]; then
            kill "$opencode_pid"
            echo "Stopped OpenCode (PID $opencode_pid)."
        elif kill -0 "$opencode_pid" 2>/dev/null; then
            echo "PID $opencode_pid is not OpenCode; leaving that process running." >&2
        fi
    else
        echo "Ignoring invalid OpenCode PID file." >&2
    fi
    rm -f "$OPENCODE_PID_FILE" "$OPENCODE_PID_METADATA_FILE"
else
    echo "No OpenCode process was started by ./scripts/opencode:enable."
fi

echo "Tailscale remains connected. Run 'sudo tailscale down' to disconnect it."
