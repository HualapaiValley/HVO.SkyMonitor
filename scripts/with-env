#!/usr/bin/env bash
# Run a command with ignored repository and devcontainer-local settings loaded.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$repo_root/.devcontainer/load-repo-env.sh"
runtime_data_root="$(realpath -m "${HVO_RUNTIME_DATA_ROOT:-$repo_root/data}")"

if [[ "$*" == *"HVO.SkyMonitor.LogicHost"* ]]; then
    export Catalog__Root="$runtime_data_root/catalog"
    export Catalog__RequiredPackageKind="Production"
    export "ConnectionStrings__skymonitordb=Server=${SQLSERVER_HOST:?SQLSERVER_HOST must be set},${SQLSERVER_PORT:?SQLSERVER_PORT must be set};Database=${SQLSERVER_DATABASE:?SQLSERVER_DATABASE must be set};User Id=${SQLSERVER_USER:?SQLSERVER_USER must be set};Password=${SQLSERVER_PASSWORD:?SQLSERVER_PASSWORD must be set};TrustServerCertificate=True"
    export "Redis__Configuration=${REDIS_HOST:?REDIS_HOST must be set}:${REDIS_PORT:?REDIS_PORT must be set},password=${REDIS_PASSWORD:?REDIS_PASSWORD must be set}"
    export Redis__InstanceName="skymonitor:"
    export Minio__Endpoint="${MINIO_HOST:?MINIO_HOST must be set}"
    export Minio__Port="${MINIO_API_PORT:?MINIO_API_PORT must be set}"
    export Minio__AccessKey="${MINIO_ACCESS_KEY:?MINIO_ACCESS_KEY must be set}"
    export Minio__SecretKey="${MINIO_SECRET_KEY:?MINIO_SECRET_KEY must be set}"
    export Minio__UseSsl="false"
    export Smtp__Host="${SMTP_HOST:?SMTP_HOST must be set}"
    export Smtp__Port="${SMTP_PORT:?SMTP_PORT must be set}"
    export Smtp__From="${SMTP_FROM:-no-reply@skymonitor.local}"
    export DeviceBootstrap__CentralIdentity__ServiceUrl="${CAMERA_AGENT_PUBLIC_LOGIC_BASEURL:-http://localhost:${LOGIC_HOST_HTTP_PORT:-5174}}"
    export DeviceBootstrap__CentralIdentity__Mode="ClientCredentials"
    export DeviceBootstrap__CentralIdentity__ClientCredentials__ClientId="${CAMERA_AGENT_OAUTH_CLIENT_ID:-system-camera-agent}"
    export DeviceBootstrap__CentralIdentity__ClientCredentials__ClientSecret="${CAMERA_AGENT_OAUTH_CLIENT_SECRET:?CAMERA_AGENT_OAUTH_CLIENT_SECRET must be set}"
    export DeviceBootstrap__CentralIdentity__ClientCredentials__Scopes__0="api.camera"
    export DeviceBootstrap__CentralIdentity__ClientCredentials__Scopes__1="api.frames"
    export DeviceBootstrap__CentralIdentity__ClientCredentials__Scopes__2="api.images"
fi
if [[ "$*" == *"HVO.SkyMonitor.CameraAgent"* ]]; then
    export Catalog__Root="$runtime_data_root/catalog"
    export Catalog__RequiredPackageKind="Production"
    export CameraAgent__RawIngressRoot="$runtime_data_root/agent"
    export SkyMonitor__BaseUrl="${CAMERA_AGENT_PUBLIC_LOGIC_BASEURL:-http://localhost:${LOGIC_HOST_HTTP_PORT:-5174}}"
    export CentralIdentity__ServiceUrl="$SkyMonitor__BaseUrl"
fi

exec "$@"
