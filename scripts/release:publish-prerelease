#!/usr/bin/env bash
# Publishes an integration pre-release's tested draft without moving latest (install contract section 3), as the
# pre-release workflow's publish job does. It needs gh, signed in or with GH_TOKEN (contents write), and jq.
#
#   scripts/release:publish-prerelease <tag>
#
# The latest release is read before and after the draft is published, and the two reads must agree. Each read is
# strict (scripts/lib/github-api.sh): only GitHub's own 404 means there is no latest release, and only a 200 that gh
# completed, with exactly one JSON object naming a tag, is an answer. Anything else, including a failure to reach
# GitHub, a 200 that gh still failed, or an empty, repeated or malformed body, is not an answer: before publishing it
# stops with nothing changed, and after publishing it fails the job rather than report that latest did not move.
set -euo pipefail

fail() {
    printf '::error::%s\n' "$*" >&2
    exit 1
}

[[ $# -eq 1 ]] || fail "usage: scripts/release:publish-prerelease <tag>"
tag="$1"
[[ "$tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-dev\.(0|[1-9][0-9]*)$ ]] ||
    fail "$tag is not an integration pre-release tag, vX.Y.Z-dev.N."
repository="${GITHUB_REPOSITORY:-HualapaiValley/HVO.SkyMonitor}"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/lib/github-api.sh
source "$repo_root/scripts/lib/github-api.sh"
errors="$(mktemp)"
trap 'rm -f "$errors"' EXIT

# The latest release's tag, or "none" when GitHub answers its own 404.
latest() {
    local body read_status=0
    body="$(github_api_read --absent-ok "the latest release" 'type == "object"' "repos/$repository/releases/latest")" ||
        read_status=$?
    case "$read_status" in
        0) ;;
        "$GITHUB_API_ABSENT")
            printf 'none\n'
            return 0
            ;;
        *) return 1 ;;
    esac
    jq -er '.tag_name | select(type == "string" and length > 0)' <<<"$body" 2>/dev/null ||
        fail "GitHub's latest release names no tag."
}

before="$(latest)" || exit 1
gh release edit "$tag" --repo "$repository" --draft=false --prerelease --latest=false >/dev/null 2>"$errors" ||
    fail "cannot publish $tag: $(tr '\n' ' ' <"$errors")"
after="$(latest)" ||
    fail "$tag is published, but the latest release cannot be read back to show it did not move; check it by hand."
[[ "$after" == "$before" ]] || fail "Publishing $tag moved the latest release from $before to $after."
printf 'Published %s as a pre-release; the latest release is still %s.\n' "$tag" "$after"
