#!/usr/bin/env bash
# Checks a release's CameraAgent image, in the OCI archive scripts/release:assets built it into (--image-oci), against the
# release.json written from that archive (install contract sections 1, 4 and 6). The archive must hold the image
# release.json names, with an image for each of its platforms and no other, and each must be labelled as the release's
# CameraAgent: its version and commit, its created time (org.opencontainers.image.created, release.json's created) and
# its state contract (io.hvo.skymonitor.state-contracts, release.json's stateContracts.cameraAgent).
#
#   scripts/release:check-image-labels <oci-archive> <release.json>
#
# scripts/release:assets runs it on what it built, and the pre-release workflow on the files it is about to publish.
# Needs tar, jq and sha256sum.
#
# Every value is compared whole, as the JSON gives it. release.json's values are checked first, each anchored on the
# whole string (\A and \z: jq's $ also matches before a final LF), and every label is compared with release.json inside
# jq, never through a shell copy, which would drop a trailing LF and let a label that differs from release.json pass.
set -euo pipefail

fail() {
    printf 'release:check-image-labels: %s\n' "$*" >&2
    exit 1
}

[[ $# -eq 2 ]] || { sed -n '8p' "${BASH_SOURCE[0]}" | sed 's/^# *//' >&2; exit 2; }
archive="$1" manifest="$2"
[[ -f "$archive" ]] || fail "$archive is not a file."
[[ -f "$manifest" ]] || fail "$manifest is not a file."

# A string that is wholly one match of a pattern; a canonical RFC 3339 UTC time to the second, which reads back
# unchanged (so 2026-02-30T18:00:00Z is refused); and a state contract: an object of stores, each with the schema it
# writes and the schemas it reads, whole numbers from 1 with min <= writes <= max.
definitions='
    def whole($pattern): type == "string" and test("\\A(?:" + $pattern + ")\\z");
    def utc_time: whole("[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z")
        and ((try (fromdateiso8601 | todateiso8601) catch null) == .);
    def schema: type == "number" and . == floor and . >= 1;
    def state_contract: type == "object" and all(.[]; type == "object" and keys == ["reads", "writes"] and (.writes | schema)
        and (.reads | type == "object" and keys == ["max", "min"] and (.min | schema) and (.max | schema))
        and .reads.min <= .writes and .writes <= .reads.max);'

# A release.json value that the filter $1 admits whole, so the shell's copy of it is exact.
release_field() {
    jq -er "$definitions $1" "$manifest" 2>/dev/null || fail "$manifest has no $2."
}
identifier='(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)'
version="$(release_field '.version | select(whole("(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-'"$identifier"'(\\.'"$identifier"')*)?"))' \
    'version, a release version such as 1.2.0-dev.3')"
commit="$(release_field '.commit | select(whole("[0-9a-f]{40}"))' 'commit, a 40-character lowercase commit ID')"
created="$(release_field '.created | select(utc_time)' 'created time, an RFC 3339 UTC time such as 2026-10-17T18:00:00Z')"
digest="$(release_field '.images.cameraAgent.digest | select(whole("sha256:[0-9a-f]{64}"))' 'cameraAgent image')"
platforms="$(release_field '.images.cameraAgent.platforms
    | select(type == "array" and length > 0 and all(whole("linux/amd64|linux/arm64")) and (unique | length) == length)
    | sort | join(",")' 'cameraAgent image platforms, linux/amd64 and linux/arm64 or one of them, each once')"
release_field '.stateContracts.cameraAgent | objects | "declared"' stateContracts.cameraAgent >/dev/null
jq -e "$definitions .stateContracts.cameraAgent | state_contract" "$manifest" >/dev/null 2>&1 ||
    fail "$manifest's stateContracts.cameraAgent is not a state contract: an object of stores, each with whole-number writes and reads.min and reads.max from 1, with min <= writes <= max."

work="$(mktemp -d "${TMPDIR:-/tmp}/hvo-check-image-labels.XXXXXX")"
trap 'rm -rf "$work"' EXIT
tar -xf "$archive" -C "$work" index.json blobs 2>/dev/null || fail "$archive is not an OCI archive."

# A blob's bytes, which must be the content its digest names.
blob() {
    local digest="$1" file
    [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || fail "$archive names a blob '$digest', which is not a sha256 digest."
    file="$work/blobs/sha256/${digest#sha256:}"
    [[ -f "$file" && ! -L "$file" ]] || fail "$archive has no blob $digest."
    [[ "$(sha256sum "$file" | cut -d ' ' -f 1)" == "${digest#sha256:}" ]] || fail "$archive's blob $digest is not the content $digest names."
    cat "$file"
}

layout="$work/index.json"
jq -e '.manifests | type == "array" and length == 1' "$layout" >/dev/null 2>&1 || fail "$archive does not hold exactly one image."
jq -e --arg digest "$digest" '.manifests[0].digest == $digest' "$layout" >/dev/null 2>&1 ||
    fail "$archive holds $(jq -c '.manifests[0].digest' "$layout"), not the image $digest that $manifest names."
kind="$(jq -er '.manifests[0].mediaType
    | if . == "application/vnd.oci.image.index.v1+json" or . == "application/vnd.docker.distribution.manifest.list.v2+json" then "index"
      elif . == "application/vnd.oci.image.manifest.v1+json" or . == "application/vnd.docker.distribution.manifest.v2+json" then "manifest"
      else empty end' "$layout" 2>/dev/null)" ||
    fail "$digest has the media type $(jq -c '.manifests[0].mediaType' "$layout"), which is neither an image nor an index."
if [[ "$kind" == index ]]; then
    index="$(blob "$digest")" || exit 1
    entries="$(jq -er '[.manifests[] | .digest] | select(all(type == "string" and test("\\Asha256:[0-9a-f]{64}\\z"))) | join(" ")' \
        <<<"$index" 2>/dev/null)" || fail "the image index $digest cannot be read."
    read -ra image_manifests <<<"$entries"
else
    image_manifests=("$digest")
fi

config=""
# Whether the configuration's labels ($labels) meet the jq condition $1, given release.json as $release.
labels_are() {
    jq -e --slurpfile release "$manifest" "(.config.Labels // {}) as \$labels | \$release[0] as \$release | $1" \
        <<<"$config" >/dev/null 2>&1
}
# A label as its JSON string, so that a trailing LF shows, or "absent".
shown() {
    jq -r --arg name "$1" '.config.Labels[$name] | if . == null then "absent" else tojson end' <<<"$config" 2>/dev/null ||
        printf 'unreadable'
}
checked=()
for image_manifest in ${image_manifests[@]+"${image_manifests[@]}"}; do
    image="$(blob "$image_manifest")" || exit 1
    config_digest="$(jq -er '.config.digest | select(type == "string" and test("\\Asha256:[0-9a-f]{64}\\z"))' <<<"$image" 2>/dev/null)" ||
        fail "the manifest $image_manifest names no configuration."
    config="$(blob "$config_digest")" || exit 1
    platform="$(jq -er '"\(.os)/\(.architecture)" | select(test("\\A[a-z0-9]+/[a-z0-9]+\\z"))' <<<"$config" 2>/dev/null)" ||
        fail "the configuration $config_digest cannot be read."

    labels_are '$labels["io.hvo.skymonitor.component"] == "CameraAgent"
        and $labels["org.opencontainers.image.version"] == $release.version
        and $labels["org.opencontainers.image.revision"] == $release.commit' ||
        fail "$platform: the image is not labelled as CameraAgent $version from commit $commit."
    labels_are '$labels["org.opencontainers.image.created"] == $release.created' ||
        fail "$platform: its created label (org.opencontainers.image.created) is $(shown org.opencontainers.image.created), not release.json's created time $created."
    # The state contract label is JSON text with nothing around it, naming release.json's object.
    labels_are '$labels["io.hvo.skymonitor.state-contracts"]
        | type == "string" and test("\\A\\S") and test("\\S\\z") and fromjson == $release.stateContracts.cameraAgent' ||
        fail "$platform: its state contract label (io.hvo.skymonitor.state-contracts) is not release.json's stateContracts.cameraAgent."
    printf '%s: CameraAgent %s, commit %s, created %s\n' "$platform" "$version" "$commit" "$created"
    checked+=("$platform")
done

held="$(printf '%s\n' ${checked[@]+"${checked[@]}"} | sort | paste -sd, -)"
[[ "$held" == "$platforms" ]] || fail "$archive holds images for ${held:-no platform}, not $platforms."
