#!/usr/bin/env bash
# Build and run the pinned, isolated Stellarium geometry oracle.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly REPO_ROOT
readonly IMAGE="${STELLARIUM_IMAGE:-hvo-stellarium-validation:24.4-noble}"
readonly RESULTS="$REPO_ROOT/TestResults/stellarium"

if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is required for pinned Stellarium validation." >&2
    exit 2
fi

mkdir -p "$RESULTS"

docker build \
    --platform linux/amd64 \
    --file "$REPO_ROOT/docker/stellarium/Dockerfile" \
    --tag "$IMAGE" \
    "$REPO_ROOT"

docker run --rm \
    --platform linux/amd64 \
    --network none \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --user "$(id -u):$(id -g)" \
    --tmpfs /tmp:rw,nosuid,nodev,noexec,size=512m \
    --mount "type=bind,source=$RESULTS,target=/results" \
    "$IMAGE"
