restore_finalized_destinations() {
  chmod -R u+w "$final_instance" "$final_catalog" 2>/dev/null || true
  rm -rf -- "$final_instance" "$final_catalog"
  cp -a "$TEMP_DIR/final-instance.valid" "$final_instance"
  cp -a "$TEMP_DIR/final-catalog.valid" "$final_catalog"
}
for finalized_drift in missing-instance missing-config corrupt-state corrupt-manifest corrupt-binding missing-catalog corrupt-catalog; do
  case "$finalized_drift" in
    missing-instance) chmod -R u+w "$final_instance"; rm -rf "$final_instance" ;;
    missing-config) chmod -R u+w "$final_instance/config"; rm -rf "$final_instance/config" ;;
    corrupt-state) printf 'corrupt\n' >> "$final_instance/state/capture-sequence" ;;
    corrupt-manifest) jq '.instanceId="aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"' "$final_instance/instance-manifest.json" > "$final_instance/instance-manifest.json.changed"; mv "$final_instance/instance-manifest.json.changed" "$final_instance/instance-manifest.json"; chmod 600 "$final_instance/instance-manifest.json" ;;
    corrupt-binding) jq '.configuredIdentity="corrupt"' "$final_instance/application-identity.json" > "$final_instance/application-identity.json.changed"; mv "$final_instance/application-identity.json.changed" "$final_instance/application-identity.json"; chmod 600 "$final_instance/application-identity.json" ;;
    missing-catalog) chmod -R u+w "$final_catalog"; rm -rf "$final_catalog" ;;
    corrupt-catalog) chmod u+w "$final_catalog/versions/fixture-v1/hyg_v42.sqlite"; printf 'corrupt\n' >> "$final_catalog/versions/fixture-v1/hyg_v42.sqlite" ;;
  esac
  if "$REPO_ROOT/scripts/deploy:migrate-product-layout" verify "${args[@]}" >/dev/null 2>&1; then
    printf 'Finalized migration verify accepted destination drift: %s\n' "$finalized_drift" >&2; exit 106
  fi
  if "$REPO_ROOT/scripts/deploy:migrate-product-layout" finalize "${args[@]}" --cutover-evidence "$cutover" >/dev/null 2>&1; then
    printf 'Finalized migration finalize accepted destination drift: %s\n' "$finalized_drift" >&2; exit 107
  fi
  restore_finalized_destinations
done
"$REPO_ROOT/scripts/deploy:migrate-product-layout" verify "${args[@]}"
"$REPO_ROOT/scripts/deploy:migrate-product-layout" finalize "${args[@]}" --cutover-evidence "$cutover" >/dev/null
test "$(readlink "$legacy/data/catalog/current")" = "$legacy_catalog_pointer"
test "$(sha256sum "$legacy/data/catalog/versions/fixture-v1/hyg_v42.sqlite" | cut -d' ' -f1)" = "$legacy_catalog_sha"
cp "$cutover" "$cutover.valid"
jq '.captureSequenceAfter=45' "$cutover.valid" > "$cutover"; chmod 600 "$cutover"
if "$REPO_ROOT/scripts/deploy:migrate-product-layout" finalize "${args[@]}" --cutover-evidence "$cutover" >/dev/null 2>&1; then exit 105; fi
mv "$cutover.valid" "$cutover"; chmod 600 "$cutover"
"$REPO_ROOT/scripts/deploy:migrate-product-layout" finalize "${args[@]}" --cutover-evidence "$cutover" >/dev/null
test "$(readlink "$legacy/data/catalog/current")" = "$legacy_catalog_pointer"
test "$(sha256sum "$legacy/data/catalog/versions/fixture-v1/hyg_v42.sqlite" | cut -d' ' -f1)" = "$legacy_catalog_sha"
if "$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${args[@]}" >/dev/null 2>&1; then
    printf 'Finalized migration unexpectedly rolled back.\n' >&2; exit 1
fi

