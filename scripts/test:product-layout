#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
umask 077

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TEMP_DIR="$(mktemp -d -t hvo-product-layout.XXXXXX)"
cleanup() {
  [[ -z "${sibling_consumer_pid:-}" ]] || kill "$sibling_consumer_pid" 2>/dev/null || true
  [[ -z "${catalog_lock_holder_pid:-}" ]] || kill "$catalog_lock_holder_pid" 2>/dev/null || true
  [[ -z "${catalog_migration_pid:-}" ]] || kill "$catalog_migration_pid" 2>/dev/null || true
  [[ -z "${destination_publisher_pid:-}" ]] || kill "$destination_publisher_pid" 2>/dev/null || true
  [[ -z "${stage_migration_pid:-}" ]] || kill "$stage_migration_pid" 2>/dev/null || true
  [[ -z "${rollback_migration_pid:-}" ]] || kill "$rollback_migration_pid" 2>/dev/null || true
  [[ -z "${migration_replacement_pid:-}" ]] || kill -CONT "$migration_replacement_pid" 2>/dev/null || true
  [[ -z "${migration_replacement_pid:-}" ]] || kill "$migration_replacement_pid" 2>/dev/null || true
  chmod -R u+w "$TEMP_DIR" 2>/dev/null || true
  rm -rf "$TEMP_DIR"
}
trap cleanup EXIT

# shellcheck source=scripts/deploy/common.sh
. "$REPO_ROOT/scripts/deploy/common.sh"
# shellcheck source=scripts/deploy/product-layout.sh
. "$REPO_ROOT/scripts/deploy/product-layout.sh"

product="$TEMP_DIR/skymonitor"
inventory="$TEMP_DIR/inventory.json"
jq -n --arg product "$product" '{
  schemaVersion:8,installationId:"test-installation",productRoot:$product,source:{revision:("a"*40)},
  logicHost:{name:"logic",friendlyName:"Logic",instanceId:"11111111-1111-4111-8111-111111111111",applicationIdentity:"logic-app",
    catalogId:"shared",cookieName:"hvo.skymonitor.11111111111141118111111111111111",runtimeRoot:($product+"/logichosts/11111111-1111-4111-8111-111111111111"),ports:[5174]},
  cameraAgents:[
    {name:"east",friendlyName:"East",instanceId:"22222222-2222-4222-8222-222222222222",applicationIdentity:"agent-east",
      catalogId:"shared",cookieName:"hvo.skymonitor.22222222222242228222222222222222",runtimeRoot:($product+"/cameraagents/22222222-2222-4222-8222-222222222222"),ports:[5130]},
    {name:"west",friendlyName:"West",instanceId:"33333333-3333-4333-8333-333333333333",applicationIdentity:"agent-west",
      catalogId:"alternate",cookieName:"hvo.skymonitor.33333333333343338333333333333333",runtimeRoot:($product+"/cameraagents/33333333-3333-4333-8333-333333333333"),ports:[5131]}],
  catalogs:[
    {catalogId:"shared",schemaVersion:"2",preprocessingVersion:"3",installRoot:($product+"/catalogs/shared")},
    {catalogId:"alternate",schemaVersion:"2",preprocessingVersion:"3",installRoot:($product+"/catalogs/alternate")}],
  deployment:{resources:{project:"test"}}
}' > "$inventory"

deploy_validate_product_layout "$inventory" isolated
test "$(deploy_catalog_root "$inventory" "$(jq -c '.cameraAgents[0]' "$inventory")")" = "$product/catalogs/shared"
test "$(deploy_catalog_root "$inventory" "$(jq -c '.cameraAgents[1]' "$inventory")")" = "$product/catalogs/alternate"

# Friendly names are metadata: changing one cannot change the UUID path, project, or manifest identity.
before_root="$(jq -r '.cameraAgents[0].runtimeRoot' "$inventory")"
before_project="$(deploy_compose_project "$inventory" "$(jq -c '.cameraAgents[0]' "$inventory")")"
before_manifest="$(deploy_instance_manifest_json "$inventory" "$(jq -c '.cameraAgents[0]' "$inventory")" cameraAgent agent-east)"
jq '.cameraAgents[0].friendlyName="Renamed camera"' "$inventory" > "$TEMP_DIR/renamed.json"
deploy_validate_product_layout "$TEMP_DIR/renamed.json" isolated
test "$(jq -r '.cameraAgents[0].runtimeRoot' "$TEMP_DIR/renamed.json")" = "$before_root"
test "$(deploy_compose_project "$TEMP_DIR/renamed.json" "$(jq -c '.cameraAgents[0]' "$TEMP_DIR/renamed.json")")" = "$before_project"
test "$(deploy_instance_manifest_json "$TEMP_DIR/renamed.json" "$(jq -c '.cameraAgents[0]' "$TEMP_DIR/renamed.json")" cameraAgent agent-east)" = "$before_manifest"

reject_layout() {
    if deploy_validate_product_layout "$1" "${3:-isolated}" >/dev/null 2>&1; then
        printf 'Invalid product layout was accepted: %s\n' "$2" >&2
        exit 1
    fi
}
jq '.cameraAgents[1].instanceId=.cameraAgents[0].instanceId' "$inventory" > "$TEMP_DIR/invalid.json"; reject_layout "$TEMP_DIR/invalid.json" uuid-collision
jq '.cameraAgents[1].runtimeRoot=.cameraAgents[0].runtimeRoot' "$inventory" > "$TEMP_DIR/invalid.json"; reject_layout "$TEMP_DIR/invalid.json" mutable-root-collision
jq '.cameraAgents[1].catalogId="missing"' "$inventory" > "$TEMP_DIR/invalid.json"; reject_layout "$TEMP_DIR/invalid.json" unknown-catalog
jq '.catalogs[1].catalogId="Shared"' "$inventory" > "$TEMP_DIR/invalid.json"; reject_layout "$TEMP_DIR/invalid.json" invalid-catalog-id
jq '.catalogs[1].catalogId=("a" * 33) | .cameraAgents[1].catalogId=("a" * 33) | .productRoot as $root | .catalogs[1].installRoot=($root+"/catalogs/"+.catalogs[1].catalogId)' "$inventory" > "$TEMP_DIR/invalid.json"; reject_layout "$TEMP_DIR/invalid.json" overlong-catalog-id
jq '.catalogs[1].installRoot=.cameraAgents[0].runtimeRoot+"/catalog"' "$inventory" > "$TEMP_DIR/invalid.json"; reject_layout "$TEMP_DIR/invalid.json" unsafe-ancestry
jq '.logicHost.runtimeRoot="/var/lib/hvo/skymonitor/logichosts/11111111-1111-4111-8111-111111111111" |
  .cameraAgents[0].runtimeRoot="/var/lib/hvo/skymonitor/cameraagents/22222222-2222-4222-8222-222222222222" |
  .cameraAgents[1].runtimeRoot="/var/lib/hvo/skymonitor/cameraagents/33333333-3333-4333-8333-333333333333" |
  .productRoot="/var/lib/hvo/skymonitor" | .productRoot as $root | .catalogs |= map(.installRoot=($root+"/catalogs/"+.catalogId))' "$inventory" > "$TEMP_DIR/persistent.json"
deploy_validate_product_layout "$TEMP_DIR/persistent.json" persistent
jq '.productRoot="/opt/not-skymonitor" | .productRoot as $root |
  .logicHost.runtimeRoot=($root+"/logichosts/"+.logicHost.instanceId) |
  .cameraAgents |= map(.runtimeRoot=($root+"/cameraagents/"+.instanceId)) |
  .catalogs |= map(.installRoot=($root+"/catalogs/"+.catalogId))' "$inventory" > "$TEMP_DIR/noncanonical-persistent.json"
reject_layout "$TEMP_DIR/noncanonical-persistent.json" persistent-root persistent

create_v2_fixture_catalog() {
  local catalog_root="$1" catalog_id="$2" package_version="$3" version_root sha length
  version_root="$catalog_root/versions/$package_version"
  mkdir -p "$version_root"
  cp "$REPO_ROOT/tests/fixtures/catalog/hyg-v42-bright-stars.sqlite" "$version_root/hyg_v42.sqlite"
  sha="$(sha256sum "$version_root/hyg_v42.sqlite" | cut -d' ' -f1)"; length="$(wc -c < "$version_root/hyg_v42.sqlite")"
  jq -n --arg id "$catalog_id" --arg package "$package_version" --arg sha "$sha" --argjson length "$length" \
    '{manifestVersion:2,package:{kind:"fixture",version:$package},catalog:{id:$id,name:"HYG bright-star test fixture",version:"4.2-fixture.1"},
      schemaVersion:"2",preprocessingVersion:"3",database:{relativePath:"hyg_v42.sqlite",sha256:$sha,length:$length,rowCount:9}}' \
    > "$version_root/manifest.json"
  chmod 444 "$version_root/hyg_v42.sqlite" "$version_root/manifest.json"; chmod 555 "$version_root"
  ln -s "versions/$package_version" "$catalog_root/current"
}

create_catalog_lock() {
  local catalog_root="$1"
  : > "$catalog_root/.catalog.lock"
  chmod 600 "$catalog_root/.catalog.lock"
}

write_catalog_lineage() {
  local catalog_root="$1" catalog_id="$2" package_kind="$3"
  jq -cn --arg id "$catalog_id" --arg kind "$package_kind" \
    --arg packageLineage "hyg-v42-${package_kind}-p3-s2" \
    '{schemaVersion:1,catalogId:$id,packageKind:$kind,packageLineage:$packageLineage}' \
    > "$catalog_root/.catalog-lineage.json"
  chmod 600 "$catalog_root/.catalog-lineage.json"
}

catalog_control_fingerprint() {
  local catalog_root="$1"
  sha256sum "$catalog_root/.catalog.lock" "$catalog_root/.catalog-lineage.json"
  stat -c '%n|%u:%g:%h:%a' "$catalog_root/.catalog.lock" "$catalog_root/.catalog-lineage.json"
}

wait_for_process_marker() {
  local pid="$1" marker="$2"
  while [[ ! -e "$marker" ]]; do sleep 0.01; kill -0 "$pid"; done
}

mkdir -m 700 "$TEMP_DIR/fake-lock-bin"
real_flock="$(command -v flock)"
cat > "$TEMP_DIR/fake-lock-bin/flock" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
"$HVO_REAL_FLOCK" "$@"
fd="${*: -1}"
if [[ "$fd" =~ ^[0-9]+$ && "$(readlink "/proc/$$/fd/$fd")" == "$HVO_MIGRATION_LOCK_PATH" ]]; then
  : > "$HVO_MIGRATION_LOCK_MARKER"
  while [[ ! -e "$HVO_MIGRATION_LOCK_RELEASE" ]]; do sleep 0.01; done
fi
EOF
chmod 700 "$TEMP_DIR/fake-lock-bin/flock"

replace_acquired_catalog_lock() {
  local pid="$1" lock_path="$2" marker="$3" release="$4" original
  original="$lock_path.replaced-original"
  wait_for_process_marker "$pid" "$marker"
  mv -T -- "$lock_path" "$original"
  create_catalog_lock "$(dirname -- "$lock_path")"
  : > "$release"
  if wait "$pid"; then
    printf 'Migration accepted a replaced acquired catalog lock: %s\n' "$lock_path" >&2
    exit 141
  fi
  rm -f -- "$lock_path"
  mv -T -- "$original" "$lock_path"
}

# Exercise guarded singular-layout migration only beneath a disposable root.
legacy="$TEMP_DIR/legacy"; migrated="$TEMP_DIR/migrated/skymonitor"; evidence="$TEMP_DIR/migration.json"
mkdir -p "$legacy/config/cameraagent" "$legacy/data/agent/identity" "$legacy/data/agent/provisioning"
printf 'owner-db\n' > "$legacy/config/cameraagent/identity.db"
printf '42\n' > "$legacy/data/agent/capture-sequence"
printf 'protected-location\n' > "$legacy/data/agent/provisioning/location.protected"
create_v2_fixture_catalog "$legacy/data/catalog" hyg-v42-production fixture-v1
printf 'sibling-preserved\n' > "$legacy/data/sibling"
instance=44444444-4444-4444-8444-444444444444
args=(--legacy-root "$legacy" --product-root "$migrated" --instance-id "$instance" --application-id agent-legacy --catalog-id hyg-v42-production --evidence "$evidence")
# Discovery, ordering, metadata, and hashing failures cannot publish a truncated source snapshot.
for snapshot_failure in snapshot-root-stat snapshot-find snapshot-sort snapshot-entry-device-stat snapshot-entry-stat snapshot-file-hash snapshot-output; do
  snapshot_legacy="$TEMP_DIR/snapshot-$snapshot_failure-legacy"
  snapshot_product="$TEMP_DIR/snapshot-$snapshot_failure-product"
  snapshot_evidence="$TEMP_DIR/snapshot-$snapshot_failure.json"
  mkdir -m 700 "$snapshot_legacy"
  cp -a "$legacy/config" "$legacy/data" "$snapshot_legacy/"
  snapshot_args=(--legacy-root "$snapshot_legacy" --product-root "$snapshot_product" --instance-id "$instance" \
    --application-id agent-legacy --catalog-id hyg-v42-production --evidence "$snapshot_evidence")
  if HVO_MIGRATION_TEST_MODE=true HVO_MIGRATION_TEST_FAIL_COMMAND_AT="$snapshot_failure" \
    "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${snapshot_args[@]}" >/dev/null 2>&1; then
    printf 'Migration accepted failed snapshot command: %s\n' "$snapshot_failure" >&2
    exit 150
  fi
  test ! -e "$snapshot_evidence"
  test ! -e "$snapshot_evidence.config.snapshot"
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${snapshot_args[@]}" >/dev/null
done
# Catalog snapshot transform failures remain failures under conditional invocation and cannot publish evidence.
for transform_failure in revalidate-catalog-expected-filter revalidate-catalog-actual-filter revalidate-catalog-cmp \
  verify-catalog-expected-filter verify-catalog-actual-filter verify-catalog-expected-content \
  verify-catalog-actual-content verify-catalog-cmp; do
  transform_legacy="$TEMP_DIR/transform-$transform_failure-legacy"
  transform_product="$TEMP_DIR/transform-$transform_failure-product"
  transform_evidence="$TEMP_DIR/transform-$transform_failure.json"
  mkdir -m 700 "$transform_legacy"
  cp -a "$legacy/config" "$legacy/data" "$transform_legacy/"
  transform_args=(--legacy-root "$transform_legacy" --product-root "$transform_product" --instance-id "$instance" \
    --application-id agent-legacy --catalog-id hyg-v42-production --evidence "$transform_evidence")
  if HVO_MIGRATION_TEST_MODE=true HVO_MIGRATION_TEST_FAIL_COMMAND_AT="$transform_failure" \
    "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${transform_args[@]}" >/dev/null 2>&1; then
    printf 'Migration accepted failed catalog snapshot transform: %s\n' "$transform_failure" >&2
    exit 149
  fi
  test ! -e "$transform_evidence"
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${transform_args[@]}" >/dev/null
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" verify "${transform_args[@]}" >/dev/null
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${transform_args[@]}" >/dev/null
done
# Every durable action transition revalidates the top-level migration lock and remains recoverable after replacement.
for replacement_case in apply-evidence verify-complete rollback-deletion rollback-destructive rollback-cleanup \
  finalize-intent finalize-pending finalize-final; do
  case "$replacement_case" in
    apply-evidence) replacement_action=apply; action_barrier=apply-evidence-publication ;;
    verify-complete) replacement_action=verify; action_barrier=verify-complete ;;
    rollback-deletion) replacement_action=rollback; action_barrier=rollback-deletion-intent-publication ;;
    rollback-destructive) replacement_action=rollback; action_barrier=migration-destructive-entry ;;
    rollback-cleanup) replacement_action=rollback; action_barrier=rollback-cleanup-intent-publication ;;
    finalize-intent) replacement_action=finalize; action_barrier=finalize-intent-publication ;;
    finalize-pending) replacement_action=finalize; action_barrier=finalize-pending-evidence-publication ;;
    finalize-final) replacement_action=finalize; action_barrier=finalize-final-evidence-publication ;;
  esac
  action_legacy="$TEMP_DIR/action-lock-$replacement_case-legacy"
  action_product="$TEMP_DIR/action-lock-$replacement_case-product"
  action_evidence="$TEMP_DIR/action-lock-$replacement_case.json"
  mkdir -m 700 "$action_legacy"
  cp -a "$legacy/config" "$legacy/data" "$action_legacy/"
  action_args=(--legacy-root "$action_legacy" --product-root "$action_product" --instance-id "$instance" \
    --application-id agent-legacy --catalog-id hyg-v42-production --evidence "$action_evidence")
  if [[ "$replacement_action" != apply ]]; then
    "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${action_args[@]}" >/dev/null
  fi
  action_cutover=()
  if [[ "$replacement_action" == finalize ]]; then
    printf '43\n' > "$action_product/cameraagents/$instance/state/capture-sequence"
    action_cutover_path="$TEMP_DIR/action-lock-finalize-cutover.json"
    jq -n --arg instance "$instance" '{schemaVersion:1,instanceId:$instance,applicationIdentity:"agent-legacy",imageIdentityVerified:true,
      healthVerified:true,loginVerified:true,provisioningVerified:true,dataProtectionVerified:true,locationHistoryVerified:true,
      artifactChecksumsVerified:true,rollbackRehearsed:true,captureSequenceBefore:42,captureSequenceAfter:43}' > "$action_cutover_path"
    chmod 600 "$action_cutover_path"
    action_cutover=(--cutover-evidence "$action_cutover_path")
  fi
  if [[ "$replacement_case" == rollback-cleanup ]]; then
    if DEPLOY_MIGRATION_FAILPOINT=after-delete-rollback-instance-config \
      "$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${action_args[@]}" >/dev/null 2>&1; then exit 147; fi
  elif [[ "$replacement_case" == finalize-final ]]; then
    if DEPLOY_MIGRATION_FAILPOINT=after-finalized-evidence \
      "$REPO_ROOT/scripts/deploy:migrate-product-layout" finalize "${action_args[@]}" "${action_cutover[@]}" >/dev/null 2>&1; then exit 148; fi
  fi
  action_marker="$TEMP_DIR/action-lock-$replacement_case.marker"
  DEPLOY_MIGRATION_TEST_LOCK_BARRIER="$action_barrier" DEPLOY_MIGRATION_TEST_LOCK_MARKER="$action_marker" \
    "$REPO_ROOT/scripts/deploy:migrate-product-layout" "$replacement_action" "${action_args[@]}" "${action_cutover[@]}" \
    >/dev/null 2>&1 &
  migration_replacement_pid=$!
  wait_for_process_marker "$migration_replacement_pid" "$action_marker"
  action_stopped_pid="$(<"$action_marker")"
  action_lock="${action_product}.migration.lock"
  mv -T -- "$action_lock" "$action_lock.original"
  : > "$action_lock"; chmod 600 "$action_lock"
  kill -CONT "$action_stopped_pid"
  if wait "$migration_replacement_pid"; then
    printf 'Migration transition accepted a replaced top-level lock: %s\n' "$replacement_case" >&2
    exit 146
  fi
  migration_replacement_pid=
  rm -f -- "$action_lock"; mv -T -- "$action_lock.original" "$action_lock"
  case "$replacement_case" in
    apply-evidence) test ! -e "$action_evidence"; test -e "$action_product/cameraagents/$instance" ;;
    verify-complete|rollback-deletion|rollback-destructive) test -e "$action_evidence"; test -e "$action_product/cameraagents/$instance" ;;
    rollback-cleanup) test -e "$action_evidence.rollback-intent.json"; test ! -e "$action_product/cameraagents/$instance" ;;
    finalize-intent) test -d "$action_legacy/config/cameraagent"; test -d "$action_legacy/data/agent" ;;
    finalize-pending) test -d "$action_legacy/config/cameraagent.hvo-migration-$instance"; test -d "$action_legacy/data/agent.hvo-migration-$instance" ;;
    finalize-final) jq -e '.status == "finalized-removal-pending"' "$action_evidence" >/dev/null ;;
  esac
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" "$replacement_action" "${action_args[@]}" "${action_cutover[@]}" >/dev/null
done
# Legacy control files are authenticated independently from payload equivalence and remain untouched.
for legacy_control_case in lock-only lock-and-lineage; do
  control_legacy="$TEMP_DIR/control-$legacy_control_case-legacy"
  control_product="$TEMP_DIR/control-$legacy_control_case-product"
  control_evidence="$TEMP_DIR/control-$legacy_control_case.json"
  mkdir -m 700 "$control_legacy"
  cp -a "$legacy/config" "$legacy/data" "$control_legacy/"
  control_catalog="$control_legacy/data/catalog"
  create_catalog_lock "$control_catalog"
  if [[ "$legacy_control_case" == lock-and-lineage ]]; then
    write_catalog_lineage "$control_catalog" hyg-v42-production fixture
  fi
  control_before="$(sha256sum "$control_catalog/.catalog.lock")|$(stat -c '%u:%g:%h:%a' "$control_catalog/.catalog.lock")"
  if [[ -e "$control_catalog/.catalog-lineage.json" ]]; then
    control_before+="|$(sha256sum "$control_catalog/.catalog-lineage.json")|$(stat -c '%u:%g:%h:%a' "$control_catalog/.catalog-lineage.json")"
  fi
  control_args=(--legacy-root "$control_legacy" --product-root "$control_product" --instance-id "$instance" \
    --application-id agent-legacy --catalog-id hyg-v42-production --evidence "$control_evidence")
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${control_args[@]}" >/dev/null
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" verify "${control_args[@]}" >/dev/null
  migrated_control_catalog="$control_product/catalogs/hyg-v42-production"
  test -f "$migrated_control_catalog/.catalog.lock"
  test "$(stat -c '%d:%i' "$control_catalog/.catalog.lock")" != "$(stat -c '%d:%i' "$migrated_control_catalog/.catalog.lock")"
  [[ "$legacy_control_case" != lock-and-lineage ]] || test -f "$migrated_control_catalog/.catalog-lineage.json"
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${control_args[@]}" >/dev/null
  control_after="$(sha256sum "$control_catalog/.catalog.lock")|$(stat -c '%u:%g:%h:%a' "$control_catalog/.catalog.lock")"
  if [[ -e "$control_catalog/.catalog-lineage.json" ]]; then
    control_after+="|$(sha256sum "$control_catalog/.catalog-lineage.json")|$(stat -c '%u:%g:%h:%a' "$control_catalog/.catalog-lineage.json")"
  fi
  test "$control_after" = "$control_before"
  test -f "$migrated_control_catalog/.catalog.lock"
  test "$(sha256sum "$migrated_control_catalog/versions/fixture-v1/hyg_v42.sqlite" | cut -d' ' -f1)" = \
    "$(sha256sum "$control_catalog/versions/fixture-v1/hyg_v42.sqlite" | cut -d' ' -f1)"
done
# Source, stage, and published lock descriptors remain bound to the pathname acquired under flock.
for replacement_case in source stage published; do
  replacement_legacy="$TEMP_DIR/replaced-$replacement_case-legacy"
  replacement_product="$TEMP_DIR/replaced-$replacement_case-product"
  replacement_evidence="$TEMP_DIR/replaced-$replacement_case.json"
  replacement_instance="15151515-1515-4515-8515-15151515151${#replacement_case}"
  mkdir -p "$replacement_legacy/config/cameraagent" "$replacement_legacy/data/agent"
  printf '{}\n' > "$replacement_legacy/config/cameraagent/config.json"
  printf 'state\n' > "$replacement_legacy/data/agent/state"
  create_v2_fixture_catalog "$replacement_legacy/data/catalog" hyg-v42-production fixture-v1
  create_catalog_lock "$replacement_legacy/data/catalog"
  replacement_args=(--legacy-root "$replacement_legacy" --product-root "$replacement_product" --instance-id "$replacement_instance" \
    --application-id "replacement-$replacement_case-agent" --catalog-id hyg-v42-production --evidence "$replacement_evidence")
  case "$replacement_case" in
    source)
      replacement_lock="$replacement_legacy/data/catalog/.catalog.lock"
      ;;
    stage)
      if DEPLOY_MIGRATION_FAILPOINT=after-copy-catalog "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply \
        "${replacement_args[@]}" >/dev/null 2>&1; then exit 142; fi
      replacement_lock="$replacement_product/catalogs/.hvo-migration-$replacement_instance.stage/.catalog.lock"
      ;;
    published)
      "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${replacement_args[@]}" >/dev/null
      "$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${replacement_args[@]}" >/dev/null
      replacement_lock="$replacement_product/catalogs/hyg-v42-production/.catalog.lock"
      ;;
  esac
  replacement_marker="$TEMP_DIR/replaced-$replacement_case.marker"
  replacement_release="$TEMP_DIR/replaced-$replacement_case.release"
  replacement_database="${replacement_lock%/.catalog.lock}/versions/fixture-v1/hyg_v42.sqlite"
  replacement_database_sha="$(sha256sum "$replacement_database" 2>/dev/null || true)"
  PATH="$TEMP_DIR/fake-lock-bin:$PATH" HVO_REAL_FLOCK="$real_flock" HVO_MIGRATION_LOCK_PATH="$replacement_lock" \
    HVO_MIGRATION_LOCK_MARKER="$replacement_marker" HVO_MIGRATION_LOCK_RELEASE="$replacement_release" \
    "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${replacement_args[@]}" >/dev/null 2>&1 &
  catalog_migration_pid=$!
  replace_acquired_catalog_lock "$catalog_migration_pid" "$replacement_lock" "$replacement_marker" "$replacement_release"
  catalog_migration_pid=
  test ! -e "$replacement_evidence"
  [[ -z "$replacement_database_sha" ]] || test "$(sha256sum "$replacement_database")" = "$replacement_database_sha"
  if [[ "$replacement_case" == source ]]; then
    test ! -e "$replacement_evidence.apply-intent.json"
    test ! -e "$replacement_product/cameraagents/$replacement_instance"
  elif [[ "$replacement_case" == stage ]]; then
    test -d "$replacement_product/catalogs/.hvo-migration-$replacement_instance.stage"
  else
    test ! -e "$replacement_product/cameraagents/$replacement_instance"
  fi
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${replacement_args[@]}" >/dev/null
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" verify "${replacement_args[@]}" >/dev/null
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${replacement_args[@]}" >/dev/null
  test ! -e "$replacement_product/cameraagents/$replacement_instance"
