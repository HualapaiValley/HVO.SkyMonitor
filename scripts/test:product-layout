for invalid_catalog in unknown-manifest-property schema-drift; do
  invalid_legacy="$TEMP_DIR/invalid-catalog-$invalid_catalog"; invalid_product="$TEMP_DIR/invalid-catalog-$invalid_catalog-product"
  mkdir -p "$invalid_legacy/config" "$invalid_legacy/data"
  cp -a "$legacy/config/cameraagent" "$invalid_legacy/config/cameraagent"
  cp -a "$legacy/data/agent" "$invalid_legacy/data/agent"
  cp -a "$legacy/data/catalog" "$invalid_legacy/data/catalog"
  invalid_version="$invalid_legacy/data/catalog/versions/fixture-v1"
  chmod 755 "$invalid_version"; chmod 644 "$invalid_version/manifest.json" "$invalid_version/hyg_v42.sqlite"
  if [[ "$invalid_catalog" == unknown-manifest-property ]]; then
    jq '.unexpected=true' "$invalid_version/manifest.json" > "$invalid_version/manifest.json.changed"
    mv "$invalid_version/manifest.json.changed" "$invalid_version/manifest.json"
  else
    sqlite3 "$invalid_version/hyg_v42.sqlite" 'CREATE TABLE unexpected_schema(value TEXT);'
    invalid_sha="$(sha256sum "$invalid_version/hyg_v42.sqlite" | cut -d' ' -f1)"
    invalid_length="$(wc -c < "$invalid_version/hyg_v42.sqlite")"
    jq --arg sha "$invalid_sha" --argjson length "$invalid_length" '.database.sha256=$sha | .database.length=$length' \
      "$invalid_version/manifest.json" > "$invalid_version/manifest.json.changed"
    mv "$invalid_version/manifest.json.changed" "$invalid_version/manifest.json"
  fi
  chmod 444 "$invalid_version/manifest.json" "$invalid_version/hyg_v42.sqlite"; chmod 555 "$invalid_version"
  if "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply --legacy-root "$invalid_legacy" --product-root "$invalid_product" \
    --instance-id aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa --application-id invalid-agent --catalog-id hyg-v42-production \
    --evidence "$TEMP_DIR/invalid-catalog-$invalid_catalog.json" >/dev/null 2>&1; then
    printf 'Migration accepted invalid v2 catalog: %s\n' "$invalid_catalog" >&2; exit 111
  fi
  test ! -e "$invalid_product/cameraagents/aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
done
