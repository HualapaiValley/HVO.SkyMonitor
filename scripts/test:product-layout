#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
umask 077

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TEMP_DIR="$(mktemp -d -t hvo-product-layout.XXXXXX)"
cleanup() { chmod -R u+w "$TEMP_DIR" 2>/dev/null || true; rm -rf "$TEMP_DIR"; }
trap cleanup EXIT

# shellcheck source=scripts/deploy/common.sh
. "$REPO_ROOT/scripts/deploy/common.sh"
# shellcheck source=scripts/deploy/product-layout.sh
. "$REPO_ROOT/scripts/deploy/product-layout.sh"

product="$TEMP_DIR/skymonitor"
inventory="$TEMP_DIR/inventory.json"
jq -n --arg product "$product" '{
  schemaVersion:8,installationId:"test-installation",productRoot:$product,source:{revision:("a"*40)},
  logicHost:{name:"logic",friendlyName:"Logic",instanceId:"11111111-1111-4111-8111-111111111111",applicationIdentity:"logic-app",
    catalogId:"shared",cookieName:"hvo.skymonitor.11111111111141118111111111111111",runtimeRoot:($product+"/logichosts/11111111-1111-4111-8111-111111111111"),ports:[5174]},
  cameraAgents:[
    {name:"east",friendlyName:"East",instanceId:"22222222-2222-4222-8222-222222222222",applicationIdentity:"agent-east",
      catalogId:"shared",cookieName:"hvo.skymonitor.22222222222242228222222222222222",runtimeRoot:($product+"/cameraagents/22222222-2222-4222-8222-222222222222"),ports:[5130]},
    {name:"west",friendlyName:"West",instanceId:"33333333-3333-4333-8333-333333333333",applicationIdentity:"agent-west",
      catalogId:"alternate",cookieName:"hvo.skymonitor.33333333333343338333333333333333",runtimeRoot:($product+"/cameraagents/33333333-3333-4333-8333-333333333333"),ports:[5131]}],
  catalogs:[
    {catalogId:"shared",schemaVersion:"2",preprocessingVersion:"3",installRoot:($product+"/catalogs/shared")},
    {catalogId:"alternate",schemaVersion:"2",preprocessingVersion:"3",installRoot:($product+"/catalogs/alternate")}],
  deployment:{resources:{project:"test"}}
}' > "$inventory"

deploy_validate_product_layout "$inventory" isolated
test "$(deploy_catalog_root "$inventory" "$(jq -c '.cameraAgents[0]' "$inventory")")" = "$product/catalogs/shared"
test "$(deploy_catalog_root "$inventory" "$(jq -c '.cameraAgents[1]' "$inventory")")" = "$product/catalogs/alternate"

# Friendly names are metadata: changing one cannot change the UUID path, project, or manifest identity.
before_root="$(jq -r '.cameraAgents[0].runtimeRoot' "$inventory")"
before_project="$(deploy_compose_project "$inventory" "$(jq -c '.cameraAgents[0]' "$inventory")")"
before_manifest="$(deploy_instance_manifest_json "$inventory" "$(jq -c '.cameraAgents[0]' "$inventory")" cameraAgent agent-east)"
jq '.cameraAgents[0].friendlyName="Renamed camera"' "$inventory" > "$TEMP_DIR/renamed.json"
deploy_validate_product_layout "$TEMP_DIR/renamed.json" isolated
test "$(jq -r '.cameraAgents[0].runtimeRoot' "$TEMP_DIR/renamed.json")" = "$before_root"
test "$(deploy_compose_project "$TEMP_DIR/renamed.json" "$(jq -c '.cameraAgents[0]' "$TEMP_DIR/renamed.json")")" = "$before_project"
test "$(deploy_instance_manifest_json "$TEMP_DIR/renamed.json" "$(jq -c '.cameraAgents[0]' "$TEMP_DIR/renamed.json")" cameraAgent agent-east)" = "$before_manifest"

reject_layout() {
    if deploy_validate_product_layout "$1" "${3:-isolated}" >/dev/null 2>&1; then
        printf 'Invalid product layout was accepted: %s\n' "$2" >&2
        exit 1
    fi
}
jq '.cameraAgents[1].instanceId=.cameraAgents[0].instanceId' "$inventory" > "$TEMP_DIR/invalid.json"; reject_layout "$TEMP_DIR/invalid.json" uuid-collision
jq '.cameraAgents[1].runtimeRoot=.cameraAgents[0].runtimeRoot' "$inventory" > "$TEMP_DIR/invalid.json"; reject_layout "$TEMP_DIR/invalid.json" mutable-root-collision
jq '.cameraAgents[1].catalogId="missing"' "$inventory" > "$TEMP_DIR/invalid.json"; reject_layout "$TEMP_DIR/invalid.json" unknown-catalog
jq '.catalogs[1].catalogId="Shared"' "$inventory" > "$TEMP_DIR/invalid.json"; reject_layout "$TEMP_DIR/invalid.json" invalid-catalog-id
jq '.catalogs[1].catalogId=("a" * 33) | .cameraAgents[1].catalogId=("a" * 33) | .productRoot as $root | .catalogs[1].installRoot=($root+"/catalogs/"+.catalogs[1].catalogId)' "$inventory" > "$TEMP_DIR/invalid.json"; reject_layout "$TEMP_DIR/invalid.json" overlong-catalog-id
jq '.catalogs[1].installRoot=.cameraAgents[0].runtimeRoot+"/catalog"' "$inventory" > "$TEMP_DIR/invalid.json"; reject_layout "$TEMP_DIR/invalid.json" unsafe-ancestry
jq '.logicHost.runtimeRoot="/var/lib/hvo/skymonitor/logichosts/11111111-1111-4111-8111-111111111111" |
  .cameraAgents[0].runtimeRoot="/var/lib/hvo/skymonitor/cameraagents/22222222-2222-4222-8222-222222222222" |
  .cameraAgents[1].runtimeRoot="/var/lib/hvo/skymonitor/cameraagents/33333333-3333-4333-8333-333333333333" |
  .productRoot="/var/lib/hvo/skymonitor" | .productRoot as $root | .catalogs |= map(.installRoot=($root+"/catalogs/"+.catalogId))' "$inventory" > "$TEMP_DIR/persistent.json"
deploy_validate_product_layout "$TEMP_DIR/persistent.json" persistent
jq '.productRoot="/opt/not-skymonitor" | .productRoot as $root |
  .logicHost.runtimeRoot=($root+"/logichosts/"+.logicHost.instanceId) |
  .cameraAgents |= map(.runtimeRoot=($root+"/cameraagents/"+.instanceId)) |
  .catalogs |= map(.installRoot=($root+"/catalogs/"+.catalogId))' "$inventory" > "$TEMP_DIR/noncanonical-persistent.json"
reject_layout "$TEMP_DIR/noncanonical-persistent.json" persistent-root persistent

# Exercise guarded singular-layout migration only beneath a disposable root.
legacy="$TEMP_DIR/legacy"; migrated="$TEMP_DIR/migrated/skymonitor"; evidence="$TEMP_DIR/migration.json"
mkdir -p "$legacy/config/cameraagent" "$legacy/data/agent/identity" "$legacy/data/agent/provisioning" "$legacy/data/catalog/versions/v1"
printf 'owner-db\n' > "$legacy/config/cameraagent/identity.db"
printf '42\n' > "$legacy/data/agent/capture-sequence"
printf 'protected-location\n' > "$legacy/data/agent/provisioning/location.protected"
printf 'catalog-bytes\n' > "$legacy/data/catalog/versions/v1/catalog.sqlite"
printf '{"manifestVersion":2,"catalog":{"id":"hyg-v42-production"}}\n' > "$legacy/data/catalog/versions/v1/manifest.json"
chmod 444 "$legacy/data/catalog/versions/v1/catalog.sqlite" "$legacy/data/catalog/versions/v1/manifest.json"
chmod 555 "$legacy/data/catalog/versions/v1"
ln -s versions/v1 "$legacy/data/catalog/current"
printf 'sibling-preserved\n' > "$legacy/data/sibling"
instance=44444444-4444-4444-8444-444444444444
args=(--legacy-root "$legacy" --product-root "$migrated" --instance-id "$instance" --application-id agent-legacy --catalog-id hyg-v42-production --evidence "$evidence")
if DEPLOY_MIGRATION_FAILPOINT=after-instance-stage-mkdir "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${args[@]}" >/dev/null 2>&1; then exit 88; fi
test -d "$migrated/cameraagents/.hvo-migration-$instance.stage"
test -z "$(find "$migrated/cameraagents/.hvo-migration-$instance.stage" -mindepth 1 -print -quit)"
"$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${args[@]}"
test ! -e "$migrated/cameraagents/.hvo-migration-$instance.stage"
if DEPLOY_MIGRATION_FAILPOINT=mid-copy-config "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${args[@]}" >/dev/null 2>&1; then exit 89; fi
test -f "$evidence.apply-intent.json"; test -d "$migrated/cameraagents/.hvo-migration-$instance.stage"
test ! -e "$migrated/cameraagents/.hvo-migration-$instance.stage/config/identity.db"
"$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${args[@]}"
test ! -e "$evidence.apply-intent.json"; test ! -e "$migrated/cameraagents/.hvo-migration-$instance.stage"; test -f "$legacy/data/agent/capture-sequence"
# Unknown or replaced stale-stage content is retained for operator inspection rather than recursively deleted.
if DEPLOY_MIGRATION_FAILPOINT=after-copy-config "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${args[@]}" >/dev/null 2>&1; then exit 89; fi
stage="$migrated/cameraagents/.hvo-migration-$instance.stage"
printf 'unknown\n' > "$stage/unknown"
if "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${args[@]}" >/dev/null 2>&1; then exit 96; fi
test -f "$stage/unknown"; test -f "$stage/config/identity.db"
rm "$stage/unknown"
printf 'replaced\n' > "$stage/config/identity.db"
if "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${args[@]}" >/dev/null 2>&1; then exit 97; fi
test "$(<"$stage/config/identity.db")" = replaced
cp "$legacy/config/cameraagent/identity.db" "$stage/config/identity.db"
"$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${args[@]}"
if DEPLOY_MIGRATION_FAILPOINT=after-copy-config "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${args[@]}" >/dev/null 2>&1; then exit 89; fi
"$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${args[@]}"
"$REPO_ROOT/scripts/deploy:migrate-product-layout" verify "${args[@]}"
if DEPLOY_MIGRATION_FAILPOINT=after-delete-rollback-instance-config "$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${args[@]}" >/dev/null 2>&1; then exit 102; fi
test -f "$evidence.rollback-intent.json"
test ! -e "$migrated/cameraagents/$instance/config"
test -d "$migrated/cameraagents/$instance/state"
test -f "$migrated/catalogs/hyg-v42-production/versions/v1/catalog.sqlite"
"$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${args[@]}"
test ! -e "$evidence.rollback-intent.json"; test ! -e "$migrated/cameraagents/$instance"
for cleanup_case in \
  'intent|' \
  "evidence|$evidence" \
  "config-snapshot|$evidence.config.snapshot" \
  "state-snapshot|$evidence.state.snapshot" \
  "catalog-snapshot|$evidence.catalog.snapshot" \
  "apply-intent|$evidence.apply-intent.json"; do
  cleanup_boundary="${cleanup_case%%|*}"; cleanup_deleted="${cleanup_case#*|}"
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${args[@]}"
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" verify "${args[@]}"
  if DEPLOY_MIGRATION_FAILPOINT="after-rollback-cleanup-$cleanup_boundary" "$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${args[@]}" >/dev/null 2>&1; then exit 103; fi
  jq -e '.state == "cleanup-pending"' "$evidence.rollback-intent.json" >/dev/null
  [[ -z "$cleanup_deleted" ]] || test ! -e "$cleanup_deleted"
  if [[ "$cleanup_boundary" == evidence ]]; then
    cp "$evidence.config.snapshot" "$TEMP_DIR/config.snapshot.valid"
    printf 'hostile\n' >> "$evidence.config.snapshot"
    if "$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${args[@]}" >/dev/null 2>&1; then exit 104; fi
    test -f "$evidence.rollback-intent.json"
    cp "$TEMP_DIR/config.snapshot.valid" "$evidence.config.snapshot"
  fi
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${args[@]}"
  test ! -e "$evidence.rollback-intent.json"; test ! -e "$evidence.apply-intent.json"
  test ! -e "$evidence.config.snapshot"; test ! -e "$evidence.state.snapshot"; test ! -e "$evidence.catalog.snapshot"
done
"$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${args[@]}"
"$REPO_ROOT/scripts/deploy:migrate-product-layout" verify "${args[@]}"
test "$(<"$migrated/cameraagents/$instance/state/capture-sequence")" = 42
test "$(readlink "$migrated/catalogs/hyg-v42-production/current")" = versions/v1
jq -e --arg instance "$instance" '.schemaVersion == 2 and .status == "copied-and-verified" and .legacyRetained == true and .instanceId == $instance' "$evidence" >/dev/null
jq -e --arg instance "$instance" '.component == "cameraAgent" and .instanceId == $instance and .applicationIdentityFile == "application-identity.json" and (has("applicationIdentity") | not)' "$migrated/cameraagents/$instance/instance-manifest.json" >/dev/null
jq -e '.state == "pre-provisioning" and .configuredIdentity == "agent-legacy" and .boundIdentity == null' "$migrated/cameraagents/$instance/application-identity.json" >/dev/null
# Rollback prevalidates every candidate root before deleting any sibling.
printf 'unknown\n' > "$migrated/cameraagents/$instance/unknown"
if "$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${args[@]}" >/dev/null 2>&1; then exit 98; fi
test -f "$migrated/cameraagents/$instance/unknown"; test -f "$migrated/catalogs/hyg-v42-production/versions/v1/catalog.sqlite"
rm "$migrated/cameraagents/$instance/unknown"
printf 'unknown\n' > "$migrated/catalogs/hyg-v42-production/unknown"
if "$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${args[@]}" >/dev/null 2>&1; then exit 99; fi
test -f "$migrated/cameraagents/$instance/config/identity.db"; test -f "$migrated/catalogs/hyg-v42-production/unknown"
rm "$migrated/catalogs/hyg-v42-production/unknown"
"$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${args[@]}"
test -f "$legacy/data/agent/capture-sequence"; test ! -e "$migrated/cameraagents/$instance"
if DEPLOY_MIGRATION_FAILPOINT=after-publish-instance "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${args[@]}" >/dev/null 2>&1; then exit 90; fi
test -d "$migrated/cameraagents/$instance"; test ! -e "$evidence"
"$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${args[@]}"
cutover="$TEMP_DIR/cutover.json"
jq -n --arg instance "$instance" '{schemaVersion:1,instanceId:$instance,applicationIdentity:"agent-legacy",imageIdentityVerified:true,
  healthVerified:true,loginVerified:true,provisioningVerified:true,dataProtectionVerified:true,locationHistoryVerified:true,
  artifactChecksumsVerified:true,rollbackRehearsed:true,captureSequenceBefore:42,captureSequenceAfter:43}' > "$cutover"
chmod 600 "$cutover"
if "$REPO_ROOT/scripts/deploy:migrate-product-layout" finalize "${args[@]/hyg-v42-production/alternate-catalog}" --cutover-evidence "$cutover" >/dev/null 2>&1; then exit 103; fi
test -d "$legacy/config/cameraagent"; test -d "$legacy/data/agent"; test -d "$legacy/data/catalog"
if DEPLOY_MIGRATION_FAILPOINT=after-tombstone-config "$REPO_ROOT/scripts/deploy:migrate-product-layout" finalize "${args[@]}" --cutover-evidence "$cutover" >/dev/null 2>&1; then exit 91; fi
test -d "$legacy/config/cameraagent.hvo-migration-$instance"; test -d "$legacy/data/agent"; test -d "$legacy/data/catalog"
if DEPLOY_MIGRATION_FAILPOINT=after-partial-delete-state "$REPO_ROOT/scripts/deploy:migrate-product-layout" finalize "${args[@]}" --cutover-evidence "$cutover" >/dev/null 2>&1; then exit 92; fi
jq -e '.status == "finalized-removal-pending" and .legacyRetained == false' "$evidence" >/dev/null
test -d "$legacy/data/agent.hvo-migration-$instance"
test "$(find "$legacy/data/agent.hvo-migration-$instance" -type f | wc -l)" -lt 2
cp "$cutover" "$cutover.valid"
jq '.captureSequenceAfter=44' "$cutover.valid" > "$cutover"; chmod 600 "$cutover"
if "$REPO_ROOT/scripts/deploy:migrate-product-layout" finalize "${args[@]}" --cutover-evidence "$cutover" >/dev/null 2>&1; then exit 104; fi
mv "$cutover.valid" "$cutover"; chmod 600 "$cutover"
printf 'unknown\n' > "$legacy/data/agent.hvo-migration-$instance/unknown"
if "$REPO_ROOT/scripts/deploy:migrate-product-layout" finalize "${args[@]}" --cutover-evidence "$cutover" >/dev/null 2>&1; then exit 95; fi
rm "$legacy/data/agent.hvo-migration-$instance/unknown"
"$REPO_ROOT/scripts/deploy:migrate-product-layout" finalize "${args[@]}" --cutover-evidence "$cutover"
test ! -e "$legacy/config/cameraagent"; test ! -e "$legacy/data/agent"; test ! -e "$legacy/data/catalog"
jq -e '.status == "finalized" and .legacyRetained == false' "$evidence" >/dev/null
test "$(<"$legacy/data/sibling")" = sibling-preserved
cp "$cutover" "$cutover.valid"
jq '.captureSequenceAfter=45' "$cutover.valid" > "$cutover"; chmod 600 "$cutover"
if "$REPO_ROOT/scripts/deploy:migrate-product-layout" finalize "${args[@]}" --cutover-evidence "$cutover" >/dev/null 2>&1; then exit 105; fi
mv "$cutover.valid" "$cutover"; chmod 600 "$cutover"
"$REPO_ROOT/scripts/deploy:migrate-product-layout" finalize "${args[@]}" --cutover-evidence "$cutover" >/dev/null
if "$REPO_ROOT/scripts/deploy:migrate-product-layout" rollback "${args[@]}" >/dev/null 2>&1; then
    printf 'Finalized migration unexpectedly rolled back.\n' >&2; exit 1
fi

# An explicitly supplied preserved device identity migrates as bound without resetting provisioned configuration.
provisioned="$TEMP_DIR/provisioned"; provisioned_product="$TEMP_DIR/provisioned-product"; provisioned_evidence="$TEMP_DIR/provisioned.json"
mkdir -p "$provisioned/config/cameraagent/secrets" "$provisioned/data/agent" "$provisioned/data/catalog/versions/v1"
printf '{"agentId":"device-preserved","module":{},"rig":{}}\n' > "$provisioned/config/cameraagent/camera-module.json"
printf 'device-preserved\n' > "$provisioned/config/cameraagent/secrets/CameraAgent__AgentId"
printf 'false\n' > "$provisioned/config/cameraagent/secrets/CameraAgent__ProvisioningStartupGate__Enabled"
printf 'true\n' > "$provisioned/config/cameraagent/secrets/CameraAgent__CaptureDistribution__UploadEnabled"
printf 'preserved-password-state\n' > "$provisioned/config/cameraagent/password-state"
printf 'state\n' > "$provisioned/data/agent/state"
printf '{"manifestVersion":2,"catalog":{"id":"hyg-v42-production"}}\n' > "$provisioned/data/catalog/versions/v1/manifest.json"
ln -s versions/v1 "$provisioned/data/catalog/current"
provisioned_instance=66666666-6666-4666-8666-666666666666
provisioned_args=(--legacy-root "$provisioned" --product-root "$provisioned_product" --instance-id "$provisioned_instance" --application-id configured-agent --bound-device-id device-preserved --catalog-id hyg-v42-production --evidence "$provisioned_evidence")
"$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${provisioned_args[@]}"
jq -e '.state == "bound" and .configuredIdentity == "configured-agent" and .boundIdentity == "device-preserved"' "$provisioned_product/cameraagents/$provisioned_instance/application-identity.json" >/dev/null
test "$(<"$provisioned_product/cameraagents/$provisioned_instance/config/secrets/CameraAgent__ProvisioningStartupGate__Enabled")" = false
test "$(<"$provisioned_product/cameraagents/$provisioned_instance/config/secrets/CameraAgent__CaptureDistribution__UploadEnabled")" = true
test "$(<"$provisioned_product/cameraagents/$provisioned_instance/config/password-state")" = preserved-password-state

# Exact legacy fixture facts derive and record the canonical fixture identity without changing manifest v1.
fixture_legacy="$TEMP_DIR/fixture-legacy"; fixture_product="$TEMP_DIR/fixture-product"; fixture_evidence="$TEMP_DIR/fixture-migration.json"
fixture_version="$fixture_legacy/data/catalog/versions/hyg-v42-fixture-1"
mkdir -p "$fixture_legacy/config/cameraagent" "$fixture_legacy/data/agent" "$fixture_version"
printf '{}\n' > "$fixture_legacy/config/cameraagent/config.json"; printf 'fixture-state\n' > "$fixture_legacy/data/agent/state"
cp "$REPO_ROOT/tests/fixtures/catalog/hyg-v42-bright-stars.sqlite" "$fixture_version/hyg_v42.sqlite"
fixture_sha="$(sha256sum "$fixture_version/hyg_v42.sqlite" | cut -d' ' -f1)"
jq -n --arg sha "$fixture_sha" '{manifestVersion:1,package:{kind:"fixture",version:"hyg-v42-fixture-1"},
  catalog:{name:"HYG bright-star test fixture",version:"4.2-fixture.1"},schemaVersion:"2",preprocessingVersion:"3",
  database:{relativePath:"hyg_v42.sqlite",sha256:$sha,length:16384,rowCount:9}}' > "$fixture_version/manifest.json"
ln -s versions/hyg-v42-fixture-1 "$fixture_legacy/data/catalog/current"
fixture_instance=77777777-7777-4777-8777-777777777777
fixture_args=(--legacy-root "$fixture_legacy" --product-root "$fixture_product" --instance-id "$fixture_instance" --application-id fixture-agent --catalog-id hyg-v42-fixture --evidence "$fixture_evidence")
fixture_wrong_product="$TEMP_DIR/fixture-wrong-product"
if "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply --legacy-root "$fixture_legacy" --product-root "$fixture_wrong_product" \
  --instance-id "$fixture_instance" --application-id fixture-agent --catalog-id hyg-v42-production --evidence "$TEMP_DIR/fixture-wrong.json" >/dev/null 2>&1; then exit 100; fi
test ! -e "$fixture_wrong_product/cameraagents/$fixture_instance"; test ! -e "$fixture_wrong_product/catalogs/hyg-v42-production"
# Matching legacy manifest claims cannot derive identity from arbitrary database bytes.
hostile_fixture="$TEMP_DIR/fixture-hostile"; hostile_product="$TEMP_DIR/fixture-hostile-product"
mkdir -p "$hostile_fixture/config/cameraagent" "$hostile_fixture/data/agent" "$hostile_fixture/data/catalog/versions/hyg-v42-fixture-1"
printf '{}\n' > "$hostile_fixture/config/cameraagent/config.json"; printf 'state\n' > "$hostile_fixture/data/agent/state"
cp "$fixture_version/manifest.json" "$hostile_fixture/data/catalog/versions/hyg-v42-fixture-1/manifest.json"
printf 'arbitrary-database-bytes\n' > "$hostile_fixture/data/catalog/versions/hyg-v42-fixture-1/hyg_v42.sqlite"
ln -s versions/hyg-v42-fixture-1 "$hostile_fixture/data/catalog/current"
if "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply --legacy-root "$hostile_fixture" --product-root "$hostile_product" \
  --instance-id 99999999-9999-4999-8999-999999999999 --application-id hostile-agent --catalog-id hyg-v42-fixture \
  --evidence "$TEMP_DIR/fixture-hostile.json" >/dev/null 2>&1; then exit 101; fi
test ! -e "$hostile_product/cameraagents/99999999-9999-4999-8999-999999999999"; test ! -e "$hostile_product/catalogs/hyg-v42-fixture"
"$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${fixture_args[@]}"
"$REPO_ROOT/scripts/deploy:migrate-product-layout" verify "${fixture_args[@]}"
jq -e '.catalogId == "hyg-v42-fixture" and .catalogIdentitySource == "derived-manifest-v1"' "$fixture_evidence" >/dev/null
jq -e '.manifestVersion == 1 and (.catalog | has("id") | not)' "$fixture_product/catalogs/hyg-v42-fixture/current/manifest.json" >/dev/null

# The operator-supplied real production bundle exercises the same immutable v1 compatibility path when available.
if [[ -n "${HVO_LEGACY_CATALOG_BUNDLE:-}" ]]; then
  production_legacy="$TEMP_DIR/production-legacy"; production_product="$TEMP_DIR/production-product"; production_evidence="$TEMP_DIR/production-migration.json"
  production_version="$production_legacy/data/catalog/versions/hyg-v4.2-p3-s2-r1"
  mkdir -p "$production_legacy/config/cameraagent" "$production_legacy/data/agent" "$production_legacy/data/catalog/versions"
  printf '{}\n' > "$production_legacy/config/cameraagent/config.json"; printf 'production-state\n' > "$production_legacy/data/agent/state"
  cp -a "$HVO_LEGACY_CATALOG_BUNDLE" "$production_version"
  ln -s versions/hyg-v4.2-p3-s2-r1 "$production_legacy/data/catalog/current"
  production_instance=88888888-8888-4888-8888-888888888888
  production_args=(--legacy-root "$production_legacy" --product-root "$production_product" --instance-id "$production_instance" --application-id production-agent --catalog-id hyg-v42-production --evidence "$production_evidence")
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${production_args[@]}"
  "$REPO_ROOT/scripts/deploy:migrate-product-layout" verify "${production_args[@]}"
  jq -e '.catalogId == "hyg-v42-production" and .catalogIdentitySource == "derived-manifest-v1"' "$production_evidence" >/dev/null
  jq -e '.manifestVersion == 1 and (.catalog | has("id") | not)' "$production_product/catalogs/hyg-v42-production/current/manifest.json" >/dev/null
fi

# Hostile legacy trees fail before destination publication.
mkdir "$TEMP_DIR/fake-bin"
cat > "$TEMP_DIR/fake-bin/stat" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == -c && "${2:-}" == %d && "${4:-}" == *nested-device* ]]; then
  value="$(/usr/bin/stat "$@")"; printf '%s\n' "$((value + 1))"; exit 0
fi
exec /usr/bin/stat "$@"
EOF
chmod 700 "$TEMP_DIR/fake-bin/stat"
for unsafe in absolute-link escaping-link fifo device-crossing ownership-drift tab-name newline-name tab-link-target newline-link-target; do
  root="$TEMP_DIR/unsafe-$unsafe"; destination="$TEMP_DIR/unsafe-$unsafe-product"; unsafe_evidence="$TEMP_DIR/unsafe-$unsafe.json"
  mkdir -p "$root/config/cameraagent" "$root/data/agent" "$root/data/catalog/versions/v1"
  printf '{}\n' > "$root/config/cameraagent/config.json"; printf 'state\n' > "$root/data/agent/state"
  printf '{"manifestVersion":2,"catalog":{"id":"hyg-v42-production"}}\n' > "$root/data/catalog/versions/v1/manifest.json"
  ln -s versions/v1 "$root/data/catalog/current"
  case "$unsafe" in
    absolute-link) ln -s /etc/passwd "$root/data/agent/unsafe" ;;
    escaping-link) ln -s ../../../../outside "$root/data/agent/unsafe" ;;
    fifo) mkfifo "$root/data/agent/unsafe" ;;
    device-crossing) mkdir "$root/data/agent/nested-device" ;;
    ownership-drift) chmod 755 "$root/data/agent" ;;
    tab-name) printf 'unsafe\n' > "$root/data/agent/"$'tab\tname' ;;
    newline-name) printf 'unsafe\n' > "$root/data/agent/"$'newline\nname' ;;
    tab-link-target) ln -s $'identity/tab\ttarget' "$root/data/agent/unsafe" ;;
    newline-link-target) ln -s $'identity/newline\ntarget' "$root/data/agent/unsafe" ;;
  esac
  unsafe_args=(--legacy-root "$root" --product-root "$destination" --instance-id 55555555-5555-4555-8555-555555555555 --application-id unsafe-agent --catalog-id hyg-v42-production --evidence "$unsafe_evidence")
  if [[ "$unsafe" == ownership-drift ]]; then
    "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${unsafe_args[@]}"
    chmod 700 "$root/data/agent"
    if "$REPO_ROOT/scripts/deploy:migrate-product-layout" verify "${unsafe_args[@]}" >/dev/null 2>&1; then exit 93; fi
  elif [[ "$unsafe" == device-crossing ]]; then
    if PATH="$TEMP_DIR/fake-bin:$PATH" "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${unsafe_args[@]}" >/dev/null 2>&1; then exit 94; fi
  elif "$REPO_ROOT/scripts/deploy:migrate-product-layout" apply "${unsafe_args[@]}" >/dev/null 2>&1; then exit 94; fi
  [[ "$unsafe" == ownership-drift ]] || test ! -e "$destination/cameraagents/55555555-5555-4555-8555-555555555555"
done

printf 'Product instance layout and guarded migration tests passed.\n'
