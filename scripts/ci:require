#!/usr/bin/env bash
set -euo pipefail

# Required CI aggregation. The expected result of every gate is derived from the
# validated classifier plan, so a plan that silently drops an affected gate is a
# rejected plan rather than a green merge.

# Plan and result values are split on whitespace; disable pathname expansion so a
# value can never glob against the runner workspace.
set -f

event_name="${1:-}"
plan_input="${2:-}"
result_input="${3:-}"

declare -A plan=()
declare -A result=()

plan_keys=(mode complete shared cameraagent logichost combined delivery deployment)
result_keys=(
  changes
  quality
  architecture
  coverage-policy
  migrations-cameraagent
  migrations-logichost
)

reject() {
  printf 'Required CI rejected the current head: %s\n' "$1" >&2
  printf 'Event: %s\nPlan: %s\nResults: %s\n' "$event_name" "$plan_input" "$result_input" >&2
  exit 1
}

parse_pairs() {
  local -n target="$1"
  local input="$2"
  local kind="$3"
  local pair key value
  for pair in $input; do
    [[ "$pair" == *=* ]] || reject "malformed $kind entry '$pair'"
    key="${pair%%=*}"
    value="${pair#*=}"
    [[ -n "$key" ]] || reject "malformed $kind entry '$pair'"
    [[ -z "${target[$key]+set}" ]] || reject "duplicate $kind entry '$key'"
    target["$key"]="$value"
  done
}

parse_pairs plan "$plan_input" plan
parse_pairs result "$result_input" result

for key in "${plan_keys[@]}"; do
  [[ -n "${plan[$key]+set}" ]] || reject "plan is missing '$key'"
done
for key in "${!plan[@]}"; do
  printf '%s\n' "${plan_keys[@]}" | grep -Fxq -- "$key" || reject "plan contains unknown key '$key'"
done
for key in "${result_keys[@]}"; do
  [[ -n "${result[$key]+set}" ]] || reject "results are missing '$key'"
  case "${result[$key]}" in
    success | failure | cancelled | skipped) ;;
    *) reject "job '$key' reported an unusable result '${result[$key]}'" ;;
  esac
done
for key in "${!result[@]}"; do
  printf '%s\n' "${result_keys[@]}" | grep -Fxq -- "$key" || reject "results contain unknown job '$key'"
done

case "${plan[mode]}" in
  full | reduced) ;;
  *) reject "unknown or missing CI classification mode '${plan[mode]}'" ;;
esac

for key in complete shared cameraagent logichost combined delivery deployment; do
  case "${plan[$key]}" in
    true | false) ;;
    *) reject "plan flag '$key' is not a boolean: '${plan[$key]}'" ;;
  esac
done

components=(shared cameraagent logichost combined delivery)
any_component="false"
every_component="true"
for key in "${components[@]}"; do
  if [[ "${plan[$key]}" == "true" ]]; then
    any_component="true"
  else
    every_component="false"
  fi
done

if [[ "$event_name" != "pull_request" ]]; then
  [[ "${plan[mode]}" == "full" ]] || reject "non-pull-request CI requires mode=full"
  [[ "${plan[complete]}" == "true" ]] || reject "non-pull-request CI requires complete=true"
  [[ "${plan[deployment]}" == "true" ]] || reject "non-pull-request CI requires deployment=true"
  [[ "$every_component" == "true" ]] || reject "non-pull-request CI requires every component lane"
fi

if [[ "${plan[mode]}" == "reduced" ]]; then
  [[ "$event_name" == "pull_request" ]] || reject "reduced CI is valid only for pull requests"
  [[ "${plan[deployment]}" == "false" ]] || reject "reduced CI requires deployment=false"
  [[ "${plan[complete]}" == "false" ]] || reject "reduced CI requires complete=false"
  [[ "$any_component" == "false" ]] || reject "reduced CI must select no component lane"
else
  [[ "${plan[complete]}" == "true" || "$any_component" == "true" ]] \
    || reject "full CI must select the complete matrix or at least one component lane"
  if [[ "${plan[complete]}" == "true" && "$every_component" != "true" ]]; then
    reject "the complete matrix must claim every component lane"
  fi
fi

if [[ "${plan[complete]}" == "true" && "${plan[mode]}" != "full" ]]; then
  reject "the complete matrix requires mode=full"
fi

# The classifier's fan-out rules are part of the plan contract. A shared contract
# change must claim every consuming lane. Combined coverage is only ever selected
# by a host seam, a combined fixture, or the shared fan-out, so it must claim at
# least one host lane; requiring both would reject a correct host-seam plan.
if [[ "${plan[shared]}" == "true" ]]; then
  for key in cameraagent logichost combined delivery; do
    [[ "${plan[$key]}" == "true" ]] || reject "a shared plan must claim every consuming lane, missing '$key'"
  done
fi

if [[ "${plan[combined]}" == "true" ]] \
  && [[ "${plan[cameraagent]}" != "true" && "${plan[logichost]}" != "true" ]]; then
  reject "a combined plan must claim at least one host lane"
fi

expected_when() {
  if [[ "$1" == "true" ]]; then
    printf 'success\n'
  else
    printf 'skipped\n'
  fi
}

full_mode="false"
[[ "${plan[mode]}" != "full" ]] || full_mode="true"

declare -A expected=()
expected[changes]="success"
expected[quality]="success"
expected[architecture]="$(expected_when "$full_mode")"
expected[coverage-policy]="$(expected_when "$full_mode")"
expected[migrations-cameraagent]="$(expected_when "$full_mode")"
expected[migrations-logichost]="$(expected_when "$full_mode")"

report=""
failed="false"
for key in "${result_keys[@]}"; do
  report+="$key=${result[$key]}(expected ${expected[$key]}) "
  [[ "${result[$key]}" == "${expected[$key]}" ]] || failed="true"
done

if [[ "$failed" == "true" ]]; then
  reject "at least one gate did not match its planned result: ${report% }"
fi

printf 'Required CI accepted the current head: event=%s plan=%s\n' "$event_name" "$plan_input"
printf 'Gate results: %s\n' "${report% }"
