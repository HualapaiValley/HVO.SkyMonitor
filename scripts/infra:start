#!/usr/bin/env bash
# infra:start - Start infrastructure and application services
# Usage: ./scripts/infra:start [--reset SERVICE...] [SERVICE...]
# Examples:
#   ./scripts/infra:start                    # Start all services
#   ./scripts/infra:start postgres redis     # Start specific services
#   ./scripts/infra:start --reset all        # Reset all data then start all
#   ./scripts/infra:start --reset postgres   # Reset postgres data then start all

set -euo pipefail

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Change to repo root
cd "$REPO_ROOT"

# Load environment variables
if [ -f .env ]; then
    echo -e "${BLUE}Loading environment from .env${NC}"
    set -a
    source .env
    set +a
fi

# Define all available services
readonly INFRA_SERVICES=(postgres minio redis smtp)
readonly APP_SERVICES=(skymonitor cameraagent-sim cameraagent-zwo)
readonly ALL_SERVICES=("${INFRA_SERVICES[@]}" "${APP_SERVICES[@]}")

# Parse arguments
RESET_MODE=false
RESET_SERVICES=()
START_SERVICES=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --reset)
            RESET_MODE=true
            shift
            # Collect services to reset
            while [[ $# -gt 0 ]] && [[ ! $1 =~ ^-- ]]; do
                if [[ "$1" == "all" ]]; then
                    RESET_SERVICES=("${ALL_SERVICES[@]}")
                else
                    RESET_SERVICES+=("$1")
                fi
                shift
            done
            ;;
        *)
            START_SERVICES+=("$1")
            shift
            ;;
    esac
done

# If no services specified, start all
if [[ ${#START_SERVICES[@]} -eq 0 ]]; then
    START_SERVICES=("${ALL_SERVICES[@]}")
fi

# Function to get docker context for a service
get_docker_context() {
    local service="$1"
    local context_var=""
    
    case "$service" in
        postgres)
            context_var="${POSTGRES_DOCKER_CONTEXT:-default}"
            ;;
        minio)
            context_var="${MINIO_DOCKER_CONTEXT:-default}"
            ;;
        redis)
            context_var="${REDIS_DOCKER_CONTEXT:-default}"
            ;;
        smtp)
            context_var="${SMTP_DOCKER_CONTEXT:-default}"
            ;;
        skymonitor)
            context_var="${SKYMONITOR_DOCKER_CONTEXT:-default}"
            ;;
        cameraagent-sim)
            context_var="${CAMERAAGENT_SIM_DOCKER_CONTEXT:-default}"
            ;;
        cameraagent-zwo)
            context_var="${CAMERAAGENT_ZWO_DOCKER_CONTEXT:-default}"
            ;;
        *)
            context_var="default"
            ;;
    esac
    
    echo "$context_var"
}

# Function to reset service data
reset_service() {
    local service="$1"
    local context
    context="$(get_docker_context "$service")"
    
    echo -e "${YELLOW}Resetting $service data...${NC}"
    
    case "$service" in
        postgres|minio|redis)
            # Stop the service if running
            docker --context "$context" compose -f docker-compose.dev.yml stop "$service" 2>/dev/null || true
            
            # Remove the volume
            local volume_name="skymonitor-${service}-data"
            docker --context "$context" volume rm "$volume_name" 2>/dev/null || true
            
            echo -e "${GREEN}✓ Reset $service data${NC}"
            ;;
        smtp)
            # MailHog doesn't persist data, just restart it
            docker --context "$context" compose -f docker-compose.dev.yml restart "$service" 2>/dev/null || true
            echo -e "${GREEN}✓ Reset $service (restarted)${NC}"
            ;;
        skymonitor|cameraagent-sim|cameraagent-zwo)
            # Application containers - just remove them
            docker --context "$context" compose -f docker-compose.dev.yml rm -f "$service" 2>/dev/null || true
            echo -e "${GREEN}✓ Reset $service (removed container)${NC}"
            ;;
        *)
            echo -e "${RED}Unknown service: $service${NC}"
            return 1
            ;;
    esac
}

# Reset services if requested
if [[ "$RESET_MODE" == true ]]; then
    echo -e "${BLUE}=== Resetting Services ===${NC}"
    for service in "${RESET_SERVICES[@]}"; do
        reset_service "$service"
    done
    echo ""
fi

# Start services
echo -e "${BLUE}=== Starting Services ===${NC}"

# Create data directories if they don't exist
mkdir -p data/postgres data/minio data/redis

# Start infrastructure services first
echo -e "${BLUE}Starting infrastructure services...${NC}"
docker compose -f docker-compose.dev.yml up -d "${INFRA_SERVICES[@]}"

# Wait a moment for infrastructure to stabilize
echo -e "${BLUE}Waiting for infrastructure to be healthy...${NC}"
sleep 3

# Check health of infrastructure services
for service in "${INFRA_SERVICES[@]}"; do
    if [[ " ${START_SERVICES[*]} " =~ " ${service} " ]]; then
        echo -n "Checking $service... "
        # Wait for healthy status (timeout after 30 seconds)
        timeout=30
        while [[ $timeout -gt 0 ]]; do
            status=$(docker compose -f docker-compose.dev.yml ps "$service" --format json 2>/dev/null | grep -o '"Health":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
            if [[ "$status" == "healthy" ]] || [[ "$status" == "unknown" ]]; then
                echo -e "${GREEN}✓${NC}"
                break
            fi
            sleep 1
            ((timeout--)) || true
        done
        if [[ $timeout -eq 0 ]]; then
            echo -e "${YELLOW}⚠ (timeout, may still be starting)${NC}"
        fi
    fi
done

# Start application services
if [[ " ${START_SERVICES[*]} " =~ " skymonitor " ]] || \
   [[ " ${START_SERVICES[*]} " =~ " cameraagent-sim " ]] || \
   [[ " ${START_SERVICES[*]} " =~ " cameraagent-zwo " ]]; then
    echo -e "${BLUE}Starting application services...${NC}"
    app_services_to_start=()
    for service in "${APP_SERVICES[@]}"; do
        if [[ " ${START_SERVICES[*]} " =~ " ${service} " ]]; then
            app_services_to_start+=("$service")
        fi
    done
    if [[ ${#app_services_to_start[@]} -gt 0 ]]; then
        docker compose -f docker-compose.dev.yml up -d "${app_services_to_start[@]}"
    fi
fi

echo ""
echo -e "${GREEN}=== Services Started ===${NC}"
echo "To view logs: docker compose -f docker-compose.dev.yml logs -f"
echo "To check status: ./scripts/infra:status"
echo "To stop: docker compose -f docker-compose.dev.yml down"
echo ""
echo -e "${BLUE}Service URLs:${NC}"
echo "  Main App:        http://localhost:${SKYMONITOR_HTTP_PORT:-5174}"
echo "  MinIO Console:   http://localhost:${MINIO_CONSOLE_PORT:-9001}"
echo "  MailHog Web UI:  http://localhost:${SMTP_WEB_PORT:-8025}"
echo "  Simulator Agent: http://localhost:${SIMULATOR_AGENT_HTTP_PORT:-5130}"
echo "  ZWO Agent:       http://localhost:${ZWO_AGENT_HTTP_PORT:-5232}"
