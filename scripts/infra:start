#!/usr/bin/env bash
# infra:start - Start infrastructure and application services on the local docker daemon
# Usage: ./scripts/infra:start [--reset SERVICE...] [--rebuild SERVICE...] [SERVICE...]

set -euo pipefail

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [[ -f .env ]]; then
    echo -e "${BLUE}Loading environment from .env${NC}"
    set -a
    source .env
    set +a
fi

readonly INFRA_SERVICES=(postgres minio redis smtp)
readonly APP_SERVICES=(logichost cameraagent)
readonly ALL_SERVICES=("${INFRA_SERVICES[@]}" "${APP_SERVICES[@]}")

clean_cameraagent_data() {
    mkdir -p data/cameraagent/identity data/cameraagent/dataprotection
    rm -f data/cameraagent/identity/* 2>/dev/null || true
    rm -f data/cameraagent/dataprotection/* 2>/dev/null || true
}

get_compose_file() {
    local service="$1"
    case "$service" in
        postgres|minio|redis|smtp) echo "docker-compose.infrastructure.yml" ;;
        logichost|cameraagent) echo "docker-compose.apps.yml" ;;
        *) echo "docker-compose.infrastructure.yml" ;;
    esac
}

ensure_cameraagent_networking() {
    export CAMERA_AGENT_LOGIC_BASEURL="${CAMERA_AGENT_LOGIC_BASEURL:-http://logichost:8080}"
    export CAMERA_AGENT_IDENTITY_URL="${CAMERA_AGENT_IDENTITY_URL:-http://logichost:8080}"
}

reset_service() {
    local service="$1"
    local compose_file
    compose_file="$(get_compose_file "$service")"

    echo -e "${YELLOW}Resetting $service data...${NC}"

    case "$service" in
        postgres|minio|redis)
            docker compose -f "$compose_file" stop "$service" 2>/dev/null || true
            docker compose -f "$compose_file" rm -f "$service" 2>/dev/null || true
            local volume_name="skymonitor-${service}-data"
            docker volume rm "$volume_name" 2>/dev/null || true
            echo -e "${GREEN}✓ Reset $service data${NC}"
            ;;
        smtp)
            docker compose -f "$compose_file" rm -f "$service" 2>/dev/null || true
            echo -e "${GREEN}✓ Reset $service (container removed)${NC}"
            ;;
        logichost|cameraagent)
            docker compose -f "$compose_file" rm -f "$service" 2>/dev/null || true
            if [[ "$service" == "cameraagent" ]]; then
                ensure_cameraagent_networking
                clean_cameraagent_data
            fi
            docker compose -f "$compose_file" build "$service"
            echo -e "${GREEN}✓ Reset $service (removed container and rebuilt image)${NC}"
            ;;
        *)
            echo -e "${RED}Unknown service: $service${NC}"
            return 1
            ;;
    esac
}

wait_for_health() {
    local service="$1"
    local compose_file="$2"
    local timeout=30

    echo -n "Checking $service... "
    while [[ $timeout -gt 0 ]]; do
        local status_json
        status_json=$(docker compose -f "$compose_file" ps "$service" --format json 2>/dev/null || true)
        local health
        health=$(echo "$status_json" | grep -o '"Health":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
        if [[ "$health" == "healthy" ]] || [[ "$health" == "unknown" ]]; then
            echo -e "${GREEN}✓${NC}"
            return
        fi
        sleep 1
        ((timeout--)) || true
    done
    echo -e "${YELLOW}⚠ (timeout, may still be starting)${NC}"
}

RESET_MODE=false
RESET_SERVICES=()
START_SERVICES=()
REBUILD_MODE=false
REBUILD_SERVICES=()
USER_SPECIFIED_SERVICES=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --reset)
            RESET_MODE=true
            shift
            while [[ $# -gt 0 ]] && [[ ! $1 =~ ^-- ]]; do
                if [[ "$1" == "all" ]]; then
                    RESET_SERVICES=("${ALL_SERVICES[@]}")
                else
                    RESET_SERVICES+=("$1")
                fi
                shift
            done
            ;;
        --rebuild)
            REBUILD_MODE=true
            shift
            while [[ $# -gt 0 ]] && [[ ! $1 =~ ^-- ]]; do
                if [[ "$1" == "all" ]]; then
                    REBUILD_SERVICES=("${APP_SERVICES[@]}")
                else
                    REBUILD_SERVICES+=("$1")
                fi
                shift
            done
            ;;
        *)
            USER_SPECIFIED_SERVICES=true
            if [[ "$1" == "all" ]]; then
                START_SERVICES=("${ALL_SERVICES[@]}")
            else
                START_SERVICES+=("$1")
            fi
            shift
            ;;
    esac
done

if [[ ${#START_SERVICES[@]} -eq 0 ]]; then
    START_SERVICES=("${ALL_SERVICES[@]}")
fi

if [[ "$RESET_MODE" == true ]]; then
    echo -e "${BLUE}=== Resetting Services ===${NC}"
    for service in "${RESET_SERVICES[@]}"; do
        reset_service "$service"
    done
    echo ""
fi

echo -e "${BLUE}=== Starting Services ===${NC}"
mkdir -p data/postgres data/minio data/redis data/cameraagent/identity data/cameraagent/dataprotection

infra_services_to_start=()
for service in "${INFRA_SERVICES[@]}"; do
    if [[ " ${START_SERVICES[*]} " =~ " ${service} " ]]; then
        infra_services_to_start+=("$service")
    fi
done

if [[ ${#infra_services_to_start[@]} -eq 0 ]] && [[ "$USER_SPECIFIED_SERVICES" == true ]]; then
    if [[ " ${START_SERVICES[*]} " =~ " logichost " ]] || [[ " ${START_SERVICES[*]} " =~ " cameraagent " ]]; then
        infra_services_to_start=("${INFRA_SERVICES[@]}")
    fi
fi

if [[ ${#infra_services_to_start[@]} -eq 0 ]]; then
    infra_services_to_start=("${INFRA_SERVICES[@]}")
fi

echo -e "${BLUE}Starting infrastructure services...${NC}"
for service in "${infra_services_to_start[@]}"; do
    compose_file="$(get_compose_file "$service")"
    echo -e "Starting ${service}"
    docker compose -f "$compose_file" up -d "$service"
done

echo -e "${BLUE}Waiting for infrastructure to be healthy...${NC}"
sleep 3
for service in "${infra_services_to_start[@]}"; do
    compose_file="$(get_compose_file "$service")"
    wait_for_health "$service" "$compose_file"
done

if [[ "$REBUILD_MODE" == true ]]; then
    echo -e "${BLUE}Rebuilding application images...${NC}"
    if [[ ${#REBUILD_SERVICES[@]} -eq 0 ]]; then
        REBUILD_SERVICES=("${APP_SERVICES[@]}")
    fi
    for service in "${REBUILD_SERVICES[@]}"; do
        if [[ ! " ${APP_SERVICES[*]} " =~ " ${service} " ]]; then
            continue
        fi
        compose_file="$(get_compose_file "$service")"
        if [[ "$service" == "cameraagent" ]]; then
            ensure_cameraagent_networking
        fi
        echo -e "Rebuilding ${service}"
        docker compose -f "$compose_file" build "$service"
    done
fi

if [[ " ${START_SERVICES[*]} " =~ " logichost " ]] || [[ " ${START_SERVICES[*]} " =~ " cameraagent " ]]; then
    echo -e "${BLUE}Starting application services...${NC}"
    app_services_to_start=()
    for service in "${APP_SERVICES[@]}"; do
        if [[ " ${START_SERVICES[*]} " =~ " ${service} " ]]; then
            app_services_to_start+=("$service")
        fi
    done
    for service in "${app_services_to_start[@]}"; do
        compose_file="$(get_compose_file "$service")"
        if [[ "$service" == "cameraagent" ]]; then
            ensure_cameraagent_networking
        fi
        docker compose -f "$compose_file" up -d "$service"
    done
fi

echo ""
echo -e "${GREEN}=== Services Started ===${NC}"
echo "To view logs: ./scripts/infra:logs [service]"
echo "To check status: ./scripts/infra:status"
echo "To stop: ./scripts/infra:stop"
echo ""
echo -e "${BLUE}Service URLs:${NC}"
echo "  Logic Host:     http://localhost:${LOGIC_HOST_HTTP_PORT:-5174}"
echo "  MinIO Console:  http://localhost:${MINIO_CONSOLE_PORT:-9001}"
echo "  Mailpit Web UI: http://localhost:${SMTP_WEB_PORT:-8025}"
echo "  Camera Agent:   http://localhost:${CAMERA_AGENT_HTTP_PORT:-5130}"
