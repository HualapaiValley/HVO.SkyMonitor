#!/usr/bin/env bash
# infra:start - Start infrastructure and application services
# Usage: ./scripts/infra:start [--reset SERVICE...] [--rebuild SERVICE...] [SERVICE...]
# Examples:
#   ./scripts/infra:start                             # Start all services
#   ./scripts/infra:start postgres redis              # Start specific services
#   ./scripts/infra:start --reset all                 # Reset all data then start all
#   ./scripts/infra:start --reset postgres            # Reset postgres data then start all
#   ./scripts/infra:start --rebuild logichost         # Rebuild LogicHost image before start
#   ./scripts/infra:start --reset logichost --rebuild # Reset and rebuild app containers

set -euo pipefail

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Change to repo root
cd "$REPO_ROOT"

# Load environment variables
if [ -f .env ]; then
    echo -e "${BLUE}Loading environment from .env${NC}"
    set -a
    source .env
    set +a
fi

# Define all available services
readonly INFRA_SERVICES=(postgres minio redis smtp)
readonly APP_SERVICES=(logichost cameraagent)
readonly ALL_SERVICES=("${INFRA_SERVICES[@]}" "${APP_SERVICES[@]}")

# Parse arguments
RESET_MODE=false
RESET_SERVICES=()
START_SERVICES=()
REBUILD_MODE=false
REBUILD_SERVICES=()
USER_SPECIFIED_SERVICES=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --reset)
            RESET_MODE=true
            shift
            while [[ $# -gt 0 ]] && [[ ! $1 =~ ^-- ]]; do
                if [[ "$1" == "all" ]]; then
                    RESET_SERVICES=("${ALL_SERVICES[@]}")
                else
                    RESET_SERVICES+=("$1")
                fi
                shift
            done
            ;;
        --rebuild)
            REBUILD_MODE=true
            shift
            while [[ $# -gt 0 ]] && [[ ! $1 =~ ^-- ]]; do
                if [[ "$1" == "all" ]]; then
                    REBUILD_SERVICES=("${APP_SERVICES[@]}")
                else
                    REBUILD_SERVICES+=("$1")
                fi
                shift
            done
            ;;
        *)
            USER_SPECIFIED_SERVICES=true
            if [[ "$1" == "all" ]]; then
                START_SERVICES=("${ALL_SERVICES[@]}")
            else
                START_SERVICES+=("$1")
            fi
            shift
            ;;
    esac
done

if [[ ${#START_SERVICES[@]} -eq 0 ]]; then
    START_SERVICES=("${ALL_SERVICES[@]}")
fi

get_docker_context() {
    local service="$1"
    local context_var="default"
    case "$service" in
        postgres) context_var="${POSTGRES_DOCKER_CONTEXT:-default}" ;;
        minio) context_var="${MINIO_DOCKER_CONTEXT:-default}" ;;
        redis) context_var="${REDIS_DOCKER_CONTEXT:-default}" ;;
        smtp) context_var="${SMTP_DOCKER_CONTEXT:-default}" ;;
        logichost) context_var="${LOGICHOST_DOCKER_CONTEXT:-default}" ;;
        cameraagent) context_var="${CAMERAAGENT_DOCKER_CONTEXT:-default}" ;;
    esac
    echo "$context_var"
}

reset_service() {
    local service="$1"
    local context
    context="$(get_docker_context "$service")"

    echo -e "${YELLOW}Resetting $service data...${NC}"

    case "$service" in
        postgres|minio|redis)
            docker --context "$context" compose -f docker-compose.dev.yml stop "$service" 2>/dev/null || true
            local volume_name="skymonitor-${service}-data"
            docker --context "$context" volume rm "$volume_name" 2>/dev/null || true
            echo -e "${GREEN}✓ Reset $service data${NC}"
            ;;
        smtp)
            docker --context "$context" compose -f docker-compose.dev.yml restart "$service" 2>/dev/null || true
            echo -e "${GREEN}✓ Reset $service (restarted)${NC}"
            ;;
        logichost|cameraagent)
            docker --context "$context" compose -f docker-compose.dev.yml rm -f "$service" 2>/dev/null || true
            if [[ "$service" == "cameraagent" ]]; then
                ensure_cameraagent_networking "$context"
            fi
            docker --context "$context" compose -f docker-compose.dev.yml build "$service"
            echo -e "${GREEN}✓ Reset $service (removed container and rebuilt image)${NC}"
            ;;
        *)
            echo -e "${RED}Unknown service: $service${NC}"
            return 1
            ;;
    esac
}

sanitize_context_name() {
    local context="${1:-default}"
    context="${context^^}"
    context="${context//[^A-Z0-9]/_}"
    if [[ -z "$context" ]]; then
        context="DEFAULT"
    fi
    printf '%s' "$context"
}

resolve_context_value() {
    local base_key="$1"
    local context="$2"
    local default_value="${3:-}"

    local sanitized_context
    sanitized_context="$(sanitize_context_name "$context")"
    local context_key="${base_key}_${sanitized_context}"

    if [[ -n "${!context_key:-}" ]]; then
        printf '%s' "${!context_key}"
        return
    fi

    if [[ -n "${!base_key:-}" ]]; then
        printf '%s' "${!base_key}"
        return
    fi

    if [[ -n "$default_value" ]]; then
        printf '%s' "$default_value"
        return
    fi

    printf '%s' ""
}

ensure_cameraagent_networking() {
    local context="${1:-default}"
    export CAMERA_AGENT_LOGIC_BASEURL
    export CAMERA_AGENT_IDENTITY_URL

    CAMERA_AGENT_LOGIC_BASEURL="$(resolve_context_value "CAMERA_AGENT_LOGIC_BASEURL" "$context" "http://logichost:8080")"
    CAMERA_AGENT_IDENTITY_URL="$(resolve_context_value "CAMERA_AGENT_IDENTITY_URL" "$context" "http://logichost:8080")"
}

if [[ "$RESET_MODE" == true ]]; then
    echo -e "${BLUE}=== Resetting Services ===${NC}"
    for service in "${RESET_SERVICES[@]}"; do
        reset_service "$service"
    done
    echo ""
fi

echo -e "${BLUE}=== Starting Services ===${NC}"
mkdir -p data/postgres data/minio data/redis

infra_services_to_start=()
for service in "${INFRA_SERVICES[@]}"; do
    if [[ " ${START_SERVICES[*]} " =~ " ${service} " ]]; then
        infra_services_to_start+=("$service")
    fi

done

if [[ ${#infra_services_to_start[@]} -eq 0 ]] && [[ "$USER_SPECIFIED_SERVICES" == true ]]; then
    if [[ " ${START_SERVICES[*]} " =~ " logichost " ]] || [[ " ${START_SERVICES[*]} " =~ " cameraagent " ]]; then
        infra_services_to_start=("${INFRA_SERVICES[@]}")
    fi
fi

if [[ ${#infra_services_to_start[@]} -eq 0 ]]; then
    infra_services_to_start=("${INFRA_SERVICES[@]}")
fi

echo -e "${BLUE}Starting infrastructure services...${NC}"
for service in "${infra_services_to_start[@]}"; do
    context="$(get_docker_context "$service")"
    echo -e "Starting ${service} via context '${context}'"
    docker --context "$context" compose -f docker-compose.dev.yml up -d "$service"
done

echo -e "${BLUE}Waiting for infrastructure to be healthy...${NC}"
sleep 3

for service in "${infra_services_to_start[@]}"; do
    echo -n "Checking $service... "
    timeout=30
    context="$(get_docker_context "$service")"
    while [[ $timeout -gt 0 ]]; do
        status=$(docker --context "$context" compose -f docker-compose.dev.yml ps "$service" --format json 2>/dev/null | grep -o '"Health":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
        if [[ "$status" == "healthy" ]] || [[ "$status" == "unknown" ]]; then
            echo -e "${GREEN}✓${NC}"
            break
        fi
        sleep 1
        ((timeout--)) || true
    done
    if [[ $timeout -eq 0 ]]; then
        echo -e "${YELLOW}⚠ (timeout, may still be starting)${NC}"
    fi

done

if [[ "$REBUILD_MODE" == true ]]; then
    echo -e "${BLUE}Rebuilding application images...${NC}"
    if [[ ${#REBUILD_SERVICES[@]} -eq 0 ]]; then
        rebuild_targets=("${APP_SERVICES[@]}")
    else
        rebuild_targets=("${REBUILD_SERVICES[@]}")
    fi

    filtered_targets=()
    for service in "${rebuild_targets[@]}"; do
        if [[ " ${APP_SERVICES[*]} " =~ " ${service} " ]]; then
            filtered_targets+=("$service")
        fi
    done

    if [[ ${#filtered_targets[@]} -gt 0 ]]; then
        for service in "${filtered_targets[@]}"; do
            context="$(get_docker_context "$service")"
            if [[ "$service" == "cameraagent" ]]; then
                ensure_cameraagent_networking "$context"
            fi
            echo -e "Rebuilding ${service} via context '${context}'"
            docker --context "$context" compose -f docker-compose.dev.yml build "$service"
        done
    else
        echo -e "${YELLOW}No application services matched for rebuild${NC}"
    fi
fi

if [[ " ${START_SERVICES[*]} " =~ " logichost " ]] || [[ " ${START_SERVICES[*]} " =~ " cameraagent " ]]; then
    echo -e "${BLUE}Starting application services...${NC}"
    app_services_to_start=()
    for service in "${APP_SERVICES[@]}"; do
        if [[ " ${START_SERVICES[*]} " =~ " ${service} " ]]; then
            app_services_to_start+=("$service")
        fi
    done
    if [[ ${#app_services_to_start[@]} -gt 0 ]]; then
        for service in "${app_services_to_start[@]}"; do
            context="$(get_docker_context "$service")"
            compose_flags=()
            if [[ "$service" == "cameraagent" ]]; then
                ensure_cameraagent_networking "$context"
                if [[ "$context" != "default" ]]; then
                    compose_flags+=(--no-deps)
                fi
            fi
            echo -e "Starting ${service} via context '${context}'"
            docker --context "$context" compose -f docker-compose.dev.yml up -d "${compose_flags[@]}" "$service"
        done
    fi
fi

echo ""
echo -e "${GREEN}=== Services Started ===${NC}"
echo "To view logs: docker compose -f docker-compose.dev.yml logs -f"
echo "To check status: ./scripts/infra:status"
echo "To stop: ./scripts/infra:stop"
echo ""
echo -e "${BLUE}Service URLs:${NC}"
echo "  Logic Host:      http://localhost:${LOGIC_HOST_HTTP_PORT:-5174}"
echo "  MinIO Console:   http://localhost:${MINIO_CONSOLE_PORT:-9001}"
echo "  Mailpit Web UI: http://localhost:${SMTP_WEB_PORT:-8025}"
echo "  Camera Agent:   http://localhost:${CAMERA_AGENT_HTTP_PORT:-5130}"
