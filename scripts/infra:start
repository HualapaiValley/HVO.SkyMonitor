#!/usr/bin/env bash
# infra:start - Start application containers that use shared hvo-docker services.
# Usage: ./scripts/infra:start [--reset [SERVICE...]] [--rebuild [SERVICE...]] [SERVICE...]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=scripts/infra:operation-lock
source "$SCRIPT_DIR/infra:operation-lock"
cd "$REPO_ROOT"

runtime_root_was_set=false
runtime_root_override=""
if [[ -v HVO_RUNTIME_DATA_ROOT ]]; then
    runtime_root_was_set=true
    runtime_root_override="$HVO_RUNTIME_DATA_ROOT"
fi
if [[ -f .env ]]; then
    set -a
    source .env
    set +a
fi
if [[ "$runtime_root_was_set" == true ]]; then
    HVO_RUNTIME_DATA_ROOT="$runtime_root_override"
fi

readonly APP_SERVICES=(logichost cameraagent)
readonly RUNTIME_DATA_ROOT="$(realpath -ms "${HVO_RUNTIME_DATA_ROOT:-$REPO_ROOT/data}")"
if [[ -z "$RUNTIME_DATA_ROOT" || "$RUNTIME_DATA_ROOT" == "/" ]]; then
    printf 'Refusing unsafe runtime data root: %s\n' "$RUNTIME_DATA_ROOT" >&2
    exit 1
fi
export HVO_RUNTIME_DATA_ROOT="$RUNTIME_DATA_ROOT"
export LOCAL_UID="$(id -u)"
export LOCAL_GID="$(id -g)"
hvo_acquire_application_state_lock "$RUNTIME_DATA_ROOT"
hvo_require_restore_marker_access start

prepare_runtime_directory() {
    validate_runtime_directory "$1"
    if [[ ! -d "$1" ]]; then
        install -d -m 700 "$1"
    else
        [[ ! -L "$1" && "$(stat -c '%u' "$1")" == "$(id -u)" ]] || {
            printf 'Runtime state directory must be owned by the current user and must not be a symbolic link.\n' >&2
            exit 1
        }
        chmod 700 "$1"
    fi
}

validate_runtime_directory() {
    local directory="$1"
    if [[ "$(realpath -m "$directory")" != "$directory" ]]; then
        printf 'Refusing runtime path through a symbolic link: %s\n' "$directory" >&2
        exit 1
    fi
    if [[ -e "$directory" && ( ! -d "$directory" || -L "$directory" ||
          "$(stat -c '%u' "$directory")" != "$(id -u)" ) ]]; then
        printf 'Runtime state directory must be owned by the current user and must not be a symbolic link.\n' >&2
        exit 1
    fi
}

reset_runtime_directory() {
    local directory="$1"
    case "$directory" in
        "$RUNTIME_DATA_ROOT/logichost/dataprotection"|\
        "$RUNTIME_DATA_ROOT/logichost/home"|\
        "$RUNTIME_DATA_ROOT/cameraagent/identity"|\
        "$RUNTIME_DATA_ROOT/cameraagent/dataprotection"|\
        "$RUNTIME_DATA_ROOT/cameraagent/provisioning"|\
        "$RUNTIME_DATA_ROOT/agent"|\
        "$RUNTIME_DATA_ROOT/archive") ;;
        *)
            printf 'Refusing to reset unexpected path: %s\n' "$directory" >&2
            exit 1
            ;;
    esac
    validate_runtime_directory "$directory"
    rm -rf -- "$directory"
    prepare_runtime_directory "$directory"
}

clean_logichost_data() {
    reset_runtime_directory "$RUNTIME_DATA_ROOT/logichost/dataprotection"
    reset_runtime_directory "$RUNTIME_DATA_ROOT/logichost/home"
}

clean_cameraagent_data() {
    reset_runtime_directory "$RUNTIME_DATA_ROOT/cameraagent/identity"
    reset_runtime_directory "$RUNTIME_DATA_ROOT/cameraagent/dataprotection"
    reset_runtime_directory "$RUNTIME_DATA_ROOT/cameraagent/provisioning"
    reset_runtime_directory "$RUNTIME_DATA_ROOT/agent"
    reset_runtime_directory "$RUNTIME_DATA_ROOT/archive"
}

validate_service() {
    local service="$1"
    [[ " ${APP_SERVICES[*]} " == *" ${service} "* ]] || {
        echo "Unknown application service: $service. Available services: ${APP_SERVICES[*]}" >&2
        exit 1
    }
}

RESET_SERVICES=()
REBUILD_SERVICES=()
START_SERVICES=()
mode="start"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --reset) mode="reset" ;;
        --rebuild) mode="rebuild" ;;
        all)
            case "$mode" in
                reset) RESET_SERVICES=("${APP_SERVICES[@]}") ;;
                rebuild) REBUILD_SERVICES=("${APP_SERVICES[@]}") ;;
                *) START_SERVICES=("${APP_SERVICES[@]}") ;;
            esac
            ;;
        *)
            validate_service "$1"
            case "$mode" in
                reset) RESET_SERVICES+=("$1") ;;
                rebuild) REBUILD_SERVICES+=("$1") ;;
                *) START_SERVICES+=("$1") ;;
            esac
            ;;
    esac
    shift
done

if [[ "$mode" == "reset" && ${#RESET_SERVICES[@]} -eq 0 ]]; then
    RESET_SERVICES=("${APP_SERVICES[@]}")
fi
if [[ "$mode" == "rebuild" && ${#REBUILD_SERVICES[@]} -eq 0 ]]; then
    REBUILD_SERVICES=("${APP_SERVICES[@]}")
fi
if [[ ${#START_SERVICES[@]} -eq 0 ]]; then
    if [[ ${#RESET_SERVICES[@]} -gt 0 || ${#REBUILD_SERVICES[@]} -gt 0 ]]; then
        START_SERVICES=("${RESET_SERVICES[@]}" "${REBUILD_SERVICES[@]}")
    else
        START_SERVICES=("${APP_SERVICES[@]}")
    fi
fi
if [[ ${#RESET_SERVICES[@]} -gt 0 ]]; then
    for service in "${RESET_SERVICES[@]}"; do
        if [[ "$service" == "logichost" ]]; then
            validate_runtime_directory "$RUNTIME_DATA_ROOT/logichost/dataprotection"
            validate_runtime_directory "$RUNTIME_DATA_ROOT/logichost/home"
        else
            validate_runtime_directory "$RUNTIME_DATA_ROOT/cameraagent/identity"
            validate_runtime_directory "$RUNTIME_DATA_ROOT/cameraagent/dataprotection"
            validate_runtime_directory "$RUNTIME_DATA_ROOT/cameraagent/provisioning"
            validate_runtime_directory "$RUNTIME_DATA_ROOT/agent"
            validate_runtime_directory "$RUNTIME_DATA_ROOT/archive"
        fi
    done
    for service in "${RESET_SERVICES[@]}"; do
        docker compose -f docker-compose.apps.yml rm -sf "$service"
        if [[ "$service" == "logichost" ]]; then
            clean_logichost_data
        else
            clean_cameraagent_data
        fi
    done
    REBUILD_SERVICES+=("${RESET_SERVICES[@]}")
fi
if [[ ${#REBUILD_SERVICES[@]} -gt 0 ]]; then
    docker compose -f docker-compose.apps.yml build "${REBUILD_SERVICES[@]}"
fi

prepare_runtime_directory "$RUNTIME_DATA_ROOT/logichost/dataprotection"
prepare_runtime_directory "$RUNTIME_DATA_ROOT/logichost/home"
prepare_runtime_directory "$RUNTIME_DATA_ROOT/catalog"
prepare_runtime_directory "$RUNTIME_DATA_ROOT/cameraagent/identity"
prepare_runtime_directory "$RUNTIME_DATA_ROOT/cameraagent/dataprotection"
prepare_runtime_directory "$RUNTIME_DATA_ROOT/cameraagent/provisioning"
prepare_runtime_directory "$RUNTIME_DATA_ROOT/agent"
prepare_runtime_directory "$RUNTIME_DATA_ROOT/archive"
docker compose -f docker-compose.apps.yml up -d "${START_SERVICES[@]}"

echo "Application containers started. Shared dependencies remain managed on hvo-docker."
