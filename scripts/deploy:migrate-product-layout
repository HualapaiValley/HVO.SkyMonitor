#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
umask 077

usage() { printf 'Usage: %s <apply|verify|rollback|finalize> --legacy-root ABS --product-root ABS --instance-id UUID --application-id ID [--bound-device-id ID] --catalog-id ID --evidence ABS [--cutover-evidence ABS]\n' "${0##*/}" >&2; exit 2; }
action="${1:-}"; shift || true
legacy_root= product_root= instance_id= application_id= bound_device_id= catalog_id= evidence= cutover_evidence=
while (( $# )); do case "$1" in
  --legacy-root) legacy_root="${2:-}"; shift 2 ;; --product-root) product_root="${2:-}"; shift 2 ;;
  --instance-id) instance_id="${2:-}"; shift 2 ;; --application-id) application_id="${2:-}"; shift 2 ;;
  --bound-device-id) bound_device_id="${2:-}"; shift 2 ;;
  --catalog-id) catalog_id="${2:-}"; shift 2 ;; --evidence) evidence="${2:-}"; shift 2 ;;
  --cutover-evidence) cutover_evidence="${2:-}"; shift 2 ;; *) usage ;; esac; done
[[ "$action" == apply || "$action" == verify || "$action" == rollback || "$action" == finalize ]] || usage
[[ -n "$legacy_root" && -n "$product_root" && -n "$instance_id" && -n "$application_id" && -n "$catalog_id" && -n "$evidence" ]] || usage

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/deploy/common.sh"
. "$SCRIPT_DIR/deploy/product-layout.sh"
# shellcheck source=scripts/catalog/catalog-common.sh
. "$SCRIPT_DIR/catalog/catalog-common.sh"
deploy_require_commands cat cmp cp dirname find flock jq mkdir mktemp mv readlink realpath rm sha256sum sort sqlite3 stat sync wc
for path in "$legacy_root" "$product_root" "$evidence"; do
  deploy_is_safe_absolute_path "$path" && [[ "$(realpath -m -- "$path")" == "$path" ]] || { printf 'Unsafe or noncanonical migration path.\n' >&2; exit 1; }
done
if [[ -n "$cutover_evidence" ]]; then deploy_is_safe_absolute_path "$cutover_evidence" && [[ "$(realpath -m -- "$cutover_evidence")" == "$cutover_evidence" ]] || { printf 'Cutover evidence path is unsafe.\n' >&2; exit 1; }; fi
deploy_is_canonical_uuid "$instance_id" || { printf 'Instance ID must be a canonical lowercase UUID.\n' >&2; exit 1; }
deploy_is_catalog_id "$catalog_id" || { printf 'Catalog ID is invalid.\n' >&2; exit 1; }
[[ "$application_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || { printf 'Application ID is invalid.\n' >&2; exit 1; }
[[ -z "$bound_device_id" || "$bound_device_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || { printf 'Bound device ID is invalid.\n' >&2; exit 1; }
legacy_config="$legacy_root/config/cameraagent"; legacy_state="$legacy_root/data/agent"; legacy_catalog="$legacy_root/data/catalog"
for source_tree in "$legacy_config" "$legacy_state" "$legacy_catalog"; do
  [[ "$product_root" != "$source_tree" && "$product_root" != "$source_tree"/* && "$source_tree" != "$product_root"/* ]] ||
    { printf 'Product root must not overlap a migrated legacy source tree.\n' >&2; exit 1; }
done
instance_root="$product_root/cameraagents/$instance_id"; catalog_root="$product_root/catalogs/$catalog_id"
manifest="$instance_root/instance-manifest.json"; binding="$instance_root/application-identity.json"
lock="${product_root}.migration.lock"; intent="${evidence}.finalize-intent.json"
apply_intent="${evidence}.apply-intent.json"
rollback_intent="${evidence}.rollback-intent.json"
instance_stage="$product_root/cameraagents/.hvo-migration-$instance_id.stage"; catalog_stage="$product_root/catalogs/.hvo-migration-$instance_id.stage"
config_snapshot="${evidence}.config.snapshot"; state_snapshot="${evidence}.state.snapshot"; catalog_snapshot="${evidence}.catalog.snapshot"
final_config_snapshot="${evidence}.final-config.snapshot"; final_state_snapshot="${evidence}.final-state.snapshot"
cutover_snapshot="${evidence}.cutover.snapshot"
config_tomb="${legacy_config}.hvo-migration-$instance_id"; state_tomb="${legacy_state}.hvo-migration-$instance_id"

paths_overlap() { [[ "$1" == "$2" || "$1" == "$2"/* || "$2" == "$1"/* ]]; }
migration_metadata_paths=("$evidence" "$intent" "$apply_intent" "$rollback_intent" "$config_snapshot" "$state_snapshot" "$catalog_snapshot" \
  "$final_config_snapshot" "$final_state_snapshot" "$cutover_snapshot")
[[ -z "$cutover_evidence" ]] || migration_metadata_paths+=("$cutover_evidence")
migration_controlled_paths=("$legacy_config" "$legacy_state" "$legacy_catalog" "$instance_root" "$catalog_root" "$instance_stage" "$catalog_stage" \
  "$config_tomb" "$state_tomb" "$lock")
for metadata_path in "${migration_metadata_paths[@]}"; do
  for controlled_path in "${migration_controlled_paths[@]}"; do
    paths_overlap "$metadata_path" "$controlled_path" && { printf 'Migration metadata path overlaps migration-controlled state.\n' >&2; exit 1; }
  done
done
for ((metadata_index=0; metadata_index<${#migration_metadata_paths[@]}; metadata_index++)); do
  for ((other_index=metadata_index+1; other_index<${#migration_metadata_paths[@]}; other_index++)); do
    paths_overlap "${migration_metadata_paths[metadata_index]}" "${migration_metadata_paths[other_index]}" &&
      { printf 'Migration metadata paths overlap one another.\n' >&2; exit 1; }
  done
done

ensure_private_directory() {
  local directory="$1" current=/ component owner mode
  [[ "$directory" == /* && "$directory" != / ]] || return 1
  IFS=/ read -r -a components <<< "${directory#/}"
  for component in "${components[@]}"; do
    [[ -n "$component" ]] || continue
    [[ "$current" == / ]] && current="/$component" || current="$current/$component"
    [[ -e "$current" || -L "$current" ]] || break
    [[ -d "$current" && ! -L "$current" ]] || return 1
    owner="$(stat -c %u -- "$current")"; mode="$(stat -c %a -- "$current")"
    [[ "$owner" == "$(id -u)" || "$owner" == 0 ]] || return 1
    if (( (8#$mode & 0022) != 0 )); then
      (( owner == 0 && (8#$mode & 01000) != 0 )) || return 1
    fi
  done
  mkdir -m 700 -p -- "$directory" || return 1
  [[ -d "$directory" && ! -L "$directory" && "$(stat -c '%u:%g' -- "$directory")" == "$(id -u):$(id -g)" ]] || return 1
  mode="$(stat -c %a -- "$directory")"; (( (8#$mode & 0022) == 0 ))
}

validate_metadata_file() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" && "$(stat -c '%u:%g:%h:%a' -- "$path")" == "$(id -u):$(id -g):1:600" ]]
}

migration_transform_command_succeeds() {
  [[ "${HVO_MIGRATION_TEST_MODE:-}" != true || "${HVO_MIGRATION_TEST_FAIL_COMMAND_AT:-}" != "$1" ]]
}
snapshot_tree() {
  local root="$1" output="$2" root_device path relative kind target resolved metadata uid gid mode device inode links hash
  local traversal sorted records
  [[ -d "$root" && ! -L "$root" ]] || return 1
  traversal="$(mktemp)" || return 1
  sorted="$(mktemp)" || { rm -f -- "$traversal"; return 1; }
  records="$(mktemp)" || { rm -f -- "$traversal" "$sorted"; return 1; }
  if ! migration_transform_command_succeeds snapshot-root-stat ||
     ! root_device="$(stat -c %d -- "$root")"; then
    rm -f -- "$traversal" "$sorted" "$records"
    return 1
  fi
  if ! migration_transform_command_succeeds snapshot-find ||
     ! { printf '%s\0' "$root"; find -P "$root" -mindepth 1 -print0; } > "$traversal"; then
    rm -f -- "$traversal" "$sorted" "$records"
    return 1
  fi
  if ! migration_transform_command_succeeds snapshot-sort || ! sort -z "$traversal" > "$sorted"; then
    rm -f -- "$traversal" "$sorted" "$records"
    return 1
  fi
  while IFS= read -r -d '' path; do
    migration_transform_command_succeeds snapshot-entry-device-stat || { rm -f -- "$traversal" "$sorted" "$records"; return 1; }
    [[ "$(stat -c %d -- "$path")" == "$root_device" ]] || { printf 'Nested device or mount crossing rejected: %s\n' "$path" >&2; rm -f -- "$traversal" "$sorted" "$records"; return 1; }
    relative=.; [[ "$path" == "$root" ]] || relative="${path#"$root"/}"
    [[ "$relative" != *$'\t'* && "$relative" != *$'\n'* ]] || { printf 'Tab or newline in migration path rejected: %q\n' "$path" >&2; rm -f -- "$traversal" "$sorted" "$records"; return 1; }
    migration_transform_command_succeeds snapshot-entry-stat || { rm -f -- "$traversal" "$sorted" "$records"; return 1; }
    read -r uid gid mode device inode links < <(stat -c '%u %g %a %d %i %h' -- "$path") || { rm -f -- "$traversal" "$sorted" "$records"; return 1; }
    printf -v metadata '%s\t%s\t%s\t%s\t%s\t%s' "$uid" "$gid" "$mode" "$device" "$inode" "$links"
    if [[ -L "$path" ]]; then
      IFS= read -r -d '' target < <(readlink -z -- "$path") || { rm -f -- "$traversal" "$sorted" "$records"; return 1; }
      [[ "$target" != *$'\t'* && "$target" != *$'\n'* ]] || { printf 'Tab or newline in symlink target rejected: %q\n' "$path" >&2; rm -f -- "$traversal" "$sorted" "$records"; return 1; }
      [[ "$target" != /* ]] || { printf 'Absolute symlink rejected: %s\n' "$path" >&2; rm -f -- "$traversal" "$sorted" "$records"; return 1; }
      resolved="$(realpath -m -- "$(dirname -- "$path")/$target")" || { rm -f -- "$traversal" "$sorted" "$records"; return 1; }
      [[ "$resolved" == "$root" || "$resolved" == "$root"/* ]] || { printf 'Escaping symlink rejected: %s\n' "$path" >&2; rm -f -- "$traversal" "$sorted" "$records"; return 1; }
      kind=link; printf '%s\t%s\t%s\t%s\n' "$kind" "$metadata" "$relative" "$target" >> "$records" || { rm -f -- "$traversal" "$sorted" "$records"; return 1; }
    elif [[ -d "$path" ]]; then kind=directory; printf '%s\t%s\t%s\t-\n' "$kind" "$metadata" "$relative" >> "$records" || { rm -f -- "$traversal" "$sorted" "$records"; return 1; }
    elif [[ -f "$path" && "$links" == 1 ]]; then
      migration_transform_command_succeeds snapshot-file-hash || { rm -f -- "$traversal" "$sorted" "$records"; return 1; }
      hash="$(sha256sum -- "$path")" || { rm -f -- "$traversal" "$sorted" "$records"; return 1; }
      hash="${hash%% *}"
      kind=file; printf '%s\t%s\t%s\t%s\n' "$kind" "$metadata" "$relative" "$hash" >> "$records" || { rm -f -- "$traversal" "$sorted" "$records"; return 1; }
    else printf 'Special or multiply-linked migration entry rejected: %s\n' "$path" >&2; rm -f -- "$traversal" "$sorted" "$records"; return 1; fi
  done < "$sorted"
  migration_transform_command_succeeds snapshot-output || { rm -f -- "$traversal" "$sorted" "$records"; return 1; }
  cat -- "$records" > "$output" || { rm -f -- "$traversal" "$sorted" "$records"; return 1; }
  rm -f -- "$traversal" "$sorted" "$records"
}

content_tree() { cut -f1-4,7-9 "$1" || return 1; }
capture_tree() {
  local root="$1" output="$2" temporary parent
  parent="$(dirname -- "$output")"; ensure_private_directory "$parent" || return 1
  temporary="$(mktemp "${output}.tmp.XXXXXX")" || return 1
  chmod 600 "$temporary" || return 1
  snapshot_tree "$root" "$temporary" && sync -f "$temporary" && migration_lock_barrier &&
    mv -T -- "$temporary" "$output" && sync -f "$parent" && migration_lock_barrier
}
revalidate_tree() { local root="$1" expected="$2" actual; actual="$(mktemp)" || return 1; snapshot_tree "$root" "$actual" && cmp -s "$expected" "$actual"; local status=$?; rm -f -- "$actual" || return 1; return "$status"; }
verify_copy() { local source="$1" destination="$2" a b; a="$(mktemp)" || return 1; b="$(mktemp)" || { rm -f -- "$a"; return 1; }; snapshot_tree "$source" "$a" && snapshot_tree "$destination" "$b" && content_tree "$a" > "$a.content" && content_tree "$b" > "$b.content" && cmp -s "$a.content" "$b.content"; local status=$?; rm -f -- "$a" "$b" "$a.content" "$b.content" || return 1; return "$status"; }
verify_snapshot_copy() { local destination="$1" expected="$2" actual; actual="$(mktemp)" || return 1; snapshot_tree "$destination" "$actual" && content_tree "$expected" > "$actual.expected" && content_tree "$actual" > "$actual.content" && cmp -s "$actual.expected" "$actual.content"; local status=$?; rm -f -- "$actual" "$actual.expected" "$actual.content" || return 1; return "$status"; }
filter_catalog_payload() { awk -F '\t' '$8 != ".catalog.lock" && $8 != ".catalog-lineage.json"' "$1" || return 1; }
revalidate_catalog_payload() {
  local root="$1" expected="$2" actual expected_payload actual_payload status
  actual="$(mktemp)" || return 1; expected_payload="$(mktemp)" || { rm -f -- "$actual"; return 1; }
  actual_payload="$(mktemp)" || { rm -f -- "$actual" "$expected_payload"; return 1; }
  snapshot_tree "$root" "$actual" || { rm -f -- "$actual" "$expected_payload" "$actual_payload"; return 1; }
  if ! migration_transform_command_succeeds revalidate-catalog-expected-filter ||
     ! filter_catalog_payload "$expected" > "$expected_payload"; then
    rm -f -- "$actual" "$expected_payload" "$actual_payload"
    return 1
  fi
  if ! migration_transform_command_succeeds revalidate-catalog-actual-filter ||
     ! filter_catalog_payload "$actual" > "$actual_payload"; then
    rm -f -- "$actual" "$expected_payload" "$actual_payload"
    return 1
  fi
  migration_transform_command_succeeds revalidate-catalog-cmp || { rm -f -- "$actual" "$expected_payload" "$actual_payload"; return 1; }
  if cmp -s "$expected_payload" "$actual_payload"; then status=0; else status=$?; fi
  rm -f -- "$actual" "$expected_payload" "$actual_payload" || return 1
  return "$status"
}
verify_catalog_snapshot_copy() {
  local destination="$1" expected="$2" actual expected_payload actual_payload status
  actual="$(mktemp)" || return 1; expected_payload="$(mktemp)" || { rm -f -- "$actual"; return 1; }
  actual_payload="$(mktemp)" || { rm -f -- "$actual" "$expected_payload"; return 1; }
  snapshot_tree "$destination" "$actual" || { rm -f -- "$actual" "$expected_payload" "$actual_payload"; return 1; }
  if ! migration_transform_command_succeeds verify-catalog-expected-filter ||
     ! filter_catalog_payload "$expected" > "$expected_payload"; then
    rm -f -- "$actual" "$expected_payload" "$actual_payload"
    return 1
  fi
  if ! migration_transform_command_succeeds verify-catalog-actual-filter ||
     ! filter_catalog_payload "$actual" > "$actual_payload"; then
    rm -f -- "$actual" "$expected_payload" "$actual_payload"
    return 1
  fi
  if ! migration_transform_command_succeeds verify-catalog-expected-content ||
     ! content_tree "$expected_payload" > "$actual.expected"; then
    rm -f -- "$actual" "$expected_payload" "$actual_payload" "$actual.expected" "$actual.content"
    return 1
  fi
  if ! migration_transform_command_succeeds verify-catalog-actual-content ||
     ! content_tree "$actual_payload" > "$actual.content"; then
    rm -f -- "$actual" "$expected_payload" "$actual_payload" "$actual.expected" "$actual.content"
    return 1
  fi
  migration_transform_command_succeeds verify-catalog-cmp || {
    rm -f -- "$actual" "$expected_payload" "$actual_payload" "$actual.expected" "$actual.content"
    return 1
  }
  if cmp -s "$actual.expected" "$actual.content"; then status=0; else status=$?; fi
  rm -f -- "$actual" "$expected_payload" "$actual_payload" "$actual.expected" "$actual.content" || return 1
  return "$status"
}
validate_snapshot_subset() {
  local root="$1" expected="$2" actual status
  actual="$(mktemp)" || return 1; snapshot_tree "$root" "$actual" || { rm -f -- "$actual"; return 1; }
  awk -F '\t' '
    function comparable(kind, line, f,n) { n=split(line,f,"\t"); return kind=="directory" ? f[1] FS f[2] FS f[3] FS f[4] FS f[5] FS f[6] FS f[8] FS f[9] : line }
    NR==FNR { expected[$8]=comparable($1,$0); next }
    !($8 in expected) || expected[$8] != comparable($1,$0) { exit 1 }
    $8=="." { root_seen=1 }
    END { if (!root_seen) exit 1 }' "$expected" "$actual"; status=$?; rm -f -- "$actual" || return 1; return "$status"
}
validate_copy_subset() {
  local root="$1" expected="$2" actual status
  actual="$(mktemp)" || return 1; snapshot_tree "$root" "$actual" || { rm -f -- "$actual"; return 1; }
  awk -F '\t' '
    function comparable(kind, line, f,n) { n=split(line,f,"\t"); return kind=="directory" ? f[1] FS f[2] FS f[3] FS f[4] FS f[8] FS f[9] : f[1] FS f[2] FS f[3] FS f[4] FS f[7] FS f[8] FS f[9] }
    NR==FNR { expected[$8]=comparable($1,$0); next }
    !($8 in expected) || expected[$8] != comparable($1,$0) { exit 1 }
    $8=="." { root_seen=1 }
    END { if (!root_seen) exit 1 }' "$expected" "$actual"; status=$?; rm -f -- "$actual" || return 1; return "$status"
}
validate_catalog_copy_subset() {
  local root="$1" expected="$2" actual expected_payload actual_payload status
  actual="$(mktemp)" || return 1; expected_payload="$(mktemp)" || { rm -f -- "$actual"; return 1; }
  actual_payload="$(mktemp)" || { rm -f -- "$actual" "$expected_payload"; return 1; }
  snapshot_tree "$root" "$actual" || { rm -f -- "$actual" "$expected_payload" "$actual_payload"; return 1; }
  if ! migration_transform_command_succeeds validate-catalog-expected-filter ||
     ! awk -F '\t' '$8 != ".catalog.lock"' "$expected" > "$expected_payload"; then
    rm -f -- "$actual" "$expected_payload" "$actual_payload"
    return 1
  fi
  if ! migration_transform_command_succeeds validate-catalog-actual-filter ||
     ! awk -F '\t' '$8 != ".catalog.lock"' "$actual" > "$actual_payload"; then
    rm -f -- "$actual" "$expected_payload" "$actual_payload"
    return 1
  fi
  migration_transform_command_succeeds validate-catalog-subset || {
    rm -f -- "$actual" "$expected_payload" "$actual_payload"
    return 1
  }
  if awk -F '\t' '
    function comparable(kind, line, f,n) { n=split(line,f,"\t"); return kind=="directory" ? f[1] FS f[2] FS f[3] FS f[4] FS f[8] FS f[9] : f[1] FS f[2] FS f[3] FS f[4] FS f[7] FS f[8] FS f[9] }
    NR==FNR { expected[$8]=comparable($1,$0); next }
    !($8 in expected) || expected[$8] != comparable($1,$0) { exit 1 }
    $8=="." { root_seen=1 }
    END { if (!root_seen) exit 1 }' "$expected_payload" "$actual_payload"; then status=0; else status=$?; fi
  rm -f -- "$actual" "$expected_payload" "$actual_payload" || return 1
  return "$status"
}
validate_stage_root() {
  local stage="$1" parent="$2" mode
  [[ -d "$stage" && ! -L "$stage" && "$(stat -c '%u:%g:%d' "$stage")" == "$(id -u):$(id -g):$(stat -c %d "$parent")" ]] || return 1
  mode="$(stat -c %a "$stage")"; (( (8#$mode & 0022) == 0 ))
}
validate_instance_identity_file() {
  local path="$1" kind="$2" root="$3"
  [[ -f "$path" && ! -L "$path" && "$(stat -c '%u:%g:%h:%a:%d' "$path")" == "$(id -u):$(id -g):1:600:$(stat -c %d "$root")" ]] || return 1
  if [[ "$kind" == manifest ]]; then
    jq -e --arg instance "$instance_id" '(keys | sort) == (["applicationIdentityFile","component","creationProvenance","instanceId","product","schemaVersion"] | sort) and
      .schemaVersion == 1 and .product == "HVO.SkyMonitor" and .component == "cameraAgent" and
      .instanceId == $instance and .creationProvenance == {migration:"singular-layout-v1"} and
      .applicationIdentityFile == "application-identity.json"' "$path" >/dev/null
  else
    jq -e --arg configured "$application_id" --arg bound "$bound_device_id" '(keys | sort) == (["boundIdentity","configuredIdentity","schemaVersion","state"] | sort) and .schemaVersion == 1 and
      .configuredIdentity == $configured and .state == (if $bound == "" then "pre-provisioning" else "bound" end) and
      .boundIdentity == (if $bound == "" then null else $bound end)' "$path" >/dev/null
  fi
}
validate_instance_tree_for_removal() {
  local root="$1" parent="$2" completeness="$3" config_expected="${4:-$config_snapshot}" state_expected="${5:-$state_snapshot}" path name
  local have_config=false have_state=false have_manifest=false have_binding=false
  validate_stage_root "$root" "$parent" || return 1
  while IFS= read -r path; do
    name="${path##*/}"
    case "$name" in
      config) have_config=true; [[ -d "$path" && ! -L "$path" ]] || return 1 ;;
      state) have_state=true; [[ -d "$path" && ! -L "$path" ]] || return 1 ;;
      instance-manifest.json) have_manifest=true; validate_instance_identity_file "$path" manifest "$root" || return 1 ;;
      application-identity.json) have_binding=true; validate_instance_identity_file "$path" binding "$root" || return 1 ;;
      *) return 1 ;;
    esac
  done < <(find -P "$root" -mindepth 1 -maxdepth 1 -print)
  [[ "$have_config" == false ]] || validate_copy_subset "$root/config" "$config_expected" || return 1
  [[ "$have_state" == false ]] || validate_copy_subset "$root/state" "$state_expected" || return 1
  if [[ "$completeness" == complete ]]; then
    [[ "$have_config" == true && "$have_state" == true && "$have_manifest" == true && "$have_binding" == true ]] || return 1
  else [[ "$completeness" == partial ]] || return 1; fi
}
delete_instance_tree() {
  local root="$1" label="${2:-}" config_expected="${3:-$config_snapshot}" state_expected="${4:-$state_snapshot}" path
  [[ ! -e "$root/config" ]] || delete_copy_subset "$root/config" "$config_expected" || return 1
  [[ -z "$label" ]] || failpoint "after-delete-$label-config"
  [[ ! -e "$root/state" ]] || delete_copy_subset "$root/state" "$state_expected" || return 1
  [[ -z "$label" ]] || failpoint "after-delete-$label-state"
  for path in "$root/instance-manifest.json" "$root/application-identity.json"; do
    [[ ! -e "$path" && ! -L "$path" ]] || delete_validated_entry "$root" "$path" || return 1
  done
  migration_lock_barrier || return 1
  rmdir -- "$root" || return 1
  migration_lock_barrier || return 1
}
partial_delete_one() {
  local root="$1" victim
  victim="$(find -P "$root" -xdev -depth -mindepth 1 ! -type d -print -quit)"; [[ -n "$victim" ]] || return 1
  [[ "$victim" == "$root"/* && ! -d "$victim" ]] || return 1
  migration_lock_barrier && rm -f -- "$victim" && sync -f "$root" && migration_lock_barrier
}
delete_validated_entry() {
  local root="$1" victim="$2" parent mode status
  parent="$(dirname -- "$victim")"
  [[ "$parent" == "$root" || "$parent" == "$root"/* ]] || return 1
  [[ -d "$parent" && ! -L "$parent" && "$(stat -c '%u:%d' -- "$parent")" == "$(id -u):$(stat -c %d -- "$root")" ]] || return 1
  mode="$(stat -c %a -- "$parent")"
  migration_lock_barrier || return 1
  chmod u+w -- "$parent" || return 1
  migration_lock_barrier migration-destructive-entry || return 1
  if [[ -d "$victim" && ! -L "$victim" ]]; then rmdir -- "$victim"; else rm -f -- "$victim"; fi
  status=$?
  migration_lock_barrier || return 1
  chmod "$mode" -- "$parent" || return 1
  migration_lock_barrier || return 1
  return "$status"
}
delete_snapshot_subset() {
  local root="$1" expected="$2" victim
  while :; do
    validate_snapshot_subset "$root" "$expected" || return 1
    victim="$(find -P "$root" -xdev -depth -mindepth 1 -print -quit)"
    [[ -n "$victim" ]] || break
    [[ "$victim" == "$root"/* ]] || return 1
    delete_validated_entry "$root" "$victim" || return 1
  done
  validate_snapshot_subset "$root" "$expected" && migration_lock_barrier && rmdir -- "$root" && migration_lock_barrier
}
delete_copy_subset() {
  local root="$1" expected="$2" victim
  while :; do
    validate_copy_subset "$root" "$expected" || return 1
    victim="$(find -P "$root" -xdev -depth -mindepth 1 -print -quit)"
    [[ -n "$victim" ]] || break
    [[ "$victim" == "$root"/* ]] || return 1
    delete_validated_entry "$root" "$victim" || return 1
  done
  validate_copy_subset "$root" "$expected" && migration_lock_barrier && rmdir -- "$root" && migration_lock_barrier
}
delete_catalog_copy_subset() {
  local root="$1" expected="$2" victim lock_path="$1/.catalog.lock"
  while :; do
    validate_catalog_copy_subset "$root" "$expected" || return 1
    victim="$(find -P "$root" -xdev -depth -mindepth 1 ! -path "$lock_path" -print -quit)"
    [[ -n "$victim" ]] || break
    [[ "$victim" == "$root"/* ]] || return 1
    delete_validated_entry "$root" "$victim" || return 1
  done
  validate_catalog_copy_subset "$root" "$expected" && revalidate_staged_catalog_lock &&
    delete_validated_entry "$root" "$lock_path" && migration_lock_barrier && rmdir -- "$root" && migration_lock_barrier
}
publish_json() {
  local path="$1" json="$2" temporary parent barrier_label=''
  parent="$(dirname -- "$path")"; ensure_private_directory "$parent" || return 1
  temporary="$(mktemp "${path}.tmp.XXXXXX")" || return 1
  chmod 600 "$temporary" || return 1
  printf '%s\n' "$json" > "$temporary" || return 1
  sync -f "$temporary" || return 1
  case "$path" in
    "$evidence")
      case "$(jq -r '.status // empty' <<< "$json")" in
        copied-and-verified) barrier_label=apply-evidence-publication ;;
        finalized-removal-pending) barrier_label=finalize-pending-evidence-publication ;;
        finalized) barrier_label=finalize-final-evidence-publication ;;
      esac
      ;;
    "$rollback_intent")
      case "$(jq -r '.state // empty' <<< "$json")" in
        deletion-pending) barrier_label=rollback-deletion-intent-publication ;;
        cleanup-pending) barrier_label=rollback-cleanup-intent-publication ;;
      esac
      ;;
    "$intent") barrier_label=finalize-intent-publication ;;
  esac
  migration_lock_barrier "$barrier_label" || return 1
  mv -Tf -- "$temporary" "$path" || return 1
  sync -f "$parent" || return 1
  migration_lock_barrier || return 1
}
pin_cutover_evidence() {
  local source="$1" output="$2" source_fd source_identity fd_identity temporary parent status
  validate_metadata_file "$source" || return 1
  exec {source_fd}<"$source" || return 1
  if ! validate_metadata_file "$source" ||
     [[ "$(stat -Lc '%u:%g:%h:%a' -- "/proc/$$/fd/$source_fd")" != "$(id -u):$(id -g):1:600" ]]; then
    exec {source_fd}<&-
    return 1
  fi
  source_identity="$(stat -Lc '%d:%i' -- "$source")"
  fd_identity="$(stat -Lc '%d:%i' -- "/proc/$$/fd/$source_fd")"
  if [[ "$source_identity" != "$fd_identity" ]]; then
    exec {source_fd}<&-
    return 1
  fi
  parent="$(dirname -- "$output")"; ensure_private_directory "$parent" || { exec {source_fd}<&-; return 1; }
  temporary="$(mktemp "${output}.tmp.XXXXXX")" || { exec {source_fd}<&-; return 1; }
  chmod 600 "$temporary" || { exec {source_fd}<&-; return 1; }
  if cat <&"$source_fd" > "$temporary" && sync -f "$temporary"; then status=0; else status=$?; fi
  exec {source_fd}<&-
  (( status == 0 )) || { rm -f -- "$temporary"; return "$status"; }
  if [[ -e "$output" || -L "$output" ]]; then
    if validate_metadata_file "$output" && cmp -s "$output" "$temporary"; then status=0; else status=$?; fi
    rm -f -- "$temporary" || return 1
    return "$status"
  fi
  migration_lock_barrier || return 1
  mv -T -- "$temporary" "$output" || return 1
  sync -f "$parent" || return 1
  migration_lock_barrier || return 1
}
failpoint() { [[ "${DEPLOY_MIGRATION_FAILPOINT:-}" != "$1" ]] || exit 75; }
catalog_manifest_identity() {
  local manifest="$1" bundle="$2" identity package_version
  [[ "$(jq -er '.manifestVersion' "$manifest")" == 2 ]] || return 1
  package_version="$(jq -er '.package.version | select(type == "string")' "$manifest")" || return 1
  [[ "${bundle##*/}" == "$package_version" ]] || return 1
  identity="$(hyg_resolve_catalog_identity "$bundle")" || return 1
  printf '%s\texplicit-manifest-v2\n' "$identity"
}
validate_catalog_control_files() {
  local root="$1" expected_id="$2" expected_kind="$3" expected_schema="$4" expected_preprocessing="$5"
  local lock="$root/.catalog.lock" lineage="$root/.catalog-lineage.json" path name expected_package_lineage
  while IFS= read -r -d '' path; do
    name="${path##*/}"
    [[ "$name" == .catalog.lock || "$name" == .catalog-lineage.json ]] || return 1
  done < <(find -P "$root" -mindepth 1 -maxdepth 1 -name '.catalog*' -print0)
  if [[ -e "$lock" || -L "$lock" ]]; then
    [[ -f "$lock" && ! -L "$lock" &&
       "$(stat -c '%u:%h:%a' -- "$lock")" == "$(id -u):1:600" ]] || return 1
  fi
  if [[ -e "$lineage" || -L "$lineage" ]]; then
    [[ -f "$lock" && ! -L "$lock" && -f "$lineage" && ! -L "$lineage" &&
       "$(stat -c '%u:%h:%a' -- "$lineage")" == "$(id -u):1:600" ]] || return 1
    hyg_validate_manifest_document "$lineage" || return 1
    expected_package_lineage="$(hyg_catalog_package_lineage "$expected_kind" "$expected_schema" "$expected_preprocessing")" || return 1
    jq -e --arg id "$expected_id" --arg kind "$expected_kind" --arg packageLineage "$expected_package_lineage" '
      (keys | sort) == (["catalogId","packageKind","packageLineage","schemaVersion"] | sort) and
      .schemaVersion == 1 and .catalogId == $id and .packageKind == $kind and .packageLineage == $packageLineage' \
      "$lineage" >/dev/null || return 1
  fi
}

legacy_catalog_lock_fd=''
legacy_catalog_lock_identity=''
legacy_catalog_lock_metadata=''
acquire_legacy_catalog_lock() {
  local lock_path="$legacy_catalog/.catalog.lock" path_identity fd_identity path_metadata fd_metadata
  if [[ ! -e "$lock_path" && ! -L "$lock_path" ]]; then
    legacy_catalog_lock_fd=''; legacy_catalog_lock_identity=''; legacy_catalog_lock_metadata=''
    return 0
  fi
  [[ -f "$lock_path" && ! -L "$lock_path" &&
     "$(stat -c '%u:%h:%a' -- "$lock_path")" == "$(id -u):1:600" ]] || return 1
  exec {legacy_catalog_lock_fd}<>"$lock_path" || return 1
  if ! flock -x "$legacy_catalog_lock_fd"; then exec {legacy_catalog_lock_fd}>&-; legacy_catalog_lock_fd=''; return 1; fi
  [[ -f "$lock_path" && ! -L "$lock_path" &&
     "$(stat -c '%u:%h:%a' -- "$lock_path")" == "$(id -u):1:600" &&
     "$(stat -Lc '%u:%h:%a' -- "/proc/$$/fd/$legacy_catalog_lock_fd")" == "$(id -u):1:600" ]] || return 1
  path_identity="$(stat -Lc '%d:%i' -- "$lock_path")"
  fd_identity="$(stat -Lc '%d:%i' -- "/proc/$$/fd/$legacy_catalog_lock_fd")"
  path_metadata="$(stat -Lc '%u:%g:%h:%a' -- "$lock_path")"
  fd_metadata="$(stat -Lc '%u:%g:%h:%a' -- "/proc/$$/fd/$legacy_catalog_lock_fd")"
  [[ "$path_identity" == "$fd_identity" && "$path_metadata" == "$fd_metadata" ]] || return 1
  legacy_catalog_lock_identity="$fd_identity"
  legacy_catalog_lock_metadata="$fd_metadata"
}

revalidate_legacy_catalog_lock() {
  local lock_path="$legacy_catalog/.catalog.lock"
  if [[ -z "$legacy_catalog_lock_fd" ]]; then
    [[ ! -e "$lock_path" && ! -L "$lock_path" ]]
  else
    [[ -f "$lock_path" && ! -L "$lock_path" &&
       "$(stat -c '%u:%h:%a' -- "$lock_path")" == "$(id -u):1:600" &&
       "$(stat -Lc '%d:%i' -- "$lock_path")" == "$legacy_catalog_lock_identity" &&
       "$(stat -Lc '%d:%i' -- "/proc/$$/fd/$legacy_catalog_lock_fd")" == "$legacy_catalog_lock_identity" &&
       "$(stat -Lc '%u:%g:%h:%a' -- "$lock_path")" == "$legacy_catalog_lock_metadata" &&
       "$(stat -Lc '%u:%g:%h:%a' -- "/proc/$$/fd/$legacy_catalog_lock_fd")" == "$legacy_catalog_lock_metadata" ]]
  fi
}

staged_catalog_lock_fd=''
staged_catalog_lock_identity=''
staged_catalog_lock_metadata=''
published_catalog_lock_fd=''
published_catalog_lock_identity=''
published_catalog_lock_metadata=''
acquire_catalog_root_lock() {
  local root="$1" fd_name="$2" identity_name="$3" metadata_name="$4"
  local lock_path="$root/.catalog.lock" fd path_identity fd_identity path_metadata fd_metadata
  [[ -d "$root" && ! -L "$root" && "$(stat -c %u -- "$root")" == "$(id -u)" ]] || return 1
  if [[ ! -e "$lock_path" && ! -L "$lock_path" ]]; then
    (set -o noclobber; umask 077; : > "$lock_path") 2>/dev/null || true
  fi
  [[ -f "$lock_path" && ! -L "$lock_path" &&
     "$(stat -c '%u:%h:%a' -- "$lock_path")" == "$(id -u):1:600" ]] || return 1
  exec {fd}<>"$lock_path" || return 1
  if ! flock -x "$fd"; then exec {fd}>&-; return 1; fi
  if [[ ! -f "$lock_path" || -L "$lock_path" ||
        "$(stat -c '%u:%h:%a' -- "$lock_path")" != "$(id -u):1:600" ||
        "$(stat -Lc '%u:%h:%a' -- "/proc/$$/fd/$fd")" != "$(id -u):1:600" ]]; then
    exec {fd}>&-
    return 1
  fi
  path_identity="$(stat -Lc '%d:%i' -- "$lock_path")"
  fd_identity="$(stat -Lc '%d:%i' -- "/proc/$$/fd/$fd")"
  path_metadata="$(stat -Lc '%u:%g:%h:%a' -- "$lock_path")"
  fd_metadata="$(stat -Lc '%u:%g:%h:%a' -- "/proc/$$/fd/$fd")"
  if [[ "$path_identity" != "$fd_identity" || "$path_metadata" != "$fd_metadata" ]]; then
    exec {fd}>&-
    return 1
  fi
  printf -v "$fd_name" '%s' "$fd"
  printf -v "$identity_name" '%s' "$fd_identity"
  printf -v "$metadata_name" '%s' "$fd_metadata"
}

revalidate_catalog_root_lock() {
  local root="$1" fd="$2" identity="$3" metadata="$4" lock_path
  lock_path="$root/.catalog.lock"
  [[ -n "$fd" && -f "$lock_path" && ! -L "$lock_path" &&
     "$(stat -Lc '%d:%i' -- "$lock_path")" == "$identity" &&
     "$(stat -Lc '%d:%i' -- "/proc/$$/fd/$fd")" == "$identity" &&
     "$(stat -Lc '%u:%g:%h:%a' -- "$lock_path")" == "$metadata" &&
     "$(stat -Lc '%u:%g:%h:%a' -- "/proc/$$/fd/$fd")" == "$metadata" ]]
}

acquire_staged_catalog_lock() {
  if [[ -n "$staged_catalog_lock_fd" ]]; then
    revalidate_catalog_root_lock "$catalog_stage" "$staged_catalog_lock_fd" "$staged_catalog_lock_identity" "$staged_catalog_lock_metadata"
    return
  fi
  validate_stage_root "$catalog_stage" "$product_root/catalogs" &&
    acquire_catalog_root_lock "$catalog_stage" staged_catalog_lock_fd staged_catalog_lock_identity staged_catalog_lock_metadata
}

revalidate_staged_catalog_lock() {
  revalidate_catalog_root_lock "$catalog_stage" "$staged_catalog_lock_fd" "$staged_catalog_lock_identity" "$staged_catalog_lock_metadata"
}

release_staged_catalog_lock() {
  [[ -z "$staged_catalog_lock_fd" ]] || exec {staged_catalog_lock_fd}>&-
  staged_catalog_lock_fd=''; staged_catalog_lock_identity=''; staged_catalog_lock_metadata=''
}

acquire_published_catalog_lock() {
  if [[ -n "$published_catalog_lock_fd" ]]; then
    revalidate_catalog_root_lock "$catalog_root" "$published_catalog_lock_fd" "$published_catalog_lock_identity" "$published_catalog_lock_metadata"
    return
  fi
  validate_stage_root "$catalog_root" "$product_root/catalogs" &&
    acquire_catalog_root_lock "$catalog_root" published_catalog_lock_fd published_catalog_lock_identity published_catalog_lock_metadata
}

revalidate_published_catalog_lock() {
  revalidate_catalog_root_lock "$catalog_root" "$published_catalog_lock_fd" "$published_catalog_lock_identity" "$published_catalog_lock_metadata"
}

promote_staged_catalog_lock() {
  published_catalog_lock_fd="$staged_catalog_lock_fd"
  published_catalog_lock_identity="$staged_catalog_lock_identity"
  published_catalog_lock_metadata="$staged_catalog_lock_metadata"
  staged_catalog_lock_fd=''; staged_catalog_lock_identity=''; staged_catalog_lock_metadata=''
  revalidate_published_catalog_lock
}

validate_legacy_catalog_snapshot() {
  local snapshot="$1" manifest="$legacy_catalog/current/manifest.json" bundle identity identity_source kind schema preprocessing
  revalidate_legacy_catalog_lock || return 1
  [[ -f "$manifest" && ! -L "$manifest" ]] || return 1
  bundle="$(realpath -- "$legacy_catalog/current")"
  [[ "$bundle" == "$legacy_catalog/versions/"* && -d "$bundle" && ! -L "$bundle" ]] || return 1
  IFS=$'\t' read -r identity identity_source < <(catalog_manifest_identity "$manifest" "$bundle") || return 1
  [[ "$identity" == "$catalog_id" ]] || return 1
  kind="$(hyg_json_value "$manifest" '$.package.kind')"
  schema="$(hyg_json_value "$manifest" '$.schemaVersion')"
  preprocessing="$(hyg_json_value "$manifest" '$.preprocessingVersion')"
  validate_catalog_control_files "$legacy_catalog" "$identity" "$kind" "$schema" "$preprocessing" &&
    revalidate_catalog_payload "$legacy_catalog" "$snapshot" && revalidate_legacy_catalog_lock
}

validate_apply_intent() {
  local identity_source="$1"
  validate_metadata_file "$apply_intent" && jq -e --arg instance "$instance_id" --arg application "$application_id" --arg bound "$bound_device_id" --arg catalog "$catalog_id" --arg identitySource "$identity_source" --arg legacy "$legacy_root" --arg product "$product_root" --arg instanceStage "$instance_stage" --arg catalogStage "$catalog_stage" '
    (keys | sort) == (["applicationIdentity","boundDeviceIdentity","catalogId","catalogIdentitySource","catalogPreexisting","catalogStage","instanceId","instanceStage","legacyRoot","productRoot","schemaVersion","state"] | sort) and
    .schemaVersion == 1 and .state == "staging" and .instanceId == $instance and .applicationIdentity == $application and
    .boundDeviceIdentity == (if $bound == "" then null else $bound end) and .catalogId == $catalog and .catalogIdentitySource == $identitySource and
    (.catalogPreexisting | type == "boolean") and .legacyRoot == $legacy and .productRoot == $product and
    .instanceStage == $instanceStage and .catalogStage == $catalogStage' "$apply_intent" >/dev/null
}
validate_rollback_evidence() {
  local identity_source="$1"
  validate_metadata_file "$evidence" && jq -e --arg instance "$instance_id" --arg application "$application_id" --arg bound "$bound_device_id" --arg catalog "$catalog_id" --arg identitySource "$identity_source" --arg legacy "$legacy_root" --arg product "$product_root" '
    (keys | sort) == (["applicationIdentity","boundDeviceIdentity","catalogId","catalogIdentitySource","instanceId","legacyCatalogRetained","legacyRetained","legacyRoot","productRoot","schemaVersion","status"] | sort) and
    .schemaVersion == 2 and .status == "copied-and-verified" and .legacyRetained == true and .legacyCatalogRetained == true and
    .instanceId == $instance and .applicationIdentity == $application and
    .boundDeviceIdentity == (if $bound == "" then null else $bound end) and .catalogId == $catalog and .catalogIdentitySource == $identitySource and
    .legacyRoot == $legacy and .productRoot == $product' "$evidence" >/dev/null
}
validate_finalize_evidence() {
  local cutover_sha="$1"
  validate_metadata_file "$evidence" && jq -e --arg instance "$instance_id" --arg application "$application_id" --arg bound "$bound_device_id" --arg catalog "$catalog_id" --arg legacy "$legacy_root" --arg product "$product_root" --arg cutover "$cutover_sha" '
    .schemaVersion == 2 and .instanceId == $instance and .applicationIdentity == $application and
    .boundDeviceIdentity == (if $bound == "" then null else $bound end) and .catalogId == $catalog and
    .catalogIdentitySource == "explicit-manifest-v2" and
    .legacyRoot == $legacy and .productRoot == $product and
    if .status == "copied-and-verified" then
      (keys | sort) == (["applicationIdentity","boundDeviceIdentity","catalogId","catalogIdentitySource","instanceId","legacyCatalogRetained","legacyRetained","legacyRoot","productRoot","schemaVersion","status"] | sort) and .legacyRetained == true and .legacyCatalogRetained == true
    elif .status == "finalized-removal-pending" then
      (keys | sort) == (["applicationIdentity","boundDeviceIdentity","catalogId","catalogIdentitySource","cutoverEvidenceSha256","finalConfigSnapshotSha256","finalStateSnapshotSha256","instanceId","legacyCatalogRetained","legacyRetained","legacyRoot","productRoot","schemaVersion","status"] | sort) and
      .legacyRetained == false and .legacyCatalogRetained == true and .cutoverEvidenceSha256 == $cutover and
      all(.finalConfigSnapshotSha256,.finalStateSnapshotSha256; type == "string" and test("^[0-9a-f]{64}$"))
    elif .status == "finalized" then
      (keys | sort) == (["applicationIdentity","boundDeviceIdentity","catalogId","catalogIdentitySource","cutoverEvidenceSha256","finalConfigSnapshotSha256","finalStateSnapshotSha256","instanceId","legacyCatalogRetained","legacyRetained","legacyRoot","productRoot","schemaVersion","status","tombstonesRemoved"] | sort) and
      .legacyRetained == false and .legacyCatalogRetained == true and .cutoverEvidenceSha256 == $cutover and .tombstonesRemoved == true and
      all(.finalConfigSnapshotSha256,.finalStateSnapshotSha256; type == "string" and test("^[0-9a-f]{64}$"))
    else false end' "$evidence" >/dev/null
}
validate_migration_evidence() {
  validate_metadata_file "$evidence" && jq -e --arg instance "$instance_id" --arg application "$application_id" --arg bound "$bound_device_id" --arg catalog "$catalog_id" --arg legacy "$legacy_root" --arg product "$product_root" '
    .schemaVersion == 2 and .instanceId == $instance and .applicationIdentity == $application and
    .boundDeviceIdentity == (if $bound == "" then null else $bound end) and .catalogId == $catalog and
    .catalogIdentitySource == "explicit-manifest-v2" and
    .legacyRoot == $legacy and .productRoot == $product and
    if .status == "copied-and-verified" then
      (keys | sort) == (["applicationIdentity","boundDeviceIdentity","catalogId","catalogIdentitySource","instanceId","legacyCatalogRetained","legacyRetained","legacyRoot","productRoot","schemaVersion","status"] | sort) and
      .legacyRetained == true and .legacyCatalogRetained == true
    elif .status == "finalized-removal-pending" then
      (keys | sort) == (["applicationIdentity","boundDeviceIdentity","catalogId","catalogIdentitySource","cutoverEvidenceSha256","finalConfigSnapshotSha256","finalStateSnapshotSha256","instanceId","legacyCatalogRetained","legacyRetained","legacyRoot","productRoot","schemaVersion","status"] | sort) and
      .legacyRetained == false and .legacyCatalogRetained == true and all(.cutoverEvidenceSha256,.finalConfigSnapshotSha256,.finalStateSnapshotSha256;
        type == "string" and test("^[0-9a-f]{64}$"))
    elif .status == "finalized" then
      (keys | sort) == (["applicationIdentity","boundDeviceIdentity","catalogId","catalogIdentitySource","cutoverEvidenceSha256","finalConfigSnapshotSha256","finalStateSnapshotSha256","instanceId","legacyCatalogRetained","legacyRetained","legacyRoot","productRoot","schemaVersion","status","tombstonesRemoved"] | sort) and
      .legacyRetained == false and .legacyCatalogRetained == true and all(.cutoverEvidenceSha256,.finalConfigSnapshotSha256,.finalStateSnapshotSha256;
        type == "string" and test("^[0-9a-f]{64}$")) and .tombstonesRemoved == true
    else false end' "$evidence" >/dev/null
}
validate_migration_filesystem_state() {
  local status spec original tomb snapshot
  status="$(jq -r '.status' "$evidence")"
  case "$status" in
  copied-and-verified)
    for spec in "$legacy_config|$config_tomb|$config_snapshot" "$legacy_state|$state_tomb|$state_snapshot"; do
      IFS='|' read -r original tomb snapshot <<< "$spec"
      [[ -d "$original" && ! -L "$original" && ! -e "$tomb" && ! -L "$tomb" ]] || return 1
      revalidate_tree "$original" "$snapshot" || return 1
    done
    [[ -d "$legacy_catalog" && ! -L "$legacy_catalog" ]] && validate_legacy_catalog_snapshot "$catalog_snapshot" || return 1
    ;;
  finalized-removal-pending)
    for spec in "$legacy_config|$config_tomb|$config_snapshot" "$legacy_state|$state_tomb|$state_snapshot"; do
      IFS='|' read -r original tomb snapshot <<< "$spec"
      [[ ! -e "$original" && ! -L "$original" ]] || return 1
      if [[ -e "$tomb" || -L "$tomb" ]]; then validate_snapshot_subset "$tomb" "$snapshot" || return 1; fi
    done
    [[ -d "$legacy_catalog" && ! -L "$legacy_catalog" ]] && validate_legacy_catalog_snapshot "$catalog_snapshot" || return 1
    ;;
  finalized)
    for original in "$legacy_config" "$legacy_state" "$config_tomb" "$state_tomb"; do
      [[ ! -e "$original" && ! -L "$original" ]] || return 1
    done
    [[ -d "$legacy_catalog" && ! -L "$legacy_catalog" ]] && validate_legacy_catalog_snapshot "$catalog_snapshot" || return 1
    ;;
  *) return 1 ;;
  esac
}
validate_finalize_intent() {
  local cutover_sha="$1" config_sha="$2" state_sha="$3"
  validate_metadata_file "$intent" && jq -e --arg instance "$instance_id" --arg c "$config_tomb" --arg s "$state_tomb" \
    --arg cutover "$cutover_sha" --arg cutoverSnapshot "$cutover_snapshot" --arg configSha "$config_sha" --arg stateSha "$state_sha" '
    (keys | sort) == (["cutoverEvidenceSha256","cutoverEvidenceSnapshot","finalConfigSnapshotSha256","finalStateSnapshotSha256","instanceId","legacyCatalogRetained","schemaVersion","state","tombstones"] | sort) and
    .schemaVersion == 1 and .state == "rename-pending" and .instanceId == $instance and
    .cutoverEvidenceSha256 == $cutover and .finalConfigSnapshotSha256 == $configSha and .finalStateSnapshotSha256 == $stateSha and
    .cutoverEvidenceSnapshot == $cutoverSnapshot and .legacyCatalogRetained == true and
    (.tombstones | keys | sort) == (["config","state"] | sort) and .tombstones == {config:$c,state:$s}' "$intent" >/dev/null
}
validate_rollback_intent() {
  validate_metadata_file "$rollback_intent" && jq -e --arg instance "$instance_id" --arg application "$application_id" \
    --arg bound "$bound_device_id" --arg catalog "$catalog_id" --arg legacy "$legacy_root" --arg product "$product_root" \
    '(keys | sort) == (["applicationIdentity","boundDeviceIdentity","catalogId","cutoverEvidenceSha256","finalConfigSnapshotSha256","finalStateSnapshotSha256","instanceId","legacyRoot","productRoot","schemaVersion","state"] | sort) and
     .schemaVersion == 1 and (.state | IN("deletion-pending","cleanup-pending")) and .instanceId == $instance and
     .applicationIdentity == $application and .boundDeviceIdentity == (if $bound == "" then null else $bound end) and
     .catalogId == $catalog and .legacyRoot == $legacy and .productRoot == $product and
     ((.cutoverEvidenceSha256 == null and .finalConfigSnapshotSha256 == null and .finalStateSnapshotSha256 == null) or
      all(.cutoverEvidenceSha256,.finalConfigSnapshotSha256,.finalStateSnapshotSha256;
        type == "string" and test("^[0-9a-f]{64}$")))' "$rollback_intent" >/dev/null
}
rollback_intent_json() {
  local state="$1" cutover_sha="$2" config_sha="$3" state_sha="$4"
  jq -cn --arg state "$state" --arg instance "$instance_id" --arg application "$application_id" --arg bound "$bound_device_id" \
    --arg catalog "$catalog_id" --arg legacy "$legacy_root" --arg product "$product_root" --arg cutover "$cutover_sha" \
    --arg configSha "$config_sha" --arg stateSha "$state_sha" \
    '{schemaVersion:1,state:$state,instanceId:$instance,applicationIdentity:$application,
      boundDeviceIdentity:(if $bound == "" then null else $bound end),catalogId:$catalog,legacyRoot:$legacy,productRoot:$product,
      cutoverEvidenceSha256:(if $cutover == "" then null else $cutover end),
      finalConfigSnapshotSha256:(if $configSha == "" then null else $configSha end),
      finalStateSnapshotSha256:(if $stateSha == "" then null else $stateSha end)}'
}
validate_finalize_filesystem_state() {
  local status spec original tomb snapshot
  status="$(jq -r '.status' "$evidence")"
  if [[ "$status" != copied-and-verified ]]; then
    validate_migration_filesystem_state
    return
  fi
  for spec in "$legacy_config|$config_tomb|$config_snapshot" "$legacy_state|$state_tomb|$state_snapshot"; do
    IFS='|' read -r original tomb snapshot <<< "$spec"
    if [[ -d "$original" && ! -L "$original" && ! -e "$tomb" && ! -L "$tomb" ]]; then
      revalidate_tree "$original" "$snapshot" || return 1
    elif [[ ! -e "$original" && ! -L "$original" && -d "$tomb" && ! -L "$tomb" ]]; then
      revalidate_tree "$tomb" "$snapshot" || return 1
    else
      return 1
    fi
  done
  [[ -d "$legacy_catalog" && ! -L "$legacy_catalog" ]] && validate_legacy_catalog_snapshot "$catalog_snapshot"
}
verify_catalog_destination() {
  local root="$1" snapshot="$2" expected_identity_source="$3" catalog_manifest catalog_bundle catalog_identity catalog_identity_source kind schema preprocessing
  if [[ "$root" == "$catalog_stage" ]]; then
    acquire_staged_catalog_lock || return 1
  elif [[ "$root" == "$catalog_root" ]]; then
    acquire_published_catalog_lock || return 1
  else
    return 1
  fi
  validate_stage_root "$root" "$product_root/catalogs" || return 1
  catalog_manifest="$root/current/manifest.json"
  [[ -f "$catalog_manifest" && ! -L "$catalog_manifest" ]] || return 1
  catalog_bundle="$(realpath -- "$root/current")"
  [[ "$catalog_bundle" == "$root/versions/"* && -d "$catalog_bundle" && ! -L "$catalog_bundle" ]] || return 1
  IFS=$'\t' read -r catalog_identity catalog_identity_source < <(catalog_manifest_identity "$catalog_manifest" "$catalog_bundle") || return 1
  [[ "$catalog_identity" == "$catalog_id" && "$catalog_identity_source" == "$expected_identity_source" ]] || return 1
  kind="$(hyg_json_value "$catalog_manifest" '$.package.kind')"
  schema="$(hyg_json_value "$catalog_manifest" '$.schemaVersion')"
  preprocessing="$(hyg_json_value "$catalog_manifest" '$.preprocessingVersion')"
  validate_catalog_control_files "$legacy_catalog" "$catalog_identity" "$kind" "$schema" "$preprocessing" &&
    validate_catalog_control_files "$root" "$catalog_identity" "$kind" "$schema" "$preprocessing" &&
    verify_catalog_snapshot_copy "$root" "$snapshot" &&
    if [[ "$root" == "$catalog_stage" ]]; then revalidate_staged_catalog_lock; else revalidate_published_catalog_lock; fi
}
verify_migration_destination_for_identity() {
  local expected_identity_source="$1" expected_config="${2:-$config_snapshot}" expected_state="${3:-$state_snapshot}"
  validate_instance_tree_for_removal "$instance_root" "$product_root/cameraagents" complete "$expected_config" "$expected_state" || return 1
  verify_snapshot_copy "$instance_root/config" "$expected_config" &&
    verify_snapshot_copy "$instance_root/state" "$expected_state" &&
    verify_catalog_destination "$catalog_root" "$catalog_snapshot" "$expected_identity_source"
}
validate_final_snapshots() {
  local config_sha="$1" state_sha="$2"
  validate_metadata_file "$final_config_snapshot" && validate_metadata_file "$final_state_snapshot" &&
    [[ "$(sha256sum "$final_config_snapshot" | cut -d' ' -f1)" == "$config_sha" &&
       "$(sha256sum "$final_state_snapshot" | cut -d' ' -f1)" == "$state_sha" ]]
}
verify_final_destination() {
  local expected_identity_source="$1" config_sha="$2" state_sha="$3"
  validate_final_snapshots "$config_sha" "$state_sha" && validate_legacy_catalog_snapshot "$catalog_snapshot" &&
    verify_migration_destination_for_identity "$expected_identity_source" "$final_config_snapshot" "$final_state_snapshot"
}
validate_final_capture_sequence() {
  local expected="$1" sequence_file="$instance_root/state/capture-sequence" actual
  [[ -f "$sequence_file" && ! -L "$sequence_file" && "$(stat -c %h -- "$sequence_file")" == 1 ]] || return 1
  actual="$(<"$sequence_file")"
  [[ "$actual" =~ ^(0|[1-9][0-9]*)$ && "$actual" == "$expected" ]]
}
verify_migration_destination() {
  local expected_identity_source status config_sha state_sha
  expected_identity_source="$(jq -r '.catalogIdentitySource' "$evidence")" || return 1
  status="$(jq -r '.status' "$evidence")" || return 1
  if [[ "$status" == copied-and-verified ]]; then
    verify_migration_destination_for_identity "$expected_identity_source"
  else
    config_sha="$(jq -r '.finalConfigSnapshotSha256' "$evidence")" || return 1
    state_sha="$(jq -r '.finalStateSnapshotSha256' "$evidence")" || return 1
    verify_final_destination "$expected_identity_source" "$config_sha" "$state_sha"
  fi
}
remove_rollback_metadata() {
  local path="$1" label="$2"
  if [[ -e "$path" || -L "$path" ]]; then
    migration_lock_barrier || return 1
    rm -f -- "$path" || return 1
    sync -f "$(dirname -- "$path")" || return 1
    migration_lock_barrier || return 1
    failpoint "after-rollback-cleanup-$label"
  fi
}

product_parent="$(dirname -- "$product_root")"; evidence_parent="$(dirname -- "$evidence")"; lock_parent="$(dirname -- "$lock")"
ensure_private_directory "$product_parent" && ensure_private_directory "$evidence_parent" && ensure_private_directory "$lock_parent" ||
  { printf 'Migration output parents must be owner-private canonical directories.\n' >&2; exit 1; }
if [[ ! -e "$lock" && ! -L "$lock" ]]; then
  (set -o noclobber; umask 077; : > "$lock") 2>/dev/null || { printf 'Migration lock creation failed safely.\n' >&2; exit 1; }
fi
validate_metadata_file "$lock" || { printf 'Migration lock is unsafe.\n' >&2; exit 1; }
exec 9<>"$lock"
flock -n 9 || { printf 'Another product-layout migration is active.\n' >&2; exit 1; }
validate_metadata_file "$lock" && [[ "$(stat -Lc '%d:%i' -- "$lock")" == "$(stat -Lc '%d:%i' -- /proc/$$/fd/9)" ]] ||
  { printf 'Migration lock changed while being acquired.\n' >&2; exit 1; }
migration_lock_identity="$(stat -Lc '%d:%i:%u:%g:%h:%a' -- /proc/$$/fd/9)"
migration_lock_barrier() {
  local label="${1:-}"
  if [[ -n "$label" && "${DEPLOY_MIGRATION_TEST_LOCK_BARRIER:-}" == "$label" ]]; then
    [[ -n "${DEPLOY_MIGRATION_TEST_LOCK_MARKER:-}" ]] || return 1
    printf '%s\n' "$BASHPID" > "$DEPLOY_MIGRATION_TEST_LOCK_MARKER"
    kill -STOP "$BASHPID"
  fi
  validate_metadata_file "$lock" &&
    [[ "$(stat -Lc '%d:%i:%u:%g:%h:%a' -- "$lock")" == "$migration_lock_identity" &&
       "$(stat -Lc '%d:%i:%u:%g:%h:%a' -- /proc/$$/fd/9)" == "$migration_lock_identity" ]] || {
    printf 'Migration lock descriptor no longer matches its pathname.\n' >&2
    return 1
  }
}
migration_lock_barrier || exit 1
if [[ -d "$legacy_catalog" && ! -L "$legacy_catalog" ]]; then
  acquire_legacy_catalog_lock || { printf 'Legacy catalog lock is unsafe or could not be acquired.\n' >&2; exit 1; }
fi
case "$action" in
apply)
  migration_lock_barrier apply-start || exit 1
  catalog_manifest="$legacy_catalog/current/manifest.json"; catalog_bundle='' catalog_identity='' catalog_identity_source=''
  [[ -d "$legacy_config" && ! -L "$legacy_config" && -d "$legacy_state" && ! -L "$legacy_state" && -d "$legacy_catalog" && ! -L "$legacy_catalog" ]] || { printf 'The exact singular legacy layout is not present.\n' >&2; exit 1; }
  [[ "$(stat -c %d -- "$legacy_root")" == "$(stat -c %d -- "$(dirname -- "$product_root")")" ]] || { printf 'Migration requires one filesystem for guarded publication.\n' >&2; exit 1; }
  [[ -f "$catalog_manifest" && ! -L "$catalog_manifest" ]] || { printf 'Legacy catalog manifest is missing or unsafe.\n' >&2; exit 1; }
  catalog_bundle="$(realpath -- "$legacy_catalog/current")"
  [[ "$catalog_bundle" == "$legacy_catalog/versions/"* && -d "$catalog_bundle" && ! -L "$catalog_bundle" ]] || { printf 'Legacy catalog current target is unsafe.\n' >&2; exit 1; }
  IFS=$'\t' read -r catalog_identity catalog_identity_source < <(catalog_manifest_identity "$catalog_manifest" "$catalog_bundle") || { printf 'Legacy catalog identity is not canonical.\n' >&2; exit 1; }
  [[ "$catalog_identity" == "$catalog_id" ]] || { printf 'Legacy catalog manifest identity mismatch.\n' >&2; exit 1; }
  if [[ -e "$evidence" || -L "$evidence" ]]; then
    validate_rollback_evidence "$catalog_identity_source" || exit 1
    validate_metadata_file "$config_snapshot" && validate_metadata_file "$state_snapshot" &&
      validate_metadata_file "$catalog_snapshot" || exit 1
    validate_migration_filesystem_state && verify_migration_destination || exit 1
    migration_lock_barrier || exit 1
    printf 'migration=%s status=passed instance=%s catalog=%s\n' "$action" "$instance_id" "$catalog_id"; exit 0
  fi
  if [[ ! -e "$apply_intent" && ! -L "$apply_intent" ]]; then
    for path in "$instance_root" "$instance_stage" "$catalog_stage"; do [[ ! -e "$path" && ! -L "$path" ]] || { printf 'Unowned migration destination exists.\n' >&2; exit 1; }; done
    [[ ! -e "$catalog_root" && ! -L "$catalog_root" || -d "$catalog_root" && ! -L "$catalog_root" ]] || { printf 'Published catalog destination is unsafe.\n' >&2; exit 1; }
    catalog_preexisting=false; [[ ! -e "$catalog_root" && ! -L "$catalog_root" ]] || catalog_preexisting=true
    publish_json "$apply_intent" "$(jq -cn --arg instance "$instance_id" --arg application "$application_id" --arg bound "$bound_device_id" --arg catalog "$catalog_id" --arg identitySource "$catalog_identity_source" --arg legacy "$legacy_root" --arg product "$product_root" --arg instanceStage "$instance_stage" --arg catalogStage "$catalog_stage" --argjson catalogPreexisting "$catalog_preexisting" '
      {schemaVersion:1,state:"staging",instanceId:$instance,applicationIdentity:$application,boundDeviceIdentity:(if $bound == "" then null else $bound end),catalogId:$catalog,catalogIdentitySource:$identitySource,catalogPreexisting:$catalogPreexisting,legacyRoot:$legacy,productRoot:$product,instanceStage:$instanceStage,catalogStage:$catalogStage}')"
  fi
  validate_apply_intent "$catalog_identity_source" || exit 1
  if [[ -e "$config_snapshot" || -L "$config_snapshot" ]]; then validate_metadata_file "$config_snapshot" && revalidate_tree "$legacy_config" "$config_snapshot" || exit 1; else capture_tree "$legacy_config" "$config_snapshot"; failpoint after-initial-config-snapshot; fi
  if [[ -e "$state_snapshot" || -L "$state_snapshot" ]]; then validate_metadata_file "$state_snapshot" && revalidate_tree "$legacy_state" "$state_snapshot" || exit 1; else capture_tree "$legacy_state" "$state_snapshot"; failpoint after-initial-state-snapshot; fi
  if [[ -e "$catalog_snapshot" || -L "$catalog_snapshot" ]]; then validate_metadata_file "$catalog_snapshot" && validate_legacy_catalog_snapshot "$catalog_snapshot" || exit 1; else capture_tree "$legacy_catalog" "$catalog_snapshot"; validate_legacy_catalog_snapshot "$catalog_snapshot"; failpoint after-initial-catalog-snapshot; fi
  if [[ -n "$bound_device_id" ]]; then
    [[ -f "$legacy_config/camera-module.json" && -f "$legacy_config/secrets/CameraAgent__AgentId" && "$(<"$legacy_config/secrets/CameraAgent__AgentId")" == "$bound_device_id" ]] || { printf 'Preserved provisioning identity is not present in legacy configuration.\n' >&2; exit 1; }
    module_identity="$(jq -r '.agentId' "$legacy_config/camera-module.json")"; [[ "$module_identity" == "$application_id" || "$module_identity" == "$bound_device_id" ]] || exit 1
  fi
  migration_lock_barrier || exit 1
  mkdir -m 700 -p -- "$product_root/cameraagents" "$product_root/catalogs" || exit 1
  migration_lock_barrier || exit 1
  if [[ -e "$catalog_root" || -L "$catalog_root" ]]; then
    verify_catalog_destination "$catalog_root" "$catalog_snapshot" "$catalog_identity_source" ||
      { printf 'Preexisting published catalog does not exactly match the authenticated legacy catalog.\n' >&2; exit 1; }
  fi
  if [[ ! -e "$instance_root" && ! -L "$instance_root" ]]; then
    if [[ -d "$instance_stage" && ! -L "$instance_stage" ]] && { ! verify_copy "$legacy_config" "$instance_stage/config" || ! verify_copy "$legacy_state" "$instance_stage/state"; }; then
      validate_instance_tree_for_removal "$instance_stage" "$product_root/cameraagents" partial || { printf 'Stale instance stage is unsafe.\n' >&2; exit 1; }
      delete_instance_tree "$instance_stage"
    fi
    if [[ ! -e "$instance_stage" && ! -L "$instance_stage" ]]; then
      migration_lock_barrier || exit 1
      mkdir -m 700 -- "$instance_stage" || exit 1
      migration_lock_barrier || exit 1
      failpoint after-instance-stage-mkdir
      migration_lock_barrier || exit 1
      cp -a -- "$legacy_config" "$instance_stage/config" || exit 1
      migration_lock_barrier || exit 1
      if [[ "${DEPLOY_MIGRATION_FAILPOINT:-}" == mid-copy-config ]]; then partial_delete_one "$instance_stage/config"; exit 75; fi
      failpoint after-copy-config
      migration_lock_barrier || exit 1
      cp -a -- "$legacy_state" "$instance_stage/state" || exit 1
      migration_lock_barrier || exit 1
    fi
    verify_copy "$legacy_config" "$instance_stage/config" && verify_copy "$legacy_state" "$instance_stage/state" || { printf 'Staged instance state did not verify.\n' >&2; exit 1; }
    publish_json "$instance_stage/instance-manifest.json" "$(jq -cn --arg instance "$instance_id" '{schemaVersion:1,product:"HVO.SkyMonitor",component:"cameraAgent",instanceId:$instance,creationProvenance:{migration:"singular-layout-v1"},applicationIdentityFile:"application-identity.json"}')"
    publish_json "$instance_stage/application-identity.json" "$(jq -cn --arg configured "$application_id" --arg bound "$bound_device_id" '{schemaVersion:1,state:(if $bound == "" then "pre-provisioning" else "bound" end),configuredIdentity:$configured,boundIdentity:(if $bound == "" then null else $bound end)}')"
    migration_lock_barrier || exit 1
    mv -T -- "$instance_stage" "$instance_root" || exit 1
    sync -f "$product_root/cameraagents" || exit 1
    migration_lock_barrier || exit 1
  fi
  [[ -d "$instance_root" && ! -L "$instance_root" && ! -e "$instance_stage" ]] || exit 1
  verify_copy "$legacy_config" "$instance_root/config" || exit 1
  verify_copy "$legacy_state" "$instance_root/state" || exit 1
  failpoint after-publish-instance
  [[ -f "$manifest" && ! -L "$manifest" && -f "$binding" && ! -L "$binding" && "$(stat -c '%u:%h:%a' "$manifest")" == "$(id -u):1:600" && "$(stat -c '%u:%h:%a' "$binding")" == "$(id -u):1:600" ]] || exit 1
  jq -e --arg instance "$instance_id" '.schemaVersion == 1 and .product == "HVO.SkyMonitor" and .component == "cameraAgent" and .instanceId == $instance and .creationProvenance == {migration:"singular-layout-v1"} and .applicationIdentityFile == "application-identity.json"' "$manifest" >/dev/null || exit 1
  jq -e --arg configured "$application_id" --arg bound "$bound_device_id" '.schemaVersion == 1 and .configuredIdentity == $configured and .state == (if $bound == "" then "pre-provisioning" else "bound" end) and .boundIdentity == (if $bound == "" then null else $bound end)' "$binding" >/dev/null || exit 1
  if [[ ! -e "$catalog_root" && ! -L "$catalog_root" ]]; then
    if [[ -d "$catalog_stage" && ! -L "$catalog_stage" ]]; then
      acquire_staged_catalog_lock || { printf 'Staged catalog lock is unsafe or could not be acquired.\n' >&2; exit 1; }
    fi
    if [[ -n "$staged_catalog_lock_fd" ]] && ! verify_catalog_destination "$catalog_stage" "$catalog_snapshot" "$catalog_identity_source"; then
      revalidate_staged_catalog_lock || { printf 'Staged catalog lock changed while being held.\n' >&2; exit 1; }
      validate_stage_root "$catalog_stage" "$product_root/catalogs" && validate_catalog_copy_subset "$catalog_stage" "$catalog_snapshot" ||
        { printf 'Stale catalog stage is unsafe.\n' >&2; exit 1; }
      delete_catalog_copy_subset "$catalog_stage" "$catalog_snapshot"
      release_staged_catalog_lock
    fi
    if [[ ! -e "$catalog_stage" && ! -L "$catalog_stage" ]]; then
      migration_lock_barrier || exit 1
      cp -a -- "$legacy_catalog" "$catalog_stage" || exit 1
      migration_lock_barrier || exit 1
      failpoint after-copy-catalog
    fi
    acquire_staged_catalog_lock || { printf 'Staged catalog lock is unsafe or could not be acquired.\n' >&2; exit 1; }
    verify_catalog_destination "$catalog_stage" "$catalog_snapshot" "$catalog_identity_source" || { printf 'Staged catalog did not verify.\n' >&2; exit 1; }
    validate_legacy_catalog_snapshot "$catalog_snapshot" || { printf 'Legacy catalog changed before publication.\n' >&2; exit 1; }
    migration_lock_barrier || exit 1
    mv -T -- "$catalog_stage" "$catalog_root" || exit 1
    sync -f "$product_root/catalogs" || exit 1
    migration_lock_barrier || exit 1
    promote_staged_catalog_lock || { printf 'Published catalog lock changed during publication.\n' >&2; exit 1; }
  fi
  [[ -d "$catalog_root" && ! -L "$catalog_root" && ! -e "$catalog_stage" ]] || exit 1
  verify_catalog_destination "$catalog_root" "$catalog_snapshot" "$catalog_identity_source"
  failpoint before-final-evidence-revalidation
  revalidate_tree "$legacy_config" "$config_snapshot" && revalidate_tree "$legacy_state" "$state_snapshot" &&
    validate_legacy_catalog_snapshot "$catalog_snapshot" &&
    verify_migration_destination_for_identity "$catalog_identity_source" || { printf 'Migration source or destination changed before evidence publication.\n' >&2; exit 1; }
  failpoint after-final-evidence-revalidation
  revalidate_published_catalog_lock || { printf 'Published catalog lock changed before evidence publication.\n' >&2; exit 1; }
  publish_json "$evidence" "$(jq -cn --arg instance "$instance_id" --arg application "$application_id" --arg bound "$bound_device_id" --arg catalog "$catalog_id" --arg identitySource "$catalog_identity_source" --arg legacy "$legacy_root" --arg product "$product_root" '{schemaVersion:2,status:"copied-and-verified",instanceId:$instance,applicationIdentity:$application,boundDeviceIdentity:(if $bound == "" then null else $bound end),catalogId:$catalog,catalogIdentitySource:$identitySource,legacyRoot:$legacy,productRoot:$product,legacyRetained:true,legacyCatalogRetained:true}')"
  revalidate_published_catalog_lock || { printf 'Published catalog lock changed during evidence publication.\n' >&2; exit 1; }
  ;;
verify)
  migration_lock_barrier verify-start || exit 1
  validate_migration_evidence || exit 1
  validate_metadata_file "$config_snapshot" && validate_metadata_file "$state_snapshot" &&
    validate_metadata_file "$catalog_snapshot" || exit 1
  validate_migration_filesystem_state || exit 1
  verify_migration_destination || exit 1
  migration_status="$(jq -r '.status' "$evidence")"
  if [[ "$migration_status" == copied-and-verified ]]; then
    [[ ! -e "$cutover_snapshot" && ! -L "$cutover_snapshot" ]] || validate_metadata_file "$cutover_snapshot" || exit 1
  else
    validate_metadata_file "$cutover_snapshot" &&
      [[ "$(sha256sum "$cutover_snapshot" | cut -d' ' -f1)" == "$(jq -r '.cutoverEvidenceSha256' "$evidence")" ]] || exit 1
  fi
  migration_lock_barrier verify-complete || exit 1
  ;;
rollback)
  migration_lock_barrier rollback-start || exit 1
  if [[ -e "$apply_intent" || -L "$apply_intent" ]] &&
    [[ ! -e "$evidence" && ! -L "$evidence" && ! -e "$instance_stage" && ! -L "$instance_stage" &&
       ! -e "$instance_root" && ! -L "$instance_root" && ! -e "$catalog_stage" && ! -L "$catalog_stage" &&
       ! -e "$rollback_intent" && ! -L "$rollback_intent" && ! -e "$intent" && ! -L "$intent" &&
       ! -e "$final_config_snapshot" && ! -L "$final_config_snapshot" && ! -e "$final_state_snapshot" && ! -L "$final_state_snapshot" &&
       ! -e "$cutover_snapshot" && ! -L "$cutover_snapshot" ]]; then
    metadata_identity_source="$(jq -r '.catalogIdentitySource' "$apply_intent" 2>/dev/null)"
    [[ "$metadata_identity_source" == explicit-manifest-v2 ]] || exit 1
    validate_apply_intent "$metadata_identity_source" || exit 1
    catalog_preexisting="$(jq -r '.catalogPreexisting' "$apply_intent")"
    if [[ "$catalog_preexisting" == true ]]; then acquire_published_catalog_lock || exit 1
    else [[ ! -e "$catalog_root" && ! -L "$catalog_root" ]] || exit 1; fi
    snapshot_gap=false
    for path in "$config_snapshot" "$state_snapshot" "$catalog_snapshot"; do
      if [[ -e "$path" || -L "$path" ]]; then
        [[ "$snapshot_gap" == false ]] && validate_metadata_file "$path" || exit 1
      else
        snapshot_gap=true
      fi
    done
    remove_rollback_metadata "$catalog_snapshot" partial-catalog-snapshot
    remove_rollback_metadata "$state_snapshot" partial-state-snapshot
    remove_rollback_metadata "$config_snapshot" partial-config-snapshot
    remove_rollback_metadata "$apply_intent" partial-apply-intent
    migration_lock_barrier || exit 1
    printf 'migration=%s status=passed instance=%s catalog=%s\n' "$action" "$instance_id" "$catalog_id"
    exit 0
  fi
  catalog_manifest="$legacy_catalog/current/manifest.json"; catalog_bundle='' catalog_identity='' catalog_identity_source=''
  [[ -f "$catalog_manifest" && ! -L "$catalog_manifest" ]] || exit 1
  catalog_bundle="$(realpath -- "$legacy_catalog/current")"
  [[ "$catalog_bundle" == "$legacy_catalog/versions/"* && -d "$catalog_bundle" && ! -L "$catalog_bundle" ]] || exit 1
  IFS=$'\t' read -r catalog_identity catalog_identity_source < <(catalog_manifest_identity "$catalog_manifest" "$catalog_bundle") || exit 1
  [[ "$catalog_identity" == "$catalog_id" ]] || exit 1
  if [[ -e "$instance_stage" || -L "$instance_stage" ]]; then validate_instance_tree_for_removal "$instance_stage" "$product_root/cameraagents" partial || exit 1; fi
  rollback_state=none; rollback_cutover_sha='' rollback_config_sha='' rollback_state_sha=''
  if [[ -e "$rollback_intent" || -L "$rollback_intent" ]]; then
    validate_rollback_intent || exit 1
    rollback_state="$(jq -r '.state' "$rollback_intent")"
    rollback_cutover_sha="$(jq -r '.cutoverEvidenceSha256 // ""' "$rollback_intent")"
    rollback_config_sha="$(jq -r '.finalConfigSnapshotSha256 // ""' "$rollback_intent")"
    rollback_state_sha="$(jq -r '.finalStateSnapshotSha256 // ""' "$rollback_intent")"
  fi
  [[ -d "$legacy_config" && ! -L "$legacy_config" && -d "$legacy_state" && ! -L "$legacy_state" &&
     ! -e "$config_tomb" && ! -L "$config_tomb" && ! -e "$state_tomb" && ! -L "$state_tomb" ]] || {
    printf 'Rollback is unavailable after legacy tombstoning has started. Resume finalize instead.\n' >&2
    exit 1
  }
  if [[ "$rollback_state" == cleanup-pending ]]; then
    for path in "$instance_stage" "$instance_root" "$catalog_stage"; do [[ ! -e "$path" && ! -L "$path" ]] || exit 1; done
    cleanup_seen_present=false
    for path in "$intent" "$final_state_snapshot" "$final_config_snapshot" "$cutover_snapshot" \
      "$evidence" "$config_snapshot" "$state_snapshot" "$catalog_snapshot" "$apply_intent"; do
      if [[ -e "$path" || -L "$path" ]]; then cleanup_seen_present=true; validate_metadata_file "$path" || exit 1
      elif [[ "$cleanup_seen_present" == true ]]; then exit 1
      fi
    done
    if [[ -n "$rollback_cutover_sha" ]]; then
      [[ ! -e "$intent" && ! -L "$intent" ]] || validate_finalize_intent "$rollback_cutover_sha" "$rollback_config_sha" "$rollback_state_sha" || exit 1
      [[ ! -e "$cutover_snapshot" && ! -L "$cutover_snapshot" || "$(sha256sum "$cutover_snapshot" | cut -d' ' -f1)" == "$rollback_cutover_sha" ]] || exit 1
      [[ ! -e "$final_config_snapshot" && ! -L "$final_config_snapshot" || "$(sha256sum "$final_config_snapshot" | cut -d' ' -f1)" == "$rollback_config_sha" ]] || exit 1
      [[ ! -e "$final_state_snapshot" && ! -L "$final_state_snapshot" || "$(sha256sum "$final_state_snapshot" | cut -d' ' -f1)" == "$rollback_state_sha" ]] || exit 1
    else
      [[ ! -e "$intent" && ! -L "$intent" ]] || exit 1
    fi
    [[ ! -e "$evidence" && ! -L "$evidence" ]] || validate_rollback_evidence "$catalog_identity_source" || exit 1
    [[ ! -e "$config_snapshot" && ! -L "$config_snapshot" ]] || revalidate_tree "$legacy_config" "$config_snapshot"
    [[ ! -e "$state_snapshot" && ! -L "$state_snapshot" ]] || revalidate_tree "$legacy_state" "$state_snapshot"
    [[ ! -e "$catalog_snapshot" && ! -L "$catalog_snapshot" ]] || validate_legacy_catalog_snapshot "$catalog_snapshot"
    [[ ! -e "$apply_intent" && ! -L "$apply_intent" ]] || validate_apply_intent "$catalog_identity_source"
    if [[ -e "$catalog_root" || -L "$catalog_root" ]]; then
      if [[ -e "$catalog_snapshot" ]]; then verify_catalog_destination "$catalog_root" "$catalog_snapshot" "$catalog_identity_source"
      else acquire_published_catalog_lock; fi
    fi
  else
    validate_apply_intent "$catalog_identity_source" || { printf 'Migration apply intent is missing or invalid.\n' >&2; exit 1; }
    validate_metadata_file "$config_snapshot" && validate_metadata_file "$state_snapshot" && validate_metadata_file "$catalog_snapshot" || exit 1
    for path in "$final_config_snapshot" "$final_state_snapshot" "$cutover_snapshot" "$intent"; do
      [[ ! -e "$path" && ! -L "$path" ]] || validate_metadata_file "$path" || exit 1
    done
    revalidate_tree "$legacy_config" "$config_snapshot"; revalidate_tree "$legacy_state" "$state_snapshot"; validate_legacy_catalog_snapshot "$catalog_snapshot"
    if [[ -e "$evidence" || -L "$evidence" ]]; then validate_rollback_evidence "$catalog_identity_source" || { printf 'Finalized or mismatched migration cannot be rolled back.\n' >&2; exit 1; }; fi
    if [[ "$rollback_state" == none && ( -e "$intent" || -L "$intent" ) ]]; then
      rollback_cutover_sha="$(sha256sum "$cutover_snapshot" | cut -d' ' -f1)"
      rollback_config_sha="$(sha256sum "$final_config_snapshot" | cut -d' ' -f1)"
      rollback_state_sha="$(sha256sum "$final_state_snapshot" | cut -d' ' -f1)"
    fi
    if [[ -n "$rollback_cutover_sha" ]]; then
      validate_finalize_intent "$rollback_cutover_sha" "$rollback_config_sha" "$rollback_state_sha" &&
        validate_final_snapshots "$rollback_config_sha" "$rollback_state_sha" &&
        [[ "$(sha256sum "$cutover_snapshot" | cut -d' ' -f1)" == "$rollback_cutover_sha" ]] || exit 1
      if [[ "$rollback_state" == none ]]; then
        verify_final_destination "$catalog_identity_source" "$rollback_config_sha" "$rollback_state_sha" || exit 1
      fi
    else
      [[ ! -e "$intent" && ! -L "$intent" ]] || exit 1
      [[ ! -e "$final_config_snapshot" && ! -L "$final_config_snapshot" || -e "$cutover_snapshot" ]] || exit 1
      [[ ! -e "$final_state_snapshot" && ! -L "$final_state_snapshot" || -e "$final_config_snapshot" ]] || exit 1
    fi
  fi
  if [[ "$rollback_state" != cleanup-pending ]]; then
  if [[ -e "$instance_root" || -L "$instance_root" ]]; then
    rollback_config_expected="$config_snapshot"; rollback_state_expected="$state_snapshot"
    if [[ -n "$rollback_cutover_sha" ]]; then rollback_config_expected="$final_config_snapshot"; rollback_state_expected="$final_state_snapshot"; fi
    validate_instance_tree_for_removal "$instance_root" "$product_root/cameraagents" \
      "$([[ "$rollback_state" == deletion-pending ]] && printf partial || printf complete)" "$rollback_config_expected" "$rollback_state_expected" || exit 1
    if [[ "$rollback_state" == none && -z "$rollback_cutover_sha" ]]; then
      verify_copy "$legacy_config" "$instance_root/config"; verify_copy "$legacy_state" "$instance_root/state"
    fi
  fi
  if [[ -e "$catalog_stage" || -L "$catalog_stage" ]]; then
    acquire_staged_catalog_lock && validate_catalog_copy_subset "$catalog_stage" "$catalog_snapshot" && revalidate_staged_catalog_lock || exit 1
  fi
  if [[ -e "$catalog_root" || -L "$catalog_root" ]]; then
    verify_catalog_destination "$catalog_root" "$catalog_snapshot" "$catalog_identity_source" || exit 1
  fi
  if [[ "$rollback_state" == none ]]; then
    publish_json "$rollback_intent" "$(rollback_intent_json deletion-pending "$rollback_cutover_sha" "$rollback_config_sha" "$rollback_state_sha")"
  fi
  if [[ -e "$instance_stage" || -L "$instance_stage" ]]; then delete_instance_tree "$instance_stage" rollback-stage; fi
  if [[ -e "$instance_root" || -L "$instance_root" ]]; then
    delete_instance_tree "$instance_root" rollback-instance "${rollback_config_expected:-$config_snapshot}" "${rollback_state_expected:-$state_snapshot}"
  fi
  if [[ -e "$catalog_stage" || -L "$catalog_stage" ]]; then
    revalidate_staged_catalog_lock && delete_catalog_copy_subset "$catalog_stage" "$catalog_snapshot" || exit 1
    release_staged_catalog_lock
  fi
  publish_json "$rollback_intent" "$(rollback_intent_json cleanup-pending "$rollback_cutover_sha" "$rollback_config_sha" "$rollback_state_sha")"
  failpoint after-rollback-cleanup-intent
  fi
  remove_rollback_metadata "$intent" finalize-intent
  remove_rollback_metadata "$final_state_snapshot" final-state-snapshot
  remove_rollback_metadata "$final_config_snapshot" final-config-snapshot
  remove_rollback_metadata "$cutover_snapshot" cutover-snapshot
  remove_rollback_metadata "$evidence" evidence
  remove_rollback_metadata "$config_snapshot" config-snapshot
  remove_rollback_metadata "$state_snapshot" state-snapshot
  remove_rollback_metadata "$catalog_snapshot" catalog-snapshot
  remove_rollback_metadata "$apply_intent" apply-intent
  migration_lock_barrier || exit 1
  rm -f -- "$rollback_intent" || exit 1
  sync -f "$(dirname -- "$rollback_intent")" || exit 1
  migration_lock_barrier || exit 1
  ;;
finalize)
  migration_lock_barrier finalize-start || exit 1
  validate_metadata_file "$evidence" && validate_metadata_file "$config_snapshot" && validate_metadata_file "$state_snapshot" &&
    validate_metadata_file "$catalog_snapshot" && validate_migration_evidence || exit 1
  [[ -n "$cutover_evidence" ]] && pin_cutover_evidence "$cutover_evidence" "$cutover_snapshot" ||
    { printf 'Owner-only cutover evidence could not be pinned or does not match the retained snapshot.\n' >&2; exit 1; }
  jq -e --arg instance "$instance_id" --arg application "$application_id" '(keys | sort) == (["applicationIdentity","artifactChecksumsVerified","captureSequenceAfter","captureSequenceBefore","dataProtectionVerified","healthVerified","imageIdentityVerified","instanceId","locationHistoryVerified","loginVerified","provisioningVerified","rollbackRehearsed","schemaVersion"] | sort) and .schemaVersion == 1 and .instanceId == $instance and .applicationIdentity == $application and all(.artifactChecksumsVerified,.dataProtectionVerified,.healthVerified,.imageIdentityVerified,.locationHistoryVerified,.loginVerified,.provisioningVerified,.rollbackRehearsed; . == true) and .captureSequenceBefore as $before | ($before | type == "number" and floor == . and . >= 0) and (.captureSequenceAfter | type == "number" and floor == . and . >= $before)' "$cutover_snapshot" >/dev/null || { printf 'Cutover evidence is invalid or incomplete.\n' >&2; exit 1; }
  cutover_sha="$(sha256sum "$cutover_snapshot" | cut -d' ' -f1)"
  validate_finalize_evidence "$cutover_sha" || exit 1
  migration_status="$(jq -r '.status' "$evidence")"
  expected_identity_source="$(jq -r '.catalogIdentitySource' "$evidence")"
  capture_sequence_after="$(jq -r '.captureSequenceAfter | tostring' "$cutover_snapshot")"
  if [[ "$migration_status" == finalized ]]; then
    validate_migration_filesystem_state && verify_migration_destination && validate_final_capture_sequence "$capture_sequence_after" || exit 1
    migration_lock_barrier || exit 1
    printf 'migration=%s status=passed instance=%s catalog=%s\n' "$action" "$instance_id" "$catalog_id"; exit 0
  fi
  if [[ "$migration_status" == copied-and-verified ]]; then
    if [[ -e "$intent" || -L "$intent" ]]; then validate_finalize_filesystem_state || exit 1
    else validate_migration_filesystem_state || exit 1; fi
    validate_instance_identity_file "$manifest" manifest "$instance_root" &&
      validate_instance_identity_file "$binding" binding "$instance_root" &&
      verify_catalog_destination "$catalog_root" "$catalog_snapshot" "$expected_identity_source" || exit 1
    if [[ -e "$final_config_snapshot" || -L "$final_config_snapshot" ]]; then
      validate_metadata_file "$final_config_snapshot" && revalidate_tree "$instance_root/config" "$final_config_snapshot" || exit 1
    else
      capture_tree "$instance_root/config" "$final_config_snapshot"; failpoint after-final-config-snapshot
    fi
    if [[ -e "$final_state_snapshot" || -L "$final_state_snapshot" ]]; then
      validate_metadata_file "$final_state_snapshot" && revalidate_tree "$instance_root/state" "$final_state_snapshot" || exit 1
    else
      capture_tree "$instance_root/state" "$final_state_snapshot"; failpoint after-final-state-snapshot
    fi
    final_config_sha="$(sha256sum "$final_config_snapshot" | cut -d' ' -f1)"
    final_state_sha="$(sha256sum "$final_state_snapshot" | cut -d' ' -f1)"
    verify_final_destination "$expected_identity_source" "$final_config_sha" "$final_state_sha" &&
      validate_final_capture_sequence "$capture_sequence_after" || exit 1
    if [[ ! -e "$intent" && ! -L "$intent" ]]; then
      publish_json "$intent" "$(jq -cn --arg instance "$instance_id" --arg c "$config_tomb" --arg s "$state_tomb" \
        --arg cutover "$cutover_sha" --arg cutoverSnapshot "$cutover_snapshot" --arg configSha "$final_config_sha" --arg stateSha "$final_state_sha" \
        '{schemaVersion:1,state:"rename-pending",instanceId:$instance,cutoverEvidenceSha256:$cutover,
          cutoverEvidenceSnapshot:$cutoverSnapshot,finalConfigSnapshotSha256:$configSha,finalStateSnapshotSha256:$stateSha,
          legacyCatalogRetained:true,tombstones:{config:$c,state:$s}}')"
      failpoint after-finalize-intent
    fi
  else
    [[ "$migration_status" == finalized-removal-pending ]] || exit 1
    final_config_sha="$(jq -r '.finalConfigSnapshotSha256' "$evidence")"
    final_state_sha="$(jq -r '.finalStateSnapshotSha256' "$evidence")"
  fi
  validate_finalize_intent "$cutover_sha" "$final_config_sha" "$final_state_sha" || exit 1
  validate_finalize_filesystem_state && verify_final_destination "$expected_identity_source" "$final_config_sha" "$final_state_sha" &&
    validate_final_capture_sequence "$capture_sequence_after" || exit 1
  if [[ "$migration_status" == copied-and-verified ]]; then
    for spec in "config|$legacy_config|$config_tomb|$config_snapshot" "state|$legacy_state|$state_tomb|$state_snapshot"; do
      IFS='|' read -r label original tomb snapshot <<< "$spec"
      if [[ -d "$original" && ! -L "$original" && ! -e "$tomb" && ! -L "$tomb" ]]; then
        revalidate_tree "$original" "$snapshot" || exit 1
        migration_lock_barrier || exit 1
        mv -T -- "$original" "$tomb" || exit 1
        sync -f "$(dirname -- "$original")" || exit 1
        migration_lock_barrier || exit 1
      fi
      [[ ! -e "$original" && ! -L "$original" && -d "$tomb" && ! -L "$tomb" ]] || { printf 'Migration tombstone state is inconsistent.\n' >&2; exit 1; }
      revalidate_tree "$tomb" "$snapshot" || exit 1
      failpoint "after-tombstone-$label"
    done
  else
    for original in "$legacy_config" "$legacy_state"; do [[ ! -e "$original" && ! -L "$original" ]] || exit 1; done
    validate_legacy_catalog_snapshot "$catalog_snapshot" || exit 1
  fi
  verify_final_destination "$expected_identity_source" "$final_config_sha" "$final_state_sha" &&
    validate_final_capture_sequence "$capture_sequence_after" || exit 1
  failpoint after-pre-pending-destination-barrier
  if [[ "$migration_status" == copied-and-verified ]]; then
    revalidate_published_catalog_lock || { printf 'Published catalog lock changed before pending evidence publication.\n' >&2; exit 1; }
    publish_json "$evidence" "$(jq --arg sha "$cutover_sha" --arg configSha "$final_config_sha" --arg stateSha "$final_state_sha" \
      '.status="finalized-removal-pending" | .legacyRetained=false | .legacyCatalogRetained=true | .cutoverEvidenceSha256=$sha |
       .finalConfigSnapshotSha256=$configSha | .finalStateSnapshotSha256=$stateSha' "$evidence")"
    revalidate_published_catalog_lock || { printf 'Published catalog lock changed during pending evidence publication.\n' >&2; exit 1; }
  fi
  failpoint after-finalized-evidence
  verify_final_destination "$expected_identity_source" "$final_config_sha" "$final_state_sha" &&
    validate_final_capture_sequence "$capture_sequence_after" || exit 1
  failpoint after-pre-delete-destination-barrier
  for spec in "config|$config_tomb|$config_snapshot" "state|$state_tomb|$state_snapshot"; do
    IFS='|' read -r label tomb snapshot <<< "$spec"
    if [[ -e "$tomb" || -L "$tomb" ]]; then
      validate_snapshot_subset "$tomb" "$snapshot" || exit 1
      if [[ "${DEPLOY_MIGRATION_FAILPOINT:-}" == "after-partial-delete-$label" ]]; then partial_delete_one "$tomb"; validate_snapshot_subset "$tomb" "$snapshot"; exit 75; fi
      delete_snapshot_subset "$tomb" "$snapshot" || exit 1
      sync -f "$(dirname -- "$tomb")" || exit 1
    fi
    [[ ! -e "$tomb" && ! -L "$tomb" ]] || exit 1; failpoint "after-remove-$label"
  done
  verify_final_destination "$expected_identity_source" "$final_config_sha" "$final_state_sha" &&
    validate_final_capture_sequence "$capture_sequence_after" || exit 1
  failpoint after-final-destination-barrier
  revalidate_published_catalog_lock || { printf 'Published catalog lock changed before final evidence publication.\n' >&2; exit 1; }
  publish_json "$evidence" "$(jq '.status="finalized" | .legacyRetained=false | .legacyCatalogRetained=true | .tombstonesRemoved=true' "$evidence")"
  revalidate_published_catalog_lock || { printf 'Published catalog lock changed during final evidence publication.\n' >&2; exit 1; }
  ;;
esac
migration_lock_barrier || exit 1
printf 'migration=%s status=passed instance=%s catalog=%s\n' "$action" "$instance_id" "$catalog_id"
