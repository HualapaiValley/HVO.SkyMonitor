    wait "$first_dispatch_pid" || true
    printf 'A concurrent dispatcher acquired the same participant/session.\n' >&2
    exit 1
fi
grep -Fq "DISPATCH_BUSY CMD-REVIEW-CONCURRENT $participant" "$work_root/concurrent-second.err" ||
    fail 'Concurrent dispatcher did not report DISPATCH_BUSY for the held participant.'
wait "$first_dispatch_pid"
unset MOCK_LEDGER_GET_DELAY
[[ "$(grep -Fc CODEX_LAUNCH "$MOCK_EVENT_LOG")" == 1 ]] ||
    fail 'Serialized dispatch did not launch the reviewer exactly once.'
[[ "$(grep -Fc '## Review launch — STARTING (durable reservation)' "$MOCK_LEDGER")" == 1 ]] ||
    fail 'Serialized dispatch did not write exactly one durable reservation.'

printf '[]\n' > "$MOCK_LEDGER"
: > "$MOCK_EVENT_LOG"
: > "$MOCK_POST_COUNT"
rm -f "$MOCK_REVIEW_RESULT"
jq -n --arg participant "$participant" '{participants:[{id:$participant,status:"ACTIVE",joinState:"JOINED",joinAckId:"JOINACK-REVIEW-001",lease:{generation:1,expiresAt:null}}]}' > "$MOCK_REGISTRY"
jq -n --arg participant "$participant" '{commandId:"CMD-REVIEW-LEASE",targetParticipantId:$participant,leaseGeneration:1}' > "$work_root/command-lease.json"
sed 's/CMD-REVIEW-001/CMD-REVIEW-LEASE/g' "$work_root/initial.request" > "$work_root/lease.request"
export MOCK_REPLACE_LEASE_ON_RESERVATION=true
if $dispatch_tool --repo RoySalisbury/HVO.SkyMonitor --pr 700 --request "$work_root/lease.request" \
    --runner codex --model gpt-5.6-terra --effort high --worktree "$repo_root" \
    --log-file "$work_root/logs/lease.jsonl" --registry "$MOCK_REGISTRY" \
    --command "$work_root/command-lease.json" --receipts "$work_root/receipts.json" \
    --reviewer-id "$participant" --resume-session "$resume_session" >/dev/null 2>&1; then
    printf 'A replaced lease launched a reviewer.\n' >&2
    exit 1
fi
unset MOCK_REPLACE_LEASE_ON_RESERVATION
[[ "$(grep -Fc CODEX_LAUNCH "$MOCK_EVENT_LOG" || true)" == 0 ]] ||
    fail 'A replaced lease reached the reviewer launch.'
grep -Fq '## Review launch — ABORTED' "$MOCK_LEDGER" ||
    fail 'Replaced lease did not record the aborted launch in the ledger.'

printf '[]\n' > "$MOCK_LEDGER"
: > "$MOCK_EVENT_LOG"
: > "$MOCK_POST_COUNT"
rm -f "$MOCK_REVIEW_RESULT"
jq -n --arg participant "$participant" '{participants:[{id:$participant,status:"ACTIVE",joinState:"JOINED",joinAckId:"JOINACK-REVIEW-001",lease:{generation:1,expiresAt:null}}]}' > "$MOCK_REGISTRY"
jq -n --arg participant "$participant" '{commandId:"CMD-REVIEW-POSTFAIL",targetParticipantId:$participant,leaseGeneration:1}' > "$work_root/command-postfail.json"
sed 's/CMD-REVIEW-001/CMD-REVIEW-POSTFAIL/g' "$work_root/initial.request" > "$work_root/postfail.request"
export MOCK_FAIL_POST_NUMBER=3
if $dispatch_tool --repo RoySalisbury/HVO.SkyMonitor --pr 700 --request "$work_root/postfail.request" \
    --runner codex --model gpt-5.6-terra --effort high --worktree "$repo_root" \
    --log-file "$work_root/logs/postfail.jsonl" --registry "$MOCK_REGISTRY" \
    --command "$work_root/command-postfail.json" --receipts "$work_root/receipts.json" \
    --reviewer-id "$participant" --resume-session "$resume_session" > "$work_root/postfail-result.json" 2>/dev/null; then
    printf 'A missing STARTED receipt was accepted as complete.\n' >&2
    exit 1
fi
unset MOCK_FAIL_POST_NUMBER
[[ "$(grep -Fc CODEX_LAUNCH "$MOCK_EVENT_LOG")" == 1 ]] ||
    fail 'Failed-receipt run did not launch the reviewer exactly once.'
[[ "$(grep -Fc CODEX_COMPLETE "$MOCK_EVENT_LOG")" == 1 ]] ||
    fail 'Failed-receipt run did not record exactly one reviewer completion.'
grep -Fq '## Review launch — STARTING (durable reservation)' "$MOCK_LEDGER" ||
    fail 'Failed-receipt run did not write the durable reservation.'
grep -Fq '## Review process — ERROR' "$MOCK_LEDGER" ||
    fail 'Failed-receipt run did not record the review process error.'
if $dispatch_tool --repo RoySalisbury/HVO.SkyMonitor --pr 700 --request "$work_root/postfail.request" \
    --runner codex --model gpt-5.6-terra --effort high --worktree "$repo_root" \
    --log-file "$work_root/logs/postfail.jsonl" --registry "$MOCK_REGISTRY" \
    --command "$work_root/command-postfail.json" --receipts "$work_root/receipts.json" \
    --reviewer-id "$participant" --resume-session "$resume_session" >/dev/null 2>&1; then
    printf 'A reserved command retried without recovery.\n' >&2
    exit 1
fi
[[ "$(grep -Fc CODEX_LAUNCH "$MOCK_EVENT_LOG")" == 1 ]] ||
    fail 'Retry after a failed receipt launched the reviewer a second time.'

printf 'Review request merge-base/pagination, evidence-pack/replay, serialized dispatch, reservation, lease-race, failed-receipt, harness-lifetime, and retry tests passed.\n'
