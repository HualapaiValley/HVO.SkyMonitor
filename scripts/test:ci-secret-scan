#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

# Contract test for scripts/ci:secret-scan and .gitleaks.toml (#1321). Each case
# runs the real scan, with the pinned gitleaks, against a temporary fixture
# repository. The fake credential is assembled at run time, so this file holds
# nothing a scan could match, and every case checks that the output never shows
# it. The cases share one downloaded archive through HVO_GITLEAKS_CACHE_DIR.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly REPO_ROOT="$SCRIPT_DIR/.."
readonly SCAN="$SCRIPT_DIR/ci:secret-scan"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
export HVO_GITLEAKS_CACHE_DIR="${HVO_GITLEAKS_CACHE_DIR:-$work/cache}"
# Fixture commits must not depend on the caller's Git configuration (signing, hooks, identity).
printf '[user]\n\tname = Secret Scan Fixture\n\temail = fixture@example.invalid\n[init]\n\tdefaultBranch = main\n' \
    > "$work/gitconfig"
export GIT_CONFIG_GLOBAL="$work/gitconfig" GIT_CONFIG_NOSYSTEM=1

fail() {
    printf 'Secret scan contract failed: %s\n' "$*" >&2
    exit 1
}

# An obviously fake GitHub token that gitleaks' github-pat rule still matches: the prefix, a marker
# and a random tail, joined only at run time.
token_tail="$(head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | cut -c 1-20)"
token='ghp_''FakeFixtureToken'"$token_tail"
((${#token} == 40)) || fail 'could not generate a fixture credential'
readonly token_tail token

new_repo() {
    git init -q "$1"
}
commit_file() {
    local repo="$1" path="$2" content="$3"
    mkdir -p -- "$(dirname -- "$repo/$path")"
    printf '%s\n' "$content" > "$repo/$path"
    git -C "$repo" add -- "$path"
    git -C "$repo" commit -q -m "add $path"
}

cases=0
# expect_scan LABEL REPO STATUS [TEXT] [-- SCAN ARGUMENTS...]: the scan (SECRET_SCAN, by default
# scripts/ci:secret-scan) exits STATUS, prints TEXT when one is given, and never prints the
# credential, its body or its random tail.
expect_scan() {
    local label="$1" repo="$2" expected="$3" text="${4-}" status=0
    shift 4 || shift $#
    [[ "${1-}" != '--' ]] || shift
    HVO_SECRET_SCAN_REPO_ROOT="$repo" "${SECRET_SCAN:-$SCAN}" "$@" > "$work/output" 2>&1 || status=$?
    if grep -qF -e "$token" -e "${token#ghp_}" -e "$token_tail" "$work/output"; then
        fail "$label: the output shows the credential"
    fi
    ((status == expected)) || { cat "$work/output" >&2; fail "$label: exit $status, expected $expected"; }
    [[ -z "$text" ]] || grep -qF -- "$text" "$work/output" || { cat "$work/output" >&2; fail "$label: no \"$text\""; }
    cases=$((cases + 1))
}

clean="$work/clean"
new_repo "$clean"
commit_file "$clean" README.md 'Fixture repository.'
expect_scan 'clean history' "$clean" 0 'no findings'

# A credential that a later commit deleted is gone from the tree but not from history.
removed="$work/removed"
new_repo "$removed"
commit_file "$removed" README.md 'Fixture repository.'
commit_file "$removed" config/app.env "GITHUB_TOKEN=$token"
added="$(git -C "$removed" rev-parse --short=12 HEAD)"
git -C "$removed" rm -q config/app.env
git -C "$removed" commit -q -m 'remove config/app.env'
expect_scan 'credential removed from the tree' "$removed" 1 "config/app.env:1 in commit $added"
grep -qF 'github-pat' "$work/output" || fail 'the finding does not name its rule'

inline="$work/inline"
new_repo "$inline"
commit_file "$inline" src/settings.py "TOKEN = \"$token\"  # gitleaks:allow"
expect_scan 'inline gitleaks:allow comment' "$inline" 1 'src/settings.py:1'

# Only the history of the scanned commit counts, never another ref the clone holds.
git -C "$clean" switch -q -c leaked
commit_file "$clean" leak.txt "token: $token"
git -C "$clean" switch -q main
expect_scan 'another branch' "$clean" 0 'no findings'
expect_scan 'that branch named by --revision' "$clean" 1 'leak.txt:1' -- --revision leaked

# What a merge itself added is scanned: a credential that only a conflict resolution added, and one
# that a merge added to a file neither side changed. A later commit deletes each.
resolved="$work/resolved"
new_repo "$resolved"
commit_file "$resolved" config/app.env 'VALUE=base'
git -C "$resolved" switch -q -c side
commit_file "$resolved" config/app.env 'VALUE=side'
git -C "$resolved" switch -q main
commit_file "$resolved" config/app.env 'VALUE=main'
if git -C "$resolved" merge -q side > /dev/null 2>&1; then
    fail 'the conflict-resolution fixture merged without a conflict'
fi
printf 'GITHUB_TOKEN=%s\n' "$token" > "$resolved/config/app.env"
git -C "$resolved" add config/app.env
git -C "$resolved" commit -q --no-edit
merge="$(git -C "$resolved" rev-parse --short=12 HEAD)"
commit_file "$resolved" config/app.env 'VALUE=resolved'
expect_scan 'credential added only by a conflict resolution' "$resolved" 1 \
    "github-pat config/app.env:1 in commit $merge"

evil="$work/evil"
new_repo "$evil"
commit_file "$evil" README.md 'Fixture repository.'
git -C "$evil" switch -q -c side
commit_file "$evil" side.txt 'Side.'
git -C "$evil" switch -q main
commit_file "$evil" main.txt 'Main.'
git -C "$evil" merge -q --no-ff --no-commit side > /dev/null 2>&1
printf 'Fixture repository.\ntoken: %s\n' "$token" > "$evil/README.md"
git -C "$evil" add README.md
git -C "$evil" commit -q --no-edit
merge="$(git -C "$evil" rev-parse --short=12 HEAD)"
commit_file "$evil" README.md 'Fixture repository.'
expect_scan 'credential added by a merge to a file neither side changed' "$evil" 1 \
    "github-pat README.md:2 in commit $merge"

# Git shows no diff for a merge of more than two parents, so such a history is refused.
octopus="$work/octopus"
new_repo "$octopus"
commit_file "$octopus" README.md 'Fixture repository.'
for branch in one two; do
    git -C "$octopus" switch -q -c "$branch" main
    commit_file "$octopus" "$branch.txt" "Branch $branch."
done
git -C "$octopus" switch -q main
commit_file "$octopus" main.txt 'Main.'
git -C "$octopus" merge -q --no-edit one two > /dev/null 2>&1
expect_scan 'an octopus merge' "$octopus" 2 'has more than two parents'

# A tracked symlink replaced by a regular file that holds a credential is a type change.
retyped="$work/retyped"
new_repo "$retyped"
commit_file "$retyped" README.md 'Fixture repository.'
mkdir "$retyped/config"
ln -s ../README.md "$retyped/config/app.env"
git -C "$retyped" add config/app.env
git -C "$retyped" commit -q -m 'link config/app.env'
rm -- "$retyped/config/app.env"
printf 'GITHUB_TOKEN=%s\n' "$token" > "$retyped/config/app.env"
git -C "$retyped" add config/app.env
git -C "$retyped" commit -q -m 'replace the config/app.env link with a file'
[[ "$(git -C "$retyped" diff-tree --no-commit-id --name-status -r HEAD)" == $'T\tconfig/app.env' ]] ||
    fail 'the type-change fixture commit is not a type change'
expect_scan 'credential in a file that replaced a symlink' "$retyped" 1 \
    "github-pat config/app.env:1 in commit $(git -C "$retyped" rev-parse --short=12 HEAD)"

# A commit that gives gitleaks no text to read is accounted for as such, so none of these shapes can
# fail a full scan. Each fixture is one text commit followed by the shape.
shape_repo() {
    shaped="$work/shape-$1"
    new_repo "$shaped"
    commit_file "$shaped" README.md 'Fixture repository.'
}
shape_repo empty-file
: > "$shaped/empty.txt"
git -C "$shaped" add empty.txt
git -C "$shaped" commit -q -m 'add an empty file'
expect_scan 'an empty file added' "$shaped" 0 'The other 1 reachable commits added no text'
shape_repo mode
git -C "$shaped" update-index --chmod=+x README.md
git -C "$shaped" commit -q -m 'make README.md executable'
expect_scan 'a mode-only change' "$shaped" 0 'The other 1 reachable commits added no text'
shape_repo binary
printf 'fixture\0data\n' > "$shaped/fixture.dat"
git -C "$shaped" add fixture.dat
git -C "$shaped" commit -q -m 'add a binary file'
expect_scan 'a binary file added' "$shaped" 0 'The other 1 reachable commits added no text'
shape_repo archive
printf 'PK\003\004fixture\0' > "$shaped/fixture.zip"
git -C "$shaped" add fixture.zip
git -C "$shaped" commit -q -m 'add an archive'
expect_scan 'an archive added' "$shaped" 0 'The other 1 reachable commits added no text'
shape_repo rename
git -C "$shaped" mv README.md README.txt
git -C "$shaped" commit -q -m 'rename README.md'
expect_scan 'a pure rename' "$shaped" 0 'The other 1 reachable commits added no text'
shape_repo deletion
commit_file "$shaped" notes.txt 'Notes.'
git -C "$shaped" rm -q notes.txt
git -C "$shaped" commit -q -m 'remove notes.txt'
expect_scan 'a deletion' "$shaped" 0 'The other 1 reachable commits added no text'
shape_repo empty-commit
git -C "$shaped" commit -q --allow-empty -m 'an empty commit'
expect_scan 'an empty commit' "$shaped" 0 'The other 1 reachable commits added no text'

# A malformed expression makes gitleaks panic and print it, here with the credential inside, so its
# log must not reach the output. A copy of the scan reads the malformed configuration beside it.
mkdir -p "$work/malformed/scripts"
cp -- "$SCAN" "$work/malformed/scripts/"
printf '[extend]\nuseDefault = true\n\n[[allowlists]]\ndescription = "A malformed path expression."\npaths = [%s]\n' \
    "'''$token('''" > "$work/malformed/.gitleaks.toml"
SECRET_SCAN="$work/malformed/scripts/ci:secret-scan" expect_scan 'a malformed .gitleaks.toml expression' "$clean" 2 \
    'as a malformed expression in .gitleaks.toml causes'

git clone -q --depth 1 "file://$removed" "$work/shallow"
expect_scan 'shallow clone' "$work/shallow" 2 'the clone is shallow'

ignored="$work/ignored"
new_repo "$ignored"
commit_file "$ignored" README.md 'Fixture repository.'
printf 'anything\n' > "$ignored/.gitleaksignore"
expect_scan 'a .gitleaksignore file' "$ignored" 2 'record a reviewed exception in .gitleaks.toml'

expect_scan 'unknown revision' "$clean" 2 'missing is not a commit' -- --revision missing
expect_scan 'unknown option' "$clean" 2 'Usage:' -- --everything

printf '#!/bin/sh\necho 8.0.0\n' > "$work/old-gitleaks"
chmod +x "$work/old-gitleaks"
HVO_GITLEAKS_BIN="$work/old-gitleaks" expect_scan 'another gitleaks version' "$clean" 2 'expected gitleaks'

# A scan that gitleaks cuts short still fails. These stand-ins run the real gitleaks with one more
# git log option: --max-count=1 reads the newest commit only, and an option git rejects stops git at
# once, after which gitleaks reports 0 commits and exits 0.
archives=("$HVO_GITLEAKS_CACHE_DIR"/gitleaks_*.tar.gz)
if [[ -n "${HVO_GITLEAKS_BIN-}" ]]; then
    real_gitleaks="$HVO_GITLEAKS_BIN"
else
    [[ -f "${archives[0]}" ]] || fail 'the pinned gitleaks archive was not downloaded'
    mkdir "$work/real"
    tar -xzf "${archives[0]}" -C "$work/real" gitleaks
    real_gitleaks="$work/real/gitleaks"
fi
wrap_gitleaks() {
    {
        printf '#!/usr/bin/env bash\nreal=%q extra=%q\n' "$real_gitleaks" "$2"
        cat <<'SH'
args=()
while (($# > 0)); do
    if [[ "$1" == --log-opts ]]; then
        args+=("$1" "$extra $2")
        shift 2
    else
        args+=("$1")
        shift
    fi
done
exec "$real" "${args[@]}"
SH
    } > "$1"
    chmod +x "$1"
}
history="$work/history"
new_repo "$history"
commit_file "$history" README.md 'Fixture repository.'
commit_file "$history" notes.txt 'Notes.'
wrap_gitleaks "$work/cut-gitleaks" --max-count=1
HVO_GITLEAKS_BIN="$work/cut-gitleaks" expect_scan 'a scan cut short' "$history" 2 \
    'gitleaks scanned 1 commits, but 2 of the 2 commits'
wrap_gitleaks "$work/failing-gitleaks" --no-such-option
HVO_GITLEAKS_BIN="$work/failing-gitleaks" expect_scan 'git failing under gitleaks' "$history" 2 \
    'so its scan may be partial'

if [[ -z "${HVO_GITLEAKS_BIN-}" && -f "${archives[0]}" ]]; then
    mkdir "$work/tampered"
    cp -- "${archives[0]}" "$work/tampered/"
    printf 'x' >> "$work/tampered/${archives[0]##*/}"
    HVO_GITLEAKS_CACHE_DIR="$work/tampered" expect_scan 'tampered archive' "$clean" 2 'does not match the pinned SHA-256'
else
    printf 'Skipped the tampered-archive case: no pinned archive was downloaded on this host.\n'
fi

# The configuration keeps every exception reviewable and unable to hide a later commit. It reads the
# repository with the caller's Git configuration, not the fixture one.
env -u GIT_CONFIG_GLOBAL -u GIT_CONFIG_NOSYSTEM python3 - "$REPO_ROOT" <<'PY' ||
import pathlib, re, subprocess, sys

if sys.version_info < (3, 11):
    sys.exit(f"Python 3.11 or newer is required for tomllib; this is {sys.version.split()[0]}")
import tomllib

root = pathlib.Path(sys.argv[1])
config = tomllib.loads((root / ".gitleaks.toml").read_text())
errors = []
if config.get("extend") != {"useDefault": True}:
    errors.append("[extend] must be exactly useDefault = true, without disabledRules or a path")
if "allowlist" in config:
    errors.append("use [[allowlists]], not the legacy [allowlist]")
for rule in config.get("rules", []):
    if "allowlist" in rule or "allowlists" in rule:
        errors.append(f"rule {rule.get('id')} carries its own allowlist")
allowlists = config.get("allowlists", [])
for index, entry in enumerate(allowlists, 1):
    name = f"allowlist {index}"
    unknown = set(entry) - {"description", "targetRules", "condition", "commits", "paths"}
    if unknown:
        errors.append(f"{name} uses {sorted(unknown)}, which could match later commits")
    if not entry.get("description", "").strip():
        errors.append(f"{name} has no description")
    if entry.get("condition") != "AND":
        errors.append(f'{name} must use condition = "AND"')
    if not entry.get("targetRules") or not entry.get("paths"):
        errors.append(f"{name} must name its rules and paths")
    commits = entry.get("commits", [])
    if not commits:
        errors.append(f"{name} must name the historical commits it covers")
    for commit in commits:
        if not re.fullmatch(r"[0-9a-f]{40}", commit):
            errors.append(f"{name}: {commit!r} is not a full commit SHA")
        elif subprocess.run(["git", "-C", str(root), "merge-base", "--is-ancestor", commit, "HEAD"],
                            capture_output=True).returncode != 0:
            errors.append(f"{name}: {commit} is not in the history of HEAD")
tracked = subprocess.run(["git", "-C", str(root), "ls-files", "--", "*.gitleaksignore", ".gitleaksignore"],
                         capture_output=True, text=True, check=True).stdout.split()
if tracked:
    errors.append(f"tracked .gitleaksignore files: {tracked}")
if errors:
    print("\n".join(errors), file=sys.stderr)
    sys.exit(1)
print(f"{len(allowlists)} reviewed .gitleaks.toml exceptions, each limited to named historical commits.")
PY
    fail '.gitleaks.toml does not have the reviewed shape'

printf 'Secret scan contract passed: %d scan cases.\n' "$cases"
