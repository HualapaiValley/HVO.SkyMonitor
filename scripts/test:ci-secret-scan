#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

# Contract test for scripts/ci:secret-scan and .gitleaks.toml (#1321). Each case
# runs the real scan, with the pinned gitleaks, against a temporary fixture
# repository. The fake credential is generated at run time, so this file holds
# nothing a scan could match, and every case checks that the output never shows
# it. The cases share one downloaded archive through HVO_GITLEAKS_CACHE_DIR.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly REPO_ROOT="$SCRIPT_DIR/.."
readonly SCAN="$SCRIPT_DIR/ci:secret-scan"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
export HVO_GITLEAKS_CACHE_DIR="${HVO_GITLEAKS_CACHE_DIR:-$work/cache}"
# Fixture commits must not depend on the caller's Git configuration (signing, hooks, identity).
printf '[user]\n\tname = Secret Scan Fixture\n\temail = fixture@example.invalid\n[init]\n\tdefaultBranch = main\n' \
    > "$work/gitconfig"
export GIT_CONFIG_GLOBAL="$work/gitconfig" GIT_CONFIG_NOSYSTEM=1

fail() {
    printf 'Secret scan contract failed: %s\n' "$*" >&2
    exit 1
}

token="ghp_$(head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | cut -c 1-36)"
((${#token} == 40)) || fail 'could not generate a fixture credential'
readonly token

new_repo() {
    git init -q "$1"
}
commit_file() {
    local repo="$1" path="$2" content="$3"
    mkdir -p -- "$(dirname -- "$repo/$path")"
    printf '%s\n' "$content" > "$repo/$path"
    git -C "$repo" add -- "$path"
    git -C "$repo" commit -q -m "add $path"
}

cases=0
# expect_scan LABEL REPO STATUS [TEXT] [-- SCAN ARGUMENTS...]: the scan exits STATUS, prints TEXT
# when one is given, and never prints the credential or its body.
expect_scan() {
    local label="$1" repo="$2" expected="$3" text="${4-}" status=0
    shift 4 || shift $#
    [[ "${1-}" != '--' ]] || shift
    HVO_SECRET_SCAN_REPO_ROOT="$repo" "$SCAN" "$@" > "$work/output" 2>&1 || status=$?
    if grep -qF -e "$token" -e "${token#ghp_}" "$work/output"; then
        fail "$label: the output shows the credential"
    fi
    ((status == expected)) || { cat "$work/output" >&2; fail "$label: exit $status, expected $expected"; }
    [[ -z "$text" ]] || grep -qF -- "$text" "$work/output" || { cat "$work/output" >&2; fail "$label: no \"$text\""; }
    cases=$((cases + 1))
}

clean="$work/clean"
new_repo "$clean"
commit_file "$clean" README.md 'Fixture repository.'
expect_scan 'clean history' "$clean" 0 'no findings'

# A credential that a later commit deleted is gone from the tree but not from history.
removed="$work/removed"
new_repo "$removed"
commit_file "$removed" README.md 'Fixture repository.'
commit_file "$removed" config/app.env "GITHUB_TOKEN=$token"
added="$(git -C "$removed" rev-parse --short=12 HEAD)"
git -C "$removed" rm -q config/app.env
git -C "$removed" commit -q -m 'remove config/app.env'
expect_scan 'credential removed from the tree' "$removed" 1 "config/app.env:1 in commit $added"
grep -qF 'github-pat' "$work/output" || fail 'the finding does not name its rule'

inline="$work/inline"
new_repo "$inline"
commit_file "$inline" src/settings.py "TOKEN = \"$token\"  # gitleaks:allow"
expect_scan 'inline gitleaks:allow comment' "$inline" 1 'src/settings.py:1'

# Only the history of the scanned commit counts, never another ref the clone holds.
git -C "$clean" switch -q -c leaked
commit_file "$clean" leak.txt "token: $token"
git -C "$clean" switch -q main
expect_scan 'another branch' "$clean" 0 'no findings'
expect_scan 'that branch named by --revision' "$clean" 1 'leak.txt:1' -- --revision leaked

git clone -q --depth 1 "file://$removed" "$work/shallow"
expect_scan 'shallow clone' "$work/shallow" 2 'the clone is shallow'

ignored="$work/ignored"
new_repo "$ignored"
commit_file "$ignored" README.md 'Fixture repository.'
printf 'anything\n' > "$ignored/.gitleaksignore"
expect_scan 'a .gitleaksignore file' "$ignored" 2 'record a reviewed exception in .gitleaks.toml'

expect_scan 'unknown revision' "$clean" 2 'missing is not a commit' -- --revision missing
expect_scan 'unknown option' "$clean" 2 'Usage:' -- --everything

printf '#!/bin/sh\necho 8.0.0\n' > "$work/old-gitleaks"
chmod +x "$work/old-gitleaks"
HVO_GITLEAKS_BIN="$work/old-gitleaks" expect_scan 'another gitleaks version' "$clean" 2 'expected gitleaks'

archives=("$HVO_GITLEAKS_CACHE_DIR"/gitleaks_*.tar.gz)
if [[ -z "${HVO_GITLEAKS_BIN-}" && -f "${archives[0]}" ]]; then
    mkdir "$work/tampered"
    cp -- "${archives[0]}" "$work/tampered/"
    printf 'x' >> "$work/tampered/${archives[0]##*/}"
    HVO_GITLEAKS_CACHE_DIR="$work/tampered" expect_scan 'tampered archive' "$clean" 2 'does not match the pinned SHA-256'
else
    printf 'Skipped the tampered-archive case: no pinned archive was downloaded on this host.\n'
fi

# The configuration keeps every exception reviewable and unable to hide a later commit. It reads the
# repository with the caller's Git configuration, not the fixture one.
env -u GIT_CONFIG_GLOBAL -u GIT_CONFIG_NOSYSTEM python3 - "$REPO_ROOT" <<'PY' ||
import pathlib, re, subprocess, sys

if sys.version_info < (3, 11):
    sys.exit(f"Python 3.11 or newer is required for tomllib; this is {sys.version.split()[0]}")
import tomllib

root = pathlib.Path(sys.argv[1])
config = tomllib.loads((root / ".gitleaks.toml").read_text())
errors = []
if config.get("extend") != {"useDefault": True}:
    errors.append("[extend] must be exactly useDefault = true, without disabledRules or a path")
if "allowlist" in config:
    errors.append("use [[allowlists]], not the legacy [allowlist]")
for rule in config.get("rules", []):
    if "allowlist" in rule or "allowlists" in rule:
        errors.append(f"rule {rule.get('id')} carries its own allowlist")
allowlists = config.get("allowlists", [])
for index, entry in enumerate(allowlists, 1):
    name = f"allowlist {index}"
    unknown = set(entry) - {"description", "targetRules", "condition", "commits", "paths"}
    if unknown:
        errors.append(f"{name} uses {sorted(unknown)}, which could match later commits")
    if not entry.get("description", "").strip():
        errors.append(f"{name} has no description")
    if entry.get("condition") != "AND":
        errors.append(f'{name} must use condition = "AND"')
    if not entry.get("targetRules") or not entry.get("paths"):
        errors.append(f"{name} must name its rules and paths")
    commits = entry.get("commits", [])
    if not commits:
        errors.append(f"{name} must name the historical commits it covers")
    for commit in commits:
        if not re.fullmatch(r"[0-9a-f]{40}", commit):
            errors.append(f"{name}: {commit!r} is not a full commit SHA")
        elif subprocess.run(["git", "-C", str(root), "merge-base", "--is-ancestor", commit, "HEAD"],
                            capture_output=True).returncode != 0:
            errors.append(f"{name}: {commit} is not in the history of HEAD")
tracked = subprocess.run(["git", "-C", str(root), "ls-files", "--", "*.gitleaksignore", ".gitleaksignore"],
                         capture_output=True, text=True, check=True).stdout.split()
if tracked:
    errors.append(f"tracked .gitleaksignore files: {tracked}")
if errors:
    print("\n".join(errors), file=sys.stderr)
    sys.exit(1)
print(f"{len(allowlists)} reviewed .gitleaks.toml exceptions, each limited to named historical commits.")
PY
    fail '.gitleaks.toml does not have the reviewed shape'

printf 'Secret scan contract passed: %d scan cases.\n' "$cases"
