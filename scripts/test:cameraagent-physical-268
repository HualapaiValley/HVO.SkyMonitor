    [[ "$(findmnt -n -o SOURCE --target "$STATE_ROOT")" == /dev/mmcblk0p2 &&
       "$(findmnt -n -o FSTYPE --target "$STATE_ROOT")" == ext4 ]] || {
        printf 'ARM evidence export storage identity changed.\n' >&2
        exit 2
