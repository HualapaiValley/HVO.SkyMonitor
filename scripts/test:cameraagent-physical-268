[[ "$(timedatectl show --property=NTPSynchronized --value)" == yes ]] || { printf 'NTP must be synchronized.\n' >&2; exit 2; }
dmesg >/dev/null || { printf 'Kernel log access is required for USB fault evidence.\n' >&2; exit 2; }
running_cameraagents="$(docker ps --format '{{.Names}} {{.Image}}' | rg -i 'cameraagent|hvo.*camera' || true)"
[[ -z "$running_cameraagents" ]] || { printf 'Competing CameraAgent containers must be stopped:\n%s\n' "$running_cameraagents" >&2; exit 2; }
[[ -z "$(docker ps -a --filter 'name=^/hvo268-' --format '{{.Names}}')" ]] || { printf 'Stale hvo268 containers must be removed.\n' >&2; exit 2; }

