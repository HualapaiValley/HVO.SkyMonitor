((evidence_blocks * evidence_block_size >= MINIMUM_FREE_BYTES)) || { printf 'Evidence storage is below the %s-byte floor.\n' "$MINIMUM_FREE_BYTES" >&2; exit 2; }
readonly BLOCK_DEVICE="${EXPECTED_RUNTIME_DEVICE##*/}"
