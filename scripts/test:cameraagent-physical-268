assert_authenticated_execution_inputs() {
    local actual
    assert_source_unchanged 2>/dev/null || { printf 'Source identity changed during physical preflight.\n' >&2; return 1; }
    assert_static_identities 2>/dev/null || { printf 'Camera profile, SDK, header, or udev identity changed during physical preflight.\n' >&2; return 1; }
    assert_catalog_identity 2>/dev/null || { printf 'Catalog identity changed during physical preflight.\n' >&2; return 1; }
    sha256_matches "$COLLECTOR_CONFIG" "$COLLECTOR_CONFIG_SHA256" 2>/dev/null || {
        printf 'Collector configuration identity changed during physical preflight.\n' >&2
        return 1
    }
    [[ "$(docker image inspect "$HVO_OTEL_COLLECTOR_IMAGE" --format '{{.Id}}' 2>/dev/null)" == "$COLLECTOR_IMAGE_ID" ]] || {
        printf 'Collector image identity changed during physical preflight.\n' >&2
        return 1
    }
    [[ "$(docker image inspect "$CENTRAL_DENY_IMAGE" --format '{{.Id}}' 2>/dev/null)" == "$CENTRAL_DENY_IMAGE_ID" ]] || {
        printf 'Central-deny image identity changed during physical preflight.\n' >&2
        return 1
    }
    sha256_matches "$REPO_ROOT/tests/HVO.SkyMonitor.CameraAgent.Tests/bin/Release/net10.0/HVO.SkyMonitor.CameraAgent.Tests.dll" \
        "$HARDWARE_TEST_ASSEMBLY_SHA256" 2>/dev/null || {
        printf 'Hardware test assembly identity changed during physical preflight.\n' >&2
        return 1
    }
    sha256_matches "$REPO_ROOT/tests/HVO.SkyMonitor.CameraAgent.AcceptanceTests/bin/Release/net10.0/HVO.SkyMonitor.CameraAgent.AcceptanceTests.dll" \
        "$ACCEPTANCE_TEST_ASSEMBLY_SHA256" 2>/dev/null || {
        printf 'Acceptance test assembly identity changed during physical preflight.\n' >&2
        return 1
    }
    [[ "$(docker image inspect "$CAMERA_AGENT_IMAGE" --format '{{.Id}} {{.Architecture}}' 2>/dev/null)" == "$CAMERA_AGENT_IMAGE $EXPECTED_IMAGE_ARCH" ]] || {
        printf 'CameraAgent image identity changed during physical preflight.\n' >&2
        return 1
    }
    if ! actual="$(docker run --rm --entrypoint sha256sum "$CAMERA_AGENT_IMAGE" \
        /app/HVO.SkyMonitor.CameraAgent.dll 2>/dev/null | { read -r hash _; printf '%s' "$hash"; })"; then
        printf 'CameraAgent assembly identity could not be read during physical preflight.\n' >&2
        return 1
    fi
    [[ "$actual" == "$CAMERA_ASSEMBLY_SHA256" ]] || {
        printf 'CameraAgent assembly identity changed during physical preflight.\n' >&2
        return 1
    }
}

remaining_trial_seconds() {
    local remaining=$((trial_deadline_seconds - SECONDS))
    ((remaining > 0)) || { printf 'The absolute 80-minute deadline expired.\n' >&2; return 1; }
    printf '%s' "$remaining"
}

assert_before_trial_deadline() {
    remaining_trial_seconds >/dev/null
}

mounted_source() {
    local container="$1" destination="$2"
    docker inspect "$container" --format '{{json .Mounts}}' |
        jq --exit-status --raw-output --arg destination "$destination" \
            '[.[] | select(.Destination == $destination) | .Source] | if length == 1 then .[0] else error("mount is not unique") end'
}

mounted_entry() {
    local container="$1" destination="$2"
    docker inspect "$container" --format '{{json .Mounts}}' |
        jq --exit-status --arg destination "$destination" \
            '[.[] | select(.Destination == $destination)] | if length == 1 then .[0] else error("mount is not unique") end'
}

write_host_manifest() {
    local output="$1"
    jq -n \
        --arg commit "$REVISION" --arg branch "$BRANCH" --arg profile "$PROFILE" --arg model "$CAMERA_MODEL" \
        --arg kernel "$(uname -r)" --arg architecture "$EXPECTED_ARCH" \
        --argjson memoryBytes "$EXPECTED_MEMORY_BYTES" \
        --arg imageArchitecture "$EXPECTED_IMAGE_ARCH" --arg dotnetSdk "$DOTNET_SDK_VERSION" --arg dockerVersion "$DOCKER_VERSION" \
        --arg cameraImage "$CAMERA_AGENT_IMAGE" --arg cameraAssemblySha256 "$CAMERA_ASSEMBLY_SHA256" \
        --arg hardwareTestAssemblySha256 "$HARDWARE_TEST_ASSEMBLY_SHA256" --arg acceptanceTestAssemblySha256 "$ACCEPTANCE_TEST_ASSEMBLY_SHA256" \
        --arg profileSha256 "$PROFILE_CONFIG_SHA256" --arg resolvedConfigSha256 "$effective_config_sha256" \
        --arg sdkSha256 "$EXPECTED_SDK_SHA256" --arg headerSha256 "$EXPECTED_HEADER_SHA256" --arg udevSha256 "$EXPECTED_UDEV_SHA256" \
        --arg catalogSha256 "$EXPECTED_CATALOG_SHA256" --arg sourceCatalogTreeSha256 "$SOURCE_CATALOG_TREE_SHA256" \
        --arg copiedCatalogTreeSha256 "$effective_catalog_tree_sha256" \
        --arg collectorImage "$HVO_OTEL_COLLECTOR_IMAGE" --arg collectorImageId "$COLLECTOR_IMAGE_ID" \
        --arg collectorConfigSha256 "$effective_collector_config_sha256" \
        --arg centralDenyImage "$CENTRAL_DENY_IMAGE" --arg centralDenyImageId "$CENTRAL_DENY_IMAGE_ID" \
        --arg usbIdentity "03c3:$EXPECTED_USB_PRODUCT" \
        --arg runtimeKind "$runtime_kind" --arg runtimeFs "$runtime_mount_fs" \
        --arg dockerFs "$docker_mount_fs" --arg evidenceFs "$evidence_mount_fs" \
        --argjson runtimeFreeBytes "$runtime_free_bytes" --argjson dockerFreeBytes "$docker_free_bytes" \
        --argjson evidenceFreeBytes "$evidence_free_bytes" \
        --argjson logicalBlockSize "$BLOCK_LOGICAL_SIZE" '
      {
        schemaVersion: "issue-268-physical-host-manifest-v1",
        revision: {commit: $commit, branch: $branch, clean: true},
        host: {nameRetained: false, kernel: $kernel, architecture: $architecture, imageArchitecture: $imageArchitecture,
          logicalCpuCount: null, memoryBytes: $memoryBytes, dotnetSdk: $dotnetSdk,
          dockerVersion: $dockerVersion, ntpSynchronized: true},
        profile: {id: $profile, model: $model},
        sourceIdentities: {cameraImage: $cameraImage, cameraAssemblySha256: $cameraAssemblySha256,
          hardwareTestAssemblySha256: $hardwareTestAssemblySha256, acceptanceTestAssemblySha256: $acceptanceTestAssemblySha256,
          committedProfileSha256: $profileSha256, resolvedConfigurationSha256: $resolvedConfigSha256,
          sdkLibrarySha256: $sdkSha256, sdkHeaderSha256: $headerSha256, udevRuleSha256: $udevSha256,
          catalogSha256: $catalogSha256, sourceCatalogTreeSha256: $sourceCatalogTreeSha256,
          copiedCatalogTreeSha256: $copiedCatalogTreeSha256,
          collectorImage: $collectorImage, collectorImageId: $collectorImageId,
          collectorConfigurationSha256: $collectorConfigSha256,
          centralDenyImage: $centralDenyImage, centralDenyImageId: $centralDenyImageId},
        usb: {sysfsPathRetained: false, identity: $usbIdentity, speedMegabits: 5000, usbfsMemoryMegabytes: 200,
          privateSerialRetained: false},
        storage: {runtime: {kind: $runtimeKind, path: "runtime", filesystem: $runtimeFs,
            freeBytes: $runtimeFreeBytes, logicalBlockSize: $logicalBlockSize,
            volumeInspectRetained: false,
            containerMount: {type:"volume", sourceRetained:false, nameRetained:false,
              destination:"/var/lib/hvo/data/agent"}},
          evidence: {path:"evidence", filesystem:$evidenceFs, freeBytes:$evidenceFreeBytes},
          docker: {path:"docker", filesystem:$dockerFs, freeBytes:$dockerFreeBytes}}
      }' > "$output"
    jq --argjson cpus "$(nproc)" '.host.logicalCpuCount = $cpus' "$output" > "$output.tmp"
    mv "$output.tmp" "$output"
}

metric_sum() {
    local body="$1" family="$2"
    awk -v family="$family" '$0 !~ /^#/ && ($1 == family || index($1, family "{") == 1) {sum += $NF} END {printf "%.17g", sum + 0}' <<< "$body"
}

sample_resources() {
    local container="$1" central_deny="$2" output="$3"
    local next_sample_milliseconds
    next_sample_milliseconds="$(date +%s%3N)"
    while docker inspect "$container" --format '{{.State.Running}}' 2>/dev/null | rg -x true >/dev/null; do
        local now monotonic_milliseconds pid rss_bytes read_bytes write_bytes read_syscalls write_syscalls metrics docker_stats proc_stat cpu_ticks
        local ingress lanes processing oldest combined throttled arm_temp host_temp
        local metrics_available container_available central_deny_available health_status host_available_bytes database_bytes wal_bytes shm_bytes
        local central_deny_state
        now="$(date +%s%3N)"
        monotonic_milliseconds="$(awk '{printf "%.0f", $1 * 1000}' /proc/uptime)"
        pid="$(docker inspect "$container" --format '{{.State.Pid}}')"
        rss_bytes=0 read_bytes=0 write_bytes=0 read_syscalls=0 write_syscalls=0 proc_stat='' cpu_ticks=0
        if [[ -r "/proc/$pid/status" ]]; then
            while IFS=':' read -r key value; do
                case "$key" in VmRSS) read -r value _ <<< "$value"; rss_bytes=$((value * 1024));; esac
            done < "/proc/$pid/status"
            while IFS=':' read -r key value; do
                case "$key" in
                    read_bytes) read_bytes="${value//[[:space:]]/}" ;;
                    write_bytes) write_bytes="${value//[[:space:]]/}" ;;
                    syscr) read_syscalls="${value//[[:space:]]/}" ;;
                    syscw) write_syscalls="${value//[[:space:]]/}" ;;
                esac
            done < "/proc/$pid/io"
            proc_stat="$(<"/proc/$pid/stat")"
            read -r -a proc_fields <<< "${proc_stat#*) }"
            cpu_ticks=$((proc_fields[11] + proc_fields[12]))
        fi
        metrics="$(curl --fail --silent --max-time 2 "$camera_base_uri/metrics" 2>/dev/null || true)"
        metrics_available=false
        [[ -n "$metrics" ]] && metrics_available=true
        health_status="$(curl --fail --silent --max-time 2 "$camera_base_uri/health" 2>/dev/null | jq -r '.status // "Unavailable"' 2>/dev/null || printf 'Unavailable')"
        ingress="$(metric_sum "$metrics" 'camera_agent_ingress_pending')"
        lanes="$(metric_sum "$metrics" 'camera_agent_lanes_pending')"
        processing="$(metric_sum "$metrics" 'camera_agent_processing_pending')"
        oldest="$(printf '%s\n%s\n%s\n' \
            "$(metric_sum "$metrics" 'camera_agent_ingress_oldest_age_seconds')" \
            "$(metric_sum "$metrics" 'camera_agent_lanes_oldest_age_seconds')" \
            "$(metric_sum "$metrics" 'camera_agent_processing_oldest_age_seconds')" | sort -n | tail -n 1)"
        combined="$(awk -v a="$ingress" -v b="$lanes" -v c="$processing" 'BEGIN {print a+b+c}')"
        container_available=false
        if docker_stats="$(docker stats --no-stream --format '{{json .}}' "$container" 2>/dev/null)" && [[ -n "$docker_stats" ]]; then
            container_available=true
        else
            docker_stats='{}'
        fi
        central_deny_available=false
        if central_deny_state="$(docker inspect "$central_deny" --format '{{json .State}}' 2>/dev/null)" &&
           jq --exit-status '.Running == true and .Status == "running" and .OOMKilled == false and .Error == ""' \
               <<< "$central_deny_state" >/dev/null; then
            central_deny_available=true
        else
            central_deny_state='{}'
        fi
        throttled='N/A'
        arm_temp='null'
        if [[ "$PROFILE" == asi676mc ]]; then
            throttled="$(vcgencmd get_throttled | cut -d= -f2)"
            arm_temp="$(vcgencmd measure_temp | cut -d= -f2 | cut -d\' -f1)"
        fi
        host_temp='null'
        if [[ -r /sys/class/thermal/thermal_zone0/temp ]]; then host_temp="$(awk '{print $1 / 1000}' /sys/class/thermal/thermal_zone0/temp)"; fi
        host_available_bytes="$(awk '/^MemAvailable:/ {print $2 * 1024}' /proc/meminfo)"
        read -r database_bytes wal_bytes shm_bytes <<< "$(docker exec "$container" /bin/sh -c '
          for path in /var/lib/hvo/data/agent/journal/raw-ingress.db /var/lib/hvo/data/agent/journal/raw-ingress.db-wal /var/lib/hvo/data/agent/journal/raw-ingress.db-shm; do
            if [ -e "$path" ]; then stat -c %s "$path"; else printf "0 "; fi
          done' 2>/dev/null | tr '\n' ' ')"
        database_bytes="${database_bytes:-0}"; wal_bytes="${wal_bytes:-0}"; shm_bytes="${shm_bytes:-0}"
        jq -cn \
            --argjson timestamp "$now" --argjson monotonicTimestamp "$monotonic_milliseconds" \
            --argjson pid "$pid" --argjson rss "$rss_bytes" \
            --argjson cpuTicks "$cpu_ticks" --argjson clockTicksPerSecond "$CLOCK_TICKS_PER_SECOND" \
            --argjson readBytes "$read_bytes" --argjson writeBytes "$write_bytes" \
            --argjson readSyscalls "$read_syscalls" --argjson writeSyscalls "$write_syscalls" \
            --arg procStat "$proc_stat" --arg hostStat "$(< /proc/stat)" \
            --arg memInfo "$(< /proc/meminfo)" --arg loadAverage "$(< /proc/loadavg)" \
            --arg blockStat "$(<"/sys/class/block/$BLOCK_DEVICE/stat")" --argjson docker "$docker_stats" \
            --argjson containerAvailable "$container_available" --argjson centralDenyAvailable "$central_deny_available" \
            --argjson centralDenyState "$central_deny_state" --argjson metricsAvailable "$metrics_available" --arg healthStatus "$health_status" \
            --argjson hostAvailableBytes "$host_available_bytes" --argjson databaseBytes "$database_bytes" \
            --argjson walBytes "$wal_bytes" --argjson shmBytes "$shm_bytes" \
            --argjson ingress "$ingress" --argjson lanes "$lanes" --argjson processing "$processing" \
            --argjson oldest "$oldest" --argjson combined "$combined" \
            --argjson usbPresent "$([[ -e "$HVO_ISSUE_268_USB_SYSFS_PATH" ]] && printf true || printf false)" \
            --argjson usbSpeed "$([[ -r "$HVO_ISSUE_268_USB_SYSFS_PATH/speed" ]] && cat "$HVO_ISSUE_268_USB_SYSFS_PATH/speed" || printf 0)" \
            --arg throttled "$throttled" --argjson armTemperature "$arm_temp" --argjson hostTemperature "$host_temp" '
          {timestampUnixMilliseconds: $timestamp, monotonicTimestampMilliseconds: $monotonicTimestamp,
           process: {available: ($pid > 0 and ($procStat | length) > 0), pid: $pid, rssBytes: $rss,
             readBytes: $readBytes, writeBytes: $writeBytes, readSyscalls: $readSyscalls, writeSyscalls: $writeSyscalls,
             cpuTicks: $cpuTicks, clockTicksPerSecond: $clockTicksPerSecond, stat: $procStat},
           containerAvailable: $containerAvailable,
           container: $docker,
           centralDeny: {available: $centralDenyAvailable, state: $centralDenyState},
           host: {stat: $hostStat, meminfo: $memInfo, loadAverage: $loadAverage,
             blockDeviceStat: $blockStat, availableMemoryBytes: $hostAvailableBytes, temperatureC: $hostTemperature},
           application: {metricsAvailable: $metricsAvailable, healthStatus: $healthStatus},
           sqliteFiles: {databaseBytes: $databaseBytes, walBytes: $walBytes, shmBytes: $shmBytes},
           backlog: {ingress: $ingress, lanes: $lanes, processing: $processing,
             combined: $combined, oldestAgeSeconds: $oldest},
           usb: {present: $usbPresent, speedMegabits: $usbSpeed},
           arm: {throttled: $throttled, temperatureC: $armTemperature}}' >> "$output"
        next_sample_milliseconds=$((next_sample_milliseconds + 2000))
        local current_milliseconds delay_milliseconds
        current_milliseconds="$(date +%s%3N)"
        delay_milliseconds=$((next_sample_milliseconds - current_milliseconds))
        if ((delay_milliseconds > 0)); then
            sleep "$(awk -v milliseconds="$delay_milliseconds" 'BEGIN {printf "%.3f", milliseconds / 1000}')"
        else
            next_sample_milliseconds="$current_milliseconds"
        fi
    done
}

write_inventory() {
    local root="$1" output="$2"
    local rows="$root/.inventory.jsonl"
    : > "$rows"
    while IFS= read -r -d '' file; do
        [[ "$file" != "$rows" && "$file" != "$output" ]] || continue
        local relative sha bytes
        relative="${file#"$root/"}"
        read -r sha _ < <(sha256sum "$file")
        bytes="$(stat --format='%s' "$file")"
        jq -cn --arg path "$relative" --arg sha256 "${sha^^}" --argjson bytes "$bytes" \
            '{path: $path, bytes: $bytes, sha256: $sha256}' >> "$rows"
    done < <(find "$root" -type f -print0 | sort -z)
    jq -s --arg commit "$REVISION" '{schemaVersion: "issue-268-evidence-manifest-v1", revision: $commit,
      files: sort_by(.path), fileCount: length, totalBytes: (map(.bytes) | add // 0)}' "$rows" > "$output"
    rm -f "$rows"
}

write_authenticated_trial_manifest() {
    local root="$1" output="$2" schema="$3" include_summary="$4"
    local rows="$root/.trial-authenticated-inventory.jsonl"
    local file relative hash bytes identity
    : > "$rows"
    while IFS= read -r -d '' file; do
        case "$file" in
            "$rows"|"$output"|*/evidence-manifest.json|*.tmp) continue ;;
        esac
        if [[ "$include_summary" == false && "$file" == */trial-summary.json ]]; then continue; fi
        relative="${file#"$root/"}"
        read -r hash _ < <(sha256sum "$file")
        bytes="$(stat --format='%s' "$file")"
        jq -cn --arg path "$relative" --arg sha256 "${hash^^}" --argjson bytes "$bytes" \
            '{path:$path, bytes:$bytes, sha256:$sha256}' >> "$rows"
    done < <(find "$root" -type f -print0 | sort -z)
    jq -cS -s --arg schema "$schema" --arg revision "$REVISION" --arg profile "$PROFILE" --arg trial "$trial" '
      {schemaVersion:$schema, revision:$revision, profile:$profile, trial:$trial,
       files:sort_by(.path), fileCount:length, totalBytes:(map(.bytes) | add // 0)}' "$rows" > "$output.input"
    read -r identity _ < <(sha256sum "$output.input")
    jq --arg identity "${identity^^}" '. + {evidenceIdentitySha256:$identity}' "$output.input" > "$output"
    rm -f "$rows" "$output.input"
}

verify_authenticated_manifest() {
    "$MANIFEST_VERIFIER" "$1" "$2"
}

aggregate_retained_trial() {
    local evidence="$1" output="$2"
    jq -n --arg mode trial \
        --slurpfile acquisition "$evidence/capture-evidence.json" \
        --slurpfile host "$evidence/host-manifest.json" \
        --slurpfile resources "$evidence/resource-samples.jsonl" \
        --slurpfile metrics "$evidence/telemetry/metrics.json" \
        --slurpfile traces "$evidence/telemetry/traces.json" \
        --slurpfile logs "$evidence/telemetry/logs.json" \
        --slurpfile dmesg "$evidence/dmesg-status.json" \
        --slurpfile exportIo "$evidence/export-io.json" \
        --slurpfile execution "$evidence/trial-execution.json" \
        --slurpfile trialManifests "$evidence/trial-input-manifest.json" \
        --argjson trials '[]' --argjson campaignManifests '[]' \
        -f "$AGGREGATOR" > "$output"
}

sanitize_text_file() {
    local path="$1"
    local temporary="$path.sanitized"
    if ! {
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "${line,,}" == *"${HVO_ZWO_CAMERA_SERIAL,,}"* ]]; then
                line='[REDACTED-CAMERA-SERIAL-LINE]'
            fi
            if [[ -n "$owner_password" && "$line" == *"$owner_password"* ]]; then
                line='[REDACTED-CREDENTIAL-LINE]'
            fi
            line="${line//"$REPO_ROOT"/[REPOSITORY]}"
            line="${line//"$STATE_ROOT"/[AGENT-STATE]}"
            line="${line//"$HVO_ZWO_SDK_LIBRARY"/[SDK-LIBRARY]}"
            if [[ -n "$runtime_path" ]]; then line="${line//"$runtime_path"/[RUNTIME-ROOT]}"; fi
            if [[ -n "$camera_container_ip" ]]; then line="${line//"$camera_container_ip"/[CONTAINER-IP]}"; fi
            if [[ "${line,,}" =~ authorization:|bearer[[:space:]]|set-cookie:|requestverificationtoken|token[=:]|actor[=:]|idempotency|checksum|storage[_-]?(reference|path|id)|[0-9a-f]{8}-[0-9a-f-]{27,}|(^|[^0-9a-f])[0-9a-f]{64}([^0-9a-f]|$)|/(home|workspaces|tmp|var/lib/hvo)/[^[:space:]]+ ]]; then
                printf '%s\n' '[REDACTED-PRIVATE-LINE]'
            else
                printf '%s\n' "$line"
            fi
        done < "$path" > "$temporary"
    }; then
        rm -f -- "$temporary"
        return 1
    fi
    mv "$temporary" "$path"
}

for ((trial_number = 1; trial_number <= TRIAL_COUNT; trial_number++)); do
    failure_stage=preacquisition
    assert_source_unchanged
    assert_static_identities || { printf 'Static identity changed before trial %s.\n' "$trial_number" >&2; exit 1; }
    assert_host_runtime_identity || { printf 'Host identity changed before trial %s.\n' "$trial_number" >&2; exit 1; }
    trial="trial-$(printf '%02d' "$trial_number")"
    trial_deadline_seconds=$((SECONDS + 4800))
    trial_deadline_unix_seconds=$(($(date +%s) + 4800))
    runner_pid=$$
    (exec 7>&- 8>&-; sleep 4800; kill -TERM "$runner_pid") &
    deadline_pid=$!
    trial_started_seconds="$(date +%s)"
    trial_root="$CAMPAIGN_ROOT/$trial"
    evidence_root="$trial_root/evidence"
    control_root="$trial_root/control"
    active_control_root="$control_root"
    mkdir -p "$evidence_root/telemetry" "$control_root"/{config,dataprotection,secrets,catalog}
    printf '%s\n' 'hvo-issue-268-trial-v1' > "$trial_root/.hvo-issue-268-owned"

    [[ -z "$(fuser "$USB_DEVICE_NODE" 2>/dev/null || true)" ]] || { printf 'Camera was opened before %s idle.\n' "$trial" >&2; exit 1; }
    idle_started="$(date +%s)"
    timeout "$(remaining_trial_seconds)s" sleep 600
    idle_elapsed=$(($(date +%s) - idle_started))
    ((idle_elapsed >= 600)) || { printf '%s idle period was shorter than ten minutes.\n' "$trial" >&2; exit 1; }
    assert_host_runtime_identity || { printf 'Host identity changed during %s idle.\n' "$trial" >&2; exit 1; }
    [[ -z "$(fuser "$USB_DEVICE_NODE" 2>/dev/null || true)" ]] || { printf 'Camera was opened during %s idle.\n' "$trial" >&2; exit 1; }
    assert_authenticated_execution_inputs || { printf 'Authenticated inputs changed after %s idle.\n' "$trial" >&2; exit 1; }

    resolved_config="$control_root/config/cameraagent.json"
    gain="$(jq -r '.rig.pipeline.nightGain' "$PROFILE_FILE")"
    jq --argjson gain "$gain" '
      .agentId = "cameraagent-physical-268" |
      .rig.pipeline.dayExposure = "00:00:20" |
      .rig.pipeline.nightExposure = "00:00:20" |
      .rig.pipeline.dayGain = $gain |
      .rig.pipeline.nightGain = $gain |
      .rig.pipeline.envelope.dayDefaults.exposure = "00:00:20" |
      .rig.pipeline.envelope.nightDefaults.exposure = "00:00:20" |
      .rig.pipeline.envelope.dayDefaults.gain = $gain |
      .rig.pipeline.envelope.nightDefaults.gain = $gain
    ' "$PROFILE_FILE" > "$resolved_config"
    cp -a "$HVO_CATALOG_PERF_ROOT/." "$control_root/catalog/"
    cp "$COLLECTOR_CONFIG" "$control_root/config/otel-collector.yml"
    owner_password="Aa!$(openssl rand -hex 32)"
    printf '%s\n' "$owner_password" > "$control_root/secrets/owner-password"
    cp "$resolved_config" "$evidence_root/resolved-config.sanitized.json"
    assert_authenticated_execution_inputs || { printf 'Authenticated inputs changed before %s execution.\n' "$trial" >&2; exit 1; }

    runtime_volume="hvo268-${PROFILE}-${REVISION:0:12}-${trial_number}"
    if docker volume inspect "$runtime_volume" >/dev/null 2>&1; then
        printf 'Create-new runtime volume already exists: %s\n' "$runtime_volume" >&2
        exit 1
    fi
    runtime_kind='docker-named-volume'
    runtime_path="/var/lib/docker/volumes/$runtime_volume/_data"
    if [[ "$PROFILE" == asi178mc ]]; then
        runtime_kind='bind-backed-docker-volume'
        runtime_path="/home/roys/hvo-268-runtime/$REVISION/$trial"
        [[ ! -e "$runtime_path" ]] || { printf 'Create-new x64 runtime path exists: %s\n' "$runtime_path" >&2; exit 1; }
        mkdir -p "$runtime_path"
        printf '%s\n' 'hvo-issue-268-runtime-v1' > "$runtime_path/.hvo-issue-268-owned"
        docker volume create --label "hvo.issue-268.owner=$REVISION:$PROFILE" \
            --driver local --opt type=none --opt o=bind --opt "device=$runtime_path" "$runtime_volume" >/dev/null
    else
        docker volume create --label "hvo.issue-268.owner=$REVISION:$PROFILE" "$runtime_volume" >/dev/null
        runtime_init_container="hvo268-${REVISION:0:8}-${PROFILE}-${trial_number}-runtime-init"
        docker run --rm --name "$runtime_init_container" --user 0:0 --volume "$runtime_volume:/runtime" \
            --entrypoint /bin/sh "$CAMERA_AGENT_IMAGE" \
            -c 'mkdir -p /runtime && printf "%s\n" hvo-issue-268-runtime-v1 > /runtime/.hvo-issue-268-owned && chown -R "$1:$2" /runtime' \
            -- "$(id -u)" "$(id -g)"
        runtime_init_container=''
    fi

    if [[ "$runtime_kind" == docker-named-volume ]]; then
        runtime_storage_path="$(docker volume inspect "$runtime_volume" --format '{{.Mountpoint}}')"
        runtime_path="$runtime_storage_path"
    else
        runtime_storage_path="$runtime_path"
    fi
    runtime_volume_source="$(docker volume inspect "$runtime_volume" --format '{{.Mountpoint}}')"
    if [[ "$runtime_kind" == docker-named-volume ]]; then
        read -r runtime_mount_source _runtime_mount_target runtime_mount_fs _runtime_mount_options < <(
            sudo -n findmnt -n -o SOURCE,TARGET,FSTYPE,OPTIONS --target "$runtime_storage_path")
    else
        read -r runtime_mount_source _runtime_mount_target runtime_mount_fs _runtime_mount_options < <(
            findmnt -n -o SOURCE,TARGET,FSTYPE,OPTIONS --target "$runtime_storage_path")
    fi
    read -r _docker_mount_source _docker_mount_target docker_mount_fs _docker_mount_options < <(
        findmnt -n -o SOURCE,TARGET,FSTYPE,OPTIONS --target "$DOCKER_ROOT")
    read -r evidence_mount_source _evidence_mount_target evidence_mount_fs _evidence_mount_options < <(
        findmnt -n -o SOURCE,TARGET,FSTYPE,OPTIONS --target "$evidence_root")
    [[ "$runtime_mount_source" == "$EXPECTED_RUNTIME_DEVICE" && "$runtime_mount_fs" == "$EXPECTED_RUNTIME_FS" ]] || {
        printf 'Per-trial runtime mount identity changed: %s %s.\n' "$runtime_mount_source" "$runtime_mount_fs" >&2
        exit 1
    }
    if [[ "$PROFILE" == asi676mc ]]; then
        [[ "$evidence_mount_source" == /dev/mmcblk0p2 && "$evidence_mount_fs" == ext4 ]] || {
            printf 'Per-trial ARM evidence mount identity changed.\n' >&2
            exit 1
        }
    fi
    if [[ "$runtime_kind" == docker-named-volume ]]; then
        read -r free_blocks free_block_size < <(sudo -n stat -f --format='%a %S' "$runtime_storage_path")
    else
        read -r free_blocks free_block_size < <(stat -f --format='%a %S' "$runtime_storage_path")
    fi
    runtime_free_bytes=$((free_blocks * free_block_size))
    read -r free_blocks free_block_size < <(stat -f --format='%a %S' "$DOCKER_ROOT")
    docker_free_bytes=$((free_blocks * free_block_size))
    read -r free_blocks free_block_size < <(stat -f --format='%a %S' "$evidence_root")
    evidence_free_bytes=$((free_blocks * free_block_size))
    ((runtime_free_bytes >= MINIMUM_FREE_BYTES && docker_free_bytes >= MINIMUM_FREE_BYTES && evidence_free_bytes >= MINIMUM_FREE_BYTES)) || {
        printf 'A per-trial runtime, Docker, or evidence mount is below the free-space floor.\n' >&2
        exit 1
    }
    EVIDENCE_BLOCK_DEVICE="${evidence_mount_source##*/}"

    suffix="${REVISION:0:8}-${PROFILE}-${trial_number}"
    cleanup_project="hvo268-$suffix"
    camera_container="hvo268-$suffix-camera"
    collector_container="hvo268-$suffix-collector"
    central_deny_container="hvo268-$suffix-central-deny"
    cleanup_env="$control_root/compose.env"
    cat > "$cleanup_env" <<EOF
CAMERA_AGENT_IMAGE=$CAMERA_AGENT_IMAGE
CAMERA_AGENT_CONTAINER=$camera_container
CAMERA_AGENT_CONFIG_SOURCE=$resolved_config
CAMERA_AGENT_DATA_PROTECTION_SOURCE=$control_root/dataprotection
CAMERA_AGENT_CATALOG_SOURCE=$control_root/catalog
CAMERA_AGENT_OWNER_PASSWORD_FILE=$control_root/secrets/owner-password
CAMERA_RUNTIME_VOLUME=$runtime_volume
HVO_ZWO_SDK_LIBRARY=$HVO_ZWO_SDK_LIBRARY
HVO_ZWO_CAMERA_SERIAL=$HVO_ZWO_CAMERA_SERIAL
SERVICE_INSTANCE_ID=physical-268-$PROFILE-$trial
OTEL_COLLECTOR_IMAGE=$HVO_OTEL_COLLECTOR_IMAGE
OTEL_COLLECTOR_CONTAINER=$collector_container
OTEL_COLLECTOR_CONFIG_SOURCE=$control_root/config/otel-collector.yml
OTEL_EVIDENCE_SOURCE=$evidence_root/telemetry
CENTRAL_DENY_IMAGE=$CENTRAL_DENY_IMAGE
CENTRAL_DENY_CONTAINER=$central_deny_container
USB_DEVICE_GID=$USB_DEVICE_GID
USB_DEVICE_NODE=$USB_DEVICE_NODE
LOCAL_UID=$(id -u)
LOCAL_GID=$(id -g)
EOF
    chmod 600 "$cleanup_env" "$control_root/secrets/owner-password"
    effective_config_sha256="$(sha256sum "$resolved_config" | { read -r hash _; printf '%s' "$hash"; })"
    effective_catalog_tree_sha256="$(tree_sha256 "$control_root/catalog")"
    effective_collector_config_sha256="$(sha256sum "$control_root/config/otel-collector.yml" | { read -r hash _; printf '%s' "$hash"; })"
    [[ "$effective_catalog_tree_sha256" == "$SOURCE_CATALOG_TREE_SHA256" ]] || {
        printf 'Copied catalog tree differs from the authenticated source tree.\n' >&2
        exit 1
    }
    write_host_manifest "$evidence_root/host-manifest.json"
    jq --argjson idleSeconds "$idle_elapsed" '. + {idle: {cameraClosed: true, elapsedSeconds: $idleSeconds}}' \
        "$evidence_root/host-manifest.json" > "$evidence_root/host-manifest.json.tmp"
    mv "$evidence_root/host-manifest.json.tmp" "$evidence_root/host-manifest.json"

    docker compose --env-file "$cleanup_env" --project-name "$cleanup_project" --file "$COMPOSE_FILE" config --quiet
    rendered_compose_sha256="$(docker compose --env-file "$cleanup_env" --project-name "$cleanup_project" --file "$COMPOSE_FILE" config | sha256sum | { read -r hash _; printf '%s' "$hash"; })"
    jq --arg hash "$rendered_compose_sha256" '.sourceIdentities.renderedComposeSha256 = $hash' \
        "$evidence_root/host-manifest.json" > "$evidence_root/host-manifest.json.tmp"
    mv "$evidence_root/host-manifest.json.tmp" "$evidence_root/host-manifest.json"

    dmesg --follow-new --decode 7>&- 8>&- > "$control_root/kernel-live.raw" &
    kernel_pid=$!
    sleep 1
    kill -0 "$kernel_pid" 2>/dev/null || { printf 'dmesg follow exited before CameraAgent startup.\n' >&2; exit 1; }
    jq -n --argjson pid "$kernel_pid" --arg startedUtc "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
        '{schemaVersion:"issue-268-dmesg-monitor-v2", pid:$pid, startedUtc:$startedUtc, liveBeforeCameraAgent:true}' \
        > "$evidence_root/dmesg-status.json"

    prestart_config_sha256="$(sha256sum "$resolved_config" | { read -r hash _; printf '%s' "$hash"; })"
    prestart_catalog_tree_sha256="$(tree_sha256 "$control_root/catalog")"
    prestart_collector_config_sha256="$(sha256sum "$control_root/config/otel-collector.yml" | { read -r hash _; printf '%s' "$hash"; })"
    jq --arg capturedUtc "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" --arg configSha256 "$prestart_config_sha256" \
        --arg catalogTreeSha256 "$prestart_catalog_tree_sha256" --arg collectorConfigSha256 "$prestart_collector_config_sha256" '
      .mountAuthentication.prestart = {capturedUtc:$capturedUtc, configSha256:$configSha256,
        catalogTreeSha256:$catalogTreeSha256, collectorConfigurationSha256:$collectorConfigSha256,
        passed: ($configSha256 == .sourceIdentities.resolvedConfigurationSha256 and
          $catalogTreeSha256 == .sourceIdentities.copiedCatalogTreeSha256 and
          $collectorConfigSha256 == .sourceIdentities.collectorConfigurationSha256)}
    ' "$evidence_root/host-manifest.json" > "$evidence_root/host-manifest.json.tmp"
    mv "$evidence_root/host-manifest.json.tmp" "$evidence_root/host-manifest.json"
    jq --exit-status '.mountAuthentication.prestart.passed == true' "$evidence_root/host-manifest.json" >/dev/null
    docker compose --env-file "$cleanup_env" --project-name "$cleanup_project" --file "$COMPOSE_FILE" up --detach
    [[ "$(docker inspect "$camera_container" --format '{{.Image}}')" == "$CAMERA_AGENT_IMAGE" ]] || { printf 'Trial container image identity changed.\n' >&2; exit 1; }
    [[ "$(docker inspect "$central_deny_container" --format '{{.Image}}')" == "$CENTRAL_DENY_IMAGE_ID" ]] || { printf 'Central deny image identity changed.\n' >&2; exit 1; }
    isolated_network="${cleanup_project}_isolated"
    camera_networks="$(docker inspect "$camera_container" --format '{{json .NetworkSettings.Networks}}')"
    camera_container_ip="$(jq --exit-status --raw-output --arg network "$isolated_network" \
        'if (keys == [$network]) and .[$network].IPAddress != "" then .[$network].IPAddress else error("unexpected network attachment") end' \
        <<< "$camera_networks")"
    [[ "$(docker network inspect "$isolated_network" --format '{{.Internal}}')" == true ]] || {
        printf 'CameraAgent evidence network is not internal.\n' >&2
        exit 1
    }
    published_ports="$(docker inspect "$camera_container" --format '{{json .NetworkSettings.Ports}}')"
    jq --exit-status 'all(.[]; . == null)' <<< "$published_ports" >/dev/null || {
        printf 'CameraAgent must not publish a host port from the internal evidence network.\n' >&2
        exit 1
    }
    camera_base_uri="http://$camera_container_ip:8080"
    jq '.networkIsolation = {mode:"host-to-internal-container-ip", internal:true, networkCount:1,
          publishedHostPorts:false, containerIpRetained:false}' \
        "$evidence_root/host-manifest.json" > "$evidence_root/host-manifest.json.tmp"
    mv "$evidence_root/host-manifest.json.tmp" "$evidence_root/host-manifest.json"
    if ! camera_startup_state="$(docker inspect "$camera_container" --format '{{json .State}}')"; then
        printf 'CameraAgent state could not be inspected after compose startup.\n' >&2
        exit 1
    fi
    jq --exit-status '.Running == true and .Status == "running" and .OOMKilled == false and .Error == ""' \
        <<< "$camera_startup_state" >/dev/null || {
        printf 'CameraAgent exited before startup authentication.\n' >&2
        exit 1
    }
    central_startup_state="$(docker inspect "$central_deny_container" --format '{{json .State}}')"
    jq --argjson state "$central_startup_state" \
        '.centralTraffic = {mechanism:"isolated-socat-deny-recorder", startup:$state}' \
        "$evidence_root/host-manifest.json" > "$evidence_root/host-manifest.json.tmp"
    mv "$evidence_root/host-manifest.json.tmp" "$evidence_root/host-manifest.json"
    jq --exit-status '.centralTraffic.startup.Running == true and .centralTraffic.startup.Status == "running" and
      .centralTraffic.startup.OOMKilled == false and .centralTraffic.startup.Error == ""' \
        "$evidence_root/host-manifest.json" >/dev/null
    device_exposure="$(docker inspect "$camera_container" --format '{{json .HostConfig.Devices}}')"
    jq --exit-status --arg node "$USB_DEVICE_NODE" '
      length == 1 and .[0].PathOnHost == $node and .[0].PathInContainer == $node and .[0].CgroupPermissions == "rwm"
    ' <<< "$device_exposure" >/dev/null || {
        printf 'Only-selected-camera Docker device exposure could not be proven.\n' >&2
        exit 1
    }
    if ! exposed_usb_nodes="$(docker exec "$camera_container" /bin/sh -c 'find /dev/bus/usb -type c -print 2>/dev/null | sort')"; then
        printf 'CameraAgent exited before selected-device exposure could be inspected.\n' >&2
        exit 1
    fi
    [[ "$exposed_usb_nodes" == "$USB_DEVICE_NODE" ]] || {
        printf 'Container USB exposure is not limited to the selected device; refusing physical collection.\n' >&2
        exit 1
    }

    if ! startup_config_source="$(mounted_source "$camera_container" /run/hvo/cameraagent.json)" ||
       ! startup_catalog_source="$(mounted_source "$camera_container" /var/lib/hvo/data/catalog)" ||
       ! startup_collector_source="$(mounted_source "$collector_container" /etc/otelcol/config.yml)" ||
       ! startup_sdk_source="$(mounted_source "$camera_container" "$HVO_ZWO_SDK_LIBRARY")" ||
       ! startup_runtime_mount="$(mounted_entry "$camera_container" /var/lib/hvo/data/agent)"; then
        printf 'Container mounts could not be inspected during startup authentication.\n' >&2
        exit 1
    fi
    startup_runtime_writable=false
    if docker exec "$camera_container" /bin/sh -c 'test -w /var/lib/hvo/data/agent'; then startup_runtime_writable=true; fi
    if ! startup_config_sha256="$(docker exec "$camera_container" sha256sum /run/hvo/cameraagent.json | { read -r hash _; printf '%s' "$hash"; })" ||
       ! startup_catalog_tree_sha256="$(tree_sha256 "$control_root/catalog")" ||
       ! startup_collector_config_sha256="$(sha256sum "$control_root/config/otel-collector.yml" | { read -r hash _; printf '%s' "$hash"; })" ||
       ! startup_sdk_sha256="$(docker exec "$camera_container" sha256sum "$HVO_ZWO_SDK_LIBRARY" | { read -r hash _; printf '%s' "$hash"; })"; then
        printf 'Mounted input hashes could not be captured during startup authentication.\n' >&2
        exit 1
    fi
    jq --arg configSource "$startup_config_source" --arg catalogSource "$startup_catalog_source" \
        --arg collectorSource "$startup_collector_source" --arg sdkSource "$startup_sdk_source" \
        --arg configSha256 "$startup_config_sha256" --arg sdkSha256 "$startup_sdk_sha256" \
        --arg catalogTreeSha256 "$startup_catalog_tree_sha256" --arg collectorConfigSha256 "$startup_collector_config_sha256" \
        --arg expectedConfigSource "$(realpath "$resolved_config")" --arg expectedCatalogSource "$(realpath "$control_root/catalog")" \
        --arg expectedCollectorSource "$(realpath "$control_root/config/otel-collector.yml")" \
        --arg expectedSdkSource "$HVO_ZWO_SDK_LIBRARY" \
        --argjson runtimeMount "$startup_runtime_mount" --argjson runtimeWritable "$startup_runtime_writable" \
        --arg expectedRuntimeSource "$runtime_volume_source" --arg expectedRuntimeName "$runtime_volume" '
      .mountAuthentication.startup = {
        sourcePathsRetained:false,
        configSha256:$configSha256, catalogTreeSha256:$catalogTreeSha256, sdkSha256:$sdkSha256,
        collectorConfigurationSha256:$collectorConfigSha256,
        runtime:{mount:{Type:$runtimeMount.Type, Destination:$runtimeMount.Destination, RW:$runtimeMount.RW,
          sourceRetained:false, nameRetained:false}, writable:$runtimeWritable},
        passed: ($configSource == $expectedConfigSource and $catalogSource == $expectedCatalogSource and
          $collectorSource == $expectedCollectorSource and $sdkSource == $expectedSdkSource and
          $configSha256 == .sourceIdentities.resolvedConfigurationSha256 and $sdkSha256 == .sourceIdentities.sdkLibrarySha256 and
          $catalogTreeSha256 == .sourceIdentities.copiedCatalogTreeSha256 and
          $collectorConfigSha256 == .sourceIdentities.collectorConfigurationSha256 and
          $runtimeMount.Type == "volume" and $runtimeMount.Source == $expectedRuntimeSource and
          $runtimeMount.Name == $expectedRuntimeName and $runtimeMount.Destination == "/var/lib/hvo/data/agent" and
          $runtimeMount.RW == true and $runtimeWritable == true)
      }' "$evidence_root/host-manifest.json" > "$evidence_root/host-manifest.json.tmp"
    mv "$evidence_root/host-manifest.json.tmp" "$evidence_root/host-manifest.json"
    jq --exit-status '.mountAuthentication.startup.passed == true' "$evidence_root/host-manifest.json" >/dev/null

    startup_wait_started="$(date +%s)"
    startup_wait_deadline=$((SECONDS + 120))
    startup_alive=false
    startup_attempts=0
    startup_terminal_result=insufficient-deadline
    if (( $(remaining_trial_seconds) <= 122 )); then
        jq --argjson elapsedSeconds 0 --argjson attempts 0 --argjson ready false \
            --arg terminalResult "$startup_terminal_result" \
            '.startupReadiness = {endpoint:"/alive", anonymous:true, ready:$ready, attempts:$attempts,
              elapsedSeconds:$elapsedSeconds, terminalResult:$terminalResult}' \
            "$evidence_root/host-manifest.json" > "$evidence_root/host-manifest.json.tmp"
        mv "$evidence_root/host-manifest.json.tmp" "$evidence_root/host-manifest.json"
        printf 'Insufficient trial deadline remains for the startup readiness barrier.\n' >&2
        exit 1
    fi
    startup_terminal_result=timeout
    while ((SECONDS < startup_wait_deadline)); do
        startup_attempts=$((startup_attempts + 1))
        if curl --fail --silent --connect-timeout 1 --max-time 2 --output /dev/null \
            "$camera_base_uri/alive"; then
            startup_alive=true
            startup_terminal_result=ready
            break
        fi
        ((SECONDS < startup_wait_deadline)) || break
        if ! camera_running="$(timeout 2s docker inspect "$camera_container" --format '{{.State.Running}}')"; then
            startup_terminal_result='container-inspection-failed'
            break
        fi
        if [[ "$camera_running" != true ]]; then
            startup_terminal_result='container-exited'
            break
        fi
        ((SECONDS < startup_wait_deadline)) && sleep 1
    done
    startup_wait_elapsed=$(($(date +%s) - startup_wait_started))
    jq --argjson elapsedSeconds "$startup_wait_elapsed" --argjson attempts "$startup_attempts" \
        --argjson ready "$startup_alive" --arg terminalResult "$startup_terminal_result" \
        '.startupReadiness = {endpoint:"/alive", anonymous:true, ready:$ready, attempts:$attempts,
          elapsedSeconds:$elapsedSeconds, terminalResult:$terminalResult}' \
        "$evidence_root/host-manifest.json" > "$evidence_root/host-manifest.json.tmp"
    mv "$evidence_root/host-manifest.json.tmp" "$evidence_root/host-manifest.json"
    [[ "$startup_alive" == true ]] || {
        printf 'CameraAgent startup readiness failed: %s.\n' "$startup_terminal_result" >&2
        exit 1
    }

    resource_samples="$evidence_root/resource-samples.jsonl"
    : > "$resource_samples"
    sample_resources "$camera_container" "$central_deny_container" "$resource_samples" 7>&- 8>&- &
    sampler_pid=$!

    acquisition_timeout_seconds="$(remaining_trial_seconds)"
    ((acquisition_timeout_seconds <= 3900)) || acquisition_timeout_seconds=3900
    failure_stage=acquisition
    HVO_ISSUE_268_PHYSICAL_EVIDENCE=1 HVO_ISSUE_268_PROFILE="$PROFILE" HVO_ISSUE_268_TRIAL="$trial" \
    HVO_ISSUE_268_EVIDENCE_ROOT="$evidence_root" HVO_ISSUE_268_CAMERA_CONTAINER="$camera_container" \
    HVO_ISSUE_268_BASE_URI="$camera_base_uri" HVO_ISSUE_268_OWNER_PASSWORD_FILE="$control_root/secrets/owner-password" \
    HVO_ISSUE_268_RESOLVED_CONFIG="$resolved_config" HVO_ISSUE_268_REVISION="$REVISION" \
    HVO_ISSUE_268_BLOCK_DEVICE="$BLOCK_DEVICE" \
    HVO_ISSUE_268_DEADLINE_UNIX_SECONDS="$trial_deadline_unix_seconds" \
        timeout --signal=TERM --kill-after=30s "${acquisition_timeout_seconds}s" dotnet test "$ACCEPTANCE_PROJECT" --no-build --configuration Release \
        --filter 'FullyQualifiedName~SustainedPhysicalEvidenceTests.AcquireSustainedPhysicalTrialAndStopAsync' \
        --results-directory "$evidence_root" --logger 'trx;LogFileName=acquisition.trx' --logger 'console;verbosity=normal'
    failure_stage=postacquisition

    wait "$sampler_pid" 2>/dev/null || true
    sampler_pid=''
    dmesg_live_at_total_end=false
    if kill -0 "$kernel_pid" 2>/dev/null; then dmesg_live_at_total_end=true; fi
    [[ "$dmesg_live_at_total_end" == true ]] || { printf 'dmesg follow exited during the trial.\n' >&2; exit 1; }
    jq --argjson live true --arg completedUtc "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
        '. + {liveAtTotalEnd:$live, completedUtc:$completedUtc, passed:$live}' "$evidence_root/dmesg-status.json" \
        > "$evidence_root/dmesg-status.json.tmp"
    mv "$evidence_root/dmesg-status.json.tmp" "$evidence_root/dmesg-status.json"
    kill "$kernel_pid" >/dev/null 2>&1 || true
    wait "$kernel_pid" 2>/dev/null || true
    kernel_pid=''
    central_pre_stop_state="$(docker inspect "$central_deny_container" --format '{{json .State}}')"
    jq --argjson state "$central_pre_stop_state" '.centralTraffic.preStop = $state' \
        "$evidence_root/host-manifest.json" > "$evidence_root/host-manifest.json.tmp"
    mv "$evidence_root/host-manifest.json.tmp" "$evidence_root/host-manifest.json"
    jq --exit-status '.centralTraffic.preStop.Running == true and .centralTraffic.preStop.Status == "running" and
      .centralTraffic.preStop.OOMKilled == false and .centralTraffic.preStop.Error == ""' \
        "$evidence_root/host-manifest.json" >/dev/null
    docker stop --timeout 15 "$collector_container" "$central_deny_container" >/dev/null
    for stopped_container in "$camera_container" "$collector_container" "$central_deny_container"; do
        [[ "$(docker inspect "$stopped_container" --format '{{.State.Running}}')" == false ]] || {
            printf 'Container did not stop before retained mount inspection: %s\n' "$stopped_container" >&2
            exit 1
        }
    done
    central_shutdown_state="$(docker inspect "$central_deny_container" --format '{{json .State}}')"
    jq --argjson state "$central_shutdown_state" '.centralTraffic.shutdown = $state' \
        "$evidence_root/host-manifest.json" > "$evidence_root/host-manifest.json.tmp"
    mv "$evidence_root/host-manifest.json.tmp" "$evidence_root/host-manifest.json"

    shutdown_config_source="$(mounted_source "$camera_container" /run/hvo/cameraagent.json)"
    shutdown_catalog_source="$(mounted_source "$camera_container" /var/lib/hvo/data/catalog)"
    shutdown_collector_source="$(mounted_source "$collector_container" /etc/otelcol/config.yml)"
    shutdown_sdk_source="$(mounted_source "$camera_container" "$HVO_ZWO_SDK_LIBRARY")"
    shutdown_runtime_mount="$(mounted_entry "$camera_container" /var/lib/hvo/data/agent)"
    shutdown_runtime_writable=false
    if [[ "$runtime_kind" == docker-named-volume ]]; then
        runtime_probe_container="hvo268-$suffix-runtime-writable"
        if docker run --rm --name "$runtime_probe_container" --user "$(id -u):$(id -g)" \
            --volume "$runtime_volume:/runtime" --entrypoint /bin/sh "$CAMERA_AGENT_IMAGE" -c 'test -w /runtime'; then
            shutdown_runtime_writable=true
        fi
        runtime_probe_container=''
    elif [[ -w "$runtime_storage_path" ]]; then
        shutdown_runtime_writable=true
    fi
    shutdown_config_sha256="$(sha256sum "$resolved_config" | { read -r hash _; printf '%s' "$hash"; })"
    shutdown_catalog_tree_sha256="$(tree_sha256 "$control_root/catalog")"
    shutdown_collector_config_sha256="$(sha256sum "$control_root/config/otel-collector.yml" | { read -r hash _; printf '%s' "$hash"; })"
    sdk_probe_container="hvo268-$suffix-sdk-post-collection"
    shutdown_sdk_sha256="$(docker run --rm --name "$sdk_probe_container" --volume "$HVO_ZWO_SDK_LIBRARY:$HVO_ZWO_SDK_LIBRARY:ro" \
        --entrypoint sha256sum "$CAMERA_AGENT_IMAGE" "$HVO_ZWO_SDK_LIBRARY" | { read -r hash _; printf '%s' "$hash"; })"
    sdk_probe_container=''
    jq --arg configSource "$shutdown_config_source" --arg catalogSource "$shutdown_catalog_source" \
        --arg collectorSource "$shutdown_collector_source" --arg sdkSource "$shutdown_sdk_source" \
        --arg configSha256 "$shutdown_config_sha256" --arg sdkSha256 "$shutdown_sdk_sha256" \
        --arg catalogTreeSha256 "$shutdown_catalog_tree_sha256" --arg collectorConfigSha256 "$shutdown_collector_config_sha256" \
        --arg expectedConfigSource "$(realpath "$resolved_config")" --arg expectedCatalogSource "$(realpath "$control_root/catalog")" \
        --arg expectedCollectorSource "$(realpath "$control_root/config/otel-collector.yml")" \
        --arg expectedSdkSource "$HVO_ZWO_SDK_LIBRARY" \
        --argjson runtimeMount "$shutdown_runtime_mount" --argjson runtimeWritable "$shutdown_runtime_writable" \
        --arg expectedRuntimeSource "$runtime_volume_source" --arg expectedRuntimeName "$runtime_volume" '
      .mountAuthentication.shutdown = {
        sourcePathsRetained:false,
        configSha256:$configSha256, catalogTreeSha256:$catalogTreeSha256, sdkSha256:$sdkSha256,
        collectorConfigurationSha256:$collectorConfigSha256,
        runtime:{mount:{Type:$runtimeMount.Type, Destination:$runtimeMount.Destination, RW:$runtimeMount.RW,
          sourceRetained:false, nameRetained:false}, writable:$runtimeWritable},
        passed: ($configSource == $expectedConfigSource and $catalogSource == $expectedCatalogSource and
          $collectorSource == $expectedCollectorSource and $sdkSource == $expectedSdkSource and
          $configSha256 == .sourceIdentities.resolvedConfigurationSha256 and $sdkSha256 == .sourceIdentities.sdkLibrarySha256 and
          $catalogTreeSha256 == .sourceIdentities.copiedCatalogTreeSha256 and
          $collectorConfigSha256 == .sourceIdentities.collectorConfigurationSha256 and
          $runtimeMount.Type == "volume" and $runtimeMount.Source == $expectedRuntimeSource and
          $runtimeMount.Name == $expectedRuntimeName and $runtimeMount.Destination == "/var/lib/hvo/data/agent" and
          $runtimeMount.RW == true and $runtimeWritable == true)
      }' "$evidence_root/host-manifest.json" > "$evidence_root/host-manifest.json.tmp"
    mv "$evidence_root/host-manifest.json.tmp" "$evidence_root/host-manifest.json"
    jq --exit-status '.mountAuthentication.shutdown.passed == true' "$evidence_root/host-manifest.json" >/dev/null

    docker logs --timestamps "$central_deny_container" > "$evidence_root/central-deny.log" 2>&1
    deny_status=0
    central_attempt_count="$(rg --count-matches --fixed-strings 'HVO268_CENTRAL_DENY_HIT' "$evidence_root/central-deny.log")" || deny_status=$?
    if ((deny_status > 1)); then
        printf 'Unable to inspect retained central-deny evidence.\n' >&2
        exit 1
    fi
    central_attempt_count="${central_attempt_count:-0}"
    jq --argjson attempts "$central_attempt_count" --arg image "$CENTRAL_DENY_IMAGE" --arg imageId "$CENTRAL_DENY_IMAGE_ID" \
        '.centralTraffic += {attemptCount:$attempts, image:$image, imageId:$imageId} |
         .centralTraffic.passed = ($attempts == 0 and .centralTraffic.startup.Running == true and
           .centralTraffic.preStop.Running == true and .centralTraffic.shutdown.Running == false and
           .centralTraffic.shutdown.Status == "exited" and .centralTraffic.shutdown.OOMKilled == false and
           .centralTraffic.shutdown.Error == "" and (.centralTraffic.shutdown.ExitCode | IN(0, 143)))' \
        "$evidence_root/host-manifest.json" > "$evidence_root/host-manifest.json.tmp"
    mv "$evidence_root/host-manifest.json.tmp" "$evidence_root/host-manifest.json"
    jq --exit-status '.centralTraffic.passed == true' "$evidence_root/host-manifest.json" >/dev/null

    exported_runtime="$evidence_root/runtime"
    mkdir -p "$exported_runtime/frames" "$exported_runtime/journal"
    export_started_nanoseconds="$(date +%s%N)"
    runtime_block_before="$(<"/sys/class/block/$BLOCK_DEVICE/stat")"
    evidence_block_before="$(<"/sys/class/block/$EVIDENCE_BLOCK_DEVICE/stat")"
    timeout --signal=TERM --kill-after=30s "$(remaining_trial_seconds)s" docker cp \
        "$camera_container:/var/lib/hvo/data/agent/frames/." "$exported_runtime/frames/"
    timeout --signal=TERM --kill-after=30s "$(remaining_trial_seconds)s" docker cp \
        "$camera_container:/var/lib/hvo/data/agent/journal/raw-ingress.db" "$exported_runtime/journal/raw-ingress.db"
    for sqlite_suffix in -wal -shm; do
        timeout --signal=TERM --kill-after=10s "$(remaining_trial_seconds)s" docker cp \
            "$camera_container:/var/lib/hvo/data/agent/journal/raw-ingress.db$sqlite_suffix" \
            "$exported_runtime/journal/raw-ingress.db$sqlite_suffix" >/dev/null 2>&1 || true
    done
    export_completed_nanoseconds="$(date +%s%N)"
    runtime_block_after="$(<"/sys/class/block/$BLOCK_DEVICE/stat")"
    evidence_block_after="$(<"/sys/class/block/$EVIDENCE_BLOCK_DEVICE/stat")"
    exported_bytes="$(du -sb "$exported_runtime" | cut -f1)"
    jq -n --arg profile "$PROFILE" \
        --arg runtimeBefore "$runtime_block_before" --arg runtimeAfter "$runtime_block_after" \
        --arg evidenceBefore "$evidence_block_before" --arg evidenceAfter "$evidence_block_after" \
        --argjson startedNanoseconds "$export_started_nanoseconds" --argjson completedNanoseconds "$export_completed_nanoseconds" \
        --argjson exportedBytes "$exported_bytes" '
      {schemaVersion:"issue-268-export-io-v1", profile:$profile, startedUnixNanoseconds:$startedNanoseconds,
       completedUnixNanoseconds:$completedNanoseconds, durationNanoseconds:($completedNanoseconds-$startedNanoseconds),
       exportedBytes:$exportedBytes, runtime:{device:"runtime", blockStatBefore:$runtimeBefore, blockStatAfter:$runtimeAfter},
       evidence:{device:"evidence", blockStatBefore:$evidenceBefore, blockStatAfter:$evidenceAfter},
       excludedFromTrialMeasurements:true,
       armExportReportedSeparately:($profile=="asi676mc")}' > "$evidence_root/export-io.json"
    while IFS= read -r -d '' exported_path; do
        exported_relative="${exported_path#"$exported_runtime/"}"
        case "$exported_relative" in
            frames/*|journal/raw-ingress.db|journal/raw-ingress.db-wal|journal/raw-ingress.db-shm) ;;
            *) printf 'Runtime export escaped the frames/raw-journal allowlist: %s\n' "$exported_relative" >&2; exit 1 ;;
        esac
    done < <(find "$exported_runtime" -type f -print0)
    HVO_ISSUE_268_PHYSICAL_EVIDENCE=1 HVO_ISSUE_268_PROFILE="$PROFILE" HVO_ISSUE_268_TRIAL="$trial" \
    HVO_ISSUE_268_EVIDENCE_ROOT="$evidence_root" HVO_ISSUE_268_EXPORTED_RUNTIME_ROOT="$exported_runtime" \
        timeout --signal=TERM --kill-after=30s "$(remaining_trial_seconds)s" dotnet test "$ACCEPTANCE_PROJECT" --no-build --configuration Release \
        --filter 'FullyQualifiedName~SustainedPhysicalEvidenceTests.InspectRetainedPhysicalTrialAsync' \
        --results-directory "$evidence_root" --logger 'trx;LogFileName=inspection.trx' --logger 'console;verbosity=normal'

    docker logs --timestamps "$camera_container" > "$evidence_root/cameraagent.sanitized.log" 2>&1
    sanitize_text_file "$evidence_root/cameraagent.sanitized.log"
    selected_usb_kernel_token="${HVO_ISSUE_268_USB_SYSFS_PATH##*/}"
    while IFS= read -r line; do
        if [[ "${line,,}" == *"usb ${selected_usb_kernel_token,,}:"* ||
              "${line,,}" =~ oom|out[[:space:]]+of[[:space:]]+memory|killed[[:space:]]+process ]]; then
            printf '%s\n' "$line"
        fi
    done < "$control_root/kernel-live.raw" > "$control_root/kernel-selected.raw"
    reset_disposition="$(jq -R -s --arg profile "$PROFILE" --arg token "$selected_usb_kernel_token" \
        --slurpfile capture "$evidence_root/capture-evidence.json" -f "$USB_RESET_CLASSIFIER" \
        "$control_root/kernel-selected.raw")"
    while IFS= read -r line; do
        printf '%s\n' "${line//"$selected_usb_kernel_token"/<selected-usb>}"
    done < "$control_root/kernel-selected.raw" > "$evidence_root/kernel-selected.sanitized.log"
    sanitize_text_file "$evidence_root/kernel-selected.sanitized.log"
    jq --argjson resetDisposition "$reset_disposition" \
        '. + {followMode:"follow-new", selectedUsbTokenRetained:false,
          retainedLineCount:$resetDisposition.retainedLineCount,
          oomEvidenceLineCount:$resetDisposition.oomEvidenceLineCount, privacySanitized:true,
          resetDisposition:$resetDisposition}' "$evidence_root/dmesg-status.json" \
        > "$evidence_root/dmesg-status.json.tmp"
    mv "$evidence_root/dmesg-status.json.tmp" "$evidence_root/dmesg-status.json"
    jq --exit-status '.resetDisposition.passed == true' "$evidence_root/dmesg-status.json" >/dev/null || {
        printf 'USB reset evidence did not match the approved profile disposition.\n' >&2
        exit 1
    }
    docker logs --timestamps "$collector_container" > "$evidence_root/collector.log" 2>&1
    sanitize_text_file "$evidence_root/collector.log"
    sanitize_text_file "$evidence_root/central-deny.log"
    sanitize_text_file "$evidence_root/acquisition.trx"
    sanitize_text_file "$evidence_root/inspection.trx"

    remove_trial_containers
    cleanup_project=''
    cleanup_env=''
    camera_container=''
    collector_container=''
    central_deny_container=''
    runtime_init_container=''
    remove_active_control

    for telemetry_file in "$evidence_root/telemetry/logs.json" "$evidence_root/telemetry/metrics.json" "$evidence_root/telemetry/traces.json"; do
        [[ -s "$telemetry_file" ]] || { printf 'Missing OTLP signal file: %s\n' "$telemetry_file" >&2; exit 1; }
        if rg --text --ignore-case --fixed-strings "$HVO_ZWO_CAMERA_SERIAL" "$telemetry_file" >/dev/null; then
            printf 'Private camera serial leaked into OTLP evidence.\n' >&2
            exit 1
        fi
    done
    if rg --text --ignore-case --fixed-strings "$HVO_ZWO_CAMERA_SERIAL" "$evidence_root" >/dev/null; then
        printf 'Retained binary or text evidence contains a camera serial variant.\n' >&2
        exit 1
    fi
    if rg --text --fixed-strings "$owner_password" "$evidence_root" >/dev/null; then
        printf 'Retained binary or text evidence contains the generated credential.\n' >&2
        exit 1
    fi
    if rg --text --ignore-case '(authorization:[[:space:]]*(basic|bearer)|set-cookie:|requestverificationtoken|connection[_-]?string|owner[_-]?password)' "$evidence_root" >/dev/null; then
        printf 'Retained evidence contains a forbidden credential pattern.\n' >&2
        exit 1
    fi
    if rg --text --ignore-case \
        'usb.*(disconnect|error|timeout)|(disconnect|error|timeout).*usb|oom|out of memory|killed process' \
        "$evidence_root/kernel-selected.sanitized.log" "$evidence_root/cameraagent.sanitized.log" >/dev/null; then
        printf 'USB, SDK, timeout, or OOM fault was observed.\n' >&2
        exit 1
    fi
    if rg --text --ignore-case 'usb.*reset' "$evidence_root/cameraagent.sanitized.log" >/dev/null; then
        printf 'An unclassified CameraAgent USB reset was observed.\n' >&2
        exit 1
    fi
    if rg --text --ignore-case 'exporter.*(error|failed)|connection refused|retrying' "$evidence_root/collector.log" >/dev/null; then
        printf 'The OTLP collector reported an exporter failure.\n' >&2
        exit 1
    fi
    if [[ "$PROFILE" == asi676mc && "$(vcgencmd get_throttled | cut -d= -f2)" != 0x0 ]]; then
        printf 'ARM throttle state changed.\n' >&2
        exit 1
    fi
    jq --exit-status '
      def lacks($keys): . as $object | all($keys[]; . as $key | ($object | has($key) | not));
      (.host | has("name") | not) and (.usb | has("sysfsPath") | not) and
      (.storage.runtime | lacks(["device", "mount", "mountOptions", "volumeInspect"])) and
      (.storage.evidence | lacks(["device", "mount", "mountOptions"])) and
      (.storage.docker | lacks(["device", "mount", "mountOptions"])) and
      all([.mountAuthentication.startup, .mountAuthentication.shutdown][];
        .sourcePathsRetained == false and
        lacks(["configSource", "catalogSource", "collectorSource", "sdkSource"]) and
        (.runtime.mount | lacks(["Source", "Name"])))
    ' "$evidence_root/host-manifest.json" >/dev/null || {
        printf 'Retained host evidence contains private host or filesystem topology.\n' >&2
        exit 1
    }
    if rg --text --fixed-strings "$selected_usb_kernel_token" \
        "$evidence_root/host-manifest.json" "$evidence_root/dmesg-status.json" \
        "$evidence_root/kernel-selected.sanitized.log" >/dev/null; then
        printf 'Retained evidence contains the selected USB bus/port token.\n' >&2
        exit 1
    fi
    privacy_scan_files=(
        "$evidence_root/cameraagent.sanitized.log"
        "$evidence_root/kernel-selected.sanitized.log"
        "$evidence_root/collector.log"
        "$evidence_root/central-deny.log"
        "$evidence_root/acquisition.trx"
        "$evidence_root/inspection.trx"
    )
    if rg --text --ignore-case \
        'authorization:|bearer[[:space:]]|set-cookie:|requestverificationtoken|token[=:]|actor[=:]|idempotency|checksum|storage[_-]?(reference|path|id)|[0-9a-f]{8}-[0-9a-f-]{27,}|(^|[^0-9a-f])[0-9a-f]{64}([^0-9a-f]|$)|/(home|workspaces|tmp|var/lib/hvo)/[^[:space:]]+' \
        "${privacy_scan_files[@]}" >/dev/null; then
        printf 'A retained non-raw log contains a private path, identifier, checksum, actor, or credential.\n' >&2
        exit 1
    fi
    if [[ -n "$camera_container_ip" ]] && rg --text --fixed-strings "$camera_container_ip" \
        "${privacy_scan_files[@]}" >/dev/null; then
        printf 'A retained non-raw log contains the private runtime container IP.\n' >&2
        exit 1
    fi
    jq --argjson scannedFileCount "${#privacy_scan_files[@]}" \
        '.privacy = {policy:"all-retained-non-raw-logs", scannedFileCount:$scannedFileCount,
          rawFramesAndAuthenticatedProvenanceExcluded:true, passed:true}' \
        "$evidence_root/host-manifest.json" > "$evidence_root/host-manifest.json.tmp"
    mv "$evidence_root/host-manifest.json.tmp" "$evidence_root/host-manifest.json"

    assert_before_trial_deadline
    trial_elapsed=$(($(date +%s) - trial_started_seconds))
    ((trial_elapsed <= 4800)) || { printf '%s exceeded the 80-minute whole-trial deadline.\n' "$trial" >&2; exit 1; }
    jq -n --arg schemaVersion issue-268-trial-execution-v1 --arg revision "$REVISION" \
        --arg profile "$PROFILE" --arg trial "$trial" --argjson wholeTrialElapsedSeconds "$trial_elapsed" \
        '{schemaVersion:$schemaVersion, revision:$revision, profile:$profile, trial:$trial,
          wholeTrialElapsedSeconds:$wholeTrialElapsedSeconds}' > "$evidence_root/trial-execution.json"
    write_authenticated_trial_manifest "$trial_root" "$evidence_root/trial-input-manifest.json" \
        issue-268-trial-input-manifest-v1 false
    verify_authenticated_manifest "$evidence_root/trial-input-manifest.json" "$trial_root" || {
        printf '%s trial input manifest authentication failed.\n' "$trial" >&2
        exit 1
    }
    aggregate_retained_trial "$evidence_root" "$evidence_root/trial-summary.json"
    jq --exit-status '.passed == true' "$evidence_root/trial-summary.json" >/dev/null
    write_authenticated_trial_manifest "$trial_root" "$evidence_root/trial-manifest.json" \
        issue-268-post-summary-trial-manifest-v1 true
    verify_authenticated_manifest "$evidence_root/trial-manifest.json" "$trial_root" || {
        printf '%s post-summary trial manifest authentication failed.\n' "$trial" >&2
        exit 1
    }
    write_inventory "$trial_root" "$evidence_root/evidence-manifest.json"
    assert_before_trial_deadline

    remove_owned_runtime
    runtime_volume=''
    runtime_path=''
    runtime_kind=''
    unset owner_password
    assert_before_trial_deadline
    kill "$deadline_pid" >/dev/null 2>&1 || true
    wait "$deadline_pid" 2>/dev/null || true
    deadline_pid=''
    assert_source_unchanged
done

for trial_manifest in "$CAMPAIGN_ROOT"/trial-*/evidence/trial-manifest.json; do
    trial_manifest_root="${trial_manifest%/evidence/trial-manifest.json}"
    trial_evidence_root="$trial_manifest_root/evidence"
    verify_authenticated_manifest "$trial_evidence_root/trial-input-manifest.json" "$trial_manifest_root" || {
        printf 'Campaign trial input manifest authentication failed: %s\n' "$trial_manifest" >&2
        exit 1
    }
    verify_authenticated_manifest "$trial_manifest" "$trial_manifest_root" || {
        printf 'Campaign post-summary trial manifest authentication failed: %s\n' "$trial_manifest" >&2
        exit 1
    }
    rerun_summary="$(mktemp "$STATE_ROOT/issue-268-rerun-summary.XXXXXX")"
    aggregate_retained_trial "$trial_evidence_root" "$rerun_summary"
    retained_summary_sha="$(sha256sum "$trial_evidence_root/trial-summary.json" | { read -r hash _; printf '%s' "${hash^^}"; })"
    rerun_summary_sha="$(sha256sum "$rerun_summary" | { read -r hash _; printf '%s' "${hash^^}"; })"
    [[ "$retained_summary_sha" == "$rerun_summary_sha" ]] || {
        printf 'Retained trial summary is not exactly reproducible: %s\n' "$trial_evidence_root/trial-summary.json" >&2
        exit 1
    }
    rm -f -- "$rerun_summary"
    rerun_summary=''
done
jq -n --arg mode campaign \
    --argjson acquisition '[]' --argjson host '[]' --argjson resources '[]' --argjson metrics '[]' \
    --argjson traces '[]' --argjson logs '[]' --argjson dmesg '[]' --argjson exportIo '[]' --argjson execution '[]' \
    --argjson trialManifests '[]' \
    --slurpfile trials <(jq -s '.' "$CAMPAIGN_ROOT"/trial-*/evidence/trial-summary.json) \
    --slurpfile campaignManifests <(jq -s '.' "$CAMPAIGN_ROOT"/trial-*/evidence/trial-manifest.json) \
    -f "$AGGREGATOR" > "$CAMPAIGN_ROOT/five-trial-summary.json"
jq --exit-status '.citable == true and .allPassed == true' "$CAMPAIGN_ROOT/five-trial-summary.json" >/dev/null
if rg --text --ignore-case --fixed-strings "$HVO_ZWO_CAMERA_SERIAL" "$CAMPAIGN_ROOT" >/dev/null; then
    printf 'Campaign binary or text evidence contains a camera serial variant.\n' >&2
    exit 1
fi
if rg --text --ignore-case '(authorization:[[:space:]]*(basic|bearer)|set-cookie:|requestverificationtoken|connection[_-]?string|owner[_-]?password)' "$CAMPAIGN_ROOT" >/dev/null; then
    printf 'Campaign evidence contains a forbidden credential pattern.\n' >&2
    exit 1
fi
write_inventory "$CAMPAIGN_ROOT" "$CAMPAIGN_ROOT/evidence-manifest.json"
assert_source_unchanged
trap - EXIT INT TERM
printf 'Issue #268 %s physical evidence: %s\n' "$PROFILE" "$CAMPAIGN_ROOT"
