#!/usr/bin/env bash
# Run one of the two frozen issue #268 sustained physical acquisition strata.

set -euo pipefail
umask 077
export LC_ALL=C

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly REPO_ROOT
readonly COMPOSE_FILE="$REPO_ROOT/deploy/acceptance/issue-268/compose.yml"
readonly COLLECTOR_CONFIG="$REPO_ROOT/deploy/acceptance/issue-268/otel-collector.yml"
readonly AGGREGATOR="$REPO_ROOT/scripts/issue-268-physical-aggregate.jq"
readonly USB_RESET_CLASSIFIER="$REPO_ROOT/scripts/issue-268-usb-reset-classify.jq"
readonly MANIFEST_VERIFIER="$REPO_ROOT/scripts/issue-268-verify-manifest"
readonly ACCEPTANCE_PROJECT="$REPO_ROOT/tests/HVO.SkyMonitor.CameraAgent.AcceptanceTests/HVO.SkyMonitor.CameraAgent.AcceptanceTests.csproj"
readonly HARDWARE_PROJECT="$REPO_ROOT/tests/HVO.SkyMonitor.CameraAgent.Tests/HVO.SkyMonitor.CameraAgent.Tests.csproj"
readonly COLLECTOR_DIGEST='sha256:f2f01157055a9b2aab9df7118e1f1c9abf345e99b23bc7a2bc791db374a7d0f6'
readonly CENTRAL_DENY_IMAGE='alpine/socat@sha256:4e625a62c9ea40ccbce93b9a4fcc6b41740a9f308389c216f34c88ce3abb275b'
readonly EXPECTED_HEADER_SHA256='af6ab82e66905b3a0f3313e1e82ccb4fedde272eaa64744588a1be8103f9cf0c'
readonly EXPECTED_UDEV_SHA256='a64c24317f154d5b074e9fac9249f4a5d905153b22f1e74aac4c5f8fe1443f36'
readonly EXPECTED_CATALOG_SHA256='b51d18b722199e89aa8fe4622ebe507346c75effb375e546881452a263f0b9e2'
readonly HEADER_PATH='/usr/local/include/ASICamera2.h'
readonly UDEV_PATH='/etc/udev/rules.d/99-asi.rules'
readonly TRIAL_COUNT=5

usage() {
    printf 'Usage: HVO_AGENT_STATE_ROOT=... HVO_CATALOG_PERF_ROOT=... HVO_OTEL_COLLECTOR_IMAGE=IMAGE@sha256:DIGEST HVO_ZWO_SDK_LIBRARY=... HVO_ZWO_CAMERA_SERIAL=PRIVATE HVO_ISSUE_268_USB_SYSFS_PATH=/sys/bus/usb/devices/BUS-PORT %s --profile asi178mc --expected-host home-dev-01\n' "${0##*/}" >&2
    printf '   or: ... %s --profile asi676mc --expected-host allsky01\n' "${0##*/}" >&2
}

if [[ $# -ne 4 || "$1" != '--profile' || "$3" != '--expected-host' ]]; then
    usage
    exit 2
fi
readonly PROFILE="$2"
readonly EXPECTED_HOST="$4"

case "$PROFILE:$EXPECTED_HOST" in
    asi178mc:home-dev-01)
        readonly CAMERA_MODEL='ASI178MC'
        readonly PROFILE_FILE="$REPO_ROOT/src/HVO.SkyMonitor.CameraAgent/cameraagent.zwo-asi178mc.sample.json"
        readonly EXPECTED_PROFILE_SHA256='f1213ee610d50a3634fec194908e18f9e12114e46ea687e5145c911aa6cf9ec7'
        readonly EXPECTED_SDK_SHA256='d1de4a5ab85c8cafbddfad9c593bbba515890d3adf20c1ca44dafcf15f2775ce'
        readonly EXPECTED_ARCH='x86_64'
        readonly EXPECTED_KERNEL='6.8.0-136-generic'
        readonly EXPECTED_LOGICAL_CPUS=8
        readonly EXPECTED_MEMORY_BYTES=25199149056
        readonly EXPECTED_IMAGE_ARCH='amd64'
        readonly EXPECTED_USB_PRODUCT='178a'
        readonly EXPECTED_RUNTIME_DEVICE='/dev/sda1'
        readonly EXPECTED_RUNTIME_FS='ext4'
        readonly EXPECTED_RUNTIME_MOUNT='/'
        readonly MINIMUM_FREE_BYTES=$((32 * 1024 * 1024 * 1024))
        ;;
    asi676mc:allsky01)
        readonly CAMERA_MODEL='ASI676MC'
        readonly PROFILE_FILE="$REPO_ROOT/src/HVO.SkyMonitor.CameraAgent/cameraagent.zwo-asi676mc.sample.json"
        readonly EXPECTED_PROFILE_SHA256='0d6c8118081204163e4895b75d0ae17b9366af9db51139981ccf8339a37063b5'
        readonly EXPECTED_SDK_SHA256='3ecf511979ed571131e7d7f4a467112aba21940b4dc91d63bd109b9683bf67c4'
        readonly EXPECTED_ARCH='aarch64'
        readonly EXPECTED_KERNEL='6.18.34+rpt-rpi-2712'
        readonly EXPECTED_LOGICAL_CPUS=4
        readonly EXPECTED_MEMORY_BYTES=17006182400
        readonly EXPECTED_IMAGE_ARCH='arm64'
        readonly EXPECTED_USB_PRODUCT='676d'
        readonly EXPECTED_RUNTIME_DEVICE='/dev/nvme0n1p1'
        readonly EXPECTED_RUNTIME_FS='xfs'
        readonly EXPECTED_RUNTIME_MOUNT='/var/lib/docker'
        readonly MINIMUM_FREE_BYTES=$((40 * 1024 * 1024 * 1024))
        ;;
    *)
        usage
        exit 2
        ;;
esac
readonly EXPECTED_CATALOG_PACKAGE_VERSION='hyg-v4.2-p3-s2-r1'

for variable in HVO_AGENT_STATE_ROOT HVO_CATALOG_PERF_ROOT HVO_OTEL_COLLECTOR_IMAGE \
    HVO_ZWO_SDK_LIBRARY HVO_ZWO_CAMERA_SERIAL HVO_ISSUE_268_USB_SYSFS_PATH; do
    [[ -n "${!variable:-}" ]] || { printf '%s is required.\n' "$variable" >&2; exit 2; }
done
[[ "$HVO_AGENT_STATE_ROOT" == /* && "$HVO_CATALOG_PERF_ROOT" == /* &&
   "$HVO_ZWO_SDK_LIBRARY" == /* && "$HVO_ISSUE_268_USB_SYSFS_PATH" == /sys/bus/usb/devices/* ]] || {
    printf 'Agent state, catalog, SDK, and USB sysfs inputs must be absolute declared paths.\n' >&2
    exit 2
}
[[ "$HVO_ZWO_CAMERA_SERIAL" =~ ^[0-9A-Fa-f]{16}$ ]] || { printf 'The private camera serial must be exactly 16 hexadecimal characters.\n' >&2; exit 2; }
[[ "$HVO_OTEL_COLLECTOR_IMAGE" == *@"$COLLECTOR_DIGEST" ]] || { printf 'The collector must use reviewed digest %s.\n' "$COLLECTOR_DIGEST" >&2; exit 2; }

for command in awk cat chmod cp curl cut date df dmesg docker dotnet du find findmnt flock fuser getconf git hostname id jq lsblk mkdir mv nproc openssl ps readlink realpath rg rm sha256sum shellcheck sleep sort stat strings tail timedatectl timeout tr uname wc; do
    command -v "$command" >/dev/null 2>&1 || { printf 'Required command is unavailable: %s\n' "$command" >&2; exit 2; }
done
if [[ "$PROFILE" == asi676mc ]]; then
    command -v vcgencmd >/dev/null 2>&1 || { printf 'vcgencmd is required for ARM throttle evidence.\n' >&2; exit 2; }
    command -v sudo >/dev/null 2>&1 || { printf 'sudo is required for ARM Docker-volume metadata evidence.\n' >&2; exit 2; }
    if ! sudo -n findmnt -n -o SOURCE,TARGET,FSTYPE,OPTIONS --target "$EXPECTED_RUNTIME_MOUNT" >/dev/null ||
       ! sudo -n stat -f --format='%a %S' "$EXPECTED_RUNTIME_MOUNT" >/dev/null; then
        printf 'Non-interactive ARM Docker-volume metadata access is unavailable.\n' >&2
        exit 2
    fi
fi

STATE_ROOT="$(realpath -m "$HVO_AGENT_STATE_ROOT")"
readonly STATE_ROOT
[[ "$STATE_ROOT" == /home/roys/hvo-agent-state ]] || {
    printf 'Physical evidence state must remain at /home/roys/hvo-agent-state.\n' >&2
    exit 2
}
mkdir -p "$STATE_ROOT"
readonly PERFORMANCE_LOCK="$STATE_ROOT/.performance.lock"
[[ ! -L "$PERFORMANCE_LOCK" ]] || { printf 'The shared performance lock must not be a symbolic link.\n' >&2; exit 2; }
exec 8>> "$PERFORMANCE_LOCK"
if [[ "$(realpath -e -- "$PERFORMANCE_LOCK")" != "$PERFORMANCE_LOCK" ||
    "$(realpath -e -- "/proc/$$/fd/8")" != "$PERFORMANCE_LOCK" ||
    "$(stat -c %F -- "$PERFORMANCE_LOCK")" != regular*file ]]; then
    printf 'The shared performance lock is not a trusted regular file.\n' >&2
    exit 2
fi
flock -n 8 || { printf 'Another performance campaign owns %s/.performance.lock.\n' "$STATE_ROOT" >&2; exit 2; }

compute_dirty_sha256() {
    {
        git -C "$REPO_ROOT" diff --binary HEAD
        while IFS= read -r -d '' path; do
            printf 'untracked\0%s\0' "$path"
            git -C "$REPO_ROOT" hash-object -- "$path"
        done < <(git -C "$REPO_ROOT" ls-files --others --exclude-standard -z)
    } | sha256sum | { read -r hash _; printf '%s' "$hash"; }
}

REVISION="$(git -C "$REPO_ROOT" rev-parse HEAD)"
BRANCH="$(git -C "$REPO_ROOT" branch --show-current)"
CLEAN_DIRTY_SHA256="$(printf '' | sha256sum | { read -r hash _; printf '%s' "$hash"; })"
readonly REVISION BRANCH CLEAN_DIRTY_SHA256
[[ "$REVISION" =~ ^[0-9a-f]{40}$ && "$(compute_dirty_sha256)" == "$CLEAN_DIRTY_SHA256" ]] || {
    printf 'Issue #268 requires one clean exact 40-hex committed HEAD.\n' >&2
    exit 2
}

assert_source_unchanged() {
    [[ "$(git -C "$REPO_ROOT" rev-parse HEAD)" == "$REVISION" && "$(compute_dirty_sha256)" == "$CLEAN_DIRTY_SHA256" ]] || {
        printf 'Source moved or became dirty after issue #268 authentication.\n' >&2
        return 1
    }
}

readonly CAMPAIGN_ROOT="$STATE_ROOT/issues/268/$REVISION/physical/$PROFILE"
if [[ -e "$CAMPAIGN_ROOT" ]]; then
    printf 'Create-new physical evidence root already exists: %s\n' "$CAMPAIGN_ROOT" >&2
    exit 2
fi
mkdir -p "$CAMPAIGN_ROOT"
printf '%s\n' 'hvo-issue-268-evidence-v1' > "$CAMPAIGN_ROOT/.hvo-issue-268-owned"

cleanup_project=''
cleanup_env=''
sampler_pid=''
kernel_pid=''
deadline_pid=''
runtime_volume=''
runtime_path=''
runtime_kind=''
active_control_root=''
evidence_root=''
owner_password=''
camera_container=''
collector_container=''
central_deny_container=''
camera_base_uri=''
camera_container_ip=''
runtime_init_container=''
runtime_probe_container=''
sdk_probe_container=''
hardware_output=''
rerun_summary=''
failure_stage=preacquisition

sanitize_failed_test_artifacts() {
    local path raw
    [[ -n "$active_control_root" && -d "$active_control_root" ]] || return 0
    for path in "$evidence_root/acquisition.trx" "$evidence_root/inspection.trx"; do
        [[ -f "$path" ]] || continue
        raw="$active_control_root/${path##*/}.failure-raw"
        if ! mv "$path" "$raw"; then
            rm -f -- "$path" || return 1
            return 1
        fi
        sanitize_text_file "$raw" || return 1
        mv "$raw" "$path" || return 1
    done
}

container_state_summary() {
    docker inspect "$1" --format '{{json .State}}' |
        jq '{Status, Running, Paused, Restarting, OOMKilled, Dead, ExitCode, ErrorEmpty:(.Error == "")}'
}

retain_failure_diagnostics() {
    local camera_state='null' collector_state='null' central_state='null' container output raw state_output stage
    [[ -n "$evidence_root" && -d "$evidence_root" ]] || return 0
    [[ -n "$active_control_root" && -d "$active_control_root" ]] || return 1
    stage="$failure_stage"
    for container in "$camera_container" "$collector_container" "$central_deny_container"; do
        [[ -n "$container" ]] || continue
        if docker container inspect "$container" >/dev/null 2>&1; then
            case "$container" in
                "$camera_container") camera_state="$(container_state_summary "$container")" || return 1 ;;
                "$collector_container") collector_state="$(container_state_summary "$container")" || return 1 ;;
                "$central_deny_container") central_state="$(container_state_summary "$container")" || return 1 ;;
            esac
            output="$evidence_root/${container##*-}-$stage.log"
            raw="$active_control_root/${container##*-}-$stage.raw"
            docker logs --timestamps "$container" > "$raw" 2>&1 || true
            sanitize_text_file "$raw" || return 1
            mv "$raw" "$output" || return 1
        fi
    done
    state_output="$active_control_root/$stage-failure.json"
    jq -n --arg stage "$stage" --argjson camera "$camera_state" --argjson collector "$collector_state" \
        --argjson centralDeny "$central_state" \
        '{schemaVersion:("issue-268-" + $stage + "-failure-v1"), stage:$stage,
          camera:$camera, collector:$collector, centralDeny:$centralDeny}' \
        > "$state_output" || return 1
    mv "$state_output" "$evidence_root/$stage-failure.json" || return 1
}

remove_trial_containers() {
    local container cleanup_failed=0 network
    if [[ -n "$cleanup_project" && -n "$cleanup_env" && -f "$cleanup_env" ]]; then
        docker compose --env-file "$cleanup_env" --project-name "$cleanup_project" --file "$COMPOSE_FILE" \
            down --remove-orphans >/dev/null 2>&1 || cleanup_failed=1
    fi
    for container in "$camera_container" "$collector_container" "$central_deny_container" "$runtime_init_container" "$runtime_probe_container" "$sdk_probe_container"; do
        [[ -n "$container" ]] || continue
        if docker container inspect "$container" >/dev/null 2>&1; then
            docker rm --force "$container" >/dev/null 2>&1 || cleanup_failed=1
        fi
        if docker container inspect "$container" >/dev/null 2>&1; then
            printf 'Failed to remove sensitive issue #268 container metadata: %s\n' "$container" >&2
            cleanup_failed=1
        fi
    done
    if [[ -n "$cleanup_project" ]]; then
        network="${cleanup_project}_isolated"
        if docker network inspect "$network" >/dev/null 2>&1; then
            docker network rm "$network" >/dev/null 2>&1 || cleanup_failed=1
        fi
    fi
    return "$cleanup_failed"
}

remove_owned_runtime() {
    local cleanup_failed=0 owner_label
    if [[ -n "$runtime_volume" ]] && docker volume inspect "$runtime_volume" >/dev/null 2>&1; then
        owner_label="$(docker volume inspect "$runtime_volume" --format '{{index .Labels "hvo.issue-268.owner"}}')"
        if [[ "$owner_label" == "$REVISION:$PROFILE" ]]; then
            docker volume rm --force "$runtime_volume" >/dev/null 2>&1 || cleanup_failed=1
        else
            printf 'Refusing to remove unowned issue #268 runtime volume: %s\n' "$runtime_volume" >&2
            cleanup_failed=1
        fi
    fi
    if [[ -n "$runtime_volume" ]] && docker volume inspect "$runtime_volume" >/dev/null 2>&1; then
        printf 'Failed to remove issue #268 runtime volume: %s\n' "$runtime_volume" >&2
        cleanup_failed=1
    fi
    if [[ "$runtime_kind" == bind-backed-docker-volume && -n "$runtime_path" && -e "$runtime_path" ]]; then
        if [[ -f "$runtime_path/.hvo-issue-268-owned" &&
              "$(<"$runtime_path/.hvo-issue-268-owned")" == 'hvo-issue-268-runtime-v1' ]]; then
            rm -rf -- "$runtime_path" || cleanup_failed=1
        else
            printf 'Refusing to remove unowned issue #268 runtime path: %s\n' "$runtime_path" >&2
            cleanup_failed=1
        fi
    fi
    [[ -z "$runtime_path" || "$runtime_kind" != bind-backed-docker-volume || ! -e "$runtime_path" ]] || cleanup_failed=1
    return "$cleanup_failed"
}

remove_active_control() {
    local cleanup_failed=0
    if [[ -z "$active_control_root" || ! -d "$active_control_root" ]]; then
        active_control_root=''
        return 0
    fi
    chmod -R u+w -- "$active_control_root" || cleanup_failed=1
    rm -rf -- "$active_control_root" || cleanup_failed=1
    if [[ -e "$active_control_root" ]]; then
        cleanup_failed=1
    else
        active_control_root=''
    fi
    return "$cleanup_failed"
}

cleanup() {
    local status=$?
    local cleanup_failed=0
    trap - EXIT INT TERM
    if [[ -n "$sampler_pid" ]]; then kill "$sampler_pid" >/dev/null 2>&1 || true; wait "$sampler_pid" 2>/dev/null || true; fi
    if [[ -n "$kernel_pid" ]]; then kill "$kernel_pid" >/dev/null 2>&1 || true; wait "$kernel_pid" 2>/dev/null || true; fi
    if [[ -n "$deadline_pid" ]]; then kill "$deadline_pid" >/dev/null 2>&1 || true; wait "$deadline_pid" 2>/dev/null || true; fi
    if ((status != 0)); then
        sanitize_failed_test_artifacts || cleanup_failed=1
        retain_failure_diagnostics || printf 'Failure diagnostics could not be retained safely.\n' >&2
    fi
    remove_trial_containers || cleanup_failed=1
    remove_owned_runtime || cleanup_failed=1
    remove_active_control || cleanup_failed=1
    if [[ -n "$hardware_output" ]]; then rm -f -- "$hardware_output" || cleanup_failed=1; fi
    if [[ -n "$rerun_summary" ]]; then rm -f -- "$rerun_summary" || cleanup_failed=1; fi
    unset owner_password HVO_ZWO_CAMERA_SERIAL
    camera_container_ip=''
    camera_base_uri=''
    if ((cleanup_failed != 0)); then
        printf 'Issue #268 cleanup could not prove removal of all sensitive metadata and owned runtime state.\n' >&2
        status=1
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

HOSTNAME_ACTUAL="$(hostname -s)"
readonly HOSTNAME_ACTUAL
[[ "$HOSTNAME_ACTUAL" == "$EXPECTED_HOST" ]] || { printf 'Expected host %s, found %s.\n' "$EXPECTED_HOST" "$HOSTNAME_ACTUAL" >&2; exit 2; }
[[ "$(uname -m)" == "$EXPECTED_ARCH" ]] || { printf 'Expected architecture %s.\n' "$EXPECTED_ARCH" >&2; exit 2; }
[[ "$(cat /sys/module/usbcore/parameters/usbfs_memory_mb)" == 200 ]] || { printf 'USBFS memory must be exactly 200 MB.\n' >&2; exit 2; }
[[ -r "$HVO_ISSUE_268_USB_SYSFS_PATH/idVendor" && -r "$HVO_ISSUE_268_USB_SYSFS_PATH/idProduct" && -r "$HVO_ISSUE_268_USB_SYSFS_PATH/speed" ]] || {
    printf 'Selected USB sysfs device is incomplete.\n' >&2
    exit 2
}
[[ "$(<"$HVO_ISSUE_268_USB_SYSFS_PATH/idVendor")" == '03c3' && "$(<"$HVO_ISSUE_268_USB_SYSFS_PATH/idProduct")" == "$EXPECTED_USB_PRODUCT" ]] || {
    printf 'Selected USB identity does not match %s.\n' "$CAMERA_MODEL" >&2
    exit 2
}
[[ "$(<"$HVO_ISSUE_268_USB_SYSFS_PATH/speed")" == '5000' ]] || { printf 'Selected camera must enumerate at 5 Gbit/s.\n' >&2; exit 2; }
if [[ "$PROFILE" == asi178mc &&
      ("$(<"$HVO_ISSUE_268_USB_SYSFS_PATH/busnum")" != 10 || "$(<"$HVO_ISSUE_268_USB_SYSFS_PATH/devpath")" != 1) ]]; then
    printf 'The x64 ASI178MC must remain on USB bus 010 port 1.\n' >&2
    exit 2
fi
USB_BUS="$(printf '%03d' "$((10#$(<"$HVO_ISSUE_268_USB_SYSFS_PATH/busnum")))")"
USB_DEVICE="$(printf '%03d' "$((10#$(<"$HVO_ISSUE_268_USB_SYSFS_PATH/devnum")))")"
readonly USB_BUS USB_DEVICE
readonly USB_DEVICE_NODE="/dev/bus/usb/$USB_BUS/$USB_DEVICE"
[[ -c "$USB_DEVICE_NODE" ]] || { printf 'Selected USB device node is missing.\n' >&2; exit 2; }
USB_DEVICE_GID="$(stat --format='%g' "$USB_DEVICE_NODE")"
readonly USB_DEVICE_GID

assert_usb_topology() {
    local zwo_count=0 selected_count=0
    local speeds=() buses=()
    local vendor_file
    for vendor_file in /sys/bus/usb/devices/*/idVendor; do
        [[ -f "$vendor_file" ]] || continue
        [[ "$(<"$vendor_file")" == '03c3' ]] || continue
        local device_root="${vendor_file%/idVendor}"
        zwo_count=$((zwo_count + 1))
        speeds+=("$(<"$device_root/speed")")
        buses+=("$(<"$device_root/busnum")")
        [[ "$device_root" == "$HVO_ISSUE_268_USB_SYSFS_PATH" ]] && selected_count=$((selected_count + 1))
    done
    [[ "$selected_count" -eq 1 ]] || { printf 'Selected USB path is not unique in the ZWO topology.\n' >&2; return 1; }
    if [[ "$PROFILE" == asi178mc ]]; then
        [[ "$zwo_count" -eq 1 && "${speeds[0]}" == 5000 ]] || {
            printf 'x64 topology must contain only the selected 5-Gbit/s ZWO camera.\n' >&2
            return 1
        }
    else
        [[ "$zwo_count" -eq 3 && "$(printf '%s\n' "${speeds[@]}" | sort -n | tr '\n' ' ')" == '480 5000 5000 ' &&
           "$(printf '%s\n' "${buses[@]}" | sort -u | wc -l)" -eq 3 ]] || {
            printf 'ARM topology must retain three ZWO cameras on separate buses at 480/5000/5000 Mbit/s.\n' >&2
            return 1
        }
    fi
}

assert_host_runtime_identity() {
    local blocks size evidence_blocks_current evidence_size_current
    [[ "$(hostname -s)" == "$EXPECTED_HOST" && "$(uname -m)" == "$EXPECTED_ARCH" &&
       "$(uname -r)" == "$EXPECTED_KERNEL" && "$(nproc)" -eq "$EXPECTED_LOGICAL_CPUS" &&
       "$(awk '/^MemTotal:/ {printf "%.0f", $2 * 1024}' /proc/meminfo)" -eq "$EXPECTED_MEMORY_BYTES" ]] || return 1
    [[ "$(<"$HVO_ISSUE_268_USB_SYSFS_PATH/idVendor")" == 03c3 &&
       "$(<"$HVO_ISSUE_268_USB_SYSFS_PATH/idProduct")" == "$EXPECTED_USB_PRODUCT" &&
       "$(<"$HVO_ISSUE_268_USB_SYSFS_PATH/speed")" == 5000 ]] || return 1
    [[ "$(timedatectl show --property=NTPSynchronized --value)" == yes ]] || return 1
    [[ "$(findmnt -n -o SOURCE --target "$EXPECTED_RUNTIME_MOUNT")" == "$EXPECTED_RUNTIME_DEVICE" &&
       "$(findmnt -n -o FSTYPE --target "$EXPECTED_RUNTIME_MOUNT")" == "$EXPECTED_RUNTIME_FS" ]] || return 1
    read -r blocks size < <(stat -f --format='%a %S' "$EXPECTED_RUNTIME_MOUNT")
    read -r evidence_blocks_current evidence_size_current < <(stat -f --format='%a %S' "$STATE_ROOT")
    ((blocks * size >= MINIMUM_FREE_BYTES && evidence_blocks_current * evidence_size_current >= MINIMUM_FREE_BYTES)) || return 1
    [[ "$PROFILE" != asi676mc || "$(vcgencmd get_throttled | cut -d= -f2)" == 0x0 ]] || return 1
    assert_usb_topology
}

assert_host_runtime_identity || { printf 'Host, clock, storage, or USB topology identity changed.\n' >&2; exit 2; }
[[ -z "$(fuser "$USB_DEVICE_NODE" 2>/dev/null || true)" ]] || { printf 'A competing process owns the selected camera.\n' >&2; exit 2; }

sha256_matches() {
    local path="$1" expected="$2" actual
    read -r actual _ < <(sha256sum "$path")
    [[ "${actual,,}" == "${expected,,}" ]]
}
tree_sha256() {
    local root="$1"
    (
        cd "$root"
        {
            find . -type f -exec sha256sum {} \;
            find . -type l -printf 'symlink %p -> %l\n'
        } | sort
    ) | sha256sum | { read -r hash _; printf '%s' "$hash"; }
}
assert_static_identities() {
    sha256_matches "$PROFILE_FILE" "$EXPECTED_PROFILE_SHA256" &&
        sha256_matches "$HVO_ZWO_SDK_LIBRARY" "$EXPECTED_SDK_SHA256" &&
        sha256_matches "$HEADER_PATH" "$EXPECTED_HEADER_SHA256" &&
        sha256_matches "$UDEV_PATH" "$EXPECTED_UDEV_SHA256"
}
assert_static_identities || { printf 'Profile, SDK, header, or udev identity changed.\n' >&2; exit 2; }
catalog_lock="$HVO_CATALOG_PERF_ROOT/.catalog.lock"
[[ -f "$catalog_lock" && ! -L "$catalog_lock" ]] || {
    printf 'Production catalog installer lock is missing or unsafe.\n' >&2
    exit 2
}
catalog_lock_identity="$(stat -Lc '%d:%i' "$catalog_lock")"
exec 7>> "$catalog_lock"
flock -s 7
[[ ! -L "$catalog_lock" && "$catalog_lock_identity" == "$(stat -Lc '%d:%i' "$catalog_lock")" &&
   "$catalog_lock_identity" == "$(stat -Lc '%d:%i' /proc/$$/fd/7)" ]] || {
    printf 'Production catalog installer lock changed while it was acquired.\n' >&2
    exit 2
}
assert_catalog_identity() {
    local catalog_file
    local expected_target="versions/$EXPECTED_CATALOG_PACKAGE_VERSION"
    [[ -L "$HVO_CATALOG_PERF_ROOT/current" &&
       "$(readlink "$HVO_CATALOG_PERF_ROOT/current")" == "$expected_target" &&
       -d "$HVO_CATALOG_PERF_ROOT/$expected_target" ]] || return 1
    [[ -z "$(find "$HVO_CATALOG_PERF_ROOT" -mindepth 1 ! -type d ! -type f \
        ! -path "$HVO_CATALOG_PERF_ROOT/current" -print -quit)" ]] || return 1
    [[ "$(find "$HVO_CATALOG_PERF_ROOT" -type l -print)" == "$HVO_CATALOG_PERF_ROOT/current" ]] || return 1
    catalog_file="$HVO_CATALOG_PERF_ROOT/$expected_target/hyg_v42.sqlite"
    [[ -f "$catalog_file" && ! -L "$catalog_file" ]] || return 1
    sha256_matches "$catalog_file" "$EXPECTED_CATALOG_SHA256" || return 1
    [[ "$(find "$HVO_CATALOG_PERF_ROOT" -type f -name '*.sqlite' -print)" == "$catalog_file" ]] || return 1
    [[ -z "${SOURCE_CATALOG_TREE_SHA256:-}" ||
       "$(tree_sha256 "$HVO_CATALOG_PERF_ROOT")" == "$SOURCE_CATALOG_TREE_SHA256" ]]
}
assert_catalog_identity || { printf 'Production catalog root must contain exactly one reviewed database.\n' >&2; exit 2; }
SOURCE_CATALOG_TREE_SHA256="$(tree_sha256 "$HVO_CATALOG_PERF_ROOT")"
readonly SOURCE_CATALOG_TREE_SHA256

