#!/usr/bin/env python3
"""Exercise the queue gate and Kepler publisher using real Git and offline REST responses."""
import copy
import json
import os
import pathlib
import shutil
import subprocess
import tempfile
import unittest

ROOT = pathlib.Path(__file__).resolve().parent.parent
GATE = ROOT / "scripts/ci:queue-reviewed-head"
REPO = "example/repo"
BRANCH = "development/v1"
BASE_REF = f"refs/heads/{BRANCH}"
BASE_API = f"git/ref/heads/{BRANCH}"
CONTEXT = "hvo/reviewed-head"
ACTOR = {"login": "RoySalisbury", "id": 12501943}
PR = 42
VERSION = "hvo-diff-v1"

# Only the transport is mocked. All merges, history walks, diffs and fetches
# (including the trusted checkout's fetch of the queue ref) use Git.
GH = r'''#!/usr/bin/env python3
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_GH_CALLS"], "a") as calls:
    calls.write(json.dumps(args) + "\n")
if args[:3] != ["api", "--hostname", "github.com"]:
    sys.exit("unexpected gh invocation")
args = args[3:]
with open(os.environ["FAKE_GH_STATE"]) as source:
    endpoints = json.load(source)
if args[:2] == ["--method", "POST"]:
    if args[2] not in endpoints or args[3:8] != ["-f", "state=success", "-f", "context=hvo/reviewed-head", "-f"]:
        sys.exit("unexpected status write")
    print("{}")
    sys.exit(0)
path, *flags = args
if path not in endpoints or flags not in ([], ["--paginate", "--slurp"]):
    sys.exit(f"unexpected API call: {args}")
response = endpoints[path]
if "sequence" in response:
    with open(os.environ["FAKE_GH_CALLS"]) as calls:
        count = sum(path in json.loads(line) for line in calls) - 1
    response = response["sequence"][min(count, len(response["sequence"]) - 1)]
pages = response["pages"] if flags else response["pages"][:1]
if "fail_page" in response and response["fail_page"] < len(pages):
    sys.exit("simulated API failure")
if "raw" in response:
    print(response["raw"])
else:
    print(json.dumps(pages if flags else pages[0]))
'''


def endpoint(path):
    return f"repos/{REPO}/{path}"


def statuses(sha):
    return endpoint(f"commits/{sha}/statuses?per_page=100")


def associations(sha):
    return endpoint(f"commits/{sha}/pulls?per_page=100")


def status(id_=10, description=None, *, state="success", actor=ACTOR, context=CONTEXT):
    return {"id": id_, "state": state, "creator": actor, "context": context, "description": description}


def pull(number, head, *, state="open", branch=BRANCH, repo=REPO):
    return {"number": number, "state": state, "base": {"ref": branch, "repo": {"full_name": repo}},
            "head": {"sha": head, "repo": {"full_name": "contributor/fork"}}}


def base_response(sha):
    return {"pages": [{"object": {"type": "commit", "sha": sha}}]}


class QueueReviewedHead(unittest.TestCase):
    def setUp(self):
        cache = pathlib.Path.home() / ".cache"
        cache.mkdir(mode=0o700, exist_ok=True)
        scratch = tempfile.TemporaryDirectory(prefix="hvo-scratch-review-diff-", dir=cache)
        self.addCleanup(scratch.cleanup)
        self.dir = pathlib.Path(scratch.name)
        self.origin = self.dir / "origin"
        self.checkout = self.dir / "trusted"
        self.state = self.dir / "state.json"
        self.call_log = self.dir / "calls.jsonl"
        gh = self.dir / "gh"
        gh.write_text(GH)
        gh.chmod(0o700)
        self.env = dict(
            os.environ, PATH=f"{self.dir}:{os.environ['PATH']}", FAKE_GH_STATE=str(self.state),
            FAKE_GH_CALLS=str(self.call_log), REPOSITORY=REPO, ALLOWED_SETTERS="RoySalisbury",
            BASE_REF=BASE_REF, GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL=os.devnull,
        )
        self.origin.mkdir()
        self.git("init", "-qb", BRANCH, "--object-format=sha1")
        for key, value in (("user.name", "Queue Fixture"), ("user.email", "fixture@example.invalid"),
                           ("core.fileMode", "true"), ("commit.gpgsign", "false")):
            self.git("config", key, value)
        self.original = "".join(f"line {index:02d}\n" for index in range(30))
        self.write("shared.txt", self.original)
        self.write("operator.md", "operator instructions\n")
        self.write("payload.bin", b"\x00\x01\x02base\xff")
        self.write("run.sh", "#!/bin/sh\nexit 0\n")
        self.write("empty", "")
        self.base = self.commit("original base")
        self.switch(self.base)
        self.write("shared.txt", self.original.replace("line 18", "PR change"))
        self.reviewed = self.commit("reviewed head")
        self.data = {endpoint(BASE_API): base_response(self.base), "user": {"pages": [ACTOR]}}
        self.set_pull(PR, self.reviewed)

    def git(self, *args, where=None, check=True):
        result = subprocess.run(
            ["git", *args], cwd=where or self.origin, env=self.env,
            capture_output=True, text=True, timeout=30,
        )
        if check:
            self.assertEqual(result.returncode, 0, f"git {args}\n{result.stderr}")
            return result.stdout.strip()
        return result

    def write(self, name, contents):
        path = self.origin / name
        path.write_bytes(contents if isinstance(contents, bytes) else contents.encode())

    def switch(self, ref):
        self.git("switch", "--detach", "-q", ref)

    def commit(self, message):
        self.git("add", "-A")
        self.git("commit", "-qm", message)
        return self.git("rev-parse", "HEAD")

    def merge(self, parent, *, check=True, options=()):
        result = self.git("merge", "--no-ff", "--no-edit", *options, parent, check=check)
        return self.git("rev-parse", "HEAD") if check else result

    def advance(self, *, same_file=False):
        self.git("switch", "-q", BRANCH)
        if same_file:
            path = self.origin / "shared.txt"
            self.write("shared.txt", "inserted upstream line\n" + path.read_text())
        else:
            self.write("upstream.txt", self.git("rev-parse", "HEAD") + "\n")
        tip = self.commit("protected branch advances")
        self.data[endpoint(BASE_API)] = base_response(tip)
        return tip

    def sync(self, parent, tip):
        self.switch(parent)
        return self.merge(tip)

    def set_pull(self, number, head):
        self.git("update-ref", f"refs/pull/{number}/head", head)
        self.data[endpoint(f"pulls/{number}")] = {"pages": [pull(number, head)]}
        self.data.setdefault(statuses(head), {"pages": [[]]})

    def set_status(self, head, *pages):
        self.data[statuses(head)] = {"pages": list(pages)}

    def make_group(self, head=None, *, tip=None, number=PR, object_id=None):
        head = head or self.reviewed
        if object_id is None:
            self.switch(tip or self.git("rev-parse", BRANCH))
            object_id = self.merge(head)
        self.set_pull(number, head)
        self.group = object_id
        self.queue_ref = f"refs/heads/gh-readonly-queue/{BRANCH}/pr-{number}-{head}"
        self.git("update-ref", self.queue_ref, self.group)
        return object_id

    def commit_tree(self, tree, *parents):
        args = [arg for parent in parents for arg in ("-p", parent)]
        return self.git("commit-tree", tree, *args, "-m", "fixture topology")

    def clone(self, *, shallow=False):
        flags = ["--depth=1"] if shallow else ["--no-hardlinks"]
        source = self.origin.as_uri() if shallow else str(self.origin)
        self.git("clone", "-q", "--branch", BRANCH, *flags, source, str(self.checkout), where=self.dir)

    def run_command(self, *args, gate=GATE, **overrides):
        if not self.checkout.exists():
            self.clone()
        self.call_log.write_text("")
        self.state.write_text(json.dumps(self.data))
        head = self.git("rev-parse", "HEAD", where=self.checkout)
        env = dict(self.env, BASE_SHA=head)
        env.update(overrides)
        if not args:
            env.setdefault("HEAD_REF", self.queue_ref)
            env.setdefault("GROUP_SHA", self.group)
        return subprocess.run(
            [str(gate), *args], cwd=self.checkout, env=env,
            capture_output=True, text=True, timeout=90,
        )

    def calls(self):
        return [json.loads(line) for line in self.call_log.read_text().splitlines()]

    def writes(self):
        return [call for call in self.calls() if call[3:5] == ["--method", "POST"]]

    def assert_pass(self, result):
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)

    def assert_fails(self, result, reason):
        self.assertNotEqual(result.returncode, 0, result.stdout)
        self.assertIn(reason, result.stderr)
        self.assertEqual(self.writes(), [], result.stdout)

    def stamp(self, head, *args, number=PR):
        self.data[endpoint(f"statuses/{head}")] = {"pages": []}
        return self.run_command("stamp", str(number), head, "--repo", REPO, *args)

    def approve(self, *, number=PR, reviewed=None, base=None):
        reviewed = reviewed or self.reviewed
        base = base or self.base
        self.set_pull(number, reviewed)
        self.assert_pass(self.stamp(reviewed, "--reviewed-base", base, number=number))
        self.assertEqual(len(self.writes()), 1)
        description = self.writes()[0][-1].split("=", 1)[1]
        self.assertRegex(description, rf"^{VERSION}:{reviewed}:{base}:[A-Za-z0-9_-]{{43}}$")
        self.assertLessEqual(len(description), 140)
        self.set_status(reviewed, [status(description=description)])
        return description

    def test_exact_reviewed_head_legacy_and_versioned(self):
        self.make_group()
        self.set_status(self.reviewed, [status(description="Dual-CLEAN at exact head")])
        self.assert_pass(self.run_command())
        self.approve()
        self.assert_pass(self.run_command())
        self.assertTrue(any(statuses(self.reviewed) in call for call in self.calls()))
        self.assertFalse(any(statuses(self.group) in call for call in self.calls()))
        self.assertEqual(self.writes(), [])

    def test_conflict_free_base_move_without_pr_resync(self):
        self.approve()
        tip = self.advance(same_file=True)
        self.make_group(tip=tip)
        self.assert_pass(self.run_command())
        self.set_status(self.reviewed, [status()])
        self.assert_pass(self.run_command())

    def test_unrelated_file_clean_sync(self):
        self.approve()
        head = self.sync(self.reviewed, self.advance())
        self.make_group(head)
        result = self.run_command()
        self.assert_pass(result)
        self.assertIn(f"against approval on {self.reviewed}", result.stdout)

    def test_nonoverlapping_same_file_clean_sync(self):
        description = self.approve()
        head = self.sync(self.reviewed, self.advance(same_file=True))
        self.set_status(head, [status(description=description)])
        self.make_group(head)
        self.assert_pass(self.run_command())

    def test_multiple_syncs_carry_status_for_current_head_and_recheck_ancestor(self):
        description = self.approve()
        first = self.sync(self.reviewed, self.advance())
        self.set_status(first, [])
        second = self.sync(first, self.advance(same_file=True))
        self.make_group(second)
        self.assert_pass(self.run_command())
        self.data[endpoint(f"statuses/{second}")] = {"pages": []}
        args = ("stamp", str(PR), self.reviewed, "--repo", REPO, "--carry")
        self.assert_pass(self.run_command(*args))
        self.assertEqual(self.writes()[0][-1], f"description={description}")
        self.set_status(second, [status(description=description)])
        self.assert_pass(self.run_command())
        self.set_status(self.reviewed, [status(description=description)], [status(11, state="pending")])
        self.assert_fails(self.run_command(), "is pending")
        self.assert_fails(self.run_command(*args), "is pending")

    def test_stale_fingerprint_after_every_kind_of_pr_file_edit(self):
        original = self.approve()
        edits = {
            "code or text": lambda: self.write("shared.txt", "other change\n"),
            "documentation": lambda: self.write("operator.md", "updated instructions\n"),
            "whitespace only": lambda: self.write("shared.txt", (self.origin / "shared.txt").read_text() + " \n"),
            "binary": lambda: self.write("payload.bin", b"\x00\xffunreviewed"),
            "executable mode": lambda: (self.origin / "run.sh").chmod(0o755),
            "empty file addition": lambda: self.write("another-empty", ""),
            "empty file deletion": lambda: (self.origin / "empty").unlink(),
            "rename": lambda: self.git("mv", "operator.md", "renamed.md"),
            "add": lambda: self.write("new-file", "hello\n"),
            "delete": lambda: (self.origin / "operator.md").unlink(),
        }
        for label, edit in edits.items():
            with self.subTest(edit=label):
                self.switch(self.reviewed)
                edit()
                head = self.commit(label)
                self.make_group(head)
                self.set_status(head, [status(description=original)])
                self.assert_fails(self.run_command(), "is not a merge-only base sync")
                # Even a stale fingerprint relabeled with the new commit SHA
                # cannot pass as a direct versioned approval.
                relabeled = original.replace(self.reviewed, head)
                self.set_status(head, [status(description=relabeled)])
                self.assert_fails(self.run_command(), "fingerprint does not match")

    def conflicting_tip(self):
        self.git("switch", "-q", BRANCH)
        self.write("shared.txt", self.original.replace("line 18", "upstream conflict"))
        tip = self.commit("overlapping upstream edit")
        self.data[endpoint(BASE_API)] = base_response(tip)
        return tip

    def test_manual_conflict_resolution_and_strategy_options_fail_closed(self):
        description = self.approve()
        tip = self.conflicting_tip()
        for option in ("manual", "ours", "theirs"):
            with self.subTest(resolution=option):
                self.switch(self.reviewed)
                if option == "manual":
                    self.assertNotEqual(self.merge(tip, check=False).returncode, 0)
                    self.write("shared.txt", self.original.replace("line 18", "manual resolution"))
                    head = self.commit("manually resolved conflict")
                else:
                    head = self.merge(tip, options=("-X", option))
                self.make_group(head, tip=tip)
                self.set_status(head, [status(description=description)])
                self.assert_fails(self.run_command(), "cannot reproduce a clean merge")

    def test_automatic_union_conflict_driver_cannot_carry_approval(self):
        self.git("switch", "-q", BRANCH)
        self.write(".gitattributes", "shared.txt merge=union\n")
        self.base = self.commit("configured conflict driver")
        self.switch(self.base)
        self.write("shared.txt", self.original.replace("line 18", "PR change"))
        self.reviewed = self.commit("reviewed change with union driver")
        self.data[endpoint(BASE_API)] = base_response(self.base)
        self.approve()
        tip = self.conflicting_tip()
        head = self.sync(self.reviewed, tip)
        self.make_group(head)
        self.assert_fails(self.run_command(), "cannot reproduce a clean merge")

    def test_evil_sync_edit_anywhere_fails(self):
        description = self.approve()
        tip = self.advance()
        for name in ("shared.txt", "unrelated-change.txt"):
            with self.subTest(path=name):
                self.switch(self.reviewed)
                self.merge(tip, options=("--no-commit",))
                self.write(name, "unreviewed change\n")
                bad = self.commit("extra merge edit")
                self.make_group(bad, tip=tip)
                self.set_status(bad, [status(description=description)])
                self.assert_fails(self.run_command(), "differs from the clean merge")

    def test_evil_queue_merge_fails_even_for_direct_review(self):
        self.approve()
        tip = self.advance()
        self.switch(tip)
        self.merge(self.reviewed, options=("--no-commit",))
        self.write("unrelated-extra", "unapproved queue change\n")
        self.make_group(object_id=self.commit("evil queue merge"))
        self.assert_fails(self.run_command(), "differs from the clean merge")

    def test_sync_from_non_mainline_commit_or_with_reversed_parents_fails(self):
        self.approve()
        self.switch(self.base)
        self.write("side.txt", "side branch\n")
        side = self.commit("merged side branch")
        self.git("switch", "-q", BRANCH)
        tip = self.merge(side)
        self.data[endpoint(BASE_API)] = base_response(tip)
        self.make_group(self.sync(self.reviewed, side))
        self.assert_fails(self.run_command(), "does not advance the protected base")
        self.switch(tip)
        swapped = self.merge(self.reviewed)
        self.make_group(swapped)
        self.assert_fails(self.run_command(), "does not advance the protected base")

    def test_legacy_success_cannot_cross_shas(self):
        self.set_status(self.reviewed, [status(description="Dual-CLEAN")])
        self.make_group(self.sync(self.reviewed, self.advance()))
        self.assert_fails(self.run_command(), "legacy approval is valid only on the exact PR head")

    def test_missing_failed_and_tampered_reviewed_ancestor_fail(self):
        description = self.approve()
        head = self.sync(self.reviewed, self.advance())
        self.make_group(head)
        self.set_status(head, [status(description=description)])
        for ancestor_page, diagnostic in (
            ([], "has no hvo/reviewed-head status"),
            ([status(description=description, state="failure")], "is failure"),
            ([status(description=description[::-1])], "unverified reviewed diff approval"),
            ([status(description=description, actor={"login": "fake", "id": 2})], "unauthorized"),
        ):
            with self.subTest(diagnostic=diagnostic):
                self.set_status(self.reviewed, ancestor_page)
                self.assert_fails(self.run_command(), diagnostic)

    def test_forged_status_format_publisher_context_and_comments(self):
        good = self.approve()
        self.make_group()
        self.data[endpoint(f"issues/{PR}/comments")] = {"pages": [[{"body": good, "user": ACTOR}]]}
        cases = (
            (status(description=good, actor={"login": "RoySalisbury", "id": 999}), "unauthorized"),
            (status(description=good, actor={"login": "RoySalisbury2", "id": ACTOR["id"]}), "unauthorized"),
            (status(description=good, actor=None), "unauthorized"),
            (status(description=good, context="other"), "is not a merge-only base sync"),
            (status(description=good, context=CONTEXT.upper()), "noncanonical"),
            (status(description=good, state="failure"), "is failure"),
            (status(description=good.replace(VERSION, "hvo-diff-v2")), "unknown or malformed"),
            (status(description=VERSION + ":bad"), "unknown or malformed"),
            (status(description=good[:-43] + "A" * 43), "fingerprint does not match"),
            (status(description={"description": good}), "malformed reviewed-head description"),
        )
        for record, diagnostic in cases:
            with self.subTest(diagnostic=diagnostic, id=record["id"]):
                self.set_status(self.reviewed, [record])
                self.assert_fails(self.run_command(), diagnostic)
                self.assertFalse(any("comments" in arg for call in self.calls() for arg in call))

    def test_fingerprint_for_another_pr_cannot_be_replayed_even_at_same_head(self):
        self.approve(number=43)
        self.make_group(number=PR)
        self.assert_fails(self.run_command(), "fingerprint does not match pull request #42")

    def test_stamped_base_must_be_in_reviewed_and_protected_history(self):
        description = self.approve()
        tip = self.advance()
        self.make_group()
        self.set_status(self.reviewed, [status(description=description.replace(self.base, tip))])
        self.assert_fails(self.run_command(), "stamped merge base is outside")

    def test_newest_numeric_status_across_pages_and_api_errors(self):
        self.make_group()
        self.set_status(self.reviewed, [status(11, state="failure"), status(13, context="other")], [status(12)])
        self.assert_pass(self.run_command())
        self.set_status(self.reviewed, [status(9)], [status(10, state="failure")])
        self.assert_fails(self.run_command(), "is failure")
        self.set_status(self.reviewed, [status()], [])
        self.data[statuses(self.reviewed)]["fail_page"] = 1
        self.assert_fails(self.run_command(), "cannot read GitHub API response")
        for page in ({}, [{"id": 10}], [status(0)], [status("10")], [status(1.5)], [status(True)],
                     [status(), status(state="pending")], [status(state="approved")]):
            with self.subTest(page=page):
                self.set_status(self.reviewed, page)
                self.assert_fails(self.run_command(), CONTEXT)
        for path in (endpoint(BASE_API), endpoint(f"pulls/{PR}"), statuses(self.reviewed)):
            with self.subTest(path=path):
                previous = self.data[path]
                self.data[path] = {"pages": [[]], "raw": "{invalid"}
                self.assert_fails(self.run_command(), "cannot read GitHub API response")
                self.data[path] = previous

    def test_wrong_head_target_and_group_ref_fail(self):
        self.make_group()
        self.set_status(self.reviewed, [status()])
        for record, diagnostic in (
            (pull(PR, self.base), "is not its queued second parent"),
            (pull(PR, self.reviewed, state="closed"), "is closed"),
            (pull(PR, self.reviewed, repo="another/repo"), "targets a different"),
            (pull(PR, self.reviewed, branch="main"), "targets a different"),
            (pull(PR + 1, self.reviewed), "mismatched pull request number"),
        ):
            self.data[endpoint(f"pulls/{PR}")] = {"pages": [record]}
            self.assert_fails(self.run_command(), diagnostic)
        self.set_pull(PR, self.reviewed)
        for key in ("HEAD_REF", "GROUP_SHA", "BASE_REF", "BASE_SHA", "REPOSITORY", "ALLOWED_SETTERS"):
            self.assert_fails(self.run_command(**{key: ""}), f"{key} is required")
        self.assert_fails(self.run_command(GROUP_SHA=self.base), "moved during the fetch")
        self.assert_fails(self.run_command(HEAD_REF="refs/heads/untrusted"), "unexpected merge group head ref")
        self.assert_fails(self.run_command(BASE_REF="refs/heads/main"), "unexpected merge group base ref")

    def test_squash_rebase_octopus_and_zero_entry_queue_are_rejected(self):
        self.set_status(self.reviewed, [status()])
        tree = self.git("rev-parse", f"{self.reviewed}^{{tree}}")
        tip = self.advance()
        # A rebase keeps the author's patch but the queued result still has
        # one parent. A squash also has a single parent.
        self.switch(self.reviewed)
        self.git("rebase", tip)
        rebased = self.git("rev-parse", "HEAD")
        for result in (self.commit_tree(tree, tip), rebased, self.commit_tree(tree, tip, self.reviewed, self.base)):
            self.make_group(object_id=result)
            self.assert_fails(self.run_command(), "only the merge-commit method is supported")
        self.make_group(object_id=tip)
        self.assert_fails(self.run_command(), "contains no queued PRs")

    def test_rewritten_pr_head_cannot_inherit_approval_even_if_diff_matches(self):
        description = self.approve()
        tip = self.advance()
        self.switch(self.reviewed)
        self.git("rebase", tip)
        head = self.git("rev-parse", "HEAD")
        self.make_group(head)
        self.set_status(head, [status(description=description)])
        self.assert_fails(self.run_command(), "is not a merge-only base sync")

    def test_criss_cross_merge_base_fails(self):
        tree = self.git("rev-parse", f"{self.base}^{{tree}}")
        # Use two incomparable commits as the paired merge bases.
        self.switch(self.base)
        self.write("second.txt", "second branch\n")
        second = self.commit("second branch")
        left = self.commit_tree(tree, self.reviewed, second)
        right = self.commit_tree(tree, second, self.reviewed)
        self.git("update-ref", BASE_REF, left)
        self.data[endpoint(BASE_API)] = base_response(left)
        self.set_status(right, [status()])
        self.make_group(right, object_id=self.commit_tree(tree, left, right))
        self.assert_fails(self.run_command(), "ambiguous merge base")

    def test_old_shallow_caller_fetches_history_and_incomplete_origin_fails(self):
        tip = self.advance()
        self.make_group()
        self.set_status(self.reviewed, [status()])
        self.clone(shallow=True)
        self.assert_pass(self.run_command())
        shallow = self.dir / "shallow-origin"
        self.git("clone", "-q", "--bare", "--depth=1", "--branch", BRANCH,
                 self.origin.as_uri(), str(shallow), where=self.dir)
        shutil.rmtree(self.checkout)
        self.git("clone", "-q", "--branch", BRANCH, shallow.as_uri(), str(self.checkout), where=self.dir)
        self.assertEqual(self.git("rev-parse", "HEAD", where=self.checkout), tip)
        self.assert_fails(self.run_command(), "shallow Git history")

    def test_missing_reachable_blob_and_unavailable_base_fail_closed(self):
        self.make_group()
        self.set_status(self.reviewed, [status()])
        self.clone()
        blob = self.git("rev-parse", f"{self.reviewed}:shared.txt")
        (self.checkout / ".git/objects" / blob[:2] / blob[2:]).unlink()
        self.assert_fails(self.run_command(), "rev-list")
        self.data[endpoint(BASE_API)] = base_response("0" * 40)
        self.assert_fails(self.run_command(), "merge-base")

    def make_chain(self, entries):
        tip = self.base
        heads = []
        for index in range(entries):
            self.switch(self.base)
            self.write(f"entry-{index}.txt", f"PR {index}\n")
            head = self.commit(f"reviewed entry {index}")
            number = PR if index == entries - 1 else 1000 + index
            tip = self.make_group(head, tip=tip, number=number)
            self.data[associations(head)] = {"pages": [[], [pull(number, head)]]}
            self.set_status(head, [status()])
            heads.append((head, tip))
        return heads

    def test_two_and_three_entry_group_checks_each_entry(self):
        for entries in (2, 3):
            with self.subTest(entries=entries):
                heads = self.make_chain(entries)
                self.assert_pass(self.run_command())
                for head, _ in heads[:-1]:
                    self.set_status(head, [status(state="failure")])
                    self.assert_fails(self.run_command(), "is failure")
                    self.set_status(head, [status()])

    def test_earlier_entry_pr_association_is_unique_paged_and_exact(self):
        head = self.make_chain(2)[0][0]
        good = self.data[associations(head)]
        for bad in ([pull(1000, head, state="closed")], [pull(1000, self.base)],
                    [pull(1000, head, branch="main")], [pull(1000, head, repo="other/repo")]):
            self.data[associations(head)] = {"pages": [bad]}
            self.assert_fails(self.run_command(), "found 0")
        self.data[associations(head)] = {"pages": [[pull(1000, head)], [pull(1001, head)]]}
        self.assert_fails(self.run_command(), "found 2")
        self.data[associations(head)] = good
        self.assert_pass(self.run_command())
        self.data[associations(head)]["fail_page"] = 1
        self.assert_fails(self.run_command(), "cannot read GitHub API response")

    def test_base_refresh_accepts_only_authenticated_landed_earlier_entry(self):
        (head, landed), _ = self.make_chain(2)
        old, new = base_response(self.base), base_response(landed)
        for response, pull_state in (({"pages": [[]]}, "open"),
                                     ({"pages": [[pull(1000, head)]]}, "closed")):
            self.data[endpoint(BASE_API)] = {"sequence": [old, old, new]}
            self.data[associations(head)] = response
            self.data[endpoint("pulls/1000")]["pages"] = [pull(1000, head, state=pull_state)]
            self.assert_pass(self.run_command())
        self.data[endpoint(BASE_API)] = base_response(self.reviewed)
        self.data[endpoint("pulls/1000")]["pages"] = [pull(1000, head)]
        self.assert_fails(self.run_command(), "only the merge-commit method is supported")

    def test_queue_entry_limit_boundary(self):
        for entries in (100, 101):
            with self.subTest(entries=entries):
                self.make_chain(entries)
                result = self.run_command()
                if entries == 100:
                    self.assert_pass(result)
                else:
                    self.assert_fails(result, "exceeds 100 entries")

    def test_stamp_requires_authorized_actor_reviewed_base_and_current_head(self):
        data = copy.deepcopy(self.data)
        for actor in ({"login": "RoySalisbury", "id": 999}, {"login": "other", "id": ACTOR["id"]}):
            self.data["user"] = {"pages": [actor]}
            self.assert_fails(self.stamp(self.reviewed, "--reviewed-base", self.base), "unauthorized")
        self.data = data
        self.assert_fails(self.stamp(self.reviewed, "--reviewed-base", self.reviewed), "does not match the PR")
        self.assert_fails(self.stamp(self.base, "--reviewed-base", self.base), "has changed since review")
        old = self.data[endpoint(f"pulls/{PR}")]
        self.data[endpoint(f"pulls/{PR}")] = {"sequence": [old, {"pages": [pull(PR, self.base)]}]}
        self.assert_fails(self.stamp(self.reviewed, "--reviewed-base", self.base), "moved during approval")

    def test_mutations_are_caught_by_tree_fingerprint_and_trust_fixtures(self):
        good = self.approve()
        source = GATE.read_text()
        mutant = self.dir / "mutant"
        self.make_group()
        for record, before, after in (
            (status(description=good[:-43] + "A" * 43), "require(origin == Approval.calculate(",
             "require(True or origin == Approval.calculate("),
            (status(description=good, actor={"login": "RoySalisbury", "id": 999}),
             'require(self.is_authorized(latest["creator"]),', 'require(True,'),
        ):
            self.set_status(self.reviewed, [record])
            self.assert_fails(self.run_command(), CONTEXT)
            self.assertIn(before, source)
            mutant.write_text(source.replace(before, after, 1))
            mutant.chmod(0o700)
            self.assert_pass(self.run_command(gate=mutant))

        self.set_status(self.reviewed, [status(description=good)])
        tip = self.advance()
        self.switch(self.reviewed)
        self.merge(tip, options=("--no-commit",))
        self.write("extra", "evil merge\n")
        self.make_group(self.commit("unexpected tree"))
        self.assert_fails(self.run_command(), "differs from the clean merge")
        before = "require(self.tree(commit) == self.clean_merge(left, right),"
        self.assertIn(before, source)
        mutant.write_text(source.replace(before, "require(True,", 1))
        self.assert_pass(self.run_command(gate=mutant))


if __name__ == "__main__":
    unittest.main(verbosity=2)
