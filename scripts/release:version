#!/usr/bin/env bash
# The product version (install contract section 1, #1310): the VersionPrefix in Directory.Build.props, the one version
# every program and image carries.
#
#   scripts/release:version                    0.9.0, the version the next release carries
#   scripts/release:version --dev              0.9.0-dev, the version of a build given none
#   scripts/release:version --check <version>  succeeds when <version> is the product version or a pre-release of it,
#                                              such as 0.9.0, 0.9.0-rc.1 or 0.9.0-dev.3, and fails naming why otherwise
#   scripts/release:version --tag <tag>        the version a final release or release candidate tag names, checked:
#                                              v0.9.0 gives 0.9.0 and v0.9.0-rc.1 gives 0.9.0-rc.1; any other tag, or
#                                              one for another version, fails
#
# A release's builds are given its version as -p:Version (scripts/release:assets, and the CameraAgent image through
# HVO_VERSION). Directory.Build.targets refuses a build given a version that --check would refuse.
set -euo pipefail

usage() {
    sed -n '4,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
    exit 2
}

fail() {
    printf 'release:version: %s\n' "$*" >&2
    exit 1
}

props="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/Directory.Build.props"
[[ -f "$props" ]] || fail "$props was not found."
prefix="$(sed -n 's:^[[:space:]]*<VersionPrefix>\([^<]*\)</VersionPrefix>[[:space:]]*$:\1:p' "$props")"
[[ "$(grep -c '<VersionPrefix>' "$props")" == 1 && -n "$prefix" ]] ||
    fail "Directory.Build.props must hold exactly one VersionPrefix, on a line of its own."
[[ "$prefix" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] ||
    fail "the VersionPrefix '$prefix' is not a release version such as 0.9.0."

# A SemVer pre-release identifier: a number without a leading zero, or letters, digits and hyphens with a non-digit.
identifier='(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)'

case "${1:-}" in
    "")
        [[ $# -eq 0 ]] || usage
        printf '%s\n' "$prefix"
        ;;
    --dev)
        [[ $# -eq 1 ]] || usage
        printf '%s-dev\n' "$prefix"
        ;;
    --check)
        [[ $# -eq 2 ]] || usage
        version="$2"
        [[ "$version" =~ ^((0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))(-${identifier}(\.${identifier})*)?$ ]] ||
            fail "'$version' is not a release version such as $prefix, $prefix-rc.1 or $prefix-dev.1 (no build metadata)."
        [[ "${BASH_REMATCH[1]}" == "$prefix" ]] ||
            fail "'$version' is for ${BASH_REMATCH[1]}, but Directory.Build.props holds $prefix. Change the VersionPrefix first, in its own pull request."
        ;;
    --tag)
        [[ $# -eq 2 ]] || usage
        tag="$2"
        [[ "$tag" =~ ^v((0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))(-rc\.([1-9][0-9]*))?$ ]] ||
            fail "the tag '$tag' is not a release tag: use v$prefix for a release or v$prefix-rc.1 for a release candidate."
        [[ "${BASH_REMATCH[1]}" == "$prefix" ]] ||
            fail "the tag '$tag' is for ${BASH_REMATCH[1]}, but Directory.Build.props holds $prefix. Change the VersionPrefix first, in its own pull request."
        printf '%s\n' "${tag#v}"
        ;;
    *)
        usage
        ;;
esac
