#!/usr/bin/env bash
# Check active identity/security guidance for stale commands and source drift.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly REPO_ROOT
cd "$REPO_ROOT"

readonly DOCS=(
    README.md
    docs/identity/overview.md
    docs/identity/operations-runbook.md
    docs/security/secrets.md
    docs/runbooks/cameraagent-retention.md
    docs/runbooks/cameraagent-arm64-ci.md
    docs/runbooks/infra-operations.md
    docs/runbooks/local-dev.md
    docs/runbooks/smoke-test.md
    docs/runbooks/split-host-preflight.md
    docs/runbooks/ci-pipeline.md
    docs/runbooks/deployment-installer.md
    docs/runbooks/release-distribution.md
    docs/catalog/production-install.md
    docs/catalog/hyg-v42.md
    docs/planning/standalone-cameraagent-course-correction.md
    docs/validation/ci-reduced-mode.md
    docs/validation/issue-331-production-like-install-findings.md
    src/HVO.SkyMonitor.Astronomy/README.md
    src/HVO.SkyMonitor.LogicHost/README.md
)

for document in "${DOCS[@]}"; do
    if [[ ! -f "$document" || -L "$document" ]]; then
        printf 'Required operations document is missing or not a regular file: %s\n' "$document" >&2
        exit 1
    fi
done

forbidden_command='^[[:space:]]*(\$[[:space:]]+)?(pg_dump|psql|kubectl|az[[:space:]]+keyvault|redis-cli[^#]*(FLUSHDB|FLUSHALL)|docker[^#]*[[:space:]]env([[:space:]]|$))'
if grep -Eni "$forbidden_command" "${DOCS[@]}"; then
    printf 'Active operations guidance contains a prohibited command.\n' >&2
    exit 1
fi

if grep -En '/api/v1\.0/frame/' "${DOCS[@]}"; then
    printf 'Active operations guidance contains the obsolete singular frame route.\n' >&2
    exit 1
fi

if grep -En 'Historical and non-executable|quarantined historical' "${DOCS[@]}"; then
    printf 'Active identity guidance still describes the replacement runbook as quarantined.\n' >&2
    exit 1
fi

if grep -En 'MINIO_|mc admin|minio/minio' "${DOCS[@]}"; then
    printf 'Active operations guidance still provisions a MinIO server; LogicHost uses the filesystem object store.\n' >&2
    exit 1
fi

if grep -En 'build-hyg-v42|bundle-hyg-v42' docs/runbooks/split-host-preflight.md scripts/deploy/catalog.sh; then
    printf 'Split-host catalog deployment must install the approved bundle, not rebuild it.\n' >&2
    exit 1
fi

if grep -ERn --exclude-dir=bin --exclude-dir=obj --include='appsettings*.json' \
    '"(AdminPassword|ClientSecret|AccessKey|SecretKey|Key)"[[:space:]]*:[[:space:]]*"[^"[:space:]]+"' \
    src/HVO.SkyMonitor.CameraAgent src/HVO.SkyMonitor.LogicHost; then
    printf 'Application appsettings contains a usable committed credential.\n' >&2
    exit 1
fi

tracked_path_exists() {
    local path
    while IFS= read -r path; do
        [[ -e "$path" ]] && return 0
    done < <(git ls-files "$1")
    return 1
}

if tracked_path_exists ':(glob)**/DataProtection-Keys/**'; then
    printf 'Runtime Data Protection keys must not be tracked.\n' >&2
    exit 1
fi

if tracked_path_exists ':(glob)src/HVO.SkyMonitor.LogicHost/wwwroot/lib/bootstrap/**'; then
    printf 'The unused local Bootstrap vendor tree must not be tracked.\n' >&2
    exit 1
fi

if grep -En 'schema-v6 split-host|schema v6 split-host|Production source currently has no certificate loader|Production has no repository-supported certificate' \
    docs/identity/overview.md docs/identity/operations-runbook.md docs/security/secrets.md docs/runbooks/infra-operations.md; then
    printf 'Active operations guidance contains a superseded capability or deployment schema.\n' >&2
    exit 1
fi

if git grep --untracked -En 'test:phase14-(campaign|normal-campaign)|test:cameraagent-(dual-197|standalone-171|ui-106)|test:logichost-ui-107|deploy/acceptance/issue-197|logichost-ui-107-runtime-signals' \
    -- . ':(exclude)scripts/docs:audit-operations'; then
    printf 'A generalized interface still uses an obsolete issue or milestone name.\n' >&2
    exit 1
fi

require_source_reference() {
    local value="$1"
    local source_file="$2"
    if ! grep -Fq -- "$value" "$source_file"; then
        printf 'Documented value %s is missing from %s.\n' "$value" "$source_file" >&2
        exit 1
    fi
}

# Match a Markdown table row inside the runbook's Required Checks section only,
# anchored at the start of the line, so prose elsewhere cannot satisfy the pin.
require_required_check_row() {
    local check="$1"
    local value="$2"
    local section
    # The pins are matched only inside the contiguous table under exactly one
    # "## Required Checks" heading (a longer heading is a different section and a
    # duplicate heading is an error), with HTML comments removed and fenced code
    # blocks skipped, so a commented-out, quoted, or stray copy of an old row
    # cannot satisfy them.
    if ! section="$(awk '
        function fail(message) {
            print message > "/dev/stderr"
            failed = 1
            exit 1
        }
        # Remove HTML comments from a line, carrying comment state across lines,
        # so neither a heading nor a row inside a comment is ever visible.
        function strip_html_comments(line,    open_at, close_at, rest) {
            while (1) {
                if (in_comment) {
                    close_at = index(line, "-->")
                    if (close_at == 0) {
                        return ""
                    }
                    line = substr(line, close_at + 3)
                    in_comment = 0
                }
                open_at = index(line, "<!--")
                if (open_at == 0) {
                    return line
                }
                rest = substr(line, open_at + 4)
                close_at = index(rest, "-->")
                if (close_at == 0) {
                    in_comment = 1
                    return substr(line, 1, open_at - 1)
                }
                line = substr(line, 1, open_at - 1) substr(rest, close_at + 3)
            }
        }
        # A fenced code block opens with three or more backticks or tildes (mawk
        # cannot compile an interval before a group, so any indentation is accepted) and
        # closes only with the same character, at least as many of them, and
        # nothing else on the line; any other fence-looking line is content.
        function fence_marker(line,    marker) {
            if (line !~ /^ *(```+|~~~+)/) {
                return ""
            }
            marker = line
            sub(/^ */, "", marker)
            # The delimiter is the initial run of the opener character only; an
            # info string may begin with the other marker.
            if (substr(marker, 1, 1) == "`") {
                sub(/[^`].*$/, "", marker)
            } else {
                sub(/[^~].*$/, "", marker)
            }
            return marker
        }
        {
            # Fenced content is inert: while fenced, the raw line is inspected only
            # for a closing delimiter made solely of the opener character, at least
            # as long as the opener, and never for HTML comments.
            if (in_fence) {
                marker = fence_marker($0)
                if (marker != "" && substr(marker, 1, 1) == fence_char && length(marker) >= fence_length &&
                    ((fence_char == "`" && $0 ~ /^ *`+[[:space:]]*$/) || (fence_char == "~" && $0 ~ /^ *~+[[:space:]]*$/))) {
                    in_fence = 0
                }
                next
            }
            # A fence opener is recognized on the raw line before any HTML-comment
            # processing (its info string may begin with "<!--"), unless the line
            # is already inside a multi-line HTML comment.
            if (!in_comment) {
                marker = fence_marker($0)
                if (marker != "") {
                    in_fence = 1
                    fence_char = substr(marker, 1, 1)
                    fence_length = length(marker)
                    next
                }
            }
            line = strip_html_comments($0)
            if (line ~ /^##[[:space:]]+Required Checks[[:space:]]*$/) {
                headings++
                in_section = 1
                count = 0
                next
            }
            if (line ~ /^##([[:space:]]|$)/) {
                in_section = 0
            }
            if (in_section) {
                section[++count] = line
            }
        }
        END {
            if (failed) {
                exit 1
            }
            if (in_comment) {
                fail("unterminated HTML comment in docs/runbooks/ci-pipeline.md")
            }
            if (in_fence) {
                fail("unterminated fenced code block in docs/runbooks/ci-pipeline.md")
            }
            if (headings != 1) {
                fail("expected exactly one \"## Required Checks\" heading in docs/runbooks/ci-pipeline.md, found " headings + 0)
            }
            # The pins apply only to the canonical Required Checks table: the
            # contiguous table whose header row normalizes to "| Check | Enforced
            # behavior |" and whose delimiter row has one cell of three or more
            # hyphens per column.
            # Any other table or row-shaped line in the section is prose.
            # The whole section is scanned first: exactly one canonical table may
            # exist, and it is emitted only once its uniqueness is known, so a
            # second valid table can never shadow or precede the real one.
            tables = 0
            for (i = 1; i < count; i++) {
                header = section[i]
                gsub(/[[:space:]]+/, " ", header)
                sub(/^ /, "", header)
                sub(/ $/, "", header)
                if (header != "| Check | Enforced behavior |") {
                    continue
                }
                # GFM requires at least three hyphens per delimiter cell; a header
                # row without a valid delimiter is ordinary text, so keep looking.
                if (section[i + 1] !~ /^\|[[:space:]]*:?---+:?[[:space:]]*\|[[:space:]]*:?---+:?[[:space:]]*\|[[:space:]]*$/) {
                    continue
                }
                tables++
                table_start = i
            }
            if (tables != 1) {
                fail("expected exactly one canonical \"| Check | Enforced behavior |\" table under the \"## Required Checks\" heading in docs/runbooks/ci-pipeline.md, found " tables + 0)
            }
            for (j = table_start; j <= count && section[j] ~ /^\|/; j++) {
                print section[j]
            }
        }' docs/runbooks/ci-pipeline.md)"; then
        printf 'Could not isolate the Required Checks section of docs/runbooks/ci-pipeline.md.\n' >&2
        exit 1
    fi
    # The pin must be a complete active table row: the check cell, the value cell
    # beginning with the expected text, and the row's closing pipe.
    if ! grep -Eq -- "^\\| ${check} \\| ${value}[^|]*\\|[[:space:]]*$" <<< "$section"; then
        printf 'Required Checks row %s in docs/runbooks/ci-pipeline.md is not a complete table row beginning with %s.\n' "$check" "$value" >&2
        exit 1
    fi
}

coverage_line="$(jq -er '.aggregate.line * 100' scripts/coverage/baseline.json)"
coverage_branch="$(jq -er '.aggregate.branch * 100' scripts/coverage/baseline.json)"
LC_ALL=C printf -v coverage_line_percent '%.4f' "$coverage_line"
LC_ALL=C printf -v coverage_branch_percent '%.4f' "$coverage_branch"
coverage_report_count="$(awk '
    /name: Enforce exact-path coverage baseline/ { in_step = 1 }
    in_step && /patterns=\(/ { in_patterns = 1; next }
    in_patterns && /^[[:space:]]*\)/ { print count; exit }
    in_patterns && /coverage\.cobertura\.xml/ { count++ }
' .github/workflows/ci.yml)"
if [[ ! "$coverage_report_count" =~ ^[1-9][0-9]*$ ]]; then
    printf 'Could not derive the explicit coverage report count from .github/workflows/ci.yml.\n' >&2
    exit 1
fi

# The runbook's category totals are derived from the per-project category
# inventories rather than pinned as literals, so editing an inventory without the
# runbook fails here. Each test project owns tests/<project>/test-categories.json
# (#853): a flat JSON object with exactly the six known categories, each a
# non-negative integer. The audit engine validates the same shape against real
# discovery; this reads the same files so the two totals cannot disagree.
architecture_project=tests/HVO.SkyMonitor.Architecture.Tests/HVO.SkyMonitor.Architecture.Tests.csproj
architecture_inventory="$(dirname "$architecture_project")/test-categories.json"
category_rows=0
category_unit=0; category_integration=0; category_manual=0; category_soak=0; category_external=0; category_hardware=0
architecture_unit=0; architecture_integration=0
while IFS= read -r inventory; do
    [[ -n "$inventory" ]] || continue
    if ! jq --exit-status '
        type == "object"
        and (keys | sort) == ["External", "Hardware", "Integration", "Manual", "Soak", "Unit"]
        and all(.[]; type == "number" and . == floor and . >= 0)' "$inventory" > /dev/null 2>&1; then
        printf 'Malformed category inventory: %s\n' "$inventory" >&2
        exit 1
    fi
    # jq collapses a duplicated key to its last value at parse time, so neither
    # `keys` nor `tostream` can see the duplicate the audit engine rejects. Only
    # the parser-level `--stream` mode emits one leaf event per key occurrence in
    # the source text, so counting those against the six distinct keys catches it.
    if [[ "$(jq --stream -c 'select(length == 2) | .[0][0]' "$inventory" | wc -l)" -ne 6 ]]; then
        printf 'Duplicate category key in inventory: %s\n' "$inventory" >&2
        exit 1
    fi
    if ! ls "$(dirname "$inventory")"/*.csproj > /dev/null 2>&1; then
        printf 'Category inventory has no test project beside it: %s\n' "$inventory" >&2
        exit 1
    fi
    read -r unit integration manual soak external hardware < <(jq -r '[.Unit, .Integration, .Manual, .Soak, .External, .Hardware] | @sh' "$inventory" | tr -d "'")
    category_rows=$((category_rows + 1))
    category_unit=$((category_unit + unit)); category_integration=$((category_integration + integration))
    category_manual=$((category_manual + manual)); category_soak=$((category_soak + soak))
    category_external=$((category_external + external)); category_hardware=$((category_hardware + hardware))
    if [[ "$inventory" == "$architecture_inventory" ]]; then
        architecture_unit=$unit; architecture_integration=$integration; architecture_seen=1
    fi
done < <(find tests -name test-categories.json -not -path '*/bin/*' -not -path '*/obj/*' | sort)
# A missing project would otherwise hand the architecture assertions an empty
# expected value, which every document trivially contains.
if [[ -z "${architecture_seen:-}" ]]; then
    printf 'No category inventory was found for %s.\n' "$architecture_project" >&2
    exit 1
fi
# Every test project must own an inventory; a project added without one would
# otherwise drop out of the runbook totals silently.
while IFS= read -r csproj; do
    [[ "$csproj" != */HVO.SkyMonitor.LogicHost.TestInfrastructure.csproj ]] || continue
    if [[ ! -f "$(dirname "$csproj")/test-categories.json" ]]; then
        printf 'Test project is missing its category inventory: %s\n' "$csproj" >&2
        exit 1
    fi
done < <(find tests -name '*.csproj' -not -path '*/bin/*' -not -path '*/obj/*' | sort)
category_totals="$category_rows $category_unit $category_integration $category_manual $category_soak $category_external $category_hardware $architecture_unit $architecture_integration"
read -r category_rows category_unit category_integration category_manual category_soak category_external category_hardware architecture_unit architecture_integration <<< "$category_totals"
if [[ ! "$category_rows" =~ ^[1-9][0-9]*$ || ! "$category_unit" =~ ^[1-9][0-9]*$ || ! "$category_integration" =~ ^[1-9][0-9]*$ ||
      ! "$architecture_unit" =~ ^[1-9][0-9]*$ || ! "$architecture_integration" =~ ^[1-9][0-9]*$ ]]; then
    printf 'Derived implausible test category totals from the category inventories: %s\n' "$category_totals" >&2
    exit 1
fi

require_source_reference '[HttpGet("detailed")]' src/HVO.SkyMonitor.LogicHost/Controllers/StatusController.cs
require_source_reference '[HttpGet("protected")]' src/HVO.SkyMonitor.LogicHost/Controllers/StatusController.cs
require_source_reference '/connect/token' src/HVO.SkyMonitor.LogicHost/Program.cs
require_source_reference 'X-API-Key' src/HVO.SkyMonitor.Common/Security/ApiKeyAuthenticationOptions.cs
require_source_reference 'Redis__InstanceName: "skymonitor:"' docker-compose.apps.yml
require_source_reference 'skymonitor-diagnostics' src/HVO.SkyMonitor.LogicHost/Configuration/CentralObjectStorageOptions.cs
require_source_reference 'skymonitor-artifacts' src/HVO.SkyMonitor.LogicHost/Configuration/CentralObjectStorageOptions.cs
require_source_reference 'DeviceProvisioning__StateDirectory: /app/data/provisioning' docker-compose.apps.yml
require_source_reference 'DeviceBootstrap__CentralIdentity__ClientCredentials__ClientSecret' docker-compose.apps.yml
require_source_reference 'OpenIddictCertificateOptions.SectionName' src/HVO.SkyMonitor.LogicHost/Program.cs
require_source_reference 'options.AddSigningCertificate(signing).AddEncryptionCertificate(encryption);' src/HVO.SkyMonitor.LogicHost/Program.cs
require_source_reference '"api.artifacts.read"' src/HVO.SkyMonitor.LogicHost/Program.cs
require_source_reference '"api.owner.write"' src/HVO.SkyMonitor.LogicHost/Program.cs
require_source_reference 'ArtifactManifestV2.CurrentSchemaVersion' src/HVO.SkyMonitor.LogicHost/Services/ArtifactIngestService.cs
require_required_check_row '\*\*Unit Tests\*\*' "${category_unit} Unit cases"
require_required_check_row '\*\*Integration Tests\*\*' "${category_integration} Integration-category cases"
require_source_reference "Current discovery is \`Unit=${category_unit}\`, \`Integration=${category_integration}\`, \`Manual=${category_manual}\`, \`Soak=${category_soak}\`, \`External=${category_external}\`, and \`Hardware=${category_hardware}\`." docs/runbooks/ci-pipeline.md
# Both halves of the architecture sentence are the architecture project's own
# category discovery totals, so both are derived here. Pinned as the English word
# "seven", the first of these asserted that the document said seven and never that
# seven was correct: it passed while the real count moved to 15, and it would have
# failed on the edit that corrected it. Membership is stated in the runbook itself
# so the number is checkable by something other than this line.
require_source_reference "${architecture_unit} Unit-category boundary cases" docs/runbooks/ci-pipeline.md
require_source_reference "${architecture_integration} Integration-category repository graph" docs/runbooks/ci-pipeline.md
# The Integration Tests row states the same quantity one line above the Architecture &
# Publish row, and it was still spelled "seven". Deriving only the second would have left
# the first to go stale on the next count change -- #784 reappearing in the document #784
# was about, one row away from its own fix.
require_source_reference "the ${architecture_integration} repository graph/provider-boundary/publish cases in Architecture & Publish" docs/runbooks/ci-pipeline.md
require_source_reference "merge of $coverage_report_count expected reports" docs/runbooks/ci-pipeline.md
require_source_reference "report count other than the expected $coverage_report_count" docs/runbooks/ci-pipeline.md
require_source_reference "each of the $coverage_report_count category/project slots" docs/runbooks/ci-pipeline.md
require_source_reference "Merge those $coverage_report_count explicit reports" docs/runbooks/ci-pipeline.md
require_source_reference "The Coverlet 10.0.1 baseline is $coverage_line_percent% line and $coverage_branch_percent% branch coverage." docs/runbooks/ci-pipeline.md
require_source_reference "aggregate baseline is $coverage_line_percent percent line and $coverage_branch_percent percent branch" docs/planning/performance-validation.md
require_source_reference "CI collects $coverage_report_count explicit" docs/planning/performance-validation.md
require_source_reference 'public string? AccessKey' src/HVO.SkyMonitor.LogicHost/Configuration/CentralObjectStorageOptions.cs
require_source_reference 'public string? SecretKey' src/HVO.SkyMonitor.LogicHost/Configuration/CentralObjectStorageOptions.cs
# shellcheck disable=SC2016 # Backticks are literal Markdown.
require_source_reference 'canonical builder for package `hyg-v4.2-p3-s2-r1` is Ubuntu 24.04 on' docs/catalog/production-install.md
require_source_reference 'ARM64 operators must install the' docs/catalog/production-install.md
require_source_reference 'It never copies or executes the catalog builder remotely.' docs/runbooks/split-host-preflight.md
require_source_reference 'Two consecutive' docs/runbooks/split-host-preflight.md
require_source_reference 'final reassertion' docs/runbooks/split-host-preflight.md
require_source_reference 'There is no generic privilege escalation path.' docs/runbooks/split-host-preflight.md
require_source_reference 'including a same-device bind' docs/runbooks/split-host-preflight.md
require_source_reference 'It removes neither marker nor root.' docs/runbooks/split-host-preflight.md
require_source_reference '--pull never' docs/runbooks/split-host-preflight.md
require_source_reference 'does not claim inode binding' docs/runbooks/split-host-preflight.md
require_source_reference 'POSIX/BusyBox-compatible syntax' docs/runbooks/split-host-preflight.md
require_source_reference 'inventory-label-drift-retained' docs/runbooks/split-host-preflight.md
require_source_reference 'never uses a' docs/runbooks/split-host-preflight.md
require_source_reference 'wildcard.' docs/runbooks/split-host-preflight.md
require_source_reference 'no intent permits partial absence' docs/runbooks/split-host-preflight.md
require_source_reference 'deploy_capture_queues_converged' scripts/deploy/common.sh
require_source_reference './scripts/test:deploy-environment --parallel' docs/runbooks/ci-pipeline.md
require_source_reference 'name: Catalog Contracts' .github/workflows/ci.yml
require_source_reference 'name: Deployment Contracts' .github/workflows/ci.yml
# shellcheck disable=SC2016 # GitHub expression syntax is intentionally literal.
require_source_reference 'deployment: ${{ steps.classify.outputs.deployment }}' .github/workflows/ci.yml
require_source_reference 'is_deployment_path()' scripts/ci:classify
# shellcheck disable=SC2016 # The deployment source must retain this literal shell expression.
require_source_reference 'deploy_transport_copy "$bundle/$file"' scripts/deploy/catalog.sh
require_source_reference 'deploy_transport_catalog_install' scripts/deploy/catalog.sh
require_source_reference '<harness>:<provider>:<host>:<session-short-id>' AGENTS.md
require_source_reference 'UNREGISTERED/WAIT' AGENTS.md
require_source_reference 'JOIN REQUEST' docs/planning/agent-execution.md
require_source_reference 'JOIN ACK <ack-id>' docs/planning/agent-execution.md
require_source_reference 'JOINED ACK <ack-id>' docs/planning/agent-execution.md
require_source_reference 'targetParticipantId' docs/planning/agent-execution.md
require_source_reference 'scripts/coordination:guard' docs/planning/agent-execution.md
require_source_reference 'scripts/pr:review-request' .agents/skills/pr-lifecycle/SKILL.md
require_source_reference 'scripts/pr:dispatch-review' .agents/skills/pr-lifecycle/SKILL.md

for document in "${DOCS[@]}"; do
    while IFS= read -r target; do
        case "$target" in
            ''|'#'*|http://*|https://*|mailto:*) continue ;;
        esac
        target="${target%%#*}"
        if [[ ! -e "$(dirname "$document")/$target" ]]; then
            printf 'Broken relative link in %s: %s\n' "$document" "$target" >&2
            exit 1
        fi
    done < <(perl -ne 'while (/\]\(([^)]+)\)/g) { print "$1\n" }' "$document")
done

printf 'Identity and security operations documentation audit passed.\n'
