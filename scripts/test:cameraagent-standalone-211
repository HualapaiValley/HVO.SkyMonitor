printf '%s\n' "$bind_probe" > "$(dirname "$BIND_LOCAL_ROOT")/.issue-211-bind-probe"
if ! docker run --rm --entrypoint /bin/sh \
    --mount "type=bind,source=$(dirname "$BIND_HOST_ROOT"),target=/probe,readonly" \
    "$CENTRAL_DENY_IMAGE" -c 'test "$(cat /probe/.issue-211-bind-probe)" = "$1"' -- "$bind_probe" 8>&-; then
    rm -f -- "$(dirname "$BIND_LOCAL_ROOT")/.issue-211-bind-probe"
    printf 'Docker daemon bind-root round-trip failed.\n' >&2
    exit 2
fi
rm -f -- "$(dirname "$BIND_LOCAL_ROOT")/.issue-211-bind-probe"

image_iid_file="$RESULTS/cameraagent-image-id"
assert_worktree_unchanged
