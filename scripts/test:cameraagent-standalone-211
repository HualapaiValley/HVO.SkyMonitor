# Issue #770, correction round 3. The original six central-traffic documents were counted and never
# identified, so replacing trial 2's document with a copy of trial 1's left the count unchanged and
# every gate passing while the summary printed trial 1 twice in its own output. The labels the
# campaign actually ran are built here, outside any document, and the documents must name exactly
# that set.
EXPECTED_W6_TRIALS="$(jq -nc --argjson trialCount "$TRIAL_COUNT" \
    '[range(1; $trialCount + 1) | "trial-\(.)"]')"
readonly EXPECTED_W6_TRIALS
EXPECTED_CENTRAL_TRAFFIC_TRIALS="$(jq -nc --argjson expectedW6Trials "$EXPECTED_W6_TRIALS" \
    '["mono8-control", "replay-inprocess", "replay-localrunner"] + $expectedW6Trials')"
readonly EXPECTED_CENTRAL_TRAFFIC_TRIALS

# Issue #770. `add` over a list of nulls is null and `// 0` turned that into a clean zero, so a
# counter that was never recorded and a counter that was genuinely zero produced the same summary.
# Each counter is now required to be a number, and the input count is recorded, because `add` and
# `all` over an empty list also score as a perfect run when the glob matches nothing.
#
# Issue #770, correction round 2. Requiring a number is not the same as requiring a valid
# measurement. Corrupt one trial to a finalDenyHits of 1 and another to -1 and the sum is zero
# again, so a type check alone lets two corrupted trials cancel each other out and every gate
# below passes. An event count is a non-negative whole number, and that is now the requirement.
# `passed` is recomputed here from the five counters the trial derived it from, rather than read
# back as a flag that a corrupted document keeps after its counters have stopped supporting it.
jq -s -f "$CENTRAL_TRAFFIC_SUMMARY_PROGRAM" \
    --argjson expectedTrials "$EXPECTED_CENTRAL_TRAFFIC_TRIALS" \
    "$RESULTS"/*/evidence/central-traffic-gate.json > "$RESULTS/final-central-traffic-summary.json"

# Issue #770, correction round 3. The aggregate above established that a recorded flag disagreed
# with its own counters, wrote the disagreement into the summary, and passed anyway, because
# nothing read the field. A fail-open with a witness is worse than not having looked, since the
# document then carries a false assurance that the disagreement was weighed. It is read here, at
# the point of production, together with the trial identity the same aggregate now records.
jq --exit-status '.trialsIdentified == true and .trialKindsMatchLabels == true and
    .recordedFlagsAgreeWithCounters == true and .allPassed == true' \
    "$RESULTS/final-central-traffic-summary.json" >/dev/null \
    || gate_failed 'final central-traffic aggregate' "$RESULTS/final-central-traffic-summary.json"

# Issue #770. The W6 evidence document has to carry the identities the run measured, not only
# the constants it was checked against, and this gate refuses a document that omits them. It is
# written as a positive requirement: every field named here must be present and well formed, so a
# missing field fails the run rather than scoring as clean. The comparison between the declared
# and the recomputed digest is re-derived here from the record itself, which is the property that
# lets a later reader stop trusting the runner.
#
# Issue #770, correction round 4. The program itself now lives in scripts/issue-211-w6-identity.jq
# rather than in a string here, so the same standard can be run on its own over a directory of
# finished documents without rerunning a two-hour campaign. Every standard it checks against is
# passed in on this command line, which is the point: a gate that reads its standard out of the
# documents under test cannot reject a document that misstates it.
jq -s -f "$W6_IDENTITY_PROGRAM" \
    --arg expectedSchemaVersion 'issue-211-w6-evidence-v3' \
    --argjson measuredCaptureCount "$MEASURED_CAPTURE_COUNT" \
    --argjson expectedTrialLabels "$EXPECTED_W6_TRIALS" \
    --argjson expectedCaptureRoles "$EXPECTED_CAPTURE_ARTIFACT_ROLES" \
    --argjson expectedCaptureArtifactRoleCounts "$EXPECTED_CAPTURE_ARTIFACT_ROLE_COUNTS" \
    "$RESULTS"/trial-*/evidence/issue-211-w6.json > "$RESULTS/w6-identity-summary.json"

jq --exit-status -f "$W6_IDENTITY_GATE_PROGRAM" \
    --argjson measuredCaptureCount "$MEASURED_CAPTURE_COUNT" \
    --argjson expectedTrialLabels "$EXPECTED_W6_TRIALS" \
    --argjson expectedCaptureRoles "$EXPECTED_CAPTURE_ARTIFACT_ROLES" \
    --argjson expectedCaptureArtifactRoleCounts "$EXPECTED_CAPTURE_ARTIFACT_ROLE_COUNTS" \
    "$RESULTS/w6-identity-summary.json" >/dev/null \
    || gate_failed 'W6 evidence identity' "$RESULTS/w6-identity-summary.json"

jq -s \
    --arg fingerprint "$WORKTREE_FINGERPRINT" \
    --argjson declaredBoundedTrialFootprintBytes "$DECLARED_BOUNDED_TRIAL_FOOTPRINT_BYTES" \
    --slurpfile finalCentralTraffic "$RESULTS/final-central-traffic-summary.json" '
  def percent_change($baseline; $candidate): (($candidate / $baseline) - 1) * 100;
  # Issue #770. `sort` puts null below every number, so a five-sample list with one absent
  # field still has a number at the median index: sampleCount still reports 5 while the median
  # shifts one rank toward the low end, and nothing in the run ever says a sample was missing.
  # On the four normalized ratios below that shift is optimistic in the candidate direction, so
  # every sample must now be a number for a summary to be produced at all.
  # Issue #770, correction round 3. `all` over an empty list is vacuously true, so on an empty
  # sample list the guard added to name a bad field said nothing at all; the run still failed,
  # but only because the median arithmetic went on to divide null, and the message named no
  # field. Emptiness is refused first so the failure names the series it came from.
  def stats($what):
    (if (type == "array") and (length > 0) then . else
      error("\($what) has no samples, so its summary would have been computed over an empty list") end)
    | (if all(type == "number") then . else
      error("\($what) has a sample that is not a number, so its median would have been taken over an absent measurement") end)
    | sort as $values |
    {
      sampleCount: ($values | length),
      minimum: $values[0],
      median: (if ($values | length) % 2 == 0 then
        (($values[(($values | length) / 2 - 1)] + $values[(($values | length) / 2)]) / 2)
      else $values[(($values | length) / 2 | floor)] end),
      p95: (if ($values | length) >= 30 then $values[((($values | length) * 0.95 | ceil) - 1)] else null end),
      maximum: $values[-1]
    };
  # Issue #770. Every one of these was `add // 0`, which cannot distinguish an absent counter
  # from a zero one, and an empty input list summed to a clean zero as well. Each counter must
  # now be a number and each list must be non-empty for the run to produce a summary at all.
  def require_number($field): if type == "number" then . else
    error("an issue-211-w6.json has no numeric \($field)") end;
  # Issue #770, correction round 2. Event counts and byte totals are non-negative whole numbers.
  # A type check alone admits a negative or fractional value, which is well typed and impossible,
  # and lets two corrupted trials cancel to a clean aggregate.
  def is_byte_count: (type == "number") and (isnan | not) and (isinfinite | not)
    and (. >= 0) and (. == floor);
  def require_count($field): if is_byte_count then . else
    error("an issue-211-w6.json has \($field) = \(tojson), which is not a non-negative whole count") end;
  def require_present($what): if (type == "array" and length > 0) then . else
    error("\($what) is empty, so this summary would have been computed over no measurements") end;
  def is_nonnegative_number: (type == "number") and (isnan | not) and (isinfinite | not) and (. >= 0);
  # Issue #770, correction round 3. The durable-queue maxima took a maximum over values nothing
  # had checked, and the gate below then read the producer boolean back instead of
  # comparing those maxima to a bound. Empty every maxima list and the run reached ready; set a
  # count to minus five with bytes at a trillion and it reached ready. That is precisely the
  # read-the-flag-back pattern this pull request abandoned in the central-traffic aggregate, two
  # fields away in the same document. The bound is now taken from the bounds the trials declare,
  # every trial must declare the same ones, and the recomputation must cover exactly the queues
  # those bounds name — so shrinking the maxima list, or fitting the bounds in one document to
  # the maxima in that same document, is a disagreement rather than a pass.
  def require_queue_count($queue; $field): if is_byte_count then . else
    error("durable queue \($queue) has \($field) = \(tojson), which is not a non-negative whole count") end;
  def require_queue_number($queue; $field): if is_nonnegative_number then . else
    error("durable queue \($queue) has \($field) = \(tojson), which is not a non-negative finite measurement") end;
  (length) as $trial_count |
  ([ .[].performance.declaredDurableQueueBounds ] | unique) as $declared_queue_bound_sets |
  ($declared_queue_bound_sets | first) as $declared_queue_bounds |
  ([ .[].performance.maximumDurableQueues[]? ] | group_by(.name) | map(
    (.[0].name) as $queue |
    ($declared_queue_bounds[$queue]? // null) as $bound |
    {
      name: $queue,
      sampleCount: length,
      count: (map(.count | require_queue_count($queue; "count")) | max),
      bytes: (map(.bytes | require_queue_count($queue; "bytes")) | max),
      ageSeconds: (map(.ageSeconds | require_queue_number($queue; "ageSeconds")) | max),
      declaredCount: ($bound.count? // null),
      declaredBytes: ($bound.bytes? // null),
      declaredAgeSeconds: ($bound.ageSeconds? // null)
    }
    | . as $observed
    | $observed + {
        withinDeclaredBound: (
          ($bound | type) == "object"
          and ($bound.count | is_byte_count) and ($bound.bytes | is_byte_count)
          and ($bound.ageSeconds | is_nonnegative_number)
          and ($observed.count <= $bound.count)
          and ($observed.bytes <= $bound.bytes)
          and ($observed.ageSeconds <= $bound.ageSeconds))
      })) as $durable_queue_maxima |
  (($declared_queue_bound_sets | length) == 1
    and ($declared_queue_bounds | type) == "object"
    and ($declared_queue_bounds | length) > 0
    and ($durable_queue_maxima | length) > 0
    and (($durable_queue_maxima | map(.name) | sort) == ($declared_queue_bounds | keys))
    and ($durable_queue_maxima | all(.sampleCount == $trial_count))
    and ($durable_queue_maxima | all(.withinDeclaredBound)))
    as $durable_queues_within_bounds |
  # Issue #770, correction round 4. This compared the recorded boolean against the recomputation
  # above and called the comparison an agreement check. It never was one. The producer wrote the
  # literal true, so there was no recorded value that could differ, and now that the producer
  # computes the boolean it does so from the same maxima and bounds this document carries, so the
  # two still cannot disagree. The recomputation is the check. The recorded flag is required to be
  # true, which refuses a document whose own producer reports its queues out of bounds, and that
  # is the whole of what it can honestly be asked to decide.
  (all(.performance.durableQueuesWithinDeclaredBounds == true))
    as $durable_queues_recorded_within_bounds |
  ($finalCentralTraffic[0].trials | require_present("the final central-traffic gate list"))
    as $final_central_traffic |
  (require_present("the five-trial evidence list")
    | map(.centralTrafficAttempts | require_count("centralTrafficAttempts")) | add)
    as $central_traffic_attempts |
  ($final_central_traffic | map(.finalDenyHits | require_count("finalDenyHits")) | add)
    as $final_deny_hits |
  ($final_central_traffic
    | map(.finalCentralHandlerAttempts | require_count("finalCentralHandlerAttempts")) | add)
    as $central_handler_attempts |
  # Issue #770, correction round 3. Requiring a value to be a number is not requiring it to be a
  # measurement. Rewrite three of five allocatedBytes samples to minus one and the median goes
  # negative, the normalized percent change goes to roughly minus one hundred, and the
  # fifteen-percent regression guard admits a corpus that carries a real regression.
  #
  # The guard belongs on these four series and on no others. cadenceHeadroomMilliseconds is a
  # cadence interval minus an end-to-end duration and is legitimately negative on any overrun,
  # and rawStorageGrowthBytes, derivativeStorageGrowthBytes and sqliteFootprintGrowthBytes are
  # after-minus-before subtractions that go negative whenever retention prunes. A blanket
  # non-negativity guard on `stats` would have traded this fail-open for a fail-closed on all
  # four of those. Each of the four is summarized once here, so the guarded value is also the
  # value the comparison block prints rather than a second computation that could drift from it.
  # Issue #770, correction round 4. The backlog maxima reached this summary through the bare
  # statistics helper, so a trial reporting a backlog depth of minus five printed a minimum of
  # minus five under the same schema as the guarded values, with nothing saying it had not been
  # checked. They are event counts and byte totals, unlike the cadence headroom and the storage
  # deltas, which are excluded from this guard because they are legitimately negative.
  #
  # Issue #770, correction round 5. That paragraph named an excluded list and left five byte
  # totals in neither list, so it read as though everything unexcluded was covered when
  # peakContainerMemoryUsageBytes, maximumObservedLastCollectionLohBytes, processReadBytes,
  # containerBlockReadBytes and containerBlockWriteBytes were not. They are peaks and cumulative
  # totals rather than differences, so they are non-negative for the same reason the backlog
  # figures are, and they now go through the same guard. This closed a false comment and not a
  # fail-open: none of them is read by any gate, each name appears once in this file, and a
  # negative value in any of them changed no decision. The remaining unguarded series are the
  # cadence headroom and the three storage deltas, and the reason is the one given above.
  def counted_stats($what):
    (if all(is_byte_count) then . else
      error("\($what) has a sample that is not a non-negative whole count, so its summary would have reported an impossible backlog") end)
    | stats($what);
  def measured_stats($what):
    (if all((type == "number") and (isnan | not) and (isinfinite | not) and (. >= 0)) then . else
      error("\($what) has a sample that is not a non-negative finite measurement, so the normalized regression comparison would have rested on an impossible value") end)
    | stats($what);
  (map(.performance.cpuSeconds) | measured_stats("cpuSeconds")) as $cpu_seconds |
  (map(.performance.allocatedBytes) | measured_stats("allocatedBytes")) as $allocated_bytes |
  (map(.performance.peakRssBytes) | measured_stats("peakRssBytes")) as $peak_rss_bytes |
  (map(.performance.processWriteBytes) | measured_stats("processWriteBytes")) as $process_write_bytes |
  ([
    percent_change(
      (37.973 / (14 * 4708352 / 1073741824));
      ($cpu_seconds.median / (10 * 25233408 / 1073741824))),
    percent_change(
      (13320000000 / (14 * 4708352));
      ($allocated_bytes.median / (10 * 25233408))),
    percent_change(
      (1101000000 / 4708352);
      ($peak_rss_bytes.median / 25233408)),
    percent_change(
      (2703000000 / (14 * 4708352));
      ($process_write_bytes.median / (10 * 25233408)))
  ]) as $normalized_percent_changes |
  {
    schemaVersion: "issue-211-w6-summary-v1",
    worktreeFingerprint: $fingerprint,
    trialCount: length,
    declaredBoundedTrialFootprintBytes: $declaredBoundedTrialFootprintBytes,
    elapsedMilliseconds: (map(.performance.elapsedMilliseconds) | stats("elapsedMilliseconds")),
    cpuSeconds: $cpu_seconds,
    peakRssBytes: $peak_rss_bytes,
    allocatedBytes: $allocated_bytes,
    peakContainerMemoryUsageBytes: (map(.performance.peakContainerMemoryUsageBytes) | counted_stats("peakContainerMemoryUsageBytes")),
    maximumObservedLastCollectionLohBytes:
      (map(.performance.maximumObservedLastCollectionLohBytes) | counted_stats("maximumObservedLastCollectionLohBytes")),
    operationalCaptureRatePerSecond: (map(.performance.operationalCaptureRatePerSecond) | stats("operationalCaptureRatePerSecond")),
    rawStorageGrowthBytes: (map(.performance.rawStorageGrowthBytes) | stats("rawStorageGrowthBytes")),
    declaredRawBytesPerDay: (map(.performance.declaredRawBytesPerDay) | stats("declaredRawBytesPerDay")),
    hypotheticalFiveSecondStartIntervalRawBytesPerDay:
      (map(.performance.hypotheticalFiveSecondStartIntervalRawBytesPerDay) | stats("hypotheticalFiveSecondStartIntervalRawBytesPerDay")),
    derivativeStorageGrowthBytes: (map(.performance.derivativeStorageGrowthBytes) | stats("derivativeStorageGrowthBytes")),
    sqliteFootprintGrowthBytes: (map(.performance.sqliteFootprintGrowthBytes) | stats("sqliteFootprintGrowthBytes")),
    processReadBytes: (map(.performance.processReadBytes) | counted_stats("processReadBytes")),
    processWriteBytes: $process_write_bytes,
    containerBlockReadBytes: (map(.performance.containerBlockReadBytes) | counted_stats("containerBlockReadBytes")),
    containerBlockWriteBytes: (map(.performance.containerBlockWriteBytes) | counted_stats("containerBlockWriteBytes")),
    maximumBacklogCount:
      (map(.performance.maximumBacklogCount) | counted_stats("maximumBacklogCount")),
    maximumBacklogBytes:
      (map(.performance.maximumBacklogBytes) | counted_stats("maximumBacklogBytes")),
    maximumBacklogAgeSeconds:
      (map(.performance.maximumBacklogAgeSeconds) | measured_stats("maximumBacklogAgeSeconds")),
    peakFilesystemBytes: (map(.performance.peakFilesystemBytes) | stats("peakFilesystemBytes")),
    retainedFilesystemBytes: (map(.performance.retainedFilesystemBytes) | stats("retainedFilesystemBytes")),
    durableQueueMaxima: $durable_queue_maxima,
    declaredDurableQueueBounds: $declared_queue_bounds,
    durableQueueBoundSetCount: ($declared_queue_bound_sets | length),
    comparison: {
      baseline: {
        source: "main@42b6dee issue-171 attempted trial-1",
        profile: "ASI174 1936x1216 Mono16, five-second cadence, smaller graph",
        rawBytesPerCapture: 4708352,
        captureCount: 14,
        cpuSeconds: 37.973,
        allocatedBytes: 13320000000,
        peakRssBytes: 1101000000,
        processWriteBytes: 2703000000
      },
      candidate: {
        profile: "W6 ASI676MC 3552x3552 Bayer12-in-16, ten-second cadence, complete standalone graph",
        rawBytesPerCapture: 25233408,
        captureCountPerTrial: 10
      },
      normalized: {
        cpuSecondsPerRawGiB: {
          baseline: (37.973 / (14 * 4708352 / 1073741824)),
          candidate: ($cpu_seconds.median / (10 * 25233408 / 1073741824)),
          percentChange: percent_change(
            (37.973 / (14 * 4708352 / 1073741824));
            ($cpu_seconds.median / (10 * 25233408 / 1073741824)))
        },
        allocatedBytesPerRawByte: {
          baseline: (13320000000 / (14 * 4708352)),
          candidate: ($allocated_bytes.median / (10 * 25233408)),
          percentChange: percent_change(
            (13320000000 / (14 * 4708352));
            ($allocated_bytes.median / (10 * 25233408)))
        },
        peakRssBytesPerRawFrameByte: {
          baseline: (1101000000 / 4708352),
          candidate: ($peak_rss_bytes.median / 25233408),
          percentChange: percent_change(
            (1101000000 / 4708352);
            ($peak_rss_bytes.median / 25233408))
        },
        processWriteBytesPerRawByte: {
          baseline: (2703000000 / (14 * 4708352)),
          candidate: ($process_write_bytes.median / (10 * 25233408)),
          percentChange: percent_change(
            (2703000000 / (14 * 4708352));
            ($process_write_bytes.median / (10 * 25233408)))
        }
      },
      disposition: "Issue #171 and W6 use different cadence, frame size, graph, and measurement boundaries. The normalized values are descriptive, but the conservative <=15% regression guard remains executable."
    },
    pipeline: {
      moduleDurationMilliseconds: ([.[].performance.pipeline.moduleDurationMilliseconds.samples[]] | stats("moduleDurationMilliseconds")),
      moduleOverheadMilliseconds: ([.[].performance.pipeline.moduleOverheadMilliseconds.samples[]] | stats("moduleOverheadMilliseconds")),
      ingressDurationMilliseconds: ([.[].performance.pipeline.ingressDurationMilliseconds.samples[]] | stats("ingressDurationMilliseconds")),
      graphDurationMilliseconds: ([.[].performance.pipeline.graphDurationMilliseconds.samples[]] | stats("graphDurationMilliseconds")),
      endToEndDurationMilliseconds: ([.[].performance.pipeline.endToEndDurationMilliseconds.samples[]] | stats("endToEndDurationMilliseconds")),
      cadenceHeadroomMilliseconds: ([.[].performance.pipeline.cadenceHeadroomMilliseconds.samples[]] | stats("cadenceHeadroomMilliseconds")),
      nodes: ([.[].performance.pipeline.nodes[]] | group_by(.nodeId) | map({
        nodeId: .[0].nodeId,
        durationMilliseconds: ([.[].durationMilliseconds.samples[]] | stats("durationMilliseconds"))
      }))
    },
    centralTrafficAttempts: $central_traffic_attempts,
    centralHandlerAttempts: $central_handler_attempts,
    finalDenyGateCount: ($final_central_traffic | length),
    finalDenyHits: $final_deny_hits,
    allPassed: all(.result.passed),
    retainedFilesystemWithinDeclaredBound:
      all((.performance.peakFilesystemBytes | is_byte_count)
        and .performance.peakFilesystemBytes <= $declaredBoundedTrialFootprintBytes),
    candidateGates: {
      exactlyFiveTrials: (length == 5),
      allFiveTestResultsPassed: (length == 5 and all(.result.passed == true)),
      zeroCentralTrafficAttempts: ($central_traffic_attempts == 0),
      zeroCentralHandlerAttempts: ($central_handler_attempts == 0),
      eightFinalDenyChecksPassed:
        (($final_central_traffic | length) == 8 and all($final_central_traffic[]; .passed == true)),
      zeroFinalDenyHits: ($final_deny_hits == 0),
      durableQueuesWithinDeclaredBounds: $durable_queues_within_bounds,
      durableQueuesRecordedWithinDeclaredBounds: $durable_queues_recorded_within_bounds,
      finalDenyGateFlagsAgreeWithCounters:
        ($finalCentralTraffic[0].recordedFlagsAgreeWithCounters == true),
      finalDenyGateTrialsIdentified:
        ($finalCentralTraffic[0].trialsIdentified == true),
      finalDenyGateTrialKindsMatchLabels:
        ($finalCentralTraffic[0].trialKindsMatchLabels == true),
      normalizedRegressionWithinFifteenPercent:
        all($normalized_percent_changes[]; . <= 15),
      retainedFilesystemWithinDeclaredBound:
        all((.performance.peakFilesystemBytes | is_byte_count)
          and .performance.peakFilesystemBytes <= $declaredBoundedTrialFootprintBytes),
      filesystemBytesAreValidMeasurements:
        all((.performance.peakFilesystemBytes | is_byte_count)
          and (.performance.retainedFilesystemBytes | is_byte_count))
    },
    w6Ready: (
      length == 5 and
      all(.result.passed == true) and
      $central_traffic_attempts == 0 and
      $central_handler_attempts == 0 and
      ($final_central_traffic | length) == 8 and
      all($final_central_traffic[]; .passed == true) and
      $final_deny_hits == 0 and
      $durable_queues_within_bounds and
      $durable_queues_recorded_within_bounds and
      ($finalCentralTraffic[0].recordedFlagsAgreeWithCounters == true) and
      ($finalCentralTraffic[0].trialsIdentified == true) and
      ($finalCentralTraffic[0].trialKindsMatchLabels == true) and
      all($normalized_percent_changes[]; . <= 15) and
      all((.performance.peakFilesystemBytes | is_byte_count)
        and (.performance.retainedFilesystemBytes | is_byte_count)
        and .performance.peakFilesystemBytes <= $declaredBoundedTrialFootprintBytes))
  }
' "$RESULTS"/trial-*/evidence/issue-211-w6.json > "$RESULTS/five-trial-summary.json"

jq --exit-status --argjson declaredBoundedTrialFootprintBytes "$DECLARED_BOUNDED_TRIAL_FOOTPRINT_BYTES" \
    '.trialCount == 5 and
     .declaredBoundedTrialFootprintBytes == $declaredBoundedTrialFootprintBytes and
     .peakFilesystemBytes.minimum >= 0 and
     .peakFilesystemBytes.maximum <= $declaredBoundedTrialFootprintBytes and
     .centralTrafficAttempts == 0 and .centralHandlerAttempts == 0 and
     .finalDenyGateCount == 8 and .finalDenyHits == 0 and
     .allPassed == true and .retainedFilesystemWithinDeclaredBound == true and
     ([.candidateGates[]] | all) and .w6Ready == true' \
    "$RESULTS/five-trial-summary.json" >/dev/null || gate_failed 'five-trial summary' "$RESULTS/five-trial-summary.json"
jq --exit-status '.result.passed == true and (.captures | length) == 5 and
    .centralTrafficAttempts == 0 and .centralHandlerAttempts == 0' \
    "$RESULTS/mono8-control/evidence/issue-211-mono8.json" >/dev/null || gate_failed 'mono8 control profile' "$RESULTS/mono8-control/evidence/issue-211-mono8.json"
jq --exit-status '.passed == true and .finalDenyHits == 0' \
    "$RESULTS/mono8-control/evidence/central-traffic-gate.json" >/dev/null || gate_failed 'mono8 central traffic' "$RESULTS/mono8-control/evidence/central-traffic-gate.json"
jq -s '
  {
    schemaVersion: "issue-211-telemetry-summary-v1",
    trialCount: length,
    failedTrials: [to_entries[] | select(
      (.value.missingSpans | length) != 0 or
      (.value.missingMetricScopes | length) != 0 or
      (.value.missingMetrics | length) != 0 or
      (.value.unitMismatches | length) != 0 or
      (.value.severeLogs | length) != 0 or
      (.value.missingEventFamilies | length) != 0 or
      (.value.unexpectedWarnings | length) != 0 or
      (.value.excessiveWarningCounts | length) != 0 or
      (.value.forbiddenAttributeKeys | length) != 0 or
      (.value.forbiddenAttributeValues | length) != 0 or
      (.value.unsupportedMetricKeys | length) != 0 or
      (.value.forbiddenMetricValues | length) != 0 or
      (.value.excessiveMetricCardinality | length) != 0) | .key],
  passed: (length == 8 and all(.[];
      (.missingSpans | length) == 0 and
      (.missingMetricScopes | length) == 0 and
      (.missingMetrics | length) == 0 and
      (.unitMismatches | length) == 0 and
      (.severeLogs | length) == 0 and
      (.missingEventFamilies | length) == 0 and
      (.unexpectedWarnings | length) == 0 and
      (.excessiveWarningCounts | length) == 0 and
      (.forbiddenAttributeKeys | length) == 0 and
      (.forbiddenAttributeValues | length) == 0 and
      (.unsupportedMetricKeys | length) == 0 and
      (.forbiddenMetricValues | length) == 0 and
      (.excessiveMetricCardinality | length) == 0))
  }
' "$RESULTS"/*/evidence/runtime/telemetry-scan.json > "$RESULTS/telemetry-summary.json"
jq -s '{schemaVersion: "issue-211-trial-sanitization-summary-v1", trialCount: length,
  failedTrials: [to_entries[] | select(.value.passed != true) | .key],
  passed: (length == 8 and all(.[]; .passed == true))}' \
  "$RESULTS"/*/evidence/runtime/sanitization-scan.json > "$RESULTS/trial-sanitization-summary.json"
assert_gate "$RESULTS/telemetry-summary.json" 'telemetry summary' '.passed == true'
assert_gate "$RESULTS/trial-sanitization-summary.json" 'trial sanitization summary' '.passed == true'
# This root scan searches the whole retained tree for header/cookie patterns and the synthetic owner
# email, and deliberately not for the two generated secret values. The reason is scope, not content:
# the per-trial scans above search "$RESULTS/<trial>" for exactly those literals, so the retained
# tree can certainly contain them. What protects this scan is that by the time it runs both globals
# were cleared at the end of every trial and $trial_local is local to run_profile_trial, so nothing
# here holds a secret's value or a path to its file. The owner email is scannable here only because
# it is a fixed literal known at every scope. The one root-level artifact that could carry a secret
# is "$RESULTS/failure-$active_project.log", which cleanup() writes only on the abort path and only
# with the values already substituted out.
root_scan_matches="$RESULTS/.root-sanitization-matches"
root_scan_status=0
rg --text --files-with-matches --null --hidden --ignore-case \
    '(authorization:[[:space:]]*(basic|bearer)|set-cookie:|requestverificationtoken|antiforgery|client[_-]?secret([^[:alnum:]]|$)|connection[_-]?string([^[:alnum:]]|$)|owner[_-]?password([^[:alnum:]]|$))' \
    "$RESULTS" > "$root_scan_matches" || root_scan_status=$?
if ((root_scan_status > 1)); then
    printf 'Unable to scan the retained run tree (rg exit %s).\n' "$root_scan_status" >&2
    exit 1
fi
root_scan_status=0
rg --text --files-with-matches --null --hidden --fixed-strings 'standalone-owner@cameraagent.test' \
    "$RESULTS" >> "$root_scan_matches" || root_scan_status=$?
if ((root_scan_status > 1)); then
    printf 'Unable to scan retained synthetic owner identities (rg exit %s).\n' "$root_scan_status" >&2
    exit 1
fi
root_matched_paths=()
while IFS= read -r -d '' path; do
    root_matched_paths+=("${path#"$RESULTS/"}")
done < "$root_scan_matches"
jq -n \
    --argjson matches "$(printf '%s\n' "${root_matched_paths[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
    '{schemaVersion: "issue-211-root-sanitization-scan-v1", matchedFiles: ($matches | unique),
      passed: ($matches | length == 0)}' > "$RESULTS/root-sanitization-scan.json"
rm -f "$root_scan_matches"
assert_gate "$RESULTS/root-sanitization-scan.json" 'root sanitization scan' '.passed == true'
assert_no_owned_acceptance_resources
jq -n '{schemaVersion: "issue-211-cleanup-gate-v1", ownedResourceCount: 0, passed: true}' \
    > "$RESULTS/cleanup-gate.json"
assert_worktree_unchanged
jq -n --arg fingerprint "$WORKTREE_FINGERPRINT" \
    '{schemaVersion: "issue-211-source-integrity-gate-v1", worktreeFingerprint: $fingerprint,
      unchangedAfterBuildAndTrials: true, passed: true}' > "$RESULTS/source-integrity-gate.json"
jq -n \
    --arg fingerprint "$WORKTREE_FINGERPRINT" \
    --slurpfile w6 "$RESULTS/five-trial-summary.json" \
    --slurpfile mono "$RESULTS/mono8-control/evidence/issue-211-mono8.json" \
    --slurpfile monoTraffic "$RESULTS/mono8-control/evidence/central-traffic-gate.json" \
    --slurpfile replayPair "$RESULTS/replay-pair-summary.json" \
    --slurpfile sanitization "$RESULTS/root-sanitization-scan.json" \
    --slurpfile telemetry "$RESULTS/telemetry-summary.json" \
    --slurpfile trialSanitization "$RESULTS/trial-sanitization-summary.json" \
    --slurpfile cleanup "$RESULTS/cleanup-gate.json" \
    --slurpfile sourceIntegrity "$RESULTS/source-integrity-gate.json" '
  {
    schemaVersion: "issue-211-final-acceptance-summary-v1",
    worktreeFingerprint: $fingerprint,
    gates: {
      w6: $w6[0].w6Ready,
      mono8: ($mono[0].result.passed == true and ($mono[0].captures | length) == 5),
      mono8CentralIsolation: $monoTraffic[0].passed,
      replayPair: ($replayPair[0].passed == true and ([ $replayPair[0].bindings[] ] | all)),
      telemetry: $telemetry[0].passed,
      trialSanitization: $trialSanitization[0].passed,
      retainedEvidenceSanitized: $sanitization[0].passed,
      ownedResourcesCleaned: $cleanup[0].passed,
      sourceUnchanged: $sourceIntegrity[0].passed
    },
    acceptanceReady: (
      $w6[0].w6Ready and
      $mono[0].result.passed == true and
      ($mono[0].captures | length) == 5 and
      $monoTraffic[0].passed and
      $replayPair[0].passed == true and
      ([ $replayPair[0].bindings[] ] | all) and
      $telemetry[0].passed and
      $trialSanitization[0].passed and
      $sanitization[0].passed and
      $cleanup[0].passed and
      $sourceIntegrity[0].passed)
  }
' > "$RESULTS/final-acceptance-summary.json"
jq --exit-status '.acceptanceReady == true and ([.gates[]] | all)' \
    "$RESULTS/final-acceptance-summary.json" >/dev/null || gate_failed 'final acceptance summary' "$RESULTS/final-acceptance-summary.json"
run_inventory="$RESULTS/.run-manifest.jsonl"
: > "$run_inventory"
shopt -s globstar nullglob dotglob
for retained_output in "$RESULTS"/**/*; do
    [[ -f "$retained_output" && "$retained_output" != "$run_inventory" &&
        "$retained_output" != "$RESULTS/run-manifest.json" ]] || continue
    read -r retained_sha _ < <(sha256sum "$retained_output")
    retained_bytes="$(stat --format='%s' "$retained_output")"
    retained_relative="${retained_output#"$RESULTS/"}"
    jq -cn \
        --arg path "$retained_relative" \
        --arg sha256 "$retained_sha" \
        --argjson bytes "$retained_bytes" \
        '{path: $path, bytes: $bytes, sha256: ($sha256 | ascii_upcase)}' >> "$run_inventory"
done
jq -s \
    --arg fingerprint "$WORKTREE_FINGERPRINT" \
    --arg runId "$RUN_ID" \
    --arg revision "$REVISION" \
    --arg dirtyStateSha256 "$DIRTY_SHA256" \
    --arg cameraImage "$CAMERA_AGENT_IMAGE" '
  {
    schemaVersion: "issue-211-run-manifest-v1",
    worktreeFingerprint: $fingerprint,
    runId: $runId,
    revision: $revision,
    dirtyStateSha256: ($dirtyStateSha256 | ascii_upcase),
    cameraImage: $cameraImage,
    excludedSelf: "run-manifest.json",
    retainedOutputs: sort_by(.path),
    totalBytes: (map(.bytes) | add // 0)
  }
' "$run_inventory" > "$RESULTS/run-manifest.json"
rm -f "$run_inventory"
assert_worktree_unchanged
[[ "$(sha256sum "$TEST_ASSEMBLY" | cut -d' ' -f1)" == "$TEST_ASSEMBLY_SHA256" ]] || {
    printf 'Acceptance test assembly changed after the no-build trials.\n' >&2
    exit 1
}
if [[ -n "${HVO_PHASE14_TEST_ASSEMBLY_SHA_FILE:-}" ]]; then
    printf '%s\n' "$TEST_ASSEMBLY_SHA256" > "$HVO_PHASE14_TEST_ASSEMBLY_SHA_FILE"
    chmod 600 "$HVO_PHASE14_TEST_ASSEMBLY_SHA_FILE"
fi
assert_no_owned_acceptance_resources
final_root_scan_status=0
rg --text --hidden --ignore-case \
    '(authorization:[[:space:]]*(basic|bearer)|set-cookie:|requestverificationtoken|antiforgery|client[_-]?secret([^[:alnum:]]|$)|connection[_-]?string([^[:alnum:]]|$)|owner[_-]?password([^[:alnum:]]|$))' \
    "$RESULTS" >/dev/null || final_root_scan_status=$?
if ((final_root_scan_status == 0 || final_root_scan_status > 1)); then
    printf 'The final retained run tree failed sanitization (rg exit %s).\n' "$final_root_scan_status" >&2
    exit 1
fi
final_root_scan_status=0
rg --text --hidden --fixed-strings 'standalone-owner@cameraagent.test' \
    "$RESULTS" >/dev/null || final_root_scan_status=$?
if ((final_root_scan_status == 0 || final_root_scan_status > 1)); then
    printf 'The final retained run tree contains the synthetic owner identity (rg exit %s).\n' \
        "$final_root_scan_status" >&2
    exit 1
fi
printf 'Issue #211 W6 evidence: %s\n' "$RESULTS/final-acceptance-summary.json"
