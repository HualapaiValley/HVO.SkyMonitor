    path_map=(-p:PathMap="$HVO_PHASE14_BUILD_PATH_MAP")
fi
dotnet build "$PROJECT" --no-restore --no-incremental --configuration Release -warnaserror "${path_map[@]}" 8>&-
assert_worktree_unchanged
readonly TEST_ASSEMBLY="$REPO_ROOT/tests/HVO.SkyMonitor.CameraAgent.AcceptanceTests/bin/Release/net10.0/HVO.SkyMonitor.CameraAgent.AcceptanceTests.dll"
TEST_ASSEMBLY_SHA256="$(sha256sum "$TEST_ASSEMBLY" | cut -d' ' -f1)"
readonly TEST_ASSEMBLY_SHA256
readonly TEST_OUTPUT_DIR="$REPO_ROOT/tests/HVO.SkyMonitor.CameraAgent.AcceptanceTests/bin/Release/net10.0"

# The browser evidence is gated inside the test by an Assert.Inconclusive, and a skipped MSTest returns
# zero, so a host with no pinned Chromium produced "Test Run Successful" having opened no page at all.
# Resolve the pinned browser here, before the first trial, so a campaign that cannot produce browser
# evidence stops with the cause named instead of reporting a result it never obtained. The driver is asked
# rather than a path being guessed, so this answers with the same install location the test resolves.
verify_pinned_browser() {
    local report location identity chrome
    if ! report="$(PLAYWRIGHT_DRIVER_SEARCH_PATH="$TEST_OUTPUT_DIR" dotnet exec \
            --runtimeconfig "$TEST_OUTPUT_DIR/HVO.SkyMonitor.CameraAgent.AcceptanceTests.runtimeconfig.json" \
            --depsfile "$TEST_OUTPUT_DIR/HVO.SkyMonitor.CameraAgent.AcceptanceTests.deps.json" \
            "$TEST_OUTPUT_DIR/Microsoft.Playwright.dll" install --dry-run chromium 2>&1)"; then
        printf 'Could not ask the Playwright driver where the pinned Chromium lives:\n%s\n' "$report" >&2
        exit 2
    fi
    # The report lists chromium, chromium-headless-shell and ffmpeg. Take the chromium block only; the
    # headless shell is a different browser and satisfying the guard with it would be the same substitution
    # this check exists to refuse.
    identity="$(printf '%s\n' "$report" \
        | awk '/^Chrome for Testing .*playwright chromium v[0-9]+\)$/ { print; exit }')"
    location="$(printf '%s
' "$report" \
        | awk '/^Chrome for Testing .*playwright chromium v[0-9]+\)$/ { seen = 1; next }
               seen && /Install location:/ { sub(/^[[:space:]]*Install location:[[:space:]]*/, ""); print; exit }')"
    if [[ -z "$identity" || -z "$location" ]]; then
        printf 'The Playwright driver did not report a pinned Chromium install location:\n%s\n' "$report" >&2
        exit 2
    fi
    # The location is absent exactly when the browser is missing, and under pipefail a failing find would
    # abort this check before it could say so — a fail-closed guard that exits silently is the defect this
    # is here to remove.
    chrome=""
    if [[ -d "$location" ]]; then
        chrome="$(find "$location" -maxdepth 2 -type f -name chrome -perm -u+x 2>/dev/null | head -n 1 || true)"
    fi
    if [[ -z "$chrome" ]]; then
        printf 'The pinned Playwright Chromium is not installed, so this campaign cannot produce browser evidence.\n' >&2
        printf '  required: %s\n' "$identity" >&2
        printf '  expected at: %s\n' "$location" >&2
        printf '  install it with: scripts/test:cameraagent-ui --install-browser\n' >&2
        exit 2
    fi
    BROWSER_IDENTITY="$identity"
    BROWSER_EXECUTABLE="$chrome"
    printf 'Pinned browser verified: %s\n  %s\n' "$identity" "$chrome"
}
verify_pinned_browser
readonly BROWSER_IDENTITY BROWSER_EXECUTABLE

# The TRX is written on every trial, but until now it was only retained under Phase 14 and never inspected,
# so the artefact recording what actually happened was the one nobody read. Assert against it here, on every
# trial, whether or not Phase 14 retention is on.
#
# Read "executed" and "passed", not "notExecuted" or "inconclusive". A skipped run records notExecuted="0"
# and inconclusive="0" in ResultSummary, so a validator that checked either of those would see green on a
# run that executed nothing. The truth survives only in the executed and passed counts and in the per-result
# outcome attribute, and this checks both.
# A jq gate that evaluates false exits 1 and prints nothing, so under set -e the campaign dies wordlessly
# and a failed gate is indistinguishable from a crash. That is what produced the silent exit on #738, where
# the acceptance test passed and the campaign still stopped without a message. Every gate says which one it
# was and which artefact it read.
# For gates whose jq program spans several lines, the program is left as it stands and only its silence is
# fixed. Without this the compound simply returns non-zero and set -e ends the campaign with nothing said.
gate_failed() {
    printf 'The %s gate did not pass, reading %s.\n' "$1" "$2" >&2
    return 1
}

assert_gate() {
    local file="$1"
    local description="$2"
    shift 2
    if [[ ! -s "$file" ]]; then
        printf 'The %s gate has no evidence to read at %s.\n' "$description" "$file" >&2
        return 1
    fi
    if ! jq --exit-status "$@" "$file" >/dev/null; then
        printf 'The %s gate did not pass, reading %s.\n' "$description" "$file" >&2
        return 1
    fi
}

assert_trial_executed_and_passed() {
    local trx="$1"
    local label="$2"
    # Both halves of the contract, from the one implementation in scripts/lib/trx-evidence.sh:
    # the per-result outcomes, then the run's own totals. This runner asserts both because a
    # campaign trial must show that the tests it selected are the tests that ran. Issue #803
    # folded the second copy that used to live here into the library, where the gate covers it.
    trx_assert_executed_and_passed "$trx" "$label" || return 1
    trx_assert_counters_executed_and_passed "$trx" "$label" || return 1
}

active_project=""
active_env=""
# The compose files backing the active project. Set with active_project so the EXIT trap tears
# down exactly what was brought up: a cleanup that omitted the overlay would leave the replay
# runner running and the socket directory populated, and the next trial would inherit both.
active_compose_files=("--file" "$COMPOSE_FILE")
active_client_network=""
active_owner_email=""
active_owner_password=""
active_replay_auth_key=""
cleanup() {
    if [[ -n "$active_project" ]]; then
        local failure_log="$RESULTS/failure-$active_project.log"
        while IFS= read -r line; do
            # An empty needle substitutes between every character, so each replacement is
            # guarded on the value being set. cleanup() runs before a trial assigns them.
            if [[ -n "$active_owner_email" ]]; then
                line="${line//$active_owner_email/[REDACTED-OWNER]}"
            fi
            if [[ -n "$active_owner_password" ]]; then
                line="${line//$active_owner_password/[REDACTED-PASSWORD]}"
            fi
            if [[ -n "$active_replay_auth_key" ]]; then
                line="${line//$active_replay_auth_key/[REDACTED-REPLAY-AUTH-KEY]}"
            fi
            if [[ "$line" =~ [Aa]uthorization:[[:space:]]*(Basic|Bearer)|[Ss]et-[Cc]ookie:|[Rr]equest[Vv]erification[Tt]oken|[Aa]ntiforgery|[Cc]lient[_-]?[Ss]ecret|[Cc]onnection[_-]?[Ss]tring ]]; then
                printf '%s\n' '[REDACTED-SENSITIVE-LOG-LINE]'
            else
                printf '%s\n' "$line"
            fi
        done < <(docker compose --env-file "$active_env" --project-name "$active_project" "${active_compose_files[@]}" logs --no-color --tail 20000 2>&1 || true) \
            > "$failure_log"
        if [[ -n "$active_client_network" ]]; then
            docker network disconnect "$active_client_network" "$(hostname)" >/dev/null 2>&1 || true
            active_client_network=""
        fi
        docker compose --env-file "$active_env" --project-name "$active_project" "${active_compose_files[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT

run_profile_trial() {
    if (($# != 15)); then
        printf 'run_profile_trial requires exactly 15 arguments; received %s.\n' "$#" >&2
        return 1
    fi
    local trial="$1"
    local config_template="$2"
    local agent_id="$3"
    local calibration_required="$4"
    local test_filter="$5"
    local result_file="$6"
    local warmup_capture_count="$7"
    local measured_capture_count="$8"
    local transient_mode="$9"
    local transient_required="${10}"
    local collect_phase14="${11}"
    # InProcess unless a trial asks otherwise, so existing trials are unchanged by construction
    # rather than by a default chosen to look safe.
    local replay_profile="${12:-InProcess}"
    # The durable root is named separately from the trial so two invocations can share one, which
    # is what #719 requires: the issue's acceptance criteria say to "recreate only CameraAgent
    # against the same durable root under LocalRunner". Defaulting to the trial name leaves every
    # existing caller with a private root, unchanged by construction.
    local state_key="${13:-$trial}"
    # Whether this invocation hands its durable root to a later one. The last invocation over a
    # shared root is the one that deletes it.
    local retain_state="${14:-false}"
    local trial_kind="${15}"
    case "$trial_kind" in
        w6|mono8|replay) ;;
        *) printf 'Unknown trial kind %s for %s.\n' "$trial_kind" "$trial" >&2; return 1 ;;
    esac
    assert_worktree_unchanged
    local trial_result="$RESULTS/$trial"
    local trial_local="$BIND_LOCAL_ROOT/$state_key"
    local trial_host="$BIND_HOST_ROOT/$state_key"
    # A marker rather than the presence of the directory: an invocation that died partway through
    # setup leaves directories behind, and treating that as established state would silently run
    # the second invocation against a root the first never finished writing.
    local reuse_state=false
    if [[ -f "$trial_local/.state-established" ]]; then
        reuse_state=true
    fi
    mkdir -p "$trial_result/evidence" "$trial_local"/{config,runtime/home,dataprotection,secrets,telemetry,catalog}
    if [[ "$reuse_state" == true ]]; then
        # Durable replay state lives under runtime, calibration, and the databases. Telemetry is
        # invocation evidence, not durable state, so LocalRunner must not inherit InProcess signals.
        rm -rf -- "$trial_local/telemetry"
        mkdir -p "$trial_local/telemetry"
    fi
    # The acceptance handler appends its startup ready record and attempts. Each invocation gets a
    # fresh log while retaining every other file in the durable runtime root.
    rm -f -- "$trial_local/runtime/central-http-attempts.log"
    jq '
      .schedule.blackouts = [{
        "id": "w6-bootstrap-closed",
        "startUtc": "2020-01-01T00:00:00Z",
        "endUtc": "2100-01-01T00:00:00Z"
      }]
    ' "$config_template" > "$trial_local/config/cameraagent.json"
    cp "$COLLECTOR_CONFIG" "$trial_local/config/otel-collector.yml"
    local owner_password
    local owner_email='standalone-owner@cameraagent.test'
    if [[ "$reuse_state" == true ]]; then
        # The Identity store inside this root already holds this owner, so bootstrap will not run
        # again. Minting a fresh password here would leave the second invocation unable to
        # authenticate against the state the first one established -- which is the whole reason
        # the root is shared.
        owner_password="$(< "$trial_local/secrets/owner-password")"
    else
        cp -a "$HVO_CATALOG_PERF_ROOT/." "$trial_local/catalog/"
        owner_password="Aa!$(openssl rand -base64 36 | tr -d '\n')"
        printf '%s\n' "$owner_password" > "$trial_local/secrets/owner-password"
        chmod 600 "$trial_local/secrets/owner-password"
    fi
    active_owner_email="$owner_email"
    active_owner_password="$owner_password"

    local suffix="${REVISION:0:8}-${trial//[^a-zA-Z0-9]/}-$$"
    active_project="hvo211-$suffix"
    active_env="$trial_local/compose.env"
    if [[ "$replay_profile" == LocalRunner ]]; then
        # The runner reaches the agent only over this socket and authenticates with this key, so
        # both are created per trial and neither is shared between them. 0700 and 0600 are the
        # installer's modes; a looser mode here would prove a topology nobody deploys.
        install -d -m 700 "$trial_local/replay-runner"
        if [[ ! -s "$trial_local/secrets/replay-runner-auth-key" ]]; then
            umask 077
            openssl rand -base64 48 | tr -d '\n' > "$trial_local/secrets/replay-runner-auth-key"
            chmod 600 "$trial_local/secrets/replay-runner-auth-key"
        fi
        active_replay_auth_key="$(cat "$trial_local/secrets/replay-runner-auth-key")"
        active_compose_files=("--file" "$COMPOSE_FILE" "--file" "$LOCAL_RUNNER_COMPOSE_FILE")
    else
        active_compose_files=("--file" "$COMPOSE_FILE")
    fi
    cat > "$active_env" <<EOF
CAMERA_AGENT_IMAGE=$CAMERA_AGENT_IMAGE
CAMERA_AGENT_CONTAINER=hvo211-$suffix-camera
ISSUE211_PROXY_CONTAINER=hvo211-$suffix-proxy
CAMERA_AGENT_ID=$agent_id
CAMERA_AGENT_CALIBRATION_REQUIRED=$calibration_required
CAMERA_AGENT_TRANSIENT_MODE=$transient_mode
CAMERA_AGENT_TRANSIENT_REQUIRED=$transient_required
CAMERA_AGENT_REPLAY_PROFILE=$replay_profile
REPLAY_RUNNER_CONTAINER=hvo211-$suffix-replay
REPLAY_RUNNER_SOCKET_DIR=$trial_host/replay-runner
REPLAY_RUNNER_AUTH_KEY_FILE=$trial_host/secrets/replay-runner-auth-key
ISSUE211_BIND_ADDRESS=$DOCKER_HOST_ADDRESS
ISSUE211_HTTP_PORT=$HTTP_PORT
CAMERA_AGENT_RUNTIME_SOURCE=$trial_host/runtime
CAMERA_AGENT_DATA_PROTECTION_SOURCE=$trial_host/dataprotection
CAMERA_AGENT_CONFIG_SOURCE=$trial_host/config/cameraagent.json
CAMERA_AGENT_CATALOG_SOURCE=$trial_host/catalog
CAMERA_AGENT_OWNER_PASSWORD_FILE=$trial_host/secrets/owner-password
CAMERA_AGENT_OWNER_EMAIL=$owner_email
OTEL_COLLECTOR_IMAGE=$HVO_OTEL_COLLECTOR_IMAGE
OTEL_COLLECTOR_CONTAINER=hvo211-$suffix-collector
OTEL_COLLECTOR_CONFIG_SOURCE=$trial_host/config/otel-collector.yml
OTEL_EVIDENCE_SOURCE=$trial_host/telemetry
CENTRAL_DENY_IMAGE=$CENTRAL_DENY_IMAGE
CENTRAL_DENY_CONTAINER=hvo211-$suffix-central-deny
LOCAL_UID=$LOCAL_UID
LOCAL_GID=$LOCAL_GID
EOF
    docker compose --env-file "$active_env" --project-name "$active_project" "${active_compose_files[@]}" config --quiet
    docker compose --env-file "$active_env" --project-name "$active_project" "${active_compose_files[@]}" up --detach
    local base_uri="http://$DOCKER_HOST_ADDRESS:$HTTP_PORT"
    if [[ -n "$host_workspace" ]]; then
        active_client_network="${active_project}_isolated"
        docker network connect "$active_client_network" "$(hostname)"
        local camera_ip
        camera_ip="$(docker inspect "hvo211-$suffix-camera" |
            jq -er --arg network "$active_client_network" '
              .[0].NetworkSettings.Networks[$network].IPAddress |
              select(type == "string" and length > 0)')"
        base_uri="http://$camera_ip:8080"
    fi

    local phase14_environment=()
    if [[ "$collect_phase14" == true ]]; then
        phase14_environment=(
            "HVO_PHASE14_EVIDENCE_ALLOWED_ROOT=$HVO_PHASE14_EVIDENCE_ALLOWED_ROOT"
            "HVO_PHASE14_EVIDENCE_ROOT=$HVO_PHASE14_EVIDENCE_ROOT"
            "HVO_PHASE14_OBSERVATION_PREFIX=$trial"
            "HVO_PHASE14_SOURCE_REVISION=$HVO_PHASE14_SOURCE_REVISION"
            "HVO_PHASE14_SOURCE_TREE=$HVO_PHASE14_SOURCE_TREE"
        )
    fi
    env -u HVO_PHASE14_EVIDENCE_ALLOWED_ROOT -u HVO_PHASE14_EVIDENCE_ROOT \
    -u HVO_PHASE14_OBSERVATION_PREFIX -u HVO_PHASE14_SOURCE_REVISION \
    -u HVO_PHASE14_SOURCE_TREE -u HVO_PHASE14_TRX_ROOT \
    "${phase14_environment[@]}" \
    HVO_ISSUE_211_TRIAL="$trial" \
    HVO_ISSUE_211_REVISION="$REVISION" \
    HVO_ISSUE_211_BRANCH="$BRANCH" \
    HVO_ISSUE_211_DIRTY_SHA256="$DIRTY_SHA256" \
    HVO_ISSUE_211_EVIDENCE_ROOT="$trial_result/evidence" \
    HVO_ISSUE_211_BASE_URI="$base_uri" \
    HVO_ISSUE_211_RUNTIME_ROOT="$trial_local/runtime" \
    HVO_ISSUE_211_CONTAINER="hvo211-$suffix-camera" \
    HVO_ISSUE_211_PROXY_CONTAINER="hvo211-$suffix-proxy" \
    HVO_ISSUE_211_COLLECTOR_CONTAINER="hvo211-$suffix-collector" \
    HVO_ISSUE_211_CENTRAL_DENY_CONTAINER="hvo211-$suffix-central-deny" \
    HVO_ISSUE_211_CENTRAL_HANDLER_LOG="$trial_local/runtime/central-http-attempts.log" \
    HVO_ISSUE_211_OWNER_PASSWORD_FILE="$trial_local/secrets/owner-password" \
    HVO_ISSUE_211_CAMERA_IMAGE="$CAMERA_AGENT_IMAGE" \
    HVO_ISSUE_211_WORKTREE_FINGERPRINT="$WORKTREE_FINGERPRINT" \
    HVO_ISSUE_211_BOUNDED_FOOTPRINT_BYTES="$DECLARED_BOUNDED_TRIAL_FOOTPRINT_BYTES" \
    HVO_ISSUE_211_REQUIRED_FREE_BYTES="$REQUIRED_FREE_BYTES" \
    HVO_ISSUE_211_DOTNET_SDK_VERSION="$DOTNET_SDK_VERSION" \
    HVO_ISSUE_211_DOCKER_SERVER_VERSION="$DOCKER_SERVER_VERSION" \
    HVO_ISSUE_211_COLLECTOR_IMAGE="$HVO_OTEL_COLLECTOR_IMAGE" \
    HVO_ISSUE_211_CENTRAL_DENY_IMAGE="$CENTRAL_DENY_IMAGE" \
    HVO_ISSUE_211_WARMUP_CAPTURES="$warmup_capture_count" \
    HVO_ISSUE_211_MEASURED_CAPTURES="$measured_capture_count" \
    HVO_ISSUE_211_REPLAY_PROFILE="$replay_profile" \
    HVO_ISSUE_211_STATE_KEY="$state_key" \
    HVO_ISSUE_211_STATE_REUSED="$reuse_state" \
        dotnet test "$PROJECT" --no-build --configuration Release \
        --filter "FullyQualifiedName=$test_filter" \
        --results-directory "$trial_result" \
        --logger "trx;LogFileName=$result_file" \
        --logger 'console;verbosity=normal' 8>&-
    assert_worktree_unchanged
    assert_trial_executed_and_passed "$trial_result/$result_file" "$trial"
    # Record which browser actually ran, so a later reader can tell a real trial from one that never opened
    # a page. Without it the evidence is silent on the single fact that distinguishes them.
    jq --null-input \
        --arg identity "$BROWSER_IDENTITY" \
        --arg executable "$BROWSER_EXECUTABLE" \
        '{ pinnedBrowser: { identity: $identity, executable: $executable } }' \
        > "$trial_result/evidence/browser.json"
    if [[ "$collect_phase14" == true ]]; then
        shopt -s nullglob
        local raw_trx_files=("$trial_result"/*.trx)
        if ((${#raw_trx_files[@]} != 1)) || [[ "${raw_trx_files[0]:-}" != "$trial_result/$result_file" ]]; then
            printf 'Expected exactly one raw TRX for %s at %s.\n' "$trial" "$trial_result/$result_file" >&2
            return 1
        fi
        cp -- "${raw_trx_files[0]}" "$HVO_PHASE14_TRX_ROOT/$trial/result.trx"
        chmod 600 -- "$HVO_PHASE14_TRX_ROOT/$trial/result.trx"
    fi

    local profile_evidence_file
    case "$trial_kind" in
        w6) profile_evidence_file='issue-211-w6.json' ;;
        mono8) profile_evidence_file='issue-211-mono8.json' ;;
        replay) profile_evidence_file="issue-719-replay-${replay_profile}.json" ;;
    esac
    if [[ "$trial_kind" == replay ]]; then
        jq --exit-status -f "$SCRIPT_DIR/issue-719-replay-evidence.jq" \
            --arg replayProfile "$replay_profile" \
            --arg stateKey "$state_key" \
            --argjson stateReused "$reuse_state" \
            --argjson measuredCaptureCount "$measured_capture_count" \
            "$trial_result/evidence/$profile_evidence_file" >/dev/null \
            || gate_failed 'replay profile evidence' "$trial_result/evidence/$profile_evidence_file"
        local camera_state replay_runner_state='null' replay_stats
        camera_state="$(docker inspect "hvo211-$suffix-camera" --format '{{json .State}}')"
        if [[ "$replay_profile" == LocalRunner ]]; then
            replay_runner_state="$(docker inspect "hvo211-$suffix-replay" --format '{{json .State}}')"
        fi
        jq -n \
            --arg trial "$trial" \
            --arg replayProfile "$replay_profile" \
            --argjson cameraState "$camera_state" \
            --argjson replayRunnerState "$replay_runner_state" '
          {
            schemaVersion: "issue-719-replay-runtime-status-v1",
            trial: $trial,
            replayProfile: $replayProfile,
            cameraAgent: {
              running: $cameraState.Running,
              status: $cameraState.Status,
              healthStatus: ($cameraState.Health.Status // "not-configured")
            },
            replayRunner: (if $replayProfile == "LocalRunner" then {
              running: $replayRunnerState.Running,
              status: $replayRunnerState.Status,
              healthStatus: ($replayRunnerState.Health.Status // null)
            } else null end),
            passed: ($cameraState.Running == true and $cameraState.Status == "running" and
              ($cameraState.Health == null or $cameraState.Health.Status == "healthy") and
              ($replayProfile != "LocalRunner" or
                ($replayRunnerState.Running == true and $replayRunnerState.Status == "running" and
                 $replayRunnerState.Health.Status == "healthy")))
          }
        ' > "$trial_result/evidence/health.json"
        assert_gate "$trial_result/evidence/health.json" 'replay runtime health' '.passed == true'
        local replay_process_containers=("hvo211-$suffix-camera")
        if [[ "$replay_profile" == LocalRunner ]]; then
            replay_process_containers+=("hvo211-$suffix-replay")
        fi
        replay_stats="$(docker stats --no-stream --format '{{json .}}' "${replay_process_containers[@]}")"
        [[ -n "$replay_stats" ]] || { printf 'Replay process snapshot is empty for %s.\n' "$trial" >&2; return 1; }
        printf '%s\n' 'schemaVersion,trial,replayProfile,containerId,name,cpuPercent,memoryUsage,memoryPercent,netIO,blockIO,pids' \
            > "$trial_result/evidence/process.csv"
        jq -r --arg trial "$trial" --arg replayProfile "$replay_profile" '
          ["issue-719-replay-process-snapshot-v1", $trial, $replayProfile, .Container, .Name,
           .CPUPerc, .MemUsage, .MemPerc, .NetIO, .BlockIO, .PIDs] | @csv
        ' <<< "$replay_stats" >> "$trial_result/evidence/process.csv"
        local expected_process_lines=2
        if [[ "$replay_profile" == LocalRunner ]]; then
            expected_process_lines=3
        fi
        [[ "$(wc -l < "$trial_result/evidence/process.csv")" -eq "$expected_process_lines" ]] \
            || { printf 'Replay process snapshot is malformed for %s.\n' "$trial" >&2; return 1; }
        cut -d, -f5 "$trial_result/evidence/process.csv" | tr -d '"' | tail -n +2 | sort \
            > "$trial_result/evidence/.process-names"
        printf '%s\n' "${replay_process_containers[@]}" | sort > "$trial_result/evidence/.expected-process-names"
        cmp --silent "$trial_result/evidence/.expected-process-names" "$trial_result/evidence/.process-names" \
            || { printf 'Replay process snapshot omitted a required container for %s.\n' "$trial" >&2; return 1; }
        rm -f "$trial_result/evidence/.process-names" "$trial_result/evidence/.expected-process-names"
    fi
    docker stop --timeout 30 "hvo211-$suffix-camera" >/dev/null
    cp "$trial_local/runtime/central-http-attempts.log" \
        "$trial_result/evidence/central-http-attempts.log"
    while IFS= read -r line; do
        printf '%s\n' "${line//$owner_email/[REDACTED-OWNER]}"
    done < <(docker logs --timestamps --tail 20000 "hvo211-$suffix-camera" 2>&1) \
        > "$trial_result/evidence/cameraagent.log"
    docker logs --timestamps --tail 20000 "hvo211-$suffix-collector" > "$trial_result/evidence/collector.log" 2>&1
    docker logs --timestamps --tail 20000 "hvo211-$suffix-central-deny" > "$trial_result/evidence/central-deny.log" 2>&1
    local deny_rg_status=0
    local final_deny_hits=0
    final_deny_hits="$(rg --count-matches --fixed-strings 'HVO211_DENY_HIT' \
        "$trial_result/evidence/central-deny.log")" || deny_rg_status=$?
    if ((deny_rg_status > 1)); then
        printf 'Unable to scan the final central-deny log for %s (rg exit %s).\n' "$trial" "$deny_rg_status" >&2
        return 1
    fi
    if ((deny_rg_status == 1)); then
        final_deny_hits=0
    fi
    local final_handler_rg_status=0
    local final_central_handler_attempts=0
    rg --text --invert-match '^(HVO211_HANDLER_READY|HVO211_HANDLER_ATTEMPT .+)$' \
        "$trial_local/runtime/central-http-attempts.log" >/dev/null || final_handler_rg_status=$?
    if ((final_handler_rg_status == 0 || final_handler_rg_status > 1)); then
        printf 'The final central-handler log is invalid for %s (rg exit %s).\n' \
            "$trial" "$final_handler_rg_status" >&2
        return 1
    fi
    final_handler_rg_status=0
    final_central_handler_attempts="$(rg --count-matches '^HVO211_HANDLER_ATTEMPT ' \
        "$trial_local/runtime/central-http-attempts.log")" || final_handler_rg_status=$?
    if ((final_handler_rg_status > 1)); then
        printf 'Unable to scan final central-handler attempts for %s (rg exit %s).\n' \
            "$trial" "$final_handler_rg_status" >&2
        return 1
    fi
    if ((final_handler_rg_status == 1)); then
        final_central_handler_attempts=0
    fi
    local final_handler_ready_count=0
    final_handler_rg_status=0
    final_handler_ready_count="$(rg --count-matches '^HVO211_HANDLER_READY$' \
        "$trial_local/runtime/central-http-attempts.log")" || final_handler_rg_status=$?
    if ((final_handler_rg_status > 1)); then
        printf 'Unable to scan final central-handler readiness for %s (rg exit %s).\n' \
            "$trial" "$final_handler_rg_status" >&2
        return 1
    fi
    if ((final_handler_rg_status == 1)); then
        final_handler_ready_count=0
    fi
    if ((final_handler_ready_count < 1)); then
        printf 'The final central-handler log has no ready record for %s.\n' "$trial" >&2
        return 1
    fi
    local in_test_central_attempts='null'
    local in_test_central_handler_attempts='null'
    local in_test_counters_applicable=false
    local in_test_counters_reason='Replay evidence schema does not record in-test central traffic counters.'
    if [[ "$trial_kind" != replay ]]; then
        in_test_central_attempts="$(jq -er '.centralTrafficAttempts | select(type == "number")' \
            "$trial_result/evidence/$profile_evidence_file")"
        in_test_central_handler_attempts="$(jq -er '.centralHandlerAttempts | select(type == "number")' \
            "$trial_result/evidence/$profile_evidence_file")"
        in_test_counters_applicable=true
        in_test_counters_reason='Recorded by the profile evidence schema.'
    fi
    jq -n -f "$SCRIPT_DIR/issue-211-central-traffic-gate.jq" \
        --arg trial "$trial" \
        --arg trialKind "$trial_kind" \
        --arg inTestCountersReason "$in_test_counters_reason" \
        --argjson inTestCountersApplicable "$in_test_counters_applicable" \
        --argjson inTestCentralTrafficAttempts "$in_test_central_attempts" \
        --argjson inTestCentralHandlerAttempts "$in_test_central_handler_attempts" \
        --argjson finalCentralHandlerAttempts "$final_central_handler_attempts" \
        --argjson finalCentralHandlerReadyRecords "$final_handler_ready_count" \
        --argjson finalDenyHits "$final_deny_hits" \
        > "$trial_result/evidence/central-traffic-gate.json"
    docker stop --timeout 10 "hvo211-$suffix-collector" "hvo211-$suffix-central-deny" >/dev/null
    assert_gate "$trial_result/evidence/central-traffic-gate.json" 'central traffic' '.passed == true'
    cp -a "$trial_local/telemetry" "$trial_result/evidence/runtime"
    local raw_logs="$trial_local/raw-telemetry-logs.json"
    cp "$trial_result/evidence/runtime/logs.json" "$raw_logs"
    local raw_log_scan_status=0
    rg --text --ignore-case \
        '(authorization:[[:space:]]*(basic|bearer)|set-cookie:|requestverificationtoken|antiforgery|client[_-]?secret([^[:alnum:]]|$)|connection[_-]?string([^[:alnum:]]|$)|owner[_-]?password([^[:alnum:]]|$))' \
        "$raw_logs" >/dev/null || raw_log_scan_status=$?
    if ((raw_log_scan_status == 0)); then
        printf 'Unsanitized telemetry logs contain a forbidden credential pattern for %s.\n' "$trial" >&2
        return 1
    fi
    if ((raw_log_scan_status > 1)); then
        printf 'Unable to scan unsanitized telemetry logs for %s (rg exit %s).\n' "$trial" "$raw_log_scan_status" >&2
        return 1
    fi
    local secret_name sensitive_file
    for secret_name in "${SECRET_FILE_NAMES[@]}"; do
        sensitive_file="$trial_local/secrets/$secret_name"
        [[ -s "$sensitive_file" ]] || continue
        raw_log_scan_status=0
        rg --text --fixed-strings --file "$sensitive_file" "$raw_logs" >/dev/null || raw_log_scan_status=$?
        if ((raw_log_scan_status == 0)); then
            printf 'Unsanitized telemetry logs contain generated credentials for %s.\n' "$trial" >&2
            return 1
        fi
        if ((raw_log_scan_status > 1)); then
            printf 'Unable to scan generated credentials in telemetry logs for %s (rg exit %s).\n' \
                "$trial" "$raw_log_scan_status" >&2
            return 1
        fi
    done
    raw_log_scan_status=0
    rg --text --fixed-strings "$owner_email" "$raw_logs" >/dev/null || raw_log_scan_status=$?
    if ((raw_log_scan_status == 0)); then
        printf 'Unsanitized telemetry logs contain the synthetic owner identity for %s.\n' "$trial" >&2
        return 1
    fi
    if ((raw_log_scan_status > 1)); then
        printf 'Unable to scan the synthetic owner identity in telemetry logs for %s (rg exit %s).\n' \
            "$trial" "$raw_log_scan_status" >&2
        return 1
    fi
    jq --arg ownerEmail "$owner_email" '
      def forbidden_key:
        . != "EventId" and . != "RequestPath" and
        test("(artifact|capture|candidate|event|agent)[._-]?id|hash|sha256|path|payload|token|secret|connection[._-]?string"; "i");
      def forbidden_value:
        test("(^|[^0-9A-Fa-f])[0-9A-Fa-f]{64}([^0-9A-Fa-f]|$)|[0-9a-fA-F]{8}-[0-9a-fA-F-]{27,}|/(var|run|tmp|app|home|workspaces)/[^[:space:]]+|://");
      def scrub_string:
        split($ownerEmail) | join("[REDACTED-OWNER]") |
        if forbidden_value then "[REDACTED]" else . end;
      walk(
        if type == "object" and has("attributes") and (.attributes | type == "array") then
          .attributes |= map(select((.key | forbidden_key) | not))
        elif type == "string" then
          scrub_string
        else
          .
        end)
    ' "$trial_result/evidence/runtime/logs.json" > "$trial_result/evidence/runtime/logs.sanitized.json"
    mv "$trial_result/evidence/runtime/logs.sanitized.json" "$trial_result/evidence/runtime/logs.json"
    mv "$trial_result/evidence/runtime/logs.json" "$trial_result/evidence/runtime/logs.jsonl"
    mv "$trial_result/evidence/runtime/traces.json" "$trial_result/evidence/runtime/traces.jsonl"
    cp "$trial_result/evidence/health.json" "$trial_result/evidence/runtime/health.json"
    cp "$trial_result/evidence/process.csv" "$trial_result/evidence/runtime/process.csv"
    jq -n \
        --argjson strict "$([[ "$trial_kind" == w6 ]] && printf true || printf false)" \
        --argjson phase14 "$collect_phase14" \
        --arg trial "$trial" \
        --arg trialKind "$trial_kind" \
        --arg replayProfile "$replay_profile" \
        --slurpfile traces "$trial_result/evidence/runtime/traces.jsonl" \
        --slurpfile metrics "$trial_result/evidence/runtime/metrics.json" \
        --slurpfile logs "$raw_logs" '
      def attribute_values: .value | .. | scalars | tostring;
      def attribute_value: first(attribute_values) // "";
      def trace_names: [$traces[] | .resourceSpans[]?.scopeSpans[]?.spans[]?.name] | unique;
      def metric_points: [$metrics[] | .resourceMetrics[]? | .scopeMetrics[]? as $scope |
        $scope.metrics[]? as $metric |
        ($metric.sum.dataPoints[]?, $metric.gauge.dataPoints[]?, $metric.histogram.dataPoints[]?) |
        {scope: $scope.scope.name, metric: $metric.name, unit: ($metric.unit // ""), attributes: (.attributes // [])}];
      def metric_names: [metric_points[].metric] | unique;
      def metric_scopes: [metric_points[].scope] | unique;
      def metric_units: reduce metric_points[] as $point ({}; .[$point.metric] = $point.unit);
       def log_records: [$logs[] | .resourceLogs[]?.scopeLogs[]?.logRecords[]?];
       def log_event_id:
         first(.attributes[]? | select(.key == "EventId") | attribute_values | tonumber?) // null;
       def severe_logs: [log_records[] |
         select(.severityNumber >= 17) | {severity: .severityText}];
       def warning_limits: {"15": 16, "35": 4, "103": 64, "2013": 4, "2029": 2, "2048": 64, "2055": 4, "2067": 2};
       def log_body: [.body? | .. | strings] | first // "";
       def log_source:
         first(.attributes[]? | select(.key == "SourceContext") | attribute_values) // "";
       def expected_warning:
         (log_event_id) as $event_id | (log_body) as $body | (log_source) as $source |
         if $event_id == 15 then
           $body == "[REDACTED]" and $source == "Microsoft.AspNetCore.Hosting.Diagnostics"
         elif $event_id == 35 then
           $body == "[REDACTED]" and
           $source == "Microsoft.AspNetCore.DataProtection.KeyManagement.XmlKeyManager"
         elif $event_id == 103 then
           $source == "Microsoft.Extensions.Diagnostics.HealthChecks.DefaultHealthCheckService" and
           ($body == "[REDACTED]" or
              (($body | test("^Health check \"(calibration-library|capture-admission|capture-processing|disk-pressure|environmental-acquisition|raw-ingress)\" with status Degraded ")) and
               ($body | test("Calibration is required but no bundle is active|active calibration bundle has not completed startup validation|Calibration acquisition or reconciliation requires attention|Capture admission has not initialized|Capture admission is draining an in-flight capture|Capture processing has retryable graph work|Storage capacity has not been evaluated|Environmental acquisition has stale, missing, or failed sources|Raw ingress is accepting with reconciliation or pressure findings"))))
         elif $event_id == 2029 then
           $strict and $body == "[REDACTED]" and
           $source == "HVO.SkyMonitor.CameraAgent.Common.Background.RetentionBackgroundService"
         elif $event_id == 2048 then
           $source == "HVO.SkyMonitor.CameraAgent.Common.RawIngress.RawCaptureIngress" and
           ($body | test("^Raw ingress SQLite operation \"(checkpoint|commit)\" completed with result \"success\"$"))
         elif $event_id == 2013 then
           ($trial == "trial-1" or $phase14) and
           $source == "HVO.SkyMonitor.CameraAgent.Common.Capture.Distribution.StandardCaptureLaneHandler" and
           ($body | test("^Capture processing step \"(weather-overlay|cloud-presentation)\" failed"))
         elif $event_id == 2055 then
           $source == "HVO.SkyMonitor.CameraAgent.Common.RawIngress.RawCaptureIngress" and
           (((($trial == "trial-1") or $phase14) and ($body | test("^Capture lane \"standard\" scheduled retry attempt [23] because \"handler-failure\"$"))) or
            ($trial == "mono8-control" and $body == "Capture lane \"standard\" scheduled retry attempt 1 because \"handler-failure\""))
         elif $event_id == 2067 then
           $trial == "mono8-control" and
           $source == "HVO.SkyMonitor.CameraAgent.Common.Capture.Distribution.StandardCaptureLaneHandler" and
           $body == "Capture processing node \"annotation\" requested retry because \"environment.association-pending\""
         else false end;
      def application_metric_dimensions: [metric_points[] |
        select(.scope | startswith("HVO.SkyMonitor.")) as $point | $point.attributes[]? |
        {metric: $point.metric, key: .key, value: attribute_value}];
      def telemetry_dimension($signal; $location):
        {signal: $signal, location: $location, key: .key, value: attribute_values};
      def forbidden_key:
        . != "EventId" and . != "RequestPath" and
        test("(artifact|capture|candidate|event|agent)[._-]?id|hash|sha256|path|payload|token|secret|connection[._-]?string"; "i");
      def forbidden_value:
        test("(^|[^0-9A-Fa-f])[0-9A-Fa-f]{64}([^0-9A-Fa-f]|$)|[0-9a-fA-F]{8}-[0-9a-fA-F-]{27,}|/(var|run|tmp|app|home|workspaces)/[^[:space:]]+|://");
       def telemetry_dimensions: [
         ($traces[] | .resourceSpans[]? |
           .resource.attributes as $resource_attributes |
           .scopeSpans[]? |
             ($resource_attributes[]? | telemetry_dimension("trace"; "resource")),
             (.scope.attributes[]? | telemetry_dimension("trace"; "scope")),
             (.spans[]? |
               (.attributes[]? | telemetry_dimension("trace"; "span")),
               (.events[]?.attributes[]? | telemetry_dimension("trace"; "event")))),
         ($metrics[] | .resourceMetrics[]? |
           .resource.attributes as $resource_attributes |
           .scopeMetrics[]? |
             ($resource_attributes[]? | telemetry_dimension("metric"; "resource")),
             (.scope.attributes[]? | telemetry_dimension("metric"; "scope")),
             (.metrics[]? |
               (.sum.dataPoints[]?.attributes[]?, .gauge.dataPoints[]?.attributes[]?,
                .histogram.dataPoints[]?.attributes[]?) |
               telemetry_dimension("metric"; "data-point"))),
         ($logs[] | .resourceLogs[]? |
           .resource.attributes as $resource_attributes |
           .scopeLogs[]? |
             ($resource_attributes[]? | telemetry_dimension("log"; "resource")),
             (.scope.attributes[]? | telemetry_dimension("log"; "scope")),
             (.logRecords[]? |
               (.attributes[]? | telemetry_dimension("log"; "record")),
               ((.body? // empty) | .. | scalars | tostring |
                 {signal: "log", location: "body", key: null, value: .})))
       ];
      def required_units: {
        "camera_agent.capture.interval_ms": "ms",
        "camera_agent.capture_control.cycle.duration": "s",
        "camera_agent.ingress.committed.bytes": "By",
        "camera_agent.ingress.commit.duration": "s",
        "camera_agent.lanes.processing.duration": "s",
        "camera_agent.lanes.pending.bytes": "By",
