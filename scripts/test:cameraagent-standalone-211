read -r available_blocks block_size < <(stat -f --format='%a %S' "$BIND_LOCAL_ROOT")
available_bytes=$((available_blocks * block_size))
readonly DECLARED_BOUNDED_TRIAL_FOOTPRINT_BYTES=$((12 * 1024 * 1024 * 1024))
readonly MINIMUM_FREE_BYTES=$((20 * 1024 * 1024 * 1024))
required_footprint_headroom_bytes=$((4 * DECLARED_BOUNDED_TRIAL_FOOTPRINT_BYTES))
readonly REQUIRED_FREE_BYTES=$((required_footprint_headroom_bytes > MINIMUM_FREE_BYTES ? required_footprint_headroom_bytes : MINIMUM_FREE_BYTES))
if ((available_bytes < REQUIRED_FREE_BYTES)); then
    printf 'Issue #211 requires at least %s bytes free (20 GiB and four times the bounded trial footprint); found %s bytes.\n' "$REQUIRED_FREE_BYTES" "$available_bytes" >&2
    exit 2
fi

collector_config="$RESULTS/docker-config"
