printf '{"auths":{}}\n' > "$collector_config/config.json"
for image in "$HVO_OTEL_COLLECTOR_IMAGE" "$CENTRAL_DENY_IMAGE"; do
    if ! docker image inspect "$image" >/dev/null 2>&1; then
        DOCKER_CONFIG="$collector_config" docker pull "$image"
    fi
done
