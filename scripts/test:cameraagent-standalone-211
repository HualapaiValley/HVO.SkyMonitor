# Every generated secret whose literal value must never reach retained evidence, named once so a
# secret added to one scan cannot be missed by another. Each site prefixes "$trial_local/secrets/"
# and skips a name the current trial did not generate. `rg --file` aborts on a missing file, which
# is the case the guard exists for: the replay runner key exists only in the LocalRunner trial, so
# an unguarded site would fail every other trial's evidence gate rather than leak anything. A
# zero-byte file is the quieter half; rg reports no match and the scan silently asserts nothing.
readonly SECRET_FILE_NAMES=(owner-password owner-password-initial replay-runner-auth-key)

prepare_private_root() {
    local path="$1"
    local label="$2"
    local current mode
    if [[ "$path" != /* || "$path" == / || "$path" == *//* || "$path" == */./* ||
        "$path" == */../* || "$path" == */. || "$path" == */.. ||
        "$(realpath -m -- "$path" 2>/dev/null)" != "$path" ]]; then
        printf '%s must be a safe canonical absolute path: %s\n' "$label" "$path" >&2
        return 1
    fi
    current="$path"
    while [[ ! -e "$current" && ! -L "$current" ]]; do
        current="$(dirname -- "$current")"
    done
    if [[ ! -d "$current" || -L "$current" || "$(stat -c '%u' -- "$current" 2>/dev/null)" != "$LOCAL_UID" ]]; then
        printf '%s has an unsafe existing ancestor: %s\n' "$label" "$current" >&2
        return 1
    fi
    mode="$(stat -c '%a' -- "$current" 2>/dev/null)" || return 1
    if ((8#$mode != 0700)); then
        printf '%s must exist beneath an owner-only mode 0700 directory: %s\n' "$label" "$current" >&2
        return 1
    fi
    mkdir -p -- "$path"
    chmod 700 -- "$path"
    if [[ ! -d "$path" || -L "$path" || "$(stat -c '%u:%a' -- "$path" 2>/dev/null)" != "$LOCAL_UID:700" ]]; then
        printf '%s must be an owner-only non-symlink directory with mode 0700: %s\n' "$label" "$path" >&2
        return 1
    fi
}

if [[ -n "${HVO_PHASE14_TEST_ASSEMBLY_SHA_FILE:-}" ]]; then
    prepare_private_root "$(dirname "$HVO_PHASE14_TEST_ASSEMBLY_SHA_FILE")" 'HVO_PHASE14_TEST_ASSEMBLY_SHA_FILE parent'
fi

