        printf 'HVO_PHASE14 source revision and tree must be 40-character hexadecimal Git identities.\n' >&2
        exit 2
    fi
    prepare_private_root "$HVO_PHASE14_EVIDENCE_ALLOWED_ROOT" 'HVO_PHASE14_EVIDENCE_ALLOWED_ROOT'
    prepare_private_root "$HVO_PHASE14_EVIDENCE_ROOT" 'HVO_PHASE14_EVIDENCE_ROOT'
    if [[ "$HVO_PHASE14_EVIDENCE_ROOT" != "$HVO_PHASE14_EVIDENCE_ALLOWED_ROOT"/* ]]; then
        printf 'HVO_PHASE14_EVIDENCE_ROOT must be a child of HVO_PHASE14_EVIDENCE_ALLOWED_ROOT.\n' >&2
        exit 2
