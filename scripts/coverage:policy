#!/usr/bin/env bash
set -euo pipefail

# Reject any pull request that weakens an aggregate or component coverage
# baseline relative to its merge target, and require every classifier component
# to own a baseline.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

event_name="${1:-}"
base_ref="${2:-}"

baselines=(scripts/coverage/baseline.json)
component_count=0
while IFS= read -r component; do
  ((component_count += 1))
  baseline="scripts/coverage/baseline.$component.json"
  if [[ ! -f "$baseline" ]]; then
    printf 'Coverage component %s has no baseline at %s\n' "$component" "$baseline" >&2
    exit 1
  fi
  baselines+=("$baseline")
done < <(./scripts/coverage:component --list-components)

if (( component_count == 0 )); then
  printf 'No coverage component was listed; the baseline policy would validate nothing.\n' >&2
  exit 1
fi

for escape in "${below_aggregate_escapes[@]}"; do
  jq --exit-status --arg path "$escape" '.files[$path] != null' scripts/coverage/baseline.json > /dev/null || {
    printf 'Stale below_aggregate_escapes entry: %s has no aggregate floor.\n' "$escape" >&2
    exit 1
  }
done

for baseline in "${baselines[@]}"; do
  jq --exit-status '
    (.aggregate.line | type == "number" and . > 0 and . <= 1) and
    (.aggregate.branch | type == "number" and . > 0 and . <= 1) and
    (.aggregate.tolerancePercentagePoints | type == "number" and . >= 0 and . <= 1) and
    (.files | type == "object") and
    all(.files[];
      (.line | type == "number" and . >= 0 and . <= 1) and
      (.branch | type == "number" and . >= 0 and . <= 1))
  ' "$baseline" > /dev/null || {
    printf 'Coverage baseline is malformed: %s\n' "$baseline" >&2
    exit 1
  }
done

# Every aggregate file floor must also be enforced by the component lane that a
# change to that file selects, so a component plan cannot silently drop a risk
# floor the complete matrix enforces. A component floor may sit below the
# aggregate only for a path pinned here, and only when its entry also records a
# `belowAggregateReason`. Adding an escape is a change to this gate, not to data.
below_aggregate_escapes=(
  'HVO.SkyMonitor.AgentCore/ArtifactManifestV2.cs'
)

is_below_aggregate_escape() {
  local candidate="$1" escape
  for escape in "${below_aggregate_escapes[@]}"; do
    [[ "$escape" != "$candidate" ]] || return 0
  done
  return 1
}

component_of() {
  case "$1" in
    tools/* | HVO.SkyMonitor.Deployment.*) printf 'delivery\n' ;;
    HVO.SkyMonitor.CameraAgent*) printf 'cameraagent\n' ;;
    HVO.SkyMonitor.LogicHost*) printf 'logichost\n' ;;
    *) printf 'shared\n' ;;
  esac
}

while IFS= read -r aggregate_path; do
  source_path="$aggregate_path"
  [[ "$source_path" == tools/* ]] || source_path="src/$source_path"
  [[ -f "$source_path" ]] || continue
  owning_component="$(component_of "$aggregate_path")"
  escape_allowed=false
  ! is_below_aggregate_escape "$aggregate_path" || escape_allowed=true
  jq --exit-status \
    --arg path "$aggregate_path" \
    --argjson escapeAllowed "$escape_allowed" \
    --slurpfile aggregate scripts/coverage/baseline.json '
      ($aggregate[0].files[$path]) as $required |
      (.files[$path]) as $candidate |
      $candidate != null and
      ((($candidate.line >= $required.line) and ($candidate.branch >= $required.branch)) or
        ($escapeAllowed and
         ($candidate.belowAggregateReason | type == "string") and
         ($candidate.belowAggregateReason | length > 0)))
    ' "scripts/coverage/baseline.$owning_component.json" > /dev/null || {
    printf 'Component baseline %s must enforce the aggregate floor for %s, or the path must be listed in below_aggregate_escapes in this script with a belowAggregateReason on the entry.\n' \
      "scripts/coverage/baseline.$owning_component.json" "$aggregate_path" >&2
    exit 1
  }
done < <(jq -r '.files | keys[]' scripts/coverage/baseline.json)

if [[ "$event_name" != "pull_request" ]]; then
  printf 'Coverage policy validated %s baselines; non-pull-request events have no merge target.\n' \
    "${#baselines[@]}"
  exit 0
fi

if [[ -z "$base_ref" ]]; then
  printf 'A pull request coverage policy check requires a base ref.\n' >&2
  exit 1
fi

# Fail closed when the merge target is unavailable: without it, every baseline
# would look new and the non-regression gate would silently become a no-op.
if ! git rev-parse --verify --quiet "origin/$base_ref^{commit}" > /dev/null; then
  printf 'Merge target origin/%s is unavailable; the coverage non-regression check cannot run.\n' \
    "$base_ref" >&2
  exit 1
fi

comparison_dir="$(mktemp -d)"
trap 'rm -rf "$comparison_dir"' EXIT

for baseline in "${baselines[@]}"; do
  if ! git cat-file -e "origin/$base_ref:$baseline" 2>/dev/null; then
    printf 'New coverage baseline introduced by this pull request: %s\n' "$baseline"
    continue
  fi

  git show "origin/$base_ref:$baseline" > "$comparison_dir/base.json"
  jq --exit-status --slurpfile base "$comparison_dir/base.json" '
    . as $candidate |
    $candidate.aggregate.line >= $base[0].aggregate.line and
    $candidate.aggregate.branch >= $base[0].aggregate.branch and
    $candidate.aggregate.tolerancePercentagePoints <= $base[0].aggregate.tolerancePercentagePoints and
    all($base[0].files | to_entries[];
      $candidate.files[.key] != null and
      $candidate.files[.key].line >= .value.line and
      $candidate.files[.key].branch >= .value.branch)
  ' "$baseline" > /dev/null || {
    printf 'Coverage baseline %s is weaker than origin/%s.\n' "$baseline" "$base_ref" >&2
    exit 1
  }
  printf 'Coverage baseline %s is at or above origin/%s.\n' "$baseline" "$base_ref"
done

printf 'Coverage policy accepted %s baselines.\n' "${#baselines[@]}"
