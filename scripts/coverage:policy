#!/usr/bin/env bash
set -euo pipefail

# Reject any pull request that weakens an aggregate or component coverage
# baseline relative to its merge target, and require every classifier component
# to own a baseline.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

event_name="${1:-}"
base_ref="${2:-}"

policy="scripts/coverage/policy.json"
jq --exit-status '
  # Expanding the retired list requires an executable policy change and review;
  # editing policy data alone cannot turn a moved source into a new exemption.
  (.retiredSourcePaths | sort) == ([
    "HVO.SkyMonitor.AgentCore/ArtifactUploadManifest.cs",
    "HVO.SkyMonitor.Deployment.Cli/DistributionCatalogAcquirer.cs",
    "HVO.SkyMonitor.Deployment.Distribution/DistributionVerifier.cs",
    "HVO.SkyMonitor.Storage.FileSystem/AtomicPublisher.cs",
    "HVO.SkyMonitor.Storage.FileSystem/DurableSync.cs",
    "HVO.SkyMonitor.Storage.FileSystem/FileSystemFault.cs",
    "HVO.SkyMonitor.Storage.FileSystem/HardLinkPublisher.cs",
    "HVO.SkyMonitor.Storage.FileSystem/LinuxOpenFlags.cs",
    "HVO.SkyMonitor.Storage.FileSystem/PhysicalRoot.cs",
    "HVO.SkyMonitor.CameraAgent.Common/Upload/ArtifactOutboxDrainService.cs"
  ] | sort)
' "$policy" > /dev/null || {
  printf 'Malformed retired-source coverage policy: %s\n' "$policy" >&2
  exit 1
}
mapfile -t retired_source_paths < <(jq -r '.retiredSourcePaths[]' "$policy")
is_retired_source() {
  local path="$1" retired
  for retired in "${retired_source_paths[@]}"; do
    [[ "$path" != "$retired" ]] || return 0
  done
  return 1
}

baselines=(scripts/coverage/baseline.json)
component_count=0
while IFS= read -r component; do
  ((component_count += 1))
  baseline="scripts/coverage/baseline.$component.json"
  if [[ ! -f "$baseline" ]]; then
    printf 'Coverage component %s has no baseline at %s\n' "$component" "$baseline" >&2
    exit 1
  fi
  baselines+=("$baseline")
done < <(./scripts/coverage:component --list-components)

if (( component_count == 0 )); then
  printf 'No coverage component was listed; the baseline policy would validate nothing.\n' >&2
  exit 1
fi

# The only v1 local-only file is the documented catalog-dependent ReleaseTool
# path. Adding another exclusion requires changing this executable policy.
for baseline in "${baselines[@]}"; do
  jq --exit-status '
    (.aggregate.line | type == "number" and . > 0 and . <= 1) and
    (.aggregate.branch | type == "number" and . > 0 and . <= 1) and
    (.aggregate.tolerancePercentagePoints | type == "number" and . >= 0 and . <= 1) and
    (.files | type == "object") and
    all(.files[];
      (.line | type == "number" and . >= 0 and . <= 1) and
      (.branch | type == "number" and . >= 0 and . <= 1)) and
    all(.files | to_entries[];
      (.value | has("developmentV1LocalOnlyReason") | not) or
      (.key == "tools/HVO.SkyMonitor.Deployment.ReleaseTool/Program.cs" and
       (.value.developmentV1LocalOnlyReason | type == "string" and test("\\S"))))
  ' "$baseline" > /dev/null || {
    printf 'Coverage baseline is malformed: %s\n' "$baseline" >&2
    exit 1
  }
done

for retired in "${retired_source_paths[@]}"; do
  jq --exit-status --slurp --arg path "$retired" 'any(.[]; .files[$path] != null)' "${baselines[@]}" > /dev/null || {
    printf 'Pinned retired source %s has no canonical coverage floor.\n' "$retired" >&2
    exit 1
  }
done

# Source disappearance is not retirement. Check every baseline on every event,
# before the PR comparison, so renames cannot remove enforcement in the queue.
for baseline in "${baselines[@]}"; do
  while IFS= read -r path; do
    source_path="$path"
    [[ "$path" == tools/* ]] || source_path="src/$path"
    if [[ ! -f "$source_path" ]] && ! is_retired_source "$path"; then
      printf 'Required source path %s in %s is missing and is not a pinned retired path; restore it or review its move and floor mapping.\n' \
        "$path" "$baseline" >&2
      exit 1
    fi
  done < <(jq -r '.files | keys[]' "$baseline")
done

# Every aggregate file floor must also be enforced by the component lane that a
# change to that file selects, so a component plan cannot silently drop a risk
# floor the complete matrix enforces. A component floor may sit below the
# aggregate only for a path pinned here, and only when its entry also records a
# `belowAggregateReason`. Adding an escape is a change to this gate, not to data.
below_aggregate_escapes=(
  'HVO.SkyMonitor.AgentCore/ArtifactManifestV2.cs'
)

is_below_aggregate_escape() {
  local candidate="$1" escape
  for escape in "${below_aggregate_escapes[@]}"; do
    [[ "$escape" != "$candidate" ]] || return 0
  done
  return 1
}

for escape in "${below_aggregate_escapes[@]}"; do
  jq --exit-status --arg path "$escape" '.files[$path] != null' scripts/coverage/baseline.json > /dev/null || {
    printf 'Stale below_aggregate_escapes entry: %s has no aggregate floor.\n' "$escape" >&2
    exit 1
  }
done

component_of() {
  case "$1" in
    tools/* | HVO.SkyMonitor.Deployment.*) printf 'delivery\n' ;;
    HVO.SkyMonitor.CameraAgent*) printf 'cameraagent\n' ;;
    *) printf 'shared\n' ;;
  esac
}

while IFS= read -r aggregate_path; do
  source_path="$aggregate_path"
  [[ "$source_path" == tools/* ]] || source_path="src/$source_path"
  [[ -f "$source_path" ]] || continue
  owning_component="$(component_of "$aggregate_path")"
  escape_allowed=false
  ! is_below_aggregate_escape "$aggregate_path" || escape_allowed=true
  jq --exit-status \
    --arg path "$aggregate_path" \
    --argjson escapeAllowed "$escape_allowed" \
    --slurpfile aggregate scripts/coverage/baseline.json '
      ($aggregate[0].files[$path]) as $required |
      (.files[$path]) as $candidate |
      $candidate != null and
      ((($candidate.line >= $required.line) and ($candidate.branch >= $required.branch)) or
        ($escapeAllowed and
         ($candidate.belowAggregateReason | type == "string") and
         ($candidate.belowAggregateReason | length > 0)))
    ' "scripts/coverage/baseline.$owning_component.json" > /dev/null || {
    printf 'Component baseline %s must enforce the aggregate floor for %s, or the path must be listed in below_aggregate_escapes in this script with a belowAggregateReason on the entry.\n' \
      "scripts/coverage/baseline.$owning_component.json" "$aggregate_path" >&2
    exit 1
  }
done < <(jq -r '.files | keys[]' scripts/coverage/baseline.json)

if [[ "$event_name" != "pull_request" ]]; then
  printf 'Coverage policy validated %s baselines; non-pull-request events have no merge target.\n' \
    "${#baselines[@]}"
  exit 0
fi

if [[ -z "$base_ref" ]]; then
  printf 'A pull request coverage policy check requires a base ref.\n' >&2
  exit 1
fi

# Fail closed when the merge target is unavailable: without it, every baseline
# would look new and the non-regression gate would silently become a no-op.
if ! git rev-parse --verify --quiet "origin/$base_ref^{commit}" > /dev/null; then
  printf 'Merge target origin/%s is unavailable; the coverage non-regression check cannot run.\n' \
    "$base_ref" >&2
  exit 1
fi

comparison_dir="$(mktemp -d)"
trap 'rm -rf "$comparison_dir"' EXIT

# Issue #2178 deletes these component-only sources. A reintroduced source
# takes its existing floor, and a moved source keeps its floor at the new path.
removed_cameraagent_floors=(
  'HVO.SkyMonitor.CameraAgent.Common/Fleet/SqliteFleetStatusOutbox.cs'
  'HVO.SkyMonitor.CameraAgent.Common/Upload/ArtifactOutboxDrainService.cs'
  'HVO.SkyMonitor.CameraAgent.Common/Upload/ArtifactUploadClient.cs'
  'HVO.SkyMonitor.CameraAgent.Common/Upload/SqliteArtifactOutbox.cs'
)
removed_floors_json="$(
  for path in "${removed_cameraagent_floors[@]}"; do
    if [[ ! -e "src/$path" && ! -L "src/$path" ]]; then
      printf '%s\n' "$path"
    fi
  done | jq -Rnc '[inputs]'
)"
environmental_outbox='HVO.SkyMonitor.CameraAgent.Common/Environmental/SqliteEnvironmentalObservationOutbox.cs'
environmental_store='HVO.SkyMonitor.CameraAgent.Common/Environmental/SqliteEnvironmentalObservationStore.cs'

for baseline in "${baselines[@]}"; do
  if ! git cat-file -e "origin/$base_ref:$baseline" 2>/dev/null; then
    printf 'New coverage baseline introduced by this pull request: %s\n' "$baseline"
    continue
  fi

  git show "origin/$base_ref:$baseline" > "$comparison_dir/base.json"
  component_retirements='[]'
  renamed_environmental=''
  if [[ "$baseline" == scripts/coverage/baseline.cameraagent.json ]]; then
    component_retirements="$removed_floors_json"
    if [[ ! -e "src/$environmental_outbox" && ! -L "src/$environmental_outbox" ]]; then
      renamed_environmental="$environmental_store"
    fi
  fi
  jq --exit-status --slurpfile base "$comparison_dir/base.json" \
    --argjson retired "$component_retirements" \
    --arg oldEnvironmental "$environmental_outbox" --arg renamedEnvironmental "$renamed_environmental" '
    . as $candidate |
    $candidate.aggregate.line >= $base[0].aggregate.line and
    $candidate.aggregate.branch >= $base[0].aggregate.branch and
    $candidate.aggregate.tolerancePercentagePoints <= $base[0].aggregate.tolerancePercentagePoints and
    all($base[0].files | to_entries[];
      .key as $path |
      if ($retired | index($path)) != null then
        true
      else
        (if $path == $oldEnvironmental and $renamedEnvironmental != "" then
           $renamedEnvironmental
         else
           $path
         end) as $candidatePath |
        $candidate.files[$candidatePath] != null and
        $candidate.files[$candidatePath].line >= .value.line and
        $candidate.files[$candidatePath].branch >= .value.branch
      end)
  ' "$baseline" > /dev/null || {
    printf 'Coverage baseline %s is weaker than origin/%s.\n' "$baseline" "$base_ref" >&2
    exit 1
  }
  jq --exit-status --slurpfile base "$comparison_dir/base.json" '
    . as $candidate |
    all($base[0].files | to_entries[] |
      select(.key | startswith("HVO.SkyMonitor.Storage.FileSystem/"));
      (.key | sub("^HVO[.]SkyMonitor[.]Storage[.]FileSystem/"; "HVO.SkyMonitor.LocalFiles/")) as $moved |
      $candidate.files[$moved] != null and
      $candidate.files[$moved].line >= .value.line and
      $candidate.files[$moved].branch >= .value.branch)
  ' "$baseline" > /dev/null || {
    printf 'Coverage baseline %s weakened the floor of a moved local file primitive.\n' "$baseline" >&2
    exit 1
  }
  printf 'Coverage baseline %s is at or above origin/%s.\n' "$baseline" "$base_ref"
done

printf 'Coverage policy accepted %s baselines.\n' "${#baselines[@]}"
