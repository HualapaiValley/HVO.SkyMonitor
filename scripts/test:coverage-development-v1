#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT
dotnet build "$repo_root/scripts/coverage/HVO.SkyMonitor.CoverageGate.csproj" \
  --configuration Release --output "$scratch/gate" --disable-build-servers -p:UseSharedCompilation=false -warnaserror > "$scratch/build.log" 2>&1 || {
  cat "$scratch/build.log" >&2
  exit 1
}
python3 - "$repo_root" "$scratch" <<'PY'
import copy
import json
import pathlib
import shutil
import subprocess
import sys
import xml.etree.ElementTree as ET

root, scratch = map(pathlib.Path, sys.argv[1:])
canonical = json.loads((root / "scripts/coverage/baseline.json").read_text())
path = "HVO.SkyMonitor.Astronomy/CameraGeometry.cs"
release = "tools/HVO.SkyMonitor.Deployment.ReleaseTool/Program.cs"
retired = "HVO.SkyMonitor.AgentCore/ArtifactUploadManifest.cs"
baseline = copy.deepcopy(canonical)
baseline["files"] = {key: copy.deepcopy(canonical["files"][key]) for key in (path, release, retired)}
baseline_file = scratch / "repo/scripts/coverage/baseline.json"
baseline_file.parent.mkdir(parents=True)
baseline_file.write_text(json.dumps(baseline))
for source in (scratch / "repo/src" / path, scratch / "repo" / release):
    source.parent.mkdir(parents=True, exist_ok=True)
    source.touch()


def report(name, *, filename=path, hits=1, covered=2, empty=False, release_data=False):
    document = ET.Element("coverage")
    classes = ET.SubElement(ET.SubElement(ET.SubElement(document, "packages"), "package", name="fixture"), "classes")
    lines = ET.SubElement(ET.SubElement(classes, "class", name="Fixture", filename=filename), "lines")
    if not empty:
        for number in range(1, 101):
            line = ET.SubElement(lines, "line", number=str(number), hits=str(hits), branch="false")
            if number == 1:
                line.set("branch", "true")
                line.set("condition-coverage", f"{covered * 50}% ({covered}/2)")
    if release_data:
        lines = ET.SubElement(ET.SubElement(classes, "class", name="Release", filename=release), "lines")
        ET.SubElement(lines, "line", number="1", hits="0", branch="true", **{"condition-coverage": "0% (0/2)"})
    output = scratch / f"{name}.xml"
    ET.ElementTree(document).write(output)
    return output


cases = 0


def check(name, report_file, expected, *needles, profile=True):
    global cases
    command = ["dotnet", str(scratch / "gate/HVO.SkyMonitor.CoverageGate.dll")]
    if profile:
        command += ["--development-v1"]
    result = subprocess.run([*command, str(baseline_file), str(report_file)], capture_output=True, text=True)
    output = result.stdout + result.stderr
    if result.returncode != expected or any(needle not in output for needle in needles):
        raise SystemExit(f"FAIL {name}: exit={result.returncode}\n{output}")
    cases += 1
    print(f"PASS {name}")


good = report("good")
check("measured floors pass; absent catalog and retired source are explicit", good, 0,
      "Coverage gate passed.", f"SKIP {release}", "HVO_PRODUCTION_CATALOG_BUNDLE", f"SKIP {retired}", "source file is absent")
check("real line-count violation fails", report("line-failure", hits=0), 1,
      path, "line 0.00", "min 95.00", "add tests")
check("real branch-count violation fails", report("branch-failure", covered=1), 1,
      path, "branch 50.00", "min 90.00")
check("missing enforced file fails", report("missing", filename="Other.cs"), 1,
      path, "measured coverage MISSING", "floors line 95.00")
check("empty file data does not become 100%", report("empty", empty=True), 1,
      path, "no executable line data")
check("default gate also rejects an empty enforced file", report("empty-full", empty=True), 1,
      path, "no executable line data", profile=False)
check("catalog-dependent failure is explicitly local-only in v1", report("catalog-absent", release_data=True), 0,
      f"SKIP {release}", "Coverage gate passed.")
check("default canonical gate still enforces the catalog-dependent floor", report("full-catalog-absent", release_data=True), 1,
      release, "min 50.00", profile=False)
check("default canonical gate still rejects missing paths", report("full-missing", filename="Other.cs"), 1,
      path, "missing from the supplied reports", profile=False)

missing_branch = ET.parse(good)
line = missing_branch.find(".//line")
del line.attrib["condition-coverage"]
missing_branch.write(scratch / "missing-branch.xml")
check("declared branches without counts fail", scratch / "missing-branch.xml", 1,
      path, "measured branch data MISSING", "90.00")
check("default gate also rejects missing branch counts", scratch / "missing-branch.xml", 1,
      path, "measured branch data MISSING", profile=False)
del line.attrib["branch"]
missing_branch.write(scratch / "missing-branch-marker.xml")
check("absent branch declarations fail", scratch / "missing-branch-marker.xml", 1,
      path, "measured branch data MISSING")
line.set("branch", "false")
missing_branch.write(scratch / "branchless.xml")
check("explicitly branchless files remain valid", scratch / "branchless.xml", 0,
      "Coverage gate passed.", "(0/0)")

source = scratch / "repo/src" / path
source.rename(source.with_suffix(".moved.cs"))
check("a moved enforced source fails even with its original coverage", good, 1,
      path, "not a pinned retired path")
source.with_suffix(".moved.cs").rename(source)

# A runtime-only floor bump must affect the same evaluator; no threshold is
# copied into the development profile or its wrapper.
baseline["files"][path]["line"] = 1.0
baseline_file.write_text(json.dumps(baseline))
one_uncovered = ET.parse(good)
one_uncovered.find(".//line").set("hits", "0")
one_uncovered.write(scratch / "bumped.xml")
check("changed shared definition changes v1 enforcement", scratch / "bumped.xml", 1,
      "line 99.00", "min 100.00")

# Regression for the signed merged representation produced when two positive
# Int32.MaxValue counters wrap to -2. Keep this independent of ReportGenerator's
# source/method coalescing choices in miniature inputs; the real shared lane is
# validated separately with full instrumentation.
overflow_baseline = copy.deepcopy(baseline)
overflow_baseline["files"] = {path: copy.deepcopy(canonical["files"][path])}
baseline_file.write_text(json.dumps(overflow_baseline))
wrapped = ET.parse(good)
for line in wrapped.findall(".//line"):
    line.set("hits", "-2")
merged_overflow = scratch / "wrapped-merged.xml"
wrapped.write(merged_overflow)
check("canonical gate treats signed wrapped merged hits as covered", merged_overflow, 0,
      "line 100.00", "Coverage gate passed.", profile=False)
check("v1 still rejects negative hit counts", merged_overflow, 1, "Invalid negative line hits")
baseline_file.write_text(json.dumps(baseline))

# Preserve canonical exclusions; only Include and SingleHit differ. Derive
# assembly expectations from the baseline so new floor owners need no test pin.
settings_file = scratch / "v1.runsettings"
subprocess.run([str(root / "scripts/coverage:development-v1"), "--settings", str(settings_file)], check=True)
original = ET.parse(root / "tests/coverage.runsettings")
generated = ET.parse(settings_file)
include = generated.find(".//Configuration/Include")
expected = set()
for floor_path, floor in canonical["files"].items():
    source = root / floor_path if floor_path.startswith("tools/") else root / "src" / floor_path
    if source.is_file() and not floor.get("developmentV1LocalOnlyReason"):
        owner = floor_path.split("/")[1 if floor_path.startswith("tools/") else 0]
        expected.add(f"[{owner}]*")
actual = set(include.text.split(","))
if actual != expected:
    raise SystemExit(f"Generated assembly Include differs from active floor owners: expected={sorted(expected)}, actual={sorted(actual)}")
single_hit = generated.find(".//Configuration/SingleHit")
if single_hit is None or single_hit.text != "true":
    raise SystemExit("Generated coverage must enable SingleHit to bound Unit-stage overhead")
original_single_hit = original.find(".//Configuration/SingleHit")
if original_single_hit is None:
    generated.find(".//Configuration").remove(single_hit)
else:
    single_hit.text = original_single_hit.text
include.text = original.find(".//Configuration/Include").text
assert ET.tostring(generated.getroot()) == ET.tostring(original.getroot())
cases += 1
print("PASS settings derive floor owners and retain exclusions with SingleHit enabled")

results = scratch / "results"
results.mkdir()
result = subprocess.run([str(root / "scripts/coverage:development-v1"), str(results), str(scratch / "coverage")],
                        capture_output=True, text=True)
assert result.returncode == 1 and "Missing or extra Unit coverage data" in result.stderr
cases += 1
print("PASS missing Unit reports fail before merging")

# Build an independent two-source assembly for report-inventory fixtures. Its
# portable PDB, not a coverage-derived file list, determines expected input.
inventory_repo = scratch / "inventory-repo"
assembly_name = "HVO.SkyMonitor.Astronomy"
source_dir = inventory_repo / "src" / assembly_name
source_dir.mkdir(parents=True)
for filename, type_name in (("CameraGeometry.cs", "InventoryA"), ("InventorySentinel.cs", "InventoryB")):
    (source_dir / filename).write_text(f"namespace CoverageFixture; public static class {type_name} {{ public static int Value() => 1; }}\n")
(source_dir / "CameraGeometry.cs").write_text("namespace CoverageFixture; public static class InventoryA\n{\n    public static int Value() => 1;\n    public static int Other() => 1;\n    [System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage] public static int Excluded() => 1;\n}\n")
(source_dir / "Excluded.cs").write_text("namespace CoverageFixture; [System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage] public static class ExcludedType { public static int Value() => 1; }\n")
fixture_project = inventory_repo / "Inventory.csproj"
fixture_project.write_text(f"""<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup>
<TargetFramework>net10.0</TargetFramework><AssemblyName>{assembly_name}</AssemblyName>
<EnableDefaultCompileItems>false</EnableDefaultCompileItems><DebugType>portable</DebugType>
</PropertyGroup><ItemGroup><Compile Include="src/**/*.cs" /></ItemGroup></Project>""")
assembly_output = inventory_repo / "tests/Fixture.Tests/bin/Release/net10.0"
result = subprocess.run(["dotnet", "build", str(fixture_project), "--configuration", "Release", "--output", str(assembly_output),
                         "--disable-build-servers", "-p:UseSharedCompilation=false"], capture_output=True, text=True)
if result.returncode != 0:
    raise SystemExit(f"Inventory fixture build failed: {result.stdout}{result.stderr}")
shutil.copy2(assembly_output / f"{assembly_name}.dll", assembly_output / "Fixture.Tests.dll")
shutil.copy2(assembly_output / f"{assembly_name}.deps.json", assembly_output / "Fixture.Tests.deps.json")
(inventory_repo / "tests/Fixture.Tests/test-categories.json").write_text('{"Unit":1}')
fixture_scripts = inventory_repo / "scripts"
fixture_scripts.mkdir()
shutil.copytree(root / "scripts/coverage", fixture_scripts / "coverage", ignore=shutil.ignore_patterns("bin", "obj"))
for name in ("coverage:development-v1", "coverage:enforce"):
    shutil.copy2(root / "scripts" / name, fixture_scripts / name)
fixture_baseline = copy.deepcopy(canonical)
fixture_baseline["files"] = {path: copy.deepcopy(canonical["files"][path])}
(fixture_scripts / "coverage/baseline.json").write_text(json.dumps(fixture_baseline))
results = inventory_repo / "results"
(results / "original").mkdir(parents=True)
(results / "attachment/In/computer").mkdir(parents=True)
valid = results / "original/coverage.cobertura.xml"
attachment = results / "attachment/In/computer/coverage.cobertura.xml"
(results / "fixture.trx").write_text(f"""<TestRun xmlns="http://microsoft.com/schemas/VisualStudio/TeamTest/2010">
<TestSettings><Deployment runDeploymentRoot="attachment" /></TestSettings>
<TestDefinitions><UnitTest><TestMethod codeBase="{assembly_output / 'Fixture.Tests.dll'}" /></UnitTest></TestDefinitions>
<ResultSummary><CollectorDataEntries><Collector collectorDisplayName="XPlat code coverage">
<UriAttachments><UriAttachment><A href="computer/coverage.cobertura.xml" /></UriAttachment></UriAttachments>
</Collector></CollectorDataEntries></ResultSummary></TestRun>""")
composite = ET.Element("coverage")
ET.SubElement(ET.SubElement(composite, "sources"), "source").text = str(inventory_repo)
classes = ET.SubElement(ET.SubElement(ET.SubElement(composite, "packages"), "package", name=assembly_name), "classes")
for index, filename in enumerate(("CameraGeometry.cs", "InventorySentinel.cs")):
    entry = ET.SubElement(classes, "class", name=f"CoverageFixture.Inventory{index}", filename=str(source_dir / filename),
                          **{"line-rate":"1", "branch-rate":"1"})
    lines = ET.SubElement(entry, "lines")
    for number in ((3, 4) if filename == "CameraGeometry.cs" else (1,)):
        ET.SubElement(lines, "line", number=str(number), hits="1", branch="true", **{"condition-coverage":"100% (2/2)"})


def write_fixture(document):
    ET.ElementTree(document).write(valid)
    shutil.copy2(valid, attachment)


def wrapper_case(name, expected, *needles):
    global cases
    result = subprocess.run([str(fixture_scripts / "coverage:development-v1"), str(results), str(inventory_repo / "coverage-output")],
                            capture_output=True, text=True)
    output = result.stdout + result.stderr
    if result.returncode != expected or any(needle not in output for needle in needles):
        raise SystemExit(f"FAIL {name}: exit={result.returncode}\n{output}")
    cases += 1
    print(f"PASS {name}")


write_fixture(composite)
wrapper_case("complete wrapper accepts a report matching independent DLL/PDB inventory", 0, "Coverage gate passed.")
valid.write_text("<coverage")
shutil.copy2(valid, attachment)
wrapper_case("one malformed report cannot be discarded by the merger", 1, str(valid), "Coverage input validation failed")
valid.write_text("<not-coverage />")
shutil.copy2(valid, attachment)
wrapper_case("a well-formed non-coverage input fails", 1, str(valid), "Expected a Cobertura")
broken = copy.deepcopy(composite)
line = broken.find(".//line")
del line.attrib["condition-coverage"]
write_fixture(broken)
wrapper_case("missing branch counters fail before merge", 1, path, "measured branch data MISSING")
partial = copy.deepcopy(composite)
partial.find(".//classes").remove(partial.findall(".//class")[1])
write_fixture(partial)
wrapper_case("partial report still covering every floor fails independent source inventory", 1,
             "materially incomplete", "InventorySentinel.cs")
partial_lines = copy.deepcopy(composite)
lines = partial_lines.find(".//class/lines")
lines.remove(lines.findall("line")[-1])
write_fixture(partial_lines)
wrapper_case("partial class data with every source still present fails PDB sequence points", 1,
             "materially incomplete", "sequence-point lines")
empty_report = ET.Element("coverage")
ET.SubElement(empty_report, "packages")
write_fixture(empty_report)
wrapper_case("a classless report is rejected for a project with included assemblies", 1, "incomplete assembly inventory")
write_fixture(composite)
# The declared TRX attachment is independent evidence of the original input.
valid.write_text(valid.read_text().replace('hits="1"', 'hits="0"'))
wrapper_case("replaced report fails TRX identity binding", 1, "no matching original coverage report")

# Raw Coverlet switch conditions need structural validation, not canonical math.
switch_report = ET.parse(good)
switch_line = switch_report.find(".//line")
switch_line.set("condition-coverage", "100% (5/5)")
switch_conditions = ET.SubElement(switch_line, "conditions")
for number in ("0", "1"):
    ET.SubElement(switch_conditions, "condition", number=number, type="jump", coverage="100%")
switch_file = scratch / "raw-switch.xml"
switch_report.write(switch_file)
result = subprocess.run(["dotnet", str(scratch / "gate/HVO.SkyMonitor.CoverageGate.dll"),
                         "--validate-reports", str(baseline_file), str(switch_file)],
                        capture_output=True, text=True)
if result.returncode != 0:
    raise SystemExit(f"Raw switch validation incorrectly evaluated canonical branch arities: {result.stdout}{result.stderr}")
cases += 1
print("PASS raw switch validation accepts unequal condition arities")
result = subprocess.run(["dotnet", str(scratch / "gate/HVO.SkyMonitor.CoverageGate.dll"),
                         "--development-v1", "--validate-reports", str(baseline_file), str(switch_file)],
                        capture_output=True, text=True)
if result.returncode != 1 or "requires --unit-results" not in result.stderr:
    raise SystemExit("V1 input validation accepted structural checks without an independent inventory")
cases += 1
print("PASS v1 input validation cannot bypass the independent Unit inventory")

# Exercise the actual policy, including the rule against turning arbitrary
# low-coverage files into new local-only exceptions. This fixture is not a Git
# worktree and never mutates the caller's baselines.
policy_scripts = scratch / "policy-repo/scripts"
(policy_scripts / "coverage").mkdir(parents=True)
for script in ("coverage:policy", "coverage:component"):
    shutil.copy2(root / "scripts" / script, policy_scripts / script)
for source in (root / "scripts/coverage").glob("baseline*.json"):
    shutil.copy2(source, policy_scripts / "coverage" / source.name)
shutil.copy2(root / "scripts/coverage/policy.json", policy_scripts / "coverage/policy.json")
for baseline_path in (policy_scripts / "coverage").glob("baseline*.json"):
    for key in json.loads(baseline_path.read_text())["files"]:
        if key in policy["retiredSourcePaths"]:
            continue
        relative = pathlib.Path(key) if key.startswith("tools/") else pathlib.Path("src") / key
        source = policy_scripts.parent / relative
        source.parent.mkdir(parents=True, exist_ok=True)
        source.touch()
command = [str(policy_scripts / "coverage:policy"), "push", ""]
result = subprocess.run(command, capture_output=True, text=True)
assert result.returncode == 0, result.stdout + result.stderr
unauthorized = copy.deepcopy(canonical)
unauthorized["files"][path]["developmentV1LocalOnlyReason"] = "Unapproved exception"
(policy_scripts / "coverage/baseline.json").write_text(json.dumps(unauthorized))
result = subprocess.run(command, capture_output=True, text=True)
assert result.returncode == 1 and "malformed" in result.stderr
cases += 1
print("PASS actual policy rejects an arbitrary new v1 exclusion")

(policy_scripts / "coverage/baseline.json").write_text(json.dumps(canonical))
fixture = policy_scripts.parent
subprocess.run(["git", "init", "-q", str(fixture)], check=True)
subprocess.run(["git", "-C", str(fixture), "add", "."], check=True)
subprocess.run(["git", "-C", str(fixture), "-c", "user.name=Coverage fixture", "-c", "user.email=coverage@example.invalid",
                "-c", "commit.gpgsign=false", "-c", "core.hooksPath=/dev/null", "commit", "-qm", "fixture"], check=True)
subprocess.run(["git", "-C", str(fixture), "update-ref", "refs/remotes/origin/development/v1", "HEAD"], check=True)
source = fixture / "src/HVO.SkyMonitor.Imaging/SceneRenderers.cs"
for event, base_ref in (("push", ""), ("merge_group", ""), ("pull_request", "development/v1")):
    command = [str(policy_scripts / "coverage:policy"), event, base_ref]
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        raise SystemExit(f"Policy fixture failed before rename ({event}): {result.stdout}{result.stderr}")
    source.rename(source.with_suffix(".moved.cs"))
    result = subprocess.run(command, capture_output=True, text=True)
    source.with_suffix(".moved.cs").rename(source)
    if result.returncode != 1 or "SceneRenderers.cs" not in result.stderr or "not a pinned retired path" not in result.stderr:
        raise SystemExit(f"Policy accepted a renamed floor source ({event}): {result.stdout}{result.stderr}")
    cases += 1
    print(f"PASS moved SceneRenderers source fails actual policy on {event}")
    changed_policy = copy.deepcopy(policy)
    changed_policy["retiredSourcePaths"].append("HVO.SkyMonitor.Imaging/SceneRenderers.cs")
    (policy_scripts / "coverage/policy.json").write_text(json.dumps(changed_policy))
    source.rename(source.with_suffix(".moved.cs"))
    result = subprocess.run(command, capture_output=True, text=True)
    source.with_suffix(".moved.cs").rename(source)
    (policy_scripts / "coverage/policy.json").write_text(json.dumps(policy))
    if result.returncode != 1 or "retired-source coverage policy" not in result.stderr:
        raise SystemExit(f"Policy accepted a new retirement through a JSON edit ({event}): {result.stdout}{result.stderr}")
    cases += 1
    print(f"PASS rename plus retirement JSON edit fails policy on {event}")

print(f"Development v1 coverage contracts passed: {cases} behavioral cases.")
PY
