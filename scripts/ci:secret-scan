#!/usr/bin/env bash
set -Eeuo pipefail
export LC_ALL=C

# Scan the Git history reachable from one commit (HEAD by default) for committed
# credentials (#1321). It runs gitleaks, pinned by version and release-archive
# SHA-256, with its default rules and the reviewed exceptions in .gitleaks.toml.
# The lines every reachable commit added are scanned, including what each merge's
# resolution added and text that Git shows as a binary diff, so a credential that a
# later commit removed is still found. CI runs it on development/v1 and main pull
# requests and pushes; run it locally the same way before pushing.
#
# The script prints counts and, for a finding, its rule, path, line and commit,
# nothing else. gitleaks redacts the matched text from its report. No tool's
# diagnostics are printed, because git and gitleaks can quote the configuration,
# .gitattributes or scanned text in them; a failure is described in the script's own
# words. Exit status: 0 no findings, 1 findings, 2 the scan could not be done (usage,
# an old Git, shallow clone, octopus merge, checksum or version mismatch, a failed
# step, an error that git or gitleaks reported, or a scan that did not read every
# commit with text to scan).
#
# HVO_GITLEAKS_CACHE_DIR keeps the downloaded archive between runs; it is verified
# on every use. HVO_GITLEAKS_BIN names a gitleaks binary for a host without a
# pinned archive; only its version is checked. HVO_SECRET_SCAN_REPO_ROOT scans
# another checkout with this repository's .gitleaks.toml, which is how
# scripts/test:ci-secret-scan scans its fixtures.

readonly GITLEAKS_VERSION='8.30.1'
readonly SCAN_TIMEOUT_SECONDS=150

# From here on every tool's stderr is discarded and the script's own messages go to
# the original stderr (fd 3). A step that fails without its own message is reported
# by line and exit status, and the scan exits 2; in a subshell the trap only exits, so
# the caller reports it once.
exec 3>&2 2>/dev/null

cannot_scan() {
    printf 'secret-scan: %s\n' "$*" >&3
    exit 2
}
# shellcheck disable=SC2317 # Invoked indirectly by the ERR trap.
on_error() {
    local status=$? line="$1"
    ((BASH_SUBSHELL == 0)) || exit "$status"
    cannot_scan "a step failed unexpectedly at line $line (exit $status)"
}
trap 'on_error "$LINENO"' ERR

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly CONFIG="$SCRIPT_DIR/../.gitleaks.toml"

revision='HEAD'
if (($# == 2)) && [[ "$1" == '--revision' ]]; then
    revision="$2"
elif (($# > 0)); then
    printf 'Usage: %s [--revision REV]\n' "${0##*/}" >&3
    exit 2
fi

for command in awk git grep head jq mktemp sort tar tr uname wc; do
    command -v "$command" >/dev/null || cannot_scan "requires $command"
done
git_version="$(git version)" || cannot_scan "git version failed (exit $?)"
if [[ ! "$git_version" =~ ^git\ version\ ([0-9]+)\.([0-9]+) ]] ||
    ((BASH_REMATCH[1] < 2 || (BASH_REMATCH[1] == 2 && BASH_REMATCH[2] < 36))); then
    cannot_scan "requires Git 2.36 or newer to scan merge resolutions (git log --diff-merges=remerge); this is $git_version"
fi
sha256_of() {
    if command -v sha256sum >/dev/null; then
        sha256sum -- "$1" | awk '{ print $1 }'
    else
        shasum -a 256 -- "$1" | awk '{ print $1 }'
    fi
}

# Neither a replacement ref nor these settings, from any configuration file including
# the repository's .git/config, may change what git shows. GIT_CONFIG_COUNT entries
# override every configuration file, as the options in LOG_OPTIONS below do.
# GIT_CONFIG_GLOBAL=/dev/null would leave .git/config in effect and drop settings a
# checkout can need, such as safe.directory.
export GIT_NO_REPLACE_OBJECTS=1 GIT_CONFIG_COUNT=2 \
    GIT_CONFIG_KEY_0=core.bigFileThreshold GIT_CONFIG_VALUE_0=512m \
    GIT_CONFIG_KEY_1=core.quotePath GIT_CONFIG_VALUE_1=true

requested_root="${HVO_SECRET_SCAN_REPO_ROOT:-$SCRIPT_DIR/..}"
REPO_ROOT="$(git -C "$requested_root" rev-parse --show-toplevel)" ||
    cannot_scan "$requested_root is not in a Git work tree"
readonly REPO_ROOT
[[ -f "$CONFIG" && ! -L "$CONFIG" ]] || cannot_scan ".gitleaks.toml is missing or not a regular file"
shallow="$(git -C "$REPO_ROOT" rev-parse --is-shallow-repository)" ||
    cannot_scan "git failed while checking for a shallow clone (exit $?)"
[[ "$shallow" == 'false' ]] ||
    cannot_scan 'the clone is shallow, so its history cannot be scanned; fetch it first (git fetch --unshallow)'
# Exceptions are recorded, with their reasons, only in the reviewed .gitleaks.toml.
[[ ! -e "$REPO_ROOT/.gitleaksignore" ]] ||
    cannot_scan '.gitleaksignore is not used here; record a reviewed exception in .gitleaks.toml'
commit="$(git -C "$REPO_ROOT" rev-parse --verify --quiet --end-of-options "$revision^{commit}")" ||
    cannot_scan 'the requested revision is not a commit'
readonly commit
# git log --diff-merges=remerge shows no diff for a merge of more than two parents, so
# what such a merge added could not be read.
octopus="$(git -C "$REPO_ROOT" rev-list --min-parents=3 --max-count=1 "$commit")" ||
    cannot_scan "git failed while looking for merges of more than two parents (exit $?)"
[[ -z "$octopus" ]] ||
    cannot_scan "merge ${octopus:0:12} has more than two parents; Git cannot show what such a merge added, so this history cannot be scanned"

work="$(mktemp -d)" || cannot_scan 'could not create a temporary directory'
trap 'rm -rf "$work"' EXIT

gitleaks_bin="${HVO_GITLEAKS_BIN-}"
if [[ -z "$gitleaks_bin" ]]; then
    case "$(uname -s)/$(uname -m)" in
        Linux/x86_64) platform='linux_x64' archive_sha256='551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb' ;;
        Linux/aarch64 | Linux/arm64) platform='linux_arm64' archive_sha256='e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080' ;;
        Darwin/arm64) platform='darwin_arm64' archive_sha256='b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5' ;;
        Darwin/x86_64) platform='darwin_x64' archive_sha256='dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709' ;;
        *) cannot_scan "no pinned gitleaks $GITLEAKS_VERSION archive for $(uname -s)/$(uname -m); set HVO_GITLEAKS_BIN to a gitleaks $GITLEAKS_VERSION binary" ;;
    esac
    command -v curl >/dev/null || cannot_scan 'requires curl'
    archive_name="gitleaks_${GITLEAKS_VERSION}_${platform}.tar.gz"
    cache_dir="${HVO_GITLEAKS_CACHE_DIR:-$work}"
    archive="$cache_dir/$archive_name"
    if [[ ! -f "$archive" ]]; then
        mkdir -p -- "$cache_dir" || cannot_scan "could not create $cache_dir"
        partial="$archive.partial.$$"
        if ! curl --proto '=https' --tlsv1.2 -fsSL --retry 3 -o "$partial" \
            "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/${archive_name}"; then
            rm -f -- "$partial"
            cannot_scan "could not download $archive_name"
        fi
        mv -f -- "$partial" "$archive" || cannot_scan "could not store $archive_name in $cache_dir"
    fi
    [[ "$(sha256_of "$archive")" == "$archive_sha256" ]] ||
        cannot_scan "$archive does not match the pinned SHA-256 of $archive_name"
    tar -xzf "$archive" -C "$work" gitleaks || cannot_scan "could not extract gitleaks from $archive_name"
    gitleaks_bin="$work/gitleaks"
fi
[[ -x "$gitleaks_bin" ]] || cannot_scan "gitleaks is not executable: $gitleaks_bin"
actual_version="$("$gitleaks_bin" version || true)"
if [[ "$actual_version" != "$GITLEAKS_VERSION" ]]; then
    [[ "$actual_version" =~ ^[0-9A-Za-z.+-]{1,32}$ ]] || actual_version='unrecognised output'
    cannot_scan "expected gitleaks $GITLEAKS_VERSION, got $actual_version from $gitleaks_bin"
fi

# gitleaks reads the patches of `git log -p -U0 $LOG_OPTIONS <revisions>`:
# - --root shows the root commit's content, which log.showRoot=false would leave out.
# - --diff-merges=remerge shows a two-parent merge as the difference between Git's own
#   re-merge of its parents, conflict markers included, and the committed result. What
#   a conflict resolution or any other change made in the merge added is scanned; a
#   merge that keeps Git's result shows nothing.
# - No --diff-filter. gitleaks' default, tuxdb, leaves out type changes, which can
#   replace a symlink with a whole file. gitleaks itself skips deleted and binary files.
# - The other options pin what configuration could change: a textconv or external diff
#   driver could rewrite or hide the content; the a/ and b/ prefixes, which paths and
#   exceptions depend on (diff.noprefix, diff.mnemonicPrefix); diff.relative; colour;
#   rename detection and the diff algorithm, which decide the lines a commit added; and
#   the commit header format that gitleaks parses. --full-index names each blob in full.
# - No --all, so the result depends on this commit's history alone and not on
#   whichever other refs a clone happens to hold.
readonly LOG_OPTIONS='--root --full-history --diff-merges=remerge --find-renames --diff-algorithm=myers --full-index --no-textconv --no-ext-diff --no-relative --src-prefix=a/ --dst-prefix=b/ --submodule=short --no-color --pretty=medium --date=default --no-decorate --no-abbrev-commit --no-notes --no-show-signature'

# account OUTPUT [OPTION...] REVISION...: lists, from the patches of
# `git log -p -U0 $LOG_OPTIONS [OPTION...] REVISION...`, each commit as
# "C <commit> <parents> <added>" and each file Git shows as a binary diff, unless it is
# deleted, as "B <commit> <new blob>".
#
# gitleaks counts a commit when it reads at least one hunk of a file the commit does not
# delete, and only then: it skips deleted files, and a binary file, archives included at
# --max-archive-depth 0, has no hunk. <added> is 1 for such a commit, so the same rule
# over the same patches gives the number it must report. A commit without such a hunk
# added no text: an empty commit, a deletion, a pure rename, a mode change, an empty or
# binary file, or a merge that keeps Git's result. grep -a keeps a NUL byte in a text
# diff from turning the stream into "binary file matches".
account() {
    local output="$1" codes
    shift
    # shellcheck disable=SC2086 # LOG_OPTIONS is split into git log arguments on purpose; it holds no glob or quoted value.
    git -C "$REPO_ROOT" log $LOG_OPTIONS -p -U0 --format='%x01%H %P' "$@" |
        grep -aE $'^(\x01|diff --git |index |Binary files |[+]{3} /dev/null$|@@ -)' |
        awk -v marker=$'\x01' '
            function close_file() {
                if (binary && blob !~ /^0+$/) print "B", sha, (blob == "" ? "-" : blob)
                binary = 0; blob = ""
            }
            function close_commit() {
                if (sha == "") return
                close_file()
                print "C", sha, parents, added
            }
            substr($0, 1, 1) == marker { close_commit(); sha = substr($1, 2); parents = NF - 1; added = 0; file = 0; next }
            /^diff --git / { close_file(); file = 1; deleted = 0; next }
            /^index / { blob = ($2 ~ /[.][.]/) ? substr($2, index($2, "..") + 2) : ""; next }
            /^Binary files / { binary = 1; next }
            /^[+][+][+] \/dev\/null$/ { deleted = 1; next }
            /^@@ -/ { if (file && !deleted) added = 1 }
            END { close_commit() }
        ' > "$output" && return
    codes=("${PIPESTATUS[@]}")
    ((codes[0] == 0)) || cannot_scan "git failed while listing the history of ${commit:0:12} (exit ${codes[0]})"
    cannot_scan "could not account for the commits reachable from ${commit:0:12}"
}

account "$work/history" "$commit"

# Git shows a file as a binary diff when either side has a NUL byte in its first 8000
# bytes, or when an attribute or setting says so (-diff, binary, a large file), and
# gitleaks reads no text from such a diff. Text it added would be missed: a binary file
# replaced by text, a binary conflict that a merge resolved as text, or a text file that
# .gitattributes marks as binary. So every commit with such a file whose new blob is text
# by Git's own rule, no NUL byte in its first 8000 bytes, is read again with --text.
awk '$1 == "B" { print $3 }' "$work/history" | sort -u > "$work/binary-blobs"
: > "$work/text-blobs"
while read -r blob; do
    [[ "$blob" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] ||
        cannot_scan "git did not name the blob of a file it shows as a binary diff in the history of ${commit:0:12}"
    git -C "$REPO_ROOT" cat-file blob "$blob" > "$work/blob" ||
        cannot_scan "git failed while reading a blob in the history of ${commit:0:12} (exit $?)"
    nuls="$(head -c 8000 "$work/blob" | tr -dc '\000' | wc -c)"
    ((nuls > 0)) || printf '%s\n' "$blob" >> "$work/text-blobs"
done < "$work/binary-blobs"
awk 'FILENAME == ARGV[1] { text[$1] = 1; next } $1 == "B" && ($3 in text) { print $2 }' \
    "$work/text-blobs" "$work/history" | sort -u > "$work/as-text"
awk 'FILENAME == ARGV[1] { again[$1] = 1; next }
    $1 == "C" {
        listed++; merge = ($3 > 1); merges += merge; added += $4
        if ($4 || ($2 in again)) { scanned++; scanned_merges += merge }
    }
    END { printf "%d %d %d %d %d\n", listed, merges, added, scanned, scanned_merges }
' "$work/as-text" "$work/history" > "$work/accounting"
read -r listed merges added scanned scanned_merges < "$work/accounting" ||
    cannot_scan "could not account for the commits reachable from ${commit:0:12}"
reachable="$(git -C "$REPO_ROOT" rev-list --count "$commit")" ||
    cannot_scan "git failed while counting the commits reachable from ${commit:0:12} (exit $?)"
((listed == reachable)) ||
    cannot_scan "git log listed $listed of the $reachable commits reachable from ${commit:0:12}"
((scanned > 0)) || cannot_scan "no commit reachable from ${commit:0:12} added text to scan"

as_text="$(($(wc -l < "$work/as-text")))"
if ((as_text > 0)); then
    as_text_revisions="$(tr '\n' ' ' < "$work/as-text")"
    as_text_revisions="${as_text_revisions% }"
    # shellcheck disable=SC2086 # The commit IDs are split into arguments on purpose.
    account "$work/as-text-history" --text --no-walk $as_text_revisions
    as_text_added="$(awk '$1 == "C" { added += $4 } END { print added + 0 }' "$work/as-text-history")"
    ((as_text_added == as_text)) ||
        cannot_scan "git log --text showed text in $as_text_added of the $as_text commits that Git shows as adding text in a binary diff"
fi

withheld="its log is not shown, because it can quote the configuration, .gitattributes or scanned text"
elapsed=0
# run_gitleaks NAME LOG_OPTS: runs gitleaks over the patches of `git log -p -U0 LOG_OPTS`,
# refuses a failed run or a run that logged an error, and sets gitleaks_status,
# gitleaks_scanned and gitleaks_findings from its log and its validated report,
# $work/NAME.json.
run_gitleaks() {
    local name="$1" log_opts="$2" started=$SECONDS errors
    gitleaks_status=0
    # --platform none: no finding links, so gitleaks makes no remote lookup, whose failure
    # it would log as an error.
    env -u GITLEAKS_CONFIG -u GITLEAKS_CONFIG_TOML "$gitleaks_bin" git \
        --config "$CONFIG" \
        --gitleaks-ignore-path "$work" \
        --ignore-gitleaks-allow \
        --max-archive-depth 0 \
        --platform none \
        --redact \
        --no-banner \
        --no-color \
        --log-level info \
        --exit-code 3 \
        --timeout "$SCAN_TIMEOUT_SECONDS" \
        --report-format json \
        --report-path "$work/$name.json" \
        --log-opts "$log_opts" \
        "$REPO_ROOT" > "$work/$name.log" 2>&1 || gitleaks_status=$?
    elapsed=$((elapsed + SECONDS - started))

    # The log is read, never printed: a malformed expression makes gitleaks panic and
    # quote it, and gitleaks logs git's own diagnostics, which can quote .gitattributes or
    # scanned text. gitleaks also exits 0 when git fails part way, having scanned only
    # what it read, so any error it logged fails the scan.
    if ((gitleaks_status != 0 && gitleaks_status != 3)); then
        grep -q '^panic: ' "$work/$name.log" &&
            cannot_scan "gitleaks stopped on an internal error (exit status $gitleaks_status), as a malformed expression in .gitleaks.toml causes; $withheld"
        cannot_scan "gitleaks exited with status $gitleaks_status; $withheld"
    fi
    errors="$(grep -cE '^[^ ]+ ERR \[git\] ' "$work/$name.log" || true)"
    ((errors == 0)) ||
        cannot_scan "git reported $errors problem(s) while gitleaks read the history (a malformed .gitattributes line is one cause), so the scan may be partial; $withheld"
    errors="$(grep -cE '^[^ ]+ (ERR|FTL) |^panic: ' "$work/$name.log" || true)"
    ((errors == 0)) || cannot_scan "gitleaks logged $errors error(s), so its scan may be partial; $withheld"
    gitleaks_scanned="$(awk 'NF == 5 && $2 == "INF" && $4 == "commits" && $5 == "scanned." { print $3 }' "$work/$name.log")"
    [[ "$gitleaks_scanned" =~ ^[0-9]+$ ]] || cannot_scan "gitleaks did not report how many commits it scanned; $withheld"

    # Only these validated fields of a finding are ever printed.
    gitleaks_findings="$(jq -er '
        if type == "array" and all(.[];
            (.RuleID | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) and
            (.File | type == "string" and length > 0) and
            (.StartLine | type == "number" and . >= 0 and . == floor) and
            (.Commit | type == "string" and test("^[0-9a-f]{40}$")))
        then length else error("unexpected report") end' "$work/$name.json")" ||
        cannot_scan 'gitleaks wrote no readable report'
    if ((gitleaks_status == 3 && gitleaks_findings == 0 || gitleaks_status == 0 && gitleaks_findings > 0)); then
        cannot_scan "gitleaks exit status $gitleaks_status disagrees with its $gitleaks_findings reported finding(s)"
    fi
}

reports=("$work/history.json")
run_gitleaks history "$LOG_OPTIONS $commit"
((gitleaks_scanned == added)) ||
    cannot_scan "gitleaks scanned $gitleaks_scanned commits, but $added of the $reachable commits reachable from ${commit:0:12} added text to scan; refusing a partial scan"
if ((as_text > 0)); then
    reports+=("$work/as-text.json")
    run_gitleaks as-text "$LOG_OPTIONS --text --no-walk $as_text_revisions"
    ((gitleaks_scanned == as_text)) ||
        cannot_scan "gitleaks read $gitleaks_scanned commits again as text, but $as_text commits added text that Git shows as a binary diff; refusing a partial scan"
fi

# A commit read in both passes can be reported twice; each finding is counted once.
jq -s 'add | unique_by([.RuleID, .File, .StartLine, .Commit])' "${reports[@]}" > "$work/findings.json" ||
    cannot_scan 'could not combine the gitleaks reports'
findings="$(jq -r 'length' "$work/findings.json")" || cannot_scan 'could not combine the gitleaks reports'
skipped=$((reachable - scanned))
if ((findings == 0)); then
    printf 'Secret scan passed: gitleaks %s scanned %s commits reachable from %s, %s of them merge resolutions, in %ss; no findings.\n' \
        "$GITLEAKS_VERSION" "$scanned" "${commit:0:12}" "$scanned_merges" "$elapsed"
    if ((as_text > 0)); then
        printf '%s of them added text that Git shows as a binary diff, which gitleaks read again with git log --text.\n' "$as_text"
    fi
    printf 'The other %s reachable commits added no text to scan: %s merges whose resolution added none, and %s commits that are empty or only delete, rename, change modes or add empty or binary files.\n' \
        "$skipped" "$((merges - scanned_merges))" "$((skipped - merges + scanned_merges))"
    exit 0
fi
# A path is printed only when it is printable ASCII without a backslash. In a merge's
# conflict resolution gitleaks reports the path with Git's b/ prefix: git writes a
# "remerge CONFLICT" line inside that file's header, and gitleaks then reads the path
# from the "+++ b/<path>" line. The path the merge holds is printed instead.
while IFS=$'\t' read -r rule file line sha; do
    if [[ "$file" == b/* ]] && ! git -C "$REPO_ROOT" cat-file -e "$sha:$file" &&
        git -C "$REPO_ROOT" cat-file -e "$sha:${file#b/}"; then
        file="${file#b/}"
    fi
    printf '%s %s:%s in commit %s\n' "$rule" "$file" "$line" "${sha:0:12}"
done < <(jq -r '.[] | [.RuleID,
    (.File | if test("^[ -~]+$") and (test("[\\\\]") | not) then . else "(a path with characters that are not shown)" end),
    .StartLine, .Commit] | @tsv' "$work/findings.json")
printf 'Secret scan failed: %s finding(s) in %s commits reachable from %s. The matched text is not shown.\n' \
    "$findings" "$scanned" "${commit:0:12}"
printf 'Revoke or rotate a real credential; do not rewrite history. Record a false positive, with its reason, in .gitleaks.toml.\n'
exit 1
