#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

# Scan the Git history reachable from one commit (HEAD by default) for committed
# credentials (#1321). It runs gitleaks, pinned by version and release-archive
# SHA-256, with its default rules and the reviewed exceptions in .gitleaks.toml.
# Every non-merge commit's added lines are scanned, so a credential that a later
# commit removed is still found. CI runs it on development/v1 and main pull
# requests and pushes; run it locally the same way before pushing.
#
# A finding is reported by rule, path, line, commit and fingerprint only. gitleaks
# redacts the matched text from its log and report, and this script prints
# neither. Exit status: 0 no findings, 1 findings, 2 the scan could not be done
# (usage, shallow clone, checksum or version mismatch, gitleaks failure, or a
# commit count that does not cover the history).
#
# HVO_GITLEAKS_CACHE_DIR keeps the downloaded archive between runs; it is verified
# on every use. HVO_GITLEAKS_BIN names a gitleaks binary for a host without a
# pinned archive; only its version is checked. HVO_SECRET_SCAN_REPO_ROOT scans
# another checkout with this repository's .gitleaks.toml, which is how
# scripts/test:ci-secret-scan scans its fixtures.

readonly GITLEAKS_VERSION='8.30.1'
readonly SCAN_TIMEOUT_SECONDS=150

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly CONFIG="$SCRIPT_DIR/../.gitleaks.toml"

cannot_scan() {
    printf 'secret-scan: %s\n' "$*" >&2
    exit 2
}

revision='HEAD'
if (($# == 2)) && [[ "$1" == '--revision' ]]; then
    revision="$2"
elif (($# > 0)); then
    printf 'Usage: %s [--revision REV]\n' "${0##*/}" >&2
    exit 2
fi

for command in awk git grep jq mktemp tar uname; do
    command -v "$command" >/dev/null 2>&1 || cannot_scan "requires $command"
done
sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum -- "$1" | awk '{ print $1 }'
    else
        shasum -a 256 -- "$1" | awk '{ print $1 }'
    fi
}

requested_root="${HVO_SECRET_SCAN_REPO_ROOT:-$SCRIPT_DIR/..}"
REPO_ROOT="$(git -C "$requested_root" rev-parse --show-toplevel 2>/dev/null)" ||
    cannot_scan "$requested_root is not in a Git work tree"
readonly REPO_ROOT
[[ -f "$CONFIG" && ! -L "$CONFIG" ]] || cannot_scan ".gitleaks.toml is missing or not a regular file"
[[ "$(git -C "$REPO_ROOT" rev-parse --is-shallow-repository)" == 'false' ]] ||
    cannot_scan 'the clone is shallow, so its history cannot be scanned; fetch it first (git fetch --unshallow)'
# Exceptions are recorded, with their reasons, only in the reviewed .gitleaks.toml.
[[ ! -e "$REPO_ROOT/.gitleaksignore" ]] ||
    cannot_scan '.gitleaksignore is not used here; record a reviewed exception in .gitleaks.toml'
commit="$(git -C "$REPO_ROOT" rev-parse --verify --quiet --end-of-options "$revision^{commit}")" ||
    cannot_scan "$revision is not a commit"
readonly commit

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

gitleaks_bin="${HVO_GITLEAKS_BIN-}"
if [[ -z "$gitleaks_bin" ]]; then
    case "$(uname -s)/$(uname -m)" in
        Linux/x86_64) platform='linux_x64' archive_sha256='551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb' ;;
        Linux/aarch64 | Linux/arm64) platform='linux_arm64' archive_sha256='e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080' ;;
        Darwin/arm64) platform='darwin_arm64' archive_sha256='b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5' ;;
        Darwin/x86_64) platform='darwin_x64' archive_sha256='dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709' ;;
        *) cannot_scan "no pinned gitleaks $GITLEAKS_VERSION archive for $(uname -s)/$(uname -m); set HVO_GITLEAKS_BIN to a gitleaks $GITLEAKS_VERSION binary" ;;
    esac
    command -v curl >/dev/null 2>&1 || cannot_scan 'requires curl'
    archive_name="gitleaks_${GITLEAKS_VERSION}_${platform}.tar.gz"
    cache_dir="${HVO_GITLEAKS_CACHE_DIR:-$work}"
    archive="$cache_dir/$archive_name"
    if [[ ! -f "$archive" ]]; then
        mkdir -p -- "$cache_dir"
        partial="$archive.partial.$$"
        if ! curl --proto '=https' --tlsv1.2 -fsSL --retry 3 -o "$partial" \
            "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/${archive_name}"; then
            rm -f -- "$partial"
            cannot_scan "could not download $archive_name"
        fi
        mv -f -- "$partial" "$archive"
    fi
    [[ "$(sha256_of "$archive")" == "$archive_sha256" ]] ||
        cannot_scan "$archive does not match the pinned SHA-256 of $archive_name"
    tar -xzf "$archive" -C "$work" gitleaks || cannot_scan "could not extract gitleaks from $archive_name"
    gitleaks_bin="$work/gitleaks"
fi
[[ -x "$gitleaks_bin" ]] || cannot_scan "gitleaks is not executable: $gitleaks_bin"
actual_version="$("$gitleaks_bin" version 2>/dev/null || true)"
[[ "$actual_version" == "$GITLEAKS_VERSION" ]] ||
    cannot_scan "expected gitleaks $GITLEAKS_VERSION, got ${actual_version:-<unreadable>} from $gitleaks_bin"

# gitleaks reads the patches of this git log: its default options without --all, so
# the result depends on this commit's history alone and not on whichever other refs
# a clone happens to hold. The same selection counts the commits it must report.
readonly LOG_OPTIONS="--full-history --diff-filter=tuxdb $commit"
# shellcheck disable=SC2086 # LOG_OPTIONS is split into git log arguments on purpose; it holds no glob or quoted value.
git -C "$REPO_ROOT" log --format='%x01%H' --name-only $LOG_OPTIONS > "$work/commits" ||
    cannot_scan "git log failed for ${commit:0:12}"
expected_commits="$(grep -c $'^\x01' "$work/commits" || true)"
((expected_commits > 0)) || cannot_scan "no commit reachable from ${commit:0:12} has changes to scan"

report="$work/report.json"
log="$work/gitleaks.log"
started=$SECONDS
status=0
env -u GITLEAKS_CONFIG -u GITLEAKS_CONFIG_TOML "$gitleaks_bin" git \
    --config "$CONFIG" \
    --gitleaks-ignore-path "$work" \
    --ignore-gitleaks-allow \
    --redact \
    --no-banner \
    --no-color \
    --log-level info \
    --exit-code 3 \
    --timeout "$SCAN_TIMEOUT_SECONDS" \
    --report-format json \
    --report-path "$report" \
    --log-opts "$LOG_OPTIONS" \
    "$REPO_ROOT" > "$log" 2>&1 || status=$?
elapsed=$((SECONDS - started))
# The log carries only counts and timings: findings appear in it only in verbose mode, and redacted.
sed 's/^/gitleaks: /' "$log" >&2
((status == 0 || status == 3)) || cannot_scan "gitleaks exited with status $status"

scanned_commits="$(awk '{ for (i = 1; i < NF; i++) if ($(i + 1) == "commits" && $(i + 2) == "scanned.") print $i }' "$log")"
[[ "$scanned_commits" =~ ^[0-9]+$ && "$scanned_commits" == "$expected_commits" ]] ||
    cannot_scan "gitleaks scanned ${scanned_commits:-an unknown number of} commits, but ${expected_commits} commits reachable from ${commit:0:12} have changes; refusing a partial scan"
findings="$(jq -er 'if type == "array" then length else error("not an array") end' "$report" 2>/dev/null)" ||
    cannot_scan 'gitleaks wrote no readable report'
if ((status == 0 && findings == 0)); then
    printf 'Secret scan passed: gitleaks %s scanned %s commits reachable from %s in %ss; no findings.\n' \
        "$GITLEAKS_VERSION" "$scanned_commits" "${commit:0:12}" "$elapsed"
    exit 0
fi
((status == 3 && findings > 0)) || cannot_scan "gitleaks exit status $status disagrees with its $findings reported finding(s)"
jq -r '.[] | "\(.RuleID) \(.File):\(.StartLine) in commit \(.Commit[0:12]) (fingerprint \(.Fingerprint))"' "$report"
printf 'Secret scan failed: %s finding(s) in %s commits reachable from %s. The matched text is not shown.\n' \
    "$findings" "$scanned_commits" "${commit:0:12}"
printf 'Revoke or rotate a real credential; do not rewrite history. Record a false positive, with its reason, in .gitleaks.toml.\n'
exit 1
