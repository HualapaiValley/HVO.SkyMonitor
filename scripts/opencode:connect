#!/usr/bin/env bash
# Attach a new terminal client to this devcontainer's persistent OpenCode server.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
readonly REPO_ROOT
# shellcheck source=.devcontainer/opencode-host.conf disable=SC1091
source "$REPO_ROOT/.devcontainer/opencode-host.conf"

if [[ ! -t 0 || ! -t 1 ]]; then
    echo "OpenCode connection requires an interactive terminal." >&2
    exit 1
fi
if [[ -f /.dockerenv ]]; then
    readonly PORT="${OPENCODE_CONTAINER_PORT:?OPENCODE_CONTAINER_PORT is required}"
    readonly PASSWORD_FILE="${OPENCODE_DATA_DIR:-$HOME/.local/share/opencode}/server-password"
    readonly OPENCODE_BINARY=/usr/local/bin/opencode
else
    readonly PORT="${OPENCODE_HOST_PORT:?OPENCODE_HOST_PORT is required}"
    readonly PASSWORD_FILE="$REPO_ROOT/.devcontainer/state/opencode-data/server-password"
    OPENCODE_BINARY="$(command -v opencode 2>/dev/null || true)"
    readonly OPENCODE_BINARY
fi
if [[ -z "$OPENCODE_BINARY" || ! -x "$OPENCODE_BINARY" ]]; then
    echo "A compatible OpenCode CLI is not installed in this environment." >&2
    exit 1
fi
if [[ ! -s "$PASSWORD_FILE" ]]; then
    echo "OpenCode password is missing at $PASSWORD_FILE." >&2
    exit 1
fi

server_password="$(<"$PASSWORD_FILE")"
export OPENCODE_SERVER_PASSWORD="$server_password"
exec "$OPENCODE_BINARY" attach "http://127.0.0.1:${PORT}" "$@"
