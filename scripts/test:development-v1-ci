    for name, candidate in (
        ("default discovery", source.replace(executable + ' "${workflows[@]}"', executable)),
        ("case-sensitive discovery", source.replace("-iname", "-name")),
        ("empty workflow list allowed", source.replace(lint_commands(executable)[2], "true")),
        ("hidden workflows excluded", source.replace("find .github/workflows -type f", "find .github/workflows -type f ! -name '.*'")),
    ):
        mutations += ((f"{profile} {name}", candidate, full) if profile == "Preflight"
                      else (f"{profile} {name}", short, candidate),)
with tempfile.TemporaryDirectory(prefix="hvo-v1-workflows-") as directory:
    fixture = pathlib.Path(directory)
    (fixture / "benign.yml").write_text(spoof_workflow("Benign"))
    (fixture / "ignored.txt").write_text(spoof_workflow("hvo/reviewed-head"))
    (fixture / "spoof.yaml").write_text(spoof_workflow("Benign YAML"))
    (fixture / ".hidden.YML").write_text(spoof_workflow("Hidden"))
    (fixture / "upper.YAML").write_text(spoof_workflow("Upper"))
    discovered = read_workflows(fixture)
    if set(discovered) != {"benign.yml", "spoof.yaml", ".hidden.YML", "upper.YAML"} or violations(short, full, queue_gate, discovered):
        raise SystemExit("Both workflow extensions must be discovered and safe names must pass")
    (fixture / "spoof.yaml").write_text(spoof_workflow("hvo/reviewed-head"))
    if not violations(short, full, queue_gate, read_workflows(fixture)):
        raise SystemExit("Discovered .yaml spoof workflow was not rejected")
    print("R2 file discovery: benign .yml/.yaml pass; .yaml spoof rejected.")
# R3: on.pull_request must not shadow jobs.pull_request in the job helper.
shadow = ("name: Event shadow\non:\n  pull_request:\n    types: [opened]\n"
          "jobs:\n  pull_request:\n    name: Benign\n    runs-on: ubuntu-24.04\n"
          "    steps:\n      - run: 'true'\n")
if "types:" in job(shadow, "pull_request") or "name: Benign" not in job(shadow, "pull_request"):
    raise SystemExit("Event block shadowed a job with the same id")
if violations(short, full, queue_gate, {"shadow.yml": shadow}):
    raise SystemExit("Benign event/job id overlap must pass")
mutations += (("event name shadows reserved job", short, full, queue_gate,
               {"shadow.yml": shadow.replace("name: Benign", "name: hvo/reviewed-head")}),)
# Also verify that a later root-level event mapping is outside the jobs block.
trailing_event = "name: Trailing event\njobs:\n  build:\n    runs-on: ubuntu-24.04\non:\n  pull_request:\n"
if job(trailing_event, "pull_request") or re.search(r"^on:", job(trailing_event, "build"), re.M):
    raise SystemExit("Job lookup escaped the top-level jobs mapping")

# R3: local reusable callers compose names even though neither label alone is
# reserved. Include named and id-fallback callees, plus normalized caller labels.
for check in ("Preflight", "Build and Unit"):
    for named in (True, False) if check == "Preflight" else (True,):
        callee = ("name: Callee\non:\n  workflow_call:\njobs:\n  Preflight:\n" +
                  (f"    name: {check}\n" if named else "") +
                  "    runs-on: ubuntu-24.04\n    steps:\n      - run: 'true'\n")
        caller = ("name: Caller\non:\n  pull_request:\njobs:\n  call:\n"
                  "    name: Fixture\n    uses: ./.github/workflows/callee.yml\n")
        sources = {"caller.yml": caller, "callee.yml": callee}
        if violations(short, full, queue_gate, sources):
            raise SystemExit("Benign reusable caller/callee must pass")
        for label in ("Development v1", "  dEvElOpMeNt   V1  "):
            sources = {"caller.yml": caller.replace("name: Fixture", f"name: {json.dumps(label)}"),
                       "callee.yml": callee}
            mutations += ((f"composed {check} (named={named}, caller={label!r})",
                           short, full, queue_gate, sources),)
for required in required_names:
    for label in (required.swapcase(), "  " + required.replace(" ", "   ") + "  "):
        mutations += ((f"normalized required name: {label!r}", short, full, queue_gate,
                       {"normalized.yml": spoof_workflow(json.dumps(label))}),)
# R4 fixtures are valid YAML/actionlint workflows whose quoted/flow values
# conceal producers from the old line-regex view. Parsing them must succeed;
# the semantic producer checks and source agreement must reject every one.
r4_fixtures = root / "tests/fixtures/development-v1-ci"
r4_callee = (r4_fixtures / "r4-callee.yml").read_text()
r4_paths = sorted(path for path in r4_fixtures.glob("*.yml") if path.name != "r4-callee.yml")
if len(r4_paths) != 10:
    raise SystemExit("Expected all ten R4 producer-name repro fixtures")
for path in r4_paths:
    source = path.read_text()
    parsed_jobs(source)
    sources = {path.name: source, "r4-callee.yml": r4_callee}
    if not violations(short, full, queue_gate, sources):
        raise SystemExit(f"R4 spoof was not rejected: {path.name}")
    print(f"R4 spoof rejected: {path.name}")
    mutations += ((f"R4 {path.name}", short, full, queue_gate, sources),)

# Refs #1747. Actionlint's default discovery ignores uppercase extensions.
# Check the actual workflow tails, including invalid steps that the job-name
# contract deliberately leaves to actionlint rather than treating names as lint.
choices = [os.environ.get("HVO_ACTIONLINT_BIN"),
           str(pathlib.Path(os.environ.get("RUNNER_TEMP", "/tmp")) / "actionlint"),
           shutil.which("actionlint"), "/tmp/actionlint"]
actionlint = next((pathlib.Path(path) for path in choices
                   if path and pathlib.Path(path).is_file() and os.access(path, os.X_OK)), None)
if actionlint is None:
    raise SystemExit("Actionlint regressions require pinned 1.7.12; set HVO_ACTIONLINT_BIN locally")
version = subprocess.run([str(actionlint), "-version"], capture_output=True, text=True, check=True)
if version.stdout.splitlines()[0] != "1.7.12":
    raise SystemExit("Actionlint regressions require the workflow's pinned version 1.7.12")
lint_cases = lint_mutations = 0
for profile, source, title, executable in (
    ("Preflight", short, "Lint workflows", '"$RUNNER_TEMP/actionlint"'),
    ("Quality", full, "Lint GitHub Actions workflows", "/tmp/actionlint"),
):
    section = step(source, title)
    tail = [line.strip() for line in section.splitlines() if line.startswith("          ")][-4:]
    if tail != lint_commands(executable):
        raise SystemExit("Unexpected lint fixture wiring: " + profile)
    tail[-1] = tail[-1].replace(executable, shlex.quote(str(actionlint)), 1)
    with tempfile.TemporaryDirectory(prefix="hvo-actionlint-") as directory:
        fixture = pathlib.Path(directory)
        subprocess.run(["git", "init", "-q", str(fixture)], check=True)
        workflow_dir = fixture / ".github/workflows"
        workflow_dir.mkdir(parents=True)
        runner_temp = fixture / "runner"
        runner_temp.mkdir()
        environment = dict(os.environ, RUNNER_TEMP=str(runner_temp))
        names = ("normal.yml", "normal.yaml", ".hidden.yml", "upper.YML", "upper.YAML",
                 ".hidden.YaMl", "space name.YmL")
        good = spoof_workflow("Benign")
        bad = good[:good.index("    steps:")] + "    steps: [{unexpected: true}]\n"
        if violations(short, full, extra={"upper.YML": bad}):
            raise SystemExit("Bad-step regression must exercise lint, not the job-name contract")
        for name in names:
            (workflow_dir / name).write_text(good)

        def lint(lines):
            return subprocess.run(["bash", "-euo", "pipefail", "-c", "\n".join(lines)],
                                  cwd=fixture, env=environment, capture_output=True, text=True)

        result = lint(tail)
        discovered = (runner_temp / "actionlint-workflows.list").read_bytes().split(b"\0")[:-1]
        if result.returncode != 0 or {pathlib.Path(os.fsdecode(name)).name for name in discovered} != set(names):
            raise SystemExit(f"{profile} missed hidden/uppercase/space workflow names: {result.stderr}")
        lint_cases += 1
        for name in (".hidden.yml", "upper.YML", "upper.YAML"):
            (workflow_dir / name).write_text(bad)
            result = lint(tail)
            if result.returncode == 0 or "unexpected" not in result.stdout + result.stderr:
                raise SystemExit(f"{profile} accepted invalid step in {name}: {result.stdout}{result.stderr}")
            lint_cases += 1
            if name.startswith("upper"):
                for mutation, lines in (
                    ("default discovery", [*tail[:-1], shlex.quote(str(actionlint))]),
                    ("case-sensitive discovery", [line.replace("-iname", "-name") for line in tail]),
                ):
                    result = lint(lines)
                    if result.returncode != 0:
                        raise SystemExit(f"{profile} {mutation} must expose the prior omission: {result.stdout}{result.stderr}")
                    lint_mutations += 1
            (workflow_dir / name).write_text(good)
        for path in workflow_dir.iterdir():
            path.unlink()
        result = lint(tail)
        if result.returncode == 0 or "No workflow files found" not in result.stderr:
            raise SystemExit(f"{profile} accepted an empty workflow list")
        lint_cases += 1
print(f"Actionlint discovery passed: {lint_cases} behavior cases and {lint_mutations} mutation controls.")

# Exercise the actual interpreter-selection prologue without running this suite
# recursively. This also proves missing system PyYAML cannot silently skip it.
with tempfile.TemporaryDirectory(prefix="hvo-yaml-parser-") as directory:
    fixture = pathlib.Path(directory)
    bin_dir = fixture / "bin"
    bin_dir.mkdir()
    missing_python = bin_dir / "python3"
    missing_python.write_text("#!/usr/bin/env bash\nexit 1\n")
    missing_python.chmod(0o700)
    selector = fixture / "select-parser"
    prologue = (root / "scripts/test:development-v1-ci").read_text().split("<<'PY'\n", 1)[0]
    selector.write_text(prologue + "<<'PY'\nimport yaml\nprint('PyYAML available')\nPY\n")
    environment = dict(os.environ, PATH=f"{bin_dir}:{os.environ['PATH']}", PIPX_HOME=str(fixture / "pipx"))
    result = subprocess.run(["bash", str(selector)], env=environment, capture_output=True, text=True)
    if result.returncode == 0 or "requires PyYAML" not in result.stderr:
        raise SystemExit("Missing YAML parser did not fail closed")
    fallback = fixture / "pipx/venvs/yamllint/bin/python"
    fallback.parent.mkdir(parents=True)
    fallback.write_text(f'#!/usr/bin/env bash\nexec {shlex.quote(sys.executable)} "$@"\n')
    fallback.chmod(0o700)
    result = subprocess.run(["bash", str(selector)], env=environment, capture_output=True, text=True)
    if result.returncode != 0 or result.stdout.strip() != "PyYAML available":
        raise SystemExit(f"Hosted yamllint parser fallback failed: {result.stderr}")
    print("PyYAML availability controls: absent parser fails; hosted pipx fallback passes.")
for name, candidate, qualification, *queue in mutations:
    if not violations(candidate, qualification, *queue):
        raise SystemExit(f"Mutation was not rejected: {name}")
changelog = step(job(short, "preflight"), "Validate changelog fragments")
for label, original, replacement in (
    ("limit removed", 'args+=(--base "$first")', ":"),
    ("stale event base", 'args+=(--base "$first")', 'args+=(--base "${{ github.event.pull_request.base.sha }}")'),
    ("merge SHA unchecked", '"$merge" == "$GITHUB_SHA" && ', ""),
    ("PR head unchecked", '"$second" == "$PR_HEAD_SHA" && ', ""),
    ("extra parent allowed", ' && -z "$extra"', ""),
    ("binding failure ignored", "exit 1", ":"),
):
    candidate = short.replace(changelog, changelog.replace(original, replacement), 1)
    if candidate == short or changelog_error not in violations(candidate, full):
        raise SystemExit(f"PR changelog mutation was not rejected: {label}")
    print(f"Rejected PR changelog mutation: {label}")

# Run the Preflight shell against real Git parent lists and record both validator calls.
changelog_script = textwrap.dedent(changelog.split("        run: |\n", 1)[1])
with tempfile.TemporaryDirectory(prefix="hvo-changelog-workflow-") as directory:
    fixture = pathlib.Path(directory)

    def git(*args):
        return subprocess.run(["git", *args], cwd=fixture, check=True, capture_output=True, text=True).stdout.strip()

    git("init", "-q")
    git("config", "user.email", "fixture@example.invalid")
    git("config", "user.name", "fixture")
    git("commit", "-qm", "base", "--allow-empty")
    base = git("rev-parse", "HEAD")
    tree = git("rev-parse", "HEAD^{tree}")
    candidate = git("commit-tree", tree, "-p", base, "-m", "candidate")
    third = git("commit-tree", tree, "-p", base, "-m", "third parent")
    merge = git("commit-tree", tree, "-p", base, "-p", candidate, "-m", "PR merge")
    octopus = git("commit-tree", tree, "-p", base, "-p", candidate, "-p", third, "-m", "octopus")
    (fixture / "scripts").mkdir()
    for name in ("release:changelog", "test:changelog"):
        script = fixture / "scripts" / name
        script.write_text('#!/usr/bin/env bash\nprintf "%s " "${0##*/}" "$@" >> "$CALLS"\nprintf "\\n" >> "$CALLS"\n')
        script.chmod(0o700)
    calls = fixture / "calls"
    expected_calls = [f"release:changelog --check --base {base}", "test:changelog"]
    for label, checkout, workflow_sha, pr_head, passes in (
        ("valid merge", merge, merge, candidate, True),
        ("mismatched checkout", merge, third, candidate, False),
        ("wrong PR parent", merge, merge, third, False),
        ("single parent", candidate, candidate, candidate, False),
        ("extra parent", octopus, octopus, candidate, False),
    ):
        git("checkout", "-q", "--detach", checkout)
        calls.write_text("")
        env = dict(os.environ, GITHUB_EVENT_NAME="pull_request", GITHUB_SHA=workflow_sha,
                   PR_HEAD_SHA=pr_head, CALLS=str(calls))
        result = subprocess.run(["bash", "-euo", "pipefail", "-c", changelog_script],
                                cwd=fixture, env=env, capture_output=True, text=True, timeout=10)
        observed = [line.rstrip() for line in calls.read_text().splitlines()]
        if passes:
            if result.returncode or observed != expected_calls:
                raise SystemExit(f"Preflight changelog case {label} failed: {observed} {result.stderr}")
        elif result.returncode != 1 or observed or "Cannot bind the changelog fragment limit" not in result.stderr:
            raise SystemExit(f"Preflight changelog case {label} did not fail closed: {observed} {result.stderr}")
    print("Preflight changelog merge-parent binding: 5 behavioral cases passed.")

# The documented reproduction check must compare the inventory without rewriting it.
runbook = (root / "docs/runbooks/ci-pipeline.md").read_text()
