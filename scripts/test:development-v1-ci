r4_paths = sorted(path for path in r4_fixtures.glob("*.yml") if path.name != "r4-callee.yml")
if len(r4_paths) != 10:
    raise SystemExit("Expected all ten R4 producer-name repro fixtures")
for path in r4_paths:
    source = path.read_text()
    parsed_jobs(source)
    sources = {path.name: source, "r4-callee.yml": r4_callee}
    if not violations(short, full, queue_gate, sources):
        raise SystemExit(f"R4 spoof was not rejected: {path.name}")
    print(f"R4 spoof rejected: {path.name}")
    mutations += ((f"R4 {path.name}", short, full, queue_gate, sources),)

# Exercise the actual interpreter-selection prologue without running this suite
# recursively. This also proves missing system PyYAML cannot silently skip it.
with tempfile.TemporaryDirectory(prefix="hvo-yaml-parser-") as directory:
    fixture = pathlib.Path(directory)
    bin_dir = fixture / "bin"
    bin_dir.mkdir()
    missing_python = bin_dir / "python3"
    missing_python.write_text("#!/usr/bin/env bash\nexit 1\n")
    missing_python.chmod(0o700)
    selector = fixture / "select-parser"
    prologue = (root / "scripts/test:development-v1-ci").read_text().split("<<'PY'\n", 1)[0]
    selector.write_text(prologue + "<<'PY'\nimport yaml\nprint('PyYAML available')\nPY\n")
    environment = dict(os.environ, PATH=f"{bin_dir}:{os.environ['PATH']}", PIPX_HOME=str(fixture / "pipx"))
    result = subprocess.run(["bash", str(selector)], env=environment, capture_output=True, text=True)
    if result.returncode == 0 or "requires PyYAML" not in result.stderr:
        raise SystemExit("Missing YAML parser did not fail closed")
    fallback = fixture / "pipx/venvs/yamllint/bin/python"
    fallback.parent.mkdir(parents=True)
    fallback.write_text(f'#!/usr/bin/env bash\nexec {shlex.quote(sys.executable)} "$@"\n')
    fallback.chmod(0o700)
    result = subprocess.run(["bash", str(selector)], env=environment, capture_output=True, text=True)
    if result.returncode != 0 or result.stdout.strip() != "PyYAML available":
        raise SystemExit(f"Hosted yamllint parser fallback failed: {result.stderr}")
    print("PyYAML availability controls: absent parser fails; hosted pipx fallback passes.")
for name, candidate, qualification, *queue in mutations:
    if not violations(candidate, qualification, *queue):
        raise SystemExit(f"Mutation was not rejected: {name}")
# Exercise the real final promotion step with an offline gh substitute. Creating
# a PR must be draft; refreshing one must preserve its state; API errors must fail.
promotion_step = promotion.split("      - name: Open or refresh the promotion pull request\n", 1)[1]
promotion_script = textwrap.dedent(promotion_step.split("        run: |\n", 1)[1])
promotion_settings = promotion_step.split("        run: |\n", 1)[0]
shell_match = re.search(r"^        shell: (.+)$", promotion_settings, re.M)
if shell_match and shell_match.group(1) != "bash":
    raise SystemExit("Update the promotion regression for the configured shell")
# Match Actions: unspecified Linux shell is bash -e; explicit bash also enables
# pipefail. Removing shell: bash must therefore make the API-failure cases fail.
promotion_shell = (["bash", "--noprofile", "--norc", "-e", "-o", "pipefail", "-c"]
                   if shell_match else ["bash", "-e", "-c"])
with tempfile.TemporaryDirectory(prefix="hvo-v1-ci-") as directory:
    fixture = pathlib.Path(directory)
    gh = fixture / "gh"
    gh.write_text("""#!/usr/bin/env python3
import json, os, sys
args = sys.argv[1:]
with open(os.environ["HVO_V1_TEST_CALLS"], "a") as output:
    output.write(json.dumps(args) + "\\n")
if args[:3] in (["api", "-X", "POST"], ["api", "-X", "PATCH"]):
    if os.environ["HVO_V1_TEST_FAIL"] == "1":
        sys.exit(23)
    print("https://github.com/example/repo/pull/42")
elif args[0] == "api" and "/compare/" in args[1]:
    print("- aaaaaaaa fixture" + (" (#1142)" if os.environ["HVO_V1_TEST_REFERENCES"] == "1" else ""))
elif args[0] == "api" and "/pulls?" in args[1]:
    print(os.environ["HVO_V1_TEST_EXISTING"])
else:
    sys.exit(24)
""")
    gh.chmod(0o700)
    for existing, failure, references in itertools.product(("", "42"), (False, True), (False, True)):
        calls = fixture / "calls.jsonl"
        calls.write_text("")
        environment = dict(
            os.environ, PATH=f"{fixture}:{os.environ['PATH']}",
            REPOSITORY="example/repo", SOURCE="development/v1", TARGET="main",
            SOURCE_SHA="a" * 40, TARGET_SHA="b" * 40, AHEAD="1",
            RUN_URL="https://github.com/example/repo/actions/runs/1", TRIGGER="schedule",
            GITHUB_STEP_SUMMARY=str(fixture / "summary.md"),
            HVO_V1_TEST_CALLS=str(calls), HVO_V1_TEST_EXISTING=existing,
            HVO_V1_TEST_FAIL="1" if failure else "0",
            HVO_V1_TEST_REFERENCES="1" if references else "0",
        )
        result = subprocess.run(
            [*promotion_shell, promotion_script],
            env=environment, capture_output=True, text=True,
        )
        if (result.returncode != 0) != failure:
            raise SystemExit(f"Promotion result was not fail-closed: {result.stderr}")
        requests = [json.loads(line) for line in calls.read_text().splitlines()
                     if json.loads(line)[:2] == ["api", "-X"]]
        if len(requests) != 1:
            raise SystemExit(f"Unexpected promotion mutations: {requests}")
        request = requests[0]
        if existing:
            if request[:3] != ["api", "-X", "PATCH"] or any("draft=" in arg for arg in request):
                raise SystemExit("Refreshing a promotion changed its draft/ready state")
        elif request[:3] != ["api", "-X", "POST"] or "draft=true" not in request:
            raise SystemExit("New promotion was not created as draft")
print(f"Development v1 CI contracts passed; {len(mutations)} mutation controls and 8 offline promotion cases passed.")
