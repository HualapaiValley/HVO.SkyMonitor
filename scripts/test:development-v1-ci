#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Hosted Ubuntu 24.04 supplies PyYAML through yamllint's pipx environment.
# Prefer the developer's python3 when it already supplies the parser.
yaml_python=python3
if ! "$yaml_python" -c 'import yaml' >/dev/null 2>&1; then
    yaml_python="${PIPX_HOME:-/opt/pipx}/venvs/yamllint/bin/python"
    if [[ ! -x "$yaml_python" ]] || ! "$yaml_python" -c 'import yaml' >/dev/null 2>&1; then
        printf 'test:development-v1-ci requires PyYAML in python3 or the yamllint pipx environment; install python3-yaml locally.\n' >&2
        exit 1
    fi
fi
"$yaml_python" - "$repo_root" <<'PY'
import json
import functools
import itertools
import os
import pathlib
import re
import shlex
import subprocess
import sys
import tempfile
import textwrap

try:
    import yaml
except ImportError:
    raise SystemExit("test:development-v1-ci requires PyYAML; install python3-yaml locally")

print(f"Workflow YAML parser: PyYAML {yaml.__version__} ({sys.executable})")

root = pathlib.Path(sys.argv[1])
short = (root / ".github/workflows/development-v1.yml").read_text()
full = (root / ".github/workflows/ci.yml").read_text()
promotion = (root / ".github/workflows/promote-main.yml").read_text()
queue_gate = (root / ".github/workflows/merge-queue-reviewed-head.yml").read_text()


def read_workflows(directory):
    return {path.name: path.read_text() for pattern in ("*.yml", "*.yaml")
            for path in directory.glob(pattern)}


workflows = read_workflows(root / ".github/workflows")


def regex_jobs(workflow):
    return re.search(r"^jobs:\n(.*?)(?=^[^\s#]|\Z)", workflow, re.M | re.S)


def jobs_section(workflow):
    # This view binds canonical command formatting only. Parsed nodes below
    # decide which jobs exist, and must agree with these exact source bounds.
    match = regex_jobs(workflow)
    return match.group(1) if match else ""


def unique_mapping(node, label):
    if not isinstance(node, yaml.MappingNode):
        raise ValueError(f"{label} must be a mapping")
    result = {}
    for key, value in node.value:
        if not isinstance(key, yaml.ScalarNode) or key.value == "<<" or key.value in result:
            raise ValueError(f"{label} has a complex, duplicate or merge key")
        result[key.value] = (key, value)
    return result


def scalar(node, label):
    if not isinstance(node, yaml.ScalarNode):
        raise ValueError(f"{label} must be a scalar")
    return node.value


@functools.lru_cache(maxsize=256)
def parsed_jobs(workflow):
    # BaseLoader preserves strings such as the root `on` key (YAML 1.1 boolean
    # resolution would turn it into True). Compose never constructs tagged code.
    document = unique_mapping(yaml.compose(workflow, Loader=yaml.BaseLoader), "workflow")
    if "jobs" not in document:
        raise ValueError("workflow has no jobs mapping")
    jobs_key, jobs_node = document["jobs"]
    result = {}
    for header, (key, node) in unique_mapping(jobs_node, "jobs").items():
        properties = unique_mapping(node, f"job {header}")
        result[header] = {
            "index": key.start_mark.index,
            "name": scalar(properties["name"][1], "job name") if "name" in properties else header,
            "uses": scalar(properties["uses"][1], "job uses") if "uses" in properties else None,
        }
    return jobs_key.start_mark.index, jobs_node.end_mark.index, result


def job(workflow, name):
    # This guard binds the checked-in job/command shape; actionlint validates YAML.
    match = re.search(
        rf"^  {re.escape(name)}:\n(.*?)(?=^  [\w-]+:\n|\Z)",
        jobs_section(workflow), re.M | re.S,
    )
    return match.group(1) if match else ""


def normalized_name(value):
    return " ".join(value.split()).casefold() if isinstance(value, str) else None


required_names = ("hvo/reviewed-head", "Development v1 / Preflight", "Development v1 / Build and Unit")


classifier_run_line = (
    "        run: GITHUB_STEP_SUMMARY='' ./scripts/ci:classify "
    '"$EVENT_NAME" "$BASE_SHA" "$HEAD_SHA" >> "$GITHUB_OUTPUT"'
)


contract_condition = (
    "if: ${{ !cancelled() && (steps.classify.outcome != 'success' || "
    "steps.classify.outputs.secret_scan_contract != 'false') }}"
)


release_scripts_condition = (
    "if: ${{ !cancelled() && (steps.classify.outcome != 'success' || "
    "steps.classify.outputs.release_scripts != 'false') }}"
)


def step(section, name):
    match = re.search(
        rf"^      - name: {re.escape(name)}\n(.*?)(?=^      - |\Z)",
        section, re.M | re.S,
    )
    return match.group(1) if match else ""


merge_group_trigger = (
    "  merge_group:\n    types: [checks_requested]\n    branches: [development/v1]\n"
)


preflight_timeout = "    timeout-minutes: ${{ github.event_name == 'merge_group' && 6 || 4 }}"
queue_permissions = "permissions:\n  contents: read\n  pull-requests: read\n  statuses: read\n"
trusted_checkout = """        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: refs/heads/development/v1
          persist-credentials: false"""
queue_execution = """        env:
          GH_TOKEN: ${{ github.token }}
          REPOSITORY: ${{ github.repository }}
          HEAD_REF: ${{ github.event.merge_group.head_ref }}
          GROUP_SHA: ${{ github.event.merge_group.head_sha }}
          BASE_REF: ${{ github.event.merge_group.base_ref }}
          ALLOWED_SETTERS: RoySalisbury
        run: BASE_SHA="$(git rev-parse HEAD)" ./scripts/ci:queue-reviewed-head"""


def violations(short, full, queue=None, extra=None):
    queue = queue_gate if queue is None else queue
    errors = []
    preflight = job(short, "preflight")
    build = job(short, "build-unit")
    quality = job(full, "quality")
    qualification_build = job(full, "build")

    def require(condition, message):
        if not condition:
            errors.append(message)

    require("name: Development v1 / Preflight" in preflight, "required Preflight name")
    require("name: Development v1 / Build and Unit" in build, "required Build and Unit name")
    require("needs: preflight" in build, "preflight dependency")
    require(
        "if: github.event_name == 'push' || github.event_name == 'merge_group' || "
        "github.event.pull_request.draft == false" in build,
        "draft exclusion",
    )
    require(short.count("branches: [development/v1]") == 3, "v1 PR, push and merge queue triggers")
    require(merge_group_trigger in short, "both required checks report on merge queue commits")
    # The queue commit never carries the operator's hvo/reviewed-head status, so a
    # merge_group-only job reports that context after re-checking the queued PR head.
    # It must never run (or be skipped) on pull_request, where a job with that name
    # would satisfy the required context without a review.
    queue_on = queue.split("\non:\n", 1)[1].split("\npermissions:", 1)[0] if "\non:\n" in queue else ""
    require(queue_on.strip() == merge_group_trigger.strip(), "queue reviewed-head runs only on merge_group")
    require("pull_request" not in queue_on and "push" not in queue_on and "workflow_" not in queue_on,
            "queue reviewed-head has no PR, push or dispatch trigger")
    # The YAML parse is authoritative for producer identities. Retain canonical
    # source checks for command/wiring contracts, but require their view to agree
    # with parsed job locations, names and reusable calls. Fail closed on either
    # malformed YAML or a disagreement; actionlint remains the workflow linter.
    sources = dict(workflows, **{"development-v1.yml": short, "ci.yml": full,
                                "merge-queue-reviewed-head.yml": queue})
    sources.update(extra or {})
    names = []
    for path, workflow in sources.items():
        try:
            jobs_index, jobs_end, actual_jobs = parsed_jobs(workflow)
        except (yaml.YAMLError, ValueError) as error:
            require(False, f"valid workflow YAML jobs: {path}: {error}")
            continue
        match = regex_jobs(workflow)
        require(match is not None and match.start() == jobs_index and match.end(1) == jobs_end,
                f"YAML/regex jobs bounds agree: {path}")
        require(workflow.count("\njobs:\n") == 1, f"canonical jobs block: {path}")
        section = jobs_section(workflow)
        header_matches = list(re.finditer(r"^  ([\w-]+):\n", section, re.M))
        headers = [header.group(1) for header in header_matches]
        require(headers == list(actual_jobs) and match is not None and all(
            match.start(1) + header.start() + 2 == actual_jobs[header.group(1)]["index"]
            for header in header_matches if header.group(1) in actual_jobs),
            f"YAML/regex job ids and locations agree: {path}")
        direct_children = [line for line in section.splitlines()
                           if re.match(r"^  [^\s#]", line)]
        require(bool(headers) and direct_children == [f"  {header}:" for header in headers],
                f"canonical job headers: {path}")
        for header, actual in actual_jobs.items():
            body = job(workflow, header)
            values = re.findall(r"^    name: ([^\n]+)$", body, re.M)
            properties = [line for line in body.splitlines() if re.match(r"^    [^\s#]", line)]
            require(bool(properties) and all(re.match(r"^    [\w-]+:", line) for line in properties),
                    f"canonical job properties: {path}/{header}")
            require(len(values) <= 1 and len(values) == len(re.findall(r"^    name:", body, re.M)),
                    f"one single-line name per job: {path}/{header}")
            raw_name = values[0] if values else header
            # Required check names cannot be computed. Reject expressions before
            # parsing comments/quotes, and again after decoding escaped strings.
            # With no expressions, matrix/input values cannot feed a job name.
            # Printable ASCII also excludes tabs, controls and Unicode lookalikes.
            require("${{" not in raw_name and all(" " <= char <= "~" for char in raw_name),
                    f"static printable job name: {path}/{header}")
            value = raw_name.strip()
            # Decode ordinary quoted names too; reject folded/anchored names.
            if value.startswith('"'):
                try:
                    value = json.loads(value)
                except ValueError:
                    value = None
            elif value.startswith("'"):
                value = value[1:-1].replace("''", "'") if value.endswith("'") else None
            else:
                value = value.split(" #", 1)[0].strip()
            require(isinstance(value, str) and not value.startswith(("|", ">", "&", "*", "{", "!")),
                    f"canonical job name: {path}/{header}")
            require(value == actual["name"], f"YAML/regex job name agrees: {path}/{header}")
            uses_lines = re.findall(r"^    uses: ([^\n]+)$", body, re.M)
            require(len(uses_lines) <= 1, f"one uses field per job: {path}/{header}")
            try:
                view_uses = scalar(yaml.compose(uses_lines[0], Loader=yaml.BaseLoader), "uses") if uses_lines else None
            except (yaml.YAMLError, ValueError):
                view_uses = None
                require(False, f"canonical uses scalar: {path}/{header}")
            require(view_uses == actual["uses"], f"YAML/regex job uses agrees: {path}/{header}")
            value = actual["name"]
            require(isinstance(value, str) and "${{" not in value and
                    all(" " <= char <= "~" for char in value),
                    f"decoded static printable job name: {path}/{header}")
            if normalized_name(value) == normalized_name("hvo/reviewed-head"):
                require(path == "merge-queue-reviewed-head.yml" and header == "reviewed-head" and
                        raw_name == "hvo/reviewed-head",
                        f"reviewed-head name belongs only to the approved queue gate: {path}/{header}")
            label = normalized_name(value)
            if label is not None and actual["uses"] is not None:
                # A reusable workflow reports "caller label / callee label".
                # Reserve every caller prefix that could form a required context,
                # for local and external calls alike, regardless of callee ids.
                require(not any(normalized_name(required).startswith(label + " / ")
                                for required in required_names),
                        f"reusable caller can compose a required job name: {path}/{header}")
            names.append(label)
    for required in required_names:
        require(names.count(normalized_name(required)) == 1,
                f"globally unique required job name: {required}")
    require(queue.split("\npermissions:\n", 1)[-1].split("\njobs:\n", 1)[0].strip() ==
            queue_permissions.split("\n", 1)[1].strip() and
            len(re.findall(r"^\s*permissions:", queue, re.M)) == 1,
            "queue exact read-only permissions without job overrides")
    require(step(queue, "Checkout trusted development base").strip() == trusted_checkout.strip(),
            "queue trusted branch checkout with credentials disabled")
    require(step(queue, "Require the reviewed-head status on the queued pull request head").strip() ==
            queue_execution.strip(), "queue exact environment and trusted-base execution")
    require(len(re.findall(r"^      - ", queue, re.M)) == 2 and
            re.findall(r"^  ([\w-]+):$", jobs_section(queue), re.M) == ["reviewed-head"],
            "queue has only the trusted checkout and gate steps in one job")
    require("        if:" not in queue and "    if:" not in queue and "continue-on-error:" not in queue,
            "queue reviewed-head is unconditional and fails closed")
    require("hvo/reviewed-head" not in short, "the v1 checks never report hvo/reviewed-head")
    require("cancel-in-progress: true" in short, "stale-run cancellation")
    require("continue-on-error:" not in short, "required checks must fail closed")
    for command in (
        "ci:shell-syntax", "test:ci-classification", "test:coordination-guard",
        "test:pr-review-tools", "test:development-v1-ci",
    ):
        require(f"          ./scripts/{command}\n" in preflight, f"preflight {command}")
    for profile, section, title, executable in (
        ("Preflight", preflight, "Lint workflows", '"$RUNNER_TEMP/actionlint"'),
        ("Quality", quality, "Lint GitHub Actions workflows", "/tmp/actionlint"),
    ):
        lint = step(section, title)
        commands = [line.strip() for line in lint.splitlines() if line.startswith("          ")]
        require(commands[-2:] == ["shopt -s nullglob",
                                 f"{executable} .github/workflows/*.yml .github/workflows/*.yaml"],
                f"{profile} actionlint includes both workflow extensions without unmatched globs")
    base_images = step(preflight, "Check Dockerfile base images")
    require(base_images.strip() == "run: ./scripts/ci:base-images",
            "base-image check is unconditional and fail-closed")
    require(preflight_timeout in preflight.splitlines(), "Preflight allows 360 seconds for merge_group and 240 otherwise")
    # Issue #1321: both required profiles scan the complete history for secrets,
    # inside a check that branch protection already requires.
    for profile, section in (("preflight", preflight), ("full Quality", quality)):
        for command in ("ci:secret-scan", "test:ci-secret-scan"):
            require(f"          ./scripts/{command}\n" in section, f"{profile} {command}")
        require("          fetch-depth: 0\n" in section, f"{profile} full-history checkout")
    history = step(preflight, "Scan history for secrets")
    classification = step(preflight, "Classify secret scanner contract inputs")
    contract = step(preflight, "Test secret scanner contract")
    require("./scripts/ci:secret-scan" in history and "        if:" not in history,
            "history scan is unconditional")
    require("        id: classify\n" in classification, "contract classifier identity")
    for wiring in (
        "EVENT_NAME: ${{ github.event_name }}",
        "BASE_SHA: ${{ github.event.pull_request.base.sha || github.event.before }}",
        "HEAD_SHA: ${{ github.sha }}",
    ):
        require(wiring in classification, f"contract classification wiring: {wiring}")
    require(classification.splitlines().count(classifier_run_line) == 1,
            "exact contract classification command with job summary disabled")
    require(preflight.find("Scan history for secrets") <
            preflight.find("Classify secret scanner contract inputs"),
            "history scan precedes fallible classification")
    require(contract_condition in contract and "./scripts/test:ci-secret-scan" in contract,
            "contract skips only successful explicit false, including after classification failure")
    # Issue #1309: the pre-release scripts' tests share that classification and its fail-open rule.
    release_scripts = step(preflight, "Test release scripts")
    require(release_scripts_condition in release_scripts and
            "          ./scripts/test:release-scripts\n" in release_scripts,
            "release script tests skip only successful explicit false, including after classification failure")
    require(0 <= preflight.find("Classify secret scanner contract inputs") <
            preflight.find("- name: Test release scripts"),
            "release script tests follow the classification they read")
    require("          ./scripts/test:release-scripts\n" in quality, "full Quality retains test:release-scripts")
    require(
        re.findall(r"^\s+dotnet (restore|build|test)\b", build, re.M)
        == ["restore", "build", "test"],
        "one restore/build/Unit execution",
    )
    require("dotnet build HVO.SkyMonitor.v9.slnx" in build, "complete solution build")
    require("--configuration Release" in build and "-warnaserror" in build, "Release warnings")
    require("dotnet test HVO.SkyMonitor.v9.slnx" in build, "complete solution Unit selection")
    require('--filter "TestCategory=Unit"' in build, "positive Unit filter")
    require("--no-build" in build, "reuse this job's Release build")
    require("DOCKER_HOST: unix:///tmp/hvo-no-docker.sock" in build, "Docker-disabled Unit")
    require(build.count("((remaining > 0)) || exit 124") == 3, "cumulative deadline guards")
    require(build.count('timeout --signal=TERM --kill-after=30s "${remaining}s"') == 3,
            "bounded commands")
    require(re.search(r"started_at_epoch \+ 1080\)\)", build) is not None and
            re.search(r"^    timeout-minutes: 22$", build, re.M) is not None, "bounded workload and job")
    require("workloadBudgetSeconds:1080,hardTimeoutSeconds:1320,unitTrxCount" in build, "summary matches enforced budgets")
    require("--logger trx" in build and "if-no-files-found: error" in build, "retained evidence")
    require(build.count("if: always()") == 2, "failure evidence summary and upload")
    require("hvo-development-v1-ci-v4" in build, "versioned short-profile evidence")
    for heavy in ("./scripts/ci:shellcheck", "./scripts/test:ci-shellcheck",
                  "scripts/test-categories/HVO.SkyMonitor.TestCategoryAudit.csproj",
                  '--collect:', "TestCategory=Integration", "gh workflow run ci.yml"):
        require(heavy not in short, f"qualification work in short run: {heavy}")
    for command in ("ci:shellcheck", "test:ci-shellcheck"):
        require(f"          ./scripts/{command}\n" in quality, f"full Quality retains {command}")
    require(
        "run: dotnet run --project scripts/test-categories/HVO.SkyMonitor.TestCategoryAudit.csproj"
        " --configuration Release" in qualification_build,
        "full Build retains exhaustive category discovery",
    )
    require("if: needs.changes.outputs.mode == 'full'" in qualification_build,
            "category audit belongs to full qualification")
    # Issue #849 keeps two general x64 runners out of qualification so a ready v1
    # PR is not queued behind a promotion fan-out. Qualification must opt in to
    # the hvo-qualification label on every self-hosted job; the v1 check must not.
    general = "[self-hosted, linux, x64, hvo-skymonitor]"
    reserved = "[self-hosted, linux, x64, hvo-skymonitor, hvo-qualification]"
    # A selector is either a bare GitHub-hosted image or the exact reserved list;
    # anything else (a self-hosted list carrying an image label, a mapping or an
    # expression) could reach the general runners and is rejected.
    selectors = [value.strip() for value in re.findall(r"^\s+runs-on:(.*)$", full, re.M)]
    require(reserved in selectors and all(
        value == reserved or re.fullmatch(r"ubuntu-(latest|\d+\.\d+)", value) for value in selectors),
        "every self-hosted qualification job requires hvo-qualification")
    require(re.findall(r"^    runs-on: (.+)$", build, re.M) == [general],
            "v1 Build and Unit stays on the general runner pool")
    require("hvo-qualification" not in short, "v1 profile never requires the qualification label")
    return errors


errors = violations(short, full)
if errors:
    raise SystemExit("Development v1 CI contracts failed:\n- " + "\n- ".join(errors))

# Mutation controls prove the checks reject costly creep and silent loss of gates.
mutations = (
    ("inflated summary hard timeout", short.replace("hardTimeoutSeconds:1320", "hardTimeoutSeconds:13200"), full),
    ("inflated workload budget", short.replace("started_at_epoch + 1080", "started_at_epoch + 10800"), full),
    ("inflated hard timeout", short.replace("timeout-minutes: 22", "timeout-minutes: 220"), full),
    ("workload budget reverted", short.replace("started_at_epoch + 1080", "started_at_epoch + 720"), full),
    ("hard timeout reverted", short.replace("timeout-minutes: 22", "timeout-minutes: 15"), full),
    ("summary workload drift", short.replace("workloadBudgetSeconds:1080", "workloadBudgetSeconds:720"), full),
    ("summary hard timeout drift", short.replace("hardTimeoutSeconds:1320", "hardTimeoutSeconds:900"), full),
    ("Preflight budget reverted", short.replace(preflight_timeout, "    timeout-minutes: 3"), full),
    ("Preflight budget inflated to 40", short.replace(preflight_timeout, "    timeout-minutes: 40"), full),
    ("Preflight budget raised", short.replace(preflight_timeout, "    timeout-minutes: 5"), full),
    ("Preflight budget removed", short.replace(preflight_timeout + "\n", ""), full),
    ("merge queue Preflight budget lost", short.replace(preflight_timeout, "    timeout-minutes: 4"), full),
    ("base-image check removed", short.replace("run: ./scripts/ci:base-images", "run: true"), full),
    ("base-image check gated", short.replace(
        "- name: Check Dockerfile base images", "- name: Check Dockerfile base images\n        if: false"), full),
    ("base-image failure masked", short.replace("run: ./scripts/ci:base-images", "run: ./scripts/ci:base-images || true"), full),
    ("missing Unit filter", short.replace('--filter "TestCategory=Unit"', ""), full),
    ("integration in fast run", short.replace("TestCategory=Unit", "TestCategory=Integration"), full),
    ("Docker enabled", short.replace("DOCKER_HOST: unix:///tmp/hvo-no-docker.sock", ""), full),
    ("warnings tolerated", short.replace("-warnaserror", ""), full),
    ("draft build", short.replace(" || github.event.pull_request.draft == false", ""), full),
    ("merge queue trigger removed", short.replace(merge_group_trigger, ""), full),
    ("Build and Unit skipped in the queue", short.replace(" || github.event_name == 'merge_group'", ""), full),
    ("queue gate on pull_request", short, full, queue_gate.replace(
        "on:\n  merge_group:", "on:\n  pull_request:\n    branches: [development/v1]\n  merge_group:")),
    ("queue gate on push", short, full, queue_gate.replace(
        "on:\n  merge_group:", "on:\n  push:\n  merge_group:")),
    ("queue gate renamed", short, full, queue_gate.replace("name: hvo/reviewed-head", "name: reviewed head")),
    ("queue gate check removed", short, full, queue_gate.replace("./scripts/ci:queue-reviewed-head", "true")),
    ("queue gate skippable", short, full, queue_gate.replace(
        "    runs-on: ubuntu-24.04", "    if: github.event_name == 'merge_group'\n    runs-on: ubuntu-24.04")),
    ("queue gate masked", short, full, queue_gate.replace(
        "    timeout-minutes: 3", "    timeout-minutes: 3\n    continue-on-error: true")),
    ("v1 checks report reviewed-head", short.replace(
        "name: Development v1 / Preflight", "name: hvo/reviewed-head"), full),
    ("deadline removed", short.replace("((remaining > 0)) || exit 124", ":"), full),
    ("errors tolerated", short + "\n    continue-on-error: true\n", full),
    ("heavy lint returned", short + "\n          ./scripts/ci:shellcheck\n", full),
    ("audit destination removed", short, full.replace(
        "scripts/test-categories/HVO.SkyMonitor.TestCategoryAudit.csproj", "missing.csproj")),
    ("lint destination removed", short, full.replace("./scripts/ci:shellcheck", ":")),
    ("control guard removed", short.replace("./scripts/test:ci-classification", ":"), full),
    ("evidence lost on failure", short.replace("if: always()", "if: success()"), full),
    ("qualification job on general pool", short, full.replace(
        "x64, hvo-skymonitor, hvo-qualification]", "x64, hvo-skymonitor]", 1)),
    ("qualification selector in mapping form", short, full.replace(
        "runs-on: [self-hosted, linux, x64, hvo-skymonitor, hvo-qualification]",
        "runs-on:\n      labels: [self-hosted, linux, x64, hvo-skymonitor]", 1)),
    ("qualification selector with an image label", short, full.replace(
        "x64, hvo-skymonitor, hvo-qualification]", "x64, hvo-skymonitor, ubuntu-24.04]", 1)),
    ("v1 confined to qualification runners", short.replace(
        "x64, hvo-skymonitor]", "x64, hvo-skymonitor, hvo-qualification]"), full),
    ("v1 secret scan removed", short.replace("./scripts/ci:secret-scan", ":"), full),
    ("v1 contract removed", short.replace("./scripts/test:ci-secret-scan", ":"), full),
    ("v1 history scan gated", short.replace(
        "- name: Scan history for secrets", "- name: Scan history for secrets\n        if: false"), full),
    ("v1 classifier removed", short.replace("./scripts/ci:classify ", ": "), full),
    ("v1 classifier summary enabled", short.replace(
        "run: GITHUB_STEP_SUMMARY='' ", "run: "), full),
    ("v1 classifier masked by suffix", short.replace(
        classifier_run_line, classifier_run_line + " || true"), full),
    ("v1 classifier command suffix", short.replace(
        classifier_run_line, classifier_run_line + "; true"), full),
    ("v1 classifier failure skips contract", short.replace(
        "steps.classify.outcome != 'success' || ", ""), full),
    ("v1 missing output skips contract", short.replace(
        "secret_scan_contract != 'false'", "secret_scan_contract == 'true'"), full),
    ("v1 failed-step fallback suppressed", short.replace("!cancelled() && ", ""), full),
    ("full secret scan removed", short, full.replace("./scripts/ci:secret-scan", ":")),
    ("v1 release script tests removed", short.replace("./scripts/test:release-scripts", ":"), full),
    ("v1 classifier failure skips release script tests", short.replace(
        "steps.classify.outcome != 'success' || steps.classify.outputs.release_scripts",
        "steps.classify.outputs.release_scripts"), full),
    ("v1 missing output skips release script tests", short.replace(
        "release_scripts != 'false'", "release_scripts == 'true'"), full),
    ("v1 release script tests suppressed after a failed step", short.replace(
        "${{ !cancelled() && (steps.classify.outcome != 'success' || steps.classify.outputs.release_scripts",
        "${{ (steps.classify.outcome != 'success' || steps.classify.outputs.release_scripts"), full),
    ("full release script tests removed", short, full.replace("./scripts/test:release-scripts", ":")),
    ("v1 shallow checkout", short.replace("fetch-depth: 0", "fetch-depth: 1"), full),
    ("full shallow checkout", short, full.replace("fetch-depth: 0", "fetch-depth: 1")),
)
# Bind every credential, environment and trust source independently.
queue_mutations = [
    ("statuses write", queue_gate.replace("statuses: read", "statuses: write")),
    ("contents write", queue_gate.replace("contents: read", "contents: write")),
    ("job permissions override", queue_gate.replace("    runs-on:", "    permissions: write-all\n    runs-on:")),
    ("credentials persisted", queue_gate.replace("persist-credentials: false", "persist-credentials: true")),
    ("credential setting removed", queue_gate.replace("          persist-credentials: false\n", "")),
    ("queued checkout", queue_gate.replace("ref: refs/heads/development/v1", "ref: ${{ github.event.merge_group.head_sha }}")),
    ("base_sha checkout", queue_gate.replace("ref: refs/heads/development/v1", "ref: ${{ github.event.merge_group.base_sha }}")),
    ("checkout failure ignored", queue_gate.replace("        with:", "        continue-on-error: true\n        with:")),
    ("trusted base execution removed", queue_gate.replace('BASE_SHA="$(git rev-parse HEAD)" ', "")),
    ("execution failure ignored", queue_gate.replace("./scripts/ci:queue-reviewed-head\n", "./scripts/ci:queue-reviewed-head || true\n")),
]
for key in ("GH_TOKEN", "REPOSITORY", "HEAD_REF", "GROUP_SHA", "BASE_REF", "ALLOWED_SETTERS"):
    line = next(line for line in queue_gate.splitlines() if line.startswith(f"          {key}:"))
    queue_mutations.append((f"{key} removed", queue_gate.replace(line + "\n", "")))
    queue_mutations.append((f"{key} miswired", queue_gate.replace(line, f"          {key}: wrong")))
queue_mutations.extend([
    ("setter allowlist expanded", queue_gate.replace("ALLOWED_SETTERS: RoySalisbury", "ALLOWED_SETTERS: RoySalisbury someone")),
    ("GROUP_SHA sourced from PR", queue_gate.replace("GROUP_SHA: ${{ github.event.merge_group.head_sha }}",
                                                    "GROUP_SHA: ${{ github.event.pull_request.head.sha }}")),
])
mutations += tuple((name, short, full, candidate) for name, candidate in queue_mutations)
for required in ("hvo/reviewed-head", "Development v1 / Preflight", "Development v1 / Build and Unit"):
    spoof = f"name: Spoof\non: push\njobs:\n  spoof:\n    name: {json.dumps(required)}\n    runs-on: ubuntu-24.04\n    steps:\n      - run: 'true'\n"
    mutations += ((f"spoof workflow: {required}", short, full, queue_gate, {"spoof.yml": spoof}),)
mutations += (("inline jobs spoof", short, full, queue_gate,
               {"spoof.yml": "name: Spoof\non: push\njobs: {spoof: {name: hvo/reviewed-head}}\n"}),)
for spoof in (
    'name: Spoof\non: push\njobs:\n  benign:\n    runs-on: ubuntu-24.04\n  spoof: {name: hvo/reviewed-head}\n',
    'name: Spoof\non: push\njobs:\n  spoof:\n    "name": hvo/reviewed-head\n',
    'name: Spoof\non: push\njobs:\n  spoof:\n    name:\n      hvo/reviewed-head\n',
):
    mutations += (("alternate YAML spoof", short, full, queue_gate, {"spoof.yml": spoof}),)
# Negative regressions for the R2 producer-name bypass. Exercise discovery using
# real files: injecting an extra dict alone cannot catch a *.yml-only reader.
def spoof_workflow(name, matrix=""):
    return ("name: Spoof\non: push\njobs:\n  spoof:\n    name: " + name + "\n" + matrix +
            "    runs-on: ubuntu-24.04\n    steps:\n      - run: 'true'\n")


name_spoofs = (
    ("literal expression", "${{ 'hvo/reviewed-head' }}", ""),
    ("format expression", "${{ format('{0}/reviewed-head','hvo') }}", ""),
    ("matrix-derived name", "${{ matrix.check }}",
     "    strategy:\n      matrix:\n        check: [hvo/reviewed-head]\n"),
    ("expression in name matrix value", "${{ matrix.check }}",
     "    strategy:\n      matrix:\n        check: [\"${{ 'hvo/reviewed-head' }}\"]\n"),
    ("tab before comment", "hvo/reviewed-head\t# note", ""),
    ("escaped expression", json.dumps("${{ 'hvo/reviewed-head' }}").replace("$", r"\u0024"), ""),
    ("escaped tab", r'"hvo/reviewed-head\t"', ""),
    ("escaped control", r'"hvo/reviewed-head\u0001"', ""),
    ("raw control", "hvo/reviewed-head\x01", ""),
    ("normalized Unicode", "ｈｖｏ／ｒｅｖｉｅｗｅｄ－ｈｅａｄ", ""),
    ("case normalization", "HVO/REVIEWED-HEAD", ""),
    ("space and comment normalization", "hvo/reviewed-head # note", ""),
)
for name, value, matrix in name_spoofs:
    mutations += ((name, short, full, queue_gate, {"spoof.yml": spoof_workflow(value, matrix)}),)
mutations += (
    ("Preflight YAML lint omitted", short.replace(" .github/workflows/*.yaml", ""), full),
    ("Preflight YML lint omitted", short.replace(" .github/workflows/*.yml", ""), full),
    ("Preflight unmatched glob", short.replace("          shopt -s nullglob\n", ""), full),
    ("Quality YAML lint omitted", short, full.replace(" .github/workflows/*.yaml", "")),
    ("Quality YML lint omitted", short, full.replace(" .github/workflows/*.yml", "")),
)
with tempfile.TemporaryDirectory(prefix="hvo-v1-workflows-") as directory:
    fixture = pathlib.Path(directory)
    (fixture / "benign.yml").write_text(spoof_workflow("Benign"))
    (fixture / "ignored.txt").write_text(spoof_workflow("hvo/reviewed-head"))
    (fixture / "spoof.yaml").write_text(spoof_workflow("Benign YAML"))
    discovered = read_workflows(fixture)
    if set(discovered) != {"benign.yml", "spoof.yaml"} or violations(short, full, queue_gate, discovered):
        raise SystemExit("Both workflow extensions must be discovered and safe names must pass")
    (fixture / "spoof.yaml").write_text(spoof_workflow("hvo/reviewed-head"))
    if not violations(short, full, queue_gate, read_workflows(fixture)):
        raise SystemExit("Discovered .yaml spoof workflow was not rejected")
    print("R2 file discovery: benign .yml/.yaml pass; .yaml spoof rejected.")
# R3: on.pull_request must not shadow jobs.pull_request in the job helper.
shadow = ("name: Event shadow\non:\n  pull_request:\n    types: [opened]\n"
          "jobs:\n  pull_request:\n    name: Benign\n    runs-on: ubuntu-24.04\n"
          "    steps:\n      - run: 'true'\n")
if "types:" in job(shadow, "pull_request") or "name: Benign" not in job(shadow, "pull_request"):
    raise SystemExit("Event block shadowed a job with the same id")
if violations(short, full, queue_gate, {"shadow.yml": shadow}):
    raise SystemExit("Benign event/job id overlap must pass")
mutations += (("event name shadows reserved job", short, full, queue_gate,
               {"shadow.yml": shadow.replace("name: Benign", "name: hvo/reviewed-head")}),)
# Also verify that a later root-level event mapping is outside the jobs block.
trailing_event = "name: Trailing event\njobs:\n  build:\n    runs-on: ubuntu-24.04\non:\n  pull_request:\n"
if job(trailing_event, "pull_request") or re.search(r"^on:", job(trailing_event, "build"), re.M):
    raise SystemExit("Job lookup escaped the top-level jobs mapping")

# R3: local reusable callers compose names even though neither label alone is
# reserved. Include named and id-fallback callees, plus normalized caller labels.
for check in ("Preflight", "Build and Unit"):
    for named in (True, False) if check == "Preflight" else (True,):
        callee = ("name: Callee\non:\n  workflow_call:\njobs:\n  Preflight:\n" +
                  (f"    name: {check}\n" if named else "") +
                  "    runs-on: ubuntu-24.04\n    steps:\n      - run: 'true'\n")
        caller = ("name: Caller\non:\n  pull_request:\njobs:\n  call:\n"
                  "    name: Fixture\n    uses: ./.github/workflows/callee.yml\n")
        sources = {"caller.yml": caller, "callee.yml": callee}
        if violations(short, full, queue_gate, sources):
            raise SystemExit("Benign reusable caller/callee must pass")
        for label in ("Development v1", "  dEvElOpMeNt   V1  "):
            sources = {"caller.yml": caller.replace("name: Fixture", f"name: {json.dumps(label)}"),
                       "callee.yml": callee}
            mutations += ((f"composed {check} (named={named}, caller={label!r})",
                           short, full, queue_gate, sources),)
for required in required_names:
    for label in (required.swapcase(), "  " + required.replace(" ", "   ") + "  "):
        mutations += ((f"normalized required name: {label!r}", short, full, queue_gate,
                       {"normalized.yml": spoof_workflow(json.dumps(label))}),)
# R4 fixtures are valid YAML/actionlint workflows whose quoted/flow values
# conceal producers from the old line-regex view. Parsing them must succeed;
# the semantic producer checks and source agreement must reject every one.
r4_fixtures = root / "tests/fixtures/development-v1-ci"
