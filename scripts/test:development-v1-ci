# Run the actual decision shell with synthetic merge commits and a trusted-base
# classifier. This verifies literal output parsing and merge-parent binding.
fast_step = step(job(short, "build-unit"), workload_step)
fast_script = textwrap.dedent(fast_step.split("        run: |\n", 1)[1])
lookup_step = step(job(short, "preflight"), merge_group_lookup)
lookup_script = textwrap.dedent(lookup_step.split("        run: |\n", 1)[1])
with tempfile.TemporaryDirectory(prefix="hvo-merge-group-lookup-") as directory:
    fixture = pathlib.Path(directory)
    gh = fixture / "gh"
    gh.write_text("""#!/usr/bin/env python3
import json, os, pathlib, sys
pathlib.Path(os.environ["CALLS"]).write_text(json.dumps(sys.argv[1:]))
print(os.environ["RESPONSE"])
sys.exit(int(os.environ["API_EXIT"]))
""")
    gh.chmod(0o700)
    output = fixture / "output"
    calls = fixture / "calls.json"
    sha = "a" * 40
    expected_arguments = ["api", "--method", "GET", "--paginate", "--slurp",
                          "repos/example/repo/actions/workflows/development-v1.yml/runs",
                          "-f", "event=merge_group", "-f", f"head_sha={sha}", "-F", "per_page=100"]
    exact = dict(id=42, head_sha=sha, event="merge_group", status="completed", conclusion="success",
                 head_branch=f"gh-readonly-queue/development/v1/pr-17-{'b' * 40}",
                 path=".github/workflows/development-v1.yml")
    cases = [(key, [{"workflow_runs": [dict(exact, **{key: value})]}], 0, "") for key, value in (
        ("head_sha", "c" * 40), ("event", "push"), ("status", "in_progress"), ("conclusion", "failure"),
        ("head_branch", "gh-readonly-queue/development/v10/pr-17"), ("head_branch", None),
        ("path", ".github/workflows/ci.yml"), ("id", "42"),
    )]
    good_page = {"workflow_runs": [exact]}
    cases.extend((
        ("exact", [good_page], 0, "run_id=42\n"),
        ("match on later page", [{"workflow_runs": [dict(exact, head_sha="c" * 40)]}, good_page], 0, "run_id=42\n"),
        ("missing", [{"workflow_runs": []}], 0, ""),
        ("failed after printing match", [good_page], 1, ""),
        ("timeout", [], 124, ""),
        ("malformed", '{"workflow_runs":[', 0, ""),
        ("malformed later page", [good_page, {"workflow_runs": None}], 0, ""),
        ("extra JSON document", json.dumps([good_page]) + "\n[]", 0, ""),
    ))
    for label, response, api_exit, expected in cases:
        output.write_text("")
        calls.write_text("")
        env = dict(os.environ, PATH=f"{fixture}:{os.environ['PATH']}", GITHUB_REPOSITORY="example/repo",
                   GITHUB_SHA=sha, GITHUB_OUTPUT=str(output), CALLS=str(calls), API_EXIT=str(api_exit),
                   RESPONSE=response if isinstance(response, str) else json.dumps(response))
        result = subprocess.run(["bash", "-e", "-c", lookup_script], cwd=root, env=env,
                                capture_output=True, text=True, timeout=10)
        if result.returncode or output.read_text() != expected or json.loads(calls.read_text()) != expected_arguments:
            raise SystemExit(f"Merge-group lookup case {label} failed: {output.read_text()} {result.stderr}")
    print(f"Merge-group lookup: {len(cases)} exact binding, pagination and fallback cases passed.")

with tempfile.TemporaryDirectory(prefix="hvo-fast-workflow-") as directory:
    fixture = pathlib.Path(directory)
    def git(*args):
        return subprocess.run(["git", *args], cwd=fixture, check=True, capture_output=True, text=True).stdout.strip()
    git("init", "-q")
    git("config", "user.email", "fixture@example.invalid")
    git("config", "user.name", "fixture")
    (fixture / "scripts").mkdir()
    trusted = fixture / "scripts/ci:classify"
    trusted.write_text('''#!/usr/bin/env bash
if [[ "$1" == --verify-docs-restore ]]; then
    printf '%s' "$FAKE_PROOF"
    if [[ -n "${FAKE_PROOF_WRITER_RECORD:-}" ]]; then
        (
            trap '' TERM
            printf '%s\\n' "$BASHPID" > "$FAKE_PROOF_WRITER_RECORD"
            while :; do
                mkdir -p "$TMPDIR/nuget-scratch"
                printf 'lock\\n' > "$TMPDIR/nuget-scratch/restore.lock"
                sleep 0.02
            done
        ) </dev/null >/dev/null 2>&1 &
        wait "$!"
    fi
    if [[ -n "${FAKE_PROOF_DELAY:-}" ]]; then
        printf '%s\\n' "$TMPDIR" > "$FAKE_PROOF_SCRATCH_RECORD"
        touch "$TMPDIR/partial-restore-output"
        sleep "$FAKE_PROOF_DELAY"
    fi
    exit "$FAKE_PROOF_EXIT"
fi
if [[ "$3" == "$GITHUB_SHA" && -n "${FAKE_MERGE_CONTENT:-}" ]]; then
    printf '%s' "$FAKE_MERGE_CONTENT"
    exit 0
fi
printf '%s' "$FAKE_CONTENT"
exit "$FAKE_EXIT"
''')
    git("add", ".")
    git("commit", "-qm", "trusted base")
    base = git("rev-parse", "HEAD")
    trusted.write_text('#!/usr/bin/env bash\nprintf "docs_fast_path=true\ndocs_fast_path_reason=candidate\n"\n')
    git("commit", "-qam", "candidate classifier")
    candidate = git("rev-parse", "HEAD")
    tree = git("rev-parse", "HEAD^{tree}")
    merge = git("commit-tree", tree, "-p", base, "-p", candidate, "-m", "merge")
    git("checkout", "-q", "--detach", merge)
    for label, content, exit_code, event, pr_head, expected, reason in (
        ("positive", "docs_fast_path=true\ndocs_fast_path_reason=safe\n", "0", "pull_request", candidate, "false", "safe"),
        ("false", "docs_fast_path=false\ndocs_fast_path_reason=outside\n", "0", "pull_request", candidate, "true", "outside"),
        ("mixed case", "docs_fast_path=True\ndocs_fast_path_reason=safe\n", "0", "pull_request", candidate, "true", "classifier output missing or invalid"),
        ("missing", "", "0", "pull_request", candidate, "true", "classifier output missing or invalid"),
        ("duplicate", "docs_fast_path=true\ndocs_fast_path=true\ndocs_fast_path_reason=safe\n", "0", "pull_request", candidate, "true", "classifier output missing or invalid"),
        ("failure after true", "docs_fast_path=true\ndocs_fast_path_reason=safe\n", "2", "pull_request", candidate, "true", "base classifier unavailable or failed"),
        ("wrong parent", "docs_fast_path=true\ndocs_fast_path_reason=safe\n", "0", "pull_request", base, "true", "merge binding unavailable or mismatched"),
        ("push", "docs_fast_path=true\ndocs_fast_path_reason=safe\n", "0", "push", candidate, "true", "non-pull-request event requires full validation"),
        ("merge group", "docs_fast_path=true\ndocs_fast_path_reason=safe\n", "0", "merge_group", candidate, "true", "non-pull-request event requires full validation"),
    ):
        evidence = fixture / "evidence"
        evidence.mkdir(exist_ok=True)
        output = fixture / "output"
        output.write_text("")
        env = dict(os.environ, DEV_V1_EVIDENCE_ROOT=str(evidence), GITHUB_OUTPUT=str(output), MERGE_GROUP_RUN_ID="",
                   GITHUB_SHA=merge, EVENT_NAME=event, PR_HEAD_SHA=pr_head,
                   FAKE_CONTENT=content, FAKE_EXIT=exit_code)
        result = subprocess.run(["bash", "-euo", "pipefail", "-c", fast_script], cwd=fixture, env=env,
                                capture_output=True, text=True)
        lines = output.read_text().splitlines()
        if result.returncode or f"run_full={expected}" not in lines or f"reason={reason}" not in lines:
            raise SystemExit(f"Fast workflow case {label} failed: {lines} {result.stderr}")
    workload_env = fixture / "workload-env"
    runner_temp = fixture / "runner-temp"
    runner_temp.mkdir()
    env.update(GITHUB_ENV=str(workload_env), DEV_V1_DEADLINE_EPOCH="2000", RUNNER_TEMP=str(runner_temp))
    for proof, exit_code, expected in (
        ("restore_imports_verified=true\n", "0", "false"),
        ("restore_imports_verified=true\n", "1", "true"),
        ("restore_imports_verified=True\n", "0", "true"),
        ("", "0", "true"),
        ("restore_imports_verified=true\n\n", "0", "true"),
        ("restore_imports_verified=true\nrestore_imports_verified=true\n", "0", "true"),
    ):
        output.write_text("")
        workload_env.write_text("")
        env.update(EVENT_NAME="pull_request", PR_HEAD_SHA=candidate, FAKE_EXIT="0",
                   FAKE_CONTENT="docs_fast_path=verify-restore\ndocs_fast_path_reason=restore import proof required\n",
                   FAKE_PROOF=proof, FAKE_PROOF_EXIT=exit_code)
        result = subprocess.run(["bash", "-euo", "pipefail", "-c", fast_script], cwd=fixture, env=env,
                                capture_output=True, text=True)
        if result.returncode or f"run_full={expected}" not in output.read_text().splitlines():
            raise SystemExit(f"Restore certificate workflow case {proof!r}, {exit_code}: {output.read_text()} {result.stderr}")
        proof_evidence = (evidence / "classification.md").read_text().splitlines()
        if f"restoreProofExitCode={exit_code}" not in proof_evidence:
            raise SystemExit(f"Restore proof exit status {exit_code} is missing from evidence")
        elapsed = re.search(r"^restoreProofElapsedSeconds=(\d+)$", "\n".join(proof_evidence), re.M)
        if not elapsed:
            raise SystemExit("Restore proof duration is missing from evidence")
        expected_deadline = f"DEV_V1_DEADLINE_EPOCH={2000 + int(elapsed[1])}\n" if expected == "true" else ""
        if workload_env.read_text() != expected_deadline:
            raise SystemExit("Restore proof time changed the fallback workload budget")

    # Shorten only the duration in the actual shell so this exercises GNU
    # timeout without spending the production allowance on every contract run.
    if fast_script.count(" 30s bash ") != 1:
        raise SystemExit("Expected one bounded restore proof in the workflow")
    output.write_text("")
    workload_env.write_text("")
    scratch_record = fixture / "proof-scratch"
    timed_env = dict(env, FAKE_PROOF="restore_imports_verified=true\n", FAKE_PROOF_EXIT="0", FAKE_PROOF_DELAY="10",
                     FAKE_PROOF_SCRATCH_RECORD=str(scratch_record))
    result = subprocess.run(["bash", "-euo", "pipefail", "-c", fast_script.replace(" 30s bash ", " 1s bash ")],
                            cwd=fixture, env=timed_env, capture_output=True, text=True, timeout=8)
    proof_evidence = (evidence / "classification.md").read_text()
    elapsed = re.search(r"^restoreProofElapsedSeconds=(\d+)$", proof_evidence, re.M)
    if (result.returncode or "run_full=true" not in output.read_text().splitlines() or not elapsed or
            "restoreProofExitCode=124" not in proof_evidence.splitlines() or int(elapsed[1]) < 1 or
            workload_env.read_text() != f"DEV_V1_DEADLINE_EPOCH={2000 + int(elapsed[1])}\n"):
        raise SystemExit(f"Timed-out proof failed to preserve full workload: {output.read_text()} {result.stderr}")
    scratch = pathlib.Path(scratch_record.read_text().strip())
    if scratch.parent != runner_temp or scratch.exists():
        raise SystemExit("Timed-out proof scratch was not removed")

    # The classifier shell exits on TERM while its writer ignores it. Inject
    # the cleanup failure on every run instead of relying on a filesystem race.
    writer_record = fixture / "proof-writer-pid"
    cleanup_bin = fixture / "cleanup-bin"
    cleanup_bin.mkdir()
    fake_rm = cleanup_bin / "rm"
    fake_rm.write_text('#!/usr/bin/env bash\nprintf "%s\\n" "Directory not empty (fixture)" >&2\nexit 1\n')
    fake_rm.chmod(0o700)

    def writer_is_running(pid):
        try:
            state = pathlib.Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[0]
        except FileNotFoundError:
            return False
        return state not in ("Z", "X")

    output.write_text("")
    workload_env.write_text("")
    writer_env = dict(env, FAKE_PROOF="restore_imports_verified=true\n", FAKE_PROOF_EXIT="0",
                      FAKE_PROOF_WRITER_RECORD=str(writer_record), PATH=f"{cleanup_bin}:{os.environ['PATH']}")
    try:
        result = subprocess.run(["bash", "-euo", "pipefail", "-c", fast_script.replace(" 30s bash ", " 1s bash ")],
                                cwd=fixture, env=writer_env, capture_output=True, text=True, timeout=8)
        proof_evidence = (evidence / "classification.md").read_text()
        elapsed = re.search(r"^restoreProofElapsedSeconds=(\d+)$", proof_evidence, re.M)
        if (result.returncode or "run_full=true" not in output.read_text().splitlines() or
                "Directory not empty (fixture)" not in result.stderr or
                "restoreProofExitCode=124" not in proof_evidence.splitlines() or not elapsed or int(elapsed[1]) < 1 or
                workload_env.read_text() != f"DEV_V1_DEADLINE_EPOCH={2000 + int(elapsed[1])}\n"):
            raise SystemExit(f"Lingering writer cleanup prevented full validation: {output.read_text()} {result.stderr}")
        writer_pid = int(writer_record.read_text())
        stopped_by = time.monotonic() + 1
        while writer_is_running(writer_pid) and time.monotonic() < stopped_by:
            time.sleep(0.01)
        if writer_is_running(writer_pid):
            raise SystemExit("A TERM-resistant proof writer survived the workflow decision")
    finally:
        if writer_record.exists():
            writer_pid = int(writer_record.read_text())
            if writer_is_running(writer_pid):
                try:
                    os.kill(writer_pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
    output.write_text("")
    env.update(FAKE_PROOF="restore_imports_verified=true\n", FAKE_PROOF_EXIT="0",
               FAKE_MERGE_CONTENT="docs_fast_path=true\ndocs_fast_path_reason=safe\n")
    result = subprocess.run(["bash", "-euo", "pipefail", "-c", fast_script], cwd=fixture, env=env,
                            capture_output=True, text=True)
    if result.returncode or "reason=classification endpoints disagree" not in output.read_text().splitlines() or \
            "run_full=true" not in output.read_text().splitlines():
        raise SystemExit(f"Disagreeing restore modes qualified: {output.read_text()} {result.stderr}")
    env.pop("FAKE_MERGE_CONTENT")
    # A one-parent checkout with no head must never qualify.
    git("checkout", "-q", "--detach", candidate)
    output.write_text("")
    env.update(GITHUB_SHA=candidate, EVENT_NAME="pull_request", PR_HEAD_SHA="")
    result = subprocess.run(["bash", "-euo", "pipefail", "-c", fast_script], cwd=fixture, env=env,
                            capture_output=True, text=True)
    if result.returncode or "reason=merge binding unavailable or mismatched" not in output.read_text().splitlines():
        raise SystemExit(f"Missing PR head qualified: {output.read_text()} {result.stderr}")
    # Real base classifier must reject a candidate edit to the classifier itself,
    # even if that candidate tries to print a passing answer.
    git("checkout", "-q", "--detach", base)
    trusted.write_text((root / "scripts/ci:classify").read_text())
    (fixture / "docs").mkdir(exist_ok=True)
    (fixture / "docs/safe.md").write_text("original\n")
    (fixture / "src/fixture").mkdir(parents=True)
    (fixture / "src/fixture/fixture.csproj").write_text("<Project />\n")
    (fixture / "HVO.SkyMonitor.v9.slnx").write_text('<Solution><Project Path="src/fixture/fixture.csproj" /></Solution>\n')
    git("add", "scripts/ci:classify", "docs/safe.md", "src/fixture/fixture.csproj", "HVO.SkyMonitor.v9.slnx")
    git("commit", "-qm", "real trusted classifier")
    generated = subprocess.run(["bash", str(trusted), "--print-docs-inventory", "HEAD"],
                               cwd=fixture, capture_output=True, text=True, check=True).stdout
    (fixture / "scripts/ci:docs-inventory").write_text(generated)
    git("add", "scripts/ci:docs-inventory")
    git("commit", "-qm", "certify base")
    real_base = git("rev-parse", "HEAD")
    trusted.write_text('#!/usr/bin/env bash\nprintf "docs_fast_path=true\ndocs_fast_path_reason=forged\n"\n')
    (fixture / "docs/safe.md").write_text("changed\n")
    git("commit", "-qam", "untrusted classifier")
    real_head = git("rev-parse", "HEAD")
    real_tree = git("rev-parse", "HEAD^{tree}")
    real_merge = git("commit-tree", real_tree, "-p", real_base, "-p", real_head, "-m", "merge")
    git("checkout", "-q", "--detach", real_merge)
    output.write_text("")
    env.update(GITHUB_SHA=real_merge, EVENT_NAME="pull_request", PR_HEAD_SHA=real_head)
    result = subprocess.run(["bash", "-euo", "pipefail", "-c", fast_script], cwd=fixture, env=env,
                            capture_output=True, text=True)
    if result.returncode or "run_full=true" not in output.read_text().splitlines() or \
            "reason=path outside documentation allowlist" not in output.read_text().splitlines():
        raise SystemExit(f"Candidate classifier edit was trusted: {output.read_text()} {result.stderr}")
    # A moved base links the edited document. The decision uses the merge tree,
    # even when an older payload base would have classified the doc as safe.
    git("checkout", "-q", "--detach", real_base)
    (fixture / "Directory.Build.targets").write_text('<None Include="docs/safe.md" />\n')
    git("add", "Directory.Build.targets")
    git("commit", "-qm", "base introduces link")
    linked_base = git("rev-parse", "HEAD")
    git("checkout", "-q", "--detach", real_base)
    (fixture / "docs/safe.md").write_text("candidate edit\n")
    git("commit", "-qam", "doc edit")
    doc_head = git("rev-parse", "HEAD")
    git("checkout", "-q", "--detach", linked_base)
    git("merge", "--no-ff", "-m", "merge", doc_head)
    linked_merge = git("rev-parse", "HEAD")
    output.write_text("")
    env.update(GITHUB_SHA=linked_merge, EVENT_NAME="pull_request", PR_HEAD_SHA=doc_head)
    result = subprocess.run(["bash", "-euo", "pipefail", "-c", fast_script], cwd=fixture, env=env,
                            capture_output=True, text=True)
    if result.returncode or "reason=deleted or type-changed path in exact diff" not in output.read_text().splitlines():
        raise SystemExit(f"Moved-base link was not rejected: {output.read_text()} {result.stderr}")
    # A merge tree that drops a base-side code file is also classified against
    # the actual first parent, not the stale payload base.
    git("checkout", "-q", "--detach", real_base)
    (fixture / "code.cs").write_text("code\n")
    git("add", "code.cs")
    git("commit", "-qm", "base code")
    code_base = git("rev-parse", "HEAD")
    doc_tree = git("rev-parse", doc_head + "^{tree}")
    changed_merge = git("commit-tree", doc_tree, "-p", code_base, "-p", doc_head, "-m", "merge")
    git("checkout", "-q", "--detach", changed_merge)
    output.write_text("")
    env.update(GITHUB_SHA=changed_merge, PR_HEAD_SHA=doc_head)
    result = subprocess.run(["bash", "-euo", "pipefail", "-c", fast_script], cwd=fixture, env=env,
                            capture_output=True, text=True)
    if result.returncode or "run_full=true" not in output.read_text().splitlines():
        raise SystemExit(f"Changed merge tree qualified: {output.read_text()} {result.stderr}")
    # The PR tip deletes a base-only source file while the merge keeps it;
    # the merge-only diff is documentation but the exact tip diff is unsafe.
    git("checkout", "-q", "--detach", code_base)
    (fixture / "docs/safe.md").write_text("candidate edit\n")
    git("add", "docs/safe.md")
    kept_tree = git("write-tree")
    kept_merge = git("commit-tree", kept_tree, "-p", code_base, "-p", doc_head, "-m", "merge")
    git("reset", "--hard", "-q", kept_merge)
    output.write_text("")
    env.update(GITHUB_SHA=kept_merge, PR_HEAD_SHA=doc_head)
    result = subprocess.run(["bash", "-euo", "pipefail", "-c", fast_script], cwd=fixture, env=env,
                            capture_output=True, text=True)
    if result.returncode or "reason=deleted or type-changed path in exact diff" not in output.read_text().splitlines():
        raise SystemExit(f"Unsafe PR endpoint qualified: {output.read_text()} {result.stderr}")
    # A safe PR tip followed by an unsafe merge must evaluate both endpoints.
    git("checkout", "-q", "--detach", real_base)
    (fixture / "code.cs").write_text("unexpected merge code\n")
    (fixture / "docs/safe.md").write_text("candidate edit\n")
    git("add", "code.cs", "docs/safe.md")
    unsafe_tree = git("write-tree")
    unsafe_merge = git("commit-tree", unsafe_tree, "-p", real_base, "-p", doc_head, "-m", "merge")
    git("reset", "--hard", "-q", unsafe_merge)
    output.write_text("")
    env.update(GITHUB_SHA=unsafe_merge, PR_HEAD_SHA=doc_head)
    result = subprocess.run(["bash", "-euo", "pipefail", "-c", fast_script], cwd=fixture, env=env,
                            capture_output=True, text=True)
    evidence_text = (evidence / "classification.md").read_text()
    if result.returncode or "run_full=true" not in output.read_text().splitlines() or \
            f"Classification endpoint: {doc_head}" not in evidence_text or \
            f"Classification endpoint: {unsafe_merge}" not in evidence_text:
        raise SystemExit(f"Unsafe merge endpoint qualified: {output.read_text()} {result.stderr}")

    # Existing imports of XML or arbitrary suffixes must be included in the
    # base-controlled inventory and audited through the actual workflow shell.
    for suffix in ("xml", "items"):
        git("checkout", "-q", "--detach", real_base)
        (fixture / "Directory.Build.targets").write_text(f'<Import Project="linked.{suffix}" />\n')
        (fixture / f"linked.{suffix}").write_text("<Project />\n")
        git("add", "Directory.Build.targets", f"linked.{suffix}")
        git("commit", "-qm", "safe import")
        generated = subprocess.run(["bash", str(trusted), "--print-docs-inventory", "HEAD"],
                                   cwd=fixture, capture_output=True, text=True, check=True).stdout
        (fixture / "scripts/ci:docs-inventory").write_text(generated)
        git("add", "scripts/ci:docs-inventory")
        git("commit", "-qm", "certify safe import")
        (fixture / f"linked.{suffix}").write_text('<None Include="docs/safe.md" />\n')
        git("commit", "-qam", "unsafe imported item")
        import_base = git("rev-parse", "HEAD")
        (fixture / "docs/safe.md").write_text("docs edit\n")
        git("commit", "-qam", "docs edit")
        import_head = git("rev-parse", "HEAD")
        import_tree = git("rev-parse", "HEAD^{tree}")
        import_merge = git("commit-tree", import_tree, "-p", import_base, "-p", import_head, "-m", "merge")
        git("checkout", "-q", "--detach", import_merge)
        output.write_text("")
        env.update(GITHUB_SHA=import_merge, PR_HEAD_SHA=import_head)
        result = subprocess.run(["bash", "-euo", "pipefail", "-c", fast_script], cwd=fixture, env=env,
                                capture_output=True, text=True)
        if result.returncode or "run_full=true" not in output.read_text().splitlines():
            raise SystemExit(f"Unsafe {suffix} import qualified: {output.read_text()} {result.stderr}")
    # Both SDK declaration forms in an imported file must be rejected even if
    # its changed blob was written into a forged inventory certificate.
    for sdk_form in ("attribute", "element"):
        git("checkout", "-q", "--detach", real_base)
        (fixture / "src/fixture/fixture.csproj").write_text('<Project><Import Project="shared.props" /></Project>\n')
        (fixture / "src/fixture/shared.props").write_text("<Project />\n")
        git("add", "src/fixture/fixture.csproj", "src/fixture/shared.props")
        git("commit", "-qm", "safe shared import")
        generated = subprocess.run(["bash", str(trusted), "--print-docs-inventory", "HEAD"],
                                   cwd=fixture, capture_output=True, text=True, check=True).stdout
        (fixture / "scripts/ci:docs-inventory").write_text(generated)
        git("add", "scripts/ci:docs-inventory")
        git("commit", "-qm", "certify shared import")
        shared = ('<Project Sdk="Microsoft.NET.Sdk" />\n' if sdk_form == "attribute" else
                  '<Project><Sdk Name="Microsoft.NET.Sdk" /></Project>\n')
        (fixture / "src/fixture/shared.props").write_text(shared)
        git("commit", "-qam", "imported SDK")
        meta, path = git("ls-tree", "HEAD", "src/fixture/shared.props").split("\t", 1)
        certificate = fixture / "scripts/ci:docs-inventory"
        lines = certificate.read_text().splitlines()
        matching = [index for index, line in enumerate(lines) if line.endswith(repr(path.encode()))]
        if len(matching) != 1:
            raise SystemExit("Shared import missing from synthetic certificate")
        lines[matching[0]] = meta + " " + repr(path.encode())
        certificate.write_text("\n".join(lines) + "\n")
        git("add", "scripts/ci:docs-inventory")
        git("commit", "-qm", "forge certificate")
        sdk_base = git("rev-parse", "HEAD")
        (fixture / "docs/safe.md").write_text("docs edit\n")
        git("commit", "-qam", "docs edit")
        sdk_head = git("rev-parse", "HEAD")
        sdk_tree = git("rev-parse", "HEAD^{tree}")
        sdk_merge = git("commit-tree", sdk_tree, "-p", sdk_base, "-p", sdk_head, "-m", "merge")
        git("checkout", "-q", "--detach", sdk_merge)
        output.write_text("")
        env.update(GITHUB_SHA=sdk_merge, PR_HEAD_SHA=sdk_head)
        result = subprocess.run(["bash", "-euo", "pipefail", "-c", fast_script], cwd=fixture, env=env,
                                capture_output=True, text=True)
        if result.returncode or "reason=project inventory unavailable" not in output.read_text().splitlines():
            raise SystemExit(f"Imported SDK {sdk_form} qualified: {output.read_text()} {result.stderr}")
    # Preserve the expected merge identifier in the later manifest case.
    env.update(GITHUB_SHA=changed_merge)
    output.write_text("")
    result = subprocess.run(["bash", "-euo", "pipefail", "-c", fast_script], cwd=fixture,
                            env=dict(env, EVENT_NAME="push", MERGE_GROUP_RUN_ID="42", PR_HEAD_SHA=""),
                            capture_output=True, text=True)
    if (result.returncode or "run_full=false" not in output.read_text().splitlines() or
            "mergeGroupRunId=42" not in (evidence / "classification.md").read_text().splitlines()):
        raise SystemExit(f"Verified merge-group push selected the wrong workload: {output.read_text()} {result.stderr}")
    # Execute the actual manifest step for both fast paths and missing-output fallback.
    summary_step = step(job(short, "build-unit"), "Write evidence summary")
    summary_script = textwrap.dedent(summary_step.split("        run: |\n", 1)[1])
    (evidence / "unit").mkdir(exist_ok=True)
    (evidence / "timing").mkdir(exist_ok=True)
    summary = fixture / "step-summary.md"
    for decision, outcome, group_id, expected in (("false", "success", "", True), ("", "failure", "", False),
                                                   ("false", "success", "42", False)):
        event, summary_base, summary_head = ("push", "", "") if group_id else ("pull_request", code_base, doc_head)
        group_url = f"https://github.com/example/repo/actions/runs/{group_id}" if group_id else None
        env.update(CLASSIFY_OUTCOME=outcome, RUN_FULL=decision, WORKLOAD_REASON="", MERGE_GROUP_RUN_ID=group_id,
                   CLASSIFIED_BASE=summary_base, GITHUB_EVENT_NAME=event, PR_HEAD_SHA=summary_head,
                   GITHUB_SERVER_URL="https://github.com", GITHUB_REPOSITORY="example/repo", GITHUB_STEP_SUMMARY=str(summary),
                   RESTORE_OUTCOME="skipped", BUILD_OUTCOME="skipped", UNIT_OUTCOME="skipped",
                   COVERAGE_OUTCOME="skipped", DEV_V1_STARTED_AT_EPOCH="0")
        result = subprocess.run(["bash", "-euo", "pipefail", "-c", summary_script], cwd=fixture, env=env,
                                capture_output=True, text=True)
        if result.returncode:
            raise SystemExit(f"Manifest simulation failed: {result.stderr}")
        manifest = json.loads((evidence / "manifest.json").read_text())
        if (manifest["docsFastPath"] is not expected or not manifest["docsFastPathReason"] or
                manifest["baseSha"] != summary_base or manifest["prHeadSha"] != summary_head or
                manifest["mergeSha"] != changed_merge or manifest["schema"] != "hvo-development-v1-ci-v6" or
                manifest["mergeGroupRunUrl"] != group_url or
                (decision == "false" and (manifest["sdkVersion"] is not None or manifest["unitTrxCount"] != 0)) or
                (group_url and (group_url not in summary.read_text() or changed_merge not in summary.read_text()))):
            raise SystemExit(f"Invalid manifest evidence: {manifest}")
    print("Fast workflow shell: 29 decision, binding and trusted-base cases; 3 manifest cases passed.")

# Exercise the real final promotion step with an offline gh substitute. Creating
# a PR must be draft; refreshing one must preserve its state; API errors must fail.
promotion_step = promotion.split("      - name: Open or refresh the promotion pull request\n", 1)[1]
promotion_script = textwrap.dedent(promotion_step.split("        run: |\n", 1)[1])
promotion_settings = promotion_step.split("        run: |\n", 1)[0]
shell_match = re.search(r"^        shell: (.+)$", promotion_settings, re.M)
if shell_match and shell_match.group(1) != "bash":
    raise SystemExit("Update the promotion regression for the configured shell")
# Match Actions: unspecified Linux shell is bash -e; explicit bash also enables
# pipefail. Removing shell: bash must therefore make the API-failure cases fail.
promotion_shell = (["bash", "--noprofile", "--norc", "-e", "-o", "pipefail", "-c"]
                   if shell_match else ["bash", "-e", "-c"])
with tempfile.TemporaryDirectory(prefix="hvo-v1-ci-") as directory:
    fixture = pathlib.Path(directory)
    gh = fixture / "gh"
    gh.write_text("""#!/usr/bin/env python3
import json, os, sys
args = sys.argv[1:]
with open(os.environ["HVO_V1_TEST_CALLS"], "a") as output:
    output.write(json.dumps(args) + "\\n")
if args[:3] in (["api", "-X", "POST"], ["api", "-X", "PATCH"]):
    if os.environ["HVO_V1_TEST_FAIL"] == "1":
        sys.exit(23)
    print("https://github.com/example/repo/pull/42")
elif args[0] == "api" and "/compare/" in args[1]:
    print("- aaaaaaaa fixture" + (" (#1142)" if os.environ["HVO_V1_TEST_REFERENCES"] == "1" else ""))
elif args[0] == "api" and "/pulls?" in args[1]:
    print(os.environ["HVO_V1_TEST_EXISTING"])
else:
    sys.exit(24)
""")
    gh.chmod(0o700)
    for existing, failure, references in itertools.product(("", "42"), (False, True), (False, True)):
        calls = fixture / "calls.jsonl"
        calls.write_text("")
        environment = dict(
            os.environ, PATH=f"{fixture}:{os.environ['PATH']}",
            REPOSITORY="example/repo", SOURCE="development/v1", TARGET="main",
            SOURCE_SHA="a" * 40, TARGET_SHA="b" * 40, AHEAD="1",
            RUN_URL="https://github.com/example/repo/actions/runs/1", TRIGGER="schedule",
            GITHUB_STEP_SUMMARY=str(fixture / "summary.md"),
            HVO_V1_TEST_CALLS=str(calls), HVO_V1_TEST_EXISTING=existing,
            HVO_V1_TEST_FAIL="1" if failure else "0",
            HVO_V1_TEST_REFERENCES="1" if references else "0",
        )
        result = subprocess.run(
            [*promotion_shell, promotion_script],
            env=environment, capture_output=True, text=True,
        )
        if (result.returncode != 0) != failure:
            raise SystemExit(f"Promotion result was not fail-closed: {result.stderr}")
        requests = [json.loads(line) for line in calls.read_text().splitlines()
                     if json.loads(line)[:2] == ["api", "-X"]]
        if len(requests) != 1:
            raise SystemExit(f"Unexpected promotion mutations: {requests}")
        request = requests[0]
        if existing:
            if request[:3] != ["api", "-X", "PATCH"] or any("draft=" in arg for arg in request):
                raise SystemExit("Refreshing a promotion changed its draft/ready state")
        elif request[:3] != ["api", "-X", "POST"] or "draft=true" not in request:
            raise SystemExit("New promotion was not created as draft")
print(f"Development v1 CI contracts passed; {len(mutations)} mutation controls and 8 offline promotion cases passed.")


pr_workflow_prefixes = {"development-v1.yml": "development-v1-", "ci.yml": "ci-${{ github.workflow }}-"}


def queue_safe_concurrency(path, workflow):
    config = yaml.load(workflow, Loader=yaml.BaseLoader)
    events = config["on"]
    if isinstance(events, str):
        events = [events]
    if path in pr_workflow_prefixes:
        return ("pull_request" in events and config.get("concurrency") == {
            "group": pr_workflow_prefixes[path] + "${{ github.event_name }}-" +
                     "${{ github.event_name == 'merge_group' && github.run_id || github.event.pull_request.number || github.ref }}",
            "cancel-in-progress": "${{ github.event_name != 'merge_group' }}",
        } and all("concurrency" not in job for job in config["jobs"].values()))
    if path == "merge-queue-reviewed-head.yml":
        return (set(events) == {"merge_group"} and "concurrency" not in config and
                all("concurrency" not in job for job in config["jobs"].values()))
    return not {"pull_request", "pull_request_target", "merge_group"}.intersection(events)


for path, workflow in workflows.items():
    if not queue_safe_concurrency(path, workflow):
        raise SystemExit(f"Review PR and merge-group concurrency for {path}")
for path in pr_workflow_prefixes:
    for original, replacement in (
        ("github.event_name != 'merge_group'", "true"),
        ("github.event_name == 'merge_group' && github.run_id || ", ""),
        ("${{ github.event_name }}-", ""),
    ):
        if queue_safe_concurrency(path, workflows[path].replace(original, replacement, 1)):
            raise SystemExit(f"Concurrency mutation passed for {path}: {original}")
if queue_safe_concurrency("new-workflow.yml", "on: [push, pull_request]\n"):
    raise SystemExit("A new PR workflow escaped the concurrency audit")
print(f"Workflow concurrency: {len(workflows)} workflows audited; 7 mutation controls passed.")


def pi5_contract(workflow):
    config = yaml.load(workflow, Loader=yaml.BaseLoader)
    triggers = config["on"]
    performance = config["jobs"]["performance"]
    steps = {step["name"]: step for step in performance["steps"]}
    restore = steps["Restore last accepted Pi baseline"]
    run = steps["Run and compare Performance cases"]
    save = steps["Save accepted Pi baseline"]
    return (
        set(triggers) == {"push", "schedule", "workflow_dispatch"}
        and triggers["push"] == {"branches": ["development/v1"]}
        and triggers["schedule"] == [{"cron": "0 9 * * *"}]
        and config["concurrency"] == {"group": "skymonitor-perf-${{ github.ref }}", "cancel-in-progress": "true"}
        and set(config["jobs"]) == {"performance"}
        and performance["if"] == "github.ref == 'refs/heads/development/v1'"
        and performance["runs-on"] == ["self-hosted", "linux", "arm64", "pi5", "hvo-skymonitor-arm64"]
        and performance["timeout-minutes"] == "30"
        and steps["Setup .NET from global.json"]["with"] == {
            "dotnet-version": "10.0.402", "global-json-file": "global.json"
        }
        and "needs" not in performance and "continue-on-error" not in performance
        and restore.get("id") == "restore-baseline"
        and restore.get("if") == "${{ !inputs.reset_baseline }}"
        and run.get("env", {}).get("PI5_CACHE_MATCHED_KEY") == "${{ steps.restore-baseline.outputs.cache-matched-key }}"
        and run.get("env", {}).get("PI5_CACHE_RESTORE_OUTCOME") == "${{ steps.restore-baseline.outcome }}"
        and "ci/pi5_performance.py" in run["run"]
        and "continue-on-error" not in run and "if" not in run
        and "if" not in save and "continue-on-error" not in save
        and list(steps).index(run["name"]) < list(steps).index(save["name"])
    )


if not pi5_contract(pi5):
    raise SystemExit("Pi 5 Performance workflow lost its standalone, fail-closed contract")
for original, replacement in (
    ("on:\n", "on:\n  pull_request:\n"),
    ("on:\n", "on:\n  merge_group:\n"),
    ("development/v1]", "main]"),
    ("0 9 * * *", "17 9 * * *"),
    ("skymonitor-perf-", "cameraagent-arm64-advisory-"),
    ("cancel-in-progress: true", "cancel-in-progress: false"),
    ("timeout-minutes: 30", "timeout-minutes: 45"),
    ("10.0.402", "10.0.403"),
    ("arm64, pi5,", "arm64,"),
    ("hvo-skymonitor-arm64", "hvo-skymonitor"),
    ("outputs.cache-matched-key", "outputs.cache-hit"),
    ("steps.restore-baseline.outcome", "'success'"),
    ("- name: Run and compare Performance cases", "- name: Run and compare Performance cases\n        continue-on-error: true"),
    ("- name: Save accepted Pi baseline", "- name: Save accepted Pi baseline\n        if: always()"),
):
    if pi5_contract(pi5.replace(original, replacement, 1)):
        raise SystemExit(f"Pi 5 Performance mutation passed: {replacement}")
print("Pi 5 Performance workflow contract and 14 mutation controls passed.")
