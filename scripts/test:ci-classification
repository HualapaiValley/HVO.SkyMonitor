#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
classifier="$repo_root/scripts/ci:classify"
required="$repo_root/scripts/ci:require"
workflow="$repo_root/.github/workflows/ci.yml"
work_root="$(mktemp -d)"
fast_root="$(mktemp -d)"

declare -a parallel_pids=()
declare -a parallel_names=()
declare -a parallel_outs=()
declare -a parallel_errs=()
declare -a parallel_status=()
declare -A active_idx_to_pid=()
declare -A active_idx_to_pgid=()
launching_worker=0
pending_signal_exit=""

is_worker_dead() {
  local pid="$1" stat_line="" proc_state=""
  if ! kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  if [[ -r "/proc/$pid/stat" ]]; then
    IFS= read -r stat_line < "/proc/$pid/stat" 2>/dev/null || return 0
    proc_state="${stat_line##*) }"
    proc_state="${proc_state%% *}"
    if [[ "$proc_state" == Z || "$proc_state" == X ]]; then
      return 0
    fi
  elif command -v ps >/dev/null 2>&1; then
    proc_state="$(ps -o state= -p "$pid" 2>/dev/null | tr -d '[:space:]')" || return 0
    if [[ -z "$proc_state" || "$proc_state" == Z* || "$proc_state" == X* ]]; then
      return 0
    fi
  fi
  return 1
}

cleanup() {
  trap '' INT TERM
  set +m
  local IFS=$' \t\n'
  local idx pid pgid deadline any_alive
  local -a active_indices=("${!active_idx_to_pgid[@]}")
  if (( ${#active_indices[@]} > 0 )); then
    for idx in "${active_indices[@]}"; do
      pgid="${active_idx_to_pgid[$idx]}"
      kill -TERM -- "-$pgid" 2>/dev/null || true
    done
    deadline=$((SECONDS + 2))
    while (( SECONDS < deadline )); do
      any_alive=0
      for idx in "${!active_idx_to_pgid[@]}"; do
        if [[ -n "${active_idx_to_pid[$idx]+x}" ]]; then
          pid="${active_idx_to_pid[$idx]}"
          if is_worker_dead "$pid"; then
            wait "$pid" 2>/dev/null || true
            unset 'active_idx_to_pid[$idx]'
          fi
        fi
        pgid="${active_idx_to_pgid[$idx]}"
        if kill -0 -- "-$pgid" 2>/dev/null; then
          any_alive=1
        elif [[ -z "${active_idx_to_pid[$idx]+x}" ]]; then
          unset 'active_idx_to_pgid[$idx]'
        fi
      done
      (( any_alive == 0 )) && break
      sleep 0.05
    done
    if (( ${#active_idx_to_pgid[@]} > 0 )); then
      for idx in "${!active_idx_to_pgid[@]}"; do
        pgid="${active_idx_to_pgid[$idx]}"
        kill -KILL -- "-$pgid" 2>/dev/null || true
      done
      deadline=$((SECONDS + 1))
      while (( SECONDS < deadline )); do
        any_alive=0
        for idx in "${!active_idx_to_pgid[@]}"; do
          if [[ -n "${active_idx_to_pid[$idx]+x}" ]]; then
            pid="${active_idx_to_pid[$idx]}"
            if is_worker_dead "$pid"; then
              wait "$pid" 2>/dev/null || true
              unset 'active_idx_to_pid[$idx]'
            fi
          fi
          pgid="${active_idx_to_pgid[$idx]}"
          if kill -0 -- "-$pgid" 2>/dev/null; then
            any_alive=1
          elif [[ -z "${active_idx_to_pid[$idx]+x}" ]]; then
            unset 'active_idx_to_pgid[$idx]'
          fi
        done
        (( any_alive == 0 )) && break
        sleep 0.02
      done
      for idx in "${!active_idx_to_pgid[@]}"; do
        unset 'active_idx_to_pgid[$idx]'
      done
    fi
    for idx in "${!active_idx_to_pid[@]}"; do
      pid="${active_idx_to_pid[$idx]}"
      wait "$pid" 2>/dev/null || true
      unset 'active_idx_to_pid[$idx]'
    done
  fi
  exec 3>&- 2>/dev/null || true
  rm -rf "$work_root" "$fast_root" "$fast_root".* "$work_root".*
}
handle_signal() {
  local code="$1"
  if (( launching_worker )); then
    if [[ -z "$pending_signal_exit" ]]; then
      pending_signal_exit="$code"
    fi
    return 0
  fi
  trap '' INT TERM
  exit "${pending_signal_exit:-$code}"
}
trap cleanup EXIT
trap 'handle_signal 130' INT
trap 'handle_signal 143' TERM

max_jobs="$(nproc 2>/dev/null || printf '2\n')"
if [[ ! "$max_jobs" =~ ^[0-9]+$ ]] || (( max_jobs < 2 )); then
  max_jobs=2
elif (( max_jobs > 8 )); then
  max_jobs=8
fi

parallel_dir="$work_root.p"
mkdir -m 700 "$parallel_dir"
export TMPDIR="$parallel_dir/t"
mkdir -m 700 "$TMPDIR"
parallel_done_fifo="$parallel_dir/done.fifo"
mkfifo "$parallel_done_fifo"
exec 3<>"$parallel_done_fifo"

reap_completion_after_first_byte() {
  local first_char="$1" rest="" rest_rc=0 done_idx="" pid="" status=0
  if [[ -z "$first_char" || "$first_char" == $'\n' ]]; then
    printf 'Parallel worker completion channel reported an empty completion message.\n' >&2
    exit 1
  fi
  IFS= read -r -u 3 rest || rest_rc=$?
  if (( rest_rc != 0 )); then
    printf 'Parallel worker completion channel closed mid-message (read exit %d).\n' "$rest_rc" >&2
    exit 1
  fi
  done_idx="${first_char}${rest}"
  if [[ ! "$done_idx" =~ ^[0-9]+$ || -z "${active_idx_to_pid[$done_idx]+x}" ]]; then
    printf 'Parallel worker completion channel reported invalid dispatch index: %s\n' "$done_idx" >&2
    exit 1
  fi
  pid="${active_idx_to_pid[$done_idx]}"
  wait "$pid" || status=$?
  parallel_status[done_idx]="$status"
  unset 'active_idx_to_pid[$done_idx]'
  unset 'active_idx_to_pgid[$done_idx]'
}

drain_ready_completions() {
  local first_char="" read_rc=0
  while read -r -t 0 -u 3; do
    read_rc=0
    first_char=""
    IFS= read -r -t 1 -N 1 -u 3 first_char || read_rc=$?
    if (( read_rc == 0 )) || [[ -n "$first_char" ]]; then
      reap_completion_after_first_byte "$first_char"
    elif (( read_rc <= 128 )); then
      printf 'Parallel worker completion channel closed unexpectedly (read exit %d).\n' "$read_rc" >&2
      exit 1
    else
      break
    fi
  done
}

check_dead_workers() {
  local active_idx="" active_pid="" status=0
  local -a active_indices=()
  while true; do
    active_indices=("${!active_idx_to_pid[@]}")
    for active_idx in "${active_indices[@]}"; do
      [[ -n "${active_idx_to_pid[$active_idx]+x}" ]] || continue
      active_pid="${active_idx_to_pid[$active_idx]}"
      if is_worker_dead "$active_pid"; then
        if read -r -t 0 -u 3; then
          drain_ready_completions
          continue 2
        fi
        status=0
        wait "$active_pid" 2>/dev/null || status=$?
        printf 'Parallel test group %s (idx %s, pid %s) exited abnormally (exit %d) without reporting completion.\n' \
          "${parallel_names[$active_idx]}" "$active_idx" "$active_pid" "$status" >&2
        if [[ -s "${parallel_outs[$active_idx]}" ]]; then
          cat "${parallel_outs[$active_idx]}" >&2
        fi
        if [[ -s "${parallel_errs[$active_idx]}" ]]; then
          cat "${parallel_errs[$active_idx]}" >&2
        fi
        # Retain active_idx_to_pgid[$active_idx] so cleanup() signals and reaps
        # any reparented grandchildren remaining in this worker's process group.
        unset 'active_idx_to_pid[$active_idx]'
        exit 1
      fi
    done
    return 0
  done
}

reap_one_parallel_job() {
  local first_char="" read_rc=0 before_count=0
  while true; do
    if (( ${#active_idx_to_pid[@]} == 0 )); then
      printf 'Parallel worker reaper waited with no active workers.\n' >&2
      exit 1
    fi
    read_rc=0
    first_char=""
    IFS= read -r -t 1 -N 1 -u 3 first_char || read_rc=$?
    if (( read_rc == 0 )) || [[ -n "$first_char" ]]; then
      reap_completion_after_first_byte "$first_char"
      check_dead_workers
      return 0
    fi
    if (( read_rc <= 128 )); then
      printf 'Parallel worker completion channel closed unexpectedly (read exit %d).\n' "$read_rc" >&2
      exit 1
    fi
    before_count="${#active_idx_to_pid[@]}"
    check_dead_workers
    if (( ${#active_idx_to_pid[@]} < before_count )); then
      return 0
    fi
  done
}

start_parallel_job() {
  local name="$1"
  shift
  while (( ${#active_idx_to_pid[@]} >= max_jobs )); do
    reap_one_parallel_job
  done
  local idx="${#parallel_pids[@]}"
  local out_file="$parallel_dir/$idx.$name.out"
  local err_file="$parallel_dir/$idx.$name.err"
  local worker_tmpdir="$parallel_dir/t$idx"
  mkdir -m 700 "$worker_tmpdir"
  local pid=""
  launching_worker=1
  {
    set -m
    (
      set +m
      trap - EXIT INT TERM
      TMPDIR="$worker_tmpdir"
      export TMPDIR
      set +e
      (
        set -euo pipefail
        "$@"
      ) </dev/null >"$out_file" 2>"$err_file" 3>&-
      rc=$?
      printf '%d\n' "$idx" >&3 2>/dev/null || true
      exit "$rc"
    ) </dev/null &
    pid="$!"
    active_idx_to_pid["$idx"]="$pid"
    active_idx_to_pgid["$idx"]="$pid"
    set +m
  } 2>/dev/null
  launching_worker=0
  if [[ -n "$pending_signal_exit" ]]; then
    trap '' INT TERM
    exit "$pending_signal_exit"
  fi
  parallel_pids+=("$pid")
  parallel_names+=("$name")
  parallel_outs+=("$out_file")
  parallel_errs+=("$err_file")
  parallel_status+=("")
}

wait_parallel_jobs() {
  local failed=0 i status
  while (( ${#active_idx_to_pid[@]} > 0 )); do
    reap_one_parallel_job
  done
  for ((i = 0; i < ${#parallel_pids[@]}; i++)); do
    status="${parallel_status[$i]:-}"
    if [[ -z "$status" ]]; then
      printf 'Parallel test group %s was not reaped.\n' "${parallel_names[$i]}" >&2
      failed=1
    elif (( status != 0 )); then
      printf 'Parallel test group %s failed (exit %d):\n' "${parallel_names[$i]}" "$status" >&2
      cat "${parallel_outs[$i]}" >&2
      cat "${parallel_errs[$i]}" >&2
      failed=1
    fi
  done
  if (( failed != 0 )); then
    exit 1
  fi
}

result_jobs=(
  changes
  quality
  catalog-contracts
  catalog-reproducibility
  deployment-contracts
  build
  architecture
  coverage-policy
  migrations-cameraagent
  unit
  integration
  coverage
  shared-libraries
  cameraagent-component
  delivery-component
)

assert_plan_output() {
  local output="$1" expected_mode="$2" expected_deployment="$3"
  if [[ "$output" != "mode=$expected_mode"$'\n'"deployment=$expected_deployment"$'\n'* ]]; then
    printf 'Expected mode=%s deployment=%s, received %s\n' "$expected_mode" "$expected_deployment" "$output" >&2
    exit 1
  fi
}

assert_suites_output() {
  local output="$1" expected_catalog="$2" expected_installer="$3" expectation
  for expectation in \
    "deployment_catalog=$expected_catalog" \
    "deployment_installer=$expected_installer"; do
    grep -Fxq "$expectation" <<< "$output" || {
      printf 'Expected suite output %s, received %s\n' "$expectation" "$output" >&2
      exit 1
    }
  done
}

secret_scan_contract_cases=0
assert_secret_scan_contract_output() {
  local output="$1" expected="$2"
  grep -Fxq "secret_scan_contract=$expected" <<< "$output" || {
    printf 'Expected secret_scan_contract=%s, received %s\n' "$expected" "$output" >&2
    exit 1
  }
  ((secret_scan_contract_cases += 1))
}

release_scripts_cases=0
assert_release_scripts_output() {
  local output="$1" expected="$2"
  grep -Fxq "release_scripts=$expected" <<< "$output" || {
    printf 'Expected release_scripts=%s, received %s\n' "$expected" "$output" >&2
    exit 1
  }
  ((release_scripts_cases += 1))
}

catalog_recipe_cases=0
assert_catalog_recipe_output() {
  local output="$1" expected="$2"
  grep -Fxq "catalog_recipe=$expected" <<< "$output" || {
    printf 'Expected catalog_recipe=%s, received %s\n' "$expected" "$output" >&2
    exit 1
  }
  ((catalog_recipe_cases += 1))
}

assert_components_output() {
  local output="$1" expected_complete="$2" expected_shared="$3" expected_cameraagent="$4" expected_delivery="$5" expectation
  if grep -Eq '^(logichost|combined)=' <<< "$output"; then
    printf 'The classifier emitted a retired component output: %s\n' "$output" >&2
    exit 1
  fi
  for expectation in \
    "complete=$expected_complete" \
    "shared=$expected_shared" \
    "cameraagent=$expected_cameraagent" \
    "delivery=$expected_delivery"; do
    grep -Fxq "$expectation" <<< "$output" || {
      printf 'Expected component output %s, received %s\n' "$expectation" "$output" >&2
      exit 1
    }
  done
}

classify_in_repo() {
  local repo="$1" event_name="$2" base_sha="$3" head_sha="$4"
  (cd "$repo" && "$classifier" "$event_name" "$base_sha" "$head_sha")
}

commit_file_in() {
  local repo="$1" path="$2"
  mkdir -p "$repo/$(dirname "$path")"
  printf 'classification fixture\n' > "$repo/$path"
  git -C "$repo" add -- "$path"
  git -C "$repo" commit --quiet -m "Add $path"
}

update_file_in() {
  local repo="$1" path="$2"
  printf 'updated classification fixture\n' >> "$repo/$path"
  git -C "$repo" add -- "$path"
  git -C "$repo" commit --quiet -m "Update $path"
}

# Commit a set of initial fixture files in one git fast-import pass so
# subsequent batch_commit_files calls exercise modification (M) diffs.
seed_commit_files() {
  local repo="$1"
  shift
  (( $# > 0 )) || return 0
  local start_sha path content="seeded fixture base"$'\n' byte_len new_sha
  if ! start_sha="$(git -C "$repo" rev-parse HEAD)" || [[ -z "$start_sha" ]]; then
    printf 'seed_commit_files failed to resolve HEAD in %s\n' "$repo" >&2
    return 1
  fi
  if ! byte_len="$(LC_ALL=C printf '%s' "$content" | wc -c)" || [[ ! "$byte_len" =~ ^[0-9]+$ ]]; then
    printf 'seed_commit_files failed to compute fixture byte length.\n' >&2
    return 1
  fi
  if ! {
    printf 'commit refs/heads/fast-seed\n'
    printf 'mark :1\n'
    printf 'committer CI Classification Test <ci-classification@example.invalid> 1700000000 +0000\n'
    printf 'data 4\nseed\n'
    printf 'from %s\n' "$start_sha"
    for path in "$@"; do
      printf 'M 100644 inline "%s"\n' "$path"
      printf 'data %d\n%s\n' "$byte_len" "$content"
    done
    printf 'done\n'
  } | git -C "$repo" fast-import --quiet; then
    git -C "$repo" branch -q -D fast-seed 2>/dev/null || true
    printf 'seed_commit_files fast-import failed in %s\n' "$repo" >&2
    return 1
  fi
  if ! new_sha="$(git -C "$repo" rev-parse refs/heads/fast-seed)" || [[ -z "$new_sha" ]]; then
    git -C "$repo" branch -q -D fast-seed 2>/dev/null || true
    printf 'seed_commit_files failed to resolve refs/heads/fast-seed in %s\n' "$repo" >&2
    return 1
  fi
  if ! git -C "$repo" update-ref HEAD "$new_sha"; then
    git -C "$repo" branch -q -D fast-seed 2>/dev/null || true
    printf 'seed_commit_files update-ref HEAD failed in %s\n' "$repo" >&2
    return 1
  fi
  if ! git -C "$repo" branch -q -D fast-seed; then
    printf 'seed_commit_files failed to delete temporary branch fast-seed in %s\n' "$repo" >&2
    return 1
  fi
}

# Build a chain of single-file commits in one git fast-import pass.
# Each spec is "<path>|<content>". Emits "<base_sha> <head_sha>" per spec.
batch_commit_files() {
  local repo="$1"
  shift
  if (( $# == 0 )); then
    printf 'batch_commit_files requires at least one spec.\n' >&2
    return 1
  fi
  local start_sha spec path content mark=0 byte_len rev_out idx
  local -a spec_paths=() shas=()
  if ! start_sha="$(git -C "$repo" rev-parse HEAD)" || [[ -z "$start_sha" ]]; then
    printf 'batch_commit_files failed to resolve HEAD in %s\n' "$repo" >&2
    return 1
  fi
  for spec in "$@"; do
    spec_paths+=("${spec%%|*}")
  done
  if ! {
    for spec in "$@"; do
      path="${spec%%|*}"
      content="${spec#*|}"
      byte_len="$(LC_ALL=C printf '%s' "$content" | wc -c)" || exit 1
      ((mark += 1))
      printf 'commit refs/heads/fast-batch\n'
      printf 'mark :%d\n' "$mark"
      printf 'committer CI Classification Test <ci-classification@example.invalid> 1700000000 +0000\n'
      printf 'data 5\nbatch\n'
      if (( mark == 1 )); then
        printf 'from %s\n' "$start_sha"
      fi
      printf 'M 100644 inline "%s"\n' "$path"
      printf 'data %d\n%s\n' "$byte_len" "$content"
    done
    printf 'done\n'
  } | git -C "$repo" fast-import --quiet; then
    git -C "$repo" branch -q -D fast-batch 2>/dev/null || true
    printf 'batch_commit_files fast-import failed in %s\n' "$repo" >&2
    return 1
  fi
  if ! rev_out="$(git -C "$repo" rev-list --reverse "${start_sha}..refs/heads/fast-batch")"; then
    git -C "$repo" branch -q -D fast-batch 2>/dev/null || true
    printf 'batch_commit_files rev-list failed in %s\n' "$repo" >&2
    return 1
  fi
  if [[ -n "$rev_out" ]]; then
    mapfile -t shas <<< "$rev_out"
  fi
  if (( ${#shas[@]} != $# )); then
    git -C "$repo" branch -q -D fast-batch 2>/dev/null || true
    printf 'batch_commit_files produced %d commits for %d specs in %s\n' "${#shas[@]}" "$#" "$repo" >&2
    return 1
  fi
  local prev="$start_sha" sha diff_rc=0
  for ((idx = 0; idx < ${#shas[@]}; idx++)); do
    sha="${shas[$idx]}"
    diff_rc=0
    git -C "$repo" diff --quiet "$prev" "$sha" || diff_rc=$?
    if (( diff_rc == 0 )); then
      git -C "$repo" branch -q -D fast-batch 2>/dev/null || true
      printf 'batch_commit_files produced a no-op commit for %s (%s..%s)\n' "${spec_paths[$idx]}" "$prev" "$sha" >&2
      return 1
    elif (( diff_rc != 1 )); then
      git -C "$repo" branch -q -D fast-batch 2>/dev/null || true
      printf 'batch_commit_files diff failed (exit %d) for %s (%s..%s)\n' "$diff_rc" "${spec_paths[$idx]}" "$prev" "$sha" >&2
      return 1
    fi
    printf '%s %s\n' "$prev" "$sha"
    prev="$sha"
  done
  if ! git -C "$repo" update-ref HEAD "$prev"; then
    git -C "$repo" branch -q -D fast-batch 2>/dev/null || true
    printf 'batch_commit_files update-ref HEAD failed in %s\n' "$repo" >&2
    return 1
  fi
  if ! git -C "$repo" branch -q -D fast-batch; then
    printf 'batch_commit_files failed to delete temporary branch fast-batch in %s\n' "$repo" >&2
    return 1
  fi
}

# Populate caller's array variable with "<base_sha> <head_sha>" pairs from batch_commit_files.
# Fails closed if batch_commit_files exits non-zero or emits a different pair count than expected.
batch_commit_pairs() {
  local -n _batch_out_pairs="$1"
  local repo="$2" expected_count="$3"
  shift 3
  local batch_out=""
  if ! batch_out="$(batch_commit_files "$repo" "$@")"; then
    printf 'batch_commit_files failed in %s\n' "$repo" >&2
    return 1
  fi
  _batch_out_pairs=()
  if [[ -n "$batch_out" ]]; then
    mapfile -t _batch_out_pairs <<< "$batch_out"
  fi
  if (( ${#_batch_out_pairs[@]} != expected_count )); then
    printf 'batch_commit_files returned %d pairs in %s, expected %d\n' \
      "${#_batch_out_pairs[@]}" "$repo" "$expected_count" >&2
    return 1
  fi
}

assert_diff_status() {
  local repo="$1" base="$2" head="$3" expected_status="$4" path="$5" actual_status
  actual_status="$(git -C "$repo" diff --name-status --no-renames "$base" "$head")"
  if [[ "$actual_status" != "$expected_status"$'\t'"$path" ]]; then
    printf 'Expected diff status %s for %s, received %s\n' "$expected_status" "$path" "$actual_status" >&2
    exit 1
  fi
}

# Verify a batch of component plan rows ("path|mode|deployment|complete|shared|cameraagent|delivery[|status]")
# using one fast-import pass and one classifier invocation per row.
verify_component_plan_batch() {
  local repo="$1"
  shift
  local -a rows=("$@") specs=() pairs=()
  local i path expected_mode expected_deployment expected_complete expected_shared expected_cameraagent expected_delivery expected_status
  local base head output
  for ((i = 0; i < ${#rows[@]}; i++)); do
    IFS='|' read -r path _ <<< "${rows[$i]}"
    specs+=("$path|classification fixture $i"$'\n')
  done
  batch_commit_pairs pairs "$repo" "${#rows[@]}" "${specs[@]}"
  for ((i = 0; i < ${#rows[@]}; i++)); do
    expected_status=""
    IFS='|' read -r path expected_mode expected_deployment expected_complete expected_shared expected_cameraagent expected_delivery expected_status <<< "${rows[$i]}"
    read -r base head <<< "${pairs[$i]}"
    if [[ -n "$expected_status" ]]; then
      assert_diff_status "$repo" "$base" "$head" "$expected_status" "$path"
    fi
    output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
    assert_plan_output "$output" "$expected_mode" "$expected_deployment"
    assert_components_output "$output" "$expected_complete" "$expected_shared" "$expected_cameraagent" "$expected_delivery"
  done
}

# ==============================================================================
# Seed isolated repositories once before launching parallel test groups.
# ==============================================================================

# 1. Seed fast_root for docs fast-path and certificate tests.
git init -q "$fast_root"
git -C "$fast_root" config user.email fixture@example.invalid
git -C "$fast_root" config user.name fixture
mkdir -p "$fast_root/tests/Example" "$fast_root/docs/contracts"
printf '<None Include="../../docs/contracts/linked.md" />\n' > "$fast_root/tests/Example/Example.csproj"
printf 'old\n' > "$fast_root/docs/contracts/linked.md"
printf '<Solution><Project Path="tests/Example/Example.csproj" /></Solution>\n' > "$fast_root/HVO.SkyMonitor.v9.slnx"
git -C "$fast_root" add .
git -C "$fast_root" commit -qm base
mkdir -p "$fast_root/scripts"
(cd "$fast_root" && "$classifier" --print-docs-inventory HEAD) > "$fast_root/scripts/ci:docs-inventory"
git -C "$fast_root" add scripts/ci:docs-inventory
git -C "$fast_root" commit -qm inventory
fast_base="$(git -C "$fast_root" rev-parse HEAD)"

# Commit modified_base and modified_head once into fast_root's object store so
# both fast_group_1 (fake git show) and fast_group_4 (fault controls) share them.
printf 'original\n' > "$fast_root/docs/modified.md"
git -C "$fast_root" add docs/modified.md
git -C "$fast_root" commit -qm modified-base
modified_base="$(git -C "$fast_root" rev-parse HEAD)"
printf 'change\n' >> "$fast_root/docs/modified.md"
git -C "$fast_root" commit -qam modified
modified_head="$(git -C "$fast_root" rev-parse HEAD)"
git -C "$fast_root" reset -q --hard "$fast_base"

fast_real_git="$(command -v git)"

# Prepare certificate-case seed repository (with mutant classifiers and base files).
cert_seed_root="$fast_root.cert-seed"
cp -a "$fast_root" "$cert_seed_root"
python3 - "$classifier" "$cert_seed_root/.git" <<'PY'
import pathlib
import sys

classifier = pathlib.Path(sys.argv[1]).read_text()
directory = pathlib.Path(sys.argv[2])
for name, original, replacement in (
    ("nested-sdk", " and node is root", ""),
    ("external-sdk", 'node.attrib["Sdk"] in ("Microsoft.NET.Sdk", "Microsoft.NET.Sdk.Web")', "True"),
):
    if classifier.count(original) != 1:
        raise SystemExit(f"Could not construct the certificate fixture mutation {name}")
    (directory / f"classifier-{name}").write_text(classifier.replace(original, replacement))
PY
mkdir -p "$cert_seed_root/scripts/ci" "$cert_seed_root/docs/runbooks"
cp "$repo_root/scripts/ci/restore-imports.py" "$cert_seed_root/scripts/ci/restore-imports.py"
cp "$repo_root/global.json" "$cert_seed_root/global.json"
printf '<Project Sdk="Microsoft.NET.Sdk"><Import Project="shared.props" /></Project>\n' > "$cert_seed_root/tests/Example/Example.csproj"
printf '<Project><ItemGroup><PackageReference Include="Fixture" Version="1.0.0" /></ItemGroup></Project>\n' > "$cert_seed_root/tests/Example/shared.props"
printf 'original\n' > "$cert_seed_root/docs/runbooks/certified.md"
git -C "$cert_seed_root" add .
git -C "$cert_seed_root" commit -qm cert-seed-base
cert_seed_base="$(git -C "$cert_seed_root" rev-parse HEAD)"

# 2. Seed work_root (no real .csproj) and work_root_csproj (with all real .csproj files).
git -C "$work_root" init --quiet
git -C "$work_root" config user.email ci-classification@example.invalid
git -C "$work_root" config user.name "CI Classification Test"
git -C "$work_root" commit --quiet --allow-empty -m baseline
base_sha="$(git -C "$work_root" rev-parse HEAD)"
allowlisted_paths=(
  "docs/runbooks/example.md"
  "README.md"
  "AGENTS.md"
  "CLAUDE.md"
  "CHANGELOG.md"
  "THIRD-PARTY-NOTICES.md"
  ".agents/skills/pr-lifecycle/SKILL.md"
  ".devcontainer/devcontainer.json"
  ".vscode/settings.json"
  ".github/copilot-instructions.md"
  ".github/pull_request_template.md"
  ".github/prompts/example.md"
  "src/Example/README.md"
  "tests/Example.Tests/README.md"
  "tests/fixtures/catalog/SOURCE.md"
  "tests/fixtures/stellarium/SIMBAD_ENDPOINTS.md"
  "tools/asi-capture/README.md"
  "scripts/test:devcontainer"
)
for path in "${allowlisted_paths[@]}"; do
  mkdir -p "$work_root/$(dirname "$path")"
  printf 'allowlisted fixture\n' > "$work_root/$path"
done
git -C "$work_root" add --all
git -C "$work_root" commit --quiet -m "Add allowlisted paths"
head_sha="$(git -C "$work_root" rev-parse HEAD)"

work_root_csproj="$work_root.csproj-seed"
cp -a "$work_root" "$work_root_csproj"
while IFS= read -r linked_csproj; do
  mkdir -p "$work_root_csproj/$(dirname "$linked_csproj")"
  cp "$repo_root/$linked_csproj" "$work_root_csproj/$linked_csproj"
done < <(cd "$repo_root" && git ls-files 'src/*/*.csproj' 'tests/*/*.csproj' 'tools/*/*.csproj')
git -C "$work_root_csproj" add --all
git -C "$work_root_csproj" commit --quiet -m "Add real project files for link classification"

# Precompute real repository project links and directories once.
mapfile -t link_records < <(cd "$repo_root" && git ls-files '*/*/*.csproj' | while IFS= read -r csproj; do
  csproj_top="${csproj%%/*}"
  including="$(basename "$(dirname "$csproj")")"
  { grep -oE 'Include="(\.\.[\\/])+[^"]+"' "$csproj" 2>/dev/null || true; } | while IFS= read -r include; do
    include="${include#Include=\"}"
    include="${include%\"}"
    include="${include//\\//}"
    if [[ "$include" == ../../* ]]; then
      printf '%s|%s\n' "$including" "${include#../../}"
    elif [[ "$include" == ../* ]]; then
      printf '%s|%s/%s\n' "$including" "$csproj_top" "${include#../}"
    fi
  done
done | sort -u)

if (( ${#link_records[@]} == 0 )); then
  printf 'No linked source was discovered; the link ownership cross-check is not exercising anything.\n' >&2
  exit 1
fi

declare -A csproj_dir_by_project=()
declare -A csproj_count_by_project=()
while IFS= read -r csproj; do
  pname="$(basename "$(dirname "$csproj")")"
  csproj_dir_by_project["$pname"]="$(dirname "$csproj")"
  csproj_count_by_project["$pname"]="$(( ${csproj_count_by_project[$pname]:-0} + 1 ))"
done < <(cd "$repo_root" && git ls-files '*/*/*.csproj')

mapfile -t repo_project_directories < <(cd "$repo_root" && git ls-files 'src/*/*.csproj' 'tests/*/*.csproj' 'tools/*/*.csproj' \
  | while IFS= read -r project; do dirname "$project"; done | sort -u)

# Precompute sequential A/M diff status for every link probe so sharded link
# workers preserve exact M-status parity with the sequential baseline regardless
# of max_jobs and assert exact diff status on every probe commit.
declare -a link_expected_wildcard_status=()
declare -a link_expected_owner_status=()
declare -a link_expected_linked_status=()
declare -A link_seen_paths=()
for path in \
  "${allowlisted_paths[@]}" \
  "deploy/split-host/camera-modules/allsky01.virtual-asi676mc.full.json" \
  "tests/fixtures/catalog/hyg-v42-bright-stars.sqlite" \
  "tests/fixtures/catalog/SHA256SUMS-v44-openngc" \
  "tests/fixtures/catalog/hyg-v44-openngc-subset.sqlite" \
  "src/HVO.SkyMonitor.Deployment.Cli/ReleaseManifest.cs" \
  "tests/HVO.SkyMonitor.CameraAgent.IntegrationTests/VirtualSkyPipelineTests.cs"; do
  link_seen_paths["$path"]=1
done
for ((i = 0; i < ${#link_records[@]}; i++)); do
  link_expected_wildcard_status+=("")
  link_expected_owner_status+=("")
  link_expected_linked_status+=("")
  link_record="${link_records[$i]}"
  including_project="${link_record%%|*}"
  linked_source="${link_record#*|}"
  [[ -n "$including_project" && -n "$linked_source" ]] || continue
  [[ "$linked_source" != *.csproj ]] || continue
  if [[ "$linked_source" == *'*'* || "$linked_source" == *'?'* ]]; then
    probe_path="$(dirname "$linked_source")/WildcardProbe.cs"
    if [[ -n "${link_seen_paths[$probe_path]+x}" ]]; then
      link_expected_wildcard_status[i]="M"
    else
      link_expected_wildcard_status[i]="A"
      link_seen_paths["$probe_path"]=1
    fi
  else
    if (( ${csproj_count_by_project[$including_project]:-0} == 1 )); then
      owner_probe="${csproj_dir_by_project[$including_project]}/LinkOwnerProbe.cs"
      if [[ -n "${link_seen_paths[$owner_probe]+x}" ]]; then
        link_expected_owner_status[i]="M"
      else
        link_expected_owner_status[i]="A"
        link_seen_paths["$owner_probe"]=1
      fi
    fi
    if [[ -n "${link_seen_paths[$linked_source]+x}" ]]; then
      link_expected_linked_status[i]="M"
    else
      link_expected_linked_status[i]="A"
      link_seen_paths["$linked_source"]=1
    fi
  fi
done

# ==============================================================================
# Fast-path test group functions (isolated per-group repos)
# ==============================================================================

fast_expect_in() {
  local repo="$1" expected="$2" event="$3" base="$4" head="$5" scope="${6:-}" output
  output="$(cd "$repo" && "$classifier" "$event" "$base" "$head" "$scope")"
  grep -Fxq "docs_fast_path=$expected" <<< "$output" || { printf 'Fast path expected %s: %s\n' "$expected" "$output" >&2; exit 1; }
  grep -q '^docs_fast_path_reason=.' <<< "$output"
  ((fast_cases += 1))
}

fast_reason_in() {
  local repo="$1" reason="$2" base="$3" head="$4" result
  result="$(cd "$repo" && "$classifier" pull_request "$base" "$head" docs-fast-only)"
  grep -Fxq "docs_fast_path=false" <<< "$result"
  grep -Fxq "docs_fast_path_reason=$reason" <<< "$result" || { printf 'Expected reason %s: %s\n' "$reason" "$result" >&2; exit 1; }
  ((fast_cases += 1))
}

run_fast_group_1() {
  local repo="$fast_root.g1"
  cp -a "$fast_root" "$repo"
  local fast_cases=0 fast_path fast_head fast_expected excluded body initial mode_base mode_reason
  for fast_path in docs/runbooks/example.md docs/example.markdown docs/example.txt README.md AGENTS.md CLAUDE.md \
    docs/catalog/hyg-v44-license.md docs/validation/evidence/result.md docs/calibration/asi676/evidence/result.txt docs/images/asset.svg \
    CHANGELOG.md THIRD-PARTY-NOTICES.md .devcontainer/example.md .vscode/example.md \
    .github/prompts/example.md scripts/example.md src/Example/README.md docs/data.json; do
    git -C "$repo" reset -q --hard "$fast_base"
    mkdir -p "$repo/$(dirname "$fast_path")"
    printf 'text\n' > "$repo/$fast_path"
    git -C "$repo" add -- "$fast_path"
    git -C "$repo" commit -qm fixture
    fast_head="$(git -C "$repo" rev-parse HEAD)"
    case "$fast_path" in docs/runbooks/example.md | docs/example.markdown | docs/example.txt | README.md | AGENTS.md | CLAUDE.md) fast_expected=true ;; *) fast_expected=false ;; esac
    fast_expect_in "$repo" "$fast_expected" pull_request "$fast_base" "$fast_head"
  done
  fast_expect_in "$repo" true pull_request "$modified_base" "$modified_head"
  mkdir -p "$repo/.git/fast-bin"
  cat > "$repo/.git/fast-bin/git" <<'EOF'
#!/usr/bin/env bash
if [[ "$1" == show ]]; then exit 2; fi
exec "$FAST_REAL_GIT" "$@"
EOF
  chmod +x "$repo/.git/fast-bin/git"
  PATH="$repo/.git/fast-bin:$PATH" FAST_REAL_GIT="$fast_real_git" fast_expect_in "$repo" false pull_request "$modified_base" "$modified_head"
  git -C "$repo" reset -q --hard "$fast_base"
  printf 'changed\n' >> "$repo/docs/contracts/linked.md"
  git -C "$repo" commit -qam linked
  fast_expect_in "$repo" false pull_request "$fast_base" "$(git -C "$repo" rev-parse HEAD)"
  git -C "$repo" reset -q --hard "$fast_base"
  printf 'binary\0content\n' > "$repo/docs/binary.md"
  git -C "$repo" add docs/binary.md
  git -C "$repo" commit -qm binary
  fast_expect_in "$repo" false pull_request "$fast_base" "$(git -C "$repo" rev-parse HEAD)"
  git -C "$repo" reset -q --hard "$fast_base"
  ln -s contracts/linked.md "$repo/docs/link.md"
  git -C "$repo" add docs/link.md
  git -C "$repo" commit -qm symlink
  fast_expect_in "$repo" false pull_request "$fast_base" "$(git -C "$repo" rev-parse HEAD)"
  git -C "$repo" reset -q --hard "$fast_base"
  git -C "$repo" rm -q docs/contracts/linked.md
  git -C "$repo" commit -qm deletion
  fast_expect_in "$repo" false pull_request "$fast_base" "$(git -C "$repo" rev-parse HEAD)"
  git -C "$repo" reset -q --hard "$fast_base"
  mkdir -p "$repo/docs/runbooks" "$repo/src"
  printf 'text\n' > "$repo/docs/runbooks/safe.md"
  printf 'code\n' > "$repo/src/code.cs"
  git -C "$repo" add .
  git -C "$repo" commit -qm mixed
  fast_expect_in "$repo" false pull_request "$fast_base" "$(git -C "$repo" rev-parse HEAD)"
  git -C "$repo" reset -q --hard "$fast_base"
  git -C "$repo" mv docs/contracts/linked.md docs/contracts/renamed.md
  git -C "$repo" commit -qm rename
  fast_expect_in "$repo" false pull_request "$fast_base" "$(git -C "$repo" rev-parse HEAD)"
  fast_expect_in "$repo" false pull_request "$fast_base" "$fast_base"
  fast_expect_in "$repo" false pull_request missing "$fast_base"
  fast_expect_in "$repo" false push "$fast_base" "$fast_base"
  fast_expect_in "$repo" false merge_group "$fast_base" "$fast_base"
  for excluded in docs/upgrade-notes/0.9.1.md docs/generated/report.txt docs/evidence/report.txt docs/other/generated/report.txt docs/runbooks/development-v1-merge-queue-drill/verification.txt docs/runbooks/cameraagent-silo-runtime.md docs/UPPER.MD; do
    git -C "$repo" reset -q --hard "$fast_base"
    mkdir -p "$repo/$(dirname "$excluded")"
    printf 'text\n' > "$repo/$excluded"
    git -C "$repo" add "$excluded" && git -C "$repo" commit -qm excluded
    fast_reason_in "$repo" 'path outside documentation allowlist' "$fast_base" "$(git -C "$repo" rev-parse HEAD)"
  done
  for body in 'bad\377' 'bad\001' 'bad\177' 'bad\302\200'; do
    git -C "$repo" reset -q --hard "$fast_base"
    printf '%b' "$body" > "$repo/docs/invalid.md"
    git -C "$repo" add docs/invalid.md && git -C "$repo" commit -qm invalid
    fast_reason_in "$repo" 'documentation is binary or unreadable' "$fast_base" "$(git -C "$repo" rev-parse HEAD)"
  done
  for initial in 644 755; do
    git -C "$repo" reset -q --hard "$fast_base"
    printf 'text\n' > "$repo/docs/mode.md"
    chmod "$initial" "$repo/docs/mode.md"
    git -C "$repo" add docs/mode.md && git -C "$repo" commit -qm mode-base
    mode_base="$(git -C "$repo" rev-parse HEAD)"
    if [[ "$initial" == 644 ]]; then chmod 755 "$repo/docs/mode.md"; else chmod 644 "$repo/docs/mode.md"; fi
    git -C "$repo" add docs/mode.md && git -C "$repo" commit -qm mode-change
    if [[ "$initial" == 644 ]]; then mode_reason='non-regular or missing path in exact diff'; else mode_reason='non-regular or executable base path'; fi
    fast_reason_in "$repo" "$mode_reason" "$mode_base" "$(git -C "$repo" rev-parse HEAD)"
  done
  git -C "$repo" reset -q --hard "$fast_base"
  printf 'text\n' > "$repo/docs/executable.md"; chmod 755 "$repo/docs/executable.md"
  git -C "$repo" add docs/executable.md && git -C "$repo" commit -qm executable
  fast_reason_in "$repo" 'non-regular or missing path in exact diff' "$fast_base" "$(git -C "$repo" rev-parse HEAD)"
  printf '%d\n' "$fast_cases" > "$parallel_dir/fast_cases.g1"
}

run_fast_group_2() {
  local repo="$fast_root.g2"
  cp -a "$fast_root" "$repo"
  local fast_cases=0 link link_base runbook_rel case_base audit_case item audit_base package_item package_base sdk_base sdk_form imported_sdk_base
  # Link forms may appear in project files or imported targets, on the base tree.
  for link in "<None Include='../../../docs/runbooks/example.md' />" "<None Include = '../../docs/runbooks/example.md' />" '<None Include="../../docs/runbooks/*.md" />' '<None Include="../../**/*" />' '<Import Project="missing.items" />' '<None Include="@(UnknownItems)" />' '<ProjectReference Include="missing.proj" />' '<None Include="../../docs/runbooks/?.md" />' '<None Include="../../&#100;ocs/runbooks/example.md" />' '<None Include="../../%64ocs/runbooks/example.md" />' '<None Include="../../THIRD-PARTY-NOTICES.md;../../README.md" />' '<None Include="$(MSBuildThisFileDirectory)docs/runbooks/example.md" />' '<None Include="..\\..\\docs\\runbooks\\example.md" />'; do
    git -C "$repo" reset -q --hard "$fast_base"
    mkdir -p "$repo/docs/runbooks"
    printf 'text\n' > "$repo/docs/runbooks/example.md"
    printf '%s\n' "$link" > "$repo/Directory.Build.targets"
    printf '%s\n' "$link" > "$repo/items.xml"
    git -C "$repo" add . && git -C "$repo" commit -qm link-base
    link_base="$(git -C "$repo" rev-parse HEAD)"
    printf 'change\n' >> "$repo/docs/runbooks/example.md"
    git -C "$repo" commit -qam link-change
    fast_reason_in "$repo" 'project inventory unavailable' "$link_base" "$(git -C "$repo" rev-parse HEAD)"
  done
  # Case-sensitive negative control for the Silo replacement runbook exemption (#2071).
  for runbook_rel in \
    "docs/runbooks/cameraagent-silo-runtime.md" \
    "docs/runbooks/CameraAgent-Silo-Runtime.md" \
    "DOCS/runbooks/cameraagent-silo-runtime.md"; do
    git -C "$repo" reset -q --hard "$fast_base"
    mkdir -p "$repo/$(dirname "$runbook_rel")"
    printf '# Silo runtime\n' > "$repo/$runbook_rel"
    printf '<Project><ItemGroup><None Include="../../%s" Link="Shared/silo.md" /></ItemGroup></Project>\n' "$runbook_rel" > "$repo/tests/Example/Example.csproj"
    git -C "$repo" add . && git -C "$repo" commit -qm "runbook case $runbook_rel"
    case_base="$(git -C "$repo" rev-parse HEAD)"
    if [[ "$runbook_rel" == "docs/runbooks/cameraagent-silo-runtime.md" ]]; then
      (cd "$repo" && "$classifier" --print-docs-inventory "$case_base") > "$repo/.git/runbook-inventory"
      ((fast_cases += 1))
    else
      if (cd "$repo" && "$classifier" --print-docs-inventory "$case_base") > "$repo/.git/runbook-inventory" 2> "$repo/.git/runbook-error"; then
        printf 'Case-variant runbook %s was erroneously exempted by docs inventory audit.\n' "$runbook_rel" >&2
        exit 1
      fi
      grep -Fxq 'docs inventory audit: build input references eligible documentation' "$repo/.git/runbook-error" || {
        printf 'Unexpected audit error for %s: %s\n' "$runbook_rel" "$(cat "$repo/.git/runbook-error")" >&2
        exit 1
      }
      printf 'updated\n' >> "$repo/$runbook_rel"
      git -C "$repo" commit -qam "edit case-variant $runbook_rel"
      if [[ "$runbook_rel" == "docs/runbooks/CameraAgent-Silo-Runtime.md" ]]; then
        fast_reason_in "$repo" 'project inventory unavailable' "$case_base" "$(git -C "$repo" rev-parse HEAD)"
      else
        fast_reason_in "$repo" 'path outside documentation allowlist' "$case_base" "$(git -C "$repo" rev-parse HEAD)"
      fi
    fi
  done
  # Relative imported items use the consuming project directory in MSBuild.
  for audit_case in direct_partial direct_padded direct_semicolon imported_partial imported_glob imported_root; do
    git -C "$repo" reset -q --hard "$fast_base"
    mkdir -p "$repo/docs/runbooks" "$repo/tests/fixtures/shared"
    printf 'safe\n' > "$repo/docs/runbooks/releases.md"
    case "$audit_case" in
      direct_partial)
        printf '<Project><ItemGroup><None Include="../../d*/runbooks/releases.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup></Project>\n' > "$repo/tests/Example/Example.csproj" ;;
      direct_padded)
        printf '<Project><ItemGroup><None Include="  ../../d*/runbooks/releases.md  " CopyToOutputDirectory="PreserveNewest" /></ItemGroup></Project>\n' > "$repo/tests/Example/Example.csproj" ;;
      direct_semicolon)
        printf '<Project><ItemGroup><None Include=" harmless.txt ;  ../../d*/runbooks/releases.md  " CopyToOutputDirectory="PreserveNewest" /></ItemGroup></Project>\n' > "$repo/tests/Example/Example.csproj" ;;
      *)
        printf '<Project><Import Project="../fixtures/shared/markdown.props" /></Project>\n' > "$repo/tests/Example/Example.csproj"
        case "$audit_case" in
          imported_partial) item='../../d*/runbooks/releases.md' ;;
          imported_glob) item='../../**/*.md' ;;
          imported_root) item='../../README.md' ;;
        esac
        printf '<Project><ItemGroup><None Include="%s" CopyToOutputDirectory="PreserveNewest" /></ItemGroup></Project>\n' "$item" > "$repo/tests/fixtures/shared/markdown.props" ;;
    esac
    git -C "$repo" add . && git -C "$repo" commit -qm audit-case
    audit_base="$(git -C "$repo" rev-parse HEAD)"
    if (cd "$repo" && "$classifier" --print-docs-inventory "$audit_base") > "$repo/.git/unsafe-inventory" 2>/dev/null; then
      printf 'Unsafe %s was certified.\n' "$audit_case" >&2; exit 1
    fi
    if [[ "$audit_case" == imported_root ]]; then printf 'changed\n' > "$repo/README.md"; git -C "$repo" add README.md; else printf 'changed\n' >> "$repo/docs/runbooks/releases.md"; git -C "$repo" add docs/runbooks/releases.md; fi
    git -C "$repo" commit -qm doc-change
    fast_reason_in "$repo" 'project inventory unavailable' "$audit_base" "$(git -C "$repo" rev-parse HEAD)"
  done
  # Without a source-bound restore-import certificate, package identities are unknown.
  for package_item in '<PackageReference Include="Fixture" Version="1.0.0" />' '<PackageReference Include="Fixture" Version="1.0.0" ExcludeAssets="build;buildTransitive" />' '<GlobalPackageReference Include="Fixture" Version="1.0.0" />' '<PackageDownload Include="Fixture" Version="[1.0.0]" />'; do
    git -C "$repo" reset -q --hard "$fast_base"
    mkdir -p "$repo/docs/runbooks"
    printf 'safe\n' > "$repo/docs/runbooks/releases.md"
    printf '<Project><ItemGroup>%s</ItemGroup></Project>\n' "$package_item" > "$repo/tests/Example/Example.csproj"
    git -C "$repo" add . && git -C "$repo" commit -qm package-reference
    package_base="$(git -C "$repo" rev-parse HEAD)"
    if (cd "$repo" && "$classifier" --print-docs-inventory "$package_base") > "$repo/.git/unsafe-inventory" 2> "$repo/.git/package-error"; then
      printf 'Uncertified package input was accepted.\n' >&2; exit 1
    fi
    grep -Fxq 'docs inventory audit: restore generated package imports are uncertified' "$repo/.git/package-error"
    printf 'changed\n' >> "$repo/docs/runbooks/releases.md"
    git -C "$repo" commit -qam doc-change
    fast_reason_in "$repo" 'project inventory unavailable' "$package_base" "$(git -C "$repo" rev-parse HEAD)"
  done
  # An SDK can introduce restore-time imports even without an explicit package.
  git -C "$repo" reset -q --hard "$fast_base"
  mkdir -p "$repo/docs/runbooks"
  printf 'safe\n' > "$repo/docs/runbooks/releases.md"
  printf '<Project Sdk="Microsoft.NET.Sdk" />\n' > "$repo/tests/Example/Example.csproj"
  git -C "$repo" add . && git -C "$repo" commit -qm sdk-reference
  sdk_base="$(git -C "$repo" rev-parse HEAD)"
  if (cd "$repo" && "$classifier" --print-docs-inventory "$sdk_base") > "$repo/.git/unsafe-inventory" 2> "$repo/.git/sdk-error"; then
    printf 'Uncertified SDK imports were accepted.\n' >&2; exit 1
  fi
  grep -Fxq 'docs inventory audit: SDK generated restore imports are uncertified' "$repo/.git/sdk-error"
  printf 'changed\n' >> "$repo/docs/runbooks/releases.md"
  git -C "$repo" commit -qam doc-change
  fast_reason_in "$repo" 'project inventory unavailable' "$sdk_base" "$(git -C "$repo" rev-parse HEAD)"
  # SDK declarations in an imported file can introduce restore-generated imports.
  for sdk_form in attribute element; do
    git -C "$repo" reset -q --hard "$fast_base"
    mkdir -p "$repo/docs/runbooks"
    printf 'safe\n' > "$repo/docs/runbooks/releases.md"
    printf '<Project><Import Project="shared.props" /></Project>\n' > "$repo/tests/Example/Example.csproj"
    if [[ "$sdk_form" == attribute ]]; then
      printf '<Project Sdk="Microsoft.NET.Sdk" />\n' > "$repo/tests/Example/shared.props"
    else
      printf '<Project><Sdk Name="Microsoft.NET.Sdk" /></Project>\n' > "$repo/tests/Example/shared.props"
    fi
    git -C "$repo" add . && git -C "$repo" commit -qm imported-sdk
    imported_sdk_base="$(git -C "$repo" rev-parse HEAD)"
    if (cd "$repo" && "$classifier" --print-docs-inventory "$imported_sdk_base") > "$repo/.git/unsafe-inventory" 2> "$repo/.git/imported-sdk-error"; then
      printf 'Imported SDK %s was certified.\n' "$sdk_form" >&2; exit 1
    fi
    grep -Fxq 'docs inventory audit: SDK generated restore imports are uncertified' "$repo/.git/imported-sdk-error"
    printf 'changed\n' >> "$repo/docs/runbooks/releases.md"
    git -C "$repo" commit -qam doc-change
    fast_reason_in "$repo" 'project inventory unavailable' "$imported_sdk_base" "$(git -C "$repo" rev-parse HEAD)"
  done
  printf '%d\n' "$fast_cases" > "$parallel_dir/fast_cases.g2"
}

certificate_cases=(
  builtin-sdk web-sdk solution-folder-project slnx-folder-strasse-pair external-sdk versioned-sdk multiple-sdks
  sdk-element nested-sdk props-sdk explicit-sdk-import global-package package-download lowercase-package
  executable-certificate symlink-certificate stale-source-hash mismatched-sdk-version missing-global-json
  global-json-sdk-paths global-json-extra-top-key global-json-utf16 missing-project-record extra-project-record
  missing-coverage-project-record nested-solution-project nested-solution-folder
  slnx-folder-no-slashes slnx-folder-dup-case slnx-folder-dotdot
  slnx-folder-reserved-con slnx-folder-reserved-con-ext slnx-folder-reserved-lpt1
  slnx-folder-reserved-clock slnx-folder-del-char slnx-folder-c1-control
  slnx-{folder,project}-{tab,cr,lf,escaped-tab,escaped-cr,escaped-lf}
  slnx-{folder,project}-xmlns-{tab,cr,lf}
  slnx-doctype slnx-doctype-entity
  slnx-attribute-formatting
)

run_fast_cert_shard() {
  local shard_id="$1"
  shift
  local repo="$fast_root.cert.$shard_id"
  cp -a "$cert_seed_root" "$repo"
  python3 - "$repo" "$classifier" "$cert_seed_base" "$parallel_dir/fast_cases.cert.$shard_id" "$@" <<'PY_CERT'
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys

repo = pathlib.Path(sys.argv[1])
classifier = sys.argv[2]
seed_base = sys.argv[3]
count_file = pathlib.Path(sys.argv[4])
cases = sys.argv[5:]

SECOND_CSPROJ = '<Project Sdk="Microsoft.NET.Sdk" />\n'
SLNX_WHITESPACE = {
    "tab": "\t", "cr": "\r", "lf": "\n",
    "escaped-tab": "&#9;", "escaped-cr": "&#xD;", "escaped-lf": "&#10;",
}
SLNX_WHITESPACE_CASES = {
    f"slnx-{entry}-{kind}": (entry, whitespace)
    for entry in ("folder", "project")
    for kind, whitespace in SLNX_WHITESPACE.items()
} | {
    f"slnx-{entry}-xmlns-{kind}": (entry, SLNX_WHITESPACE[kind])
    for entry in ("folder", "project")
    for kind in ("tab", "cr", "lf")
}
SLNX_DECLARATION_CASES = {
    "slnx-doctype": ("<!DOCTYPE Solution>", "tests/Example/Example.csproj"),
    "slnx-doctype-entity": (
        '<!DOCTYPE Solution [<!ENTITY project "tests/Example/Example.csproj">]>', "&project;",
    ),
}
SECOND_PROJECT_CASES = frozenset({
    "solution-folder-project", "slnx-folder-strasse-pair", "missing-project-record",
    "nested-solution-project", "nested-solution-folder",
    "slnx-folder-no-slashes", "slnx-folder-dup-case", "slnx-folder-dotdot",
    "slnx-folder-reserved-con", "slnx-folder-reserved-con-ext", "slnx-folder-reserved-lpt1",
    "slnx-folder-reserved-clock", "slnx-folder-del-char", "slnx-folder-c1-control",
    "slnx-attribute-formatting",
}) | SLNX_WHITESPACE_CASES.keys()
SECOND_RECORD_CASES = SECOND_PROJECT_CASES - {"missing-project-record"}
SLNX_INVALID_CASES = frozenset({
    "nested-solution-project", "nested-solution-folder",
    "slnx-folder-no-slashes", "slnx-folder-dup-case", "slnx-folder-dotdot",
    "slnx-folder-reserved-con", "slnx-folder-reserved-con-ext", "slnx-folder-reserved-lpt1",
    "slnx-folder-reserved-clock", "slnx-folder-del-char", "slnx-folder-c1-control",
})
SLNX_ERRORS = dict.fromkeys(SLNX_INVALID_CASES, "unknown solution entry") | {
    case: ("escaped build input requires manual review" if whitespace.startswith("&#")
           else "solution attribute contains control whitespace")
    for case, (_, whitespace) in SLNX_WHITESPACE_CASES.items()
} | dict.fromkeys(SLNX_DECLARATION_CASES, "document type declarations require manual review")
DIRECT_CHECK_CASES = SLNX_ERRORS.keys() | {
    "global-json-sdk-paths", "global-json-extra-top-key", "global-json-utf16",
}
DIGEST_ZERO = "0" * 64


def require(condition, message):
    if not condition:
        raise SystemExit(message)


def git(*args, binary=False):
    res = subprocess.run(
        ["git", "-C", str(repo), *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=True,
    )
    return res.stdout if binary else res.stdout.decode("utf-8").strip()


fast_cases = 0
for case in cases:
    git("reset", "-q", "--hard", seed_base)
    for extra in (repo / "tests/Second", repo / "scripts/coverage"):
        if extra.exists():
            shutil.rmtree(extra)
    for extra_file in (repo / "scripts/fixture-certificate.json", repo / "scripts/ci:restore-import-certificate.json"):
        if extra_file.exists() or extra_file.is_symlink():
            extra_file.unlink()

    if case == "missing-global-json":
        (repo / "global.json").unlink()

    project = '<Project Sdk="Microsoft.NET.Sdk"><Import Project="shared.props" /></Project>'
    props = '<Project><ItemGroup><PackageReference Include="Fixture" Version="1.0.0" /></ItemGroup></Project>'
    expected = "false"
    second_project = "tests/Second/Second.csproj"

    if case == "builtin-sdk":
        expected = "verify-restore"
    elif case == "web-sdk":
        project = '<Project Sdk="Microsoft.NET.Sdk.Web" />'
        expected = "verify-restore"
    elif case == "solution-folder-project":
        (repo / "tests/Second").mkdir(parents=True, exist_ok=True)
        (repo / "tests/Second/Second.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution><Project Path="tests/Example/Example.csproj" /><Folder Name="/Tests/"><Project Path="tests/Second/Second.csproj" /></Folder></Solution>\n',
            encoding="utf-8",
        )
        expected = "verify-restore"
    elif case == "external-sdk":
        project = '<Project Sdk="MSTest.Sdk" />'
    elif case == "versioned-sdk":
        project = '<Project Sdk="Microsoft.NET.Sdk/10.0.0" />'
    elif case == "multiple-sdks":
        project = '<Project Sdk="A;B" />'
    elif case == "sdk-element":
        project = '<Project><Sdk Name="Microsoft.NET.Sdk" /></Project>'
    elif case == "nested-sdk":
        project = '<Project><Project Sdk="Microsoft.NET.Sdk" /></Project>'
    elif case == "props-sdk":
        props = '<Project Sdk="Microsoft.NET.Sdk" />'
    elif case == "explicit-sdk-import":
        project = '<Project><Import Project="shared.props" Sdk="Microsoft.NET.Sdk" /></Project>'
    elif case == "global-package":
        project = '<Project><ItemGroup><GlobalPackageReference Include="Fixture" Version="1.0.0" /></ItemGroup></Project>'
    elif case == "package-download":
        project = '<Project><ItemGroup><PackageDownload Include="Fixture" Version="[1.0.0]" /></ItemGroup></Project>'
    elif case == "lowercase-package":
        project = '<Project><ItemGroup><packagereference Include="Fixture" Version="1.0.0" /></ItemGroup></Project>'
    elif case == "global-json-sdk-paths":
        (repo / "global.json").write_text(
            '{"sdk":{"version":"10.0.402","rollForward":"disable","allowPrerelease":false,"paths":["./missing-sdk"]}}\n',
            encoding="utf-8",
        )
    elif case == "global-json-extra-top-key":
        (repo / "global.json").write_text(
            '{"sdk":{"version":"10.0.402","rollForward":"disable","allowPrerelease":false},"msbuild-sdks":{"Custom.Sdk":"1.0.0"}}\n',
            encoding="utf-8",
        )
    elif case == "global-json-utf16":
        (repo / "global.json").write_bytes(
            '{"sdk":{"version":"10.0.402","rollForward":"disable","allowPrerelease":false}}\n'.encode("utf-16")
        )
    elif case == "missing-project-record":
        (repo / "tests/Second").mkdir(parents=True, exist_ok=True)
        (repo / "tests/Second/Second.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution><Project Path="tests/Example/Example.csproj" /><Project Path="tests/Second/Second.csproj" /></Solution>\n',
            encoding="utf-8",
        )
    elif case == "nested-solution-project":
        (repo / "tests/Second").mkdir(parents=True, exist_ok=True)
        (repo / "tests/Second/Second.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution><Project Path="tests/Example/Example.csproj"><Project Path="tests/Second/Second.csproj" /></Project></Solution>\n',
            encoding="utf-8",
        )
    elif case == "nested-solution-folder":
        (repo / "tests/Second").mkdir(parents=True, exist_ok=True)
        (repo / "tests/Second/Second.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution><Project Path="tests/Example/Example.csproj" /><Folder Name="/Outer/"><Folder Name="/Inner/"><Project Path="tests/Second/Second.csproj" /></Folder></Folder></Solution>\n',
            encoding="utf-8",
        )
    elif case == "slnx-folder-no-slashes":
        (repo / "tests/Second").mkdir(parents=True, exist_ok=True)
        (repo / "tests/Second/Second.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution><Project Path="tests/Example/Example.csproj" /><Folder Name="Tests"><Project Path="tests/Second/Second.csproj" /></Folder></Solution>\n',
            encoding="utf-8",
        )
    elif case == "slnx-folder-dup-case":
        (repo / "tests/Second").mkdir(parents=True, exist_ok=True)
        (repo / "tests/Second/Second.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution><Folder Name="/Tests/"><Project Path="tests/Example/Example.csproj" /></Folder><Folder Name="/tests/"><Project Path="tests/Second/Second.csproj" /></Folder></Solution>\n',
            encoding="utf-8",
        )
    elif case == "slnx-folder-strasse-pair":
        (repo / "tests/Second").mkdir(parents=True, exist_ok=True)
        (repo / "tests/Second/Second.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution><Folder Name="/Stra\u00dfe/"><Project Path="tests/Example/Example.csproj" /></Folder><Folder Name="/STRASSE/"><Project Path="tests/Second/Second.csproj" /></Folder></Solution>\n',
            encoding="utf-8",
        )
        expected = "verify-restore"
    elif case == "slnx-folder-dotdot":
        (repo / "tests/Second").mkdir(parents=True, exist_ok=True)
        (repo / "tests/Second/Second.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution><Project Path="tests/Example/Example.csproj" /><Folder Name="/Tests/../"><Project Path="tests/Second/Second.csproj" /></Folder></Solution>\n',
            encoding="utf-8",
        )
    elif case == "slnx-folder-reserved-con":
        (repo / "tests/Second").mkdir(parents=True, exist_ok=True)
        (repo / "tests/Second/Second.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution><Project Path="tests/Example/Example.csproj" /><Folder Name="/CON/"><Project Path="tests/Second/Second.csproj" /></Folder></Solution>\n',
            encoding="utf-8",
        )
    elif case == "slnx-folder-reserved-con-ext":
        (repo / "tests/Second").mkdir(parents=True, exist_ok=True)
        (repo / "tests/Second/Second.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution><Project Path="tests/Example/Example.csproj" /><Folder Name="/con.txt/"><Project Path="tests/Second/Second.csproj" /></Folder></Solution>\n',
            encoding="utf-8",
        )
    elif case == "slnx-folder-reserved-lpt1":
        (repo / "tests/Second").mkdir(parents=True, exist_ok=True)
        (repo / "tests/Second/Second.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution><Project Path="tests/Example/Example.csproj" /><Folder Name="/Sub/LPT1.log/"><Project Path="tests/Second/Second.csproj" /></Folder></Solution>\n',
            encoding="utf-8",
        )
    elif case == "slnx-folder-reserved-clock":
        (repo / "tests/Second").mkdir(parents=True, exist_ok=True)
        (repo / "tests/Second/Second.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution><Project Path="tests/Example/Example.csproj" /><Folder Name="/CLOCK$/"><Project Path="tests/Second/Second.csproj" /></Folder></Solution>\n',
            encoding="utf-8",
        )
    elif case == "slnx-folder-del-char":
        (repo / "tests/Second").mkdir(parents=True, exist_ok=True)
        (repo / "tests/Second/Second.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution><Project Path="tests/Example/Example.csproj" /><Folder Name="/A\x7fB/"><Project Path="tests/Second/Second.csproj" /></Folder></Solution>\n',
            encoding="utf-8",
        )
    elif case == "slnx-folder-c1-control":
        (repo / "tests/Second").mkdir(parents=True, exist_ok=True)
        (repo / "tests/Second/Second.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution><Project Path="tests/Example/Example.csproj" /><Folder Name="/A\x80B/"><Project Path="tests/Second/Second.csproj" /></Folder></Solution>\n',
            encoding="utf-8",
        )
    elif case in SLNX_WHITESPACE_CASES or case == "slnx-attribute-formatting":
        entry, whitespace = SLNX_WHITESPACE_CASES.get(case, ("formatting", " "))
        folder_name = f"/Second{whitespace}Group/" if entry == "folder" else "/Second Group/"
        namespace = 'xmlns:x="urn:x" '
        folder_namespace = namespace if "-xmlns-" in case and entry == "folder" else ""
        project_namespace = namespace if "-xmlns-" in case and entry == "project" else ""
        if case == "slnx-attribute-formatting":
            folder_namespace = namespace + "\r\n\t\t"
            project_namespace = "xmlns=''\n\t\t\t"
            expected = "verify-restore"
        # Commit the space-normalized alias so accepting it would certify a different project.
        second_project = "tests/Second/Second Project.csproj"
        project_path = second_project.replace(" ", whitespace) if entry == "project" else second_project
        (repo / second_project).parent.mkdir(parents=True, exist_ok=True)
        (repo / second_project).write_text(SECOND_CSPROJ, encoding="utf-8")
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            '<Solution>\r\n'
            '\t<!-- <Folder Name="/Ignored\tName/" /> -->\n'
            '\t<?probe <Project Path="ignored\rpath.csproj" /> ?>\n'
            '\t<![CDATA[<Folder Name="/Ignored\nName/" />]]>\n'
            '\t<Project Path="tests/Example/Example.csproj" />\n'
            f'\t<Folder\n\t\t{folder_namespace}Name = "{folder_name}">\n'
            f"\t\t<Project\t{project_namespace}Path\r\n\t\t\t=\t'{project_path}' />\n"
            '\t</Folder>\n'
            '</Solution>\n',
            encoding="utf-8",
        )
    elif case in SLNX_DECLARATION_CASES:
        declaration, project_path = SLNX_DECLARATION_CASES[case]
        (repo / "HVO.SkyMonitor.v9.slnx").write_text(
            f'{declaration}\n<Solution><Project Path="{project_path}" /></Solution>\n',
            encoding="utf-8",
        )
    elif case == "missing-coverage-project-record":
        (repo / "scripts/coverage").mkdir(parents=True, exist_ok=True)
        (repo / "scripts/coverage/HVO.SkyMonitor.CoverageGate.csproj").write_text(SECOND_CSPROJ, encoding="utf-8")

    (repo / "tests/Example/Example.csproj").write_text(project + "\n", encoding="utf-8")
    (repo / "tests/Example/shared.props").write_text(props + "\n", encoding="utf-8")
    (repo / "docs/runbooks/certified.md").write_text("original\n", encoding="utf-8")

    git("add", "-A")
    sources_tree = git("write-tree")
    inventory_paths = ["HVO.SkyMonitor.v9.slnx", "tests/Example"]
    if case != "missing-global-json":
        inventory_paths.append("global.json")
    if case in SECOND_PROJECT_CASES:
        inventory_paths.append("tests/Second")
    if case == "missing-coverage-project-record":
        inventory_paths.append("scripts/coverage/HVO.SkyMonitor.CoverageGate.csproj")

    raw_tree = git("ls-tree", "-rz", sources_tree, "--", *inventory_paths, binary=True)
    entries = [entry.split(b"\t", 1) for entry in raw_tree.split(b"\0") if entry]
    inventory_text = "".join(
        metadata.decode("ascii") + " " + repr(path) + "\n"
        for metadata, path in sorted(entries, key=lambda item: item[1])
    )
    inventory_bytes = inventory_text.encode("utf-8")
    (repo / "scripts/ci:docs-inventory").write_bytes(inventory_bytes)
    source_hash = hashlib.sha256(inventory_bytes).hexdigest()

    imports = {"sha256": DIGEST_ZERO, "imports": []}
    project_entry = {"graphSha256": DIGEST_ZERO, "sources": [], "props": imports, "targets": imports}
    projects = {"tests/Example/Example.csproj": project_entry}
    if case in SECOND_RECORD_CASES:
        projects[second_project] = project_entry
    if case == "extra-project-record":
        projects["tests/Extra/Extra.csproj"] = project_entry
    certificate = {
        "version": 1,
        "sourceSha256": DIGEST_ZERO if case == "stale-source-hash" else source_hash,
        "sdk": {
            "version": "10.0.401" if case == "mismatched-sdk-version" else "10.0.402",
            "platform": "linux-x64",
            "sha256": DIGEST_ZERO,
        },
        "packages": {},
        "projects": projects,
    }
    cert_rel = "scripts/ci:restore-import-certificate.json"
    (repo / cert_rel).write_text(json.dumps(certificate), encoding="utf-8")

    if case == "symlink-certificate":
        (repo / cert_rel).rename(repo / "scripts/fixture-certificate.json")
        os.symlink("fixture-certificate.json", repo / cert_rel)
        git("add", "scripts/fixture-certificate.json")
    git("add", "--", "scripts/ci:docs-inventory", cert_rel)
    if case == "executable-certificate":
        (repo / cert_rel).chmod(0o755)
        git("update-index", "--chmod=+x", "--", cert_rel)
    git("commit", "-qm", f"{case} certificate")
    cert_base = git("rev-parse", "HEAD")

    check = subprocess.run([classifier, "--check-docs-inventory", cert_base], cwd=repo, capture_output=True, text=True)
    if expected == "verify-restore":
        if check.returncode != 0 or check.stdout != "Documentation CI build inventory is current and audited.\n" or check.stderr != "":
            raise SystemExit(f"Mandatory docs certificate gate failed for {case}: rc={check.returncode} out={check.stdout!r} err={check.stderr!r}")
    else:
        if check.returncode == 0:
            raise SystemExit(f"Mandatory docs certificate gate accepted invalid case: {case}")
        err_lines = check.stderr.splitlines()
        if case == "mismatched-sdk-version":
            want = "::error::Documentation CI build inventory is stale or unsafe; refresh scripts/ci:docs-inventory and scripts/ci:restore-import-certificate.json: restore import certificate SDK version differs from global.json"
            require(want in err_lines, f"{case}: {check.stderr!r}")
        elif case == "missing-global-json":
            want = "::error::Documentation CI build inventory is stale or unsafe; refresh scripts/ci:docs-inventory and scripts/ci:restore-import-certificate.json: committed global.json SDK pin unavailable"
            require(want in err_lines, f"{case}: {check.stderr!r}")
        elif case in ("global-json-sdk-paths", "global-json-extra-top-key"):
            want = "::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: unknown SDK resolver configuration"
            require(want in err_lines, f"{case}: {check.stderr!r}")
        elif case == "global-json-utf16":
            want = "::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: global.json is not UTF-8"
            require(want in err_lines, f"{case}: {check.stderr!r}")
        elif case in ("missing-project-record", "extra-project-record", "missing-coverage-project-record"):
            want = "::error::Documentation CI build inventory is stale or unsafe; refresh scripts/ci:docs-inventory and scripts/ci:restore-import-certificate.json: restore import certificate project set differs from committed solution"
            require(want in err_lines, f"{case}: {check.stderr!r}")
        elif case in SLNX_ERRORS:
            want = "::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: " + SLNX_ERRORS[case]
            require(want in err_lines, f"{case}: {check.stderr!r}")
        elif case in ("executable-certificate", "symlink-certificate", "stale-source-hash"):
            want = "::error::Documentation CI build inventory is stale or unsafe; refresh scripts/ci:docs-inventory and scripts/ci:restore-import-certificate.json:"
            require(want in check.stderr, f"{case}: {check.stderr!r}")
        else:
            want = "::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review:"
            require(want in check.stderr, f"{case}: {check.stderr!r}")

        if case in DIRECT_CHECK_CASES:
            direct = subprocess.run(
                ["python3", "-I", "scripts/ci/restore-imports.py", "check-source", cert_base, source_hash],
                cwd=repo, capture_output=True, text=True,
            )
            if direct.returncode == 0:
                raise SystemExit(f"validate_certificate accepted invalid case directly: {case}")
            direct_lines = direct.stderr.splitlines()
            if case in ("global-json-sdk-paths", "global-json-extra-top-key"):
                require("docs inventory audit: unknown SDK resolver configuration" in direct_lines, f"{case}: {direct.stderr!r}")
            elif case == "global-json-utf16":
                require("docs inventory audit: global.json is not UTF-8" in direct_lines, f"{case}: {direct.stderr!r}")
            else:
                require(f"docs inventory audit: {SLNX_ERRORS[case]}" in direct_lines, f"{case}: {direct.stderr!r}")

    with (repo / "docs/runbooks/certified.md").open("a", encoding="utf-8") as fh:
        fh.write("changed\n")
    git("commit", "-qam", "certified docs edit")
    if git("diff", "--name-only", cert_base, "HEAD") != "docs/runbooks/certified.md":
        raise SystemExit(f"Unexpected certified docs diff for {case}")

    fast_out = subprocess.run(
        [classifier, "pull_request", cert_base, "HEAD", "docs-fast-only"],
        cwd=repo, capture_output=True, text=True, check=True,
    ).stdout
    fast_lines = fast_out.splitlines()
    if f"docs_fast_path={expected}" not in fast_lines or not any(re.match(r"^docs_fast_path_reason=.", line) for line in fast_lines):
        raise SystemExit(f"Fast path expected {expected} for {case}: {fast_out}")
    fast_cases += 1

    if case in ("nested-sdk", "external-sdk"):
        mutant = subprocess.run(
            ["bash", f".git/classifier-{case}", "pull_request", cert_base, "HEAD", "docs-fast-only"],
            cwd=repo, capture_output=True, text=True, check=True,
        ).stdout
        if "docs_fast_path=verify-restore" not in mutant.splitlines():
            raise SystemExit(f"The {case} fixture did not distinguish its loosened guard.\n{mutant}")
        print(f"Killed certificate source audit mutation: {case}.")

count_file.write_text(f"{fast_cases}\n", encoding="utf-8")
PY_CERT
}

run_fast_group_3() {
  local repo="$fast_root.g3"
  cp -a "$fast_root" "$repo"
  local fast_cases=0 missing_cert_case expected_missing_cert_err missing_cert_base
  local legacy_global_case expected_legacy_global_err legacy_global_base
  local both_missing_case expected_both_missing_err both_missing_base
  local declared utf8_base encoding_decl_base encoding encoding_base encoding_reason
  local wildcard_base solution_base missing_base xml_base item_mode item_type item_sha item_path forged_base user_base
  # When the restore certificate is absent, only trees that pass restore-source auditing are refreshable.
  for missing_cert_case in package-download global-package unsupported-sdk global-json-sdk-paths global-json-utf16 valid-package valid-sdk valid-global-json; do
    git -C "$repo" reset -q --hard "$fast_base"
    case "$missing_cert_case" in
      package-download)
        printf '<Project Sdk="Microsoft.NET.Sdk"><ItemGroup><PackageDownload Include="Fixture" Version="[1.0.0]" /></ItemGroup></Project>\n' > "$repo/tests/Example/Example.csproj"
        expected_missing_cert_err='::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: restore generated package imports are uncertified'
        ;;
      global-package)
        printf '<Project Sdk="Microsoft.NET.Sdk"><ItemGroup><GlobalPackageReference Include="Fixture" Version="1.0.0" /></ItemGroup></Project>\n' > "$repo/tests/Example/Example.csproj"
        expected_missing_cert_err='::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: restore generated package imports are uncertified'
        ;;
      unsupported-sdk)
        printf '<Project Sdk="MSTest.Sdk" />\n' > "$repo/tests/Example/Example.csproj"
        expected_missing_cert_err='::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: SDK generated restore imports are uncertified'
        ;;
      global-json-sdk-paths)
        printf '<Project Sdk="Microsoft.NET.Sdk" />\n' > "$repo/tests/Example/Example.csproj"
        printf '{"sdk":{"version":"10.0.402","rollForward":"disable","allowPrerelease":false,"paths":["./missing-sdk"]}}\n' > "$repo/global.json"
        expected_missing_cert_err='::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: unknown SDK resolver configuration'
        ;;
      global-json-utf16)
        printf '<Project Sdk="Microsoft.NET.Sdk" />\n' > "$repo/tests/Example/Example.csproj"
        python3 -I -c 'import pathlib, sys; pathlib.Path(sys.argv[1]).write_bytes("{\"sdk\":{\"version\":\"10.0.402\",\"rollForward\":\"disable\",\"allowPrerelease\":false}}\n".encode("utf-16"))' "$repo/global.json"
        expected_missing_cert_err='::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: global.json is not UTF-8'
        ;;
      valid-package)
        printf '<Project Sdk="Microsoft.NET.Sdk"><ItemGroup><PackageReference Include="Fixture" Version="1.0.0" /></ItemGroup></Project>\n' > "$repo/tests/Example/Example.csproj"
        expected_missing_cert_err='::error::Documentation CI build inventory is stale or unsafe; refresh scripts/ci:docs-inventory and scripts/ci:restore-import-certificate.json: restore generated package imports are uncertified'
        ;;
      valid-sdk)
        printf '<Project Sdk="Microsoft.NET.Sdk" />\n' > "$repo/tests/Example/Example.csproj"
        expected_missing_cert_err='::error::Documentation CI build inventory is stale or unsafe; refresh scripts/ci:docs-inventory and scripts/ci:restore-import-certificate.json: SDK generated restore imports are uncertified'
        ;;
      valid-global-json)
        printf '<Project Sdk="Microsoft.NET.Sdk" />\n' > "$repo/tests/Example/Example.csproj"
        cp "$repo_root/global.json" "$repo/global.json"
        expected_missing_cert_err='::error::Documentation CI build inventory is stale or unsafe; refresh scripts/ci:docs-inventory and scripts/ci:restore-import-certificate.json: SDK generated restore imports are uncertified'
        ;;
    esac
    git -C "$repo" add . && git -C "$repo" commit -qm "missing-cert $missing_cert_case"
    missing_cert_base="$(git -C "$repo" rev-parse HEAD)"
    if (cd "$repo" && "$classifier" --check-docs-inventory "$missing_cert_base") > "$repo/.git/missing-cert-out" 2> "$repo/.git/missing-cert-err"; then
      printf 'Mandatory docs certificate gate accepted missing-cert case: %s\n' "$missing_cert_case" >&2
      exit 1
    fi
    grep -Fxq "$expected_missing_cert_err" "$repo/.git/missing-cert-err" || {
      printf 'Unexpected missing-cert diagnostic for %s:\n%s\n' "$missing_cert_case" "$(cat "$repo/.git/missing-cert-err")" >&2
      exit 1
    }
  done
  # Even with SDK-less projects and a matching legacy inventory, unsafe global.json must fail closed.
  for legacy_global_case in sdk-paths utf16; do
    git -C "$repo" reset -q --hard "$fast_base"
    mkdir -p "$repo/docs/runbooks"
    printf 'original\n' > "$repo/docs/runbooks/legacy-global.md"
    case "$legacy_global_case" in
      sdk-paths)
        printf '{"sdk":{"version":"10.0.402","rollForward":"disable","allowPrerelease":false,"paths":["./missing-sdk"]}}\n' > "$repo/global.json"
        expected_legacy_global_err='::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: unknown SDK resolver configuration'
        ;;
      utf16)
        python3 -I -c 'import pathlib, sys; pathlib.Path(sys.argv[1]).write_bytes("{\"sdk\":{\"version\":\"10.0.402\",\"rollForward\":\"disable\",\"allowPrerelease\":false}}\n".encode("utf-16"))' "$repo/global.json"
        expected_legacy_global_err='::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: global.json is not UTF-8'
        ;;
    esac
    git -C "$repo" add . && git -C "$repo" commit -qm "legacy-global $legacy_global_case"
    legacy_global_base="$(git -C "$repo" rev-parse HEAD)"
    if (cd "$repo" && "$classifier" --check-docs-inventory "$legacy_global_base") > "$repo/.git/legacy-global-out" 2> "$repo/.git/legacy-global-err"; then
      printf 'Legacy inventory gate accepted unsafe global.json case: %s\n' "$legacy_global_case" >&2
      exit 1
    fi
    grep -Fxq "$expected_legacy_global_err" "$repo/.git/legacy-global-err" || {
      printf 'Unexpected legacy-global diagnostic for %s:\n%s\n' "$legacy_global_case" "$(cat "$repo/.git/legacy-global-err")" >&2
      exit 1
    }
    printf 'changed\n' >> "$repo/docs/runbooks/legacy-global.md"
    git -C "$repo" commit -qam "docs-after-legacy-global-$legacy_global_case"
    fast_reason_in "$repo" 'project inventory unavailable' "$legacy_global_base" "$(git -C "$repo" rev-parse HEAD)"
  done
  # Removing both inventory files must still surface unsafe global.json inputs.
  for both_missing_case in sdk-paths utf16 clean-sdk; do
    git -C "$repo" reset -q --hard "$fast_base"
    git -C "$repo" rm -q scripts/ci:docs-inventory
    printf '<Project Sdk="Microsoft.NET.Sdk" />\n' > "$repo/tests/Example/Example.csproj"
    case "$both_missing_case" in
      sdk-paths)
        printf '{"sdk":{"version":"10.0.402","rollForward":"disable","allowPrerelease":false,"paths":["./missing-sdk"]}}\n' > "$repo/global.json"
        expected_both_missing_err='::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: unknown SDK resolver configuration'
        ;;
      utf16)
        python3 -I -c 'import pathlib, sys; pathlib.Path(sys.argv[1]).write_bytes("{\"sdk\":{\"version\":\"10.0.402\",\"rollForward\":\"disable\",\"allowPrerelease\":false}}\n".encode("utf-16"))' "$repo/global.json"
        expected_both_missing_err='::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: global.json is not UTF-8'
        ;;
      clean-sdk)
        cp "$repo_root/global.json" "$repo/global.json"
        expected_both_missing_err='::error::Documentation CI build inventory is stale or unsafe; refresh scripts/ci:docs-inventory and scripts/ci:restore-import-certificate.json: certificate unavailable'
        ;;
    esac
    git -C "$repo" add . && git -C "$repo" commit -qm "both-missing $both_missing_case"
    both_missing_base="$(git -C "$repo" rev-parse HEAD)"
    if (cd "$repo" && "$classifier" --check-docs-inventory "$both_missing_base") > "$repo/.git/both-missing-out" 2> "$repo/.git/both-missing-err"; then
      printf 'Mandatory docs certificate gate accepted missing-both case: %s\n' "$both_missing_case" >&2
      exit 1
    fi
    grep -Fxq "$expected_both_missing_err" "$repo/.git/both-missing-err" || {
      printf 'Unexpected missing-both diagnostic for %s:\n%s\n' "$both_missing_case" "$(cat "$repo/.git/both-missing-err")" >&2
      exit 1
    }
  done
  # Ordinary UTF-8 declarations, including case variants, remain eligible.
  for declared in utf-8 UTF-8; do
    git -C "$repo" reset -q --hard "$fast_base"
    mkdir -p "$repo/docs/runbooks"
    printf 'safe\n' > "$repo/docs/runbooks/releases.md"
    printf '<?xml version="1.0" encoding="%s"?><Project />\n' "$declared" > "$repo/tests/Example/Example.csproj"
    git -C "$repo" add . && git -C "$repo" commit -qm utf8-declaration
    (cd "$repo" && "$classifier" --print-docs-inventory HEAD) > "$repo/scripts/ci:docs-inventory"
    git -C "$repo" add scripts/ci:docs-inventory && git -C "$repo" commit -qm certificate
    utf8_base="$(git -C "$repo" rev-parse HEAD)"
    printf 'changed\n' >> "$repo/docs/runbooks/releases.md"
    git -C "$repo" commit -qam doc-change
    fast_expect_in "$repo" true pull_request "$utf8_base" "$(git -C "$repo" rev-parse HEAD)"
  done
  # ASCII bytes do not make a non-UTF-8 XML declaration acceptable.
  git -C "$repo" reset -q --hard "$fast_base"
  mkdir -p "$repo/docs/runbooks"
  printf 'safe\n' > "$repo/docs/runbooks/releases.md"
  printf '<?xml version="1.0" encoding="iso-8859-1"?><Project />\n' > "$repo/tests/Example/Example.csproj"
  git -C "$repo" add . && git -C "$repo" commit -qm ascii-latin-declaration
  encoding_decl_base="$(git -C "$repo" rev-parse HEAD)"
  if (cd "$repo" && "$classifier" --print-docs-inventory "$encoding_decl_base") > "$repo/.git/unsafe-inventory" 2> "$repo/.git/decl-error"; then
    printf 'Non-UTF-8 XML declaration was certified.\n' >&2; exit 1
  fi
  grep -Fxq 'docs inventory audit: XML declares a non-UTF-8 encoding' "$repo/.git/decl-error"
  printf 'changed\n' >> "$repo/docs/runbooks/releases.md"
  git -C "$repo" commit -qam doc-change
  fast_reason_in "$repo" 'project inventory unavailable' "$encoding_decl_base" "$(git -C "$repo" rev-parse HEAD)"
  # UTF-8 and UTF-16 encodings of the same escaped link must both fail closed.
  for encoding in utf-8 utf-16; do
    git -C "$repo" reset -q --hard "$fast_base"
    mkdir -p "$repo/docs/runbooks"
    printf 'safe\n' > "$repo/docs/runbooks/releases.md"
    ENCODING_FIXTURE="$encoding" python3 - "$repo/tests/Example/Example.csproj" <<'PY_ENCODING'
import os, pathlib, sys
text = '<Project><ItemGroup><None Include="../../%64ocs/runbooks/releases.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup></Project>'
pathlib.Path(sys.argv[1]).write_bytes(text.encode(os.environ["ENCODING_FIXTURE"]))
PY_ENCODING
    git -C "$repo" add . && git -C "$repo" commit -qm encoded-link
    encoding_base="$(git -C "$repo" rev-parse HEAD)"
    if (cd "$repo" && "$classifier" --print-docs-inventory "$encoding_base") > "$repo/.git/unsafe-inventory" 2> "$repo/.git/encoding-error"; then
      printf 'Unsafe %s input was certified.\n' "$encoding" >&2; exit 1
    fi
    if [[ "$encoding" == utf-8 ]]; then encoding_reason='escaped build input requires manual review'; else encoding_reason='build input is not UTF-8'; fi
    grep -Fxq "docs inventory audit: $encoding_reason" "$repo/.git/encoding-error"
    if (cd "$repo" && "$classifier" --check-docs-inventory "$encoding_base") > "$repo/.git/encoding-check-out" 2> "$repo/.git/encoding-check-err"; then
      printf 'Mandatory docs certificate gate accepted unsafe %s input.\n' "$encoding" >&2
      exit 1
    fi
    grep -Fxq "::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: $encoding_reason" "$repo/.git/encoding-check-err"
    printf 'changed\n' >> "$repo/docs/runbooks/releases.md"
    git -C "$repo" commit -qam doc-change
    fast_reason_in "$repo" 'project inventory unavailable' "$encoding_base" "$(git -C "$repo" rev-parse HEAD)"
  done
  # Reject traversal following the first wildcard even if current MSBuild does not match it.
  git -C "$repo" reset -q --hard "$fast_base"
  mkdir -p "$repo/docs/runbooks"
  printf 'safe\n' > "$repo/docs/runbooks/releases.md"
  printf '<Project><ItemGroup><None Include="../fixtures/**/../../../d*/runbooks/releases.md" /></ItemGroup></Project>\n' > "$repo/tests/Example/Example.csproj"
  git -C "$repo" add . && git -C "$repo" commit -qm wildcard-traversal
  wildcard_base="$(git -C "$repo" rev-parse HEAD)"
  if (cd "$repo" && "$classifier" --print-docs-inventory "$wildcard_base") > "$repo/.git/unsafe-inventory" 2> "$repo/.git/wildcard-error"; then
    printf 'Post-wildcard traversal was certified.\n' >&2; exit 1
  fi
  grep -Fxq 'docs inventory audit: item path traverses after a wildcard' "$repo/.git/wildcard-error"
  printf 'changed\n' >> "$repo/docs/runbooks/releases.md"
  git -C "$repo" commit -qam doc-change
  fast_reason_in "$repo" 'project inventory unavailable' "$wildcard_base" "$(git -C "$repo" rev-parse HEAD)"
  # A project listed only by the solution is audited regardless of its suffix.
  git -C "$repo" reset -q --hard "$fast_base"
  mkdir -p "$repo/docs/runbooks" "$repo/tests/Extra"
  printf 'safe\n' > "$repo/docs/runbooks/releases.md"
  printf '<Project />\n' > "$repo/tests/Extra/Extra.fsproj"
  printf '<Solution><Project Path="tests/Example/Example.csproj" /><Project Path="tests/Extra/Extra.fsproj" /></Solution>\n' > "$repo/HVO.SkyMonitor.v9.slnx"
  git -C "$repo" add . && git -C "$repo" commit -qm safe-solution-project
  (cd "$repo" && "$classifier" --print-docs-inventory HEAD) > "$repo/.git/solution-inventory"
  grep -Fq "b'tests/Extra/Extra.fsproj'" "$repo/.git/solution-inventory"
  grep -Fq "b'HVO.SkyMonitor.v9.slnx'" "$repo/.git/solution-inventory"
  printf '<Project Sdk="Microsoft.NET.Sdk"><ItemGroup><None Include="../../docs/runbooks/releases.md" /></ItemGroup></Project>\n' > "$repo/tests/Extra/Extra.fsproj"
  git -C "$repo" commit -qam unsafe-solution-project
  solution_base="$(git -C "$repo" rev-parse HEAD)"
  if (cd "$repo" && "$classifier" --print-docs-inventory "$solution_base") > "$repo/.git/unsafe-inventory" 2>/dev/null; then
    printf 'Unsafe solution-only project was certified.\n' >&2; exit 1
  fi
  printf 'changed\n' >> "$repo/docs/runbooks/releases.md"
  git -C "$repo" commit -qam doc-change
  fast_reason_in "$repo" 'project inventory unavailable' "$solution_base" "$(git -C "$repo" rev-parse HEAD)"
  # Missing solution entries are uncertainty, not an empty project selection.
  git -C "$repo" reset -q --hard "$fast_base"
  printf '<Solution><Project Path="tests/Example/Example.csproj" /><Project Path="missing.fsproj" /></Solution>\n' > "$repo/HVO.SkyMonitor.v9.slnx"
  git -C "$repo" commit -qam missing-solution-project
  missing_base="$(git -C "$repo" rev-parse HEAD)"
  if (cd "$repo" && "$classifier" --print-docs-inventory "$missing_base") > "$repo/.git/unsafe-inventory" 2>/dev/null; then
    printf 'Missing solution project was certified.\n' >&2; exit 1
  fi
  mkdir -p "$repo/docs/runbooks"
  printf 'changed\n' > "$repo/docs/runbooks/releases.md"
  git -C "$repo" add docs/runbooks/releases.md && git -C "$repo" commit -qm doc-change
  fast_reason_in "$repo" 'project inventory unavailable' "$missing_base" "$(git -C "$repo" rev-parse HEAD)"
  # Existing importer consuming a changed XML item file.
  git -C "$repo" reset -q --hard "$fast_base"
  mkdir -p "$repo/docs/runbooks"
  printf 'text\n' > "$repo/docs/runbooks/example.md"
  printf '<Import Project="items.xml" />\n' > "$repo/Directory.Build.targets"
  printf '<Project />\n' > "$repo/items.xml"
  git -C "$repo" add . && git -C "$repo" commit -qm import-base
  (cd "$repo" && "$classifier" --print-docs-inventory HEAD) > "$repo/scripts/ci:docs-inventory"
  git -C "$repo" add scripts/ci:docs-inventory && git -C "$repo" commit -qm certify-import
  printf '<None Include="docs/runbooks/example.md" />\n' > "$repo/items.xml"
  git -C "$repo" commit -qam change-imported-xml
  xml_base="$(git -C "$repo" rev-parse HEAD)"
  printf 'change\n' >> "$repo/docs/runbooks/example.md"
  git -C "$repo" commit -qam doc-change
  fast_reason_in "$repo" 'project inventory unavailable' "$xml_base" "$(git -C "$repo" rev-parse HEAD)"
  # A forged refresh must not certify a build input that links eligible docs.
  git -C "$repo" reset -q --hard "$fast_base"
  mkdir -p "$repo/docs/runbooks"
  printf 'text\n' > "$repo/docs/runbooks/example.md"
  printf '<None Include="../../docs/runbooks/example.md" />\n' > "$repo/tests/Example/Example.csproj"
  git -C "$repo" add docs/runbooks/example.md tests/Example/Example.csproj
  git -C "$repo" commit -qm unsafe-certified-input
  read -r item_mode item_type item_sha item_path < <(git -C "$repo" ls-tree HEAD -- tests/Example/Example.csproj)
  sed -i "/tests\/Example\/Example.csproj/d" "$repo/scripts/ci:docs-inventory"
  printf "%s %s %s b'%s'\n" "$item_mode" "$item_type" "$item_sha" "$item_path" >> "$repo/scripts/ci:docs-inventory"
  git -C "$repo" add scripts/ci:docs-inventory && git -C "$repo" commit -qm forged-certificate
  forged_base="$(git -C "$repo" rev-parse HEAD)"
  printf 'change\n' >> "$repo/docs/runbooks/example.md"
  git -C "$repo" commit -qam docs-change
  fast_reason_in "$repo" 'project inventory unavailable' "$forged_base" "$(git -C "$repo" rev-parse HEAD)"
  # Force-added .user files are auto-imported; they must disable the exemption.
  git -C "$repo" reset -q --hard "$fast_base"
  mkdir -p "$repo/docs/runbooks"
  printf 'text\n' > "$repo/docs/runbooks/example.md"
  printf '<None Include="../../docs/runbooks/example.md" />\n' > "$repo/tests/Example/Example.csproj.user"
  git -C "$repo" add -f tests/Example/Example.csproj.user
  git -C "$repo" add docs/runbooks/example.md && git -C "$repo" commit -qm user-input
  user_base="$(git -C "$repo" rev-parse HEAD)"
  if (cd "$repo" && "$classifier" --check-docs-inventory "$user_base") > "$repo/.git/user-check-out" 2> "$repo/.git/user-check-err"; then
    printf 'Mandatory docs certificate gate accepted tracked .user input.\n' >&2
    exit 1
  fi
  grep -Fxq '::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: tracked automatic MSBuild input requires manual review' "$repo/.git/user-check-err"
  printf 'Unsafe inventory mandatory gate passed.\n'
  printf 'change\n' >> "$repo/docs/runbooks/example.md"
  git -C "$repo" commit -qam docs-change
  fast_reason_in "$repo" 'project inventory unavailable' "$user_base" "$(git -C "$repo" rev-parse HEAD)"
  printf '%d\n' "$fast_cases" > "$parallel_dir/fast_cases.g3"
}

run_fast_group_4() {
  local repo="$fast_root.g4"
  cp -a "$fast_root" "$repo"
  local fast_cases=0 alias_case alias_base implicit_base link_base fault fault_reason type_mode type_base evidence_file
  local bad_args maintenance_case expected_check_reason expected_fast_reason maintenance_base
  # Tracked aliases cannot redirect any certified glob or explicit item into docs.
  for alias_case in glob_file directory file_update; do
    git -C "$repo" reset -q --hard "$fast_base"
    mkdir -p "$repo/docs/runbooks" "$repo/tests/fixtures/space-weather/swpc-v1"
    printf 'safe\n' > "$repo/docs/runbooks/releases.md"
    case "$alias_case" in
      glob_file)
        printf '<Project><ItemGroup><None Include="../fixtures/space-weather/swpc-v1/**/*" CopyToOutputDirectory="PreserveNewest" /></ItemGroup></Project>\n' > "$repo/tests/Example/Example.csproj"
        printf 'fixture\n' > "$repo/tests/fixtures/space-weather/swpc-v1/source.json"
        git -C "$repo" add . && git -C "$repo" commit -qm safe-glob
        (cd "$repo" && "$classifier" --print-docs-inventory HEAD) > "$repo/scripts/ci:docs-inventory"
        git -C "$repo" add scripts/ci:docs-inventory && git -C "$repo" commit -qm certified-glob
        ln -s ../../../../docs/runbooks/releases.md "$repo/tests/fixtures/space-weather/swpc-v1/alias.md" ;;
      directory)
        printf '<Project><ItemGroup><None Include="../fixtures/shared-docs/releases.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup></Project>\n' > "$repo/tests/Example/Example.csproj"
        ln -s ../../docs "$repo/tests/fixtures/shared-docs" ;;
      file_update)
        printf '<Project><ItemGroup><None Update="alias.md" CopyToOutputDirectory="PreserveNewest" /></ItemGroup></Project>\n' > "$repo/tests/Example/Example.csproj"
        ln -s ../../docs/runbooks/releases.md "$repo/tests/Example/alias.md" ;;
    esac
    git -C "$repo" add . && git -C "$repo" commit -qm tracked-alias
    alias_base="$(git -C "$repo" rev-parse HEAD)"
    if (cd "$repo" && "$classifier" --print-docs-inventory "$alias_base") > "$repo/.git/unsafe-inventory" 2> "$repo/.git/alias-error"; then
      printf 'Tracked alias %s was certified.\n' "$alias_case" >&2; exit 1
    fi
    grep -Fxq 'docs inventory audit: tracked symlink requires manual review' "$repo/.git/alias-error"
    if (cd "$repo" && "$classifier" --check-docs-inventory "$alias_base") > "$repo/.git/alias-check-out" 2> "$repo/.git/alias-check-err"; then
      printf 'Mandatory docs certificate gate accepted tracked alias %s.\n' "$alias_case" >&2
      exit 1
    fi
    grep -Fxq '::error::Documentation CI build inventory is stale or unsafe; remove the unsafe input or update the audit policy under HIGH-tier review: tracked symlink requires manual review' "$repo/.git/alias-check-err"
    printf 'changed\n' >> "$repo/docs/runbooks/releases.md"
    git -C "$repo" commit -qam doc-change
    fast_reason_in "$repo" 'project inventory unavailable' "$alias_base" "$(git -C "$repo" rev-parse HEAD)"
  done
  # A repository-root SDK project can copy implicit None items in Release.
  git -C "$repo" reset -q --hard "$fast_base"
  mkdir -p "$repo/docs/runbooks"
  printf 'safe\n' > "$repo/docs/runbooks/releases.md"
  cat > "$repo/Root.csproj" <<'EOF'
<Project Sdk="Microsoft.NET.Sdk"><ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'"><None><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None></ItemDefinitionGroup></Project>
EOF
  printf '<Solution><Project Path="tests/Example/Example.csproj" /><Project Path="Root.csproj" /></Solution>\n' > "$repo/HVO.SkyMonitor.v9.slnx"
  git -C "$repo" add . && git -C "$repo" commit -qm implicit-root-project
  implicit_base="$(git -C "$repo" rev-parse HEAD)"
  if (cd "$repo" && "$classifier" --print-docs-inventory "$implicit_base") > "$repo/.git/unsafe-inventory" 2> "$repo/.git/implicit-error"; then
    printf 'Root implicit-item project was certified.\n' >&2; exit 1
  fi
  grep -Fxq 'docs inventory audit: project location permits implicit documentation items' "$repo/.git/implicit-error"
  printf 'changed\n' >> "$repo/docs/runbooks/releases.md"
  git -C "$repo" commit -qam doc-change
  fast_reason_in "$repo" 'project inventory unavailable' "$implicit_base" "$(git -C "$repo" rev-parse HEAD)"
  # Ignore settings must not hide a gitlink update accompanying a safe doc.
  git -C "$repo" reset -q --hard "$fast_base"
  git -C "$repo" update-index --add --cacheinfo "160000,$fast_base,submodule"
  git -C "$repo" commit -qm gitlink-base
  link_base="$(git -C "$repo" rev-parse HEAD)"
  git -C "$repo" update-index --cacheinfo "160000,$link_base,submodule"
  printf 'text\n' > "$repo/docs/gitlink.md"
  git -C "$repo" add docs/gitlink.md && git -C "$repo" commit -qm gitlink-change
  git -C "$repo" config diff.ignoreSubmodules all
  fast_reason_in "$repo" 'project inventory unavailable' "$link_base" "$(git -C "$repo" rev-parse HEAD)"
  git -C "$repo" config --unset diff.ignoreSubmodules
  # Failure controls exercise distinct fail-closed reasons.
  mkdir -p "$repo/.git/fault-bin"
  cat > "$repo/.git/fault-bin/git" <<'EOF'
#!/usr/bin/env bash
case "$FAIL_KIND:$1:${2:-}" in
  ls-tree:ls-tree:* | blob:cat-file:blob | diff:diff:* | inventory:show:*) exit 2 ;;
esac
exec "$FAST_REAL_GIT" "$@"
EOF
  chmod +x "$repo/.git/fault-bin/git"
  for fault in ls-tree blob diff inventory; do
    case "$fault" in
      ls-tree) fault_reason='non-regular or missing path in exact diff' ;;
      blob) fault_reason='documentation is binary or unreadable' ;;
      diff) fault_reason='exact diff failed or is empty' ;;
      inventory) fault_reason='project inventory unavailable' ;;
    esac
    PATH="$repo/.git/fault-bin:$PATH" FAST_REAL_GIT="$fast_real_git" FAIL_KIND="$fault" fast_reason_in "$repo" "$fault_reason" "$modified_base" "$modified_head"
  done
  printf '#!/usr/bin/env bash\nexit 2\n' > "$repo/.git/fault-bin/python3"
  chmod +x "$repo/.git/fault-bin/python3"
  PATH="$repo/.git/fault-bin:$PATH" FAST_REAL_GIT="$fast_real_git" FAIL_KIND=none fast_reason_in "$repo" 'documentation is binary or unreadable' "$modified_base" "$modified_head"
  rm "$repo/.git/fault-bin/python3"
  # Existing regular file changed to symlink and the inverse are type changes.
  for type_mode in regular symlink; do
    git -C "$repo" reset -q --hard "$fast_base"
    if [[ "$type_mode" == regular ]]; then printf 'text\n' > "$repo/docs/type.md"; else ln -s contracts/linked.md "$repo/docs/type.md"; fi
    git -C "$repo" add docs/type.md && git -C "$repo" commit -qm type-base
    type_base="$(git -C "$repo" rev-parse HEAD)"
    rm "$repo/docs/type.md"
    if [[ "$type_mode" == regular ]]; then ln -s contracts/linked.md "$repo/docs/type.md"; else printf 'text\n' > "$repo/docs/type.md"; fi
    git -C "$repo" add docs/type.md && git -C "$repo" commit -qm type-change
    fast_reason_in "$repo" 'deleted or type-changed path in exact diff' "$type_base" "$(git -C "$repo" rev-parse HEAD)"
  done
  # Rejection evidence lists the complete exact diff and only the docs decision.
  git -C "$repo" reset -q --hard "$fast_base"
  printf 'unsafe\n' > "$repo/CHANGELOG.md"
  printf 'safe\n' > "$repo/docs/second.md"
  git -C "$repo" add CHANGELOG.md docs/second.md && git -C "$repo" commit -qm evidence
  evidence_file="$repo/.git/fast-summary"
  (cd "$repo" && GITHUB_STEP_SUMMARY="$evidence_file" "$classifier" pull_request "$fast_base" HEAD docs-fast-only >/dev/null)
  grep -Fq 'docs/second.md' "$evidence_file"
  grep -Fq 'Fast path paths examined: 2' "$evidence_file"
  local mode_grep_rc=0
  grep -Fq 'Mode: **' "$evidence_file" || mode_grep_rc=$?
  if (( mode_grep_rc == 0 )); then
    printf 'Docs-fast-only summary unexpectedly included Mode output:\n%s\n' "$(cat "$evidence_file")" >&2
    exit 1
  elif (( mode_grep_rc != 1 )); then
    printf 'Docs-fast-only summary check failed to inspect %s (grep exit %d).\n' "$evidence_file" "$mode_grep_rc" >&2
    exit 1
  fi
  ((fast_cases += 1))
  # Mandatory certificate-maintenance gate controls.
  (cd "$repo" && "$classifier" --check-docs-inventory "$fast_base") > "$repo/.git/check-clean-out" 2> "$repo/.git/check-clean-err"
  grep -Fxq 'Documentation CI build inventory is current and audited.' "$repo/.git/check-clean-out"
  [[ ! -s "$repo/.git/check-clean-err" ]]
  for bad_args in '' 'nonexistent-ref-1996' "$fast_base extra-arg"; do
    # shellcheck disable=SC2086 # Intentionally split argument fixtures.
    if (cd "$repo" && "$classifier" --check-docs-inventory $bad_args) > "$repo/.git/check-arg-out" 2> "$repo/.git/check-arg-err"; then
      printf 'Mandatory docs certificate gate accepted invalid arguments: %s\n' "$bad_args" >&2
      exit 1
    fi
    grep -Fq '::error::Documentation CI build inventory check failed: commit unavailable' "$repo/.git/check-arg-err"
  done
  for maintenance_case in missing executable stale-input drifted-inventory missing-verifier; do
    git -C "$repo" reset -q --hard "$fast_base"
    mkdir -p "$repo/docs/runbooks"
    printf 'text\n' > "$repo/docs/runbooks/maintenance.md"
    case "$maintenance_case" in
      missing)
        git -C "$repo" rm -q scripts/ci:docs-inventory
        expected_check_reason='certificate unavailable'
        expected_fast_reason='project inventory unavailable'
        ;;
      executable)
        chmod +x "$repo/scripts/ci:docs-inventory"
        git -C "$repo" update-index --chmod=+x -- scripts/ci:docs-inventory
        expected_check_reason='certificate must be a regular non-executable file'
        expected_fast_reason='project inventory unavailable'
        ;;
      stale-input)
        printf '<!-- updated project -->\n<None Include="../../docs/contracts/linked.md" />\n' > "$repo/tests/Example/Example.csproj"
        expected_check_reason='certificate differs from the audited inputs'
        expected_fast_reason='project inventory differs from certified baseline'
        ;;
      drifted-inventory)
        printf '100644 blob 0000000000000000000000000000000000000000 b'\''drifted.csproj'\''\n' >> "$repo/scripts/ci:docs-inventory"
        expected_check_reason='certificate differs from the audited inputs'
        expected_fast_reason='project inventory differs from certified baseline'
        ;;
      missing-verifier)
        printf '{"version":1}\n' > "$repo/scripts/ci:restore-import-certificate.json"
        git -C "$repo" add scripts/ci:restore-import-certificate.json
        expected_check_reason='restore import verifier unavailable'
        expected_fast_reason='project inventory unavailable'
        ;;
    esac
    git -C "$repo" add -A && git -C "$repo" commit -qm "maintenance-$maintenance_case"
    maintenance_base="$(git -C "$repo" rev-parse HEAD)"
    if (cd "$repo" && "$classifier" --check-docs-inventory "$maintenance_base") > "$repo/.git/check-fail-out" 2> "$repo/.git/check-fail-err"; then
      printf 'Mandatory docs certificate gate accepted %s.\n' "$maintenance_case" >&2
      exit 1
    fi
    grep -Fxq "::error::Documentation CI build inventory is stale or unsafe; refresh scripts/ci:docs-inventory and scripts/ci:restore-import-certificate.json: $expected_check_reason" "$repo/.git/check-fail-err"
    printf 'changed\n' >> "$repo/docs/runbooks/maintenance.md"
    git -C "$repo" commit -qam "docs-after-$maintenance_case"
    fast_reason_in "$repo" "$expected_fast_reason" "$maintenance_base" "$(git -C "$repo" rev-parse HEAD)"
  done
  printf 'Mandatory docs certificate maintenance gate controls passed.\n'
  printf '%d\n' "$fast_cases" > "$parallel_dir/fast_cases.g4"
}

run_fast_group_canary() {
  local canary_dir="$fast_root.canary"
  mkdir -p "$canary_dir/canary-objects"
  local real_base canary_source_objects canary_index canary_blob canary_tree canary_head canary_expected canary_output
  local runtime_input runtime_index runtime_blob runtime_tree runtime_head runtime_fast_output runtime_comp_output canary_commit
  (
    real_base="$(git -C "$repo_root" rev-parse HEAD)"
    (cd "$repo_root" && "$classifier" --check-docs-inventory "$real_base")
    canary_source_objects="$(git -C "$repo_root" rev-parse --path-format=absolute --git-path objects)"
    export GIT_OBJECT_DIRECTORY="$canary_dir/canary-objects"
    export GIT_ALTERNATE_OBJECT_DIRECTORIES="$canary_source_objects"
    canary_index="$canary_dir/canary-index"
    GIT_INDEX_FILE="$canary_index" git -C "$repo_root" read-tree "$real_base"
    canary_blob="$(printf 'canary documentation\n' | git -C "$repo_root" hash-object -w --stdin)"
    GIT_INDEX_FILE="$canary_index" git -C "$repo_root" update-index --add --cacheinfo "100644,$canary_blob,docs/runbooks/ci-fast-path-canary-1989.md"
    canary_tree="$(GIT_INDEX_FILE="$canary_index" git -C "$repo_root" write-tree)"
    canary_head="$(printf 'CI inventory canary\n' | git -C "$repo_root" -c user.name='CI fixture' -c user.email=fixture@example.invalid commit-tree "$canary_tree" -p "$real_base")"
    printf '%s\n' "$canary_head" > "$canary_dir/canary-commit"
    git -C "$repo_root" show "$real_base:scripts/ci:docs-inventory" > "$canary_dir/certified"
    (cd "$repo_root" && "$classifier" --print-docs-inventory "$real_base") > "$canary_dir/actual"
    cmp -s "$canary_dir/certified" "$canary_dir/actual" || { printf 'Real inventory differs from committed certificate.\n' >&2; exit 1; }
    canary_expected=true
    if git -C "$repo_root" cat-file -e "$real_base:scripts/ci:restore-import-certificate.json"; then
      canary_expected=verify-restore
    fi
    canary_output="$(cd "$repo_root" && "$classifier" pull_request "$real_base" "$canary_head" docs-fast-only)"
    grep -Fxq "docs_fast_path=$canary_expected" <<< "$canary_output" || { printf 'Real inventory canary failed: %s\n' "$canary_output" >&2; exit 1; }
    printf 'Real inventory canary passed: expected %s.\n' "$canary_expected"
    for runtime_input in \
      "src/HVO.SkyMonitor.CameraAgent/wwwroot/css/themes/hvo-dark.css" \
      "docs/runbooks/cameraagent-silo-runtime.md" \
      "THIRD-PARTY-NOTICES.md"; do
      runtime_index="$canary_dir/runtime-index-${runtime_input//\//_}"
      GIT_INDEX_FILE="$runtime_index" git -C "$repo_root" read-tree "$real_base"
      runtime_blob="$(printf 'runtime input mutation for %s\n' "$runtime_input" | git -C "$repo_root" hash-object -w --stdin)"
      GIT_INDEX_FILE="$runtime_index" git -C "$repo_root" update-index --add --cacheinfo "100644,$runtime_blob,$runtime_input"
      runtime_tree="$(GIT_INDEX_FILE="$runtime_index" git -C "$repo_root" write-tree)"
      runtime_head="$(printf 'CI runtime input canary %s\n' "$runtime_input" | git -C "$repo_root" -c user.name='CI fixture' -c user.email=fixture@example.invalid commit-tree "$runtime_tree" -p "$real_base")"
      runtime_fast_output="$(cd "$repo_root" && "$classifier" pull_request "$real_base" "$runtime_head" docs-fast-only)"
      grep -Fxq 'docs_fast_path=false' <<< "$runtime_fast_output" || {
        printf 'Real-repo runtime input %s qualified for docs fast path:\n%s\n' "$runtime_input" "$runtime_fast_output" >&2
        exit 1
      }
      grep -Fxq 'docs_fast_path_reason=path outside documentation allowlist' <<< "$runtime_fast_output" || {
        printf 'Real-repo runtime input %s had unexpected docs_fast_path_reason:\n%s\n' "$runtime_input" "$runtime_fast_output" >&2
        exit 1
      }
      runtime_comp_output="$(cd "$repo_root" && "$classifier" pull_request "$real_base" "$runtime_head")"
      grep -Fxq 'mode=full' <<< "$runtime_comp_output" &&
        grep -Fxq 'delivery=true' <<< "$runtime_comp_output" || {
        printf 'Real-repo runtime input %s did not select delivery=true:\n%s\n' "$runtime_input" "$runtime_comp_output" >&2
        exit 1
      }
    done
    printf 'Real-repo Deployment.Cli.Tests runtime input canaries passed (3 inputs).\n'
  )
  canary_commit="$(cat "$canary_dir/canary-commit")"
  if git -C "$repo_root" cat-file -e "$canary_commit^{commit}" 2>/dev/null; then
    printf 'Canary wrote an object into the developer repository.\n' >&2
    exit 1
  fi
  printf 'Canary object isolation passed.\n'
}

# ==============================================================================
# Work-root classification test group functions
# ==============================================================================

run_work_allow_and_secret() {
  local repo="$work_root.allow-secret"
  cp -a "$work_root" "$repo"
  local secret_scan_contract_cases=0 release_scripts_cases=0 catalog_recipe_cases=0
  local output summary_file path base head i
  # Deduplicated allowlisted event checks (4 classifier runs instead of 17).
  output="$(classify_in_repo "$repo" pull_request "$base_sha" "$head_sha")"
  assert_plan_output "$output" reduced false
  assert_components_output "$output" false false false false
  assert_secret_scan_contract_output "$output" false
  assert_release_scripts_output "$output" false

  output="$(classify_in_repo "$repo" push "$base_sha" "$head_sha")"
  assert_plan_output "$output" full true
  assert_components_output "$output" true true true true
  assert_suites_output "$output" true true
  assert_secret_scan_contract_output "$output" true
  assert_release_scripts_output "$output" true
  assert_catalog_recipe_output "$output" true

  output="$(classify_in_repo "$repo" workflow_dispatch "$base_sha" "$head_sha")"
  assert_plan_output "$output" full true
  assert_components_output "$output" true true true true
  assert_suites_output "$output" true true
  assert_secret_scan_contract_output "$output" true
  assert_release_scripts_output "$output" true
  assert_catalog_recipe_output "$output" true

  output="$(classify_in_repo "$repo" merge_group "$base_sha" "$head_sha")"
  assert_components_output "$output" true true true true

  # Restore-import verifier and offline proof changes select full mode (#1996).
  local -a restore_pairs=()
  batch_commit_pairs restore_pairs "$repo" 2 \
    "scripts/ci/restore-imports.py|classification fixture"$'\n' \
    "scripts/test:ci-docs-restore-import|classification fixture"$'\n'
  for ((i = 0; i < 2; i++)); do
    read -r base head <<< "${restore_pairs[$i]}"
    output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
    assert_plan_output "$output" full false
  done

  summary_file="$repo/.git/classification-summary.md"
  (cd "$repo" && GITHUB_STEP_SUMMARY="$summary_file" "$classifier" pull_request "$base_sha" "$head_sha" >/dev/null)
  grep -Fq 'Mode: **reduced**' "$summary_file"
  grep -Fq 'Deployment contracts: **false**' "$summary_file"
  grep -Fq 'Complete matrix: **false**' "$summary_file"
  grep -Fq 'Secret scan contract: **false**' "$summary_file"
  grep -Fq 'Release scripts: **false**' "$summary_file"
  grep -Fq 'Deployment reason: pull request does not change deployment-contract inputs' "$summary_file"

  local -a secret_scan_contract_paths=(
    "scripts/ci:secret-scan"
    "scripts/test:ci-secret-scan"
    ".gitleaks.toml"
    ".gitleaksignore"
    "docs/.gitleaksignore"
    "docs/nested/fixture.gitleaksignore"
    ".gitattributes"
    "scripts/.gitattributes"
    "tests/fixtures/x/.gitattributes"
    ".github/workflows/development-v1.yml"
    ".github/workflows/ci.yml"
    "scripts/ci:classify"
  )
  local -a specs=() pairs=()
  for path in "${secret_scan_contract_paths[@]}"; do
    specs+=("$path|classification fixture"$'\n')
    specs+=("$path|classification fixture"$'\n'"updated classification fixture"$'\n')
  done
  specs+=("src/HVO.SkyMonitor.CameraAgent/Components/Unrelated.razor|classification fixture"$'\n')
  batch_commit_pairs pairs "$repo" "$(( ${#secret_scan_contract_paths[@]} * 2 + 1 ))" "${specs[@]}"
  for ((i = 0; i < ${#secret_scan_contract_paths[@]} * 2; i++)); do
    read -r base head <<< "${pairs[$i]}"
    output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
    assert_secret_scan_contract_output "$output" true
  done
  read -r base head <<< "${pairs[-1]}"
  output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
  assert_secret_scan_contract_output "$output" false

  # Deleting a gated path must retain the contract, even though its tree entry is gone.
  git -C "$repo" read-tree HEAD
  local contract_base="$head" contract_head
  git -C "$repo" rm --cached --quiet .gitleaks.toml
  git -C "$repo" commit --quiet -m "Delete scanner configuration"
  contract_head="$(git -C "$repo" rev-parse HEAD)"
  output="$(classify_in_repo "$repo" pull_request "$contract_base" "$contract_head")"
  assert_secret_scan_contract_output "$output" true

  printf '%d\n' "$secret_scan_contract_cases" > "$parallel_dir/secret_cases.allow"
  printf '%d\n' "$release_scripts_cases" > "$parallel_dir/release_cases.allow"
  printf '%d\n' "$catalog_recipe_cases" > "$parallel_dir/catalog_cases.allow"
}

