# Failure, cancellation, missing, and unexpected results are all rejected.
for job in changes quality catalog-contracts build architecture coverage-policy \
  migrations-cameraagent migrations-logichost cameraagent-component; do
  for outcome in failure cancelled skipped; do
    expect_required_reject "$job=$outcome in the CameraAgent plan" pull_request "$cameraagent_plan" \
      "$(results changes=success quality=success catalog-contracts=success build=success \
        architecture=success coverage-policy=success migrations-cameraagent=success \
        migrations-logichost=success cameraagent-component=success "$job=$outcome")"
  done
done

for job in unit integration coverage logichost-component combined-integration \
  delivery-component shared-libraries deployment-contracts; do
  for outcome in failure cancelled success; do
    expect_required_reject "unexpected $job=$outcome in the CameraAgent plan" pull_request "$cameraagent_plan" \
      "$(results changes=success quality=success catalog-contracts=success build=success \
        architecture=success coverage-policy=success migrations-cameraagent=success \
        migrations-logichost=success cameraagent-component=success "$job=$outcome")"
  done
done

expect_required_reject "cancelled unit in the complete matrix" pull_request "$complete_plan_undeployed" \
  "$(results changes=success quality=success catalog-contracts=success build=success \
    architecture=success coverage-policy=success migrations-cameraagent=success \
    migrations-logichost=success unit=cancelled integration=success coverage=success)"
