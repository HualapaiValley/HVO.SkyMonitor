verify_component_plan "src/HVO.SkyMonitor.CameraAgent/Controllers/FrameController.cs"  full false false false true  false true  false
verify_component_plan "src/HVO.SkyMonitor.CameraAgent/Authentication/Scheme.cs"        full false false false true  false true  false
