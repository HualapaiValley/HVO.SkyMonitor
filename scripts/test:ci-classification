    "src/HVO.SkyMonitor.CameraAgent/cameraagent.sample.json|full|true|false|false|true|false|M" \
    "src/HVO.SkyMonitor.CameraAgent/virtual-asi174.full.json|full|true|false|false|true|false|M" \
    "src/HVO.SkyMonitor.CameraAgent/virtual-asi178mc.full.json|full|true|false|false|true|false|M" \
    "src/HVO.SkyMonitor.CameraAgent/Configuration/OwnerPasswordFileText.cs|full|false|false|false|true|true|M" \
    "src/HVO.SkyMonitor.CameraAgent/Configuration/LocalIdentityOptions.cs|full|false|false|false|true|true|M" \
    "src/HVO.SkyMonitor.CameraAgent/wwwroot/css/themes/hvo-dark.css|full|false|false|false|true|true|M" \
    "docs/runbooks/cameraagent-silo-runtime.md|full|false|true|true|true|true|M" \
    "src/HVO.SkyMonitor.CameraAgent.Common/DeploymentLocation/RetainedIntegrityFormat.cs|full|false|false|false|true|true|M" \
    "Directory.Build.targets|full|false|true|true|true|true|M" \
    ".github/workflows/development-v1.yml|full|false|true|true|true|true|M" \
    "scripts/coverage:development-v1|full|false|true|true|true|true|A" \
    "scripts/coverage/Program.cs|full|false|true|true|true|true|M" \
    "scripts/coverage/UnitCoverageInputs.cs|full|false|true|true|true|true|A" \
    "tests/unit-test-projects.json|full|false|true|true|true|true|M"

  # CameraAgent-only Home.razor across pull_request, merge_group, push.
  local -a home_pairs=()
  batch_commit_pairs home_pairs "$repo" 2 \
    "src/HVO.SkyMonitor.CameraAgent/Components/Home.razor|classification fixture"$'\n' \
    "src/HVO.SkyMonitor.CameraAgent/Components/Home.razor|updated classification fixture"$'\n'
  read -r base head <<< "${home_pairs[1]}"
  output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
  assert_plan_output "$output" full false
  assert_components_output "$output" false false true false
  output="$(classify_in_repo "$repo" merge_group "$base" "$head")"
  assert_plan_output "$output" full true
  assert_components_output "$output" true true true true
  output="$(classify_in_repo "$repo" push "$base" "$head")"
  assert_plan_output "$output" full true
  assert_components_output "$output" true true true true

  # Deployment paths.
  local -a deployment_rows=(
    ".env.template|A"
    "docker-compose.apps.yml|A"
    "scripts/test:deployment-installer|A"
    "scripts/test:deployment-installer-qualification|A"
    "scripts/qualify:silo-runtime|A"
    "scripts/test:silo-runtime-qualification|A"
    "scripts/catalog:install|M"
    "scripts/infra:operation-lock|A"
    "deploy/acceptance/cameraagent-dual-standalone-smoke/compose.yml|A"
    "deploy/hvo-docker/README.md|A"
    "deploy/hvo-docker/docker-compose.shared-services.yml|A"
    "tests/fixtures/catalog/hyg-v42-bright-stars.sqlite|M"
    "src/HVO.SkyMonitor.Deployment.Cli/Program.cs|A"
    "tests/HVO.SkyMonitor.Deployment.Distribution.Tests/ReleaseAssetsToolTests.cs|A"
    "src/HVO.SkyMonitor.CameraAgent/virtual-asi174.full.json|M"
    "src/HVO.SkyMonitor.CameraAgent/virtual-asi178mc.full.json|M"
  )
  local -a dep_specs=() dep_pairs=()
  local dep_path dep_status
  for ((i = 0; i < ${#deployment_rows[@]}; i++)); do
    IFS='|' read -r dep_path _ <<< "${deployment_rows[$i]}"
    dep_specs+=("$dep_path|deployment fixture $i"$'\n')
  done
  batch_commit_pairs dep_pairs "$repo" "${#deployment_rows[@]}" "${dep_specs[@]}"
  for ((i = 0; i < ${#deployment_rows[@]}; i++)); do
    IFS='|' read -r dep_path dep_status <<< "${deployment_rows[$i]}"
    read -r base head <<< "${dep_pairs[$i]}"
    assert_diff_status "$repo" "$base" "$head" "$dep_status" "$dep_path"
    output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
    assert_plan_output "$output" full true
  done

  # Targeted deployment suites (seed then modify so every case classifies an M diff).
  local -a targeted_rows=(
    ".github/workflows/ci.yml|true|true"
    ".github/workflows/release.yml|true|true"
    ".github/workflows/prerelease.yml|true|true"
    ".github/workflows/release-image.yml|true|true"
    "scripts/catalog/install-hyg-v42.sh|true|false"
    "scripts/ci:component-build|true|true"
    "tests/fixtures/catalog/hyg-v42-bright-stars.sqlite|true|false"
    "scripts/infra:operation-lock|true|false"
    "scripts/test:deployment-installer|false|true"
    "scripts/test:deployment-installer-qualification|false|true"
    "scripts/qualify:silo-runtime|false|false"
    "scripts/test:silo-runtime-qualification|false|false"
  )
  local -a tgt_specs=() tgt_pairs=()
  local tpath tcat tinst
  for ((i = 0; i < ${#targeted_rows[@]}; i++)); do
    IFS='|' read -r tpath _ <<< "${targeted_rows[$i]}"
    tgt_specs+=("$tpath|targeted seed $i"$'\n')
    tgt_specs+=("$tpath|targeted updated $i"$'\n')
  done
  batch_commit_pairs tgt_pairs "$repo" "$(( ${#targeted_rows[@]} * 2 ))" "${tgt_specs[@]}"
  for ((i = 0; i < ${#targeted_rows[@]}; i++)); do
    IFS='|' read -r tpath tcat tinst <<< "${targeted_rows[$i]}"
    read -r base head <<< "${tgt_pairs[$((i * 2 + 1))]}"
    assert_diff_status "$repo" "$base" "$head" M "$tpath"
    output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
    assert_plan_output "$output" full true
    assert_suites_output "$output" "$tcat" "$tinst"
  done

  # Sync working tree once for mixed, fallback, delete/rename/type/symlink/newline, fake-bin, trailing-bin.
  git -C "$repo" reset -q --hard HEAD

  # Mixed diffs union every affected lane.
  base="$(git -C "$repo" rev-parse HEAD)"
  commit_file_in "$repo" "src/HVO.SkyMonitor.CameraAgent.Common/Storage/Mixed.cs"
  commit_file_in "$repo" "src/HVO.SkyMonitor.Deployment.Contracts/Mixed.cs"
  head="$(git -C "$repo" rev-parse HEAD)"
  output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
  assert_plan_output "$output" full true
  assert_components_output "$output" false false true true

  base="$(git -C "$repo" rev-parse HEAD)"
  commit_file_in "$repo" "docs/mixed.md"
  commit_file_in "$repo" "src/HVO.SkyMonitor.CameraAgent.Common/Storage/DocsMixed.cs"
  head="$(git -C "$repo" rev-parse HEAD)"
  output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
  assert_plan_output "$output" full false
  assert_components_output "$output" false false true false

  # The complete fallback matrix (deduplicated per unique range).
  head="$(git -C "$repo" rev-parse HEAD)"
  output="$(classify_in_repo "$repo" pull_request "$head" "$head")"
  assert_secret_scan_contract_output "$output" true
  assert_release_scripts_output "$output" true
  assert_catalog_recipe_output "$output" true
  assert_plan_output "$output" full true
  assert_components_output "$output" true true true true

  output="$(classify_in_repo "$repo" pull_request "$head" missing-commit)"
  assert_secret_scan_contract_output "$output" true
  assert_release_scripts_output "$output" true
  assert_catalog_recipe_output "$output" true
  assert_plan_output "$output" full true
  assert_components_output "$output" true true true true

  output="$(classify_in_repo "$repo" pull_request missing-commit "$head")"
  assert_secret_scan_contract_output "$output" true
  assert_release_scripts_output "$output" true
  assert_catalog_recipe_output "$output" true

  commit_file_in "$repo" "docs/delete.md"
  base="$(git -C "$repo" rev-parse HEAD)"
  rm "$repo/docs/delete.md"
  git -C "$repo" add --all
  git -C "$repo" commit --quiet -m "Delete documentation"
  head="$(git -C "$repo" rev-parse HEAD)"
  output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
  assert_plan_output "$output" full true
  assert_components_output "$output" true true true true

  commit_file_in "$repo" "docs/rename.md"
  base="$(git -C "$repo" rev-parse HEAD)"
  git -C "$repo" mv docs/rename.md docs/renamed.md
  git -C "$repo" commit --quiet -m "Rename documentation"
  head="$(git -C "$repo" rev-parse HEAD)"
  output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
  assert_plan_output "$output" full true
  assert_components_output "$output" true true true true

  commit_file_in "$repo" "docs/type-change.md"
  base="$(git -C "$repo" rev-parse HEAD)"
  rm "$repo/docs/type-change.md"
  ln -s ../README.md "$repo/docs/type-change.md"
  git -C "$repo" add --all
  git -C "$repo" commit --quiet -m "Change documentation path type"
  head="$(git -C "$repo" rev-parse HEAD)"
  output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
  assert_plan_output "$output" full true
  assert_components_output "$output" true true true true

  base="$(git -C "$repo" rev-parse HEAD)"
  ln -s ../README.md "$repo/docs/added-link.md"
  git -C "$repo" add --all
  git -C "$repo" commit --quiet -m "Add documentation symlink"
  head="$(git -C "$repo" rev-parse HEAD)"
  output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
  assert_secret_scan_contract_output "$output" true
  assert_release_scripts_output "$output" true
  assert_catalog_recipe_output "$output" true
  assert_plan_output "$output" full true
  assert_components_output "$output" true true true true

  base="$(git -C "$repo" rev-parse HEAD)"
  local newline_path=$'docs/line\nbreak.md'
  commit_file_in "$repo" "$newline_path"
  head="$(git -C "$repo" rev-parse HEAD)"
  output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
  assert_plan_output "$output" reduced false
  assert_components_output "$output" false false false false

  local real_git="$fast_real_git"
  mkdir -p "$repo/fake-bin"
  cat > "$repo/fake-bin/git" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
case "$1" in
  cat-file) exit 0 ;;
  diff)
    [[ "${FAKE_GIT_DIFF_FAILURE:-false}" != true ]] || exit 91
    case "${FAKE_GIT_DIFF_SHAPE:-malformed}" in
      malformed) printf 'M\0' ;;
      unterminated) printf 'M' ;;
      empty-path) printf 'M\0\0' ;;
    esac
    exit 0
    ;;
  *) exec "${REAL_GIT:?}" "$@" ;;
esac
EOF
  chmod +x "$repo/fake-bin/git"

  local expected_fail_closed=$'mode=full\ndeployment=true\ndeployment_catalog=true\ndeployment_installer=true\ncomplete=true\nshared=true\ncameraagent=true\ndelivery=true\nsecret_scan_contract=true\nrelease_scripts=true\ncatalog_recipe=true'
  local fake_case fake_failure
  for fake_case in malformed unterminated empty-path failure; do
    if [[ "$fake_case" == failure ]]; then fake_failure=true; else fake_failure=false; fi
    output="$(cd "$repo" && PATH="$repo/fake-bin:$PATH" REAL_GIT="$real_git" FAKE_GIT_DIFF_FAILURE="$fake_failure" FAKE_GIT_DIFF_SHAPE="$fake_case" \
      "$classifier" pull_request fake-base fake-head)"
    assert_secret_scan_contract_output "$output" true
    assert_release_scripts_output "$output" true
    assert_catalog_recipe_output "$output" true
    if [[ "$output" != "$expected_fail_closed"$'\n'docs_fast_path=false$'\n'docs_fast_path_reason=* ]]; then
      printf 'Expected fail-closed malformed/diff-failure plan, received %s\n' "$output" >&2
      exit 1
    fi
  done

  # A valid unrelated regular entry must precede the malformed tail.
  local trailing_base trailing_head trailing_entry
  trailing_base="$(git -C "$repo" rev-parse HEAD^)"
  trailing_head="$(git -C "$repo" rev-parse HEAD)"
  "$real_git" -C "$repo" cat-file -e "${trailing_base}^{commit}"
  "$real_git" -C "$repo" cat-file -e "${trailing_head}^{commit}"
  trailing_entry="$("$real_git" -C "$repo" ls-tree "$trailing_head" -- docs/runbooks/example.md)"
  [[ "$trailing_entry" == '100644 '* ]] || {
    printf 'Malformed-tail fixture requires an unrelated regular tree entry.\n' >&2
    exit 1
  }
  mkdir -p "$repo/trailing-bin"
  cat > "$repo/trailing-bin/git" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$1" == diff ]]; then
  printf 'M\0docs/runbooks/example.md\0M\0'
  exit 0
fi
exec "${REAL_GIT:?}" "$@"
EOF
  chmod +x "$repo/trailing-bin/git"
  output="$(cd "$repo" && PATH="$repo/trailing-bin:$PATH" REAL_GIT="$real_git" \
    "$classifier" pull_request "$trailing_base" "$trailing_head")"
  assert_secret_scan_contract_output "$output" true
  assert_release_scripts_output "$output" true
  assert_catalog_recipe_output "$output" true

  printf '%d\n' "$secret_scan_contract_cases" > "$parallel_dir/secret_cases.fallback"
  printf '%d\n' "$release_scripts_cases" > "$parallel_dir/release_cases.fallback"
  printf '%d\n' "$catalog_recipe_cases" > "$parallel_dir/catalog_cases.fallback"
}

# ==============================================================================
# Required CI aggregation, SIGPIPE regression, and Workflow shape groups
# ==============================================================================

plan() {
  printf 'mode=%s complete=%s shared=%s cameraagent=%s delivery=%s deployment=%s catalog_recipe=%s' \
    "${@:1:6}" "${7:-false}"
}

results() {
  local -A values=()
  local job override
  for job in "${result_jobs[@]}"; do
    values["$job"]="skipped"
  done
  for override in "$@"; do
    values["${override%%=*}"]="${override#*=}"
  done
  local output=""
  for job in "${result_jobs[@]}"; do
    output+="$job=${values[$job]} "
  done
  printf '%s' "${output% }"
}

expect_required_accept() {
  local label="$1" event="$2" plan_value="$3" results_value="$4"
  "$required" "$event" "$plan_value" "$results_value" >/dev/null || {
    printf 'Expected Required CI acceptance for %s\n' "$label" >&2
    exit 1
  }
}

expect_required_reject() {
  local label="$1" event="$2" plan_value="$3" results_value="$4"
  if "$required" "$event" "$plan_value" "$results_value" >/dev/null 2>&1; then
    printf 'Expected Required CI rejection for %s\n' "$label" >&2
    exit 1
  fi
}

complete_success="$(results changes=success quality=success catalog-contracts=success \
  build=success architecture=success coverage-policy=success \
  migrations-cameraagent=success \
  unit=success integration=success coverage=success)"
complete_plan_deployed="$(plan full true true true true true)"
complete_plan_undeployed="$(plan full true true true true false)"
event_plan="$(plan full true true true true true true)"
reduced_plan="$(plan reduced false false false false false)"
reduced_success="$(results changes=success quality=success)"
event_success="$(results changes=success quality=success catalog-contracts=success catalog-reproducibility=success \
  deployment-contracts=success build=success architecture=success coverage-policy=success \
  migrations-cameraagent=success \
  unit=success integration=success coverage=success)"
cameraagent_plan="$(plan full false false true false false)"
cameraagent_success="$(results changes=success quality=success catalog-contracts=success \
  build=success architecture=success coverage-policy=success \
  migrations-cameraagent=success cameraagent-component=success)"
shared_plan="$(plan full false true true true false)"
shared_success="$(results changes=success quality=success catalog-contracts=success \
  build=success architecture=success coverage-policy=success \
  migrations-cameraagent=success \
  shared-libraries=success cameraagent-component=success delivery-component=success)"
delivery_plan="$(plan full false false false true true)"
delivery_success="$(results changes=success quality=success catalog-contracts=success \
  deployment-contracts=success build=success architecture=success coverage-policy=success \
  migrations-cameraagent=success delivery-component=success)"
retired_jobs=(migrations-logichost logichost-component combined-integration)

run_required_ci_part_0() {
  local outcome job
  expect_required_accept "push complete matrix" push "$event_plan" "$event_success"
  expect_required_accept "merge-group complete matrix" merge_group "$event_plan" "$event_success"
  expect_required_accept "manual complete matrix" workflow_dispatch "$event_plan" "$event_success"
  expect_required_accept "pull request complete matrix" pull_request "$complete_plan_undeployed" "$complete_success"
  expect_required_accept "documentation-only reduced plan" pull_request "$reduced_plan" "$reduced_success"
  expect_required_accept "CameraAgent-only component plan" pull_request "$cameraagent_plan" "$cameraagent_success"
  expect_required_accept "shared contract component plan" pull_request "$shared_plan" "$shared_success"
  expect_required_accept "delivery component plan" pull_request "$delivery_plan" "$delivery_success"

  local catalog_scripts_plan catalog_fixtures_plan catalog_scripts_success catalog_fixtures_success reduced_catalog_plan
  catalog_scripts_plan="$(plan full true true true true true true)"
  catalog_fixtures_plan="$(plan full true true true true false true)"
  catalog_scripts_success="$(results changes=success quality=success catalog-contracts=success \
    catalog-reproducibility=success deployment-contracts=success build=success architecture=success \
    coverage-policy=success migrations-cameraagent=success \
    unit=success integration=success coverage=success)"
  catalog_fixtures_success="$(results changes=success quality=success catalog-contracts=success \
    catalog-reproducibility=success build=success architecture=success \
    coverage-policy=success migrations-cameraagent=success \
    unit=success integration=success coverage=success)"
  expect_required_accept "catalog builder change" pull_request "$catalog_scripts_plan" "$catalog_scripts_success"
  expect_required_accept "catalog fixture change" pull_request "$catalog_fixtures_plan" "$catalog_fixtures_success"
  for outcome in failure cancelled skipped; do
    expect_required_reject "catalog-reproducibility=$outcome in a catalog builder plan" pull_request \
      "$catalog_scripts_plan" "${catalog_scripts_success/catalog-reproducibility=success/catalog-reproducibility=$outcome}"
    expect_required_reject "catalog-reproducibility=$outcome in a catalog fixture plan" pull_request \
      "$catalog_fixtures_plan" "${catalog_fixtures_success/catalog-reproducibility=success/catalog-reproducibility=$outcome}"
    expect_required_reject "catalog-reproducibility=$outcome on a push" push "$event_plan" \
      "${event_success/catalog-reproducibility=success/catalog-reproducibility=$outcome}"
  done
  expect_required_reject "catalog-reproducibility=success in an unselected complete plan" pull_request \
    "$complete_plan_deployed" "$catalog_scripts_success"
  expect_required_reject "catalog-reproducibility=success in an unselected undeployed plan" pull_request \
    "$complete_plan_undeployed" "$catalog_fixtures_success"
  reduced_catalog_plan="$(plan reduced false false false false false true)"
  expect_required_accept "documentation-only plan naming a catalog-recipe path" pull_request \
    "$reduced_catalog_plan" "$reduced_success"
  for outcome in success failure cancelled; do
    expect_required_reject "catalog-reproducibility=$outcome in a reduced plan" pull_request \
      "$reduced_catalog_plan" "$(results changes=success quality=success "catalog-reproducibility=$outcome")"
  done

  for job in changes quality catalog-contracts build architecture coverage-policy \
    migrations-cameraagent cameraagent-component; do
    for outcome in failure cancelled skipped; do
      expect_required_reject "$job=$outcome in the CameraAgent plan" pull_request "$cameraagent_plan" \
        "${cameraagent_success/$job=success/$job=$outcome}"
    done
  done

  for job in unit integration coverage \
    delivery-component shared-libraries deployment-contracts catalog-reproducibility; do
    for outcome in failure cancelled success; do
      expect_required_reject "unexpected $job=$outcome in the CameraAgent plan" pull_request "$cameraagent_plan" \
        "${cameraagent_success/$job=skipped/$job=$outcome}"
    done
  done
}

run_required_ci_part_1() {
  local event_value flag job consumer entry label plan_value
  for event_value in pull_request merge_group push; do
    for flag in logichost combined; do
      expect_required_reject "stale $flag flag on $event_value" "$event_value" \
        "$event_plan $flag=true" "$event_success"
    done
    for job in "${retired_jobs[@]}"; do
      expect_required_reject "stale $job result on $event_value" "$event_value" \
        "$event_plan" "$event_success $job=skipped"
    done
  done

  expect_required_reject "cancelled unit in the complete matrix" pull_request "$complete_plan_undeployed" \
    "$(results changes=success quality=success catalog-contracts=success build=success \
      architecture=success coverage-policy=success migrations-cameraagent=success \
      unit=cancelled integration=success coverage=success)"
  for consumer in cameraagent delivery; do
    expect_required_reject "shared plan dropping the $consumer lane" pull_request \
      "${shared_plan/$consumer=true/$consumer=false}" \
      "${shared_success/$consumer-component=success/$consumer-component=skipped}"
  done
  expect_required_reject "missing deployment contracts result" pull_request "$complete_plan_deployed" \
    "$(results changes=success quality=success catalog-contracts=success build=success \
      architecture=success coverage-policy=success migrations-cameraagent=success \
      unit=success integration=success coverage=success)"

  local -a invalid_plans=(
    "reduced|$(plan reduced false false false false false true)|push"
    "complete on a reduced mode|$(plan reduced true true true true false)|pull_request"
    "reduced with a component lane|$(plan reduced false false true false false)|pull_request"
    "reduced with deployment contracts|$(plan reduced false false false false true)|pull_request"
    "full without any selection|$(plan full false false false false false)|pull_request"
    "complete without every lane|$(plan full true true true false false)|pull_request"
    "unknown mode|$(plan unknown false false true false false)|pull_request"
    "non-boolean flag|$(plan full maybe false true false false)|pull_request"
    "push without the complete matrix|$(plan full false false true false true true)|push"
    "push without deployment contracts|$(plan full true true true true false true)|push"
  )
  for entry in "${invalid_plans[@]}"; do
    IFS='|' read -r label plan_value event_value <<< "$entry"
    expect_required_reject "$label" "$event_value" "$plan_value" "$complete_success"
  done
  for event_value in push merge_group workflow_dispatch; do
    expect_required_reject "$event_value without the catalog-recipe selection, job skipped" "$event_value" \
      "$complete_plan_deployed" "${event_success/catalog-reproducibility=success/catalog-reproducibility=skipped}"
    expect_required_reject "$event_value without the catalog-recipe selection, job run" "$event_value" \
      "$complete_plan_deployed" "$event_success"
  done
  expect_required_reject "non-boolean catalog-recipe flag" pull_request \
    "$(plan full false false true false false maybe)" "$cameraagent_success"
  expect_required_reject "plan without the catalog-recipe key" pull_request \
    "${cameraagent_plan/ catalog_recipe=false/}" "$cameraagent_success"
  expect_required_reject "missing plan key" pull_request \
    "mode=full complete=false shared=false cameraagent=true delivery=false" \
    "$cameraagent_success"
  expect_required_reject "unknown plan key" pull_request \
    "$cameraagent_plan extra=true" "$cameraagent_success"
  expect_required_reject "duplicate plan key" pull_request \
    "$cameraagent_plan mode=reduced" "$cameraagent_success"
  expect_required_reject "missing job result" pull_request "$cameraagent_plan" \
    "${cameraagent_success/ delivery-component=skipped/}"
  expect_required_reject "unknown job result" pull_request "$cameraagent_plan" \
    "$cameraagent_success migrations=success"
  expect_required_reject "unusable job result" pull_request "$cameraagent_plan" \
    "${cameraagent_success/cameraagent-component=success/cameraagent-component=neutral}"
  expect_required_reject "empty plan" pull_request "" "$cameraagent_success"
  expect_required_reject "empty results" pull_request "$cameraagent_plan" ""
}

# Force the membership producer past pipe capacity. Each list runs in its own
# isolated directory so mode (3 iterations) and changes (3 iterations) run in parallel.
expect_required_no_sigpipe() (
  local first="$1" iteration sig_dir="$parallel_dir/sigpipe.$1"
  mkdir -p "$sig_dir"
  "$required" pull_request "$reduced_plan" "$reduced_success" > "$sig_dir/expected"
  # shellcheck disable=SC2317 # Child Bash invokes this exported printf shim.
  printf() {
    if [[ "${1-}" == '%s\n' && " ${*:2} " == *" $HVO_SIGPIPE_LIST_FIRST "* ]]; then
      if [[ ! -s "$HVO_SIGPIPE_RECORDS" ]]; then
        local -a records=("${@:2}")
        local bytes=0 record
        for record in "${records[@]}"; do
          ((bytes += ${#record} + 1))
        done
        # Just exceed twice a 64 KiB pipe; build once and reuse across checks.
        while (( bytes <= 2 * 65536 )); do
          records+=("${records[@]}")
          ((bytes *= 2))
        done
        builtin printf '%s\n' "${records[@]}" > "$HVO_SIGPIPE_RECORDS"
      fi
      builtin printf x >> "$HVO_SIGPIPE_FIRED"
      cat "$HVO_SIGPIPE_RECORDS"
    else
      # shellcheck disable=SC2059 # Forward the caller's format and arguments unchanged.
      builtin printf "$@"
    fi
  }
  export -f printf
  export HVO_SIGPIPE_LIST_FIRST="$first"
  export HVO_SIGPIPE_RECORDS="$sig_dir/records"
  export HVO_SIGPIPE_FIRED="$sig_dir/fired"
  for ((iteration = 1; iteration <= 3; iteration++)); do
    : > "$HVO_SIGPIPE_FIRED"
    if ! "$required" pull_request "$reduced_plan" "$reduced_success" \
      > "$sig_dir/out" 2> "$sig_dir/err"; then
      cat "$sig_dir/err" >&2
      printf 'Required CI SIGPIPE regression failed: list=%s iteration=%s/3\n' "$first" "$iteration" >&2
      return 1
    fi
    if [[ ! -s "$HVO_SIGPIPE_FIRED" ]]; then
      printf 'Required CI SIGPIPE shim did not fire: list=%s iteration=%s/3\n' "$first" "$iteration" >&2
      return 1
    fi
    if ! cmp -s "$sig_dir/expected" "$sig_dir/out" || [[ -s "$sig_dir/err" ]]; then
      printf 'Required CI SIGPIPE regression changed output: list=%s iteration=%s/3\n' "$first" "$iteration" >&2
      return 1
    fi
  done
)

run_workflow_shape() {
  local suite
  for suite in catalog installer; do
    grep -Fq "if: needs.changes.outputs.deployment_$suite == 'true'" "$workflow" || {
      printf 'Exhaustive deployment suite is not controlled by its classifier output: %s\n' "$suite" >&2
      exit 1
    }
  done
  extract_workflow_job() {
    local target="$1" line job_name capturing=false
    while IFS= read -r line; do
      if [[ "$line" =~ ^[[:space:]]{2}([a-z0-9-]+):[[:space:]]*$ ]]; then
        job_name="${BASH_REMATCH[1]}"
        if [[ "$capturing" == true ]]; then
          break
        fi
        if [[ "$job_name" == "$target" ]]; then
          capturing=true
        fi
      fi
      if [[ "$capturing" == true ]]; then
        printf '%s\n' "$line"
      fi
    done < "$workflow"
  }

  local deployment_job changes_job output required_job job key draft_failure_step step_name non_draft_step
  local evidence_step evidence_condition job_body architecture_job badges_job badge_continue_count badge_patch_count badge_file
  deployment_job="$(extract_workflow_job deployment-contracts)"
  grep -Fq './scripts/test:silo-runtime-qualification' <<< "$deployment_job" || {
    printf 'Deployment Contracts must run the stock Silo qualifier containment test.\n' >&2
    exit 1
  }
  grep -Fq 'types: [opened, synchronize, reopened, ready_for_review, converted_to_draft]' "$workflow" || {
    printf 'Pull request CI must follow ready/draft review transitions.\n' >&2
    exit 1
  }
  changes_job="$(extract_workflow_job changes)"
  grep -Fxq "    if: github.event_name != 'pull_request' || github.event.pull_request.draft == false" <<< "$changes_job" || {
    printf 'Draft pull requests must not start the classifier-selected CI plan.\n' >&2
    exit 1
  }
  for output in mode deployment complete shared cameraagent delivery catalog_recipe; do
    # shellcheck disable=SC2016 # The workflow expression is intentionally literal.
    grep -Fq "      $output: \${{ steps.classify.outputs.$output }}" <<< "$changes_job" || {
      printf 'Change Classification must publish the %s plan output.\n' "$output" >&2
      exit 1
    }
  done

  required_job="$(extract_workflow_job required)"
  grep -Fxq '    name: Required CI' <<< "$required_job" || {
    printf 'The protected check name must remain Required CI.\n' >&2
    exit 1
  }
  grep -Fxq '    if: always()' <<< "$required_job" || {
    printf 'Required CI must report a conclusion for every pull request head.\n' >&2
    exit 1
  }
  for job in "${result_jobs[@]}"; do
    grep -Fq "$job," <<< "$required_job" || grep -Fq "$job]" <<< "$required_job" || {
      printf 'Required CI does not depend on the aggregated job: %s\n' "$job" >&2
      exit 1
    }
    # shellcheck disable=SC2016 # The workflow expression is intentionally literal.
    grep -Fq "            $job=\${{ needs.$job.result }}" <<< "$required_job" || {
      printf 'Required CI does not forward the result of: %s\n' "$job" >&2
      exit 1
    }
  done
  for key in mode complete shared cameraagent delivery deployment catalog_recipe; do
    # shellcheck disable=SC2016 # The workflow expression is intentionally literal.
    grep -Fq "            $key=\${{ needs.changes.outputs.$key }}" <<< "$required_job" || {
      printf 'Required CI does not forward the plan key: %s\n' "$key" >&2
      exit 1
    }
  done
  grep -Fq './scripts/ci:require "$EVENT_NAME" "$PLAN" "$RESULTS"' <<< "$required_job" || {
    printf 'Required CI must aggregate through the plan-derived contract script.\n' >&2
    exit 1
  }
  draft_failure_step=$'      - name: Block merge while review is in progress\n        if: github.event_name == '\''pull_request'\'' && github.event.pull_request.draft == true\n        run: |\n          echo '\''Required CI is intentionally blocked while the pull request is draft.'\'' >&2\n          exit 1'
  grep -Fq "$draft_failure_step" <<< "$required_job" || {
    printf 'Draft Required CI must fail closed rather than conclude skipped.\n' >&2
    exit 1
  }
  for step_name in 'Checkout' 'Require every current-head gate'; do
    non_draft_step=$'      - name: '"$step_name"$'\n        if: github.event_name != '\''pull_request'\'' || github.event.pull_request.draft == false'
    grep -Fq "$non_draft_step" <<< "$required_job" || {
      printf 'Required CI step must run only for a non-draft head: %s\n' "$step_name" >&2
      exit 1
    }
  done
  for evidence_step in 'Bind deployment contract evidence' 'Upload deployment contract logs'; do
    evidence_condition="$(sed -n "/      - name: $evidence_step/{n;p;}" "$workflow")"
    [[ "$evidence_condition" == '        if: always()' ]] || {
      printf 'Deployment evidence must survive lightweight failures without exhaustive shard selection: %s\n' "$evidence_step" >&2
      exit 1
    }
  done

  for job in catalog-contracts build architecture coverage-policy \
    migrations-cameraagent; do
    job_body="$(extract_workflow_job "$job")"
    grep -Fxq "    if: needs.changes.outputs.mode == 'full'" <<< "$job_body" || {
      printf 'Cross-cutting gate must run for every full-mode head: %s\n' "$job" >&2
      exit 1
    }
  done

  for job in "${retired_jobs[@]}"; do
    if grep -Fq "$job" "$workflow"; then
      printf 'Full CI still references a retired job: %s\n' "$job" >&2
      exit 1
    fi
  done
  if grep -Eq 'outputs\.(logichost|combined)|publish/logichost|logichost\.sha256|/(cameraagent-)?logichost/\*/coverage\.cobertura\.xml' "$workflow"; then
    printf 'Full CI still references retired outputs, publish evidence, or coverage slots.\n' >&2
    exit 1
  fi
  if grep -Eq 'dotnet test tests/HVO\.SkyMonitor\.(CameraAgent\.)?LogicHost\.' "$workflow"; then
    printf 'Full CI must not invoke a retired LogicHost test project.\n' >&2
    exit 1
  fi

  architecture_job="$(extract_workflow_job architecture)"
  grep -Fq 'tests/HVO.SkyMonitor.Architecture.Tests/HVO.SkyMonitor.Architecture.Tests.csproj --no-build --configuration Release --filter "$UNIT_FILTER"' <<< "$architecture_job" || {
    printf 'Architecture & Publish must run the Architecture Unit selection.\n' >&2
    exit 1
  }
  grep -Fq 'tests/HVO.SkyMonitor.Architecture.Tests/HVO.SkyMonitor.Architecture.Tests.csproj --no-build --configuration Release --filter "TestCategory=Integration&FullyQualifiedName~ArchitectureBoundaryTests"' <<< "$architecture_job" || {
    printf 'Architecture & Publish must run the Architecture Integration selection.\n' >&2
    exit 1
  }
  for job in unit integration coverage; do
    job_body="$(extract_workflow_job "$job")"
    grep -Fxq "    if: needs.changes.outputs.complete == 'true'" <<< "$job_body" || {
      printf 'Complete solution gate must follow the complete classifier output: %s\n' "$job" >&2
      exit 1
    }
  done

  badges_job="$(extract_workflow_job badges)"
  grep -Fxq "    if: github.ref == 'refs/heads/main'" <<< "$badges_job" || {
    printf 'Coverage badges must publish only from main.\n' >&2
    exit 1
  }
  grep -Fxq '    permissions: {}' <<< "$badges_job" || {
    printf 'Coverage badge publication must not receive repository permissions.\n' >&2
    exit 1
  }
  # shellcheck disable=SC2016 # The workflow expressions are intentionally literal.
  grep -Fq 'BADGE_GIST_TOKEN: ${{ secrets.GIST_TOKEN }}' <<< "$badges_job" || {
    printf 'Coverage badge publication must use the repository GIST_TOKEN secret.\n' >&2
    exit 1
  }
  # shellcheck disable=SC2016 # The workflow expressions are intentionally literal.
  grep -Fq 'BADGE_GIST_ID: ${{ vars.COVERAGE_GIST_ID }}' <<< "$badges_job" || {
    printf 'Coverage badge publication must use the public repository Gist ID variable.\n' >&2
    exit 1
  }
  if grep -Fq 'secrets.COVERAGE_GIST_ID' <<< "$badges_job"; then
    printf 'The public coverage Gist ID must not be stored as a secret.\n' >&2
    exit 1
  fi
  badge_continue_count="$(grep -Fc 'continue-on-error: true' <<< "$badges_job" || true)"
  if (( badge_continue_count != 1 )); then
    printf 'Only the bounded coverage badge publication step must be best-effort.\n' >&2
    exit 1
  fi
  grep -Fq -- '--connect-timeout 10' <<< "$badges_job" || {
    printf 'Coverage badge publication must bound the Gist connection attempt.\n' >&2
    exit 1
  }
  grep -Fq -- '--max-time 45' <<< "$badges_job" || {
    printf 'Coverage badge publication must bound each Gist transfer.\n' >&2
    exit 1
  }
  grep -Fq -- '--retry-max-time 120' <<< "$badges_job" || {
    printf 'Coverage badge publication must bound its retry window below the job timeout.\n' >&2
    exit 1
  }
  badge_patch_count="$(grep -Fc -- '--request PATCH' <<< "$badges_job" || true)"
  if (( badge_patch_count != 1 )); then
    printf 'Coverage badge publication must use one atomic Gist PATCH request.\n' >&2
    exit 1
  fi
  for badge_file in coverage-line.json coverage-branch.json; do
    grep -Fq "\"$badge_file\": {content:" <<< "$badges_job" || {
      printf 'Atomic coverage badge payload is missing %s.\n' "$badge_file" >&2
      exit 1
    }
  done
  grep -Fq 'https://api.github.com/gists/$BADGE_GIST_ID' <<< "$badges_job" || {
    printf 'Coverage badge publication must use the configured Gist API endpoint.\n' >&2
    exit 1
  }
  grep -Fq 'curl --disable --config -' <<< "$badges_job" || {
    printf 'Coverage badge publication must disable ambient curl configuration before loading the token.\n' >&2
    exit 1
  }
  grep -Fq 'header = "Authorization: Bearer %s"' <<< "$badges_job" || {
    printf 'Coverage badge publication must keep the credential out of process arguments.\n' >&2
    exit 1
  }
  grep -Fq 'line <= 100 && branch <= 100' <<< "$badges_job" || {
    printf 'Coverage badge publication must reject percentages above 100.\n' >&2
    exit 1
  }
  # shellcheck disable=SC2016 # Workflow shell variables are intentionally literal.
  grep -Fq -- '--argjson line "$line_badge"' <<< "$badges_job" || {
    printf 'Coverage badge publication must verify the complete returned line badge.\n' >&2
    exit 1
  }
  # shellcheck disable=SC2016 # Workflow shell variables are intentionally literal.
  grep -Fq -- '--argjson branch "$branch_badge"' <<< "$badges_job" || {
    printf 'Coverage badge publication must verify the complete returned branch badge.\n' >&2
    exit 1
  }
  # shellcheck disable=SC2016 # Workflow shell variables are intentionally literal.
  grep -Fq '(.files["coverage-line.json"].content | fromjson) == $line' <<< "$badges_job" || {
    printf 'Coverage badge publication must compare the complete returned line document.\n' >&2
    exit 1
  }
  # shellcheck disable=SC2016 # Workflow shell variables are intentionally literal.
  grep -Fq '(.files["coverage-branch.json"].content | fromjson) == $branch' <<< "$badges_job" || {
    printf 'Coverage badge publication must compare the complete returned branch document.\n' >&2
    exit 1
  }
  if grep -Fq 'dynamic-badges-action' <<< "$badges_job"; then
    printf 'Coverage badge publication must use the bounded first-party API request.\n' >&2
    exit 1
  fi
  grep -Fq 'Report unconfigured coverage badge publication' <<< "$badges_job" || {
    printf 'Missing badge configuration must produce an explicit warning.\n' >&2
    exit 1
  }
  grep -Fq 'Report coverage badge publication failure' <<< "$badges_job" || {
    printf 'Failed badge publication must produce an explicit warning.\n' >&2
    exit 1
  }

  job_body="$(extract_workflow_job migrations-cameraagent)"
  grep -Fq './scripts/ci:canonical-migration cameraagent' <<< "$job_body" || {
    printf 'CameraAgent migration gate must enforce its canonical migration.\n' >&2
    exit 1
  }

  local -A lane_jobs=(
    [shared]=shared-libraries
    [cameraagent]=cameraagent-component
    [delivery]=delivery-component
  )
  local component lane_slot_count slot
  for component in "${!lane_jobs[@]}"; do
    job_body="$(extract_workflow_job "${lane_jobs[$component]}")"
    grep -Fxq "    if: needs.changes.outputs.complete == 'false' && needs.changes.outputs.$component == 'true'" <<< "$job_body" || {
      printf 'Component lane must follow its classifier output without duplicating the complete matrix: %s\n' "$component" >&2
      exit 1
    }
    grep -Fq "./scripts/ci:component-build $component" <<< "$job_body" || {
      printf 'Component lane must restore and build from its own project roots: %s\n' "$component" >&2
      exit 1
    }
    grep -Fq "./scripts/coverage:component $component" <<< "$job_body" || {
      printf 'Component lane must enforce its own coverage baseline: %s\n' "$component" >&2
      exit 1
    }
    grep -Fq "./scripts/ci:component-publish $component" <<< "$job_body" || {
      printf 'Component lane must publish its own shipping outputs: %s\n' "$component" >&2
      exit 1
    }
    [[ -f "$repo_root/scripts/coverage/baseline.$component.json" ]] || {
      printf 'Component lane has no coverage baseline: %s\n' "$component" >&2
      exit 1
    }
    lane_slot_count=0
    while IFS= read -r slot; do
      ((lane_slot_count += 1))
      grep -Fq -- "--results-directory $slot " <<< "$job_body" || {
        printf 'Component lane %s does not produce its expected coverage slot: %s\n' "$component" "$slot" >&2
        exit 1
      }
    done < <("$repo_root/scripts/coverage:component" --list-slots "$component")
    (( lane_slot_count > 0 )) || {
      printf 'Component lane declares no coverage slot: %s\n' "$component" >&2
      exit 1
    }
  done

  if [[ "$("$repo_root/scripts/coverage:component" --list-components)" != $'shared\ncameraagent\ndelivery' ]]; then
    printf 'Coverage component inventory must match the three active lanes.\n' >&2
    exit 1
  fi
  local -A slot_owner=()
  local slot_count=0
  while IFS= read -r component; do
    while IFS= read -r slot; do
      ((slot_count += 1))
      if [[ -n "${slot_owner[$slot]:-}" ]]; then
        printf 'Coverage slot %s is claimed by both %s and %s\n' "$slot" "${slot_owner[$slot]}" "$component" >&2
        exit 1
      fi
      slot_owner["$slot"]="$component"
      if ! grep -Fq "'$slot/*/coverage.cobertura.xml'" "$workflow"; then
        printf 'Component coverage slot is missing from the aggregate rollup: %s\n' "$slot" >&2
        exit 1
      fi
    done < <("$repo_root/scripts/coverage:component" --list-slots "$component")
  done < <("$repo_root/scripts/coverage:component" --list-components)
  if (( slot_count != 17 )); then
    printf 'Expected 17 component coverage slots across the three active lanes, found %s.\n' "$slot_count" >&2
    exit 1
  fi

  local component_fixture="$parallel_dir/component-entry-points"
  mkdir -p "$component_fixture"/{scripts,bin}
  cp -p "$repo_root/scripts/"{ci:component-build,ci:component-publish,coverage:component,ci:canonical-migration} \
    "$component_fixture/scripts/"
  printf '#!/usr/bin/env bash\ntouch dotnet-invoked\nexit 99\n' > "$component_fixture/bin/dotnet"
  chmod +x "$component_fixture/bin/dotnet"
  expect_invalid_component() {
    local status=0
    (cd "$component_fixture" && PATH="$component_fixture/bin:$PATH" "$@") \
      >"$component_fixture/output" 2>&1 || status=$?
    if [[ "$status" != 2 || -e "$component_fixture/dotnet-invoked" || -e "$component_fixture/TestResults" ]]; then
      printf 'Expected usage error without invoking .NET or writing results: %s\n' "$*" >&2
      cat "$component_fixture/output" >&2
      exit 1
    fi
  }
  for component in logichost combined; do
    expect_invalid_component ./scripts/ci:component-build "$component" --list-projects
    expect_invalid_component ./scripts/ci:component-build "$component"
    expect_invalid_component ./scripts/ci:component-publish "$component"
    expect_invalid_component ./scripts/coverage:component --list-slots "$component"
    expect_invalid_component ./scripts/coverage:component "$component"
    [[ ! -e "$repo_root/scripts/coverage/baseline.$component.json" ]] || {
      printf 'Retired coverage baseline still exists: %s\n' "$component" >&2
      exit 1
    }
  done
  expect_invalid_component ./scripts/ci:canonical-migration logichost

  local catalog_reproducibility_job catalog_contracts_job previous_step_line catalog_step step_match
  catalog_reproducibility_job="$(extract_workflow_job catalog-reproducibility)"
  grep -Fxq "    if: needs.changes.outputs.mode == 'full' && needs.changes.outputs.catalog_recipe == 'true'" \
    <<< "$catalog_reproducibility_job" || {
    printf 'Catalog Reproducibility must run for exactly the full-mode heads that change a catalog recipe.\n' >&2
    exit 1
  }
  grep -Fxq '    needs: changes' <<< "$catalog_reproducibility_job" || {
    printf 'Catalog Reproducibility must not wait for, or be waited for by, the catalog contracts artifact.\n' >&2
    exit 1
  }
  if grep -Fq 'continue-on-error' <<< "$catalog_reproducibility_job"; then
    printf 'A failed catalog reproducibility step must fail its job.\n' >&2
    exit 1
  fi
  # shellcheck disable=SC2016 # The workflow's own shell variables are matched literally.
  local -a catalog_reproducibility_steps=(
    '        run: ./scripts/catalog/test-sqlite-identity.sh'
    '        run: ./scripts/catalog/test-fixture-reproducibility.sh'
    '        run: ./scripts/catalog/fetch-hyg-v44-openngc-inputs.sh "$RUNNER_TEMP/hyg-v44-openngc-inputs"'
    '        run: ./scripts/catalog/test-fetch-hyg-v44-openngc-inputs.sh "$RUNNER_TEMP/hyg-v44-openngc-inputs"'
    '          ./scripts/catalog/test-hyg-v44-reproducibility.sh \'
    '            "$RUNNER_TEMP/hyg-v44-openngc-inputs/hyg_v44.csv.gz" \'
    '            "$RUNNER_TEMP/hyg-v44-openngc-inputs/OpenNGC"'
  )
  previous_step_line=0
  for catalog_step in "${catalog_reproducibility_steps[@]}"; do
    step_match="$(grep -nFx -m 1 -- "$catalog_step" <<< "$catalog_reproducibility_job" || true)"
    [[ -n "$step_match" ]] || {
      printf 'Catalog Reproducibility is missing the step line: %s\n' "$catalog_step" >&2
      exit 1
    }
    (( ${step_match%%:*} > previous_step_line )) || {
      printf 'Catalog Reproducibility runs a step out of order: %s\n' "$catalog_step" >&2
      exit 1
    }
    previous_step_line="${step_match%%:*}"
  done

  catalog_contracts_job="$(extract_workflow_job catalog-contracts)"
  # shellcheck disable=SC2016 # The workflow's own shell variables are matched literally.
  local -a catalog_contracts_steps=(
    '          catalog_root="$RUNNER_TEMP/hyg-v42-contracts"'
    '          ./scripts/catalog/prepare-hyg-v42-contracts.sh "$catalog_root" >/dev/null'
    '        run: ./scripts/catalog/test-hyg-v42-reproducibility.sh "$RUNNER_TEMP/hyg-v42-contracts/build/hyg_v42.csv.gz"'
    '      - name: Upload exact production catalog contracts'
  )
  previous_step_line=0
  for catalog_step in "${catalog_contracts_steps[@]}"; do
    step_match="$(grep -nFx -m 1 -- "$catalog_step" <<< "$catalog_contracts_job" || true)"
    [[ -n "$step_match" ]] || {
      printf 'Catalog Contracts is missing the step line: %s\n' "$catalog_step" >&2
      exit 1
    }
    (( ${step_match%%:*} > previous_step_line )) || {
      printf 'Catalog Contracts runs a step out of order: %s\n' "$catalog_step" >&2
      exit 1
    }
    previous_step_line="${step_match%%:*}"
  done
  if grep -Fq 'continue-on-error' <<< "$catalog_contracts_job"; then
    printf 'A failed HYG 4.2 reproducibility step must fail Catalog Contracts.\n' >&2
    exit 1
  fi
  if grep -Eq -- '--fetch|curl|wget|https?://' "$repo_root/scripts/catalog/test-hyg-v42-reproducibility.sh"; then
    printf 'The HYG 4.2 reproducibility regression must stay offline.\n' >&2
    exit 1
  fi

  local catalog_job_script_count=0 catalog_job_script
  while IFS= read -r catalog_job_script; do
    ((catalog_job_script_count += 1))
    [[ -f "$repo_root/$catalog_job_script" && -x "$repo_root/$catalog_job_script" ]] || {
      printf 'A catalog job runs a script that is missing or not executable: %s\n' "$catalog_job_script" >&2
      exit 1
    }
  done < <(printf '%s\n' "$catalog_contracts_job" "$catalog_reproducibility_job" |
    grep -oE 'scripts/catalog/[A-Za-z0-9._-]+\.sh' | sort -u)
  if (( catalog_job_script_count != 8 )); then
    printf 'Expected 8 catalog job scripts across the two catalog jobs, found %s.\n' "$catalog_job_script_count" >&2
    exit 1
  fi

  local development_workflow="$repo_root/.github/workflows/development-v1.yml"
  if grep -Eq 'reproducibility|fetch-hyg-v44-openngc-inputs|test-sqlite-identity|catalog_recipe' "$development_workflow"; then
    printf 'The catalog reproducibility regressions must stay out of the development/v1 profile.\n' >&2
    exit 1
  fi

  local release_workflow="$repo_root/.github/workflows/release.yml"
  grep -Fxq '    uses: ./.github/workflows/ci.yml' "$release_workflow" || {
    printf 'Release qualification must call the CI workflow (workflow_call).\n' >&2
    exit 1
  }
  grep -Fxq '    needs: [gate, ci]' "$release_workflow" || {
    printf 'The release must build only after the CI qualification.\n' >&2
    exit 1
  }
  grep -Fxq '  workflow_call:' "$repo_root/.github/workflows/ci.yml" || {
    printf 'The CI workflow must be callable by the release workflow.\n' >&2
    exit 1
  }
}

run_harness_signal_cleanup() {
  python3 - "$repo_root/scripts/test:ci-classification" <<'PY'
import os
import pathlib
import shutil
import signal
import subprocess
import sys
import tempfile
import time

script_path = pathlib.Path(sys.argv[1])
script_text = script_path.read_text()
if "\nresult_jobs=(\n" not in script_text:
    raise SystemExit("Unable to locate parallel harness preamble boundary")
preamble = script_text.split("\nresult_jobs=(\n", 1)[0]
fork_marker = "    ) </dev/null &\n"
if preamble.count(fork_marker) != 1:
    raise SystemExit(f"Expected 1 worker fork marker in harness preamble, found {preamble.count(fork_marker)}")
cleanup_marker = "cleanup() {\n  trap '' INT TERM\n"
if preamble.count(cleanup_marker) != 1:
    raise SystemExit(
        f"Expected 1 cleanup trap-disarm marker in harness preamble, found {preamble.count(cleanup_marker)}"
    )
cleanup_probe = (
    "cleanup() {\n"
    '  if [[ -n "${HVO_CLEANUP_TRAP_LOG:-}" ]]; then\n'
    '    trap -p INT TERM > "$HVO_CLEANUP_TRAP_LOG"\n'
    "  fi\n"
    "  trap '' INT TERM\n"
)
instrumented_preamble = preamble.replace(cleanup_marker, cleanup_probe, 1)

active = {"proc": None, "worker_pgid": None, "probe_dir": None, "resume_fd": None}


def pgid_survivors(pgid):
    alive = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            stat = pathlib.Path(f"/proc/{entry}/stat").read_text()
            after = stat.rsplit(")", 1)[1].split()
            state, pgrp = after[0], int(after[2])
            if pgrp == pgid and state not in ("Z", "X"):
                alive.append(int(entry))
        except OSError:
            pass
    return alive


def _pid_pgrp(pid):
    try:
        return os.getpgid(pid)
    except OSError:
        return None


def _child_pgids(parent_pid, skip_pgrp):
    pgids = set()
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            stat = pathlib.Path(f"/proc/{entry}/stat").read_text()
            after = stat.rsplit(")", 1)[1].split()
            state, ppid, pgrp = after[0], int(after[1]), int(after[2])
            if ppid == parent_pid and state not in ("Z", "X") and pgrp > 0 and pgrp != skip_pgrp:
                pgids.add(pgrp)
        except (OSError, ValueError, IndexError):
            pass
    return pgids


def _collect_worker_pgids(skip_pgrp):
    pgids = set()
    recorded_pgid = active["worker_pgid"]
    if recorded_pgid is not None and recorded_pgid > 0 and recorded_pgid != skip_pgrp:
        pgids.add(recorded_pgid)
    proc = active["proc"]
    if proc is not None and proc.poll() is None:
        pgids.update(_child_pgids(proc.pid, skip_pgrp))
    probe_dir = active["probe_dir"]
    if probe_dir is not None:
        for name in ("worker.pid", "worker.pid.tmp", "worker.pids", "nested.pids"):
            path = probe_dir / name
            try:
                tokens = path.read_text().split()
            except OSError:
                continue
            for tok in tokens:
                try:
                    pid = int(tok)
                except ValueError:
                    continue
                if pid <= 0 or pid == os.getpid():
                    continue
                if proc is not None and pid == proc.pid:
                    continue
                if name in ("worker.pid", "worker.pid.tmp") and pid != skip_pgrp:
                    pgids.add(pid)
                pgrp = _pid_pgrp(pid)
                if pgrp is not None and pgrp > 0 and pgrp != skip_pgrp:
                    pgids.add(pgrp)
    return pgids


def _abort_hook():
    if active["resume_fd"] is not None:
        try:
            os.write(active["resume_fd"], b"abort\n")
        except OSError:
            pass


def _cleanup_active():
    my_pgrp = os.getpgrp()
    pgids = _collect_worker_pgids(my_pgrp)
    proc = active["proc"]
    if proc is not None and proc.poll() is None:
        try:
            proc.terminate()
        except Exception:
            pass
        _abort_hook()
        # Resume a stopped hook once TERM is pending and the abort is buffered.
        try:
            proc.send_signal(signal.SIGCONT)
        except OSError:
            pass
        try:
            proc.wait(timeout=1.5)
        except Exception:
            try:
                proc.kill()
                proc.wait(timeout=2)
            except Exception:
                pass
    else:
        _abort_hook()
    pgids.update(_collect_worker_pgids(my_pgrp))
    if pgids:
        deadline = time.monotonic() + 1.0
        while True:
            any_alive = False
            for pgid in pgids:
                if pgid_survivors(pgid):
                    any_alive = True
                    try:
                        os.killpg(pgid, signal.SIGKILL)
                    except OSError:
                        pass
            if not any_alive or time.monotonic() >= deadline:
                break
            time.sleep(0.01)


def _on_signal(signum, _frame):
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    _cleanup_active()
    raise SystemExit(128 + signum)


signal.signal(signal.SIGTERM, _on_signal)
signal.signal(signal.SIGINT, _on_signal)

# Exercise an abort write after the reader closes.
read_fd, write_fd = os.pipe()
os.close(read_fd)
active["resume_fd"] = write_fd
try:
    _abort_hook()
finally:
    active["resume_fd"] = None
    os.close(write_fd)


def parse_hook_state(state_path):
    if not state_path.exists():
        return None
    result = {}
    for line in state_path.read_text().splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            result[key] = value
    return result


def assert_traps_disarmed(log_path, context):
    if not log_path.exists():
        raise SystemExit(f"{context}: cleanup trap log missing ({log_path})")
    lines = [line.strip() for line in log_path.read_text().splitlines() if line.strip()]
    expected = {"trap -- '' SIGINT", "trap -- '' SIGTERM"}
    if set(lines) != expected:
        raise SystemExit(
            f"{context}: expected INT and TERM traps already disarmed when cleanup() begins, "
            f"saw {lines!r}"
        )


worker_body = """
run_probe_worker() {
  sleep 60 &
  local c1="$!"
  (
    sleep 60 &
    printf '%d %d\\n' "$BASHPID" "$!" > "$HVO_PROBE_DIR/nested.pids"
    wait
  ) &
  while [[ ! -s "$HVO_PROBE_DIR/nested.pids" ]]; do
    sleep 0.01
  done
  printf '%d %d\\n' "$BASHPID" "$c1" > "$HVO_PROBE_DIR/worker.pids"
  : > "$HVO_PROBE_DIR/worker_ready.flag"
  wait
}
start_parallel_job probe_worker run_probe_worker
wait_parallel_jobs
"""

root_dir = pathlib.Path(tempfile.mkdtemp(prefix="hvo-sig-"))
try:
    # 1. Signal deferral after fork, including outer cleanup before the hook opens its FIFO.
    for label, sig, expected_rc in (
        ("window-sigterm", signal.SIGTERM, 143),
        ("window-sigint", signal.SIGINT, 130),
        ("early-abort", signal.SIGTERM, 97),
    ):
        early_abort = label == "early-abort"
        case_dir = root_dir / label
        case_tmp = case_dir / "tmp"
        probe_dir = case_dir / "probe"
        case_tmp.mkdir(parents=True, mode=0o700)
        probe_dir.mkdir(parents=True, mode=0o700)
        resume_fifo = probe_dir / "resume.fifo"
        trap_log = probe_dir / "cleanup_traps.log"
        hook_state_path = probe_dir / "hook_exit.state"
        os.mkfifo(resume_fifo)
        pause_before_open = '    kill -STOP "$BASHPID"\n' if early_abort else ""
        hook = (
            fork_marker
            + pause_before_open
            + '    exec 4<>"$HVO_PROBE_DIR/resume.fifo"\n'
            + '    printf \'%d\\n\' "$!" > "$HVO_PROBE_DIR/worker.pid.tmp"\n'
            + '    mv "$HVO_PROBE_DIR/worker.pid.tmp" "$HVO_PROBE_DIR/worker.pid"\n'
            + '    : > "$HVO_PROBE_DIR/paused.flag"\n'
            + '    _hvo_resume_token=""\n'
            + '    _hvo_read_rc=0\n'
            + '    IFS= read -r -t 5 -u 4 _hvo_resume_token || _hvo_read_rc=$?\n'
            + '    exec 4>&-\n'
            + '    printf \'read_rc=%d\\ntoken=%s\\nlaunching=%s\\npending=%s\\nreg_pid=%d\\nreg_pgid=%d\\n\' \\\n'
            + '      "$_hvo_read_rc" "$_hvo_resume_token" "${launching_worker:-}" \\\n'
            + '      "${pending_signal_exit:-}" "${#active_idx_to_pid[@]}" "${#active_idx_to_pgid[@]}" \\\n'
            + '      > "$HVO_PROBE_DIR/hook_exit.state"\n'
            + '    if (( _hvo_read_rc != 0 )) || [[ "$_hvo_resume_token" != "go" ]]; then\n'
            + '      exit 97\n'
            + '    fi\n'
        )
        harness = case_dir / "harness.sh"
        harness_out = case_dir / "harness.out"
        harness_err = case_dir / "harness.err"
        harness.write_text(instrumented_preamble.replace(fork_marker, hook, 1) + worker_body)
        env = os.environ.copy()
        env["TMPDIR"] = str(case_tmp)
        env["HVO_PROBE_DIR"] = str(probe_dir)
        env["HVO_CLEANUP_TRAP_LOG"] = str(trap_log)
        active["proc"] = None
        active["worker_pgid"] = None
        active["probe_dir"] = probe_dir
        # Keep the FIFO open from before the fork so cleanup can buffer an
        # abort even if the hook has yet to open its own descriptor.
        resume_fd = os.open(resume_fifo, os.O_RDWR | os.O_NONBLOCK)
        active["resume_fd"] = resume_fd
        try:
            with harness_out.open("w") as out_fh, harness_err.open("w") as err_fh:
                proc = subprocess.Popen(
                    ["bash", str(harness)],
                    env=env,
                    stdout=out_fh,
                    stderr=err_fh,
                )
            active["proc"] = proc
            deadline = time.monotonic() + 10.0
            while time.monotonic() < deadline:
                if (probe_dir / "worker_ready.flag").exists():
                    if early_abort:
                        stopped = os.waitid(os.P_PID, proc.pid, os.WSTOPPED | os.WNOHANG)
                        if stopped is not None and stopped.si_status == signal.SIGSTOP:
                            break
                    elif (probe_dir / "paused.flag").exists():
                        break
                if proc.poll() is not None:
                    raise SystemExit(
                        f"{label} probe exited early ({proc.returncode}); "
                        f"hook_state={parse_hook_state(hook_state_path)!r}; "
                        f"stderr={harness_err.read_text()!r}"
                    )
                time.sleep(0.01)
            else:
                raise SystemExit(f"{label} probe timed out waiting for pause/ready")
            worker_pid = int((probe_dir / "worker.pids").read_text().split()[0])
            worker_pgid = os.getpgid(worker_pid)
            active["worker_pgid"] = worker_pgid
            before = pgid_survivors(worker_pgid)
            if len(before) < 4:
                raise SystemExit(f"Expected >=4 live processes in worker pgid {worker_pgid}, saw {before}")
            if early_abort:
                _cleanup_active()
                rc = proc.returncode
            else:
                os.kill(proc.pid, sig)
                time.sleep(0.03)
                os.write(resume_fd, b"go\n")
                rc = proc.wait(timeout=10)
            hook_state = parse_hook_state(hook_state_path)
            if rc != expected_rc:
                raise SystemExit(
                    f"{label} expected exit {expected_rc}, got {rc}; "
                    f"hook_state={hook_state!r}; stderr={harness_err.read_text()!r}"
                )
            expected_hook = {
                "read_rc": "0",
                "token": "abort" if early_abort else "go",
                "launching": "1",
                "pending": str(128 + sig),
                "reg_pid": "0",
                "reg_pgid": "0",
            }
            if hook_state != expected_hook:
                raise SystemExit(
                    f"{label} handshake did not prove pre-registration deferral: "
                    f"expected {expected_hook!r}, got {hook_state!r}"
                )
            if not early_abort:
                assert_traps_disarmed(trap_log, f"{label} deferred exit")
            survivors = pgid_survivors(worker_pgid)
            if survivors:
                raise SystemExit(f"{label} left surviving processes in pgid {worker_pgid}: {survivors}")
            leaked = [p.name for p in case_tmp.iterdir()]
            if leaked:
                raise SystemExit(f"{label} leaked TMPDIR entries: {leaked}")
        finally:
            try:
                _cleanup_active()
            finally:
                active["resume_fd"] = None
                os.close(resume_fd)
            active["proc"] = None
            active["worker_pgid"] = None
            active["probe_dir"] = None

    # 2. Direct handle_signal disarm + rapid back-to-back SIGINT smoke regression
    direct_cases = [("direct-sigterm", signal.SIGTERM, 143, 1)] + [
        (f"rapid-{trial}", signal.SIGINT, 130, 3) for trial in range(5)
    ]
    for label, sig, expected_rc, burst in direct_cases:
        case_dir = root_dir / label
        case_tmp = case_dir / "tmp"
        probe_dir = case_dir / "probe"
        case_tmp.mkdir(parents=True, mode=0o700)
        probe_dir.mkdir(parents=True, mode=0o700)
        trap_log = probe_dir / "cleanup_traps.log"
        harness = case_dir / "harness.sh"
        harness_out = case_dir / "harness.out"
        harness_err = case_dir / "harness.err"
        harness.write_text(instrumented_preamble + worker_body)
        env = os.environ.copy()
        env["TMPDIR"] = str(case_tmp)
        env["HVO_PROBE_DIR"] = str(probe_dir)
        env["HVO_CLEANUP_TRAP_LOG"] = str(trap_log)
        active["proc"] = None
        active["worker_pgid"] = None
        active["probe_dir"] = probe_dir
        with harness_out.open("w") as out_fh, harness_err.open("w") as err_fh:
            proc = subprocess.Popen(
                ["bash", str(harness)],
                env=env,
                stdout=out_fh,
                stderr=err_fh,
            )
        active["proc"] = proc
        try:
            deadline = time.monotonic() + 10.0
            while time.monotonic() < deadline:
                if (probe_dir / "worker_ready.flag").exists():
                    break
                if proc.poll() is not None:
                    raise SystemExit(f"{label} exited early ({proc.returncode}): {harness_err.read_text()}")
                time.sleep(0.01)
            if not (probe_dir / "worker_ready.flag").exists():
                raise SystemExit(f"{label} timed out waiting for worker")
            worker_pid = int((probe_dir / "worker.pids").read_text().split()[0])
            worker_pgid = os.getpgid(worker_pid)
            active["worker_pgid"] = worker_pgid
            for i in range(burst):
                try:
                    os.kill(proc.pid, sig)
                except ProcessLookupError:
                    break
                if i + 1 < burst:
                    time.sleep(0.00005)
            rc = proc.wait(timeout=10)
            if rc != expected_rc:
                raise SystemExit(f"{label} expected exit {expected_rc}, got {rc}: {harness_err.read_text()}")
            assert_traps_disarmed(trap_log, f"{label} direct signal")
            survivors = pgid_survivors(worker_pgid)
            if survivors:
                raise SystemExit(f"{label} left surviving processes in pgid {worker_pgid}: {survivors}")
            leaked = [p.name for p in case_tmp.iterdir()]
            if leaked:
                raise SystemExit(f"{label} leaked TMPDIR entries: {leaked}")
        finally:
            _cleanup_active()
            active["proc"] = None
            active["worker_pgid"] = None
            active["probe_dir"] = None
finally:
    shutil.rmtree(root_dir, ignore_errors=True)
PY
}

# ==============================================================================
# Dispatch all independent groups through the bounded parallel worker pool.
# ==============================================================================

start_parallel_job fast_group_1 run_fast_group_1
start_parallel_job fast_group_2 run_fast_group_2

cert_shards="$max_jobs"
for ((shard = 0; shard < cert_shards; shard++)); do
  shard_cases=()
  for ((idx = shard; idx < ${#certificate_cases[@]}; idx += cert_shards)); do
    shard_cases+=("${certificate_cases[$idx]}")
  done
  if (( ${#shard_cases[@]} > 0 )); then
    start_parallel_job "fast_cert_$shard" run_fast_cert_shard "$shard" "${shard_cases[@]}"
  fi
done

start_parallel_job fast_group_3 run_fast_group_3
start_parallel_job fast_group_4 run_fast_group_4
start_parallel_job fast_group_canary run_fast_group_canary

start_parallel_job work_allow_secret run_work_allow_and_secret
half_release="$(( ${#release_scripts_paths[@]} / 2 ))"
