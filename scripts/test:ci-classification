run_work_links_shard() {
  local shard_id="$1" total_shards="$2"
  local repo="$work_root.links.$shard_id"
  cp -a "$work_root_csproj" "$repo"
  local link_probe_index=0 i link_record including_project linked_source including_directory
  local wildcard_probe owner_probe exp_status allow_path
  local -a specs=() spec_paths=() spec_statuses=() shard_seeds=()
  local -a kinds=() meta_including=() meta_linked=() pairs=()
  local -A shard_seen=()
  for allow_path in "${allowlisted_paths[@]}"; do
    shard_seen["$allow_path"]=1
  done

  if (( shard_id == 0 )); then
    verify_component_plan_batch "$repo" \
      "tests/HVO.SkyMonitor.CameraAgent.IntegrationTests/VirtualSkyPipelineTests.cs|full|false|false|false|true|false|A"
    shard_seen["tests/HVO.SkyMonitor.CameraAgent.IntegrationTests/VirtualSkyPipelineTests.cs"]=1
  fi

  for ((i = shard_id; i < ${#link_records[@]}; i += total_shards)); do
    link_record="${link_records[$i]}"
    including_project="${link_record%%|*}"
    linked_source="${link_record#*|}"
    [[ -n "$including_project" && -n "$linked_source" ]] || continue
    [[ "$linked_source" != *.csproj ]] || continue
    if [[ "$linked_source" == *'*'* || "$linked_source" == *'?'* ]]; then
      ((link_probe_index += 1))
      wildcard_probe="$(dirname "$linked_source")/WildcardProbe.cs"
      exp_status="${link_expected_wildcard_status[$i]}"
      if [[ "$exp_status" == M && -z "${shard_seen[$wildcard_probe]+x}" ]]; then
        shard_seeds+=("$wildcard_probe")
      fi
      shard_seen["$wildcard_probe"]=1
      specs+=("$wildcard_probe|link classification fixture wildcard-$shard_id-$link_probe_index"$'\n')
      spec_paths+=("$wildcard_probe")
      spec_statuses+=("$exp_status")
      kinds+=("wildcard")
      meta_including+=("$including_project")
      meta_linked+=("$linked_source")
      continue
    fi
    [[ -e "$repo_root/$linked_source" ]] || {
      printf 'Project link does not resolve to a repository path: %s -> %s\n' \
        "$including_project" "$linked_source" >&2
      exit 1
    }
    ((link_probe_index += 1))
    if (( ${csproj_count_by_project[$including_project]:-0} != 1 )); then
      printf 'Project directory name is ambiguous across top-level directories: %s\n' "$including_project" >&2
      exit 1
    fi
    including_directory="${csproj_dir_by_project[$including_project]}"
    owner_probe="$including_directory/LinkOwnerProbe.cs"
    exp_status="${link_expected_owner_status[$i]}"
    if [[ "$exp_status" == M && -z "${shard_seen[$owner_probe]+x}" ]]; then
      shard_seeds+=("$owner_probe")
    fi
    shard_seen["$owner_probe"]=1
    specs+=("$owner_probe|link classification fixture owner-$shard_id-$link_probe_index"$'\n')
    spec_paths+=("$owner_probe")
    spec_statuses+=("$exp_status")

    exp_status="${link_expected_linked_status[$i]}"
    if [[ "$exp_status" == M && -z "${shard_seen[$linked_source]+x}" ]]; then
      shard_seeds+=("$linked_source")
    fi
    shard_seen["$linked_source"]=1
    specs+=("$linked_source|link classification fixture linked-$shard_id-$link_probe_index"$'\n')
    spec_paths+=("$linked_source")
    spec_statuses+=("$exp_status")

    kinds+=("pair")
    meta_including+=("$including_project")
    meta_linked+=("$linked_source")
  done

  if (( ${#shard_seeds[@]} > 0 )); then
    seed_commit_files "$repo" "${shard_seeds[@]}"
  fi

  if (( ${#specs[@]} > 0 )); then
    batch_commit_pairs pairs "$repo" "${#specs[@]}" "${specs[@]}"
    local pair_idx=0 kind base head wildcard_flags including_flags linked_flags flag
    for ((i = 0; i < ${#kinds[@]}; i++)); do
      kind="${kinds[$i]}"
      including_project="${meta_including[$i]}"
      linked_source="${meta_linked[$i]}"
      if [[ "$kind" == wildcard ]]; then
        read -r base head <<< "${pairs[$pair_idx]}"
        assert_diff_status "$repo" "$base" "$head" "${spec_statuses[$pair_idx]}" "${spec_paths[$pair_idx]}"
        ((pair_idx += 1))
        wildcard_flags="$(classify_in_repo "$repo" pull_request "$base" "$head" | grep -E '^(complete|shared|cameraagent|delivery)=')"
        grep -Fxq 'complete=true' <<< "$wildcard_flags" || {
          printf 'Wildcard include %s covers a directory that does not select the complete matrix.\n' \
            "$linked_source" >&2
          exit 1
        }
      else
        read -r base head <<< "${pairs[$pair_idx]}"
        assert_diff_status "$repo" "$base" "$head" "${spec_statuses[$pair_idx]}" "${spec_paths[$pair_idx]}"
        ((pair_idx += 1))
        including_flags="$(classify_in_repo "$repo" pull_request "$base" "$head" | grep -E '^(complete|shared|cameraagent|delivery)=')"
        read -r base head <<< "${pairs[$pair_idx]}"
        assert_diff_status "$repo" "$base" "$head" "${spec_statuses[$pair_idx]}" "${spec_paths[$pair_idx]}"
        ((pair_idx += 1))
        linked_flags="$(classify_in_repo "$repo" pull_request "$base" "$head" | grep -E '^(complete|shared|cameraagent|delivery)=')"
        while IFS= read -r flag; do
          [[ "$flag" == *=true ]] || continue
          grep -Fxq "$flag" <<< "$linked_flags" || {
            printf 'Linked source %s does not select %s, which its including project %s requires.\n' \
              "$linked_source" "$flag" "$including_project" >&2
            exit 1
          }
        done <<< "$including_flags"
      fi
    done
  fi
  printf '%d\n' "$link_probe_index" > "$parallel_dir/link_probes.shard.$shard_id"
}

run_work_projdirs_and_complete() {
  local repo="$work_root.proj-complete"
  cp -a "$work_root_csproj" "$repo"
  # Pre-seed files that already existed before these assertions in the sequential baseline
  # so their batched commits preserve modification (M) diff status.
  seed_commit_files "$repo" \
    ".github/workflows/ci.yml" \
    ".github/workflows/release.yml" \
    ".github/workflows/prerelease.yml" \
    ".github/workflows/release-image.yml" \
    "scripts/ci:classify" \
    "scripts/ci:require" \
    "scripts/test:ci-classification" \
    "Directory.Build.props" \
    "tests/fixtures/catalog/hyg-v42-bright-stars.sqlite" \
    "docs/validation/cameraagent-transient-fault-matrix.json" \
    "tests/HVO.SkyMonitor.CameraAgent.IntegrationTests/VirtualSkyPipelineTests.cs"
  # Verify enumerator widenings (src/ projects and links outside src/tests/tools).
  local -a link_including_projects=() src_project_names=()
  mapfile -t link_including_projects < <(printf '%s\n' "${link_records[@]}" | cut -d'|' -f1 | sort -u)
  mapfile -t src_project_names < <(cd "$repo_root" && git ls-files 'src/*/*.csproj' \
    | while IFS= read -r candidate; do basename "$(dirname "$candidate")"; done | sort -u)
  comm -12 <(printf '%s\n' "${link_including_projects[@]}") <(printf '%s\n' "${src_project_names[@]}") \
    | grep . >/dev/null || {
    printf 'No src/ project file contributed a link record; the enumerator narrowed to tests/.\n' >&2
    exit 1
  }
  printf '%s\n' "${link_records[@]}" | grep -E '^[^|]*\|(docs|deploy)/' >/dev/null || {
    printf 'No link outside src/, tests/, and tools/ was resolved; the depth widening regressed.\n' >&2
    exit 1
  }

  local -a complete_matrix_projects=(
    tools/HVO.SkyMonitor.VirtualSkyPoc
    tools/HVO.SkyMonitor.TimeLapseBenchmark
    tests/HVO.SkyMonitor.Architecture.Tests
  )
  local project_directory_count=0 project_directory
  local -a probe_dirs=() probe_specs=() probe_pairs=()
  for project_directory in "${repo_project_directories[@]}"; do
    ((project_directory_count += 1))
    if printf '%s\n' "${complete_matrix_projects[@]}" | grep -Fx -- "$project_directory" >/dev/null; then
      continue
    fi
    probe_dirs+=("$project_directory")
    probe_specs+=("$project_directory/ClassificationProbe.cs|probe $project_directory"$'\n')
  done
  if (( project_directory_count < 40 )); then
    printf 'Only %s project directories were classified; the orphan cross-check is not enumerating the repository.\n' \
      "$project_directory_count" >&2
    exit 1
  fi
  batch_commit_pairs probe_pairs "$repo" "${#probe_dirs[@]}" "${probe_specs[@]}"
  local i base head probe_output
  for ((i = 0; i < ${#probe_dirs[@]}; i++)); do
    read -r base head <<< "${probe_pairs[$i]}"
    probe_output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
    if grep -Fxq 'complete=true' <<< "$probe_output"; then
      printf 'Project directory is not claimed by any component and falls back to the complete matrix: %s\n' \
        "${probe_dirs[$i]}" >&2
      exit 1
    fi
  done

  verify_component_plan_batch "$repo" \
    "THIRD-PARTY-NOTICES.md|full|false|true|true|true|true|M" \
    "changelog.d/camera-setup.fixed.md|reduced|false|false|false|false|false|A" \
    "changelog.d/123.unknown.md|full|false|true|true|true|true|A"

  local -a complete_matrix_rows=(
    ".github/workflows/ci.yml|M"
    ".github/workflows/release.yml|M"
    ".github/workflows/prerelease.yml|M"
    ".github/workflows/release-image.yml|M"
    "scripts/ci:classify|M"
    "scripts/ci:require|M"
    "scripts/ci:component-build|A"
    "scripts/test:ci-classification|M"
    "scripts/coverage:enforce|A"
    "scripts/coverage:component|A"
    "scripts/coverage:policy|A"
    "scripts/coverage/baseline.json|A"
    "scripts/coverage/Program.cs|A"
    "scripts/test-categories/Program.cs|A"
    "scripts/test:test-category-audit|A"
    "scripts/package:audit|A"
    "scripts/package-audit/allowlist.json|A"
    "tests/coverage.runsettings|A"
    "tests/unit-test-projects.json|A"
    "tests/HVO.SkyMonitor.Architecture.Tests/ArchitectureBoundaryTests.cs|A"
    "Directory.Build.props|M"
    "Directory.Packages.props|A"
    "dotnet-tools.json|A"
    "global.json|A"
    ".editorconfig|A"
    "HVO.SkyMonitor.v9.slnx|A"
    ".dockerignore|A"
    ".agents/skills/pr-lifecycle/scripts/helper.sh|A"
    "unknown/example.txt|A"
    "src/Example/Program.cs|A"
    "tests/Example.Tests/ExampleTests.cs|A"
    "tests/fixtures/frames/sample.bin|A"
    "tests/fixtures/catalog/hyg-v42-bright-stars.sqlite|M"
    "docs/validation/cameraagent-transient-fault-matrix.json|M"
    "tools/asi-capture/capture.sh|A"
    "docker/local/Dockerfile|A"
  )
  local -a cm_specs=() cm_pairs=()
  local cm_path cm_status
  for ((i = 0; i < ${#complete_matrix_rows[@]}; i++)); do
    IFS='|' read -r cm_path _ <<< "${complete_matrix_rows[$i]}"
    cm_specs+=("$cm_path|complete matrix fixture $i"$'\n')
  done
  batch_commit_pairs cm_pairs "$repo" "${#complete_matrix_rows[@]}" "${cm_specs[@]}"
  for ((i = 0; i < ${#complete_matrix_rows[@]}; i++)); do
    IFS='|' read -r cm_path cm_status <<< "${complete_matrix_rows[$i]}"
    read -r base head <<< "${cm_pairs[$i]}"
    assert_diff_status "$repo" "$base" "$head" "$cm_status" "$cm_path"
    probe_output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
    assert_components_output "$probe_output" true true true true
  done

  # An unknown including project still widens a CameraAgent file to the complete matrix.
  git -C "$repo" read-tree HEAD
  local linked_cameraagent_source="tests/HVO.SkyMonitor.CameraAgent.IntegrationTests/VirtualSkyPipelineTests.cs"
  local unknown_project="HVO.SkyMonitor.CameraAgent.Unclassified"
  mkdir -p "$repo/tests/$unknown_project"
  printf '<Project><ItemGroup><Compile Include="../../%s" /></ItemGroup></Project>\n' "$linked_cameraagent_source" \
    > "$repo/tests/$unknown_project/$unknown_project.csproj"
  git -C "$repo" add -- "tests/$unknown_project/$unknown_project.csproj"
  git -C "$repo" commit --quiet -m 'Add an unclassified project that links a CameraAgent source'
  verify_component_plan_batch "$repo" \
    "$linked_cameraagent_source|full|false|true|true|true|true|M"
}

run_work_deploy_fallback_cli() {
  local repo="$work_root.deploy-fallback"
  cp -a "$work_root_csproj" "$repo"
  # Pre-seed linked inputs and files that already existed in the sequential baseline
  # so every modification case (including RetainedIntegrityFormat.cs) exercises an M diff.
  seed_commit_files "$repo" \
