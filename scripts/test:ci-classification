verify_targeted_suites() {
  local path="$1" expected_catalog="$2" expected_shards="$3" expected_installer="$4"
  local targeted_base targeted_head
  targeted_base="$(git -C "$work_root" rev-parse HEAD)"
  update_file "$path"
  targeted_head="$(git -C "$work_root" rev-parse HEAD)"
  expect_plan full true pull_request "$targeted_base" "$targeted_head"
  expect_suites "$expected_catalog" "$expected_shards" "$expected_installer" \
    pull_request "$targeted_base" "$targeted_head"
}

