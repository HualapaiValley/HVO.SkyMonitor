real_git="$(command -v git)"
mkdir -p "$work_root/fake-bin"
cat > "$work_root/fake-bin/git" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
case "$1" in
  cat-file) exit 0 ;;
  diff)
    [[ "${FAKE_GIT_DIFF_FAILURE:-false}" != true ]] || exit 91
    printf 'M\0'
    exit 0
    ;;
  *) exec "${REAL_GIT:?}" "$@" ;;
esac
EOF
chmod +x "$work_root/fake-bin/git"

expected_fail_closed=$'mode=full\ndeployment=true\ndeployment_catalog=true\ndeployment_shards=true\ndeployment_installer=true\ncomplete=true\nshared=true\ncameraagent=true\nlogichost=true\ncombined=true\ndelivery=true'
for fake_case in malformed failure; do
  if [[ "$fake_case" == failure ]]; then fake_failure=true; else fake_failure=false; fi
  output="$(cd "$work_root" && PATH="$work_root/fake-bin:$PATH" REAL_GIT="$real_git" FAKE_GIT_DIFF_FAILURE="$fake_failure" \
    "$classifier" pull_request fake-base fake-head)"
  if [[ "$output" != "$expected_fail_closed" ]]; then
    printf 'Expected fail-closed malformed/diff-failure plan, received %s\n' "$output" >&2
    exit 1
  fi
done

# Required CI aggregation.
plan() {
  printf 'mode=%s complete=%s shared=%s cameraagent=%s logichost=%s combined=%s delivery=%s deployment=%s' "$@"
}

results() {
  local -A values=()
  local job override
  for job in "${result_jobs[@]}"; do
    values["$job"]="skipped"
  done
  for override in "$@"; do
    values["${override%%=*}"]="${override#*=}"
  done
  local output=""
  for job in "${result_jobs[@]}"; do
    output+="$job=${values[$job]} "
  done
  printf '%s' "${output% }"
}

full_success="$(results changes=success quality=success architecture=success \
  coverage-policy=success migrations-cameraagent=success migrations-logichost=success)"
complete_plan_deployed="$(plan full true true true true true true true)"
complete_plan_undeployed="$(plan full true true true true true true false)"
reduced_plan="$(plan reduced false false false false false false false)"
reduced_success="$(results changes=success quality=success)"

expect_required_accept() {
  local label="$1" event="$2" plan_value="$3" results_value="$4"
  "$required" "$event" "$plan_value" "$results_value" >/dev/null || {
    printf 'Expected Required CI acceptance for %s\n' "$label" >&2
    exit 1
  }
}

expect_required_reject() {
  local label="$1" event="$2" plan_value="$3" results_value="$4"
  if "$required" "$event" "$plan_value" "$results_value" >/dev/null 2>&1; then
    printf 'Expected Required CI rejection for %s\n' "$label" >&2
    exit 1
  fi
}

# Every full-mode plan now expects the same six cross-cutting gates, because the
# duplicated build, suite, and component lanes were removed from the workflow.
expect_required_accept "push complete matrix" push "$complete_plan_deployed" "$full_success"
expect_required_accept "manual complete matrix" workflow_dispatch "$complete_plan_deployed" "$full_success"
expect_required_accept "pull request complete matrix" pull_request "$complete_plan_undeployed" "$full_success"
expect_required_accept "documentation-only reduced plan" pull_request "$reduced_plan" "$reduced_success"

cameraagent_plan="$(plan full false false true false false false false)"
expect_required_accept "CameraAgent-only component plan" pull_request "$cameraagent_plan" "$full_success"

logichost_plan="$(plan full false false false true false false false)"
expect_required_accept "LogicHost-only component plan" pull_request "$logichost_plan" "$full_success"

shared_plan="$(plan full false true true true true true false)"
expect_required_accept "shared contract component plan" pull_request "$shared_plan" "$full_success"

combined_plan="$(plan full false false true true true false false)"
expect_required_reject "combined plan without a host lane" pull_request \
  "$(plan full false false false false true false false)" "$full_success"
expect_required_accept "combined fixture component plan" pull_request "$combined_plan" "$full_success"

delivery_plan="$(plan full false false false false false true true)"
expect_required_accept "delivery component plan" pull_request "$delivery_plan" "$full_success"

# Failure, cancellation, and skipping are all rejected for a full-mode gate.
for job in changes quality architecture coverage-policy \
  migrations-cameraagent migrations-logichost; do
  for outcome in failure cancelled skipped; do
    expect_required_reject "$job=$outcome in the CameraAgent plan" pull_request "$cameraagent_plan" \
      "$(results changes=success quality=success architecture=success coverage-policy=success \
        migrations-cameraagent=success migrations-logichost=success "$job=$outcome")"
  done
done

expect_required_reject "reduced results under a full plan" pull_request \
  "$complete_plan_undeployed" "$reduced_success"
expect_required_reject "full results under a reduced plan" pull_request \
  "$reduced_plan" "$full_success"

invalid_plans=(
  "reduced|$(plan reduced false false false false false false false)|push"
  "complete on a reduced mode|$(plan reduced true true true true true true false)|pull_request"
  "reduced with a component lane|$(plan reduced false false true false false false false)|pull_request"
  "reduced with deployment contracts|$(plan reduced false false false false false false true)|pull_request"
  "full without any selection|$(plan full false false false false false false false)|pull_request"
  "complete without every lane|$(plan full true true true true true false false)|pull_request"
  "unknown mode|$(plan unknown false false true false false false false)|pull_request"
  "non-boolean flag|$(plan full maybe false true false false false false)|pull_request"
  "push without the complete matrix|$(plan full false false true false false false true)|push"
  "push without deployment contracts|$(plan full true true true true true true false)|push"
)
for entry in "${invalid_plans[@]}"; do
  IFS='|' read -r label plan_value event_value <<< "$entry"
  expect_required_reject "$label" "$event_value" "$plan_value" "$full_success"
done

expect_required_reject "missing plan key" pull_request \
  "mode=full complete=false shared=false cameraagent=true logichost=false combined=false delivery=false" \
  "$full_success"
expect_required_reject "unknown plan key" pull_request \
  "$cameraagent_plan extra=true" "$full_success"
expect_required_reject "duplicate plan key" pull_request \
  "$cameraagent_plan mode=reduced" "$full_success"
expect_required_reject "missing job result" pull_request "$cameraagent_plan" \
  "${full_success/ migrations-logichost=success/}"
expect_required_reject "unknown job result" pull_request "$cameraagent_plan" \
  "$full_success unit=success"
expect_required_reject "unusable job result" pull_request "$cameraagent_plan" \
  "${full_success/quality=success/quality=neutral}"
expect_required_reject "empty plan" pull_request "" "$full_success"
expect_required_reject "empty results" pull_request "$cameraagent_plan" ""

# Workflow shape.
extract_workflow_job() {
  local target="$1" line job_name capturing=false
  while IFS= read -r line; do
    if [[ "$line" =~ ^[[:space:]]{2}([a-z0-9-]+):[[:space:]]*$ ]]; then
      job_name="${BASH_REMATCH[1]}"
      if [[ "$capturing" == true ]]; then
        break
      fi
      if [[ "$job_name" == "$target" ]]; then
        capturing=true
      fi
    fi
    if [[ "$capturing" == true ]]; then
      printf '%s\n' "$line"
    fi
  done < "$workflow"
}

# The workflow no longer re-runs the build and test work that every candidate
# already runs locally, so no job in it may reappear without a decision.
for removed in catalog-contracts deployment-contracts build unit integration \
  coverage shared-libraries cameraagent-component logichost-component \
  combined-integration delivery-component badges; do
  if grep -Eq "^  $removed:[[:space:]]*$" "$workflow"; then
    printf 'Removed duplicate-work job reappeared in the workflow: %s\n' "$removed" >&2
    exit 1
  fi
done
grep -Fq 'types: [opened, synchronize, reopened, ready_for_review, converted_to_draft]' "$workflow" || {
  printf 'Pull request CI must follow ready/draft review transitions.\n' >&2
  exit 1
}
changes_job="$(extract_workflow_job changes)"
grep -Fxq "    if: github.event_name != 'pull_request' || github.event.pull_request.draft == false" <<< "$changes_job" || {
  printf 'Draft pull requests must not start the classifier-selected CI plan.\n' >&2
  exit 1
}
for output in mode deployment complete shared cameraagent logichost combined delivery; do
  # shellcheck disable=SC2016 # The workflow expression is intentionally literal.
  grep -Fq "      $output: \${{ steps.classify.outputs.$output }}" <<< "$changes_job" || {
    printf 'Change Classification must publish the %s plan output.\n' "$output" >&2
    exit 1
  }
done

# Every gate is derived from the validated plan, and every aggregated job is
# required by the aggregation job.
required_job="$(extract_workflow_job required)"
grep -Fxq '    if: always()' <<< "$required_job" || {
  printf 'Required CI must report a conclusion for every pull request head.\n' >&2
  exit 1
}
for job in "${result_jobs[@]}"; do
  [[ "$job" != "changes" ]] || continue
  grep -Fq "$job," <<< "$required_job" || grep -Fq "$job]" <<< "$required_job" || {
    printf 'Required CI does not depend on the aggregated job: %s\n' "$job" >&2
    exit 1
  }
  # shellcheck disable=SC2016 # The workflow expression is intentionally literal.
  grep -Fq "            $job=\${{ needs.$job.result }}" <<< "$required_job" || {
    printf 'Required CI does not forward the result of: %s\n' "$job" >&2
    exit 1
  }
done
for key in mode complete shared cameraagent logichost combined delivery deployment; do
  # shellcheck disable=SC2016 # The workflow expression is intentionally literal.
  grep -Fq "            $key=\${{ needs.changes.outputs.$key }}" <<< "$required_job" || {
    printf 'Required CI does not forward the plan key: %s\n' "$key" >&2
    exit 1
  }
done
grep -Fq './scripts/ci:require "$EVENT_NAME" "$PLAN" "$RESULTS"' <<< "$required_job" || {
  printf 'Required CI must aggregate through the plan-derived contract script.\n' >&2
  exit 1
}
draft_failure_step=$'      - name: Block merge while review is in progress\n        if: github.event_name == '\''pull_request'\'' && github.event.pull_request.draft == true\n        run: |\n          echo '\''Required CI is intentionally blocked while the pull request is draft.'\'' >&2\n          exit 1'
grep -Fq "$draft_failure_step" <<< "$required_job" || {
  printf 'Draft Required CI must fail closed rather than conclude skipped.\n' >&2
  exit 1
}
for step_name in 'Checkout' 'Require every current-head gate'; do
  non_draft_step=$'      - name: '"$step_name"$'\n        if: github.event_name != '\''pull_request'\'' || github.event.pull_request.draft == false'
  grep -Fq "$non_draft_step" <<< "$required_job" || {
    printf 'Required CI step must run only for a non-draft head: %s\n' "$step_name" >&2
    exit 1
  }
done

# Cross-cutting gates never depend on component selection.
for job in architecture coverage-policy migrations-cameraagent migrations-logichost; do
  job_body="$(extract_workflow_job "$job")"
  grep -Fxq "    if: needs.changes.outputs.mode == 'full'" <<< "$job_body" || {
    printf 'Cross-cutting gate must run for every full-mode head: %s\n' "$job" >&2
    exit 1
  }
done

# Quality keeps the repository-wide bookkeeping gates that a diff-bounded local
# run never selects and that need no compiled output.
quality_job="$(extract_workflow_job quality)"
for step_name in 'Verify catalog contracts' \
  'Audit vulnerable and deprecated packages'; do
  grep -Fq "      - name: $step_name" <<< "$quality_job" || {
    printf 'Quality must retain the repository-wide gate: %s\n' "$step_name" >&2
    exit 1
  }
done

# The catalog contract smoke test ran under a full-mode condition in the job it
# came from, so the move must not silently widen it to every mode.
catalog_condition="$(grep -A1 -F '      - name: Verify catalog contracts' <<< "$quality_job" | tail -n 1)"
if [[ "$catalog_condition" != "        if: needs.changes.outputs.mode == 'full'" ]]; then
  printf 'The catalog contract smoke test must stay gated on full mode.\n' >&2
  exit 1
fi

# The smoke test only proves an intentionally invalid fixture is rejected. Building the real
# HYG v42 bundle is the half that proves the production catalog can still be produced from its
# declared inputs, and it is a different assertion rather than a more expensive version of the
# same one, so keeping only the cheap one would narrow the gate while appearing to preserve it.
grep -Fq './scripts/catalog/prepare-hyg-v42-contracts.sh' <<< "$quality_job" || {
  printf 'Quality must build the exact production catalog contracts, not only smoke-test a fixture.\n' >&2
  exit 1
}

# Phase 14 acceptance is a historical inventory contract, not part of the
# per-change gate set, so it must stay behind an explicit dispatch.
phase14_condition="$(grep -A1 -F '      - name: Run historical Phase 14 acceptance inventory contract' <<< "$quality_job" | tail -n 1)"
if [[ "$phase14_condition" != "        if: needs.changes.outputs.mode == 'full' && github.event_name == 'workflow_dispatch'" ]]; then
  printf 'Phase 14 acceptance must stay gated on a full-mode workflow_dispatch.\n' >&2
  exit 1
fi

# The Architecture & Publish gate owns both category selections of the
# architecture project, so no component plan can drop the Unit boundary cases.
architecture_job="$(extract_workflow_job architecture)"
grep -Fq 'tests/HVO.SkyMonitor.Architecture.Tests/HVO.SkyMonitor.Architecture.Tests.csproj --no-build --configuration Release --filter "$UNIT_FILTER"' <<< "$architecture_job" || {
  printf 'Architecture & Publish must run the Architecture Unit selection.\n' >&2
  exit 1
}
grep -Fq 'tests/HVO.SkyMonitor.Architecture.Tests/HVO.SkyMonitor.Architecture.Tests.csproj --no-build --configuration Release --filter "TestCategory=Integration&FullyQualifiedName~ArchitectureBoundaryTests"' <<< "$architecture_job" || {
  printf 'Architecture & Publish must run the Architecture Integration selection.\n' >&2
  exit 1
}

# The behavioral category audit shells out to `dotnet test --no-build`, so it
# only produces an answer in a job that has already built the solution in
# Release. Assert the precondition and not merely the step: a gate placed where
# its precondition is missing looks identical to a gate that passes.
grep -Fq '      - name: Audit behavioral test categories' <<< "$architecture_job" || {
  printf 'Architecture & Publish must run the behavioral test category audit.\n' >&2
  exit 1
}
audit_line="$(grep -n -F '      - name: Audit behavioral test categories' <<< "$architecture_job" | head -n 1 | cut -d: -f1)"
release_build_line="$(grep -n -F 'dotnet build HVO.SkyMonitor.v9.slnx --no-restore --configuration Release' <<< "$architecture_job" | head -n 1 | cut -d: -f1)"
if [[ -z "$release_build_line" || "$release_build_line" -ge "$audit_line" ]]; then
  printf 'The behavioral category audit must follow a Release build of the solution.\n' >&2
  exit 1
fi
grep -Fq '      - name: Audit behavioral test categories' <<< "$quality_job" && {
  printf 'The behavioral category audit must not run in Quality, which never builds.\n' >&2
  exit 1
}

for host in cameraagent logichost; do
  job_body="$(extract_workflow_job "migrations-$host")"
  grep -Fq "./scripts/ci:canonical-migration $host" <<< "$job_body" || {
    printf 'Split migration gate must enforce its canonical migration: %s\n' "$host" >&2
    exit 1
  }
done

release_workflow="$repo_root/.github/workflows/release.yml"
grep -Fq -- '-f branch=main -f event=push -f status=completed -f head_sha=' "$release_workflow" || {
  printf 'Release qualification must select completed exact-SHA main-push CI runs.\n' >&2
  exit 1
}
grep -Fq 'select(.name == "Required CI")' "$release_workflow" || {
  printf 'Release qualification must inspect the Required CI job.\n' >&2
  exit 1
}
if grep -Fq 'select(.conclusion == "success")' "$release_workflow"; then
  printf 'Release qualification must not require unrelated workflow jobs to succeed.\n' >&2
  exit 1
fi

# The release lookup above only ever matches a CI run produced by a push to main. Asserting the
# query without asserting that CI answers it checks one half of a contract twice and the other
# half never, so trimming main out of the push triggers would leave every release unqualifiable
# with both halves still passing their own tests.
#
# This recognizes one workflow shape and refuses every other. It does not interpret GitHub's
# filter grammar and it does not read the file as lines: every adversarial finding that has
# defeated a guard here did the same thing, computing a value for a property of the document the
# guard could not establish. The workflow is parsed with a real YAML parser, every structural
# question is answered from the parsed document, and a key or an entry the parser cannot pin down
# is refused rather than compared as the text that spells it. Refusing what it cannot establish
# means widening the workflow requires widening the guard in the same commit, which is the
# intended cost.
guard_py="$work_root/ci-push-trigger.py"
cat > "$guard_py" <<'CI_PUSH_TRIGGER_PY'
"""Assert that the CI workflow runs on pushes to main.

release.yml qualifies a release SHA by looking for a completed CI run produced
by a push to main. Nothing else can answer that query, so a workflow that does
not produce such a run leaves every release unqualifiable.

Every adversarial finding that has defeated a guard in this file did the same
thing: the guard computed a value for a property of the document it could not
establish, instead of refusing. Four were in the branch filter grammar, which
was replaced in round 2 by the shape recognizer below and has held since. The
rest were in the reader: a duplicated mapping key resolved by taking the first,
a tab measured as a column width, whitespace that is not a space measured as a
column width, a top-level key identified without establishing which document it
was in, a duplicate key spelled with quotes, a duplicate key created by boolean
resolution, branch list entries that are not branch patterns, and a
non-specific tag reaching composition through a refusal that did not fire.

The reader was a hand-rolled line-oriented YAML parser. The only method that
ever caught anything was running a real parser beside it as the oracle. A
parser that must be checked by a real parser to be trusted should be the real
parser, so this one is.

The acceptance rule, and the standard for changing this file: refuse every
property of the document you cannot establish, rather than computing a value
anyway.

What that means for each kind of question:

Structure comes from the parser. The document is composed to a node graph and
every structural question is answered from it.

A key's identity comes from the text and from the parser's resolution of that
text, and a collision under either refuses. GitHub reads workflow keys as text
and resolves no YAML 1.1 booleans, so to GitHub `on:` and `True:` are two
distinct keys and the block spelled `on` is the trigger. PyYAML resolves `on`,
`On`, `ON`, `yes` and `True` to one boolean key, so the last of them in
document order wins and the trigger binds wherever that one points. The same
bytes, two different triggers. Refusing a collision under either reading is the
only answer that does not require this guard to pick a side.

An entry's value is compared as the text the parser read, but only once the
parser has established the entry is a string. Comparing text is what keeps this
guard out of the boolean disagreement above; it is not a licence to treat every
scalar as its own spelling. A `~` entry is read as null by every conformant
parser in either YAML version, GitHub included, so reading it as the text `~`
would not be applying the text rule, it would be applying it past its scope.

Names are checked against the lists GitHub's own parser defines, at every level
where such a list exists. What that rule is for, since it has been stated three
ways and only this one survives the cases:

This guard decides one thing, whether the classifier can rely on what this file
says it does, and it answers no whenever it cannot establish an answer. That is
why it refuses shapes that are merely unrecognized rather than provably wrong.
An unknown key or event name may be a name GitHub's parser rejects, and a
workflow GitHub declines to load produces no runs at all, so a file that reads
as a correct push trigger can trigger nothing. This guard cannot tell that case
apart from a valid extension it has not been taught, so it treats them the same.
The cost of the first mistake is a classification stated with confidence and
unsupported by any run; the cost of the second is widening this guard in the
same commit that widens the workflow, which is a cost with an owner.

Read that way the individual refusals stop needing separate arguments. `[` is
not in PATTERN_CHARS, `pushh` is not in KNOWN_ON_KEYS and `bogus_top` is not in
KNOWN_WORKFLOW_KEYS for one reason, not three, and the next name nobody has
thought of yet is decidable without another ruling. An earlier version of this
paragraph drew the line at whether an unknown name could change which branches
*match*, which is narrower than the property being defended and put those three
refusals on different footings; a branch entry GitHub cannot parse and an event
name GitHub cannot parse end in the same place, and the lists below now say so
together instead of contradicting each other.
"""

import string
import sys

PARSER_MISSING = None
try:
    import yaml
    from yaml.constructor import SafeConstructor
except ImportError as error:  # pragma: no cover - environment dependent
    PARSER_MISSING = error

BRANCH = 'main'
TRIGGER = 'on'
STRING_TAG = 'tag:yaml.org,2002:str'
BOOLEAN_TAG = 'tag:yaml.org,2002:bool'
# The only characters that can invert an entry's meaning. `!` negates, and `\`
# escapes. Either one, in any entry, can suppress the main-push run that
# another entry appears to provide. Characters like `*` and `?` are not listed:
# a positive pattern can only add branches to a trigger, never remove main, so
# refusing them would buy nothing and would reject this repository's own
# 'release/**' entry.
#
# The scope of that argument is one entry, and it is easy to over-read. It says
# nothing about suppression from outside the entry, where a second `branches`
# key, a second `push` block, or a trigger sitting in a second YAML document
# replaces the list wholesale with no entry containing either character. That
# class belongs to the reader below, which answers structural questions from
# the parsed document and refuses whatever the parse leaves ambiguous.
#
# It also says nothing about an entry that is not a positive pattern at all,
# which is a question about the entry rather than about what patterns mean.
# PATTERN_CHARS answers that one.
INVERTING = ('!', '\\')
# The characters this guard recognizes in a positive branch pattern: those git
# allows in a ref name, plus the `*`, `?` and `+` of GitHub's filter grammar,
# each of which can only widen the set of branches an entry matches. `[` and
# `]` are left out deliberately. A character range is a grammar this guard has
# not been taught, and an unterminated one is not a pattern at all; an entry
# GitHub cannot parse can make it refuse the whole workflow, which produces no
# runs of any kind. Teaching the range grammar is the way to accept one, not
# assuming the entry is well formed because it is a string.
PATTERN_CHARS = frozenset(string.ascii_letters + string.digits + '-._/+*?@')
# The three key lists below are transcribed from GitHub's own workflow parser
# schema, workflow-parser/src/workflow-v1.0.json in actions/languageservices,
# entered at the root that parser actually uses. That entry point is the part to
# get right and it is not guessable from the schema: the file defines both
# `workflow-root` and `workflow-root-strict`, they disagree about exactly the
# question these lists answer, and
# workflow-parser/src/workflows/workflow-constants.ts names the strict one as
# WORKFLOW_ROOT. `workflow-root` routes `on:` to a mapping carrying
# "loose-key-type": "non-empty-string", which accepts any event name at all.
# Read that root instead and you conclude GitHub accepts an unknown event, which
# is the opposite of what its parser does.
#
# SchemaStore's github-workflow.json is a reasonable corroborating source and a
# poor deciding one, being a third-party transcription rather than the parser
# itself. On the `description` key below the two disagree outright: SchemaStore
# rejects it and GitHub's own strict root defines it. These lists follow the
# parser.

# The nine top-level workflow keys GitHub defines. Nine, not eight:
# `description` is one of them, and refusing it refused a valid workflow.
KNOWN_WORKFLOW_KEYS = ('name', 'description', 'run-name', 'on', 'permissions',
                       'env', 'defaults', 'concurrency', 'jobs')
# The two top-level keys GitHub marks required. A workflow missing either
# produces no run for a push to main, whatever its trigger says.
REQUIRED_WORKFLOW_KEYS = ('on', 'jobs')
# The 37 event names GitHub's strict `on:` mapping defines. It carries no loose
# key type, so an event name outside this list is not an extension the platform
# tolerates; it is a workflow the platform declines to load.
KNOWN_ON_KEYS = (
    'branch_protection_rule', 'check_run', 'check_suite', 'create', 'delete',
    'deployment', 'deployment_status', 'discussion', 'discussion_comment',
    'fork', 'gollum', 'image_version', 'issue_comment', 'issues', 'label',
    'merge_group', 'milestone', 'page_build', 'project', 'project_card',
    'project_column', 'public', 'pull_request', 'pull_request_comment',
    'pull_request_review', 'pull_request_review_comment', 'pull_request_target',
    'push', 'registry_package', 'release', 'repository_dispatch', 'schedule',
    'status', 'watch', 'workflow_call', 'workflow_dispatch', 'workflow_run')
# The keys a push block may name.
KNOWN_PUSH_KEYS = ('branches', 'branches-ignore', 'tags', 'tags-ignore',
                   'paths', 'paths-ignore')
# These suppress or narrow the main-push run and must be absent.
DISQUALIFYING_PUSH_KEYS = ('branches-ignore', 'paths', 'paths-ignore')


class Unrecognized(Exception):
    pass


def refuse_reference(event):
    """Refuse an anchor, alias or explicit tag on a node the reader consumes.

    An alias makes a node's content depend on a definition elsewhere in the
    file, and an explicit tag changes what a node means; neither would be
    established by looking at the node alone. `event.tag is not None` is the
    complete condition for both scalars and collections: the parser reports
    `None` for every untagged node, plain scalar and quoted scalar and block
    and flow collection alike, and reports the non-specific tag `!` as a tag
    like any other.
    """
    if isinstance(event, yaml.AliasEvent):
        raise Unrecognized(
            'the trigger uses a YAML alias (*%s); this guard does not resolve '
            'references' % event.anchor)
    if getattr(event, 'anchor', None):
        raise Unrecognized(
            'the trigger defines a YAML anchor (&%s); this guard does not '
            'resolve references' % event.anchor)
    if getattr(event, 'tag', None) is not None:
        raise Unrecognized('the trigger gives an explicit tag %r, which '
                           'changes what a node means' % event.tag)


def scan_references(text):
    """Refuse a reference anywhere the reader will look.

    The reader consumes the root mapping's keys, the value of its `on` key and
    everything under it. A reference there is refused. A reference under
    another top-level key is not this guard's business: an anchor in `env:` or
    a tag in `permissions:` leaves the trigger byte-identical, and refusing the
    whole workflow for one would be this guard having an opinion about a part
    of the file it never reads. An anchor defined outside the trigger and used
    inside it is still refused, because the alias is inside.

    Root keys are checked rather than skipped, so a reference cannot introduce
    a top-level key without being seen. A merge key is refused a second way, by
    KNOWN_WORKFLOW_KEYS, since `<<` is not a workflow key.
    """
    depth = 0
    slot = 0            # in the root mapping: 0 expects a key, 1 its value
    key = None
    skip_depth = None   # depth at which a subtree the reader never reads began

    for event in yaml.parse(text):
        opening = isinstance(event, (yaml.MappingStartEvent,
                                     yaml.SequenceStartEvent))
        closing = isinstance(event, (yaml.MappingEndEvent,
                                     yaml.SequenceEndEvent))
        leaf = isinstance(event, (yaml.ScalarEvent, yaml.AliasEvent))

        outside = skip_depth is not None
        if not outside and depth == 1 and slot == 1 and (opening or leaf):
            outside = key != TRIGGER
        if not outside:
            refuse_reference(event)

        if opening:
            if outside and skip_depth is None:
                skip_depth = depth
            depth += 1
        elif closing:
            depth -= 1
            if skip_depth == depth:
                skip_depth = None
            if depth == 1:
                if slot == 0:
                    key = None      # a complex key, which mapping_pairs refuses
                slot = 1 - slot
        elif leaf and depth == 1 and skip_depth is None:
            if slot == 0:
                key = event.value if isinstance(event, yaml.ScalarEvent) else None
            slot = 1 - slot
        elif isinstance(event, yaml.DocumentEndEvent):
            depth, slot, key, skip_depth = 0, 0, None, None


def load_single_document(path):
    """Compose the workflow to one node graph, or refuse."""
    with open(path, encoding='utf-8') as handle:
        text = handle.read()

    try:
        scan_references(text)
        documents = list(yaml.compose_all(text))
    except yaml.YAMLError as error:
        # Tabs and non-space indentation land here, as does any other malformed
        # document. There is no shape to recognize in a file that does not
        # parse, and nothing to measure around.
        detail = str(error).replace('\n', ' ').strip()
        raise Unrecognized('the parser refused the document: %s' % detail)

    if not documents:
        raise Unrecognized('the file contains no YAML document')
    if len(documents) > 1:
        # A bare `---` puts everything after it in a second document. GitHub
        # reads the first; a guard reading the last would be inspecting a
        # trigger that never takes effect.
        raise Unrecognized(
            'the file contains %d YAML documents; GitHub reads the first, and '
            'a trigger in any later document never takes effect'
            % len(documents))

    root = documents[0]
    if root is None:
        raise Unrecognized('the workflow document is empty')
    return root


def key_identities(key_node, where):
    """Return every identity a parser can bind this key to.

    Both readings are collected, the text and the resolved value, because the
    two consumers of this file disagree about which one a key is. See the
    module docstring; the disagreement is the reason this returns a list rather
    than a value.
    """
    try:
        resolved = SafeConstructor().construct_object(key_node)
    except yaml.YAMLError as error:
        raise Unrecognized('%s has a key this guard cannot resolve: %s'
                           % (where, error))
    return [('text', key_node.value), ('value', key_node.tag, resolved)]


def mapping_pairs(node, where, known_keys=None):
    """Return a mapping node's (key text, value node) pairs, or refuse.

    A non-scalar key and a repeated key both leave the mapping's meaning
    unestablished: parsers resolve a duplicate key last-wins or refuse the
    document, and this guard will not pick between those answers.

    `known_keys` is a list of the names GitHub defines at this level. It is
    passed wherever such a list exists, because a name outside it is one this
    guard cannot establish the meaning of and GitHub may decline to load.
    """
    if not isinstance(node, yaml.MappingNode):
        raise Unrecognized('%s is not a mapping' % where)
    pairs = []
    seen = []
    for key_node, value_node in node.value:
        if not isinstance(key_node, yaml.ScalarNode):
            raise Unrecognized('%s has a key that is not a plain scalar' % where)
        key = key_node.value
        identities = key_identities(key_node, where)
        for identity in identities:
            for seen_identity, seen_key in seen:
                if seen_identity != identity:
                    continue
                if seen_key == key:
                    raise Unrecognized(
                        '%s defines %r more than once; parsers either resolve '
                        'a duplicate mapping key last-wins or refuse the '
                        'document, and this guard will not pick between those '
                        'answers' % (where, key))
                raise Unrecognized(
                    '%s spells one key two ways, as %r and %r; a parser binds '
                    'both to the same key and takes the last, so the block '
                    'this guard reads is not the block that takes effect'
                    % (where, seen_key, key))
        seen.extend((identity, key) for identity in identities)
        if known_keys is not None and key not in known_keys:
            raise Unrecognized('unrecognized key in %s: %s' % (where, key))
        pairs.append((key, value_node))
    return pairs


def read_push_block(root):
    """Return the `push:` mapping node from the workflow's `on:` key."""
    on_values = [value for key, value
                 in mapping_pairs(root, 'the workflow', KNOWN_WORKFLOW_KEYS)
                 if key == TRIGGER]
    if not on_values:
        raise Unrecognized('the workflow has no top-level `on:` key')
    # mapping_pairs already refuses a repeated key, so this cannot be reached
    # by a duplicate; it holds the invariant if that ever changes.
    if len(on_values) > 1:
        raise Unrecognized('the workflow has %d top-level `on:` keys'
                           % len(on_values))

    push_values = [value for key, value
                   in mapping_pairs(on_values[0], '`on:`', KNOWN_ON_KEYS)
                   if key == 'push']
    if not push_values:
        raise Unrecognized('`on:` has no `push:` trigger')
    if len(push_values) > 1:
        raise Unrecognized('`on:` defines `push:` %d times' % len(push_values))
    return push_values[0]


def require_declared_jobs(root):
    """Refuse a workflow that declares no jobs, in any of the shapes that takes.

    A trigger this guard accepts is only half of what release qualification
    needs. release.yml looks for a *completed CI run* produced by a push to
    main, and a workflow with no jobs produces no such run however exactly its
    push filter names the branch. GitHub marks `jobs` required for the same
    reason.

    Absent, null and non-mapping are one refusal rather than three, because they
    are one property: this guard cannot establish that the workflow declares any
    work. An empty mapping is refused on the stronger ground that it establishes
    the opposite.
    """
    jobs = [value for key, value
            in mapping_pairs(root, 'the workflow', KNOWN_WORKFLOW_KEYS)
            if key == 'jobs']
    if not jobs:
        raise Unrecognized('the workflow has no top-level `jobs:` key')
    node = jobs[0]
    if not isinstance(node, yaml.MappingNode):
        raise Unrecognized('`jobs:` is not a mapping, so the workflow declares '
                           'no job that could produce a run')
    if not mapping_pairs(node, '`jobs:`'):
        raise Unrecognized('`jobs:` is empty, so the workflow declares no job '
                           'that could produce a run')


def read_entry(item):
    """Return a branch entry as text, or refuse what is not a pattern.

    GitHub reads branch names as text, while PyYAML's YAML 1.1-compatible
    resolver tags plain boolean spellings such as `on` as booleans. The parser
    event scan has already refused explicit tags, so an implicit boolean tag is
    safe to normalize to its source text here. The order of these questions is
    deliberate: the questions added in front of the pattern checks are about
    whether the entry is a branch pattern, not about what a pattern means.
    """
    if not isinstance(item, yaml.ScalarNode):
        raise Unrecognized('a `branches` entry is not a plain scalar')
    entry = item.value
    if item.tag not in (STRING_TAG, BOOLEAN_TAG):
        raise Unrecognized(
            'branch entry %r is not a string or an implicit YAML boolean; the '
            'parser reads it as %s, and this guard compares entries as the text '
            'the parser read, so it would be comparing a spelling against a '
            'branch name' % (entry, item.tag.rsplit(':', 1)[-1]))
    for char in INVERTING:
        if char in entry:
            raise Unrecognized(
                'branch entry %r contains %r, which can invert the meaning '
                'of another entry' % (entry, char))
    if not entry:
        raise Unrecognized('a `branches` entry is empty, which is not a branch '
                           'pattern')
    unknown = sorted(set(entry) - PATTERN_CHARS)
    if unknown:
        raise Unrecognized(
            'branch entry %r contains %s, which this guard does not recognize '
            'in a branch pattern; it cannot establish the entry is a valid '
            'positive pattern, and an entry GitHub cannot parse can make it '
            'refuse the whole workflow'
            % (entry, ', '.join(repr(char) for char in unknown)))
    return entry


def read_branches(push_node):
    """Return the push trigger's branch entries as raw text, or refuse."""
    branches_node = None
    for key, value in mapping_pairs(push_node, '`push:`', KNOWN_PUSH_KEYS):
        if key in DISQUALIFYING_PUSH_KEYS:
            raise Unrecognized('`push:` defines %s, which can suppress or '
                               'narrow the main-push run' % key)
        if key == 'branches':
            branches_node = value
    if branches_node is None:
        raise Unrecognized('`push:` does not name `branches`, so no push to a '
                           'named branch is guaranteed')
    if not isinstance(branches_node, yaml.SequenceNode):
        raise Unrecognized('`branches` is not a sequence')
    return [read_entry(item) for item in branches_node.value]


def evaluate(path):
    root = load_single_document(path)
    require_declared_jobs(root)
    branches = read_branches(read_push_block(root))
    if not branches:
        raise Unrecognized('`branches` is empty')
    if BRANCH not in branches:
        raise Unrecognized('no entry is the literal string %r; entries are %r'
                           % (BRANCH, branches))


def main(argv):
    if PARSER_MISSING is not None:
        # A check that skips itself when a dependency is missing reports "no
        # problem found" having looked at nothing, which is the defect this
        # whole guard exists to prevent, aimed at the guard's own dependency.
        sys.stderr.write(
            'CI must run on pushes to %s; release qualification requires a '
            'main-push run for the release SHA.\n'
            'This guard could not run at all: the YAML parser it reads the '
            'workflow with is not importable, so nothing about the workflow '
            'was established.\n'
            'Reason: PyYAML is not available: %s\n'
            'Install it in this environment (Debian and Ubuntu package it as '
            'python3-yaml). This guard fails rather than skipping, because a '
            'check that skips itself reports success having inspected '
            'nothing.\n' % (BRANCH, PARSER_MISSING))
        return 1
    try:
        evaluate(argv[1])
    except Unrecognized as error:
        sys.stderr.write(
            'CI must run on pushes to %s; release qualification requires a '
            'main-push run for the release SHA.\n'
            'This guard recognizes one shape only: a single YAML document '
            'whose top-level keys are workflow keys it knows, whose `on:` key '
            'holds a `push:` block naming `branches` and no '
            '`branches-ignore`, `paths` or `paths-ignore`, whose branch '
            'entries are strings made of branch-pattern characters and free '
            'of `!` and backslash, and one of which is the bare literal '
            '`%s`. No key may be spelled twice, by text or by resolution, and '
            'no node the trigger is read from may carry an anchor, an alias '
            'or an explicit tag. Anything it cannot establish is refused '
            'rather than assumed.\n'
            'Reason: %s\n'
            'If you are widening the workflow deliberately, widen this guard '
            'in the same commit.\n' % (BRANCH, BRANCH, error))
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
CI_PUSH_TRIGGER_PY

# The real workflow, which is the only file this guard exists to decide about.
"$python_bin" "$guard_py" "$workflow" || exit 1

# Everything below runs the same guard over a committed corpus of mutations of that
# same file. Running the guard against one input that is expected to pass proves the
# guard is satisfiable, not that it discriminates: a guard that accepted everything
# would pass that check too. The corpus is what separates those two, and it is
# committed rather than generated in a scratch directory so that the number below is
# reproducible by anyone, on any machine, after the session that measured it is gone.
fixtures="$repo_root/tests/fixtures/ci-classification"
generator="$fixtures/generate"
expectations="$fixtures/expectations.tsv"

# A corpus derived from a file that has since moved is a corpus that no longer means
# what its case names say. Regenerating and comparing costs one process and turns
# that from a silent rot into a failure with instructions.
"$python_bin" "$generator" --check || exit 1

wrong=0
total=0
while IFS=$'\t' read -r name expect reason; do
  [[ -n "$name" ]] || continue
  total=$((total + 1))
  fixture="$fixtures/cases/$name.yml"
  if [[ ! -f "$fixture" ]]; then
    printf 'Fixture %s is named in expectations.tsv and does not exist.\n' "$name" >&2
    wrong=$((wrong + 1))
    continue
  fi
  if guard_output="$("$python_bin" "$guard_py" "$fixture" 2>&1)"; then
    actual=ACCEPT
  else
    actual=REFUSE
  fi
  if [[ "$actual" != "$expect" ]]; then
    wrong=$((wrong + 1))
    printf 'WRONG %-38s expected %s, got %s\n  case: %s\n' \
      "$name" "$expect" "$actual" "$reason" >&2
    if [[ "$actual" == REFUSE ]]; then
      printf '%s\n' "$guard_output" | sed -n 's/^Reason: /  guard: /p' >&2
    fi
  fi
done < "$expectations"

if (( total == 0 )); then
  printf 'The fixture corpus is empty, so this gate inspected nothing.\n' >&2
  exit 1
fi

if (( wrong > 0 )); then
  printf '%d of %d workflow fixtures were classified wrongly.\n' "$wrong" "$total" >&2
  printf 'A case and the guard disagree. One of them is a defect; fix that one, and do\n' >&2
  printf 'not move the expectation to match the behaviour.\n' >&2
  exit 1
fi

printf 'CI push-trigger guard agreed with all %d workflow fixtures.\n' "$total"
printf 'CI classification and Required CI contract tests passed.\n'
