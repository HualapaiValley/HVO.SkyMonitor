verify_component_plan "src/HVO.SkyMonitor.Deployment.Contracts/Installation.cs"        full true  false false false false false true
verify_component_plan "tests/HVO.SkyMonitor.Deployment.Cli.Tests/InstallerTests.cs"    full true  false false false false false true
verify_component_plan "tools/HVO.SkyMonitor.Deployment.ReleaseTool/Program.cs"         full true  false false false false false true

verify_deployment_installer_path() {
  local path="$1" deployment_base deployment_head
  deployment_base="$(git -C "$work_root" rev-parse HEAD)"
  commit_file "$path"
  deployment_head="$(git -C "$work_root" rev-parse HEAD)"
  expect_plan full true pull_request "$deployment_base" "$deployment_head"
  expect_suites false false true pull_request "$deployment_base" "$deployment_head"
}

# Release-shell validation changes must select the tests that execute their gates even when no .NET path changes.
verify_deployment_installer_path "scripts/release:cameraagent-image"
verify_deployment_installer_path "scripts/lib/component-inventory.jq"
verify_deployment_installer_path "scripts/lib/component-inventory-count.jq"

# Deployment inputs that are not project directories keep their independent
# deployment-contract selection and otherwise stay on the complete matrix,
# because test code reads several of them from the repository root at run time.
verify_component_plan "deploy/split-host/compose.logichost.yml"                        full true  true  true  true  true  true  true
verify_component_plan "deploy/sql/logichost-runtime-role.sql"                          full true  true  true  true  true  true  true
verify_component_plan "deploy/split-host/camera-modules/allsky01.virtual-asi676mc.full.json" full true true true true true true true
verify_component_plan "docs/catalog/hyg-v42-license.md"                                full false true  true  true  true  true  true
verify_component_plan "scripts/deploy/product-layout.sh"                               full true  true  true  true  true  true  true
verify_component_plan "scripts/catalog/install-hyg-v42.sh"                             full true  true  true  true  true  true  true

# Every host namespace the combined suites reference must reach the combined
# lane. This is checked against the real sources rather than a hand-maintained
# list, and it matches plain, global, static, aliased, and fully qualified
# references, so a host directory cannot silently become host-private.
expect_combined_probe() {
  local probe="$1" probe_base probe_head output
  probe_base="$(git -C "$work_root" rev-parse HEAD)"
  commit_file "$probe"
  probe_head="$(git -C "$work_root" rev-parse HEAD)"
  output="$(cd "$work_root" && "$classifier" pull_request "$probe_base" "$probe_head")"
  grep -Fxq 'combined=true' <<< "$output" || {
    printf 'A file the combined suites depend on does not select the combined lane: %s\n' "$probe" >&2
    exit 1
  }
}

combined_namespace_count=0
while IFS= read -r combined_namespace; do
  case "$combined_namespace" in
    HVO.SkyMonitor.CameraAgent.Common.*)
      seam_project="src/HVO.SkyMonitor.CameraAgent.Common"
      seam_segment="${combined_namespace#HVO.SkyMonitor.CameraAgent.Common.}"
      ;;
    HVO.SkyMonitor.CameraAgent.*)
      seam_project="src/HVO.SkyMonitor.CameraAgent"
      seam_segment="${combined_namespace#HVO.SkyMonitor.CameraAgent.}"
      ;;
    HVO.SkyMonitor.LogicHost.*)
      seam_project="src/HVO.SkyMonitor.LogicHost"
      seam_segment="${combined_namespace#HVO.SkyMonitor.LogicHost.}"
      ;;
    *) continue ;;
  esac
  seam_segment="${seam_segment%%.*}"
  [[ -d "$repo_root/$seam_project/$seam_segment" ]] || continue
  ((combined_namespace_count += 1))
  expect_combined_probe "$seam_project/$seam_segment/CombinedSeamProbe.cs"
done < <(grep -rhoE 'HVO\.SkyMonitor\.(CameraAgent(\.Common)?|LogicHost)\.[A-Za-z0-9_]+' \
  --include='*.cs' \
  "$repo_root/tests/HVO.SkyMonitor.CameraAgent.LogicHost.Tests" \
  "$repo_root/tests/HVO.SkyMonitor.CameraAgent.LogicHost.IntegrationTests" \
  | sort -u)

if (( combined_namespace_count == 0 )); then
  printf 'No combined host namespace was discovered; the seam cross-check is not exercising anything.\n' >&2
  exit 1
fi

# An assembly that grants its internals to a combined suite is part of what the
# combined lane compiles, so the file carrying that grant must select combined.
internals_grant_count=0
while IFS= read -r grant_file; do
  ((internals_grant_count += 1))
  expect_combined_probe "${grant_file#"$repo_root/"}"
done < <(grep -rl --include='*.cs' -E 'InternalsVisibleTo\("HVO\.SkyMonitor\.CameraAgent\.LogicHost' \
  "$repo_root/src" 2>/dev/null || true)

if (( internals_grant_count == 0 )); then
  printf 'No combined internals grant was discovered; the grant cross-check is not exercising anything.\n' >&2
  exit 1
fi

# A source compiled into another project through an MSBuild <Compile Include>
# link must select at least everything a file in the including project selects.
# The real project files are copied into the fixture repository so the classifier
# resolves the same links CI resolves.
while IFS= read -r linked_csproj; do
  mkdir -p "$work_root/$(dirname "$linked_csproj")"
  cp "$repo_root/$linked_csproj" "$work_root/$linked_csproj"
done < <(cd "$repo_root" && git ls-files 'src/*/*.csproj' 'tests/*/*.csproj' 'tools/*/*.csproj')
git -C "$work_root" add --all
git -C "$work_root" commit --quiet -m "Add real project files for link classification"

plan_flags() {
  local probe="$1" marker="$2" flag_base flag_head
  flag_base="$(git -C "$work_root" rev-parse HEAD)"
  mkdir -p "$work_root/$(dirname "$probe")"
  printf 'link classification fixture %s\n' "$marker" > "$work_root/$probe"
  git -C "$work_root" add -- "$probe"
  git -C "$work_root" commit --quiet -m "Probe $probe $marker"
  flag_head="$(git -C "$work_root" rev-parse HEAD)"
  (cd "$work_root" && "$classifier" pull_request "$flag_base" "$flag_head") \
    | grep -E '^(complete|shared|cameraagent|logichost|combined|delivery)='
}

mapfile -t link_records < <(cd "$repo_root" && git ls-files '*/*/*.csproj' | while IFS= read -r csproj; do
  csproj_top="${csproj%%/*}"
  including="$(basename "$(dirname "$csproj")")"
  { grep -oE 'Include="(\.\.[\\/])+[^"]+"' "$csproj" 2>/dev/null || true; } | while IFS= read -r include; do
    include="${include#Include=\"}"
    include="${include%\"}"
    include="${include//\\//}"
    if [[ "$include" == ../../* ]]; then
      printf '%s|%s\n' "$including" "${include#../../}"
    elif [[ "$include" == ../* ]]; then
      printf '%s|%s/%s\n' "$including" "$csproj_top" "${include#../}"
    fi
  done
done | sort -u)

if (( ${#link_records[@]} == 0 )); then
  printf 'No linked source was discovered; the link ownership cross-check is not exercising anything.\n' >&2
  exit 1
fi

link_probe_index=0
for link_record in "${link_records[@]}"; do
  including_project="${link_record%%|*}"
  linked_source="${link_record#*|}"
  [[ -n "$including_project" && -n "$linked_source" ]] || continue
  [[ "$linked_source" != *.csproj ]] || continue
  # A wildcard include cannot name one repository path. Prove its directory
  # already fails closed instead of assuming it.
  if [[ "$linked_source" == *'*'* || "$linked_source" == *'?'* ]]; then
    ((link_probe_index += 1))
    wildcard_flags="$(plan_flags "$(dirname "$linked_source")/WildcardProbe.cs" "wildcard-$link_probe_index")"
    grep -Fxq 'complete=true' <<< "$wildcard_flags" || {
      printf 'Wildcard include %s covers a directory that does not select the complete matrix.\n' \
        "$linked_source" >&2
      exit 1
    }
    continue
  fi
  [[ -e "$repo_root/$linked_source" ]] || {
    printf 'Project link does not resolve to a repository path: %s -> %s\n' \
      "$including_project" "$linked_source" >&2
    exit 1
  }
  ((link_probe_index += 1))
  mapfile -t including_matches < <(cd "$repo_root" && git ls-files "*/$including_project/*.csproj")
  if (( ${#including_matches[@]} != 1 )); then
    printf 'Project directory name is ambiguous across top-level directories: %s\n' "$including_project" >&2
    exit 1
  fi
  including_directory="$(dirname "${including_matches[0]}")"
  including_flags="$(plan_flags "$including_directory/LinkOwnerProbe.cs" "owner-$link_probe_index")"
  linked_flags="$(plan_flags "$linked_source" "linked-$link_probe_index")"
  while IFS= read -r flag; do
    [[ "$flag" == *=true ]] || continue
    grep -Fxq "$flag" <<< "$linked_flags" || {
      printf 'Linked source %s does not select %s, which its including project %s requires.\n' \
        "$linked_source" "$flag" "$including_project" >&2
      exit 1
    }
  done <<< "$including_flags"
done

if (( link_probe_index < 60 )); then
  printf 'Only %s project links were classified; the cross-check is not enumerating the repository.\n' \
    "$link_probe_index" >&2
  exit 1
fi

# The enumerator must scan project files outside tests/, and must resolve links
# that leave the project's own top-level directory. Both are the widenings this
# cross-check exists to keep.
mapfile -t link_including_projects < <(printf '%s\n' "${link_records[@]}" | cut -d'|' -f1 | sort -u)
mapfile -t src_project_names < <(cd "$repo_root" && git ls-files 'src/*/*.csproj' \
  | while IFS= read -r candidate; do basename "$(dirname "$candidate")"; done | sort -u)
comm -12 <(printf '%s\n' "${link_including_projects[@]}") <(printf '%s\n' "${src_project_names[@]}") \
  | grep -q . || {
  printf 'No src/ project file contributed a link record; the enumerator narrowed to tests/.\n' >&2
  exit 1
}
printf '%s\n' "${link_records[@]}" | grep -qE '^[^|]*\|(docs|deploy)/' || {
  printf 'No link outside src/, tests/, and tools/ was resolved; the depth widening regressed.\n' >&2
  exit 1
}

# Every real project directory must be claimed by a component, except the
# intentionally cross-cutting ones. A new project therefore cannot slip into a
# narrow plan without an explicit decision here.
complete_matrix_projects=(
  tests/HVO.SkyMonitor.Architecture.Tests
)
project_directory_count=0
while IFS= read -r project_directory; do
  ((project_directory_count += 1))
  if printf '%s\n' "${complete_matrix_projects[@]}" | grep -Fxq -- "$project_directory"; then
    continue
  fi
  probe_base="$(git -C "$work_root" rev-parse HEAD)"
  commit_file "$project_directory/ClassificationProbe.cs"
  probe_head="$(git -C "$work_root" rev-parse HEAD)"
  probe_output="$(cd "$work_root" && "$classifier" pull_request "$probe_base" "$probe_head")"
  if grep -Fxq 'complete=true' <<< "$probe_output"; then
    printf 'Project directory is not claimed by any component and falls back to the complete matrix: %s\n' \
      "$project_directory" >&2
    exit 1
  fi
done < <(cd "$repo_root" && git ls-files 'src/*/*.csproj' 'tests/*/*.csproj' 'tools/*/*.csproj' \
  | while IFS= read -r project; do dirname "$project"; done | sort -u)

if (( project_directory_count < 40 )); then
  printf 'Only %s project directories were classified; the orphan cross-check is not enumerating the repository.\n' \
    "$project_directory_count" >&2
  exit 1
fi

# An otherwise-allowlisted path that a project compiles, embeds, or copies leaves
# reduced mode. It is outside every project directory, so it still selects the
# complete matrix rather than only its including projects' lanes.
verify_component_plan "THIRD-PARTY-NOTICES.md" full false true true true true true true

# Cross-cutting inputs always select the complete solution matrix.
complete_matrix_paths=(
  ".github/workflows/ci.yml"
  ".github/workflows/release.yml"
  "scripts/ci:classify"
  "scripts/ci:require"
  "scripts/ci:component-build"
  "scripts/test:ci-classification"
  "scripts/coverage:enforce"
  "scripts/coverage:component"
  "scripts/coverage:policy"
  "scripts/coverage/baseline.json"
  "scripts/coverage/Program.cs"
  "scripts/test-categories/Program.cs"
  "scripts/package:audit"
  "scripts/package-audit/allowlist.json"
  "tests/coverage.runsettings"
  "tests/HVO.SkyMonitor.Architecture.Tests/ArchitectureBoundaryTests.cs"
  "Directory.Build.props"
  "Directory.Packages.props"
  "dotnet-tools.json"
  "global.json"
  ".editorconfig"
  "HVO.SkyMonitor.v9.slnx"
  ".dockerignore"
  ".agents/skills/pr-lifecycle/scripts/helper.sh"
  "unknown/example.txt"
  "src/Example/Program.cs"
  "tests/Example.Tests/ExampleTests.cs"
  "tests/fixtures/frames/sample.bin"
  "tests/fixtures/catalog/hyg-v42-bright-stars.sqlite"
  "docs/validation/central-transient-fault-matrix.json"
  "docs/validation/logichost-ui-runtime-signals.json"
  "tools/asi-capture/capture.sh"
  "docker/local/Dockerfile"
)
for path in "${complete_matrix_paths[@]}"; do
  component_base="$(git -C "$work_root" rev-parse HEAD)"
  if [[ -f "$work_root/$path" ]]; then update_file "$path"; else commit_file "$path"; fi
  component_head="$(git -C "$work_root" rev-parse HEAD)"
  expect_components true true true true true true pull_request "$component_base" "$component_head"
done

