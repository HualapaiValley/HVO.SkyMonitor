#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
classifier="$repo_root/scripts/ci:classify"
required="$repo_root/scripts/ci:require"
workflow="$repo_root/.github/workflows/ci.yml"
work_root="$(mktemp -d)"
trap 'rm -rf "$work_root"' EXIT

git -C "$work_root" init --quiet
git -C "$work_root" config user.email ci-classification@example.invalid
git -C "$work_root" config user.name "CI Classification Test"
git -C "$work_root" commit --quiet --allow-empty -m baseline

result_jobs=(
  changes
  quality
  catalog-contracts
  deployment-contracts
  build
  architecture
  coverage-policy
  migrations-cameraagent
  migrations-logichost
  unit
  integration
  coverage
  shared-libraries
  cameraagent-component
  logichost-component
  combined-integration
  delivery-component
)

expect_plan() {
  local expected_mode="$1"
  local expected_deployment="$2"
  local event_name="$3"
  local base_sha="$4"
  local head_sha="$5"
  local output

  output="$(cd "$work_root" && "$classifier" "$event_name" "$base_sha" "$head_sha")"
  if [[ "$output" != "mode=$expected_mode"$'\n'"deployment=$expected_deployment"$'\n'* ]]; then
    printf 'Expected mode=%s deployment=%s, received %s\n' "$expected_mode" "$expected_deployment" "$output" >&2
    exit 1
  fi
}

expect_suites() {
  local expected_catalog="$1" expected_shards="$2" expected_installer="$3"
  local event_name="$4" base_sha="$5" head_sha="$6" output
  output="$(cd "$work_root" && "$classifier" "$event_name" "$base_sha" "$head_sha")"
  for expectation in \
    "deployment_catalog=$expected_catalog" \
    "deployment_shards=$expected_shards" \
    "deployment_installer=$expected_installer"; do
    grep -Fxq "$expectation" <<< "$output" || {
      printf 'Expected suite output %s, received %s\n' "$expectation" "$output" >&2
      exit 1
    }
  done
}

expect_components() {
  local expected_complete="$1" expected_shared="$2" expected_cameraagent="$3"
  local expected_logichost="$4" expected_combined="$5" expected_delivery="$6"
  local event_name="$7" base_sha="$8" head_sha="$9" output
  output="$(cd "$work_root" && "$classifier" "$event_name" "$base_sha" "$head_sha")"
  for expectation in \
    "complete=$expected_complete" \
    "shared=$expected_shared" \
    "cameraagent=$expected_cameraagent" \
    "logichost=$expected_logichost" \
    "combined=$expected_combined" \
    "delivery=$expected_delivery"; do
    grep -Fxq "$expectation" <<< "$output" || {
      printf 'Expected component output %s, received %s\n' "$expectation" "$output" >&2
      exit 1
    }
  done
}

commit_file() {
  local path="$1"
  mkdir -p "$work_root/$(dirname "$path")"
  printf 'classification fixture\n' > "$work_root/$path"
  git -C "$work_root" add -- "$path"
  git -C "$work_root" commit --quiet -m "Add $path"
}

update_file() {
  local path="$1"
  printf 'updated classification fixture\n' >> "$work_root/$path"
  git -C "$work_root" add -- "$path"
  git -C "$work_root" commit --quiet -m "Update $path"
}

# Commit one representative diff and assert its complete validated plan.
verify_component_plan() {
  local path="$1" expected_mode="$2" expected_deployment="$3"
  local expected_complete="$4" expected_shared="$5" expected_cameraagent="$6"
  local expected_logichost="$7" expected_combined="$8" expected_delivery="$9"
  local component_base component_head

  component_base="$(git -C "$work_root" rev-parse HEAD)"
  if [[ -f "$work_root/$path" ]]; then
    update_file "$path"
  else
    commit_file "$path"
  fi
  component_head="$(git -C "$work_root" rev-parse HEAD)"
  expect_plan "$expected_mode" "$expected_deployment" pull_request "$component_base" "$component_head"
  expect_components "$expected_complete" "$expected_shared" "$expected_cameraagent" \
    "$expected_logichost" "$expected_combined" "$expected_delivery" \
    pull_request "$component_base" "$component_head"
}

base_sha="$(git -C "$work_root" rev-parse HEAD)"
allowlisted_paths=(
  "docs/runbooks/example.md"
  "README.md"
  "AGENTS.md"
  "CLAUDE.md"
  "THIRD-PARTY-NOTICES.md"
  ".agents/skills/pr-lifecycle/SKILL.md"
  ".devcontainer/devcontainer.json"
  ".vscode/settings.json"
  ".github/copilot-instructions.md"
  ".github/pull_request_template.md"
  ".github/prompts/example.md"
  "src/Example/README.md"
  "tests/Example.Tests/README.md"
  "tests/fixtures/catalog/SOURCE.md"
  "tests/fixtures/stellarium/SIMBAD_ENDPOINTS.md"
  "tools/asi-capture/README.md"
  "scripts/test:devcontainer"
)

for path in "${allowlisted_paths[@]}"; do
  mkdir -p "$work_root/$(dirname "$path")"
  printf 'allowlisted fixture\n' > "$work_root/$path"
done
git -C "$work_root" add --all
git -C "$work_root" commit --quiet -m "Add allowlisted paths"
head_sha="$(git -C "$work_root" rev-parse HEAD)"
expect_plan reduced false pull_request "$base_sha" "$head_sha"
expect_components false false false false false false pull_request "$base_sha" "$head_sha"
expect_plan full true push "$base_sha" "$head_sha"
expect_components true true true true true true push "$base_sha" "$head_sha"
expect_plan full true workflow_dispatch "$base_sha" "$head_sha"
expect_components true true true true true true workflow_dispatch "$base_sha" "$head_sha"
expect_suites true true true push "$base_sha" "$head_sha"
expect_suites true true true workflow_dispatch "$base_sha" "$head_sha"
summary_file="$work_root/.git/classification-summary.md"
(cd "$work_root" && GITHUB_STEP_SUMMARY="$summary_file" "$classifier" pull_request "$base_sha" "$head_sha" >/dev/null)
grep -Fq 'Mode: **reduced**' "$summary_file"
grep -Fq 'Deployment contracts: **false**' "$summary_file"
grep -Fq 'Complete matrix: **false**' "$summary_file"
grep -Fq 'Deployment reason: pull request does not change deployment-contract inputs' "$summary_file"

# Only the top-level skill manifest is reduced. Supporting files, including a
# nested file also named SKILL.md, fail closed to the complete matrix.
verify_component_plan ".agents/skills/pr-lifecycle/resources/SKILL.md" full false true true true true true true

# Component ownership. Shared contracts select every consuming lane, host-private
# paths stay in their own lane, and exported host seams add combined coverage.
verify_component_plan "src/HVO.SkyMonitor.AgentCore/Contract.cs"                       full false false true  true  true  true  true
verify_component_plan "src/HVO.SkyMonitor.Astronomy/Projection.cs"                     full false false true  true  true  true  true
verify_component_plan "src/HVO.SkyMonitor.Imaging/Codec.cs"                            full false false true  true  true  true  true
verify_component_plan "src/HVO.SkyMonitor.Processing/Recipe.cs"                        full false false true  true  true  true  true
verify_component_plan "src/HVO.SkyMonitor.ProcessingRunner/Program.cs"                 full false false true  true  true  true  true
verify_component_plan "src/HVO.SkyMonitor.ProcessingRunner.Contracts/Contract.cs"      full false false true  true  true  true  true
verify_component_plan "src/HVO.SkyMonitor.Catalog.Sqlite/Catalog.cs"                   full false false true  true  true  true  true
verify_component_plan "src/HVO.SkyMonitor.Common/Security/ApiKey.cs"                   full false false true  true  true  true  true
verify_component_plan "src/HVO.SkyMonitor.Fleet.Contracts/Registration.cs"             full false false true  true  true  true  true
verify_component_plan "src/HVO.SkyMonitor.TestSupport/Fixture.cs"                      full false false true  true  true  true  true
verify_component_plan "tests/HVO.SkyMonitor.Astronomy.Tests/ProjectionTests.cs"        full false false true  true  true  true  true
verify_component_plan "tests/HVO.SkyMonitor.AgentCore.Tests/ContractTests.cs"          full false false true  true  true  true  true

verify_component_plan "src/HVO.SkyMonitor.CameraAgent/Components/Home.razor"           full false false false true  false false false
verify_component_plan "src/HVO.SkyMonitor.CameraAgent/Components/Account/Login.razor"  full false false false true  false true  false
verify_component_plan "src/HVO.SkyMonitor.LogicHost/Components/Account/Login.razor"    full false false false false true  true  false
verify_component_plan "src/HVO.SkyMonitor.CameraAgent/wwwroot/site.css"                full false false false true  false false false
verify_component_plan "src/HVO.SkyMonitor.CameraAgent.Common/Imaging/Filter.cs"        full false false false true  false false false
verify_component_plan "src/HVO.SkyMonitor.CameraAgent.Common/Storage/LocalStore.cs"     full false false false true  false false false
verify_component_plan "src/HVO.SkyMonitor.CameraAgent.Common/Gallery/Thumbnail.cs"      full false false false true  false false false
verify_component_plan "src/HVO.SkyMonitor.CameraAgent.Modules.Zwo/Module.cs"           full false false false true  false false false
verify_component_plan "src/HVO.SkyMonitor.CameraAgent.Replay/Transport.cs"             full false false false true  false false false
verify_component_plan "src/HVO.SkyMonitor.CameraAgent.ReplayRunner/Program.cs"         full false false false true  false false false
verify_component_plan "tests/HVO.SkyMonitor.CameraAgent.Tests/CaptureTests.cs"         full false false false true  false false false
