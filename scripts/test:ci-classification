  "$(results changes=success quality=success catalog-contracts=success build=success \
    architecture=success coverage-policy=success migrations-cameraagent=success \
    migrations-logichost=success unit=success integration=success coverage=success)"

invalid_plans=(
  "reduced|$(plan reduced false false false false false false false)|push"
  "complete on a reduced mode|$(plan reduced true true true true true true false)|pull_request"
  "reduced with a component lane|$(plan reduced false false true false false false false)|pull_request"
  "reduced with deployment contracts|$(plan reduced false false false false false false true)|pull_request"
  "full without any selection|$(plan full false false false false false false false)|pull_request"
  "complete without every lane|$(plan full true true true true true false false)|pull_request"
  "unknown mode|$(plan unknown false false true false false false false)|pull_request"
  "non-boolean flag|$(plan full maybe false true false false false false)|pull_request"
  "push without the complete matrix|$(plan full false false true false false false true)|push"
  "push without deployment contracts|$(plan full true true true true true true false)|push"
)
for entry in "${invalid_plans[@]}"; do
  IFS='|' read -r label plan_value event_value <<< "$entry"
  expect_required_reject "$label" "$event_value" "$plan_value" "$complete_success"
done

expect_required_reject "missing plan key" pull_request \
  "mode=full complete=false shared=false cameraagent=true logichost=false combined=false delivery=false" \
  "$cameraagent_success"
expect_required_reject "unknown plan key" pull_request \
  "$cameraagent_plan extra=true" "$cameraagent_success"
expect_required_reject "duplicate plan key" pull_request \
  "$cameraagent_plan mode=reduced" "$cameraagent_success"
expect_required_reject "missing job result" pull_request "$cameraagent_plan" \
  "${cameraagent_success/ delivery-component=skipped/}"
expect_required_reject "unknown job result" pull_request "$cameraagent_plan" \
  "$cameraagent_success migrations=success"
expect_required_reject "unusable job result" pull_request "$cameraagent_plan" \
  "${cameraagent_success/cameraagent-component=success/cameraagent-component=neutral}"
expect_required_reject "empty plan" pull_request "" "$cameraagent_success"
expect_required_reject "empty results" pull_request "$cameraagent_plan" ""

# Workflow shape.
grep -Fq "if: needs.changes.outputs.mode == 'full' && github.event_name == 'workflow_dispatch'" "$workflow" || {
  printf 'Historical Phase 14 acceptance must remain manual-dispatch only.\n' >&2
  exit 1
}
for suite in catalog shards installer; do
  grep -Fq "if: needs.changes.outputs.deployment_$suite == 'true'" "$workflow" || {
    printf 'Exhaustive deployment suite is not controlled by its classifier output: %s\n' "$suite" >&2
    exit 1
  }
done

extract_workflow_job() {
  local target="$1" line job_name capturing=false
  while IFS= read -r line; do
    if [[ "$line" =~ ^[[:space:]]{2}([a-z0-9-]+):[[:space:]]*$ ]]; then
      job_name="${BASH_REMATCH[1]}"
      if [[ "$capturing" == true ]]; then
        break
      fi
      if [[ "$job_name" == "$target" ]]; then
        capturing=true
      fi
    fi
    if [[ "$capturing" == true ]]; then
      printf '%s\n' "$line"
    fi
  done < "$workflow"
}

grep -Fq 'types: [opened, synchronize, reopened, ready_for_review, converted_to_draft]' "$workflow" || {
  printf 'Pull request CI must follow ready/draft review transitions.\n' >&2
  exit 1
}
changes_job="$(extract_workflow_job changes)"
grep -Fxq "    if: github.event_name != 'pull_request' || github.event.pull_request.draft == false" <<< "$changes_job" || {
  printf 'Draft pull requests must not start the classifier-selected CI plan.\n' >&2
  exit 1
}
for output in mode deployment complete shared cameraagent logichost combined delivery; do
  # shellcheck disable=SC2016 # The workflow expression is intentionally literal.
  grep -Fq "      $output: \${{ steps.classify.outputs.$output }}" <<< "$changes_job" || {
    printf 'Change Classification must publish the %s plan output.\n' "$output" >&2
    exit 1
  }
done

# Every gate is derived from the validated plan, and every aggregated job is
# required by the aggregation job.
required_job="$(extract_workflow_job required)"
grep -Fxq '    if: always()' <<< "$required_job" || {
  printf 'Required CI must report a conclusion for every pull request head.\n' >&2
  exit 1
}
for job in "${result_jobs[@]}"; do
  [[ "$job" != "changes" ]] || continue
  grep -Fq "$job," <<< "$required_job" || grep -Fq "$job]" <<< "$required_job" || {
    printf 'Required CI does not depend on the aggregated job: %s\n' "$job" >&2
    exit 1
  }
  # shellcheck disable=SC2016 # The workflow expression is intentionally literal.
  grep -Fq "            $job=\${{ needs.$job.result }}" <<< "$required_job" || {
    printf 'Required CI does not forward the result of: %s\n' "$job" >&2
    exit 1
  }
done
for key in mode complete shared cameraagent logichost combined delivery deployment; do
  # shellcheck disable=SC2016 # The workflow expression is intentionally literal.
  grep -Fq "            $key=\${{ needs.changes.outputs.$key }}" <<< "$required_job" || {
    printf 'Required CI does not forward the plan key: %s\n' "$key" >&2
    exit 1
  }
done
grep -Fq './scripts/ci:require "$EVENT_NAME" "$PLAN" "$RESULTS"' <<< "$required_job" || {
  printf 'Required CI must aggregate through the plan-derived contract script.\n' >&2
  exit 1
}
draft_failure_step=$'      - name: Block merge while review is in progress\n        if: github.event_name == '\''pull_request'\'' && github.event.pull_request.draft == true\n        run: |\n          echo '\''Required CI is intentionally blocked while the pull request is draft.'\'' >&2\n          exit 1'
grep -Fq "$draft_failure_step" <<< "$required_job" || {
  printf 'Draft Required CI must fail closed rather than conclude skipped.\n' >&2
  exit 1
}
for step_name in 'Checkout' 'Require every current-head gate'; do
  non_draft_step=$'      - name: '"$step_name"$'\n        if: github.event_name != '\''pull_request'\'' || github.event.pull_request.draft == false'
  grep -Fq "$non_draft_step" <<< "$required_job" || {
    printf 'Required CI step must run only for a non-draft head: %s\n' "$step_name" >&2
    exit 1
  }
done
grep -Fq "if: always() && needs.changes.outputs.deployment_shards == 'true'" "$workflow" || {
  printf 'Deployment shard log upload must follow the shard classifier output.\n' >&2
  exit 1
}

# Cross-cutting gates never depend on component selection.
for job in catalog-contracts build architecture coverage-policy \
  migrations-cameraagent migrations-logichost; do
  job_body="$(extract_workflow_job "$job")"
  grep -Fxq "    if: needs.changes.outputs.mode == 'full'" <<< "$job_body" || {
    printf 'Cross-cutting gate must run for every full-mode head: %s\n' "$job" >&2
    exit 1
  }
done

# The Architecture & Publish gate owns both category selections of the
# architecture project, so no component plan can drop the Unit boundary cases.
architecture_job="$(extract_workflow_job architecture)"
grep -Fq 'tests/HVO.SkyMonitor.Architecture.Tests/HVO.SkyMonitor.Architecture.Tests.csproj --no-build --configuration Release --filter "$UNIT_FILTER"' <<< "$architecture_job" || {
  printf 'Architecture & Publish must run the Architecture Unit selection.\n' >&2
  exit 1
}
grep -Fq 'tests/HVO.SkyMonitor.Architecture.Tests/HVO.SkyMonitor.Architecture.Tests.csproj --no-build --configuration Release --filter "TestCategory=Integration&FullyQualifiedName~ArchitectureBoundaryTests"' <<< "$architecture_job" || {
  printf 'Architecture & Publish must run the Architecture Integration selection.\n' >&2
  exit 1
}
for job in unit integration coverage; do
  job_body="$(extract_workflow_job "$job")"
  grep -Fxq "    if: needs.changes.outputs.complete == 'true'" <<< "$job_body" || {
    printf 'Complete solution gate must follow the complete classifier output: %s\n' "$job" >&2
    exit 1
  }
done

# Badge publication is optional operational metadata. Its credential stays in
# the Actions secret store, its public Gist ID stays in a repository variable,
# and neither an absent credential nor an endpoint outage can falsify Required CI.
badges_job="$(extract_workflow_job badges)"
grep -Fxq "    if: github.ref == 'refs/heads/main'" <<< "$badges_job" || {
  printf 'Coverage badges must publish only from main.\n' >&2
  exit 1
}
grep -Fxq '    permissions: {}' <<< "$badges_job" || {
  printf 'Coverage badge publication must not receive repository permissions.\n' >&2
  exit 1
}
# shellcheck disable=SC2016 # The workflow expressions are intentionally literal.
grep -Fq 'BADGE_GIST_TOKEN: ${{ secrets.GIST_TOKEN }}' <<< "$badges_job" || {
  printf 'Coverage badge publication must use the repository GIST_TOKEN secret.\n' >&2
  exit 1
}
# shellcheck disable=SC2016 # The workflow expressions are intentionally literal.
grep -Fq 'BADGE_GIST_ID: ${{ vars.COVERAGE_GIST_ID }}' <<< "$badges_job" || {
  printf 'Coverage badge publication must use the public repository Gist ID variable.\n' >&2
  exit 1
}
if grep -Fq 'secrets.COVERAGE_GIST_ID' <<< "$badges_job"; then
  printf 'The public coverage Gist ID must not be stored as a secret.\n' >&2
  exit 1
fi
badge_continue_count="$(grep -Fc 'continue-on-error: true' <<< "$badges_job" || true)"
if (( badge_continue_count != 1 )); then
  printf 'Only the bounded coverage badge publication step must be best-effort.\n' >&2
  exit 1
fi
grep -Fq -- '--connect-timeout 10' <<< "$badges_job" || {
  printf 'Coverage badge publication must bound the Gist connection attempt.\n' >&2
  exit 1
}
grep -Fq -- '--max-time 45' <<< "$badges_job" || {
  printf 'Coverage badge publication must bound each Gist transfer.\n' >&2
  exit 1
}
grep -Fq -- '--retry-max-time 120' <<< "$badges_job" || {
  printf 'Coverage badge publication must bound its retry window below the job timeout.\n' >&2
  exit 1
}
badge_patch_count="$(grep -Fc -- '--request PATCH' <<< "$badges_job" || true)"
if (( badge_patch_count != 1 )); then
  printf 'Coverage badge publication must use one atomic Gist PATCH request.\n' >&2
  exit 1
fi
for badge_file in coverage-line.json coverage-branch.json; do
  grep -Fq "\"$badge_file\": {content:" <<< "$badges_job" || {
    printf 'Atomic coverage badge payload is missing %s.\n' "$badge_file" >&2
    exit 1
  }
done
grep -Fq 'https://api.github.com/gists/$BADGE_GIST_ID' <<< "$badges_job" || {
  printf 'Coverage badge publication must use the configured Gist API endpoint.\n' >&2
  exit 1
}
grep -Fq 'curl --disable --config -' <<< "$badges_job" || {
  printf 'Coverage badge publication must disable ambient curl configuration before loading the token.\n' >&2
  exit 1
}
grep -Fq 'header = "Authorization: Bearer %s"' <<< "$badges_job" || {
  printf 'Coverage badge publication must keep the credential out of process arguments.\n' >&2
  exit 1
}
grep -Fq 'line <= 100 && branch <= 100' <<< "$badges_job" || {
  printf 'Coverage badge publication must reject percentages above 100.\n' >&2
  exit 1
}
# shellcheck disable=SC2016 # Workflow shell variables are intentionally literal.
grep -Fq -- '--argjson line "$line_badge"' <<< "$badges_job" || {
  printf 'Coverage badge publication must verify the complete returned line badge.\n' >&2
  exit 1
}
# shellcheck disable=SC2016 # Workflow shell variables are intentionally literal.
grep -Fq -- '--argjson branch "$branch_badge"' <<< "$badges_job" || {
  printf 'Coverage badge publication must verify the complete returned branch badge.\n' >&2
  exit 1
}
# shellcheck disable=SC2016 # Workflow shell variables are intentionally literal.
grep -Fq '(.files["coverage-line.json"].content | fromjson) == $line' <<< "$badges_job" || {
  printf 'Coverage badge publication must compare the complete returned line document.\n' >&2
  exit 1
}
# shellcheck disable=SC2016 # Workflow shell variables are intentionally literal.
grep -Fq '(.files["coverage-branch.json"].content | fromjson) == $branch' <<< "$badges_job" || {
  printf 'Coverage badge publication must compare the complete returned branch document.\n' >&2
  exit 1
}
if grep -Fq 'dynamic-badges-action' <<< "$badges_job"; then
  printf 'Coverage badge publication must use the bounded first-party API request.\n' >&2
  exit 1
fi
grep -Fq 'Report unconfigured coverage badge publication' <<< "$badges_job" || {
  printf 'Missing badge configuration must produce an explicit warning.\n' >&2
  exit 1
}
grep -Fq 'Report coverage badge publication failure' <<< "$badges_job" || {
  printf 'Failed badge publication must produce an explicit warning.\n' >&2
  exit 1
}

for host in cameraagent logichost; do
  job_body="$(extract_workflow_job "migrations-$host")"
  grep -Fq "./scripts/ci:canonical-migration $host" <<< "$job_body" || {
    printf 'Split migration gate must enforce its canonical migration: %s\n' "$host" >&2
    exit 1
  }
done

declare -A lane_jobs=(
  [shared]=shared-libraries
  [cameraagent]=cameraagent-component
  [logichost]=logichost-component
  [combined]=combined-integration
  [delivery]=delivery-component
)
for component in "${!lane_jobs[@]}"; do
  job_body="$(extract_workflow_job "${lane_jobs[$component]}")"
  grep -Fxq "    if: needs.changes.outputs.complete == 'false' && needs.changes.outputs.$component == 'true'" <<< "$job_body" || {
    printf 'Component lane must follow its classifier output without duplicating the complete matrix: %s\n' "$component" >&2
    exit 1
  }
  grep -Fq "./scripts/ci:component-build $component" <<< "$job_body" || {
    printf 'Component lane must restore and build from its own project roots: %s\n' "$component" >&2
    exit 1
  }
  grep -Fq "./scripts/coverage:component $component" <<< "$job_body" || {
    printf 'Component lane must enforce its own coverage baseline: %s\n' "$component" >&2
    exit 1
  }
  if [[ "$component" != "combined" ]]; then
    grep -Fq "./scripts/ci:component-publish $component" <<< "$job_body" || {
      printf 'Component lane must publish its own shipping outputs: %s\n' "$component" >&2
      exit 1
    }
  fi
  [[ -f "$repo_root/scripts/coverage/baseline.$component.json" ]] || {
    printf 'Component lane has no coverage baseline: %s\n' "$component" >&2
    exit 1
  }
  lane_slot_count=0
  while IFS= read -r slot; do
    ((lane_slot_count += 1))
    grep -Fq -- "--results-directory $slot " <<< "$job_body" || {
      printf 'Component lane %s does not produce its expected coverage slot: %s\n' "$component" "$slot" >&2
      exit 1
    }
  done < <("$repo_root/scripts/coverage:component" --list-slots "$component")
  (( lane_slot_count > 0 )) || {
    printf 'Component lane declares no coverage slot: %s\n' "$component" >&2
    exit 1
  }
done

# Every component coverage slot must also belong to the aggregate rollup, and no
# slot may be claimed by two components.
declare -A slot_owner=()
slot_count=0
while IFS= read -r component; do
  while IFS= read -r slot; do
    ((slot_count += 1))
    if [[ -n "${slot_owner[$slot]:-}" ]]; then
      printf 'Coverage slot %s is claimed by both %s and %s\n' "$slot" "${slot_owner[$slot]}" "$component" >&2
      exit 1
    fi
    slot_owner["$slot"]="$component"
    grep -Fq "'$slot/*/coverage.cobertura.xml'" "$workflow" || {
      printf 'Component coverage slot is missing from the aggregate rollup: %s\n' "$slot" >&2
      exit 1
    }
  done < <("$repo_root/scripts/coverage:component" --list-slots "$component")
done < <("$repo_root/scripts/coverage:component" --list-components)

if (( slot_count != 20 )); then
  printf 'Expected 20 component coverage slots across the five lanes, found %s.\n' "$slot_count" >&2
  exit 1
fi

release_workflow="$repo_root/.github/workflows/release.yml"
grep -Fq -- '-f branch=main -f event=push -f status=completed -f head_sha=' "$release_workflow" || {
  printf 'Release qualification must select completed exact-SHA main-push CI runs.\n' >&2
  exit 1
}
grep -Fq 'select(.name == "Required CI")' "$release_workflow" || {
  printf 'Release qualification must inspect the Required CI job.\n' >&2
  exit 1
}
if grep -Fq 'select(.conclusion == "success")' "$release_workflow"; then
  printf 'Release qualification must not require unrelated workflow jobs to succeed.\n' >&2
  exit 1
fi

printf 'CI classification and Required CI contract tests passed.\n'
