run_work_release_shard() {
  local shard_id="$1" include_negatives="$2"
  shift 2
  local repo="$work_root.release.$shard_id"
  cp -a "$work_root" "$repo"
  # Pre-seed files already present before release_scripts_paths in the sequential baseline
  # so their first probes preserve modification (M) diff status.
  seed_commit_files "$repo" \
    ".github/workflows/development-v1.yml" \
    "scripts/ci:classify"
  local release_scripts_cases=0
  local -a paths=("$@") specs=() pairs=()
  local path i base head output expected_status
  for path in "${paths[@]}"; do
    specs+=("$path|classification fixture"$'\n')
    specs+=("$path|classification fixture"$'\n'"updated classification fixture"$'\n')
  done
  batch_commit_pairs pairs "$repo" "$(( ${#paths[@]} * 2 ))" "${specs[@]}"
  for ((i = 0; i < ${#paths[@]} * 2; i++)); do
    read -r base head <<< "${pairs[$i]}"
    path="${paths[$((i / 2))]}"
    if (( i % 2 == 1 )) || [[ "$path" == ".github/workflows/development-v1.yml" || "$path" == "scripts/ci:classify" ]]; then
      expected_status="M"
    else
      expected_status="A"
    fi
    assert_diff_status "$repo" "$base" "$head" "$expected_status" "$path"
    output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
    assert_release_scripts_output "$output" true
  done
  if [[ "$include_negatives" == true ]]; then
    local -a neg_paths=(
      "scripts/release:other" "scripts/test:release-installer" ".github/workflows/release-other.yml"
      "tools/HVO.SkyMonitor.Deployment.ReleaseToolkit/Program.cs" "src/HVO.SkyMonitor.Deployment.Cli/ReleaseManifest.cs"
      ".gitleaks.toml" ".github/workflows/ci.yml" "Directory.Build.targets"
    )
    local -a neg_specs=() neg_pairs=()
    for path in "${neg_paths[@]}"; do
      neg_specs+=("$path|classification fixture"$'\n')
      neg_specs+=("$path|classification fixture"$'\n'"updated classification fixture"$'\n')
    done
    batch_commit_pairs neg_pairs "$repo" "$(( ${#neg_paths[@]} * 2 ))" "${neg_specs[@]}"
    for ((i = 1; i < ${#neg_paths[@]} * 2; i += 2)); do
      read -r base head <<< "${neg_pairs[$i]}"
      output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
      assert_release_scripts_output "$output" false
    done
    # Deleting a gated path must retain the tests.
    git -C "$repo" read-tree HEAD
    local release_base release_head
    release_base="$(git -C "$repo" rev-parse HEAD)"
    git -C "$repo" rm --cached --quiet scripts/release:push-image
    git -C "$repo" commit --quiet -m "Delete a release script"
    release_head="$(git -C "$repo" rev-parse HEAD)"
    output="$(classify_in_repo "$repo" pull_request "$release_base" "$release_head")"
    assert_release_scripts_output "$output" true
  fi
  printf '%d\n' "$release_scripts_cases" > "$parallel_dir/release_cases.shard.$shard_id"
}

run_work_catalog_recipe() {
  local repo="$work_root.catalog"
  cp -a "$work_root" "$repo"
  local catalog_recipe_cases=0
  local -a catalog_recipe_paths=(
    "scripts/catalog/build-hyg-v42.sh"
    "scripts/catalog/catalog-common.sh"
    "scripts/catalog/hyg-v44-openngc-common.sh"
    "scripts/catalog/openngc-v20260501-outlines.sha256"
    "scripts/catalog/test-hyg-v44-reproducibility.sh"
    "scripts/catalog/f7/controls/regression.py"
    "tests/fixtures/catalog/build-fixture.sql"
    "tests/fixtures/catalog/build-fixture-v44-openngc.sh"
    "tests/fixtures/catalog/SHA256SUMS-v44-openngc"
    "tests/fixtures/catalog/hyg-v44-openngc-subset-star-objects.csv"
    "tests/fixtures/catalog/hyg-v44-openngc-subset.sqlite"
    "tests/fixtures/catalog/hyg-v42-bright-stars.sqlite"
    "tests/fixtures/catalog/nested/recipe.sql"
  )
  local -a specs=() pairs=()
  local path i base head output
  for path in "${catalog_recipe_paths[@]}"; do
    specs+=("$path|classification fixture"$'\n')
    specs+=("$path|classification fixture"$'\n'"updated classification fixture"$'\n')
  done
  batch_commit_pairs pairs "$repo" "$(( ${#catalog_recipe_paths[@]} * 2 ))" "${specs[@]}"
  for ((i = 0; i < ${#catalog_recipe_paths[@]} * 2; i++)); do
    read -r base head <<< "${pairs[$i]}"
    path="${catalog_recipe_paths[$((i / 2))]}"
    output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
    assert_catalog_recipe_output "$output" true
    grep -Fxq 'mode=full' <<< "$output" || {
      printf 'A catalog-recipe change did not select full mode: %s\n' "$path" >&2
      exit 1
    }
  done

  local -a neg_paths=(
    "scripts/catalog:install" "scripts/catalogs/other.sh" "tests/fixtures/catalogue/other.sql"
    "tests/fixtures/stellarium/SIMBAD_ENDPOINTS.md" "docs/catalog/hyg-v44-reproducibility.md"
    "docs/catalog/hyg-v42-attribution.md" "src/HVO.SkyMonitor.Catalog.Sqlite/Catalog.cs"
    "tests/HVO.SkyMonitor.Catalog.Sqlite.Tests/CatalogTests.cs" "scripts/release:assets"
    ".github/workflows/ci.yml" ".github/workflows/release.yml" "scripts/ci:classify" "scripts/ci:require"
    "scripts/test:ci-classification"
  )
  local -a neg_specs=() neg_pairs=()
  for path in "${neg_paths[@]}"; do
    neg_specs+=("$path|classification fixture"$'\n')
    neg_specs+=("$path|classification fixture"$'\n'"updated classification fixture"$'\n')
  done
  batch_commit_pairs neg_pairs "$repo" "$(( ${#neg_paths[@]} * 2 ))" "${neg_specs[@]}"
  for ((i = 1; i < ${#neg_paths[@]} * 2; i += 2)); do
    read -r base head <<< "${neg_pairs[$i]}"
    output="$(classify_in_repo "$repo" pull_request "$base" "$head")"
    assert_catalog_recipe_output "$output" false
  done

  # Sync working tree once for multi-file, delete, rename, move, and summary checks.
  git -C "$repo" reset -q --hard HEAD
  local recipe_base recipe_head summary_file="$repo/.git/classification-summary.md" recipe_log
  recipe_base="$(git -C "$repo" rev-parse HEAD)"
  update_file_in "$repo" "docs/runbooks/example.md"
  update_file_in "$repo" "tests/fixtures/catalog/build-fixture.sql"
  update_file_in "$repo" "src/HVO.SkyMonitor.Catalog.Sqlite/Catalog.cs"
  recipe_head="$(git -C "$repo" rev-parse HEAD)"
  output="$(classify_in_repo "$repo" pull_request "$recipe_base" "$recipe_head")"
  assert_catalog_recipe_output "$output" true

  recipe_base="$recipe_head"
  git -C "$repo" rm --quiet scripts/catalog/build-hyg-v42.sh
  git -C "$repo" commit --quiet -m "Delete a catalog builder"
  recipe_head="$(git -C "$repo" rev-parse HEAD)"
  output="$(classify_in_repo "$repo" pull_request "$recipe_base" "$recipe_head")"
  assert_catalog_recipe_output "$output" true

  recipe_base="$recipe_head"
  git -C "$repo" mv tests/fixtures/catalog/build-fixture.sql tests/fixtures/catalog/build-fixture-renamed.sql
  git -C "$repo" commit --quiet -m "Rename a fixture recipe"
  recipe_head="$(git -C "$repo" rev-parse HEAD)"
  output="$(classify_in_repo "$repo" pull_request "$recipe_base" "$recipe_head")"
  assert_catalog_recipe_output "$output" true

  recipe_base="$recipe_head"
  mkdir -p "$repo/scripts/lib"
  git -C "$repo" mv scripts/catalog/catalog-common.sh scripts/lib/catalog-common.sh
  git -C "$repo" commit --quiet -m "Move a catalog library"
  recipe_head="$(git -C "$repo" rev-parse HEAD)"
  output="$(classify_in_repo "$repo" pull_request "$recipe_base" "$recipe_head")"
  assert_catalog_recipe_output "$output" true

  recipe_base="$recipe_head"
  update_file_in "$repo" "tests/fixtures/catalog/SOURCE.md"
  recipe_head="$(git -C "$repo" rev-parse HEAD)"
  output="$(classify_in_repo "$repo" pull_request "$recipe_base" "$recipe_head")"
  assert_plan_output "$output" reduced false
  assert_catalog_recipe_output "$output" true

  recipe_base="$recipe_head"
  update_file_in "$repo" "docs/runbooks/example.md"
  recipe_head="$(git -C "$repo" rev-parse HEAD)"
  output="$(cd "$repo" && GITHUB_STEP_SUMMARY="$summary_file" "$classifier" pull_request "$recipe_base" "$recipe_head")"
  assert_plan_output "$output" reduced false
  assert_catalog_recipe_output "$output" false
  grep -Fq 'Catalog recipe: **false**' "$summary_file"

  recipe_base="$recipe_head"
  update_file_in "$repo" "scripts/catalog/hyg-v44-openngc-common.sh"
  recipe_head="$(git -C "$repo" rev-parse HEAD)"
  recipe_log="$(cd "$repo" && GITHUB_STEP_SUMMARY="$summary_file" "$classifier" pull_request "$recipe_base" "$recipe_head" 2>&1 >/dev/null)"
  grep -Fq 'Catalog recipe: **true**' "$summary_file"
  grep -Fq ' catalog_recipe=true reason=' <<< "$recipe_log" || {
    printf 'The classification log line does not record the catalog-recipe selection.\n' >&2
    exit 1
  }
  printf '%d\n' "$catalog_recipe_cases" > "$parallel_dir/catalog_cases.recipe"
}

