  local secret_scan_contract_cases=0 release_scripts_cases=0 catalog_recipe_cases=0
  local i base head output

  # CameraAgent Dockerfile/config + Development v1 Deployment.Cli.Tests path-filtering (#2071).
  verify_component_plan_batch "$repo" \
