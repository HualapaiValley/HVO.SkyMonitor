# Replay milestone stdout lines in canonical order and aggregate exact case counts.
for ((i = 0; i < ${#parallel_outs[@]}; i++)); do
  if [[ -s "${parallel_outs[$i]}" ]]; then
    cat "${parallel_outs[$i]}"
  fi
done

sum_count_files() {
  local pattern="$1" total=0 value f
  for f in $pattern; do
    [[ -f "$f" ]] || continue
    value="$(cat "$f")"
    total=$((total + value))
  done
  printf '%d\n' "$total"
}

fast_cases="$(sum_count_files "$parallel_dir/fast_cases.*")"
link_probe_index="$(sum_count_files "$parallel_dir/link_probes.shard.*")"
if (( link_probe_index < 60 )); then
  printf 'Only %s project links were classified; the cross-check is not enumerating the repository.\n' \
    "$link_probe_index" >&2
  exit 1
fi
secret_scan_contract_cases="$(sum_count_files "$parallel_dir/secret_cases.*")"
release_scripts_cases="$(sum_count_files "$parallel_dir/release_cases.*")"
catalog_recipe_cases="$(sum_count_files "$parallel_dir/catalog_cases.*")"

printf 'Documentation fast path classification passed: %d cases.\n' "$fast_cases"
printf 'Required CI SIGPIPE regression passed: 6 iterations (3 plan, 3 result); shim fired for each.\n'
printf 'Secret scan contract classification passed: %d cases.\n' "$secret_scan_contract_cases"
printf 'Release script classification passed: %d cases.\n' "$release_scripts_cases"
printf 'Catalog recipe classification passed: %d cases.\n' "$catalog_recipe_cases"
printf 'CI classification and Required CI contract tests passed.\n'
