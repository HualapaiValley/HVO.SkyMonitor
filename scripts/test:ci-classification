#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
classifier="$repo_root/scripts/ci:classify"
required="$repo_root/scripts/ci:require"
work_root="$(mktemp -d)"
trap 'rm -rf "$work_root"' EXIT

git -C "$work_root" init --quiet
git -C "$work_root" config user.email ci-classification@example.invalid
git -C "$work_root" config user.name "CI Classification Test"
git -C "$work_root" commit --quiet --allow-empty -m baseline

expect_plan() {
  local expected_mode="$1"
  local expected_deployment="$2"
  local event_name="$3"
  local base_sha="$4"
  local head_sha="$5"
  local output

  output="$(cd "$work_root" && "$classifier" "$event_name" "$base_sha" "$head_sha")"
  if [[ "$output" != "mode=$expected_mode"$'\n'"deployment=$expected_deployment" ]]; then
    printf 'Expected mode=%s deployment=%s, received %s\n' "$expected_mode" "$expected_deployment" "$output" >&2
    exit 1
  fi
}

commit_file() {
  local path="$1"
  mkdir -p "$work_root/$(dirname "$path")"
  printf 'classification fixture\n' > "$work_root/$path"
  git -C "$work_root" add -- "$path"
  git -C "$work_root" commit --quiet -m "Add $path"
}

base_sha="$(git -C "$work_root" rev-parse HEAD)"
allowlisted_paths=(
  "docs/runbooks/example.md"
  "README.md"
  "AGENTS.md"
  "THIRD-PARTY-NOTICES.md"
  ".devcontainer/devcontainer.json"
  ".vscode/settings.json"
  ".github/copilot-instructions.md"
  ".github/pull_request_template.md"
  ".github/prompts/example.md"
  "src/Example/README.md"
  "tests/Example.Tests/README.md"
  "tests/fixtures/catalog/SOURCE.md"
  "tests/fixtures/stellarium/SIMBAD_ENDPOINTS.md"
  "tools/asi-capture/README.md"
  "scripts/opencode:disable"
  "scripts/opencode:enable"
  "scripts/opencode:connect"
  "scripts/opencode:prepare-rebuild"
  "scripts/opencode:remote-connect"
  "scripts/test:opencode"
)

for path in "${allowlisted_paths[@]}"; do
  mkdir -p "$work_root/$(dirname "$path")"
  printf 'allowlisted fixture\n' > "$work_root/$path"
done
git -C "$work_root" add --all
git -C "$work_root" commit --quiet -m "Add allowlisted paths"
head_sha="$(git -C "$work_root" rev-parse HEAD)"
expect_plan reduced false pull_request "$base_sha" "$head_sha"
expect_plan full true push "$base_sha" "$head_sha"
summary_file="$work_root/.git/classification-summary.md"
(cd "$work_root" && GITHUB_STEP_SUMMARY="$summary_file" "$classifier" pull_request "$base_sha" "$head_sha" >/dev/null)
grep -Fq 'Mode: **reduced**' "$summary_file"
grep -Fq 'Deployment contracts: **false**' "$summary_file"
grep -Fq 'Deployment reason: pull request does not change deployment-contract inputs' "$summary_file"

ordinary_full_paths=(
  ".editorconfig"
  "docs/catalog/hyg-v42-attribution.md"
  "docs/catalog/hyg-v42-license.md"
  "dotnet-tools.json"
  "Directory.Build.props"
  "HVO.SkyMonitor.v9.slnx"
  "src/Example/Program.cs"
  "src/Example/Migrations/Example.cs"
  "tests/Example.Tests/ExampleTests.cs"
  "scripts/example"
  "unknown/example.txt"
)

for path in "${ordinary_full_paths[@]}"; do
  base_sha="$(git -C "$work_root" rev-parse HEAD)"
  commit_file "$path"
  head_sha="$(git -C "$work_root" rev-parse HEAD)"
  expect_plan full false pull_request "$base_sha" "$head_sha"
done

deployment_paths=(
  ".github/workflows/ci.yml"
  ".dockerignore"
  ".env.template"
  "docker-compose.apps.yml"
  "global.json"
  "scripts/ci:classify"
  "scripts/ci:require"
  "scripts/test:ci-classification"
  "scripts/deploy:environment"
  "scripts/deploy/common.sh"
  "scripts/test:deploy-environment"
  "scripts/test:deploy-environment-cli"
  "scripts/catalog/install-hyg-v42.sh"
  "scripts/catalog:install"
  "scripts/infra:operation-lock"
  "deploy/acceptance/issue-197/compose.yml"
  "deploy/hvo-docker/README.md"
  "deploy/hvo-docker/docker-compose.shared-services.yml"
  "deploy/split-host/workloads/canonical-workloads.json"
  "deploy/sql/logichost-runtime-role.sql"
  "tests/fixtures/catalog/hyg-v42-bright-stars.sqlite"
  "src/HVO.SkyMonitor.CameraAgent/Dockerfile"
  "src/HVO.SkyMonitor.LogicHost/Dockerfile"
  "src/HVO.SkyMonitor.CameraAgent/cameraagent.sample.json"
  "src/HVO.SkyMonitor.CameraAgent/virtual-asi174.full.json"
  "src/HVO.SkyMonitor.CameraAgent/virtual-asi178mc.full.json"
)

for path in "${deployment_paths[@]}"; do
  base_sha="$(git -C "$work_root" rev-parse HEAD)"
  commit_file "$path"
  head_sha="$(git -C "$work_root" rev-parse HEAD)"
  expect_plan full true pull_request "$base_sha" "$head_sha"
done

base_sha="$(git -C "$work_root" rev-parse HEAD)"
commit_file "docs/mixed.md"
commit_file "src/Example/Mixed.cs"
head_sha="$(git -C "$work_root" rev-parse HEAD)"
expect_plan full false pull_request "$base_sha" "$head_sha"
expect_plan full true pull_request "$head_sha" "$head_sha"
expect_plan full true pull_request "$head_sha" missing-commit

base_sha="$(git -C "$work_root" rev-parse HEAD)"
commit_file "docs/deployment-mixed.md"
commit_file "scripts/deploy/mixed.sh"
head_sha="$(git -C "$work_root" rev-parse HEAD)"
expect_plan full true pull_request "$base_sha" "$head_sha"

commit_file "docs/delete.md"
base_sha="$(git -C "$work_root" rev-parse HEAD)"
rm "$work_root/docs/delete.md"
git -C "$work_root" add --all
git -C "$work_root" commit --quiet -m "Delete documentation"
head_sha="$(git -C "$work_root" rev-parse HEAD)"
expect_plan full true pull_request "$base_sha" "$head_sha"

commit_file "docs/rename.md"
base_sha="$(git -C "$work_root" rev-parse HEAD)"
git -C "$work_root" mv docs/rename.md docs/renamed.md
git -C "$work_root" commit --quiet -m "Rename documentation"
head_sha="$(git -C "$work_root" rev-parse HEAD)"
expect_plan full true pull_request "$base_sha" "$head_sha"

commit_file "docs/type-change.md"
base_sha="$(git -C "$work_root" rev-parse HEAD)"
rm "$work_root/docs/type-change.md"
ln -s ../README.md "$work_root/docs/type-change.md"
git -C "$work_root" add --all
git -C "$work_root" commit --quiet -m "Change documentation path type"
head_sha="$(git -C "$work_root" rev-parse HEAD)"
expect_plan full true pull_request "$base_sha" "$head_sha"

base_sha="$(git -C "$work_root" rev-parse HEAD)"
ln -s ../README.md "$work_root/docs/added-link.md"
git -C "$work_root" add --all
git -C "$work_root" commit --quiet -m "Add documentation symlink"
head_sha="$(git -C "$work_root" rev-parse HEAD)"
expect_plan full true pull_request "$base_sha" "$head_sha"

base_sha="$(git -C "$work_root" rev-parse HEAD)"
newline_path=$'docs/line\nbreak.md'
commit_file "$newline_path"
head_sha="$(git -C "$work_root" rev-parse HEAD)"
expect_plan reduced false pull_request "$base_sha" "$head_sha"

real_git="$(command -v git)"
mkdir -p "$work_root/fake-bin"
cat > "$work_root/fake-bin/git" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
case "$1" in
  cat-file) exit 0 ;;
  diff)
    [[ "${FAKE_GIT_DIFF_FAILURE:-false}" != true ]] || exit 91
    printf 'M\0'
    exit 0
    ;;
  *) exec "${REAL_GIT:?}" "$@" ;;
esac
EOF
chmod +x "$work_root/fake-bin/git"

for fake_case in malformed failure; do
  if [[ "$fake_case" == failure ]]; then fake_failure=true; else fake_failure=false; fi
  output="$(cd "$work_root" && PATH="$work_root/fake-bin:$PATH" REAL_GIT="$real_git" FAKE_GIT_DIFF_FAILURE="$fake_failure" \
    "$classifier" pull_request fake-base fake-head)"
  if [[ "$output" != $'mode=full\ndeployment=true' ]]; then
    printf 'Expected fail-closed malformed/diff-failure plan, received %s\n' "$output" >&2
    exit 1
  fi
done

"$required" full true push success success success success success success success success success >/dev/null
"$required" full false pull_request success success skipped success success success success success success >/dev/null
"$required" reduced false pull_request success success skipped skipped skipped skipped skipped skipped skipped >/dev/null

invalid_required_cases=(
  "reduced false push success success skipped skipped skipped skipped skipped skipped skipped"
  "full false push success success skipped success success success success success success"
  "reduced true pull_request success success success skipped skipped skipped skipped skipped skipped"
  "unknown false pull_request success success skipped skipped skipped skipped skipped skipped skipped"
  "full true pull_request failure success success success success success success success success"
  "full true pull_request success cancelled success success success success success success success"
  "full true pull_request success success failure success success success success success success"
  "full true pull_request success success cancelled success success success success success success"
  "full true pull_request success success skipped success success success success success success"
  "full false pull_request success success success success success success success success success"
  "full false pull_request success success failure success success success success success success"
  "full false pull_request success success cancelled success success success success success success"
  "full true pull_request success success success skipped success success success success success"
  "reduced false pull_request success success skipped success skipped skipped skipped skipped skipped"
)

for arguments in "${invalid_required_cases[@]}"; do
  read -r -a fields <<< "$arguments"
  if "$required" "${fields[@]}" >/dev/null 2>&1; then
    printf 'Expected Required CI rejection for: %s\n' "$arguments" >&2
    exit 1
  fi
done

if "$required" full '' pull_request success success skipped success success success success success success >/dev/null 2>&1; then
  printf 'Expected Required CI rejection for a missing deployment plan.\n' >&2
  exit 1
fi

if "$required" full true pull_request success success '' success success success success success success >/dev/null 2>&1; then
  printf 'Expected Required CI rejection for a missing deployment result.\n' >&2
  exit 1
fi

printf 'CI classification and Required CI contract tests passed.\n'
