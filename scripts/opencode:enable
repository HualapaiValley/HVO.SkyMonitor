#!/usr/bin/env bash
# Start this workspace's persistent OpenCode server inside the devcontainer.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
readonly REPO_ROOT
# shellcheck source=.devcontainer/opencode-host.conf disable=SC1091
source "$REPO_ROOT/.devcontainer/opencode-host.conf"

readonly TMUX_SESSION="${OPENCODE_TMUX_SESSION:?OPENCODE_TMUX_SESSION is required}"
readonly CONTAINER_PORT="${OPENCODE_CONTAINER_PORT:?OPENCODE_CONTAINER_PORT is required}"
readonly PASSWORD_FILE="${OPENCODE_DATA_DIR:-$HOME/.local/share/opencode}/server-password"
readonly LOCK_FILE="${OPENCODE_DATA_DIR:-$HOME/.local/share/opencode}/server-lifecycle.lock"

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "Required command '$1' is not installed." >&2
        exit 1
    }
}

tmux_option() {
    tmux show-options -v -t "$TMUX_SESSION" "$1" 2>/dev/null || true
}

session_identity_matches() {
    [[ "$(tmux_option @hvo-opencode-repo)" == "$REPO_ROOT" ]] \
        && [[ "$(tmux_option @hvo-opencode-port)" == "$CONTAINER_PORT" ]]
}

health_status() {
    curl --silent --output /dev/null --write-out '%{http_code}' \
        --connect-timeout 2 --max-time 5 \
        --user "opencode:$(<"$PASSWORD_FILE")" \
        "http://127.0.0.1:${CONTAINER_PORT}/global/health" 2>/dev/null || true
}

if [[ ! -f /.dockerenv ]]; then
    echo "Run this script inside the devcontainer." >&2
    exit 1
fi
for command_name in curl flock opencode ss tmux; do
    require_command "$command_name"
done
OPENCODE_BINARY="$(command -v opencode)"
readonly OPENCODE_BINARY
if [[ ! "$TMUX_SESSION" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "OPENCODE_TMUX_SESSION contains unsupported characters: '$TMUX_SESSION'." >&2
    exit 1
fi
if [[ ! "$CONTAINER_PORT" =~ ^[1-9][0-9]{0,4}$ ]] || (( 10#$CONTAINER_PORT > 65535 )); then
    echo "OPENCODE_CONTAINER_PORT must be an integer from 1 through 65535." >&2
    exit 1
fi
if [[ ! -s "$PASSWORD_FILE" ]]; then
    echo "OpenCode password is missing at $PASSWORD_FILE. Run post-create setup first." >&2
    exit 1
fi

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "Another OpenCode lifecycle operation is already running." >&2
    exit 1
fi

if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    if ! session_identity_matches; then
        echo "tmux session '$TMUX_SESSION' does not match this workspace's OpenCode process; leaving it unchanged." >&2
        exit 1
    fi
    if [[ "$(tmux display-message -p -t "$TMUX_SESSION" '#{pane_dead}' 2>/dev/null || true)" == 1 ]]; then
        tmux kill-session -t "$TMUX_SESSION"
        echo "Cleared exited OpenCode tmux session '$TMUX_SESSION'."
    elif [[ "$(tmux display-message -p -t "$TMUX_SESSION" '#{pane_current_command}' 2>/dev/null || true)" != opencode ]]; then
        echo "tmux session '$TMUX_SESSION' does not contain OpenCode; leaving it unchanged." >&2
        exit 1
    elif [[ "$(health_status)" == 200 ]]; then
        echo "OpenCode is already running in internal tmux session '$TMUX_SESSION'."
        exit 0
    else
        echo "Managed tmux session '$TMUX_SESSION' exists, but OpenCode is not healthy." >&2
        echo "Inspect it inside the devcontainer with: tmux attach-session -t $TMUX_SESSION" >&2
        exit 1
    fi
fi
if [[ "$(health_status)" == 200 ]] || ss -H -ltn "sport = :${CONTAINER_PORT}" | grep -q .; then
    echo "OpenCode port $CONTAINER_PORT is already in use by an unmanaged process; leaving it unchanged." >&2
    exit 1
fi

# shellcheck disable=SC2016 # The generated command expands inside tmux.
printf -v server_command \
    'set -euo pipefail; export OPENCODE_SERVER_PASSWORD="$(<%q)"; exec %q serve --hostname 0.0.0.0 --port %q' \
    "$PASSWORD_FILE" "$OPENCODE_BINARY" "$CONTAINER_PORT"
tmux new-session -d -s "$TMUX_SESSION" "bash -lc $(printf '%q' "$server_command")" 9>&-
tmux set-option -t "$TMUX_SESSION" @hvo-opencode-repo "$REPO_ROOT"
tmux set-option -t "$TMUX_SESSION" @hvo-opencode-port "$CONTAINER_PORT"

for _ in {1..40}; do
    if [[ "$(health_status)" == 200 ]]; then
        echo "OpenCode is running in internal tmux session '$TMUX_SESSION'."
        echo "Container URL: http://127.0.0.1:${CONTAINER_PORT}"
        echo "Docker-host URL: http://<docker-host>:${OPENCODE_HOST_PORT}"
        exit 0
    fi
    if ! tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
        break
    fi
    sleep 0.25
done

echo "OpenCode did not become healthy; the internal tmux session was left intact for inspection." >&2
exit 1
