#!/usr/bin/env bash
# Verify the host-owned tmux OpenCode lifecycle contract without changing live state.
# shellcheck disable=SC2016 # Literal grep patterns intentionally contain shell expressions.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly REPO_ROOT
readonly ENABLE_SCRIPT="$REPO_ROOT/scripts/opencode:enable"
readonly DISABLE_SCRIPT="$REPO_ROOT/scripts/opencode:disable"
readonly CONNECT_SCRIPT="$REPO_ROOT/scripts/opencode:connect"
readonly CONFIGURE_SCRIPT="$REPO_ROOT/.devcontainer/configure-opencode.sh"
readonly HOST_CONFIG_FILE="$REPO_ROOT/.devcontainer/opencode-host.conf"
TEMP_DIR="$(mktemp -d -t hvo-opencode-test.XXXXXX)"
readonly TEMP_DIR

cleanup() {
    rm -rf "$TEMP_DIR"
}
trap cleanup EXIT

for host_script in "$ENABLE_SCRIPT" "$DISABLE_SCRIPT" "$CONNECT_SCRIPT"; do
    grep -Fq 'Run this script on the Docker host, not inside the devcontainer.' "$host_script"
    grep -Fq 'source "$HOST_CONFIG_FILE"' "$host_script"
done
for lifecycle_script in "$ENABLE_SCRIPT" "$DISABLE_SCRIPT"; do
    grep -Fq 'label=devcontainer.local_folder=$REPO_ROOT' "$lifecycle_script"
done
grep -Fq 'tmux new-session -d -s "$TMUX_SESSION" "$tmux_command" 9>&-' "$ENABLE_SCRIPT"
for lifecycle_script in "$ENABLE_SCRIPT" "$DISABLE_SCRIPT"; do
    grep -Fq 'opencode-lifecycle-v2.lock' "$lifecycle_script"
done
grep -Fq 'tmux set-option -t "$TMUX_SESSION" @hvo-opencode-repo "$REPO_ROOT"' "$ENABLE_SCRIPT"
grep -Fq 'tmux set-option -t "$TMUX_SESSION" @hvo-opencode-container "$CONTAINER"' "$ENABLE_SCRIPT"
grep -Fq 'tmux set-option -t "$TMUX_SESSION" @hvo-opencode-generation "$GENERATION"' "$ENABLE_SCRIPT"
grep -Fq 'exec --interactive --tty' "$ENABLE_SCRIPT"
grep -Fq 'TMUX_DOCKER_COMMAND' "$ENABLE_SCRIPT"
grep -Fq -- '-u DOCKER_HOST -u DOCKER_CONTEXT' "$ENABLE_SCRIPT"
grep -Fq 'exec opencode --hostname 0.0.0.0 --port %q --continue' "$ENABLE_SCRIPT"
grep -Fq 'OPENCODE_SERVER_PASSWORD' "$ENABLE_SCRIPT"
grep -Fq '"127.0.0.1:${HOST_PORT}"' "$ENABLE_SCRIPT"
grep -Fq 'flock -n 9' "$ENABLE_SCRIPT"
grep -Fq 'container_port_in_use' "$ENABLE_SCRIPT"
grep -Fq 'tmux kill-session -t "$TMUX_SESSION"' "$DISABLE_SCRIPT"
grep -Fq 'tmux_option @hvo-opencode-repo' "$DISABLE_SCRIPT"
grep -Fq 'tmux_option @hvo-opencode-container' "$DISABLE_SCRIPT"
grep -Fq '"${metadata[2]:-}" == "$(cut -d " " -f 22 "/proc/$pid/stat"' "$DISABLE_SCRIPT"
grep -Fq '"${metadata[3]:-}" == "$expected_uid"' "$DISABLE_SCRIPT"
grep -Fq '"${metadata[4]:-}" == "$(hostname)"' "$DISABLE_SCRIPT"
grep -Fq '"${metadata[7]:-}" == "$expected_generation"' "$DISABLE_SCRIPT"
grep -Fq 'PID start ticks survive exec' "$DISABLE_SCRIPT"
if grep -Fq 'readlink -f "/proc/$pid/exe"' "$DISABLE_SCRIPT"; then
    echo "Managed shutdown must not depend on mutable process executable state." >&2
    exit 1
fi
grep -Fq 'docker exec --user "$CONTAINER_USER"' "$DISABLE_SCRIPT"
grep -Fq 'flock -n 9' "$DISABLE_SCRIPT"
grep -Fq 'managed_process_absent' "$DISABLE_SCRIPT"
grep -Fq 'process_state" == Z' "$DISABLE_SCRIPT"
grep -Fq '[[ -e "$metadata_file" ]] || exit 2' "$DISABLE_SCRIPT"
grep -Fq 'tmux_pane_dead && ! container_port_in_use' "$DISABLE_SCRIPT"
grep -Fq 'Cleared exited tmux session' "$DISABLE_SCRIPT"
grep -Fq "Cleared exited tmux state for replaced devcontainer" "$DISABLE_SCRIPT"
grep -Fq "docker inspect --format '{{.State.Running}}' \"\$SESSION_CONTAINER\"" "$DISABLE_SCRIPT"
grep -Fq 'Cleared stale OpenCode lifecycle state; no managed process remains.' "$DISABLE_SCRIPT"
grep -Fq 'no tmux session or server listener remains' "$DISABLE_SCRIPT"
grep -Fq 'container_port_in_use' "$DISABLE_SCRIPT"
grep -Fq 'tmux attach-session -t "$TMUX_SESSION"' "$CONNECT_SCRIPT"
grep -Fq 'tmux switch-client -t "$TMUX_SESSION"' "$CONNECT_SCRIPT"
grep -Fq 'tmux_option @hvo-opencode-repo' "$CONNECT_SCRIPT"
grep -Fq 'tmux_option @hvo-opencode-generation' "$CONNECT_SCRIPT"
grep -Fq "'#{pane_dead}'" "$CONNECT_SCRIPT"
grep -Fq "Clear it safely with: \$REPO_ROOT/scripts/opencode:disable" "$CONNECT_SCRIPT"
if grep -Fq 'nohup opencode' "$ENABLE_SCRIPT"; then
    echo "Host lifecycle must not daemonize OpenCode outside tmux." >&2
    exit 1
fi
if grep -Fq 'scripts/opencode:enable' "$REPO_ROOT/.devcontainer/post-start.sh"; then
    echo "The devcontainer still starts OpenCode automatically." >&2
    exit 1
fi

# shellcheck source=.devcontainer/opencode-host.conf
source "$HOST_CONFIG_FILE"
[[ "$OPENCODE_TMUX_SESSION" =~ ^[A-Za-z0-9_.-]+$ ]]
test "$OPENCODE_CONTAINER_PORT" = 4096
test "$OPENCODE_HOST_PORT" = 4096
grep -Fq "\"127.0.0.1:${OPENCODE_HOST_PORT}:${OPENCODE_CONTAINER_PORT}\"" \
    "$REPO_ROOT/.devcontainer/devcontainer.json"
if grep -Fq '"4096:4096"' "$REPO_ROOT/.devcontainer/devcontainer.json"; then
    echo "OpenCode must not be published on every Docker-host interface." >&2
    exit 1
fi
grep -Fq '4096: OpenCode server' "$REPO_ROOT/.devcontainer/devcontainer.json"
if grep -Eq '^[[:space:]]+4096,?$' "$REPO_ROOT/.devcontainer/devcontainer.json"; then
    echo "OpenCode must not use automatic devcontainer port forwarding." >&2
    exit 1
fi
grep -Fq '"label": "OpenCode (SSH tunnel only)"' "$REPO_ROOT/.devcontainer/devcontainer.json"
grep -Fq '"onAutoForward": "ignore"' "$REPO_ROOT/.devcontainer/devcontainer.json"
if grep -Fq 'target": "/var/lib/tailscale"' "$REPO_ROOT/.devcontainer/devcontainer.json"; then
    echo "Legacy persisted Tailscale Serve state must not be mounted." >&2
    exit 1
fi
grep -Fq 'bash "$SCRIPT_DIR/configure-opencode.sh"' "$REPO_ROOT/.devcontainer/post-create.sh"

mkdir -p "$TEMP_DIR/legacy-config" "$TEMP_DIR/legacy-data"
printf '{\n\t"$schema": "https://opencode.ai/config.json",\n\t"permission": "allow"\n}\n' \
    > "$TEMP_DIR/legacy-config/opencode.jsonc"
env -i HOME="$TEMP_DIR/home" PATH="/usr/bin:/bin" \
    OPENCODE_CONFIG_DIR="$TEMP_DIR/legacy-config" \
    OPENCODE_DATA_DIR="$TEMP_DIR/legacy-data" \
    bash "$CONFIGURE_SCRIPT"
if grep -Fq '"permission": "allow"' "$TEMP_DIR/legacy-config/opencode.jsonc"; then
    echo "Legacy blanket-allow OpenCode policy was not migrated." >&2
    exit 1
fi
test "$(stat -c %a "$TEMP_DIR/legacy-config/opencode.jsonc")" = 600
test "$(stat -c %a "$TEMP_DIR/legacy-data/server-password")" = 600

mkdir -p "$TEMP_DIR/custom-config" "$TEMP_DIR/custom-data"
printf '{"permission":"ask"}\n' > "$TEMP_DIR/custom-config/opencode.jsonc"
chmod 644 "$TEMP_DIR/custom-config/opencode.jsonc"
env -i HOME="$TEMP_DIR/home" PATH="/usr/bin:/bin" \
    OPENCODE_CONFIG_DIR="$TEMP_DIR/custom-config" \
    OPENCODE_DATA_DIR="$TEMP_DIR/custom-data" \
    bash "$CONFIGURE_SCRIPT"
grep -Fqx '{"permission":"ask"}' "$TEMP_DIR/custom-config/opencode.jsonc"
test "$(stat -c %a "$TEMP_DIR/custom-config/opencode.jsonc")" = 600

grep -Fq 'OpenCode from the Docker host' "$REPO_ROOT/README.md"
grep -Fq 'host `tmux` session' "$REPO_ROOT/README.md"
grep -Fq './scripts/opencode:connect' "$REPO_ROOT/README.md"
grep -Fq "ssh -t hvo-dev-01 'cd /home/roys/development/HVO.SkyMonitor && ./scripts/opencode:connect'" \
    "$REPO_ROOT/README.md"
if grep -Fq 'opencode attach http://' "$ENABLE_SCRIPT" "$REPO_ROOT/README.md"; then
    echo "The supported remote workflow must use the host tmux connection script." >&2
    exit 1
fi

if [[ -f /.dockerenv ]]; then
    for host_script in "$ENABLE_SCRIPT" "$DISABLE_SCRIPT" "$CONNECT_SCRIPT"; do
        if bash "$host_script" >"$TEMP_DIR/host-guard.out" 2>&1; then
            echo "$(basename "$host_script") unexpectedly ran inside the devcontainer." >&2
            exit 1
        fi
        grep -Fq 'Run this script on the Docker host, not inside the devcontainer.' \
            "$TEMP_DIR/host-guard.out"
    done
fi

echo "OpenCode host tmux lifecycle contract passed."
