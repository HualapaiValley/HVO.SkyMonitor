#!/usr/bin/env bash
# Verify the in-container OpenCode lifecycle contract without changing live state.
# shellcheck disable=SC1091,SC2016 # Static sources and grep assertions intentionally use repository paths/syntax.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly REPO_ROOT
readonly ENABLE_SCRIPT="$REPO_ROOT/scripts/opencode:enable"
readonly DISABLE_SCRIPT="$REPO_ROOT/scripts/opencode:disable"
readonly CONNECT_SCRIPT="$REPO_ROOT/scripts/opencode:connect"
readonly REMOTE_CONNECT_SCRIPT="$REPO_ROOT/scripts/opencode:remote-connect"
readonly CONFIGURE_SCRIPT="$REPO_ROOT/.devcontainer/configure-opencode.sh"
readonly INITIALIZE_SCRIPT="$REPO_ROOT/.devcontainer/initialize.sh"
readonly PERSISTENCE_SCRIPT="$REPO_ROOT/.devcontainer/verify-persistent-agent-state.sh"
readonly HOST_CONFIG_FILE="$REPO_ROOT/.devcontainer/opencode-host.conf"
readonly DEVCONTAINER_FILE="$REPO_ROOT/.devcontainer/devcontainer.json"
TEMP_DIR="$(mktemp -d -t hvo-opencode-test.XXXXXX)"
readonly TEMP_DIR
LIFECYCLE_SESSION=""

cleanup() {
    if [[ -n "$LIFECYCLE_SESSION" ]] && command -v tmux >/dev/null 2>&1; then
        tmux kill-session -t "$LIFECYCLE_SESSION" 2>/dev/null || true
    fi
    rm -rf "$TEMP_DIR"
}
trap cleanup EXIT

bash -n \
    "$REPO_ROOT"/.devcontainer/*.sh \
    "$HOST_CONFIG_FILE" \
    "$ENABLE_SCRIPT" \
    "$DISABLE_SCRIPT" \
    "$CONNECT_SCRIPT" \
    "$REMOTE_CONNECT_SCRIPT" \
    "$REPO_ROOT/scripts/test:opencode"

for lifecycle_script in "$ENABLE_SCRIPT" "$DISABLE_SCRIPT"; do
    grep -Fq 'Run this script inside the devcontainer.' "$lifecycle_script"
    grep -Fq 'source "$REPO_ROOT/.devcontainer/opencode-host.conf"' "$lifecycle_script"
    grep -Fq '@hvo-opencode-repo' "$lifecycle_script"
    grep -Fq '@hvo-opencode-port' "$lifecycle_script"
    grep -Fq '#{pane_current_command}' "$lifecycle_script"
    grep -Fq 'flock -n 9' "$lifecycle_script"
done

grep -Fq 'tmux new-session -d -s "$TMUX_SESSION"' "$ENABLE_SCRIPT"
grep -Fq 'exec %q serve --hostname 0.0.0.0 --port %q' "$ENABLE_SCRIPT"
grep -Fq 'readonly OPENCODE_BINARY=/usr/local/bin/opencode' "$ENABLE_SCRIPT"
grep -Fq 'Cleared exited OpenCode tmux session' "$ENABLE_SCRIPT"
grep -Fq 'leaving it unchanged.' "$ENABLE_SCRIPT"
grep -Fq 'tmux kill-session -t "$TMUX_SESSION"' "$DISABLE_SCRIPT"
grep -Fq 'OPENCODE_CONTAINER_PORT must be an integer from 1 through 65535.' "$DISABLE_SCRIPT"
grep -Fq 'OpenCode state directory is missing; leaving tmux session' "$DISABLE_SCRIPT"
grep -Fq 'Cleared exited OpenCode tmux session' "$DISABLE_SCRIPT"
grep -Fq 'leaving it running.' "$DISABLE_SCRIPT"
grep -Fq 'if [[ -f /.dockerenv ]]' "$CONNECT_SCRIPT"
grep -Fq 'OpenCode port must be an integer from 1 through 65535.' "$CONNECT_SCRIPT"
grep -Fq 'exec "$OPENCODE_BINARY" attach --username opencode "http://127.0.0.1:${PORT}" "$@"' "$CONNECT_SCRIPT"
grep -Fq 'Run this script on the Docker host, not inside the devcontainer.' "$REMOTE_CONNECT_SCRIPT"
grep -Fq 'exec "$OPENCODE_BINARY" attach --username opencode "$server_url" "$@"' "$REMOTE_CONNECT_SCRIPT"
grep -Fq 'scripts/opencode:enable' "$REPO_ROOT/.devcontainer/post-start.sh"
grep -Fq 'configure-opencode.sh' "$REPO_ROOT/.devcontainer/post-start.sh"
grep -Fq 'bash "$PERSISTENCE_SCRIPT"' "$ENABLE_SCRIPT"
grep -Fq 'bash "$CONFIGURE_SCRIPT"' "$ENABLE_SCRIPT"
grep -Fq 'verify-persistent-agent-state.sh' "$REPO_ROOT/.devcontainer/post-create.sh"
grep -Fq 'verify-persistent-agent-state.sh' "$REPO_ROOT/.devcontainer/post-start.sh"
grep -Fq 'findmnt --noheadings --raw --output TARGET --target "$path"' "$PERSISTENCE_SCRIPT"
grep -Fq 'filesystem_type" == "tmpfs"' "$PERSISTENCE_SCRIPT"
grep -Fq 'HVO_DEVCONTAINER_STATE_SOURCE' "$PERSISTENCE_SCRIPT"
grep -Fq 'OpenCode configuration root' "$PERSISTENCE_SCRIPT"
grep -Fq 'OpenCode data root' "$PERSISTENCE_SCRIPT"
grep -Fq 'must have mode 0700' "$PERSISTENCE_SCRIPT"
grep -Fq 'verify_secure_state_directory' "$INITIALIZE_SCRIPT"
if grep -Eq 'chown -R vscode:vscode .*(opencode|/tmp/opencode|hvo-agent-state)' \
    "$REPO_ROOT/.devcontainer/post-create.sh"; then
    echo "Post-create must not silently repair persistent OpenCode state ownership." >&2
    exit 1
fi

# shellcheck source=.devcontainer/opencode-host.conf
source "$HOST_CONFIG_FILE"
[[ "$OPENCODE_TMUX_SESSION" =~ ^[A-Za-z0-9_.-]+$ ]]
test "$OPENCODE_CONTAINER_PORT" = 4096
test "$OPENCODE_HOST_PORT" = 4097
grep -Fq "\"0.0.0.0:${OPENCODE_HOST_PORT}:${OPENCODE_CONTAINER_PORT}\"" "$DEVCONTAINER_FILE"
grep -Fq '"label": "OpenCode server (Docker host port 4097)"' "$DEVCONTAINER_FILE"
grep -Fq '"onAutoForward": "ignore"' "$DEVCONTAINER_FILE"
grep -Fq '"HVO_AGENT_WORKTREE_ROOT": "/tmp/opencode"' "$DEVCONTAINER_FILE"
grep -Fq '"HVO_AGENT_STATE_ROOT": "/var/lib/hvo-agent-state"' "$DEVCONTAINER_FILE"
grep -Fq '"HVO_DEVCONTAINER_STATE_SOURCE": "${localWorkspaceFolder}/.devcontainer/state"' \
    "$DEVCONTAINER_FILE"
grep -Fq '"source": "${localWorkspaceFolder}/.devcontainer/state/opencode-worktrees"' "$DEVCONTAINER_FILE"
grep -Fq '"target": "/tmp/opencode"' "$DEVCONTAINER_FILE"
grep -Fq '"source": "${localWorkspaceFolder}/.devcontainer/state/agent-scratch"' "$DEVCONTAINER_FILE"
grep -Fq '"target": "/var/lib/hvo-agent-state"' "$DEVCONTAINER_FILE"
grep -Fq '"$state_root/opencode-worktrees"' "$REPO_ROOT/.devcontainer/initialize.sh"
grep -Fq '"$state_root/agent-scratch"' "$REPO_ROOT/.devcontainer/initialize.sh"
if grep -Fq 'opencode-bin' "$DEVCONTAINER_FILE"; then
    echo "The root-owned OpenCode executable must not be replaced by writable persisted state." >&2
    exit 1
fi

grep -Fq 'ARG OPENCODE_VERSION=1.18.2' "$REPO_ROOT/.devcontainer/Dockerfile"
grep -Fq '88f9b79f44b02e8e7c33e528832047c177b0cb20939484afaff22425a47f3d81' \
    "$REPO_ROOT/.devcontainer/Dockerfile"
grep -Fq '93352b30d37d8da2e5c226085f1afbf37cf57cfcecedc813520ff2d0f8581540' \
    "$REPO_ROOT/.devcontainer/Dockerfile"
grep -Fq 'tar -xzf "/tmp/${opencode_archive}" -C /usr/local/bin opencode' \
    "$REPO_ROOT/.devcontainer/Dockerfile"
if grep -Fq '/home/vscode/.opencode/bin' "$REPO_ROOT/.devcontainer/Dockerfile"; then
    echo "A user-writable OpenCode executable must not shadow the pinned binary." >&2
    exit 1
fi

run_configure() {
    env -i HOME="$TEMP_DIR/home" PATH="/usr/bin:/bin" \
        OPENCODE_CONFIG_DIR="$1" \
        OPENCODE_DATA_DIR="$2" \
        bash "$CONFIGURE_SCRIPT"
}

expect_configure_failure() {
    local config_root="$1"
    local data_root="$2"
    local expected_message="$3"
    local output_file="$4"

    if run_configure "$config_root" "$data_root" > "$output_file" 2>&1; then
        echo "OpenCode configuration unexpectedly accepted invalid state: $config_root $data_root" >&2
        exit 1
    fi
    grep -Fq "$expected_message" "$output_file"
}

fresh_config="$TEMP_DIR/fresh/opencode-config"
fresh_data="$TEMP_DIR/fresh/opencode-data"
mkdir -p "$fresh_config" "$fresh_data"
chmod 700 "$fresh_config" "$fresh_data"
run_configure "$fresh_config" "$fresh_data"
grep -Fqx $'\t"$schema": "https://opencode.ai/config.json"' "$fresh_config/opencode.jsonc"
test "$(stat -c %a "$fresh_config/opencode.jsonc")" = 600
test "$(stat -c %a "$fresh_data/server-password")" = 600
test "$(wc -c < "$fresh_data/server-password")" = 65
fresh_config_hash="$(sha256sum "$fresh_config/opencode.jsonc")"
fresh_password_hash="$(sha256sum "$fresh_data/server-password")"
printf 'persisted session sentinel\n' > "$fresh_data/session-sentinel"
run_configure "$fresh_config" "$fresh_data"
test "$(sha256sum "$fresh_config/opencode.jsonc")" = "$fresh_config_hash"
test "$(sha256sum "$fresh_data/server-password")" = "$fresh_password_hash"
grep -Fqx 'persisted session sentinel' "$fresh_data/session-sentinel"

for failpoint in \
    after-marker \
    after-config-write \
    after-password-write \
    after-inventory \
    after-config-install \
    after-password-install \
    after-commit; do
    interrupted_config="$TEMP_DIR/interrupted-$failpoint/opencode-config"
    interrupted_data="$TEMP_DIR/interrupted-$failpoint/opencode-data"
    mkdir -p "$interrupted_config" "$interrupted_data"
    chmod 700 "$interrupted_config" "$interrupted_data"
    if bash -c 'env -i HOME="$1" PATH="/usr/bin:/bin" OPENCODE_CONFIG_DIR="$2" OPENCODE_DATA_DIR="$3" HVO_OPENCODE_INIT_FAILPOINT="$4" bash "$5"; status=$?; :; exit "$status"' \
        _ "$TEMP_DIR/home" "$interrupted_config" "$interrupted_data" "$failpoint" "$CONFIGURE_SCRIPT" \
        > "$TEMP_DIR/interrupted-$failpoint.out" 2>&1; then
        echo "OpenCode initialization failpoint did not interrupt at $failpoint." >&2
        exit 1
    fi
    run_configure "$interrupted_config" "$interrupted_data"
    test -s "$interrupted_config/opencode.jsonc"
    test -s "$interrupted_data/server-password"
    if compgen -G "$interrupted_config/.hvo-opencode-initialization-v1-*" >/dev/null \
        || compgen -G "$interrupted_config/.hvo-opencode-initialized-v1-*" >/dev/null \
        || compgen -G "$interrupted_data/.server-password.*" >/dev/null; then
        echo "OpenCode initialization retry left transaction artifacts after $failpoint." >&2
        exit 1
    fi
done

for recovery_failpoint in \
    after-recovery-temporary-config-remove \
    after-recovery-temporary-password-remove \
    after-recovery-config-remove \
    after-recovery-password-remove \
    after-recovery-temporary-inventory-remove \
    after-recovery-inventory-remove; do
    recovery_config="$TEMP_DIR/recovery-$recovery_failpoint/opencode-config"
    recovery_data="$TEMP_DIR/recovery-$recovery_failpoint/opencode-data"
    mkdir -p "$recovery_config" "$recovery_data"
    chmod 700 "$recovery_config" "$recovery_data"
    if bash -c 'env -i HOME="$1" PATH="/usr/bin:/bin" OPENCODE_CONFIG_DIR="$2" OPENCODE_DATA_DIR="$3" HVO_OPENCODE_INIT_FAILPOINT=after-config-install bash "$4"; status=$?; :; exit "$status"' \
        _ "$TEMP_DIR/home" "$recovery_config" "$recovery_data" "$CONFIGURE_SCRIPT" \
        > "$TEMP_DIR/recovery-seed-$recovery_failpoint.out" 2>&1; then
        echo "OpenCode recovery fixture did not interrupt after config installation." >&2
        exit 1
    fi
    if bash -c 'env -i HOME="$1" PATH="/usr/bin:/bin" OPENCODE_CONFIG_DIR="$2" OPENCODE_DATA_DIR="$3" HVO_OPENCODE_INIT_FAILPOINT="$4" bash "$5"; status=$?; :; exit "$status"' \
        _ "$TEMP_DIR/home" "$recovery_config" "$recovery_data" "$recovery_failpoint" "$CONFIGURE_SCRIPT" \
        > "$TEMP_DIR/recovery-kill-$recovery_failpoint.out" 2>&1; then
        echo "OpenCode recovery failpoint did not interrupt at $recovery_failpoint." >&2
        exit 1
    fi
    run_configure "$recovery_config" "$recovery_data"
    test -s "$recovery_config/opencode.jsonc"
    test -s "$recovery_data/server-password"
done

stale_config="$TEMP_DIR/stale-marker/opencode-config"
stale_data="$TEMP_DIR/stale-marker/opencode-data"
mkdir -p "$stale_config" "$stale_data"
chmod 700 "$stale_config" "$stale_data"
if bash -c 'env -i HOME="$1" PATH="/usr/bin:/bin" OPENCODE_CONFIG_DIR="$2" OPENCODE_DATA_DIR="$3" HVO_OPENCODE_INIT_FAILPOINT=after-password-install bash "$4"; status=$?; :; exit "$status"' \
    _ "$TEMP_DIR/home" "$stale_config" "$stale_data" "$CONFIGURE_SCRIPT" \
    > "$TEMP_DIR/stale-marker-kill.out" 2>&1; then
    echo "OpenCode stale-marker fixture did not interrupt after installation." >&2
    exit 1
fi
printf '{"permission":"ask"}\n' > "$stale_config/opencode.jsonc"
chmod 600 "$stale_config/opencode.jsonc"
stale_password_hash="$(sha256sum "$stale_data/server-password")"
expect_configure_failure "$stale_config" "$stale_data" \
    'does not own configuration artifact' "$TEMP_DIR/stale-marker.out"
grep -Fqx '{"permission":"ask"}' "$stale_config/opencode.jsonc"
test "$(sha256sum "$stale_data/server-password")" = "$stale_password_hash"

concurrent_config="$TEMP_DIR/concurrent/opencode-config"
concurrent_data="$TEMP_DIR/concurrent/opencode-data"
mkdir -p "$concurrent_config" "$concurrent_data"
chmod 700 "$concurrent_config" "$concurrent_data"
env -i HOME="$TEMP_DIR/home" PATH="/usr/bin:/bin" \
    OPENCODE_CONFIG_DIR="$concurrent_config" \
    OPENCODE_DATA_DIR="$concurrent_data" \
    HVO_OPENCODE_INIT_PAUSEPOINT=after-marker \
    HVO_OPENCODE_INIT_PAUSE_SECONDS=1 \
    bash "$CONFIGURE_SCRIPT" > "$TEMP_DIR/concurrent-first.out" 2>&1 &
concurrent_first_pid=$!
for _ in {1..100}; do
    if compgen -G "$concurrent_config/.hvo-opencode-initialization-v1-*" >/dev/null; then
        break
    fi
    sleep 0.01
done
compgen -G "$concurrent_config/.hvo-opencode-initialization-v1-*" >/dev/null
run_configure "$concurrent_config" "$concurrent_data" > "$TEMP_DIR/concurrent-second.out" 2>&1 &
concurrent_second_pid=$!
wait "$concurrent_first_pid"
wait "$concurrent_second_pid"
test -s "$concurrent_config/opencode.jsonc"
test -s "$concurrent_data/server-password"
if compgen -G "$concurrent_config/.hvo-opencode-initialization-v1-*" >/dev/null \
    || compgen -G "$concurrent_config/.hvo-opencode-initialized-v1-*" >/dev/null; then
    echo "Concurrent OpenCode initialization left transaction markers." >&2
    exit 1
fi

legacy_config="$TEMP_DIR/legacy/opencode-config"
legacy_data="$TEMP_DIR/legacy/opencode-data"
mkdir -p "$legacy_config" "$legacy_data"
chmod 700 "$legacy_config" "$legacy_data"
printf '{\n\t"$schema": "https://opencode.ai/config.json",\n\t"permission": "allow"\n}\n' \
    > "$legacy_config/opencode.jsonc"
printf 'legacy-password\n' > "$legacy_data/server-password"
chmod 600 "$legacy_config/opencode.jsonc" "$legacy_data/server-password"
legacy_config_hash="$(sha256sum "$legacy_config/opencode.jsonc")"
legacy_password_hash="$(sha256sum "$legacy_data/server-password")"
expect_configure_failure "$legacy_config" "$legacy_data" \
    'obsolete blanket-allow configuration detected' "$TEMP_DIR/legacy.out"
test "$(sha256sum "$legacy_config/opencode.jsonc")" = "$legacy_config_hash"
test "$(sha256sum "$legacy_data/server-password")" = "$legacy_password_hash"

custom_config="$TEMP_DIR/custom/opencode-config"
custom_data="$TEMP_DIR/custom/opencode-data"
mkdir -p "$custom_config" "$custom_data"
chmod 700 "$custom_config" "$custom_data"
printf '{"permission":"ask"}\n' > "$custom_config/opencode.jsonc"
printf 'custom-password\n' > "$custom_data/server-password"
chmod 600 "$custom_config/opencode.jsonc" "$custom_data/server-password"
custom_config_hash="$(sha256sum "$custom_config/opencode.jsonc")"
custom_password_hash="$(sha256sum "$custom_data/server-password")"
run_configure "$custom_config" "$custom_data"
test "$(sha256sum "$custom_config/opencode.jsonc")" = "$custom_config_hash"
test "$(sha256sum "$custom_data/server-password")" = "$custom_password_hash"

chmod 644 "$custom_config/opencode.jsonc"
expect_configure_failure "$custom_config" "$custom_data" \
    'must have mode 0600, not 644' "$TEMP_DIR/custom-mode.out"
test "$(stat -c %a "$custom_config/opencode.jsonc")" = 644
chmod 600 "$custom_config/opencode.jsonc"

partial_config="$TEMP_DIR/partial/opencode-config"
partial_data="$TEMP_DIR/partial/opencode-data"
mkdir -p "$partial_config" "$partial_data"
chmod 700 "$partial_config" "$partial_data"
printf '{}\n' > "$partial_config/opencode.jsonc"
chmod 600 "$partial_config/opencode.jsonc"
expect_configure_failure "$partial_config" "$partial_data" \
    'configuration and server password must either both exist or both be absent' \
    "$TEMP_DIR/partial.out"
test ! -e "$partial_data/server-password"

empty_config="$TEMP_DIR/empty/opencode-config"
empty_data="$TEMP_DIR/empty/opencode-data"
mkdir -p "$empty_config" "$empty_data"
chmod 700 "$empty_config" "$empty_data"
: > "$empty_config/opencode.jsonc"
printf 'existing-password\n' > "$empty_data/server-password"
chmod 600 "$empty_config/opencode.jsonc" "$empty_data/server-password"
expect_configure_failure "$empty_config" "$empty_data" \
    'must not be empty' "$TEMP_DIR/empty.out"
test ! -s "$empty_config/opencode.jsonc"

nonempty_config="$TEMP_DIR/nonempty/opencode-config"
nonempty_data="$TEMP_DIR/nonempty/opencode-data"
mkdir -p "$nonempty_config" "$nonempty_data"
chmod 700 "$nonempty_config" "$nonempty_data"
printf 'unrelated state\n' > "$nonempty_data/session-state"
expect_configure_failure "$nonempty_config" "$nonempty_data" \
    'fresh initialization requires empty configuration and data roots' "$TEMP_DIR/nonempty.out"
test ! -e "$nonempty_config/opencode.jsonc"
test ! -e "$nonempty_data/server-password"

missing_config="$TEMP_DIR/missing/opencode-config"
missing_data="$TEMP_DIR/missing/opencode-data"
mkdir -p "$missing_data"
chmod 700 "$missing_data"
expect_configure_failure "$missing_config" "$missing_data" \
    'must be an existing non-symlink directory' "$TEMP_DIR/missing.out"

symlink_config="$TEMP_DIR/symlink/opencode-config"
symlink_data="$TEMP_DIR/symlink/opencode-data"
symlink_target="$TEMP_DIR/symlink/config-target"
mkdir -p "$symlink_target" "$symlink_data"
chmod 700 "$symlink_target" "$symlink_data"
ln -s "$symlink_target" "$symlink_config"
expect_configure_failure "$symlink_config" "$symlink_data" \
    'must be an existing non-symlink directory' "$TEMP_DIR/symlink.out"

if sudo -n true >/dev/null 2>&1; then
    sudo chown 0:0 "$custom_data/server-password"
    expect_configure_failure "$custom_config" "$custom_data" \
        'must be owned by' "$TEMP_DIR/custom-owner.out"
    sudo chown "$(id -u):$(id -g)" "$custom_data/server-password"
fi

grep -Fq 'persistent in-container server' "$REPO_ROOT/README.md"
grep -Fq 'publishes it to every Docker-host interface' "$REPO_ROOT/README.md"
grep -Fq 'The HTTP endpoint does not use TLS.' "$REPO_ROOT/README.md"
grep -Fq 'Host firewall rules must restrict port `4097`' "$REPO_ROOT/README.md"
grep -Fq 'scripts/opencode:remote-connect --continue' "$REPO_ROOT/README.md"
grep -Fq '`opencode-worktrees` is mounted at `/tmp/opencode`' "$REPO_ROOT/README.md"
grep -Fq 'Normal `/tmp` remains disposable' "$REPO_ROOT/README.md"
grep -Fq 'all four developer-state paths' "$REPO_ROOT/README.md"
grep -Fq 'fail without rewriting or relocating it' "$REPO_ROOT/README.md"

initialize_fixture="$TEMP_DIR/initialize-repo"
mkdir -p "$initialize_fixture/.devcontainer" "$TEMP_DIR/initialize-home"
cp "$INITIALIZE_SCRIPT" "$initialize_fixture/.devcontainer/initialize.sh"
HOME="$TEMP_DIR/initialize-home" bash "$initialize_fixture/.devcontainer/initialize.sh"
for state_directory in \
    "$initialize_fixture/.devcontainer/state" \
    "$initialize_fixture/.devcontainer/state/agent-scratch" \
    "$initialize_fixture/.devcontainer/state/opencode-config" \
    "$initialize_fixture/.devcontainer/state/opencode-data" \
    "$initialize_fixture/.devcontainer/state/opencode-worktrees"; do
    test "$(stat -c %a "$state_directory")" = 700
    test "$(stat -c '%u:%g' "$state_directory")" = "$(id -u):$(id -g)"
done
printf 'preserved worktree state\n' \
    > "$initialize_fixture/.devcontainer/state/opencode-worktrees/sentinel"
HOME="$TEMP_DIR/initialize-home" bash "$initialize_fixture/.devcontainer/initialize.sh"
grep -Fqx 'preserved worktree state' \
    "$initialize_fixture/.devcontainer/state/opencode-worktrees/sentinel"
chmod 755 "$initialize_fixture/.devcontainer/state/agent-scratch"
if HOME="$TEMP_DIR/initialize-home" bash "$initialize_fixture/.devcontainer/initialize.sh" \
    > "$TEMP_DIR/initialize-mode.out" 2>&1; then
    echo "Host initialization unexpectedly repaired an unsafe persistent-state mode." >&2
    exit 1
fi
grep -Fq 'must be owned by' "$TEMP_DIR/initialize-mode.out"
test "$(stat -c %a "$initialize_fixture/.devcontainer/state/agent-scratch")" = 755

partial_initialize_fixture="$TEMP_DIR/partial-initialize-repo"
mkdir -p "$partial_initialize_fixture/.devcontainer/state/opencode-config" \
    "$TEMP_DIR/partial-initialize-home"
chmod 700 \
    "$partial_initialize_fixture/.devcontainer/state" \
    "$partial_initialize_fixture/.devcontainer/state/opencode-config"
cp "$INITIALIZE_SCRIPT" "$partial_initialize_fixture/.devcontainer/initialize.sh"
if HOME="$TEMP_DIR/partial-initialize-home" \
    bash "$partial_initialize_fixture/.devcontainer/initialize.sh" \
    > "$TEMP_DIR/initialize-partial.out" 2>&1; then
    echo "Host initialization unexpectedly repaired partial persistent state." >&2
    exit 1
fi
grep -Fq 'Existing persistent developer state is incomplete' "$TEMP_DIR/initialize-partial.out"
test ! -e "$partial_initialize_fixture/.devcontainer/state/agent-scratch"

portable_initialize_fixture="$TEMP_DIR/portable-initialize-repo"
portable_initialize_bin="$TEMP_DIR/portable-initialize-bin"
mkdir -p "$portable_initialize_fixture/.devcontainer" \
    "$TEMP_DIR/portable-initialize-home" \
    "$portable_initialize_bin"
cp "$INITIALIZE_SCRIPT" "$portable_initialize_fixture/.devcontainer/initialize.sh"
cat > "$portable_initialize_bin/stat" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$1" == -c ]]; then
    exit 1
fi
[[ "$1" == -f ]]
format="$2"
shift 2
[[ "${1:-}" == -- ]] && shift
case "$format" in
    %u:%g) exec /usr/bin/stat -c '%u:%g' -- "$1" ;;
    %Lp) exec /usr/bin/stat -c '%a' -- "$1" ;;
    *) exit 2 ;;
esac
EOF
chmod 700 "$portable_initialize_bin/stat"
HOME="$TEMP_DIR/portable-initialize-home" PATH="$portable_initialize_bin:/usr/bin:/bin" \
    bash "$portable_initialize_fixture/.devcontainer/initialize.sh"
HOME="$TEMP_DIR/portable-initialize-home" PATH="$portable_initialize_bin:/usr/bin:/bin" \
    bash "$portable_initialize_fixture/.devcontainer/initialize.sh"
test "$(stat -c %a "$portable_initialize_fixture/.devcontainer/state")" = 700

for failpoint in \
    after-root \
    after-agent-scratch \
    after-opencode-config \
    after-opencode-data \
    after-opencode-worktrees \
    before-install; do
    interrupted_initialize_fixture="$TEMP_DIR/interrupted-initialize-$failpoint"
    interrupted_initialize_home="$TEMP_DIR/interrupted-initialize-home-$failpoint"
    mkdir -p "$interrupted_initialize_fixture/.devcontainer" "$interrupted_initialize_home"
    cp "$INITIALIZE_SCRIPT" "$interrupted_initialize_fixture/.devcontainer/initialize.sh"
    if bash -c 'HOME="$1" HVO_DEVCONTAINER_INIT_FAILPOINT="$2" bash "$3"; status=$?; :; exit "$status"' \
        _ "$interrupted_initialize_home" "$failpoint" \
        "$interrupted_initialize_fixture/.devcontainer/initialize.sh" \
        > "$TEMP_DIR/interrupted-initialize-$failpoint.out" 2>&1; then
        echo "Host initialization failpoint did not interrupt at $failpoint." >&2
        exit 1
    fi
    HOME="$interrupted_initialize_home" \
        bash "$interrupted_initialize_fixture/.devcontainer/initialize.sh"
    test -d "$interrupted_initialize_fixture/.devcontainer/state/opencode-worktrees"
    test ! -e "$interrupted_initialize_fixture/.devcontainer/.state-initialization-v1"
done

nested_initialize_fixture="$TEMP_DIR/nested-initialize-repo"
nested_initialize_home="$TEMP_DIR/nested-initialize-home"
mkdir -p \
    "$nested_initialize_fixture/.devcontainer/.state-initialization-v1/agent-scratch" \
    "$nested_initialize_fixture/.devcontainer/.state-initialization-v1/opencode-config" \
    "$nested_initialize_fixture/.devcontainer/.state-initialization-v1/opencode-data" \
    "$nested_initialize_fixture/.devcontainer/.state-initialization-v1/opencode-worktrees" \
    "$nested_initialize_home"
chmod 700 \
    "$nested_initialize_fixture/.devcontainer/.state-initialization-v1" \
    "$nested_initialize_fixture/.devcontainer/.state-initialization-v1"/*
printf 'unexpected staged credential\n' \
    > "$nested_initialize_fixture/.devcontainer/.state-initialization-v1/opencode-data/server-password"
cp "$INITIALIZE_SCRIPT" "$nested_initialize_fixture/.devcontainer/initialize.sh"
if HOME="$nested_initialize_home" bash "$nested_initialize_fixture/.devcontainer/initialize.sh" \
    > "$TEMP_DIR/nested-initialize.out" 2>&1; then
    echo "Host initialization accepted nested staged state." >&2
    exit 1
fi
grep -Fq 'initialization directory must be empty' "$TEMP_DIR/nested-initialize.out"
test ! -e "$nested_initialize_fixture/.devcontainer/state"
grep -Fqx 'unexpected staged credential' \
    "$nested_initialize_fixture/.devcontainer/.state-initialization-v1/opencode-data/server-password"

persistence_root="$TEMP_DIR/persistence"
persistence_bin="$persistence_root/bin"
mkdir -p \
    "$persistence_bin" \
    "$persistence_root/opencode-worktrees" \
    "$persistence_root/agent-scratch" \
    "$persistence_root/opencode-config" \
    "$persistence_root/opencode-data"
chmod 700 "$persistence_root"/*/
cat > "$persistence_bin/findmnt" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
output=""
target=""
while (($# > 0)); do
    case "$1" in
        --output)
            output="$2"
            shift 2
            ;;
        --target)
            target="$2"
            shift 2
            ;;
        *) shift ;;
    esac
done
[[ "${FAKE_FINDMNT_FAIL:-false}" == false ]]
case "$output" in
    TARGET) printf '%s\n' "${FAKE_FINDMNT_TARGET:-$target}" ;;
    SOURCE) printf '%s\n' "${FAKE_FINDMNT_SOURCE:-/workspace/.devcontainer/state/$(basename "$target")}" ;;
    FSTYPE) printf '%s\n' "${FAKE_FINDMNT_FSTYPE:-ext4}" ;;
    *) exit 2 ;;
esac
EOF
chmod 700 "$persistence_bin/findmnt"

persistence_env=(
    env
    "PATH=$persistence_bin:/usr/bin:/bin"
    "HVO_AGENT_WORKTREE_ROOT=$persistence_root/opencode-worktrees"
    "HVO_AGENT_STATE_ROOT=$persistence_root/agent-scratch"
    "HVO_DEVCONTAINER_STATE_SOURCE=/workspace/.devcontainer/state"
    "OPENCODE_CONFIG_DIR=$persistence_root/opencode-config"
    "OPENCODE_DATA_DIR=$persistence_root/opencode-data"
)
"${persistence_env[@]}" bash "$PERSISTENCE_SCRIPT" > "$TEMP_DIR/persistence.out"
grep -Fq 'Persistent agent state verified' "$TEMP_DIR/persistence.out"

if FAKE_FINDMNT_SOURCE=/wrong/source "${persistence_env[@]}" bash "$PERSISTENCE_SCRIPT" \
    > "$TEMP_DIR/persistence-source.out" 2>&1; then
    echo "Persistence verification accepted the wrong bind source." >&2
    exit 1
fi
grep -Fq 'has unexpected mount source' "$TEMP_DIR/persistence-source.out"

if FAKE_FINDMNT_SOURCE=/other/checkout/.devcontainer/state/opencode-worktrees \
    "${persistence_env[@]}" bash "$PERSISTENCE_SCRIPT" \
    > "$TEMP_DIR/persistence-other-checkout.out" 2>&1; then
    echo "Persistence verification accepted another checkout with the expected root suffix." >&2
    exit 1
fi
grep -Fq 'has unexpected mount source' "$TEMP_DIR/persistence-other-checkout.out"

if FAKE_FINDMNT_FSTYPE=overlay "${persistence_env[@]}" bash "$PERSISTENCE_SCRIPT" \
    > "$TEMP_DIR/persistence-filesystem.out" 2>&1; then
    echo "Persistence verification accepted an ephemeral filesystem." >&2
    exit 1
fi
grep -Fq "uses ephemeral filesystem type 'overlay'" "$TEMP_DIR/persistence-filesystem.out"

chmod 755 "$persistence_root/agent-scratch"
if "${persistence_env[@]}" bash "$PERSISTENCE_SCRIPT" \
    > "$TEMP_DIR/persistence-mode.out" 2>&1; then
    echo "Persistence verification accepted an unsafe root mode." >&2
    exit 1
fi
grep -Fq 'must have mode 0700, not 755' "$TEMP_DIR/persistence-mode.out"
chmod 700 "$persistence_root/agent-scratch"

if FAKE_FINDMNT_TARGET=/wrong/target "${persistence_env[@]}" bash "$PERSISTENCE_SCRIPT" \
    > "$TEMP_DIR/persistence-target.out" 2>&1; then
    echo "Persistence verification accepted a nondedicated mount target." >&2
    exit 1
fi
grep -Fq 'is not a dedicated persistent mount' "$TEMP_DIR/persistence-target.out"

if FAKE_FINDMNT_FAIL=true "${persistence_env[@]}" bash "$PERSISTENCE_SCRIPT" \
    > "$TEMP_DIR/persistence-metadata.out" 2>&1; then
    echo "Persistence verification accepted unavailable mount metadata." >&2
    exit 1
fi
grep -Fq 'mount metadata is unavailable' "$TEMP_DIR/persistence-metadata.out"

if sudo -n true >/dev/null 2>&1; then
    sudo chown 0:0 "$persistence_root/opencode-data"
    if "${persistence_env[@]}" bash "$PERSISTENCE_SCRIPT" \
        > "$TEMP_DIR/persistence-owner.out" 2>&1; then
        echo "Persistence verification accepted the wrong root owner." >&2
        exit 1
    fi
    grep -Fq 'must be owned by' "$TEMP_DIR/persistence-owner.out"
    sudo chown "$(id -u):$(id -g)" "$persistence_root/opencode-data"
fi

if [[ ! -f /.dockerenv ]]; then
    for lifecycle_script in "$ENABLE_SCRIPT" "$DISABLE_SCRIPT"; do
        if bash "$lifecycle_script" >"$TEMP_DIR/container-guard.out" 2>&1; then
            echo "$(basename "$lifecycle_script") unexpectedly ran outside the devcontainer." >&2
            exit 1
        fi
        grep -Fq 'Run this script inside the devcontainer.' "$TEMP_DIR/container-guard.out"
    done
fi

if [[ -f /.dockerenv ]] \
    && [[ -x /usr/local/bin/opencode ]] \
    && command -v curl >/dev/null 2>&1 \
    && command -v python3 >/dev/null 2>&1 \
    && command -v script >/dev/null 2>&1 \
    && command -v ss >/dev/null 2>&1 \
    && command -v tmux >/dev/null 2>&1; then
    LIFECYCLE_SESSION="hvo-opencode-test-$$"
    export HVO_OPENCODE_PERSISTENCE_VERIFIER=/bin/true
    lifecycle_port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
    lifecycle_data="$TEMP_DIR/lifecycle-data"
    mkdir -p "$lifecycle_data"
    printf 'test-only-password\n' > "$lifecycle_data/server-password"
    chmod 600 "$lifecycle_data/server-password"

    lifecycle_env=(
        env
        "OPENCODE_TMUX_SESSION=$LIFECYCLE_SESSION"
        "OPENCODE_CONTAINER_PORT=$lifecycle_port"
        "OPENCODE_DATA_DIR=$lifecycle_data"
        "HVO_OPENCODE_CONFIGURATOR=/bin/true"
    )

    invalid_fresh_config="$TEMP_DIR/invalid-enable/opencode-config"
    invalid_fresh_data="$TEMP_DIR/invalid-enable/opencode-data"
    mkdir -p "$invalid_fresh_config" "$invalid_fresh_data"
    chmod 700 "$invalid_fresh_config" "$invalid_fresh_data"
    if env \
        OPENCODE_TMUX_SESSION="${LIFECYCLE_SESSION}-invalid-fresh" \
        OPENCODE_CONTAINER_PORT=0 \
        OPENCODE_CONFIG_DIR="$invalid_fresh_config" \
        OPENCODE_DATA_DIR="$invalid_fresh_data" \
        "$ENABLE_SCRIPT" > "$TEMP_DIR/invalid-fresh-enable.out" 2>&1; then
        echo "OpenCode enable accepted an invalid port against fresh state." >&2
        exit 1
    fi
    grep -Fq 'OPENCODE_CONTAINER_PORT must be an integer from 1 through 65535.' \
        "$TEMP_DIR/invalid-fresh-enable.out"
    test ! -e "$invalid_fresh_config/opencode.jsonc"
    test ! -e "$invalid_fresh_data/server-password"

    for invalid_port in 0 0100000 099999 65536 100000; do
        if env \
            "OPENCODE_TMUX_SESSION=${LIFECYCLE_SESSION}-invalid" \
            "OPENCODE_CONTAINER_PORT=$invalid_port" \
            "OPENCODE_DATA_DIR=$lifecycle_data" \
            "$ENABLE_SCRIPT" > "$TEMP_DIR/invalid-enable.out" 2>&1; then
            echo "OpenCode enable accepted invalid port '$invalid_port'." >&2
            exit 1
        fi
        grep -Fq 'OPENCODE_CONTAINER_PORT must be an integer from 1 through 65535.' \
            "$TEMP_DIR/invalid-enable.out"

        if env \
            "OPENCODE_TMUX_SESSION=${LIFECYCLE_SESSION}-invalid" \
            "OPENCODE_CONTAINER_PORT=$invalid_port" \
            "OPENCODE_DATA_DIR=$lifecycle_data" \
            "$DISABLE_SCRIPT" > "$TEMP_DIR/invalid-disable.out" 2>&1; then
            echo "OpenCode disable accepted invalid port '$invalid_port'." >&2
            exit 1
        fi
        grep -Fq 'OPENCODE_CONTAINER_PORT must be an integer from 1 through 65535.' \
            "$TEMP_DIR/invalid-disable.out"

        if env \
            "OPENCODE_CONTAINER_PORT=$invalid_port" \
            "OPENCODE_DATA_DIR=$lifecycle_data" \
            script --quiet --return --command "$CONNECT_SCRIPT" /dev/null \
            > "$TEMP_DIR/invalid-connect.out" 2>&1; then
            echo "OpenCode connect accepted invalid port '$invalid_port'." >&2
            exit 1
        fi
        grep -Fq 'OpenCode port must be an integer from 1 through 65535.' \
            "$TEMP_DIR/invalid-connect.out"
    done

    first_run_session="${LIFECYCLE_SESSION}-first-run"
    first_run_data="$TEMP_DIR/missing-lifecycle-data"
    env \
        "OPENCODE_TMUX_SESSION=$first_run_session" \
        "OPENCODE_CONTAINER_PORT=$lifecycle_port" \
        "OPENCODE_DATA_DIR=$first_run_data" \
        "$DISABLE_SCRIPT" > "$TEMP_DIR/first-run-disable.out"
    grep -Fq "OpenCode is not running in internal tmux session '$first_run_session'." \
        "$TEMP_DIR/first-run-disable.out"
    if [[ -e "$first_run_data" ]]; then
        echo "First-run disable unexpectedly created OpenCode state." >&2
        exit 1
    fi

    "${lifecycle_env[@]}" "$ENABLE_SCRIPT" > "$TEMP_DIR/enable.out"
    grep -Fq "OpenCode is running in internal tmux session '$LIFECYCLE_SESSION'." "$TEMP_DIR/enable.out"
    test "$(curl --silent --output /dev/null --write-out '%{http_code}' \
        --user 'opencode:test-only-password' \
        "http://127.0.0.1:${lifecycle_port}/global/health")" = 200

    "${lifecycle_env[@]}" "$ENABLE_SCRIPT" > "$TEMP_DIR/enable-again.out"
    grep -Fq "OpenCode is already running in internal tmux session '$LIFECYCLE_SESSION'." \
        "$TEMP_DIR/enable-again.out"

    tmux set-option -t "$LIFECYCLE_SESSION" @hvo-opencode-port invalid
    if "${lifecycle_env[@]}" "$DISABLE_SCRIPT" > "$TEMP_DIR/mismatched-disable.out" 2>&1; then
        echo "OpenCode disable accepted mismatched lifecycle identity." >&2
        exit 1
    fi
    tmux has-session -t "$LIFECYCLE_SESSION"
    grep -Fq 'leaving it running.' "$TEMP_DIR/mismatched-disable.out"

    tmux set-option -t "$LIFECYCLE_SESSION" @hvo-opencode-port "$lifecycle_port"
    "${lifecycle_env[@]}" "$DISABLE_SCRIPT" > "$TEMP_DIR/disable.out"
    if tmux has-session -t "$LIFECYCLE_SESSION" 2>/dev/null; then
        echo "OpenCode disable left the verified test session running." >&2
        exit 1
    fi

    create_dead_lifecycle_session() {
        tmux new-session -d -s "$LIFECYCLE_SESSION" sleep 30
        tmux set-option -t "$LIFECYCLE_SESSION" @hvo-opencode-repo "$REPO_ROOT"
        tmux set-option -t "$LIFECYCLE_SESSION" @hvo-opencode-port "$lifecycle_port"
        tmux set-window-option -t "$LIFECYCLE_SESSION" remain-on-exit on
        tmux send-keys -t "$LIFECYCLE_SESSION" C-c
        for _ in {1..20}; do
            if [[ "$(tmux display-message -p -t "$LIFECYCLE_SESSION" '#{pane_dead}')" == 1 ]]; then
                return
            fi
            sleep 0.1
        done
        echo "OpenCode test session did not reach the expected dead-pane state." >&2
        exit 1
    }

    create_dead_lifecycle_session
    "${lifecycle_env[@]}" "$ENABLE_SCRIPT" > "$TEMP_DIR/dead-pane-enable.out"
    grep -Fq "Cleared exited OpenCode tmux session '$LIFECYCLE_SESSION'." \
        "$TEMP_DIR/dead-pane-enable.out"
    grep -Fq "OpenCode is running in internal tmux session '$LIFECYCLE_SESSION'." \
        "$TEMP_DIR/dead-pane-enable.out"
    "${lifecycle_env[@]}" "$DISABLE_SCRIPT" > "$TEMP_DIR/restarted-disable.out"

    create_dead_lifecycle_session
    "${lifecycle_env[@]}" "$DISABLE_SCRIPT" > "$TEMP_DIR/dead-pane-disable.out"
    grep -Fq "Cleared exited OpenCode tmux session '$LIFECYCLE_SESSION'." \
        "$TEMP_DIR/dead-pane-disable.out"
    if tmux has-session -t "$LIFECYCLE_SESSION" 2>/dev/null; then
        echo "OpenCode disable left the matching dead-pane test session running." >&2
        exit 1
    fi
    LIFECYCLE_SESSION=""
fi

echo "OpenCode in-container lifecycle contract passed."
