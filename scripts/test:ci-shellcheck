#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly CHECKER="$SCRIPT_DIR/ci:shellcheck"

WORK="$(mktemp -d)"
readonly WORK
trap 'rm -rf "$WORK"' EXIT

shellcheck_bin="${HVO_SHELLCHECK_BIN:-$(command -v shellcheck || true)}"
[[ -n "$shellcheck_bin" ]] || { printf 'ShellCheck 0.9.0 is required for the contract test.\n' >&2; exit 1; }

failures=0
cases=0
expect() {
    local name="$1" want_exit="$2" want_text="$3" target_file="$4"
    cases=$((cases + 1))
    local out status
    set +e
    out="$(HVO_SHELLCHECK_REPO_ROOT="$WORK" HVO_SHELLCHECK_BIN="$shellcheck_bin" \
        "$BASH" "$CHECKER" --targets-from0 "$target_file" 2>&1)"
    status=$?
    set -e
    if [[ "$status" != "$want_exit" || "$out" != *"$want_text"* ]]; then
        failures=$((failures + 1))
        printf 'FAIL %s\n  expected exit=%s containing: %s\n  actual exit=%s output:\n%s\n' \
            "$name" "$want_exit" "$want_text" "$status" "$out" >&2
    fi
}

printf '#!/usr/bin/env bash\nprintf "ok\\n"\n' > "$WORK/good file.sh"
printf '%s\0' 'good file.sh' > "$WORK/good.targets"
expect 'path containing spaces is preserved' 0 'passed for 1 derived shell file' "$WORK/good.targets"

# SC2218 is error severity in ShellCheck 0.9.0 and is deterministic without executing the file.
cat > "$WORK/error.sh" <<'EOF'
#!/usr/bin/env bash
called_later
called_later() { :; }
EOF
printf '%s\0' 'error.sh' > "$WORK/error.targets"
expect 'new error-level diagnostic fails enforcement' 1 'SC2218' "$WORK/error.targets"

# The source directive is load-bearing: the runtime source expression is dynamic and ShellCheck
# can resolve it only through the directive.
printf 'sourced_value=ok\n' > "$WORK/source-library.sh"
printf '#!/usr/bin/env bash\nSCRIPT_DIR=%q\n# shellcheck source=%s\n. "$SCRIPT_DIR/source-library.sh"\n' \
    "$WORK" "$WORK/source-library.sh" > "$WORK/source-main.sh"
printf 'printf "%%s\\n" "$sourced_value"\n' >> "$WORK/source-main.sh"
cases=$((cases + 1))
set +e
source_output="$($shellcheck_bin -x --severity=warning "$WORK/source-main.sh" 2>&1)"
source_status=$?
set -e
if ((source_status != 0)) || [[ "$source_output" == *'SC2154'* ]]; then
    failures=$((failures + 1))
    printf 'FAIL source directive was not followed:\n%s\n' "$source_output" >&2
fi
grep -v '^# shellcheck source=' "$WORK/source-main.sh" > "$WORK/source-without-directive.sh"
cases=$((cases + 1))
set +e
source_mutation="$($shellcheck_bin -x --severity=warning "$WORK/source-without-directive.sh" 2>&1)"
source_mutation_status=$?
set -e
if ((source_mutation_status == 0)) || [[ "$source_mutation" != *'SC2154'* ]]; then
    failures=$((failures + 1))
    printf 'FAIL removing the source directive did not expose SC2154:\n%s\n' "$source_mutation" >&2
fi

# Bind the production argument vector: a wrapper rejects anything except -x --severity=error,
# then delegates to the actual pinned-version binary.
cat > "$WORK/arg-check-shellcheck" <<EOF
#!/usr/bin/env bash
if [[ "\${1-}" == '--version' ]]; then exec "$shellcheck_bin" --version; fi
[[ "\${1-}" == '-x' && "\${2-}" == '--severity=error' ]] || { printf 'missing production ShellCheck arguments\\n' >&2; exit 97; }
exec "$shellcheck_bin" "\$@"
EOF
chmod 700 "$WORK/arg-check-shellcheck"
expect_with_bin() {
    local name="$1" want_exit="$2" want_text="$3" target_file="$4" bin="$5"
    cases=$((cases + 1))
    local out status
    set +e
    out="$(HVO_SHELLCHECK_REPO_ROOT="$WORK" HVO_SHELLCHECK_BIN="$bin" \
        "$BASH" "$CHECKER" --targets-from0 "$target_file" 2>&1)"
    status=$?
    set -e
    if [[ "$status" != "$want_exit" || "$out" != *"$want_text"* ]]; then
        failures=$((failures + 1))
        printf 'FAIL %s\n  expected exit=%s containing: %s\n  actual exit=%s output:\n%s\n' \
            "$name" "$want_exit" "$want_text" "$status" "$out" >&2
    fi
}
expect_with_bin 'production invocation retains -x and error severity' 0 'passed for 1 derived shell file' \
    "$WORK/good.targets" "$WORK/arg-check-shellcheck"

# The selector may emit output and then fail. Its non-zero status must win over partial output.
cat > "$WORK/partial-selector" <<'EOF'
#!/usr/bin/env bash
printf '%s\0' 'good file.sh'
exit 23
EOF
chmod 700 "$WORK/partial-selector"
cases=$((cases + 1))
set +e
partial_output="$(HVO_SHELLCHECK_REPO_ROOT="$WORK" HVO_SHELLCHECK_BIN="$shellcheck_bin" HVO_SHELL_SELECTOR="$WORK/partial-selector" \
    "$BASH" "$CHECKER" 2>&1)"
partial_status=$?
set -e
if ((partial_status == 0)) || [[ "$partial_output" != *'selector failed'* ]]; then
    failures=$((failures + 1))
    printf 'FAIL partial selector output was accepted:\n%s\n' "$partial_output" >&2
fi

# NUL records preserve a newline-bearing path even when both line fragments are also real files.
newline_path="$WORK/left.sh"$'\n'"right.sh"
printf '#!/usr/bin/env bash\ncalled_later\ncalled_later() { :; }\n' > "$newline_path"
printf '#!/usr/bin/env bash\n:\n' > "$WORK/left.sh"
printf '#!/usr/bin/env bash\n:\n' > "$WORK/right.sh"
cat > "$WORK/newline-selector" <<'EOF'
#!/usr/bin/env bash
printf '%s\0' 'left.sh' 'right.sh' 'left.sh
right.sh'
EOF
chmod 700 "$WORK/newline-selector"
cases=$((cases + 1))
set +e
newline_output="$(HVO_SHELLCHECK_REPO_ROOT="$WORK" HVO_SHELLCHECK_BIN="$shellcheck_bin" HVO_SHELL_SELECTOR="$WORK/newline-selector" \
    "$BASH" "$CHECKER" 2>&1)"
newline_status=$?
set -e
if ((newline_status == 0)) || [[ "$newline_output" != *'SC2218'* ]]; then
    failures=$((failures + 1))
    printf 'FAIL newline-bearing error path was not linted:\n%s\n' "$newline_output" >&2
fi

: > "$WORK/empty.targets"
expect 'empty derived set fails closed' 1 'No shell files selected' "$WORK/empty.targets"

# Unterminated, duplicate, absolute, and escaping records are protocol errors.
printf '%s' 'good file.sh' > "$WORK/unterminated.targets"
expect 'unterminated NUL protocol fails closed' 1 'not terminated by a NUL' "$WORK/unterminated.targets"
printf '%s\0%s\0' 'good file.sh' 'good file.sh' > "$WORK/duplicate.targets"
expect 'duplicate target fails closed' 1 'duplicated' "$WORK/duplicate.targets"
printf '%s\0' "$WORK/good file.sh" > "$WORK/absolute.targets"
expect 'absolute target fails closed' 1 'repository-relative' "$WORK/absolute.targets"
printf '%s\0' '../outside.sh' > "$WORK/escape.targets"
expect 'escaping target fails closed' 1 'repository-relative' "$WORK/escape.targets"

cat > "$WORK/fake-shellcheck" <<'EOF'
#!/usr/bin/env bash
if [[ "${1-}" == '--version' ]]; then printf 'version: 9.9.9\n'; exit 0; fi
exit 0
EOF
chmod 700 "$WORK/fake-shellcheck"
cases=$((cases + 1))
set +e
wrong_version="$(HVO_SHELLCHECK_REPO_ROOT="$WORK" HVO_SHELLCHECK_BIN="$WORK/fake-shellcheck" \
    "$BASH" "$CHECKER" --targets-from0 "$WORK/good.targets" 2>&1)"
wrong_status=$?
set -e
if ((wrong_status == 0)) || [[ "$wrong_version" != *'Expected ShellCheck 0.9.0'* ]]; then
    failures=$((failures + 1))
    printf 'FAIL wrong tool version was accepted:\n%s\n' "$wrong_version" >&2
fi

printf 'not the pinned release archive\n' > "$WORK/corrupt.tar.xz"
cases=$((cases + 1))
set +e
checksum_failure="$(HVO_SHELLCHECK_ARCHIVE_PATH="$WORK/corrupt.tar.xz" HVO_SHELLCHECK_BIN='' \
    HVO_SHELLCHECK_REPO_ROOT="$WORK" "$BASH" "$CHECKER" --targets-from0 "$WORK/good.targets" 2>&1)"
checksum_status=$?
set -e
if ((checksum_status == 0)) || [[ "$checksum_failure" != *'checksum verification failed'* ]]; then
    failures=$((failures + 1))
    printf 'FAIL corrupt pinned archive was accepted:\n%s\n' "$checksum_failure" >&2
fi

if ((failures > 0)); then
    printf '%s/%s ci:shellcheck cases failed.\n' "$failures" "$cases" >&2
    exit 1
fi
printf 'ci:shellcheck contract: %s cases passed with ShellCheck 0.9.0.\n' "$cases"
