    .expectedArchitecture=$logic.expectedArchitecture | .expectedHostName=$logic.expectedHostName |
    .expectedHostIdentity=$logic.expectedHostIdentity | .expectedDockerDaemonIdentity=$logic.expectedDockerDaemonIdentity) |
