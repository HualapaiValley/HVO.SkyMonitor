cat > "$REMOTE_BIN/curl" <<'EOF'
#!/usr/bin/bash
set -euo pipefail
output= response_headers= cookie_jar= cookies= body= method=GET explicit_request=false location=false url="${*: -1}"
url="${url//\\&/$'\x26'}"
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
  case "${args[$i]}" in
    --output) output="${args[$((i+1))]}" ;;
    --dump-header) response_headers="${args[$((i+1))]}" ;;
    --cookie-jar) cookie_jar="${args[$((i+1))]}" ;;
    --cookie) cookies="${args[$((i+1))]}" ;;
    --data-binary) body="${args[$((i+1))]#@}"; [[ "$method" != GET ]] || method=POST ;;
    --request) method="${args[$((i+1))]}"; explicit_request=true ;;
    --data-urlencode) [[ "$method" != GET ]] || method=POST ;;
    --location) location=true ;;
  esac
done
if [[ -n "$cookie_jar" ]]; then [[ -e "$cookie_jar" ]] || : > "$cookie_jar"; chmod 600 "$cookie_jar"; fi
if [[ "$url" == */Account/Login && "$method" == GET ]]; then
  printf '<input name="__RequestVerificationToken" type="hidden" value="fixture-antiforgery" />\n' > "$output"
  printf 200; exit 0
fi
if [[ "$url" == */Account/Login && "$method" == POST ]]; then
  [[ "$location" == true ]] || { : > "$output"; printf 302; exit 0; }
  if [[ "$explicit_request" == true ]]; then : > "$output"; printf 405; exit 0; fi
  printf 'owner-authenticated\n' >> "$cookie_jar"
  : > "$output"; printf 200; exit 0
fi
if [[ "$url" == */api/internal/deployment/antiforgery ]]; then
  [[ -n "$cookies" && -f "$cookies" ]] && grep -Fq owner-authenticated "$cookies" || { : > "$output"; printf 403; exit 0; }
  jq -cn '{formFieldName:"__RequestVerificationToken",headerName:"RequestVerificationToken",requestToken:"fixture-request-token"}' > "$output"
  printf 200; exit 0
fi
if [[ "$url" == */metrics ]]; then
  [[ -n "$output" ]] || exit 0
  printf '# TYPE camera_agent_capture_control_cycles_total counter\ncamera_agent_capture_control_cycles_total{outcome="completed"} 1\n' > "$output"
  printf '# TYPE hvo_fleet_edge_reports_total counter\nhvo_fleet_edge_reports_total{outcome="acknowledged"} 1\n' >> "$output"
  printf 200; exit 0
fi
if [[ "$url" == */.well-known/openid-configuration ]]; then
  authority="${url%/.well-known/openid-configuration}"
  issuer="$authority/"
  [[ "${FAKE_OIDC_ISSUER_MISMATCH:-false}" != true ]] || issuer="https://wrong.example.test/"
  token="$authority/connect/token"
  [[ "${FAKE_OIDC_TOKEN_MISMATCH:-false}" != true ]] || token="https://wrong.example.test/connect/token"
  if [[ "${FAKE_OIDC_MALFORMED:-false}" == true ]]; then discovery='not-json'
  elif [[ "${FAKE_OIDC_OVERSIZED:-false}" == true ]]; then printf -v discovery '%*s' 65537 ''
  else discovery="$(jq -cn --arg issuer "$issuer" --arg token "$token" '{issuer:$issuer,token_endpoint:$token}')"; fi
  if [[ -n "$output" ]]; then printf '%s\n' "$discovery" > "$output"; else printf '%s\n' "$discovery"; fi
  printf '%s' "${FAKE_OIDC_STATUS:-200}"
  [[ "${FAKE_OIDC_OVERSIZED:-false}" != true ]] || exit 63
  exit 0
fi
