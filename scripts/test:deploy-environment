    observatoryId:"11111111-1111-1111-1111-111111111111",friendlyName:"Camera",issuedAtUtc:"2026-08-07T00:00:00Z",
    expiresAtUtc:"2026-08-08T00:00:00Z",alreadyProvisioned:false}' > "$output"
  printf 200; exit 0
