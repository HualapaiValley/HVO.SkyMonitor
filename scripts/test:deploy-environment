FAKE_ARTIFACT_BYTES="$(printf 'fixture-artifact-content' | wc -c)"
FAKE_RAW_ARTIFACT_SHA="$(printf 'R%.0s' {1..6144} | sha256sum | cut -d' ' -f1)"
FAKE_RIG_HASH="$(printf 'A%.0s' {1..64})"
export FAKE_ARTIFACT_SHA FAKE_ARTIFACT_BYTES FAKE_RAW_ARTIFACT_SHA FAKE_RIG_HASH
if shard_enabled preflight; then . "$REPO_ROOT/scripts/deploy-contracts/preflight-1.sh"; fi

# shellcheck disable=SC2016 # The literal shell syntax verifies secrets are never evaluated.
printf 'SQL_PASSWORD=fixture-secret-never-print\nOWNER_API_KEY=owner-api-key-never-print\nEAST_PASSWORD=east-owner-never-print\nWEST_PASSWORD=west-owner-never-print\nOAUTH_SECRET=malicious-$(touch /tmp/must-not-run)-never-print\n' > "$SECRET_FILE"
chmod 600 "$SECRET_FILE"

write_inventory() {
    jq '.agentId="east-agent"' "$REPO_ROOT/src/HVO.SkyMonitor.CameraAgent/cameraagent.sample.json" > "$TEMP_DIR/east-module.json"
    jq '.agentId="west-agent"' "$REPO_ROOT/src/HVO.SkyMonitor.CameraAgent/cameraagent.sample.json" > "$TEMP_DIR/west-module.json"
    jq -n --arg revision "$REVISION" --arg secret "$SECRET_FILE" --arg root "$TEMP_DIR/remote" --arg owner "$(id -un)" \
      --arg eastModule "$TEMP_DIR/east-module.json" --arg westModule "$TEMP_DIR/west-module.json" \
      --argjson logicPort "$HTTP_PORT" --argjson eastPort "$EAST_PORT" --argjson westPort "$WEST_PORT" '{
      schemaVersion:8, environment:"test-observatory", installationId:"test-installation",productRoot:($root+"/skymonitor"),
      source:{revision:$revision,dirtyDisposition:"allow-dirty"},
      secretSource:{path:$secret,requiredReferences:["SQL_PASSWORD","OWNER_API_KEY","EAST_PASSWORD","WEST_PASSWORD","OAUTH_SECRET"]},
      observatory:{name:"Test Observatory",latitudeDegrees:19.5,longitudeDegrees:-155.5,elevationMeters:1000,timeZoneId:"Pacific/Honolulu"},
      logicHost:{name:"logic",friendlyName:"Test LogicHost",instanceId:"11111111-1111-4111-8111-111111111111",applicationIdentity:"test-logic",catalogId:"test-production",cookieName:"hvo.skymonitor.11111111111141118111111111111111",sshHost:"logic@example",dockerContext:"logic-context",expectedArchitecture:"amd64",expectedHostName:"logic-node",
        expectedHostIdentity:"logic-machine",expectedDockerDaemonIdentity:"logic-daemon",runtimeRoot:($root+"/skymonitor/logichosts/11111111-1111-4111-8111-111111111111"),runtimeOwner:$owner,
        internalEndpoint:("http://127.0.0.1:"+($logicPort|tostring)),publicEndpoint:("https://public.example.test:"+($logicPort|tostring)),trustedProxyAddresses:[],ports:[$logicPort]},
      cameraAgents:[
        {name:"east",friendlyName:"East Camera",instanceId:"22222222-2222-4222-8222-222222222222",applicationIdentity:"east-agent",catalogId:"test-production",cookieName:"hvo.skymonitor.22222222222242228222222222222222",ownerEmail:"east-owner@cameraagent.local",sshHost:"east@example",dockerContext:"east-context",expectedArchitecture:"arm64",expectedHostName:"east-node",
          expectedHostIdentity:"east-machine",expectedDockerDaemonIdentity:"east-daemon",runtimeRoot:($root+"/skymonitor/cameraagents/22222222-2222-4222-8222-222222222222"),runtimeOwner:$owner,
          internalEndpoint:("http://127.0.0.1:"+($eastPort|tostring)),publicEndpoint:("http://127.0.0.1:"+($eastPort|tostring)),trustedProxyAddresses:[],ports:[$eastPort],moduleConfigPath:$eastModule,ownerPasswordSecretReference:"EAST_PASSWORD"},
        {name:"west",friendlyName:"West Camera",instanceId:"33333333-3333-4333-8333-333333333333",applicationIdentity:"west-agent",catalogId:"test-production",cookieName:"hvo.skymonitor.33333333333343338333333333333333",ownerEmail:"west-owner@cameraagent.local",sshHost:"west@example",dockerContext:"west-context",expectedArchitecture:"amd64",expectedHostName:"west-node",
          expectedHostIdentity:"west-machine",expectedDockerDaemonIdentity:"west-daemon",runtimeRoot:($root+"/skymonitor/cameraagents/33333333-3333-4333-8333-333333333333"),runtimeOwner:$owner,
          internalEndpoint:("http://127.0.0.1:"+($westPort|tostring)),publicEndpoint:("http://127.0.0.1:"+($westPort|tostring)),trustedProxyAddresses:[],ports:[$westPort],moduleConfigPath:$westModule,ownerPasswordSecretReference:"WEST_PASSWORD"}],
      sharedServices:null,
      serviceEndpoints:[{name:"test-service",host:"127.0.0.1",port:$logicPort,fromTargets:["logic","east","west"]}],
      catalogs:[{catalogId:"test-production",displayName:"Test production catalog",kind:"production",version:"catalog-v1",schemaVersion:"2",preprocessingVersion:"3",sha256:("0"*64),length:1,rowCount:1,bundlePath:($root+"/catalog-bundle"),installRoot:($root+"/skymonitor/catalogs/test-production"),allowFixture:false}],
      images:{distributionMode:"registry",artifactRoot:null,tag:("rev-"+$revision),registryImmutableTags:true,
        builder:{name:"control-builder",driver:"docker",endpoint:"default",expectedDaemonIdentity:"control-daemon",expectedDaemonName:"control-node",expectedArchitecture:"amd64"},
        logicHost:{repository:"registry.example/logichost"},cameraAgent:{repository:"registry.example/cameraagent"}},
      deployment:{
        services:{mode:"existing",
          sql:{host:"127.0.0.1",port:1433,database:"hvo-test",adminUser:"sa",adminSecretReference:"SQL_PASSWORD",initializerUser:"hvo-init",initializerSecretReference:"SQL_PASSWORD",initializerConnectionReference:"SQL_PASSWORD",runtimeUser:"hvo-runtime",runtimeSecretReference:"SQL_PASSWORD",runtimeConnectionReference:"SQL_PASSWORD"},
          redis:{host:"127.0.0.1",port:6379,prefix:"hvo-test:",adminSecretReference:"SQL_PASSWORD",user:"hvo-runtime",secretReference:"SQL_PASSWORD"},
          objectStore:{root:"/var/lib/hvo/object-store",uid:4242,gid:4343,filesystemUuid:"fa678c86-1c12-4eba-8f04-c84256772089",minimumFreeBytes:10737418240,minimumFreeInodes:1048576,artifactBucket:"hvo-test-artifacts",diagnosticsBucket:"hvo-test-diagnostics"},
          smtp:{kind:"production",host:"127.0.0.1",ports:[2525,null],usernameReference:null,passwordReference:null},
          images:{sqlServer:null,redis:null,mailpit:null}},
        resources:{project:"hvo-test",sqlDatabase:"hvo-test",redisPrefix:"hvo-test:",artifactBucket:"hvo-test-artifacts",diagnosticsBucket:"hvo-test-diagnostics"},
        certificates:{signingPath:($root+"/signing.pfx"),encryptionPath:($root+"/encryption.pfx"),signingPasswordReference:null,encryptionPasswordReference:null},
        automation:{ownerApiKeySecretReference:"OWNER_API_KEY"},
        deviceBootstrap:{clientId:"system-camera-agent",clientSecretReference:"SQL_PASSWORD",scopes:["api.camera"]},
        transient:{mode:"Off"},
        workload:{kind:"W0",durationSeconds:120,sustainedArmOptIn:true},
        secretMappings:[{reference:"SQL_PASSWORD",key:"ConnectionStrings__skymonitordb"},{reference:"SQL_PASSWORD",key:"ConnectionStrings__skymonitordb-migrations"}],
          limits:{cpus:null,memory:null,sqlMemory:null,sqlMemoryLimitMb:null}}
    }' > "$INVENTORY"
