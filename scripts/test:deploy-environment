export FAKE_REMOTE_BIN_NO_TIMEOUT="$REMOTE_BIN_NO_TIMEOUT"
export FAKE_HTTP_STATE="$TEMP_DIR/http-state"
export FAKE_REMOTE_UID_MAP="$TEMP_DIR/remote-uid-map"
export FAKE_REMOTE_MOUNT_MAP="$TEMP_DIR/remote-mount-map"
