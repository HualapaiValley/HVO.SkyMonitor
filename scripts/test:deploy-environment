if [[ "$url" == */api/v1/operations/summary* ]]; then
  host="${FAKE_REMOTE_HOST:?}"; device="device-$host"; down_tail_mode="${FAKE_DOWN_TAIL_MODE:-off}"
  final_observation=false; [[ "$url" != *downObservation=*-final-* ]] || final_observation=true
  summary_reads_file="$FAKE_HTTP_STATE/$host.summary-reads"; summary_reads=0
  [[ ! -f "$summary_reads_file" ]] || summary_reads="$(<"$summary_reads_file")"
  summary_reads=$((summary_reads+1)); printf '%s\n' "$summary_reads" > "$summary_reads_file"
  printf -v captured_utc '2026-08-07T00:%02d:%02dZ' "$((10 + summary_reads / 60))" "$((summary_reads % 60))"
  case "$down_tail_mode" in
    equal-captured) captured_utc=2026-08-07T00:10:01Z ;;
    decreasing-captured) [[ "$summary_reads" == 1 ]] && captured_utc=2026-08-07T00:10:02Z || captured_utc=2026-08-07T00:10:01Z ;;
    pre-pause-captured) captured_utc=2026-08-06T23:59:59Z ;;
  esac
  if [[ "$final_observation" == true && "${FAKE_DOWN_FINAL_OBSERVATION:-}" == time ]]; then captured_utc=2026-08-07T00:10:02Z; fi
  measurement_samples=1; timings='[{"segment":"Module","sampleCount":1,"medianMilliseconds":1,"p95Milliseconds":1,"maximumMilliseconds":1}]'
  [[ "${FAKE_CAPTURE_TELEMETRY_EMPTY:-false}" != true ]] || measurement_samples=0
  if [[ -f "${FAKE_HTTP_STATE:?}/$host.measurement-reset" ]]; then measurement_samples=0; timings='[]'; rm -f "$FAKE_HTTP_STATE/$host.measurement-reset"; fi
  control_state="Running"; control_version=0
  [[ ! -f "${FAKE_HTTP_STATE:?}/$host.control-state" ]] || control_state="$(<"$FAKE_HTTP_STATE/$host.control-state")"
  [[ ! -f "$FAKE_HTTP_STATE/$host.control-version" ]] || control_version="$(<"$FAKE_HTTP_STATE/$host.control-version")"
  leased=0
  if [[ "${FAKE_DOWN_LEASED_ONLY:-none}" != none && "$control_state" == Paused &&
        ( "${FAKE_DOWN_LEASED_ONLY}" != delay-west || "$host" == west ) ]]; then
    leased=1; lease_reads="$FAKE_HTTP_STATE/$host.down-lease-reads"; reads=0; [[ ! -f "$lease_reads" ]] || reads="$(<"$lease_reads")"
    reads=$((reads+1)); printf '%s\n' "$reads" > "$lease_reads"
    [[ ( "${FAKE_DOWN_LEASED_ONLY}" != delay && "${FAKE_DOWN_LEASED_ONLY}" != delay-west ) || "$reads" -lt 3 ]] || leased=0
  fi
  if [[ "${FAKE_DOWN_SAFE_THEN_UNSAFE:-false}" == true && "$control_state" == Paused ]]; then
    unsafe_reads="$FAKE_HTTP_STATE/$host.down-unsafe-reads"; reads=0; [[ ! -f "$unsafe_reads" ]] || reads="$(<"$unsafe_reads")"
    reads=$((reads+1)); printf '%s\n' "$reads" > "$unsafe_reads"
    (( reads < 2 )) || leased=1
  fi
  processing_availability=Healthy; processing_terminal=0
  [[ "${FAKE_BOOTSTRAP_OPERATIONS_UNHEALTHY:-}" != "$host" ]] || { processing_availability=Unhealthy; processing_terminal=1; }
  end_sequence=0; [[ ! -f "$FAKE_HTTP_STATE/$host.count" ]] || end_sequence="$(<"$FAKE_HTTP_STATE/$host.count")"
  [[ "${FAKE_DOWN_CONTINUITY_MODE:-}" != one ]] || end_sequence=1
  [[ "${FAKE_DOWN_CONTINUITY_MODE:-}" != two ]] || end_sequence=2
  runtime_mode=Off; [[ "$down_tail_mode" == off || "$down_tail_mode" == changing-then-stable ]] || runtime_mode=Hybrid
  jq -cn --arg device "$device" --argjson samples "$measurement_samples" --argjson timings "$timings" --arg controlState "$control_state" --argjson controlVersion "$control_version" --argjson leased "$leased" \
    --arg processingAvailability "$processing_availability" --argjson processingTerminal "$processing_terminal" --arg tailMode "$down_tail_mode" --argjson endSequence "$end_sequence" \
    --arg capturedUtc "$captured_utc" --argjson summaryRead "$summary_reads" \
    --arg controlFreshness "${FAKE_DOWN_CONTROL_FRESHNESS:-fresh}" --arg workerFreshness "${FAKE_DOWN_WORKER_FRESHNESS:-fresh}" \
    --arg transientMode "${FAKE_DOWN_SUMMARY_MODE:-$runtime_mode}" --arg prePauseSections "${FAKE_DOWN_PRE_PAUSE_SECTIONS:-}" \
    --argjson finalObservation "$final_observation" --arg finalMutation "${FAKE_DOWN_FINAL_OBSERVATION:-}" '
    def queue:{pendingCount:0,pendingBytes:0,leasedCount:$leased,retryCount:0,quarantineCount:0,terminalCount:0,oldestPendingUtc:null};
    def section($value):{source:"fixture",observedUtc:$capturedUtc,freshness:"fresh",value:$value};
    (if $endSequence < 2 then $endSequence else 2 end) as $tail |
    [range($endSequence-$tail+1;$endSequence+1) | {agentId:$device,captureSequence:.}] as $identities |
    ($tail * (1 + 32)) as $maximumTransient | ($tail * 3) as $maximumRaw |
    ($tailMode != "off" and $tailMode != "changing-then-stable") as $hybrid |
    (if $tailMode == "third" then [{agentId:$device,captureSequence:($endSequence-2)}] + $identities
     elif $tailMode == "stale" then [$identities[] | .captureSequence -= 1]
     elif $tailMode == "wrong" then [$identities[] | .agentId = "wrong-device"] else $identities end) as $pendingCaptures |
    (if ($hybrid | not) then 0 elif $tailMode == "excess" then $maximumTransient + 1 elif $tailMode == "fractional" then 2.5 else $tail end) as $transientPending |
    (if ($hybrid | not) then 0 elif $tailMode == "excess-raw" then $maximumRaw + 1 elif $tailMode == "fractional-raw" then 1.5
      elif $tailMode == "changing" and ($summaryRead % 2) == 0 then $tail + 1 else $tail end) as $rawPending |
    (if $hybrid then [{name:"transient",required:true,pendingCount:$transientPending,pendingBytes:0,leasedCount:0,
      retryCount:(if $tailMode == "retry" then 1 else 0 end),quarantineCount:(if $tailMode == "quarantine" then 1 else 0 end),
      pressureLevel:(if $tailMode == "pressure" then 2 else 0 end),oldestPendingUtc:null,pendingCaptures:$pendingCaptures}] else [] end) as $transientLanes |
    (if $tailMode == "unrelated" then 1 else 0 end) as $standardPending | ($transientPending + $standardPending) as $lanePending |
    {capturedUtc:$capturedUtc,
     configuration:{source:"validated-configuration",observedUtc:null,freshness:"unknown",value:{isCurrent:true,validationStatus:"validated",agentId:$device,moduleType:"VirtualSky",centralIntegration:"Enabled",transientDetection:$transientMode}},
     captureControl:section({state:$controlState,version:$controlVersion,isInitialized:true}),
     captureTelemetry:{value:{sampleCount:$samples,latestCaptureStartedUtc:(if $samples == 0 then null else "2026-08-07T00:00:01Z" end),latestMode:(if $samples == 0 then null else "Light" end),latestExposureMilliseconds:(if $samples == 0 then null else 1 end),
       latestGain:10,averageIntervalMilliseconds:1,averageExposureMilliseconds:1,averageProcessingMilliseconds:1,averageLoopMilliseconds:1,
       capturesPerMinute:1,dutyCycle:0.5,framesStored:1,immediateUploadCount:1}},
     captureRuntime:{value:{timings:$timings}},
     rawIngress:section(queue + {availability:"Accepting",pendingCount:$rawPending}),
     captureLanes:section({availability:"Healthy",lanes:([{name:"standard",required:true,pendingCount:$standardPending,pendingBytes:0,
       leasedCount:$leased,retryCount:0,quarantineCount:0,pressureLevel:0,oldestPendingUtc:null,pendingCaptures:(if $standardPending == 0 then [] else [{agentId:$device,captureSequence:$endSequence}] end)}] + $transientLanes),pendingCount:$lanePending,pendingBytes:0,leasedCount:$leased,retryCount:(if $tailMode == "retry" then 1 else 0 end),quarantineCount:(if $tailMode == "quarantine" then 1 else 0 end),oldestPendingUtc:null}),
     captureProcessing:section(queue + {availability:$processingAvailability,terminalCount:(if $tailMode == "terminal" then 1 else $processingTerminal end)}),
     artifactOutbox:section(queue + {availability:"Healthy"}),
     transientWorker:section({availability:(if $hybrid then (if $tailMode == "unhealthy" then "Unavailable" else "Healthy" end) else "Disabled" end),pendingFrames:(if $tailMode == "busy" then 1 else 0 end),pendingCandidates:0,maximumCandidates:32}),
     heartbeat:{value:{lastAcknowledgedUtc:"2026-08-07T00:01:00Z"}}} |
     .captureControl.freshness=$controlFreshness |
     .captureControl.observedUtc=(if $controlFreshness == "stale" then "2026-08-01T00:00:00Z" else $capturedUtc end) |
     .transientWorker.freshness=$workerFreshness |
     .transientWorker.observedUtc=(if $workerFreshness == "stale" then "2026-08-01T00:00:00Z" else $capturedUtc end) |
     .configuration.value.centralIntegration=(if $tailMode == "changing-then-stable" and $summaryRead >= 2 then "EnabledStable" else "Enabled" end) |
     if $prePauseSections == "raw-lane" then .rawIngress.observedUtc="2026-08-06T23:59:59Z" | .captureLanes.observedUtc="2026-08-06T23:59:59Z"
     elif $prePauseSections == "async" then .captureProcessing.observedUtc="2026-08-06T23:59:59Z" | .artifactOutbox.observedUtc="2026-08-06T23:59:59Z"
     else . end |
     if $finalObservation and $finalMutation == "unsafe" then .rawIngress.value.leasedCount=1
     elif $finalObservation and $finalMutation == "fingerprint" then .configuration.value.centralIntegration="FinalChanged"
     else . end |
     if $tailMode == "stale-section" then .captureLanes.freshness="stale"
     elif $tailMode == "stale-hybrid-worker" then .transientWorker.freshness="stale"
     elif $tailMode == "config-mismatch" then .configuration.value.agentId="wrong-device"
     elif $tailMode == "config-not-current" then .configuration.value.isCurrent=false
     elif $tailMode == "config-mode-missing" then del(.configuration.value.transientDetection)
     elif $tailMode == "malformed" then .captureLanes.value.lanes={unexpected:true}
     else . end' > "$output"
  printf 200; exit 0
fi
if [[ "$url" == */api/v1/operations/capture/pause || "$url" == */api/v1/operations/capture/resume ]]; then
  header_path=; for ((i=0; i<${#args[@]}; i++)); do [[ "${args[$i]}" != --header || "${args[$((i+1))]}" != @* ]] || header_path="${args[$((i+1))]#@}"; done
  key=; while IFS= read -r header_line; do [[ "$header_line" != 'Idempotency-Key: '* ]] || key="${header_line#Idempotency-Key: }"; done < "$header_path"
  id_count="$(grep -c '^Idempotency-Key:' "$header_path")"; token_count="$(grep -c '^RequestVerificationToken:' "$header_path")"
  [[ "$id_count" == 1 && "$token_count" == 1 && "$key" =~ ^deploy-(bootstrap-[a-z0-9-]+-[a-z0-9-]+-resume-[0-9]+|down-[a-z0-9-]+-[a-z0-9-]+-(pause|final-pause)-[0-9]+|measure-[a-z0-9-]+-[a-z0-9-]+-[a-z0-9-]+-[0-9]+|smoke-[a-z0-9-]+-[a-z0-9-]+-(resume|initial-pause|final-pause|failure-pause)-[0-9]+)$ ]] || { : > "$output"; printf 400; exit 0; }
  action="${url##*/}"; desired=Running; [[ "$action" != pause ]] || desired=Paused
  if [[ "$action" == pause && ( "${FAKE_PAUSE_CONFLICT:-false}" == true ||
        ( "$key" == *-failure-pause-* && "${FAKE_SMOKE_FAILURE_PAUSE_CONFLICT:-false}" == true ) ) ]]; then
    : > "$output"; printf 409; exit 0
  fi
  host="${FAKE_REMOTE_HOST:?}"
  if [[ ( "$key" == *-failure-pause-* || "$key" == *-restoration-pause-* ) && "${FAKE_MEASURE_FAILURE_PAUSE_FAIL:-}" == "$host" ]]; then : > "$output"; printf 503; exit 0; fi
  receipt="$FAKE_HTTP_STATE/$host.idempotency.$(printf '%s' "$key" | sha256sum | cut -c1-32).json"
  if [[ -f "$receipt" ]]; then
    jq '.replayed=true' "$receipt" > "$output"
    printf 'control\t%s\t%s\t%s\t%s\ttrue\n' "$header_path" "$key" "$token_count" "$id_count" >> "${FAKE_LOG:?}"
    printf 200; exit 0
  fi
  current=Running; version=0
  [[ ! -f "$FAKE_HTTP_STATE/$host.control-state" ]] || current="$(<"$FAKE_HTTP_STATE/$host.control-state")"
  [[ ! -f "$FAKE_HTTP_STATE/$host.control-version" ]] || version="$(<"$FAKE_HTTP_STATE/$host.control-version")"
  if jq -e 'has("expectedVersion")' "$body" >/dev/null; then
    expected_version="$(jq -er '.expectedVersion | numbers | select(. >= 0 and floor == .)' "$body")" || { : > "$output"; printf 400; exit 0; }
    [[ "$expected_version" == "$version" ]] || { : > "$output"; printf 409; exit 0; }
  fi
  if [[ "$key" == *-final-pause-* && "${FAKE_DOWN_FINAL_REASSERT_RACE:-false}" == true ]]; then
    current=Running; version=$((version+1)); printf '%s\n' "$current" > "$FAKE_HTTP_STATE/$host.control-state"; printf '%s\n' "$version" > "$FAKE_HTTP_STATE/$host.control-version"
  fi
  changed=false
  if [[ "$current" != "$desired" ]]; then changed=true; version=$((version+1)); printf '%s\n' "$desired" > "$FAKE_HTTP_STATE/$host.control-state"; printf '%s\n' "$version" > "$FAKE_HTTP_STATE/$host.control-version"; fi
  if [[ "$desired" == Running ]]; then
    stage=measured; [[ "$key" != *-warmup-resume-* ]] || stage=warmup
    printf '%s\n' "$stage" > "$FAKE_HTTP_STATE/$host.measure-stage"; : > "$FAKE_HTTP_STATE/$host.measure-running"
    [[ "$key" != *deploy-smoke-*-resume-* ]] || : > "$FAKE_HTTP_STATE/$host.smoke-resumed"
  else
    rm -f "$FAKE_HTTP_STATE/$host.measure-running"
    [[ "$key" != *deploy-smoke-*-final-pause-* && "$key" != *deploy-smoke-*-failure-pause-* ]] || rm -f "$FAKE_HTTP_STATE/$host.smoke-resumed"
    if [[ "$changed" == true && "${FAKE_MEASURE_EXTRA_CAPTURE:-false}" == true && -f "$FAKE_HTTP_STATE/$host.measure-profile" ]]; then
      count_file="$FAKE_HTTP_STATE/$host.count"; printf '%s\n' "$(( $(<"$count_file") + 1 ))" > "$count_file"
    fi
  fi
  state_value=1; [[ "$desired" != Paused ]] || state_value=3
  jq -cn --argjson state "$state_value" --argjson version "$version" --argjson changed "$changed" \
    '{state:$state,version:$version,changed:$changed,replayed:false,requestedUtc:"2026-08-07T00:00:00Z",completedUtc:"2026-08-07T00:00:00Z"}' > "$receipt"
  cp "$receipt" "$output"
  [[ "${FAKE_DOWN_INVALID_PAUSE_RECEIPT:-false}" != true || "$desired" != Paused ]] || jq '.version="invalid"' "$receipt" > "$output"
  printf 'control\t%s\t%s\t%s\t%s\tfalse\n' "$header_path" "$key" "$token_count" "$id_count" >> "${FAKE_LOG:?}"
  printf 200; exit 0
fi
if [[ "$url" == */api/v1/operations/schedule/ ]]; then
  host="${FAKE_REMOTE_HOST:?}"; active="$FAKE_HTTP_STATE/$host.schedule-active.json"
  printf 'schedule-read\t%s\n' "$host" >> "${FAKE_LOG:?}"
  pending=null; pending_sha=; raw_pending=null
  file_profile_sha="$(schedule_profile_sha "$(jq -c . "$FAKE_HTTP_STATE/$host.active-profile.json")")"
  [[ "${FAKE_SMOKE_SCHEDULE_STALE_DRAFT:-}" != "$host" ]] || file_profile_sha="$(printf stale-file-profile | sha256sum | cut -d' ' -f1)"
  if [[ -f "$FAKE_HTTP_STATE/$host.schedule-pending.json" ]]; then
    raw_pending="$(jq -c . "$FAKE_HTTP_STATE/$host.schedule-pending.json")"
    pending="$(operator_schedule_profile "$raw_pending")"; pending_sha="$(schedule_profile_sha "$raw_pending")"
  fi
  pending_id=schedule-pending-v2; pending_number=2; pending_source=file-draft
  [[ ! -f "$FAKE_HTTP_STATE/$host.schedule-pending-revision" ]] || pending_id="$(<"$FAKE_HTTP_STATE/$host.schedule-pending-revision")"
  pending_number="${pending_id##*-v}"
  if [[ "$pending" != null && ! -f "$FAKE_HTTP_STATE/$host.schedule-w0-draft" && "$(jq -r '.rig.sensor.widthPixels' <<< "$pending")" != 1936 && "$(jq -r '.rig.sensor.widthPixels' <<< "$pending")" != 3096 ]]; then pending_id=schedule-active-v1; pending_number=1; pending_source=file-bootstrap; fi
  [[ "${FAKE_SMOKE_SCHEDULE_REVISION_DRIFT:-}" != "$host" ]] || pending_id=schedule-drift-v9
  active_version=1; [[ ! -f "$FAKE_HTTP_STATE/$host.schedule-state-version" ]] || active_version="$(<"$FAKE_HTTP_STATE/$host.schedule-state-version")"
  if [[ -f "$active" ]]; then raw_profile="$(jq -c . "$active")"; profile="$(operator_schedule_profile "$raw_profile")"; profile_sha="$(schedule_profile_sha "$raw_profile")"; active_id=schedule-active-v1; [[ ! -f "$FAKE_HTTP_STATE/$host.schedule-active-revision" ]] || active_id="$(<"$FAKE_HTTP_STATE/$host.schedule-active-revision")"; active_number="${active_id##*-v}"; jq -cn --argjson profile "$profile" --arg profileSha "$profile_sha" --arg fileProfileSha "$file_profile_sha" --arg activeId "$active_id" --argjson activeNumber "$active_number" --argjson pending "$pending" --arg pendingSha "$pending_sha" --arg pendingId "$pending_id" --argjson pendingNumber "$pending_number" --arg pendingSource "$pending_source" --argjson version "$active_version" '{stateVersion:$version,fileConfigurationProfileSha256:$fileProfileSha,activeRevision:{revisionId:$activeId,revisionNumber:$activeNumber,profile:$profile,profileSha256:$profileSha},pendingRevision:(if $pending == null then null else {revisionId:$pendingId,revisionNumber:$pendingNumber,source:$pendingSource,profile:$pending,profileSha256:$pendingSha} end)}' > "$output"
  else raw_profile='{"schemaVersion":"cameraagent-local-profile-v1","module":{"type":"VirtualSky","options":{}},"rig":{"sensor":{"widthPixels":64}},"processingSteps":[],"schedule":{}}'; profile="$(operator_schedule_profile "$raw_profile")"; profile_sha="$(schedule_profile_sha "$raw_profile")"; jq -cn --argjson profile "$profile" --arg profileSha "$profile_sha" --arg fileProfileSha "$file_profile_sha" --argjson pending "$pending" --arg pendingSha "$pending_sha" --arg pendingId "$pending_id" --argjson pendingNumber "$pending_number" --arg pendingSource "$pending_source" --argjson version "$active_version" '{stateVersion:$version,fileConfigurationProfileSha256:$fileProfileSha,activeRevision:{revisionId:"schedule-active-v1",revisionNumber:1,profile:$profile,profileSha256:$profileSha},pendingRevision:(if $pending == null then null else {revisionId:$pendingId,revisionNumber:$pendingNumber,source:$pendingSource,profile:$pending,profileSha256:$pendingSha} end)}' > "$output"; fi
  printf 200; exit 0
fi
if [[ "$url" == */api/v1/operations/schedule/activate ]]; then
  host="${FAKE_REMOTE_HOST:?}"; test -f "$FAKE_HTTP_STATE/$host.schedule-pending.json"
  printf 'schedule-activate\t%s\n' "$host" >> "${FAKE_LOG:?}"
  [[ "${FAKE_SMOKE_SCHEDULE_VERSION_DRIFT:-}" != "$host" ]] || { : > "$output"; printf 409; exit 0; }
  pending_revision="$(<"$FAKE_HTTP_STATE/$host.schedule-pending-revision")"; state_version="$(<"$FAKE_HTTP_STATE/$host.schedule-state-version")"
  jq -e --arg revision "$pending_revision" --argjson version "$state_version" '.revisionId == $revision and .expectedVersion == $version' "$body" >/dev/null || { : > "$output"; printf 409; exit 0; }
  if [[ "${FAKE_SMOKE_SCHEDULE_STALE_ACTIVE:-}" == "$host" ]]; then
    rm -f "$FAKE_HTTP_STATE/$host.schedule-pending.json" "$FAKE_HTTP_STATE/$host.schedule-w0-draft"
    jq -cn --arg sha "$(printf stale | sha256sum | cut -d' ' -f1)" '{version:3,activeRevision:{revisionId:"schedule-pending-v2",revisionNumber:2,profileSha256:$sha,profile:{schemaVersion:"cameraagent-local-profile-v1",module:{type:"VirtualSky",options:null},rig:{sensor:{widthPixels:484}},processingSteps:[],schedule:{}}},pendingRevision:null}' > "$output"
    printf 200; exit 0
  fi
  if [[ -f "$FAKE_HTTP_STATE/$host.schedule-active.json" ]]; then
    cp "$FAKE_HTTP_STATE/$host.schedule-active.json" "$FAKE_HTTP_STATE/$host.schedule-prior.json"
    cp "$FAKE_HTTP_STATE/$host.schedule-active-revision" "$FAKE_HTTP_STATE/$host.schedule-prior-revision"
  else
    printf '%s\n' '{"schemaVersion":"cameraagent-local-profile-v1","module":{"type":"VirtualSky","options":{}},"rig":{"sensor":{"widthPixels":64}},"processingSteps":[],"schedule":{}}' > "$FAKE_HTTP_STATE/$host.schedule-prior.json"
    printf 'schedule-active-v1\n' > "$FAKE_HTTP_STATE/$host.schedule-prior-revision"
  fi
  mv "$FAKE_HTTP_STATE/$host.schedule-pending.json" "$FAKE_HTTP_STATE/$host.schedule-active.json"
  printf '%s\n' "$pending_revision" > "$FAKE_HTTP_STATE/$host.schedule-active-revision"
  state_version=$((state_version + 1)); printf '%s\n' "$state_version" > "$FAKE_HTTP_STATE/$host.schedule-state-version"
  rm -f "$FAKE_HTTP_STATE/$host.schedule-pending-revision" "$FAKE_HTTP_STATE/$host.schedule-w0-draft"
  raw_profile="$(jq -c . "$FAKE_HTTP_STATE/$host.schedule-active.json")"; profile="$(operator_schedule_profile "$raw_profile")"; profile_sha="$(schedule_profile_sha "$raw_profile")"
  jq -cn --argjson profile "$profile" --arg profileSha "$profile_sha" --arg revision "$pending_revision" --argjson version "$state_version" '{version:$version,activeRevision:{revisionId:$revision,revisionNumber:($revision | split("-v")[-1] | tonumber),profile:$profile,profileSha256:$profileSha},pendingRevision:null}' > "$output"
  printf 200; exit 0
fi
if [[ "$url" == */api/v1/operations/schedule/rollback ]]; then
  host="${FAKE_REMOTE_HOST:?}"
  state_version="$(<"$FAKE_HTTP_STATE/$host.schedule-state-version")"; requested_revision="$(jq -er '.revisionId' "$body")"
  jq -e --argjson version "$state_version" '.expectedVersion == $version and (.reason | type == "string" and length > 0)' "$body" >/dev/null || { : > "$output"; printf 400; exit 0; }
  [[ "${FAKE_MEASURE_ROLLBACK_CONFLICT:-false}" != true ]] || { : > "$output"; printf 409; exit 0; }
  if [[ -f "$FAKE_HTTP_STATE/$host.schedule-prior-revision" && "$(<"$FAKE_HTTP_STATE/$host.schedule-prior-revision")" == "$requested_revision" ]]; then
    cp "$FAKE_HTTP_STATE/$host.schedule-prior.json" "$FAKE_HTTP_STATE/$host.schedule-active.json"
  elif [[ "$requested_revision" == schedule-active-v1 ]]; then
    rm -f "$FAKE_HTTP_STATE/$host.schedule-active.json"
  else : > "$output"; printf 404; exit 0; fi
  printf '%s\n' "$requested_revision" > "$FAKE_HTTP_STATE/$host.schedule-active-revision"
  rm -f "$FAKE_HTTP_STATE/$host.schedule-pending.json" "$FAKE_HTTP_STATE/$host.schedule-pending-revision" "$FAKE_HTTP_STATE/$host.schedule-w0-draft"
  state_version=$((state_version + 1)); printf '%s\n' "$state_version" > "$FAKE_HTTP_STATE/$host.schedule-state-version"
  if [[ -f "$FAKE_HTTP_STATE/$host.schedule-active.json" ]]; then raw_profile="$(jq -c . "$FAKE_HTTP_STATE/$host.schedule-active.json")"; else raw_profile='{"schemaVersion":"cameraagent-local-profile-v1","module":{"type":"VirtualSky","options":{}},"rig":{"sensor":{"widthPixels":64}},"processingSteps":[],"schedule":{}}'; fi
  profile="$(operator_schedule_profile "$raw_profile")"; profile_sha="$(schedule_profile_sha "$raw_profile")"
  jq -cn --argjson profile "$profile" --arg profileSha "$profile_sha" --arg revision "$requested_revision" --argjson version "$state_version" '{version:$version,activeRevision:{revisionId:$revision,revisionNumber:($revision | split("-v")[-1] | tonumber),profile:$profile,profileSha256:$profileSha},pendingRevision:null}' > "$output"
  printf 200; exit 0
fi
if [[ "$url" == */api/v1.0/devices/*/artifacts/*/download-authorizations ]]; then
  [[ "$method" == POST && "$body" == '{"range":null}' && -n "$cookie_jar" ]] || { : > "$output"; printf 400; exit 0; }
  printf 'artifact-download-authorized\n' >> "$cookie_jar"
  jq -cn '{authorizationId:"88888888-8888-8888-8888-888888888888",expiresAtUtc:"2026-08-07T00:05:00Z",contentUri:"/content"}' > "$output"
  printf 200; exit 0
