  jq -cn --arg device "$device" --argjson provisioned "$provisioned" \
    --arg public "33333333-3333-3333-3333-333333333333" \
    '{deviceId:$device,verificationCode:"VERIFY1234",createdUtc:"2026-08-07T00:00:00Z",configuredAgentId:null,
      isProvisioned:$provisioned,devicePublicId:(if $provisioned then $public else null end),
      observatoryId:(if $provisioned then "11111111-1111-1111-1111-111111111111" else null end)}' > "$output"
  printf 200; exit 0
fi
