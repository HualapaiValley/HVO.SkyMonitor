if [[ "$url" == */api/internal/deployment/bootstrap ]]; then
  host="${FAKE_REMOTE_HOST:?}"; count="$(<"${FAKE_HTTP_STATE:?}/envelope-count")"; grep -Fq "fixture-envelope-$count-never-print" "$body"
