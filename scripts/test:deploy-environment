      --mount) [[ "$saw_mount" == false ]]; saw_mount=true; expected_mount=$2; shift 2 ;;
      --entrypoint) [[ "$2" == /bin/sh ]]; saw_entrypoint=true; shift 2 ;;
      *) image=$1; shift; [[ "${1:-}" == -s && "${2:-}" == -- ]]; shift 2; runtime_uid=$1; marker_digest=$2; shift 2; break ;;
    esac
  done
  [[ "$saw_pull" == true && "$saw_rm" == true && "$saw_interactive" == true && "$saw_network" == true &&
     "$saw_readonly" == true && "$saw_pids" == true && "$saw_user" == true && "$saw_drop" == true && "$saw_dac" == true &&
     "$saw_fowner" == true && "$saw_security" == true && "$saw_entrypoint" == true && "$saw_cidfile" == true && "$saw_mount" == true && $# == 0 ]] || exit 80
  if [[ "$image" =~ ^sha256:[0-9a-f]{64}$ ]]; then :
  elif [[ "$image" == *@sha256:* ]]; then
