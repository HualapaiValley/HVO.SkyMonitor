    printf '{"id":"sha256:%064d","architecture":"%s","os":"linux","repoDigests":["%s@sha256:%s"],"labels":{"org.opencontainers.image.revision":"%s","org.opencontainers.image.created":"%s","org.opencontainers.image.ref.name":"%s","io.hvoskymonitor.component":"%s","io.hvoskymonitor.dotnet-sdk":"%s","io.hvoskymonitor.source-tree":"%s"}}\n' \
      0 "$image_architecture" "${reference%@*}" "$manifest_digest" "${FAKE_REVISION:?}" "$(jq -r .created <<< "$labels")" \
      "$(jq -r .source <<< "$labels")" "$component" "$(jq -r .sdk <<< "$labels")" "$(jq -r .tree <<< "$labels")"
  fi
elif [[ "$3" == volume && "$4" == inspect ]]; then
  [[ "${FAKE_DOCKER_INSPECT_OUTAGE:-}" != "$context-volume" ]] || { printf 'authorization failed\n' >&2; exit 70; }
  volume="${*: -1}"; state="${FAKE_IMAGE_STATE:?}/volume-$context-$volume"
