    local service=$1 state="${FAKE_IMAGE_STATE:?}/service-$context-$project-$1" id
    [[ -f "$state" ]] || return 0
    id="$(sha256sum <<< "$context/$project/$service" | cut -c1-64)"
    printf '%s\n' "$id"
  }
  set_service() {
    local service=$1 running=$2 id
    id="$(sha256sum <<< "$context/$project/$service" | cut -c1-64)"
    printf '%s\n' "$running" > "${FAKE_IMAGE_STATE:?}/service-$context-$project-$service"
    printf '{"project":"%s","service":"%s","running":%s}\n' "$project" "$service" "$running" > "${FAKE_IMAGE_STATE:?}/container-$id"
  }
  remove_service() {
    local service=$1 id
    id="$(sha256sum <<< "$context/$project/$service" | cut -c1-64)"
    rm -f "${FAKE_IMAGE_STATE:?}/service-$context-$project-$service" "${FAKE_IMAGE_STATE:?}/container-$id"
  }
  if [[ "$*" == *" ps --all -q "* ]]; then
    [[ "${FAKE_COMPOSE_PS_OUTAGE:-}" != "$context" ]] || exit 70
    container_state "${*: -1}"
  elif [[ "$*" == *" ps -q cameraagent"* ]]; then
    printf 'abcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcd\n'
  elif [[ "$*" == *" logs --no-color "* ]]; then
    printf 'cameraagent | {"event":"capture-complete","runId":"%s","status":"ok"}\n' "$(/usr/bin/grep '^HVO_RUN_ID=' "$env_file" | /usr/bin/cut -d= -f2-)"
  elif [[ "$*" == *"minio-provision"* ]]; then
    config_root="$(/usr/bin/grep '^HVO_CONFIG_ROOT=' "$env_file" | /usr/bin/cut -d= -f2-)"
    /usr/bin/jq -e '.version == "10" and .aliases.local.url == "http://minio:9000" and
      .aliases.local.accessKey == "fixture-minio-root" and .aliases.local.secretKey == "fixture:/@\"minio-root-never-print"' \
      "$config_root/private/mc/config.json" >/dev/null
    /usr/bin/jq -cn --arg secret 'generated:/@"minio-secret-never-print' \
      '{accessKey:"generated-minio-access",secretKey:$secret}' > "$config_root/minio-output/minio-runtime.json"
    chmod 600 "$config_root/minio-output/minio-runtime.json"
  elif [[ "$*" == *" up -d"* ]]; then
    run_id="$(/usr/bin/grep '^HVO_RUN_ID=' "$env_file" | /usr/bin/cut -d= -f2-)"
    inventory_hash="$(/usr/bin/grep '^HVO_INVENTORY_SHA256=' "$env_file" | /usr/bin/cut -d= -f2-)"
    state_root="$(/usr/bin/grep '^HVO_STATE_ROOT=' "$env_file" | /usr/bin/cut -d= -f2-)"
    network="${project}_default"
    printf '{"name":"%s","project":"%s","network":"default","runId":"%s","inventorySha256":"%s"}\n' \
      "$network" "$project" "$run_id" "$inventory_hash" > "${FAKE_IMAGE_STATE:?}/network-$context-$network"
    if [[ "$project" == *-services ]]; then
      for service in sqlserver redis minio mailpit; do set_service "$service" true; done
      for binding in sql-data:sql redis-data:redis minio-data:minio; do
        volume="${project}_${binding%%:*}"
        printf '{"runId":"%s","inventorySha256":"%s","device":"%s/%s"}\n' \
          "$run_id" "$inventory_hash" "$state_root" "${binding#*:}" > "${FAKE_IMAGE_STATE:?}/volume-$context-$volume"
      done
    elif [[ "$project" == *-logic ]]; then set_service logichost true
    else set_service cameraagent true; fi
    printf 'v2.39.1\n'
  elif [[ "$*" == *" stop -t 60"* ]]; then
    if [[ "$project" == *-services ]]; then for service in sqlserver redis minio mailpit; do [[ ! -f "${FAKE_IMAGE_STATE:?}/service-$context-$project-$service" ]] || set_service "$service" false; done
    elif [[ "$project" == *-logic ]]; then [[ ! -f "${FAKE_IMAGE_STATE:?}/service-$context-$project-logichost" ]] || set_service logichost false
    else [[ ! -f "${FAKE_IMAGE_STATE:?}/service-$context-$project-cameraagent" ]] || set_service cameraagent false; fi
    printf 'v2.39.1\n'
  elif [[ "$*" == *" rm -f"* ]]; then
    if [[ "$project" == *-services ]]; then for service in sqlserver redis minio mailpit; do remove_service "$service"; done
    elif [[ "$project" == *-logic ]]; then remove_service logichost
    else remove_service cameraagent; fi
    printf 'v2.39.1\n'
  else
    printf 'v2.39.1\n'
  fi
elif [[ "$3" == ps && -n "${FAKE_DOCKER_PORT_CONFLICT:-}" && "${*: -1}" == "publish=$FAKE_DOCKER_PORT_CONFLICT" ]]; then
  printf 'container-id\n'
fi
EOF
