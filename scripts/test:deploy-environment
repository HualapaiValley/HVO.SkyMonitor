cat > "$REMOTE_BIN/find" <<'EOF'
#!/usr/bin/bash
set -euo pipefail
root=${2:-}
if [[ -n "${FAKE_REMOTE_FIND_FAIL_MATCH:-}" && "$root" == *"$FAKE_REMOTE_FIND_FAIL_MATCH"* ]]; then exit 74; fi
if [[ -n "${FAKE_REMOTE_FIND_FAIL_ONCE_MATCH:-}" && "$root" == *"$FAKE_REMOTE_FIND_FAIL_ONCE_MATCH"* ]]; then
  failure_key="$(printf '%s' "$root" | /usr/bin/sha256sum | /usr/bin/cut -d' ' -f1)"
  failure_state="${FAKE_IMAGE_STATE:?}/find-failed-$failure_key"
  if [[ ! -f "$failure_state" ]]; then : > "$failure_state"; exit 74; fi
fi
mapped_uid() {
  local path=$1 uid
  uid="$(/usr/bin/awk -F '\t' -v path="$path" '$1 == path { value=$2; count++ } END { if (count == 1) print value; else if (count > 1) exit 2 }' "${FAKE_REMOTE_UID_MAP:?}")" || return 1
  if [[ -n "$uid" ]]; then printf '%s\n' "$uid"
  elif [[ "${FAKE_RUNTIME_UID_HOST:-}" == "${FAKE_REMOTE_HOST:-}" && "$path" == */deploy-services-skymonitor/shared-services* ]]; then printf '%s\n' "${FAKE_RUNTIME_UID:?}"
  else /usr/bin/stat -c %u -- "$path"; fi
}
if [[ "$*" == *'! -user '*'! -user 0 -print -quit'* ]]; then
  runtime_uid=${6}; while IFS= read -r -d '' path; do uid="$(mapped_uid "$path")" || exit 75
    if [[ "$uid" != "$runtime_uid" && "$uid" != 0 ]]; then printf '%s\n' "$path"; break; fi
  done < <(/usr/bin/find -P "$root" -xdev -print0); exit 0
fi
if [[ "$*" == *'-user 0 -print -quit'* ]]; then
  while IFS= read -r -d '' path; do uid="$(mapped_uid "$path")" || exit 75
    if [[ "$uid" == 0 ]]; then printf '%s\n' "$path"; break; fi
  done < <(/usr/bin/find -P "$root" -xdev -print0); exit 0
fi
exec /usr/bin/find "$@"
EOF
chmod +x "$REMOTE_BIN/find"
for tool in bash basename cmp date df dirname grep timeout chmod flock mkdir cp ln readlink realpath rmdir sha256sum sqlite3 sync wc cut seq sleep jq; do ln -s "$(command -v "$tool")" "$REMOTE_BIN/$tool"; done
for entry in "$REMOTE_BIN/"*; do
    [[ "$(basename "$entry")" == ss ]] || ln -s "$entry" "$REMOTE_BIN_NO_SS/$(basename "$entry")"
    [[ "$(basename "$entry")" == curl ]] || ln -s "$entry" "$REMOTE_BIN_NO_CURL/$(basename "$entry")"
    [[ "$(basename "$entry")" == timeout ]] || ln -s "$entry" "$REMOTE_BIN_NO_TIMEOUT/$(basename "$entry")"
done

