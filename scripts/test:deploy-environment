if [[ "$1" == buildx && "$2" == build ]]; then
  destination= component= repository= platforms= created= sdk= source_reference= tree= builder=
  while (( $# > 0 )); do
    case "$1" in
      --builder) builder=$2; shift 2 ;;
      --output) destination="${2#type=docker,dest=}"; shift 2 ;;
      --platform) platforms="$2"; shift 2 ;;
      --tag) repository="$2"; shift 2 ;;
      --label)
        [[ "$2" != io.hvoskymonitor.component=* ]] || component="${2#*=}"
        [[ "$2" != org.opencontainers.image.created=* ]] || created="${2#*=}"
        [[ "$2" != org.opencontainers.image.ref.name=* ]] || source_reference="${2#*=}"
        [[ "$2" != io.hvoskymonitor.dotnet-sdk=* ]] || sdk="${2#*=}"
        [[ "$2" != io.hvoskymonitor.source-tree=* ]] || tree="${2#*=}"
        shift 2 ;;
      *) shift ;;
    esac
  done
  [[ "$builder" == control-builder ]] || exit 1
  architecture="${platforms#linux/}"
  [[ "${FAKE_IMAGE_BUILD_FAIL:-}" != "$component-$architecture" ]] || exit 1
  jq -cn --arg created "$created" --arg sdk "$sdk" --arg source "$source_reference" --arg tree "$tree" \
    '{created:$created,sdk:$sdk,source:$source,tree:$tree}' > "${FAKE_IMAGE_STATE:?}/$component.labels"
  if [[ -z "$destination" ]]; then
    : > "${FAKE_IMAGE_STATE:?}/$component.platforms"
    IFS=, read -r -a selected <<< "$platforms"
    for platform in "${selected[@]}"; do printf '%s\n' "${platform#linux/}" >> "${FAKE_IMAGE_STATE:?}/$component.platforms"; done
    : > "${FAKE_IMAGE_STATE:?}/$component.pushed"
  fi
  if [[ -n "$destination" ]]; then
    fixture="${FAKE_IMAGE_STATE:?}/archive-$BASHPID"; mkdir -m 700 "$fixture"
    printf '{"architecture":"%s","os":"linux","config":{"Labels":{"org.opencontainers.image.revision":"%s","org.opencontainers.image.created":"%s","org.opencontainers.image.ref.name":"%s","io.hvoskymonitor.component":"%s","io.hvoskymonitor.dotnet-sdk":"%s","io.hvoskymonitor.source-tree":"%s"}}}' \
      "$architecture" "${FAKE_REVISION:?}" "$created" "$source_reference" "$component" "$sdk" "$tree" > "$fixture/config"
    config_digest="$(sha256sum "$fixture/config" | cut -d' ' -f1)"
    config_path="$config_digest.json"
    if [[ "${FAKE_BUILD_ARCHIVE_BLOB_CONFIG:-false}" == true ]]; then
      mkdir -p "$fixture/blobs/sha256"; config_path="blobs/sha256/$config_digest"
    fi
    mv "$fixture/config" "$fixture/$config_path"
    printf '[{"Config":"%s","RepoTags":["%s"],"Layers":[]}]\n' "$config_path" "$repository" > "$fixture/manifest.json"
    tar -cf "$destination" -C "$fixture" manifest.json "$config_path"
    rm -rf "$fixture"
  fi
  exit 0
fi
if [[ "$1" == buildx && "$2" == imagetools && "$3" == inspect ]]; then
  builder= format= raw=false; shift 3
  while (( $# > 0 )); do
    case "$1" in --builder) builder=$2; shift 2 ;; --raw) raw=true; shift ;; --format) format=$2; shift 2 ;; *) reference=$1; shift ;; esac
  done
  [[ "$builder" == control-builder ]] || exit 1
  component=cameraAgent; [[ "$reference" == *logichost* ]] && component=logicHost
