(
  source "$REPO_ROOT/scripts/deploy/common.sh"
  source "$REPO_ROOT/scripts/deploy/bootstrap.sh"
  local_continuity="$TEMP_DIR/local-continuity.json"; central_continuity="$TEMP_DIR/central-continuity.json"
