  esac
fi
context_rebound=false
if [[ "$1" == --context && "${FAKE_DOCKER_CONTEXT_REBIND:-}" == "$context" ]]; then
  rebind_count_file="${FAKE_IMAGE_STATE:?}/docker-context-rebind-$context"
  rebind_count=0; [[ ! -f "$rebind_count_file" ]] || rebind_count="$(<"$rebind_count_file")"
  rebind_count=$((rebind_count + 1)); printf '%s\n' "$rebind_count" > "$rebind_count_file"
  (( rebind_count <= 1 )) || context_rebound=true
fi
case "$context" in
  logic-context) id=logic-daemon; name=logic-node; daemon_architecture=x86_64; image_architecture=amd64 ;;
  east-context) id=east-daemon; name=east-node; daemon_architecture=aarch64; image_architecture=arm64 ;;
  west-context) id=west-daemon; name=west-node; daemon_architecture=x86_64; image_architecture=amd64 ;;
  shared-context) id=shared-daemon; name=shared-node; daemon_architecture=x86_64; image_architecture=amd64 ;;
  *) exit 1 ;;
esac
[[ "${FAKE_DOCKER_MISMATCH:-}" != "$context" ]] || id=changed-daemon
[[ "${FAKE_DOCKER_WRONG_HOST_CONTEXT:-}" != "$context" ]] || name=wrong-node
[[ "${FAKE_DOCKER_UNSUPPORTED_ARCH:-}" != "$context" ]] || daemon_architecture=ppc64le
if [[ ( "$3" == container || "$3" == network || "$3" == volume ) && "$4" == ls ]]; then
  resource_kind=$3; resource_filter=
  shift 4
  while (( $# > 0 )); do
    if [[ "$1" == --filter ]]; then resource_filter=$2; shift 2; else shift; fi
  done
  if [[ "$context_rebound" != true && "${FAKE_PARTIAL_PREPARE_RESOURCE:-}" == "$context:$resource_kind:$resource_filter" ]]; then
    resource_count_file="${FAKE_IMAGE_STATE:?}/partial-prepare-resource-count"
    resource_count=0; [[ ! -f "$resource_count_file" ]] || resource_count="$(<"$resource_count_file")"
    resource_count=$((resource_count + 1)); printf '%s\n' "$resource_count" > "$resource_count_file"
    if [[ -z "${FAKE_PARTIAL_PREPARE_RESOURCE_AFTER:-}" || "$resource_count" -ge "$FAKE_PARTIAL_PREPARE_RESOURCE_AFTER" ]]; then
      printf 'unexpected-resource\n'
    fi
  fi
elif [[ "$3" == image && "$4" == pull ]]; then
  reference=$5
  [[ "${FAKE_IMAGE_TRANSFER_FAIL:-}" != "$context" ]] || exit 1
  printf '%s\n' "$reference" > "${FAKE_IMAGE_STATE:?}/$context.reference"
elif [[ "$3" == image && "$4" == load ]]; then
  archive=$6
  [[ "${FAKE_IMAGE_TRANSFER_FAIL:-}" != "$context" ]] || exit 1
