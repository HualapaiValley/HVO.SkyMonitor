cat > "$TEMP_DIR/Listener.cs" <<'EOF'
using System.Net;
using System.Net.Sockets;
using System.Text;

var listener = new TcpListener(IPAddress.Loopback, 0);
listener.Start();
using var blocked = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
blocked.Bind(new IPEndPoint(IPAddress.Loopback, 0));
File.WriteAllText(args[0], $"{((IPEndPoint)listener.LocalEndpoint).Port} {((IPEndPoint)blocked.LocalEndPoint!).Port}\n");
var response = Encoding.ASCII.GetBytes("HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
while (true)
{
    using var client = await listener.AcceptTcpClientAsync();
    try { await client.GetStream().WriteAsync(response); } catch (IOException) { }
}
EOF
dotnet run "$TEMP_DIR/Listener.cs" -- "$TEMP_DIR/listener.ports" >"$TEMP_DIR/server.log" 2>&1 &
SERVER_PID=$!
listener_ready=false
for _ in {1..100}; do
    kill -0 "$SERVER_PID" 2>/dev/null || break
    if [[ -s "$TEMP_DIR/listener.ports" ]]; then
        read -r HTTP_PORT UNREACHABLE_PORT < "$TEMP_DIR/listener.ports"
        if curl --silent --max-time 1 --output /dev/null "http://127.0.0.1:$HTTP_PORT"; then listener_ready=true; break; fi
    fi
    sleep 0.1
done
[[ "$listener_ready" == true ]] || fail 'Local connectivity fixture did not start with the pinned .NET SDK.'
# shellcheck disable=SC2034 # UNREACHABLE_PORT is read by scripts/deploy-contracts/preflight-3.sh, sourced into this shell.
readonly HTTP_PORT UNREACHABLE_PORT
readonly EAST_PORT=5130
readonly WEST_PORT=5131

cat > "$BIN/ssh" <<'EOF'
#!/usr/bin/bash
set -euo pipefail
printf 'ssh' >> "${FAKE_LOG:?}"; printf '\t%s' "$@" >> "$FAKE_LOG"; printf '\n' >> "$FAKE_LOG"
while [[ "$1" != -- ]]; do shift; done
shift
ssh_host=$1
shift
case "$ssh_host" in logic@*) host=logic ;; east@*) host=east ;; west@*) host=west ;; shared@*) host=shared ;; *) exit 1 ;; esac
[[ "${FAKE_SSH_UNREACHABLE:-}" != "$host" ]] || exit 255
if [[ "${FAKE_MISSING_BASH_HOST:-}" == "$host" ]]; then /usr/bin/cat >/dev/null; exit 127; fi
if (( $# == 1 )); then
  remote_command=$1
  eval "set -- $remote_command"
  [[ "$1" == bash && "$2" == -s && "$3" == -- ]] || exit 96
  shift 3
else
  [[ "$1" == bash && "$2" == -s && "$3" == -- ]] || exit 96
  shift 3
  # OpenSSH joins legacy command arguments without preserving empty values.
  ssh_args=()
  for arg in "$@"; do [[ -n "$arg" ]] && ssh_args+=("$arg"); done
  set -- "${ssh_args[@]}"
fi
if [[ -n "${FAKE_RUNTIME_SSH_TIMEOUT_PHASE:-}" && -n "${FAKE_RUNTIME_SSH_TIMEOUT_MATCH:-}" &&
      "${1:-}" == *"$FAKE_RUNTIME_SSH_TIMEOUT_MATCH"* ]]; then
  if [[ "$FAKE_RUNTIME_SSH_TIMEOUT_PHASE" == initial && $# == 3 ]] ||
     [[ "$FAKE_RUNTIME_SSH_TIMEOUT_PHASE" == final && $# == 4 ]]; then /usr/bin/cat >/dev/null; exit 124; fi
fi
prepare=false; (( $# >= 12 )) && prepare=true
remote_args=(-s --)
if [[ "${FAKE_CAPTURE_REMOTE_SCRIPTS:-false}" == true || "$prepare" == true ]]; then
  script="${FAKE_SCRIPT_ROOT:?}/remote-$host-$BASHPID.sh"
  umask 077
  /usr/bin/cat > "$script"
  remote_args=("$script")
fi
if [[ "${FAKE_CAPTURE_REMOTE_SCRIPTS:-false}" == true ]]; then
  printf 'remote-script-begin %s\n' "$host" >> "${FAKE_REMOTE_LOG:?}"
  /usr/bin/cat "$script" >> "$FAKE_REMOTE_LOG"
  printf 'remote-script-end %s\n' "$host" >> "$FAKE_REMOTE_LOG"
fi
if [[ "$prepare" == true ]]; then /usr/bin/cat "$script" >> "${FAKE_PREPARE_REMOTE_LOG:?}"; fi
if [[ -n "${FAKE_SSH_FAIL_UPLOAD_MOVE_MATCH:-}" && $# -eq 2 && "$2" == *"$FAKE_SSH_FAIL_UPLOAD_MOVE_MATCH"* ]]; then exit 73; fi
# The object-store qualifier is piped to the target host. The fixture has no qualified
# filesystem, so the declared topology is echoed back as the preflight document it emits.
if (( $# == 6 )) && [[ "$1" == /* && "$2" =~ ^[0-9]+$ && "$3" =~ ^[0-9]+$ && "$4" =~ ^[0-9a-fA-F-]{36}$ ]]; then
  /usr/bin/cat >/dev/null
  [[ "${FAKE_OBJECT_STORE_QUALIFY_FAIL:-}" != "$host" ]] || exit 1
  /usr/bin/jq -cn --arg root "$1" --argjson uid "$2" --argjson gid "$3" --arg uuid "$4" \
    '{schema:"hvo-filesystem-object-store-preflight-v1",root:$root,uid:$uid,gid:$gid,
      mount:{uuid:$uuid,filesystem:"ext4"},buckets:["skymonitor-artifacts","skymonitor-diagnostics"]}'
  exit 0
fi
remote_path="${FAKE_REMOTE_BIN:?}"
[[ "${FAKE_MISSING_SS_HOST:-}" != "$host" ]] || remote_path="${FAKE_REMOTE_BIN_NO_SS:?}"
[[ "${FAKE_MISSING_CURL_HOST:-}" != "$host" ]] || remote_path="${FAKE_REMOTE_BIN_NO_CURL:?}"
[[ "${FAKE_MISSING_TIMEOUT_HOST:-}" != "$host" ]] || remote_path="${FAKE_REMOTE_BIN_NO_TIMEOUT:?}"
if FAKE_REMOTE_HOST="$host" FAKE_REMOTE_PREPARE="$prepare" PATH="$remote_path" /usr/bin/bash "${remote_args[@]}" "$@"; then
  if (( $# == 2 )) && [[ "$2" == */camera-module.json ]]; then
    canonical="$(/usr/bin/jq -S -c . "$2")"
    width="$(/usr/bin/jq -r '.rig.sensor.widthPixels' "$2")"
    if [[ "${FAKE_CONFIG_RUNTIME_HASH_STALE:-}" != "$host" || ( "$width" != 1936 && "$width" != 3096 ) ]]; then
      printf '%s' "$canonical" | /usr/bin/sha256sum | /usr/bin/cut -d' ' -f1 > "${FAKE_HTTP_STATE:?}/$host.active-config-sha"
    fi
    /usr/bin/cp "$2" "$FAKE_HTTP_STATE/$host.active-profile.json"
    rm -f "${FAKE_HTTP_STATE:?}/$host.measure-profile" "$FAKE_HTTP_STATE/$host.measure-running" "$FAKE_HTTP_STATE/$host.measure-stage"
    if [[ "$width" == 1936 || "$width" == 3096 ]]; then
      : > "$FAKE_HTTP_STATE/$host.measure-profile"
      /usr/bin/cp "$2" "$FAKE_HTTP_STATE/$host.schedule-pending.json"
      if [[ -f "$FAKE_HTTP_STATE/$host.schedule-active-revision" && "$(<"$FAKE_HTTP_STATE/$host.schedule-active-revision")" == schedule-pending-v2 ]]; then
        printf 'schedule-pending-v3\n' > "$FAKE_HTTP_STATE/$host.schedule-pending-revision"
      else
        printf 'schedule-pending-v2\n' > "$FAKE_HTTP_STATE/$host.schedule-pending-revision"
      fi
      if [[ -f "$FAKE_HTTP_STATE/$host.schedule-active.json" ]]; then printf '4\n'; else printf '2\n'; fi > "$FAKE_HTTP_STATE/$host.schedule-state-version"
    elif [[ "$(/usr/bin/jq -r '.rig.profileVersion // ""' "$2")" == w0-deterministic-mono16-v1 ]]; then
      if [[ ! -f "$FAKE_HTTP_STATE/$host.schedule-active.json" ]] || ! /usr/bin/cmp -s "$2" "$FAKE_HTTP_STATE/$host.schedule-active.json"; then
        /usr/bin/cp "$2" "$FAKE_HTTP_STATE/$host.schedule-pending.json"
        if [[ -f "$FAKE_HTTP_STATE/$host.schedule-prior.json" ]] && /usr/bin/cmp -s "$2" "$FAKE_HTTP_STATE/$host.schedule-prior.json"; then
          /usr/bin/cp "$FAKE_HTTP_STATE/$host.schedule-prior-revision" "$FAKE_HTTP_STATE/$host.schedule-pending-revision"
        else
          printf 'schedule-pending-v2\n' > "$FAKE_HTTP_STATE/$host.schedule-pending-revision"
        fi
        : > "$FAKE_HTTP_STATE/$host.schedule-w0-draft"
        if [[ -f "$FAKE_HTTP_STATE/$host.schedule-active.json" ]]; then printf '4\n'; else printf '2\n'; fi > "$FAKE_HTTP_STATE/$host.schedule-state-version"
      fi
    elif [[ -f "$FAKE_HTTP_STATE/$host.schedule-active.json" ]]; then
      /usr/bin/cp "$2" "$FAKE_HTTP_STATE/$host.schedule-pending.json"
      if [[ -f "$FAKE_HTTP_STATE/$host.schedule-prior.json" ]] && /usr/bin/cmp -s "$2" "$FAKE_HTTP_STATE/$host.schedule-prior.json"; then
        /usr/bin/cp "$FAKE_HTTP_STATE/$host.schedule-prior-revision" "$FAKE_HTTP_STATE/$host.schedule-pending-revision"
      else
        printf 'schedule-pending-v4\n' > "$FAKE_HTTP_STATE/$host.schedule-pending-revision"
      fi
      printf '4\n' > "$FAKE_HTTP_STATE/$host.schedule-state-version"
    fi
  fi
else exit $?; fi
EOF
cat > "$BIN/docker" <<'EOF'
#!/usr/bin/bash
set -euo pipefail
printf 'docker' >> "${FAKE_LOG:?}"; printf '\t%s' "$@" >> "$FAKE_LOG"; printf '\n' >> "$FAKE_LOG"
digest_for() {
  case "$1-$2" in logicHost-amd64) printf 'a%.0s' {1..64} ;; cameraAgent-arm64) printf 'b%.0s' {1..64} ;; cameraAgent-amd64) printf 'c%.0s' {1..64} ;; *) exit 1 ;; esac
}
registry_manifest() {
  local component=$1 platform_file="${FAKE_IMAGE_STATE:?}/$1.platforms" first=true architecture digest descriptors=''
  while IFS= read -r architecture; do
    digest="$(digest_for "$component" "$architecture")"
    [[ "$first" == true ]] || descriptors+=','; first=false
    descriptors+="{\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"digest\":\"sha256:$digest\",\"size\":1,\"platform\":{\"architecture\":\"$architecture\",\"os\":\"linux\"}}"
    if [[ "${FAKE_REGISTRY_ATTESTATION:-true}" == true ]]; then
      attest="$(printf 'd%.0s' {1..64})"
      descriptors+=",{\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"digest\":\"sha256:$attest\",\"size\":1,\"annotations\":{\"vnd.docker.reference.digest\":\"sha256:$digest\",\"vnd.docker.reference.type\":\"attestation-manifest\"},\"platform\":{\"architecture\":\"unknown\",\"os\":\"unknown\"}}"
    fi
  done < "$platform_file"
  printf '{"schemaVersion":2,"mediaType":"application/vnd.oci.image.index.v1+json","manifests":[%s]}\n' "$descriptors"
}
if [[ "$1" == buildx && "$2" == ls ]]; then
  endpoint=default
  [[ "${FAKE_BUILDER_CANONICAL_LOCAL:-false}" != true ]] || endpoint=unix:///var/run/docker.sock
  [[ "${FAKE_BUILDER_REMOTE:-false}" != true ]] || endpoint=remote-context
  if [[ "${FAKE_BUILDER_MULTI_NODE:-false}" == true ]]; then
    printf '{"Current":false,"Driver":"docker-container","Dynamic":false,"Name":"control-builder","Nodes":[{"Endpoint":"unix:///var/run/docker.sock","Name":"control-builder-amd64","Platforms":["linux/amd64"],"Status":"running","Version":"v0.31.0"},{"Endpoint":"arm64-context","Name":"control-builder-arm64","Platforms":["linux/arm64"],"Status":"running","Version":"v0.31.0"}]}\n'
  else
    printf '{"Current":false,"Driver":"docker","Dynamic":false,"Name":"control-builder","Nodes":[{"Endpoint":"%s","Name":"control-builder0","Platforms":["linux/amd64","linux/arm64"],"Status":"running","Version":"v0.31.0"}]}\n' "$endpoint"
  fi
  exit 0
fi
if [[ "$1" == info ]]; then
  printf '{"ID":"control-daemon","Name":"control-node","Architecture":"x86_64","OSType":"linux"}\n'
  exit 0
fi
if [[ "$1" == buildx && "$2" == build ]]; then
  destination= component= repository= platforms= created= sdk= source_reference= tree= builder=
  while (( $# > 0 )); do
    case "$1" in
      --builder) builder=$2; shift 2 ;;
      --output) destination="${2#type=docker,dest=}"; shift 2 ;;
      --platform) platforms="$2"; shift 2 ;;
      --tag) repository="$2"; shift 2 ;;
      --label)
        [[ "$2" != io.hvoskymonitor.component=* ]] || component="${2#*=}"
        [[ "$2" != org.opencontainers.image.created=* ]] || created="${2#*=}"
        [[ "$2" != org.opencontainers.image.ref.name=* ]] || source_reference="${2#*=}"
        [[ "$2" != io.hvoskymonitor.dotnet-sdk=* ]] || sdk="${2#*=}"
        [[ "$2" != io.hvoskymonitor.source-tree=* ]] || tree="${2#*=}"
        shift 2 ;;
      *) shift ;;
    esac
  done
  [[ "$builder" == control-builder ]] || exit 1
  architecture="${platforms#linux/}"
  [[ "${FAKE_IMAGE_BUILD_FAIL:-}" != "$component-$architecture" ]] || exit 1
  jq -cn --arg created "$created" --arg sdk "$sdk" --arg source "$source_reference" --arg tree "$tree" \
    '{created:$created,sdk:$sdk,source:$source,tree:$tree}' > "${FAKE_IMAGE_STATE:?}/$component.labels"
  if [[ -z "$destination" ]]; then
    : > "${FAKE_IMAGE_STATE:?}/$component.platforms"
    IFS=, read -r -a selected <<< "$platforms"
    for platform in "${selected[@]}"; do printf '%s\n' "${platform#linux/}" >> "${FAKE_IMAGE_STATE:?}/$component.platforms"; done
    : > "${FAKE_IMAGE_STATE:?}/$component.pushed"
  fi
  if [[ -n "$destination" ]]; then
    fixture="${FAKE_IMAGE_STATE:?}/archive-$BASHPID"; mkdir -m 700 "$fixture"
    printf '{"architecture":"%s","os":"linux","config":{"Labels":{"org.opencontainers.image.revision":"%s","org.opencontainers.image.created":"%s","org.opencontainers.image.ref.name":"%s","io.hvoskymonitor.component":"%s","io.hvoskymonitor.dotnet-sdk":"%s","io.hvoskymonitor.source-tree":"%s"}}}' \
      "$architecture" "${FAKE_REVISION:?}" "$created" "$source_reference" "$component" "$sdk" "$tree" > "$fixture/config"
    config_digest="$(sha256sum "$fixture/config" | cut -d' ' -f1)"
    config_path="$config_digest.json"
    if [[ "${FAKE_BUILD_ARCHIVE_BLOB_CONFIG:-false}" == true ]]; then
      mkdir -p "$fixture/blobs/sha256"; config_path="blobs/sha256/$config_digest"
    fi
    mv "$fixture/config" "$fixture/$config_path"
    printf '[{"Config":"%s","RepoTags":["%s"],"Layers":[]}]\n' "$config_path" "$repository" > "$fixture/manifest.json"
    tar -cf "$destination" -C "$fixture" manifest.json "$config_path"
    rm -rf "$fixture"
  fi
  exit 0
fi
if [[ "$1" == buildx && "$2" == imagetools && "$3" == inspect ]]; then
  builder= format= raw=false; shift 3
  while (( $# > 0 )); do
    case "$1" in --builder) builder=$2; shift 2 ;; --raw) raw=true; shift ;; --format) format=$2; shift 2 ;; *) reference=$1; shift ;; esac
  done
  [[ "$builder" == control-builder ]] || exit 1
  component=cameraAgent; [[ "$reference" == *logichost* ]] && component=logicHost
  [[ -f "${FAKE_IMAGE_STATE:?}/$component.pushed" ]] || exit 1
  if [[ "$raw" == true ]]; then registry_manifest "$component"; exit 0; fi
  if [[ "$format" == '{{json .Manifest}}' ]]; then
    raw_manifest="$(registry_manifest "$component")"; parent="$(registry_manifest "$component" | sha256sum | cut -d' ' -f1)"
    jq -c --arg digest "sha256:$parent" '. + {digest:$digest}' <<< "$raw_manifest"
    exit 0
  fi
  [[ "$format" == '{{json .Image}}' ]] || exit 1
  digest="${reference##*@sha256:}"; architecture=arm64
  [[ "$digest" == "$(digest_for "$component" amd64)" ]] && architecture=amd64
  labels="$(<"${FAKE_IMAGE_STATE:?}/$component.labels")"
  tree="$(jq -r .tree <<< "$labels")"; [[ "${FAKE_REGISTRY_MISMATCH_COMPONENT:-}" != "$component" ]] || tree="$(printf 'f%.0s' {1..40})"
  printf '{"architecture":"%s","os":"linux","config":{"Labels":{"org.opencontainers.image.revision":"%s","org.opencontainers.image.created":"%s","org.opencontainers.image.ref.name":"%s","io.hvoskymonitor.component":"%s","io.hvoskymonitor.dotnet-sdk":"%s","io.hvoskymonitor.source-tree":"%s"}}}\n' \
    "$architecture" "${FAKE_REVISION:?}" "$(jq -r .created <<< "$labels")" "$(jq -r .source <<< "$labels")" "$component" "$(jq -r .sdk <<< "$labels")" "$tree"
  exit 0
fi
if [[ "$1" == context && "$2" == inspect ]]; then
  context="${*: -1}"
  case "$context" in
    logic-context) endpoint=ssh://logic@example ;;
    east-context) endpoint=ssh://east@example ;;
    west-context) endpoint=ssh://west@example ;;
    shared-context) endpoint=ssh://shared@example ;;
    *) exit 1 ;;
  esac
  if [[ "$*" == *Endpoints.docker.Host* ]]; then printf '{"name":"%s","host":"%s"}\n' "$context" "$endpoint"
  else printf '%s\n' "$context"; fi
  exit 0
fi
context=$2
if [[ "$1" == --host ]]; then
  case "$context" in
    ssh://logic@example) context=logic-context ;;
    ssh://east@example) context=east-context ;;
    ssh://west@example) context=west-context ;;
    ssh://shared@example) context=shared-context ;;
