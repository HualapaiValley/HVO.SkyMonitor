#!/usr/bin/env bash
# Exercise split-host preflight with fake hosts and Docker contexts; no target is mutated.

set -euo pipefail
export LC_ALL=C

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly REPO_ROOT
TEMP_DIR="$(mktemp -d -t hvo-deploy-test.XXXXXX)"
readonly TEMP_DIR
readonly BIN="$TEMP_DIR/bin"
readonly REMOTE_BIN="$TEMP_DIR/remote-bin"
readonly REMOTE_BIN_NO_SS="$TEMP_DIR/remote-bin-no-ss"
readonly REMOTE_BIN_NO_CURL="$TEMP_DIR/remote-bin-no-curl"
readonly REMOTE_BIN_NO_TIMEOUT="$TEMP_DIR/remote-bin-no-timeout"
readonly INVENTORY="$TEMP_DIR/inventory.yml"
readonly BASE_INVENTORY="$TEMP_DIR/inventory.base"
readonly SECRET_FILE="$TEMP_DIR/deploy.env"
readonly LOG="$TEMP_DIR/commands.log"
readonly REMOTE_LOG="$TEMP_DIR/remote-scripts.log"
readonly PREPARE_REMOTE_LOG="$TEMP_DIR/prepare-remote-scripts.log"
REVISION="$(git -C "$REPO_ROOT" rev-parse HEAD)"
readonly REVISION
REAL_STAT="$(command -v stat)"
readonly REAL_STAT
REAL_GREP="$(command -v grep)"
readonly REAL_GREP
REAL_GIT="$(command -v git)"
readonly REAL_GIT
SERVER_PID=""

cleanup() {
    [[ -z "$SERVER_PID" ]] || kill "$SERVER_PID" 2>/dev/null || true
    rm -rf "$TEMP_DIR"
}
trap cleanup EXIT
trap 'printf "Deploy environment contract test failed near line %s.\n" "$LINENO" >&2' ERR
fail() { printf '%s\n' "$1" >&2; exit 1; }

mkdir -m 700 "$BIN" "$REMOTE_BIN" "$REMOTE_BIN_NO_SS" "$REMOTE_BIN_NO_CURL" "$REMOTE_BIN_NO_TIMEOUT" "$TEMP_DIR/output" "$TEMP_DIR/remote"
mkdir -p "$TEMP_DIR/remote/logic/runtime" "$TEMP_DIR/remote/east" "$TEMP_DIR/remote/west/runtime"
cat > "$TEMP_DIR/Listener.cs" <<'EOF'
using System.Net;
using System.Net.Sockets;
using System.Text;

var listener = new TcpListener(IPAddress.Loopback, 0);
listener.Start();
using var blocked = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
blocked.Bind(new IPEndPoint(IPAddress.Loopback, 0));
File.WriteAllText(args[0], $"{((IPEndPoint)listener.LocalEndpoint).Port} {((IPEndPoint)blocked.LocalEndPoint!).Port}\n");
var response = Encoding.ASCII.GetBytes("HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
while (true)
{
    using var client = await listener.AcceptTcpClientAsync();
    try { await client.GetStream().WriteAsync(response); } catch (IOException) { }
}
EOF
dotnet run "$TEMP_DIR/Listener.cs" -- "$TEMP_DIR/listener.ports" >"$TEMP_DIR/server.log" 2>&1 &
SERVER_PID=$!
listener_ready=false
for _ in {1..100}; do
    kill -0 "$SERVER_PID" 2>/dev/null || break
    if [[ -s "$TEMP_DIR/listener.ports" ]]; then
        read -r HTTP_PORT UNREACHABLE_PORT < "$TEMP_DIR/listener.ports"
        if curl --silent --max-time 1 --output /dev/null "http://127.0.0.1:$HTTP_PORT"; then listener_ready=true; break; fi
    fi
    sleep 0.1
done
[[ "$listener_ready" == true ]] || fail 'Local connectivity fixture did not start with the pinned .NET SDK.'
readonly HTTP_PORT UNREACHABLE_PORT
readonly EAST_PORT=5130
readonly WEST_PORT=5131

cat > "$BIN/ssh" <<'EOF'
#!/usr/bin/bash
set -euo pipefail
printf 'ssh' >> "${FAKE_LOG:?}"; printf '\t%s' "$@" >> "$FAKE_LOG"; printf '\n' >> "$FAKE_LOG"
while [[ "$1" != -- ]]; do shift; done
shift
ssh_host=$1
shift
case "$ssh_host" in logic@*) host=logic ;; east@*) host=east ;; west@*) host=west ;; shared@*) host=shared ;; *) exit 1 ;; esac
[[ "${FAKE_SSH_UNREACHABLE:-}" != "$host" ]] || exit 255
if [[ "${FAKE_MISSING_BASH_HOST:-}" == "$host" ]]; then /usr/bin/cat >/dev/null; exit 127; fi
[[ "$1" == bash && "$2" == -s && "$3" == -- ]] || exit 96
shift 3
script="${FAKE_SCRIPT_ROOT:?}/remote-$host-$BASHPID.sh"
umask 077
/usr/bin/cat > "$script"
prepare=false; (( $# >= 12 )) && prepare=true
printf 'remote-script-begin %s\n' "$host" >> "${FAKE_REMOTE_LOG:?}"
/usr/bin/cat "$script" >> "$FAKE_REMOTE_LOG"
printf 'remote-script-end %s\n' "$host" >> "$FAKE_REMOTE_LOG"
if [[ "$prepare" == true ]]; then /usr/bin/cat "$script" >> "${FAKE_PREPARE_REMOTE_LOG:?}"; fi
remote_path="${FAKE_REMOTE_BIN:?}"
[[ "${FAKE_MISSING_SS_HOST:-}" != "$host" ]] || remote_path="${FAKE_REMOTE_BIN_NO_SS:?}"
[[ "${FAKE_MISSING_CURL_HOST:-}" != "$host" ]] || remote_path="${FAKE_REMOTE_BIN_NO_CURL:?}"
[[ "${FAKE_MISSING_TIMEOUT_HOST:-}" != "$host" ]] || remote_path="${FAKE_REMOTE_BIN_NO_TIMEOUT:?}"
FAKE_REMOTE_HOST="$host" FAKE_REMOTE_PREPARE="$prepare" PATH="$remote_path" /usr/bin/bash "$script" "$@"
EOF
cat > "$BIN/docker" <<'EOF'
#!/usr/bin/bash
set -euo pipefail
printf 'docker' >> "${FAKE_LOG:?}"; printf '\t%s' "$@" >> "$FAKE_LOG"; printf '\n' >> "$FAKE_LOG"
digest_for() {
  case "$1-$2" in logicHost-amd64) printf 'a%.0s' {1..64} ;; cameraAgent-arm64) printf 'b%.0s' {1..64} ;; cameraAgent-amd64) printf 'c%.0s' {1..64} ;; *) exit 1 ;; esac
}
registry_manifest() {
  local component=$1 platform_file="${FAKE_IMAGE_STATE:?}/$1.platforms" first=true architecture digest descriptors=''
  while IFS= read -r architecture; do
    digest="$(digest_for "$component" "$architecture")"
    [[ "$first" == true ]] || descriptors+=','; first=false
    descriptors+="{\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"digest\":\"sha256:$digest\",\"size\":1,\"platform\":{\"architecture\":\"$architecture\",\"os\":\"linux\"}}"
    if [[ "${FAKE_REGISTRY_ATTESTATION:-true}" == true ]]; then
      attest="$(printf 'd%.0s' {1..64})"
      descriptors+=",{\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"digest\":\"sha256:$attest\",\"size\":1,\"annotations\":{\"vnd.docker.reference.digest\":\"sha256:$digest\",\"vnd.docker.reference.type\":\"attestation-manifest\"},\"platform\":{\"architecture\":\"unknown\",\"os\":\"unknown\"}}"
    fi
  done < "$platform_file"
  printf '{"schemaVersion":2,"mediaType":"application/vnd.oci.image.index.v1+json","manifests":[%s]}\n' "$descriptors"
}
if [[ "$1" == buildx && "$2" == ls ]]; then
  endpoint=default; [[ "${FAKE_BUILDER_REMOTE:-false}" != true ]] || endpoint=remote-context
  printf '{"Current":false,"Driver":"docker","Dynamic":false,"Name":"control-builder","Nodes":[{"Endpoint":"%s","Name":"control-builder0","Platforms":["linux/amd64","linux/arm64"],"Status":"running","Version":"v0.31.0"}]}\n' "$endpoint"
  exit 0
fi
if [[ "$1" == info ]]; then
  printf '{"ID":"control-daemon","Name":"control-node","Architecture":"x86_64","OSType":"linux"}\n'
  exit 0
fi
if [[ "$1" == buildx && "$2" == build ]]; then
  destination= component= repository= platforms= created= sdk= source_reference= tree= builder=
  while (( $# > 0 )); do
    case "$1" in
      --builder) builder=$2; shift 2 ;;
      --output) destination="${2#type=docker,dest=}"; shift 2 ;;
      --platform) platforms="$2"; shift 2 ;;
      --tag) repository="$2"; shift 2 ;;
      --label)
        [[ "$2" != io.hvoskymonitor.component=* ]] || component="${2#*=}"
        [[ "$2" != org.opencontainers.image.created=* ]] || created="${2#*=}"
        [[ "$2" != org.opencontainers.image.ref.name=* ]] || source_reference="${2#*=}"
        [[ "$2" != io.hvoskymonitor.dotnet-sdk=* ]] || sdk="${2#*=}"
        [[ "$2" != io.hvoskymonitor.source-tree=* ]] || tree="${2#*=}"
        shift 2 ;;
      *) shift ;;
    esac
  done
  [[ "$builder" == control-builder ]] || exit 1
  architecture="${platforms#linux/}"
  [[ "${FAKE_IMAGE_BUILD_FAIL:-}" != "$component-$architecture" ]] || exit 1
  jq -cn --arg created "$created" --arg sdk "$sdk" --arg source "$source_reference" --arg tree "$tree" \
    '{created:$created,sdk:$sdk,source:$source,tree:$tree}' > "${FAKE_IMAGE_STATE:?}/$component.labels"
  if [[ -z "$destination" ]]; then
    : > "${FAKE_IMAGE_STATE:?}/$component.platforms"
    IFS=, read -r -a selected <<< "$platforms"
    for platform in "${selected[@]}"; do printf '%s\n' "${platform#linux/}" >> "${FAKE_IMAGE_STATE:?}/$component.platforms"; done
    : > "${FAKE_IMAGE_STATE:?}/$component.pushed"
  fi
  if [[ -n "$destination" ]]; then
    fixture="${FAKE_IMAGE_STATE:?}/archive-$BASHPID"; mkdir -m 700 "$fixture"
    printf '{"architecture":"%s","os":"linux","config":{"Labels":{"org.opencontainers.image.revision":"%s","org.opencontainers.image.created":"%s","org.opencontainers.image.ref.name":"%s","io.hvoskymonitor.component":"%s","io.hvoskymonitor.dotnet-sdk":"%s","io.hvoskymonitor.source-tree":"%s"}}}' \
      "$architecture" "${FAKE_REVISION:?}" "$created" "$source_reference" "$component" "$sdk" "$tree" > "$fixture/config"
    config_digest="$(sha256sum "$fixture/config" | cut -d' ' -f1)"
    mv "$fixture/config" "$fixture/$config_digest.json"
    printf '[{"Config":"%s.json","RepoTags":["%s"],"Layers":[]}]\n' "$config_digest" "$repository" > "$fixture/manifest.json"
    tar -cf "$destination" -C "$fixture" manifest.json "$config_digest.json"
    rm -rf "$fixture"
  fi
  exit 0
fi
if [[ "$1" == buildx && "$2" == imagetools && "$3" == inspect ]]; then
  builder= format= raw=false; shift 3
  while (( $# > 0 )); do
    case "$1" in --builder) builder=$2; shift 2 ;; --raw) raw=true; shift ;; --format) format=$2; shift 2 ;; *) reference=$1; shift ;; esac
  done
  [[ "$builder" == control-builder ]] || exit 1
  component=cameraAgent; [[ "$reference" == *logichost* ]] && component=logicHost
  [[ -f "${FAKE_IMAGE_STATE:?}/$component.pushed" ]] || exit 1
  if [[ "$raw" == true ]]; then registry_manifest "$component"; exit 0; fi
  if [[ "$format" == '{{json .Manifest}}' ]]; then
    raw_manifest="$(registry_manifest "$component")"; parent="$(registry_manifest "$component" | sha256sum | cut -d' ' -f1)"
    jq -c --arg digest "sha256:$parent" '. + {digest:$digest}' <<< "$raw_manifest"
    exit 0
  fi
  [[ "$format" == '{{json .Image}}' ]] || exit 1
  digest="${reference##*@sha256:}"; architecture=arm64
  [[ "$digest" == "$(digest_for "$component" amd64)" ]] && architecture=amd64
  labels="$(<"${FAKE_IMAGE_STATE:?}/$component.labels")"
  tree="$(jq -r .tree <<< "$labels")"; [[ "${FAKE_REGISTRY_MISMATCH_COMPONENT:-}" != "$component" ]] || tree="$(printf 'f%.0s' {1..40})"
  printf '{"architecture":"%s","os":"linux","config":{"Labels":{"org.opencontainers.image.revision":"%s","org.opencontainers.image.created":"%s","org.opencontainers.image.ref.name":"%s","io.hvoskymonitor.component":"%s","io.hvoskymonitor.dotnet-sdk":"%s","io.hvoskymonitor.source-tree":"%s"}}}\n' \
    "$architecture" "${FAKE_REVISION:?}" "$(jq -r .created <<< "$labels")" "$(jq -r .source <<< "$labels")" "$component" "$(jq -r .sdk <<< "$labels")" "$tree"
  exit 0
fi
if [[ "$1" == context && "$2" == inspect ]]; then printf '%s\n' "${*: -1}"; exit 0; fi
context=$2
case "$context" in
  logic-context) id=logic-daemon; name=logic-node; daemon_architecture=x86_64; image_architecture=amd64 ;;
  east-context) id=east-daemon; name=east-node; daemon_architecture=aarch64; image_architecture=arm64 ;;
  west-context) id=west-daemon; name=west-node; daemon_architecture=x86_64; image_architecture=amd64 ;;
  shared-context) id=shared-daemon; name=shared-node; daemon_architecture=x86_64; image_architecture=amd64 ;;
  *) exit 1 ;;
esac
[[ "${FAKE_DOCKER_MISMATCH:-}" != "$context" ]] || id=changed-daemon
[[ "${FAKE_DOCKER_WRONG_HOST_CONTEXT:-}" != "$context" ]] || name=wrong-node
[[ "${FAKE_DOCKER_UNSUPPORTED_ARCH:-}" != "$context" ]] || daemon_architecture=ppc64le
if [[ "$3" == image && "$4" == pull ]]; then
  reference=$5
  [[ "${FAKE_IMAGE_TRANSFER_FAIL:-}" != "$context" ]] || exit 1
  printf '%s\n' "$reference" > "${FAKE_IMAGE_STATE:?}/$context.reference"
elif [[ "$3" == image && "$4" == load ]]; then
  archive=$6
  [[ "${FAKE_IMAGE_TRANSFER_FAIL:-}" != "$context" ]] || exit 1
  config_name="$(tar -xOf "$archive" manifest.json | jq -r '.[0].Config')"
  tar -xOf "$archive" "$config_name" > "${FAKE_IMAGE_STATE:?}/$context.config"
  printf 'sha256:%s\n' "${config_name%.json}" > "${FAKE_IMAGE_STATE:?}/$context.reference"
elif [[ "$3" == image && "$4" == inspect ]]; then
  reference="${*: -1}"
  [[ "${FAKE_IMAGE_INSPECT_DRIFT:-}" != "$context" ]] || image_architecture=amd64
  if [[ -f "${FAKE_IMAGE_STATE:?}/$context.config" ]]; then
    config="$(<"$FAKE_IMAGE_STATE/$context.config")"
    image_id="$(<"$FAKE_IMAGE_STATE/$context.reference")"
    labels="$(jq -c '.config.Labels' <<< "$config")"
    printf '{"id":"%s","architecture":"%s","os":"linux","repoDigests":[],"labels":%s}\n' "$image_id" "$image_architecture" "$labels"
  else
    component=cameraAgent; [[ "$reference" == *logichost* ]] && component=logicHost
    labels="$(<"${FAKE_IMAGE_STATE:?}/$component.labels")"
    manifest_digest="$(registry_manifest "$component" | sha256sum | cut -d' ' -f1)"
    printf '{"id":"sha256:%064d","architecture":"%s","os":"linux","repoDigests":["%s@sha256:%s"],"labels":{"org.opencontainers.image.revision":"%s","org.opencontainers.image.created":"%s","org.opencontainers.image.ref.name":"%s","io.hvoskymonitor.component":"%s","io.hvoskymonitor.dotnet-sdk":"%s","io.hvoskymonitor.source-tree":"%s"}}\n' \
      0 "$image_architecture" "${reference%@*}" "$manifest_digest" "${FAKE_REVISION:?}" "$(jq -r .created <<< "$labels")" \
      "$(jq -r .source <<< "$labels")" "$component" "$(jq -r .sdk <<< "$labels")" "$(jq -r .tree <<< "$labels")"
  fi
elif [[ "$3" == info ]]; then
  case "${FAKE_DOCKER_INFO_MALFORMED:-}" in
    architecture) printf '{"ID":"%s","Name":"%s","OSType":"linux","ServerVersion":"28.1.0"}\n' "$id" "$name" ;;
    os) printf '{"ID":"%s","Name":"%s","Architecture":"%s","OSType":{"secret":"raw-docker-secret"},"ServerVersion":"28.1.0"}\n' "$id" "$name" "$daemon_architecture" ;;
    version) printf '{"ID":"%s","Name":"%s","Architecture":"%s","OSType":"linux","ServerVersion":null}\n' "$id" "$name" "$daemon_architecture" ;;
    *) printf '{"ID":"%s","Name":"%s","Architecture":"%s","OSType":"linux","ServerVersion":"28.1.0"}\n' "$id" "$name" "$daemon_architecture" ;;
  esac
elif [[ "$3" == compose ]]; then
  [[ "${FAKE_COMPOSE_MISSING:-}" != "$context" ]] || exit 1
  printf 'v2.39.1\n'
elif [[ "$3" == ps && -n "${FAKE_DOCKER_PORT_CONFLICT:-}" && "${*: -1}" == "publish=$FAKE_DOCKER_PORT_CONFLICT" ]]; then
  printf 'container-id\n'
fi
EOF
cat > "$BIN/stat" <<'EOF'
#!/usr/bin/bash
if [[ -n "${FAKE_NONOWNER_PATH:-}" && "${*: -1}" == "$FAKE_NONOWNER_PATH" && "$*" == *"-c %u"* ]]; then printf '99999\n'; exit 0; fi
if [[ -n "${FAKE_STAT_ERROR_PATH:-}" && "${*: -1}" == "$FAKE_STAT_ERROR_PATH" ]]; then printf 'fixture-secret-never-print raw stat error\n' >&2; exit 1; fi
exec "${REAL_STAT:?}" "$@"
EOF
cat > "$BIN/grep" <<'EOF'
#!/usr/bin/bash
if [[ "${FAKE_GREP_ERROR:-}" == true ]]; then printf 'fixture-secret-never-print raw grep error\n' >&2; exit 2; fi
exec "${REAL_GREP:?}" "$@"
EOF
cat > "$BIN/git" <<'EOF'
#!/usr/bin/bash
set -euo pipefail
if [[ "$*" == *" status --porcelain"* ]]; then
  count_file="${FAKE_IMAGE_STATE:?}/git-status-count"
  count=0; [[ ! -f "$count_file" ]] || count="$(<"$count_file")"
  count=$((count + 1)); printf '%s\n' "$count" > "$count_file"
  if [[ -n "${FAKE_SOURCE_DIRTY_AT_STATUS:-}" && "$count" -ge "$FAKE_SOURCE_DIRTY_AT_STATUS" ]]; then printf ' M tracked-file\n'; fi
  exit 0
fi
exec "${REAL_GIT:?}" "$@"
EOF
chmod +x "$BIN/ssh" "$BIN/docker" "$BIN/stat" "$BIN/grep" "$BIN/git"

cat > "$REMOTE_BIN/cat" <<'EOF'
#!/usr/bin/bash
if [[ "$1" == /etc/machine-id ]]; then
  if [[ "${FAKE_PREPARE_IDENTITY_MISMATCH_HOST:-}" == "${FAKE_REMOTE_HOST:-}" && "${FAKE_REMOTE_PREPARE:-false}" == true ]]; then printf 'changed-machine\n'
  else printf '%s-machine\n' "${FAKE_REMOTE_HOST:?}"; fi
else exec /usr/bin/cat "$@"; fi
EOF
cat > "$REMOTE_BIN/hostname" <<'EOF'
#!/usr/bin/bash
printf '%s-node\n' "${FAKE_REMOTE_HOST:?}"
EOF
cat > "$REMOTE_BIN/uname" <<'EOF'
#!/usr/bin/bash
case "${FAKE_REMOTE_HOST:?}" in logic|shared|west) printf 'x86_64\n' ;; *) printf 'aarch64\n' ;; esac
EOF
cat > "$REMOTE_BIN/getconf" <<'EOF'
#!/usr/bin/bash
printf '4\n'
EOF
cat > "$REMOTE_BIN/awk" <<'EOF'
#!/usr/bin/bash
if [[ "${*: -1}" == /proc/meminfo ]]; then printf '8192000\n'; else exec /usr/bin/awk "$@"; fi
EOF
cat > "$REMOTE_BIN/stat" <<'EOF'
#!/usr/bin/bash
path="${*: -1}"
if [[ "${FAKE_REMOTE_PREPARE:-false}" == true ]]; then
  if [[ "${2:-}" == %a && "${FAKE_PREPARE_UNSAFE_MODE_HOST:-}" == "${FAKE_REMOTE_HOST:-}" && "$path" == *"/remote/"*"$FAKE_REMOTE_HOST"* ]]; then printf '777\n'; exit 0; fi
  if [[ "${2:-}" == %u && "${FAKE_PREPARE_FOREIGN_OWNER_HOST:-}" == "${FAKE_REMOTE_HOST:-}" && "$path" == *"/remote/"*"$FAKE_REMOTE_HOST"* ]]; then printf '4242\n'; exit 0; fi
  if [[ "${2:-}" == %u && "${FAKE_PREPARE_ROOT_PARENT_HOST:-}" == "${FAKE_REMOTE_HOST:-}" && "$path" == *"/remote/"*"$FAKE_REMOTE_HOST"* ]]; then printf '0\n'; exit 0; fi
  if [[ "${2:-}" == %a ]]; then printf '755\n'; exit 0; fi
  if [[ "${2:-}" == %u && ( "$path" == / || "$path" == /tmp ) ]]; then printf '0\n'; exit 0; fi
fi
if [[ "$*" == *'%u'* && "${FAKE_RUNTIME_OTHER_OWNER_HOST:-}" == "${FAKE_REMOTE_HOST:-}" && "$path" == *"/remote/$FAKE_REMOTE_HOST" ]]; then printf '4242\n'; exit 0; fi
if [[ "$*" == *'%u'* && "${FAKE_RUNTIME_ROOT_OWNER_HOST:-}" == "${FAKE_REMOTE_HOST:-}" && "$path" == *"/remote/$FAKE_REMOTE_HOST" ]]; then printf '0\n'; exit 0; fi
exec /usr/bin/stat "$@"
EOF
cat > "$REMOTE_BIN/ss" <<'EOF'
#!/usr/bin/bash
if [[ "${FAKE_PORT_CONFLICT_HOST:-}" == "${FAKE_REMOTE_HOST:-}" ]]; then printf 'LISTEN 0 1 127.0.0.1:1\n'; fi
EOF
chmod +x "$REMOTE_BIN/"*
cat > "$REMOTE_BIN/curl" <<'EOF'
#!/usr/bin/bash
[[ "${FAKE_CURL_ALWAYS_SUCCESS:-false}" == true ]] && exit 0
exec /usr/bin/curl "$@"
EOF
chmod +x "$REMOTE_BIN/curl"
for tool in bash date df grep id timeout chmod find flock mkdir mv; do ln -s "$(command -v "$tool")" "$REMOTE_BIN/$tool"; done
for entry in "$REMOTE_BIN/"*; do
    [[ "$(basename "$entry")" == ss ]] || ln -s "$entry" "$REMOTE_BIN_NO_SS/$(basename "$entry")"
    [[ "$(basename "$entry")" == curl ]] || ln -s "$entry" "$REMOTE_BIN_NO_CURL/$(basename "$entry")"
    [[ "$(basename "$entry")" == timeout ]] || ln -s "$entry" "$REMOTE_BIN_NO_TIMEOUT/$(basename "$entry")"
done

export FAKE_LOG="$LOG" FAKE_REMOTE_LOG="$REMOTE_LOG" FAKE_SCRIPT_ROOT="$TEMP_DIR"
export FAKE_IMAGE_STATE="$TEMP_DIR/image-state" FAKE_REVISION="$REVISION" FAKE_IMAGE_TAG="rev-$REVISION"
export FAKE_PREPARE_REMOTE_LOG="$PREPARE_REMOTE_LOG"
export FAKE_REMOTE_BIN="$REMOTE_BIN" FAKE_REMOTE_BIN_NO_SS="$REMOTE_BIN_NO_SS" REAL_STAT REAL_GREP REAL_GIT
export FAKE_REMOTE_BIN_NO_CURL="$REMOTE_BIN_NO_CURL"
export FAKE_REMOTE_BIN_NO_TIMEOUT="$REMOTE_BIN_NO_TIMEOUT"
mkdir -m 700 "$FAKE_IMAGE_STATE"

# shellcheck disable=SC2016 # The literal shell syntax verifies secrets are never evaluated.
printf 'SQL_PASSWORD=fixture-secret-never-print\nOAUTH_SECRET=malicious-$(touch /tmp/must-not-run)-never-print\n' > "$SECRET_FILE"
chmod 600 "$SECRET_FILE"

write_inventory() {
    jq -n --arg revision "$REVISION" --arg secret "$SECRET_FILE" --arg root "$TEMP_DIR/remote" --arg owner "$(id -un)" \
      --argjson logicPort "$HTTP_PORT" --argjson eastPort "$EAST_PORT" --argjson westPort "$WEST_PORT" '{
      schemaVersion:3, environment:"test-observatory", installationId:"test-installation",
      source:{revision:$revision,dirtyDisposition:"allow-dirty"},
      secretSource:{path:$secret,requiredReferences:["SQL_PASSWORD","OAUTH_SECRET"]},
      logicHost:{name:"logic",sshHost:"logic@example",dockerContext:"logic-context",expectedArchitecture:"amd64",expectedHostName:"logic-node",
        expectedHostIdentity:"logic-machine",expectedDockerDaemonIdentity:"logic-daemon",runtimeRoot:($root+"/logic/runtime"),runtimeOwner:$owner,
        publicEndpoint:("http://127.0.0.1:"+($logicPort|tostring)),ports:[$logicPort]},
      cameraAgents:[
        {name:"east",sshHost:"east@example",dockerContext:"east-context",expectedArchitecture:"arm64",expectedHostName:"east-node",
          expectedHostIdentity:"east-machine",expectedDockerDaemonIdentity:"east-daemon",runtimeRoot:($root+"/east/runtime"),runtimeOwner:$owner,
          publicEndpoint:("http://127.0.0.1:"+($eastPort|tostring)),ports:[$eastPort]},
        {name:"west",sshHost:"west@example",dockerContext:"west-context",expectedArchitecture:"amd64",expectedHostName:"west-node",
          expectedHostIdentity:"west-machine",expectedDockerDaemonIdentity:"west-daemon",runtimeRoot:($root+"/west/runtime"),runtimeOwner:$owner,
          publicEndpoint:("http://127.0.0.1:"+($westPort|tostring)),ports:[$westPort]}],
      sharedServices:null,
      serviceEndpoints:[{name:"test-service",host:"127.0.0.1",port:$logicPort,fromTargets:["logic","east","west"]}],
      catalog:{kind:"production",version:"catalog-v1",sha256:("0"*64)},
      images:{distributionMode:"registry",artifactRoot:null,tag:("rev-"+$revision),registryImmutableTags:true,
        builder:{name:"control-builder",driver:"docker",endpoint:"default",expectedDaemonIdentity:"control-daemon",expectedDaemonName:"control-node",expectedArchitecture:"amd64"},
        logicHost:{repository:"registry.example/logichost"},cameraAgent:{repository:"registry.example/cameraagent"}}
    }' > "$INVENTORY"
    cp "$INVENTORY" "$BASE_INVENTORY"
}

run_deploy() {
    local run_id="$1"; shift
    PATH="$BIN:$PATH" "$REPO_ROOT/scripts/deploy:environment" preflight --inventory "$INVENTORY" --mode isolated \
      --run-id "$run_id" --state-root "$TEMP_DIR/output/$run_id-state" --evidence-root "$TEMP_DIR/output/$run_id-evidence" "$@"
}

run_deploy_mode() {
    local phase="$1" run_id="$2" mode="$3"; shift 3
    PATH="$BIN:$PATH" "$REPO_ROOT/scripts/deploy:environment" "$phase" --inventory "$INVENTORY" --mode "$mode" \
      --run-id "$run_id" --state-root "$TEMP_DIR/output/$run_id-state" --evidence-root "$TEMP_DIR/output/$run_id-evidence" "$@"
}

write_prepare_case() {
    local prefix="$1" mode="$2"
    mkdir -m 700 "$TEMP_DIR/remote/$prefix-logic" "$TEMP_DIR/remote/$prefix-east" "$TEMP_DIR/remote/$prefix-west"
    jq --arg base "$TEMP_DIR/remote" --arg prefix "$prefix" '
      .logicHost.runtimeRoot=($base+"/"+$prefix+"-logic/runtime") |
      .cameraAgents[0].runtimeRoot=($base+"/"+$prefix+"-east/runtime") |
      .cameraAgents[1].runtimeRoot=($base+"/"+$prefix+"-west/runtime")' "$BASE_INVENTORY" > "$INVENTORY"
    if [[ "$mode" == persistent ]]; then
        jq '(.logicHost.publicEndpoint, .cameraAgents[].publicEndpoint) |= sub("^http:";"https:")' "$INVENTORY" > "$INVENTORY.changed"
        mv "$INVENTORY.changed" "$INVENTORY"
    fi
}

run_prepare_preflight() {
    local run_id="$1" mode="$2"
    if [[ "$mode" == persistent ]]; then FAKE_CURL_ALWAYS_SUCCESS=true run_deploy_mode preflight "$run_id" "$mode" >/dev/null
    else run_deploy_mode preflight "$run_id" "$mode" >/dev/null; fi
}

expect_prepare_failure() {
    local expected="$1" run_id="$2" mode="$3"
    if run_deploy_mode prepare "$run_id" "$mode" > "$TEMP_DIR/prepare-failure.log" 2>&1; then fail "Invalid prepare passed: $run_id"; fi
    grep -Fq "$expected" "$TEMP_DIR/prepare-failure.log" || fail "Prepare failure was not bounded: $run_id ($expected)"
    ! grep -Fq 'fixture-secret-never-print' "$TEMP_DIR/prepare-failure.log" || fail 'Prepare failure exposed a secret.'
}

create_partial_prepare_case() {
    local run_id="$1"
    write_prepare_case "$run_id" isolated
    run_prepare_preflight "$run_id" isolated
    FAKE_PREPARE_IDENTITY_MISMATCH_HOST=east expect_prepare_failure 'identity-mismatch' "$run_id" isolated
}

expect_failure() {
    local expected="$1" run_id="$2"
    if run_deploy "$run_id" > "$TEMP_DIR/failure.log" 2>&1; then fail "Invalid preflight passed: $expected"; fi
    grep -Fq "$expected" "$TEMP_DIR/failure.log" || fail "Missing bounded failure: $expected"
    if grep -Fq 'fixture-secret-never-print' "$TEMP_DIR/failure.log" || grep -Fq 'malicious-' "$TEMP_DIR/failure.log"; then
        fail 'Failure output exposed a fixture secret or raw diagnostic.'
    fi
    ! grep -Fq 'raw-docker-secret' "$TEMP_DIR/failure.log" || fail 'Failure output exposed malformed Docker response content.'
}

expect_persistent_invalid() {
    local run_id="$1"
    if PATH="$BIN:$PATH" "$REPO_ROOT/scripts/deploy:environment" preflight --inventory "$INVENTORY" --mode persistent \
      --run-id "$run_id" --state-root "$TEMP_DIR/output/$run_id-state" --evidence-root "$TEMP_DIR/output/$run_id-evidence" \
      > "$TEMP_DIR/failure.log" 2>&1; then fail "Invalid persistent inventory passed: $run_id"; fi
    grep -Fq 'persistent-mode-requires-production-https' "$TEMP_DIR/failure.log" || fail "Persistent rejection was not bounded: $run_id"
}

