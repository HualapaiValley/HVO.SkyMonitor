if FAKE_REGISTRY_MISMATCH_COMPONENT=logicHost run_deploy_mode images images-registry-mismatch isolated > "$TEMP_DIR/images-failure.log" 2>&1; then fail 'Mismatched registry tag was adopted or overwritten.'; fi
