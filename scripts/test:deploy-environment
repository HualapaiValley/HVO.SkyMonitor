# shellcheck disable=SC2016 # Assert literal commands in the captured remote script.
grep -Fq '[[ "$(id -u)" == "$runtime_uid" ]]' "$PREPARE_REMOTE_LOG"
# shellcheck disable=SC2016
grep -Fq 'chmod 700 "$root" "$control"' "$PREPARE_REMOTE_LOG"
# shellcheck disable=SC2016
