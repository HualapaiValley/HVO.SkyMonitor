    : > "$FAKE_HTTP_STATE/$host.sequence-read-failed"; : > "$output"; printf 503; exit 0
  fi
  increment="${FAKE_CONTINUITY_INCREMENT:-}"
  if [[ -z "$increment" && -f "${FAKE_HTTP_STATE:?}/$host.measure-profile" ]]; then
    increment=0
    if [[ -f "$FAKE_HTTP_STATE/$host.measure-running" ]]; then
      stage=; [[ ! -f "$FAKE_HTTP_STATE/$host.measure-stage" ]] || stage="$(<"$FAKE_HTTP_STATE/$host.measure-stage")"
      [[ "$stage" != warmup ]] || increment=1
      [[ "$stage" != measured ]] || increment=10
    fi
  else increment="${increment:-1}"; fi
  [[ ! -f "$count_file" ]] || count=$(( $(<"$count_file") + increment )); printf '%s\n' "$count" > "$count_file"
