  "$TEMP_DIR/output/$deploy_services-state/up-ledger.json" >/dev/null
test "$(<"$TEMP_DIR/remote/$deploy_services-logic/runtime/.hvo-deploy/up-$deploy_services/runtime-secrets/Minio__AccessKey")" = generated-minio-access
