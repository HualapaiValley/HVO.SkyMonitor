  (umask 077; printf '%s' "$helper_cid" > "$cidfile")
  [[ -f "$cidfile" && ! -L "$cidfile" && "$(/usr/bin/stat -c '%h:%a:%s' "$cidfile")" == 1:600:64 ]] || exit 91
  printf '{"id":"%s"}\n' "$helper_cid" > "${FAKE_IMAGE_STATE:?}/container-$helper_cid"
  printf '%s\n' "$helper_cid" > "$FAKE_IMAGE_STATE/helper-last-cid"
  [[ "${FAKE_DOCKER_HELPER_FAIL:-false}" != true ]] || exit 83
  [[ "${FAKE_DOCKER_HELPER_TIMEOUT:-false}" != true ]] || exit 124
  [[ "${FAKE_DOCKER_HELPER_FIND_FAIL:-false}" != true ]] || exit 87
  [[ "${FAKE_DOCKER_HELPER_MOUNTINFO_FAIL:-false}" != true ]] || exit 88
  [[ "${FAKE_DOCKER_HELPER_FOREIGN_UID:-false}" != true ]] || exit 92
  marker="$helper_root/.hvo-deploy/ownership"
  expected_marker="$(printf 'HVO-DEPLOY-ROOT\t1\nmarker\t%s' "$marker_digest")"
  expected_marker_bytes=$((${#expected_marker} + 1))
  [[ -f "$marker" && ! -L "$marker" && "$(/usr/bin/stat -c '%h:%a' "$marker")" == 1:600 &&
     "$(/usr/bin/wc -c < "$marker")" == "$expected_marker_bytes" && "$(/usr/bin/cat "$marker")" == "$expected_marker" ]] || exit 84
  while IFS= read -r -d '' path; do
    [[ "$path" == "$marker" ]] || { [[ -d "$path" && ! -L "$path" ]] || /usr/bin/rm -f -- "$path"; }
  done < <(/usr/bin/find -P "$helper_root" -xdev -depth -mindepth 1 -print0)
  while IFS= read -r -d '' path; do
    if [[ "${FAKE_DOCKER_HELPER_PARTIAL:-false}" == true && "$path" == "$helper_root/application" ]]; then continue; fi
    [[ "$path" == "$helper_root/.hvo-deploy" ]] || /usr/bin/rmdir -- "$path"
  done \
    < <(/usr/bin/find -P "$helper_root" -xdev -depth -mindepth 1 -type d -print0)
  if [[ "${FAKE_DOCKER_HELPER_PARTIAL:-false}" == true ]]; then chmod 700 "$helper_root/application"; exit 92; fi
  rm -f "${FAKE_IMAGE_STATE:?}/container-$helper_cid"
elif [[ "$3" == info ]]; then
  case "${FAKE_DOCKER_INFO_MALFORMED:-}" in
