elif [[ "$3" == run ]]; then
  shift 3
  expected_mount= image= runtime_uid= marker_digest= saw_pull=false saw_rm=false saw_interactive=false saw_network=false saw_readonly=false
  saw_pids=false saw_user=false saw_drop=false saw_dac=false saw_fowner=false saw_security=false saw_entrypoint=false saw_cidfile=false saw_mount=false
  cidfile=
  while (( $# > 0 )); do
    case "$1" in
      --pull) [[ "$2" == never ]]; saw_pull=true; shift 2 ;;
      --rm) saw_rm=true; shift ;;
      --interactive) saw_interactive=true; shift ;;
      --network) [[ "$2" == none ]]; saw_network=true; shift 2 ;;
      --read-only) saw_readonly=true; shift ;;
      --pids-limit) [[ "$2" == 64 ]]; saw_pids=true; shift 2 ;;
      --user) [[ "$2" == 0:0 ]]; saw_user=true; shift 2 ;;
      --cap-drop) [[ "$2" == ALL ]]; saw_drop=true; shift 2 ;;
