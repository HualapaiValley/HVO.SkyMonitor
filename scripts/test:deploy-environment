if [[ "$url" == */api/v1/operations/capture/pause || "$url" == */api/v1/operations/capture/resume ]]; then
  header_path=; for ((i=0; i<${#args[@]}; i++)); do [[ "${args[$i]}" != --header || "${args[$((i+1))]}" != @* ]] || header_path="${args[$((i+1))]#@}"; done
  key=; while IFS= read -r header_line; do [[ "$header_line" != 'Idempotency-Key: '* ]] || key="${header_line#Idempotency-Key: }"; done < "$header_path"
  id_count="$(grep -c '^Idempotency-Key:' "$header_path")"; token_count="$(grep -c '^RequestVerificationToken:' "$header_path")"
  [[ "$id_count" == 1 && "$token_count" == 1 && "$key" =~ ^deploy-(down-[a-z0-9-]+-[a-z0-9-]+-pause-[0-9]+|measure-[a-z0-9-]+-[a-z0-9-]+-[a-z0-9-]+-[0-9]+|smoke-[a-z0-9-]+-[a-z0-9-]+-(resume|pause)-[0-9]+)$ ]] || { : > "$output"; printf 400; exit 0; }
  action="${url##*/}"; desired=Running; [[ "$action" != pause ]] || desired=Paused
  [[ "$action" != pause || "${FAKE_PAUSE_CONFLICT:-false}" != true ]] || { : > "$output"; printf 409; exit 0; }
  host="${FAKE_REMOTE_HOST:?}"
  if [[ "$key" == *-failure-pause-* && "${FAKE_MEASURE_FAILURE_PAUSE_FAIL:-}" == "$host" ]]; then : > "$output"; printf 503; exit 0; fi
  receipt="$FAKE_HTTP_STATE/$host.idempotency.$(printf '%s' "$key" | sha256sum | cut -c1-32).json"
  if [[ -f "$receipt" ]]; then
    jq '.replayed=true' "$receipt" > "$output"
    printf 'control\t%s\t%s\t%s\t%s\ttrue\n' "$header_path" "$key" "$token_count" "$id_count" >> "${FAKE_LOG:?}"
    printf 200; exit 0
  fi
  current=Running; version=0
  [[ ! -f "$FAKE_HTTP_STATE/$host.control-state" ]] || current="$(<"$FAKE_HTTP_STATE/$host.control-state")"
  [[ ! -f "$FAKE_HTTP_STATE/$host.control-version" ]] || version="$(<"$FAKE_HTTP_STATE/$host.control-version")"
  changed=false
  if [[ "$current" != "$desired" ]]; then changed=true; version=$((version+1)); printf '%s\n' "$desired" > "$FAKE_HTTP_STATE/$host.control-state"; printf '%s\n' "$version" > "$FAKE_HTTP_STATE/$host.control-version"; fi
  if [[ "$desired" == Running ]]; then
    stage=measured; [[ "$key" != *-warmup-resume-* ]] || stage=warmup
    printf '%s\n' "$stage" > "$FAKE_HTTP_STATE/$host.measure-stage"; : > "$FAKE_HTTP_STATE/$host.measure-running"
  else
    rm -f "$FAKE_HTTP_STATE/$host.measure-running"
    if [[ "$changed" == true && "${FAKE_MEASURE_EXTRA_CAPTURE:-false}" == true && -f "$FAKE_HTTP_STATE/$host.measure-profile" ]]; then
      count_file="$FAKE_HTTP_STATE/$host.count"; printf '%s\n' "$(( $(<"$count_file") + 1 ))" > "$count_file"
    fi
  fi
  state_value=1; [[ "$desired" != Paused ]] || state_value=3
  jq -cn --argjson state "$state_value" --argjson version "$version" --argjson changed "$changed" \
    '{state:$state,version:$version,changed:$changed,replayed:false,requestedUtc:"2026-08-07T00:00:00Z",completedUtc:"2026-08-07T00:00:00Z"}' > "$receipt"
  cp "$receipt" "$output"
  printf 'control\t%s\t%s\t%s\t%s\tfalse\n' "$header_path" "$key" "$token_count" "$id_count" >> "${FAKE_LOG:?}"
  printf 200; exit 0
fi
if [[ "$url" == */api/v1/operations/schedule/ ]]; then
  host="${FAKE_REMOTE_HOST:?}"; active="$FAKE_HTTP_STATE/$host.schedule-active.json"
  pending='{"schemaVersion":"cameraagent-local-profile-v1","module":{"type":"VirtualSky","options":{}},"rig":{"sensor":{"widthPixels":1936,"heightPixels":1216,"sensorRecipeVersion":"virtual-asi174mm-electron-domain-v2"},"pipeline":{"captureInterval":"00:00:25"}},"processingSteps":[],"schedule":{}}'
  if [[ -f "$active" ]]; then profile="$(jq -c . "$active")"; jq -cn --argjson profile "$profile" '{stateVersion:3,activeRevision:{revisionId:"schedule-pending-v2",revisionNumber:2,profile:$profile},pendingRevision:null}' > "$output"
  else profile='{"schemaVersion":"cameraagent-local-profile-v1","module":{"type":"VirtualSky","options":{}},"rig":{"sensor":{"widthPixels":64}},"processingSteps":[],"schedule":{}}'; jq -cn --argjson profile "$profile" --argjson pending "$pending" '{stateVersion:2,activeRevision:{revisionId:"schedule-active-v1",revisionNumber:1,profile:$profile},pendingRevision:{revisionId:"schedule-pending-v2",revisionNumber:2,source:"file-draft",profile:$pending}}' > "$output"; fi
  printf 200; exit 0
fi
if [[ "$url" == */api/v1/operations/schedule/activate ]]; then
  host="${FAKE_REMOTE_HOST:?}"; printf '%s\n' '{"schemaVersion":"cameraagent-local-profile-v1","module":{"type":"VirtualSky","options":{}},"rig":{"sensor":{"widthPixels":1936,"heightPixels":1216,"sensorRecipeVersion":"virtual-asi174mm-electron-domain-v2"},"pipeline":{"captureInterval":"00:00:25"}},"processingSteps":[],"schedule":{}}' > "$FAKE_HTTP_STATE/$host.schedule-active.json"
  jq -cn --slurpfile profile "$FAKE_HTTP_STATE/$host.schedule-active.json" '{version:3,activeRevision:{revisionId:"schedule-pending-v2",revisionNumber:2,profile:$profile[0]}}' > "$output"
  printf 200; exit 0
fi
if [[ "$url" == */api/v1.0/devices/*/artifacts/*/download-authorizations ]]; then
  [[ "$method" == POST && "$body" == '{"range":null}' && -n "$cookie_jar" ]] || { : > "$output"; printf 400; exit 0; }
  printf 'artifact-download-authorized\n' >> "$cookie_jar"
  jq -cn '{authorizationId:"88888888-8888-8888-8888-888888888888",expiresAtUtc:"2026-08-07T00:05:00Z",contentUri:"/content"}' > "$output"
  printf 200; exit 0
fi
if [[ "$url" == */api/v1.0/devices/*/artifacts/*/content ]]; then
  [[ -n "$cookies" && -f "$cookies" ]] && grep -Fq artifact-download-authorized "$cookies" || { : > "$output"; printf 404; exit 0; }
  if [[ "${FAKE_RETRIEVAL_HASH_MISMATCH:-false}" == true ]]; then printf 'tampered-artifact-content' > "$output"
  elif [[ "$url" == */99999999-9999-9999-9999-999999999999/content ]]; then printf 'R%.0s' {1..6144} > "$output"
  else printf 'fixture-artifact-content' > "$output"; fi
  response_sha="${FAKE_ARTIFACT_SHA:?}"; response_bytes="${FAKE_ARTIFACT_BYTES:?}"
  if [[ "$url" == */99999999-9999-9999-9999-999999999999/content ]]; then response_sha="${FAKE_RAW_ARTIFACT_SHA:?}"; response_bytes=6144; fi
  printf 'HTTP/1.1 200 OK\r\nX-Artifact-SHA256: %s\r\nContent-Length: %s\r\n\r\n' \
    "$response_sha" "$response_bytes" > "$response_headers"
  printf 200; exit 0
fi
if [[ "$url" == */api/internal/devices/recover ]]; then
  device="$(jq -r .deviceId "$body")"; rm -f "${FAKE_HTTP_STATE:?}/$device.active" "${FAKE_HTTP_STATE:?}/$device.active-no-evidence"
  : > "${FAKE_HTTP_STATE:?}/$device.pending"; : > "${FAKE_HTTP_STATE:?}/$device.recovered"
  jq -cn --arg device "$device" '{registrationId:"22222222-2222-2222-2222-222222222222",deviceId:$device,status:"Pending"}' > "$output"
  printf 200; exit 0
fi
if [[ "$url" == */api/internal/devices/continuity/* ]]; then
  continuity_path="${url%%\?*}"; device="${continuity_path##*/}"
  if [[ ! -f "${FAKE_HTTP_STATE:?}/$device.active" ]]; then
    if [[ -f "${FAKE_HTTP_STATE:?}/$device.pending" ]]; then
      jq -cn --arg device "$device" '{registrationId:"22222222-2222-2222-2222-222222222222",deviceId:$device,
        devicePublicId:null,observatoryId:"11111111-1111-1111-1111-111111111111",status:"Pending",issuedAtUtc:"2026-08-07T00:00:00Z",
        expiresAtUtc:"2099-08-07T00:15:00Z",activatedAtUtc:null,currentRigProfileVersion:null,maximumCaptureSequence:null,
        fleetAgentInstanceId:null,maximumHeartbeatSequence:null,lastHeartbeatReceivedAtUtc:null,centralFrameCount:0,centralArtifactCount:0,
        lineageSourceCount:0,completedDerivativeCount:0,latestArtifacts:[],registrations:[{registrationId:"22222222-2222-2222-2222-222222222222",
          status:"Pending",devicePublicId:null,observatoryId:"11111111-1111-1111-1111-111111111111",issuedAtUtc:"2026-08-07T00:00:00Z",
          expiresAtUtc:"2099-08-07T00:15:00Z",activatedAtUtc:null,isAuthoritative:true}]}' > "$output"
      printf 200; exit 0
    fi
    : > "$output"; printf 404; exit 0
  fi
  if [[ -f "${FAKE_HTTP_STATE:?}/$device.active-no-evidence" ]]; then
    jq -cn --arg device "$device" '{registrationId:"22222222-2222-2222-2222-222222222222",deviceId:$device,
      devicePublicId:"33333333-3333-3333-3333-333333333333",observatoryId:"11111111-1111-1111-1111-111111111111",status:"Active",
      issuedAtUtc:"2026-08-07T00:00:00Z",expiresAtUtc:null,activatedAtUtc:"2026-08-07T00:00:00Z",currentRigProfileVersion:1,
      maximumCaptureSequence:null,fleetAgentInstanceId:null,maximumHeartbeatSequence:null,lastHeartbeatReceivedAtUtc:null,
      centralFrameCount:0,centralArtifactCount:0,lineageSourceCount:0,completedDerivativeCount:0,latestArtifacts:[],
      registrations:[{registrationId:"22222222-2222-2222-2222-222222222222",status:"Active",devicePublicId:"33333333-3333-3333-3333-333333333333",
        observatoryId:"11111111-1111-1111-1111-111111111111",issuedAtUtc:"2026-08-07T00:00:00Z",expiresAtUtc:null,
        activatedAtUtc:"2026-08-07T00:00:00Z",isAuthoritative:true}]}' > "$output"
    printf 200; exit 0
  fi
  from="${url#*fromCaptureSequence=}"; [[ "$from" != "$url" ]] || from=0; from="${from%%&*}"
  to="${url#*toCaptureSequence=}"; [[ "$to" != "$url" ]] || to=-1; to="${to%%&*}"
  count_file="${FAKE_HTTP_STATE:?}/$device.central-count"; count=1
  if (( from > 0 )); then
    agent="${device#device-}"; count="$(<"$FAKE_HTTP_STATE/$agent.count")"
  else
    [[ ! -f "$count_file" ]] || count=$(( $(<"$count_file") + 1 )); printf '%s\n' "$count" > "$count_file"
  fi
  window='[]'
  if (( from > 0 && to >= from )); then
    upper=$count; (( upper <= to )) || upper=$to
    lag_marker="$FAKE_HTTP_STATE/$device.${output##*/}.seen"
    if [[ "${FAKE_MEASURE_ASYNC_LAG:-true}" == true && ! -f "$lag_marker" ]]; then : > "$lag_marker"; upper=$((upper-1)); fi
    for ((sequence=from; sequence<=upper; sequence++)); do
      printf -v capture_id '00000000-0000-0000-0000-%012d' "$sequence"
      printf -v raw_id '10000000-0000-0000-0000-%012d' "$sequence"
      printf -v derivative_id '20000000-0000-0000-0000-%012d' "$sequence"
      central_raw_id="$raw_id"; central_raw_sha="$FAKE_RAW_ARTIFACT_SHA"; central_raw_length=6144
      if (( sequence == from )); then
        [[ "${FAKE_MEASURE_RAW_MISMATCH:-}" != id ]] || central_raw_id="30000000-0000-0000-0000-${raw_id##*-}"
        [[ "${FAKE_MEASURE_RAW_MISMATCH:-}" != checksum ]] || central_raw_sha="$(printf 'E%.0s' {1..64})"
        [[ "${FAKE_MEASURE_RAW_MISMATCH:-}" != length ]] || central_raw_length=6145
      fi
      window="$(jq -c --argjson sequence "$sequence" --arg capture "$capture_id" --arg raw "$central_raw_id" --arg derivative "$derivative_id" \
        --arg rawSha "$central_raw_sha" --argjson rawLength "$central_raw_length" --arg derivativeSha "$FAKE_ARTIFACT_SHA" --arg acknowledged "2026-08-07T00:01:00Z" '
        . + [{captureSequence:$sequence,captureId:$capture,artifacts:[
          {artifactId:$raw,role:"Raw",checksumSha256:$rawSha,byteLength:$rawLength,objectState:"Available",objectVerifiedAtUtc:$acknowledged,sources:[],completedDerivativeCount:1},
          {artifactId:$derivative,role:"Preview",checksumSha256:$derivativeSha,objectState:"Available",objectVerifiedAtUtc:null,
           sources:[{artifactId:$raw,checksumSha256:$rawSha}],completedDerivativeCount:0}]}]' <<< "$window")"
    done
  fi
  printf -v acknowledged '2026-08-07T00:01:%02dZ' "$count"
  jq -cn --arg device "$device" --argjson sequence "$count" --arg acknowledged "$acknowledged" --argjson window "$window" '{registrationId:"22222222-2222-2222-2222-222222222222",deviceId:$device,
    devicePublicId:"33333333-3333-3333-3333-333333333333",observatoryId:"11111111-1111-1111-1111-111111111111",status:"Active",
    issuedAtUtc:"2026-08-07T00:00:00Z",expiresAtUtc:null,activatedAtUtc:"2026-08-07T00:00:00Z",currentRigProfileVersion:1,maximumCaptureSequence:$sequence,
    fleetAgentInstanceId:"44444444-4444-4444-4444-444444444444",maximumHeartbeatSequence:$sequence,lastHeartbeatReceivedAtUtc:$acknowledged,
     centralFrameCount:$sequence,centralArtifactCount:($sequence*3),lineageSourceCount:($sequence*2),completedDerivativeCount:($sequence*2),
     currentRigProfileVersion:(if $ENV.FAKE_RIG_PROFILE_MISSING == "true" then null else 1 end),
     currentRigProfileHash:(if $ENV.FAKE_RIG_PROFILE_HASH_MISMATCH == "true" then ("F"*64) else $ENV.FAKE_RIG_HASH end),
    latestArtifacts:[
       {artifactId:"99999999-9999-9999-9999-999999999999",role:"Raw",recipeVersion:"raw-ingress-v1",width:64,height:48,pixelFormat:"Mono16",byteLength:6144,checksumSha256:$ENV.FAKE_RAW_ARTIFACT_SHA,
        objectState:"Available",objectVerifiedAtUtc:$acknowledged,captureSequence:$sequence,recipeName:"RawCapture",recipeSemanticVersion:"1.0.0",
        recipeImplementationVersion:"fixture",sources:[],completedDerivativeCount:0},
       {artifactId:"11111111-1111-1111-1111-111111111111",role:"Preview",recipeVersion:"central-preview-v1",width:null,height:null,pixelFormat:null,byteLength:($ENV.FAKE_ARTIFACT_BYTES|tonumber),checksumSha256:$ENV.FAKE_ARTIFACT_SHA,
        objectState:"Available",objectVerifiedAtUtc:null,captureSequence:$sequence,recipeName:"encoded-preview",recipeSemanticVersion:"1.0.0",
        recipeImplementationVersion:"fixture",sources:[{artifactId:"99999999-9999-9999-9999-999999999999",checksumSha256:$ENV.FAKE_RAW_ARTIFACT_SHA}],completedDerivativeCount:0},
       {artifactId:"77777777-7777-7777-7777-777777777777",role:"Metadata",recipeVersion:"central-image-quality-v1",width:null,height:null,pixelFormat:null,byteLength:128,checksumSha256:("C"*64),
        objectState:"Available",objectVerifiedAtUtc:null,captureSequence:$sequence,recipeName:"image-quality",recipeSemanticVersion:"1.0.0",
          recipeImplementationVersion:"fixture",sources:[{artifactId:"99999999-9999-9999-9999-999999999999",checksumSha256:$ENV.FAKE_RAW_ARTIFACT_SHA}],completedDerivativeCount:0}],captureWindow:$window,
    registrations:[{registrationId:"22222222-2222-2222-2222-222222222222",status:"Active",
      devicePublicId:"33333333-3333-3333-3333-333333333333",observatoryId:"11111111-1111-1111-1111-111111111111",
      issuedAtUtc:"2026-08-07T00:00:00Z",expiresAtUtc:null,activatedAtUtc:"2026-08-07T00:00:00Z",isAuthoritative:true}]}' > "$output"
  printf 200; exit 0
fi
[[ "${FAKE_CURL_ALWAYS_SUCCESS:-false}" == true || "$url" == https://public.example.test:* ]] && exit 0
