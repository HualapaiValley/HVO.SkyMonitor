jq -e '.phaseStatus == "passed"' "$TEMP_DIR/output/prepare-happy-evidence/prepare.json" >/dev/null
cp "$TEMP_DIR/output/prepare-happy-evidence/prepare.json" "$TEMP_DIR/prepare-happy.accepted-evidence"
