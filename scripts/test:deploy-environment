    ! /usr/bin/grep -Fq -- "$bash_only" "$helper_script" || exit 86
  done
  ! /usr/bin/grep -Eq 'chmod[^\n]*[[:space:]]--([[:space:]]|$)' "$helper_script" || exit 90
