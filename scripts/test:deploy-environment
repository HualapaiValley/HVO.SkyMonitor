[[ "${FAKE_CURL_ALWAYS_SUCCESS:-false}" == true || "$url" == https://public.example.test:* ]] && exit 0
exec /usr/bin/curl "$@"
EOF
chmod +x "$REMOTE_BIN/curl"
cat > "$REMOTE_BIN/mv" <<'EOF'
#!/usr/bin/bash
set -euo pipefail
source_path=${*: -2:1}
physical_source=$(/usr/bin/readlink -f -- "$source_path" 2>/dev/null || true)
if [[ -n "${FAKE_PARTIAL_PREPARE_REPLACE_ON_MOVE:-}" && "$physical_source" == "$FAKE_PARTIAL_PREPARE_REPLACE_ON_MOVE" ]]; then
  marker="${FAKE_IMAGE_STATE:?}/partial-prepare-move-replaced"
  if [[ ! -e "$marker" ]]; then
    : > "$marker"
    /usr/bin/mv -- "$physical_source" "$physical_source.race-original"
    /usr/bin/cp -a -- "$physical_source.race-original" "$physical_source"
  fi
fi
exec /usr/bin/mv "$@"
EOF
