  --state-root "$tampered_state" --evidence-root "$tampered_evidence" > "$TEMP_DIR/tampered-upload.log" 2>&1; then
  fail 'A registry path outside the approved private-upload subtree passed validation.'
fi
test -f "$tampered_path"

