if [[ "$url" == */api/internal/deployment/continuity* ]]; then
  host="${FAKE_REMOTE_HOST:?}"; device="device-$host"; state_host="$host"
  requested_device="${url#*/api/internal/devices/continuity/}"; requested_device="${requested_device%%\?*}"
  [[ "$requested_device" != device-* ]] || state_host="${requested_device#device-}"
  count_file="${FAKE_HTTP_STATE:?}/$state_host.count"; count=1
  if [[ "${FAKE_SMOKE_RUNNING_FAILURE:-}" == "$host" && -f "$FAKE_HTTP_STATE/$host.smoke-resumed" ]]; then
    : > "$output"; printf 503; exit 0
  fi
  if [[ "${FAKE_MEASURE_SEQUENCE_READ_FAIL:-}" == "$host" && -f "$FAKE_HTTP_STATE/$host.measure-running" && ! -f "$FAKE_HTTP_STATE/$host.sequence-read-failed" ]]; then
    : > "$FAKE_HTTP_STATE/$host.sequence-read-failed"; : > "$output"; printf 503; exit 0
  fi
  control_state=Paused; [[ ! -f "$FAKE_HTTP_STATE/$state_host.control-state" ]] || control_state="$(<"$FAKE_HTTP_STATE/$state_host.control-state")"
  increment="${FAKE_CONTINUITY_INCREMENT:-}"
  if [[ -z "$increment" && -f "${FAKE_HTTP_STATE:?}/$host.measure-profile" ]]; then
    increment=0
    if [[ -f "$FAKE_HTTP_STATE/$host.measure-running" ]]; then
      stage=; [[ ! -f "$FAKE_HTTP_STATE/$host.measure-stage" ]] || stage="$(<"$FAKE_HTTP_STATE/$host.measure-stage")"
      [[ "$stage" != warmup ]] || increment=1
      [[ "$stage" != measured ]] || increment=10
    fi
  else
    increment=0; [[ "$control_state" != Running ]] || increment=1
  fi
  [[ ! -f "$count_file" ]] || count=$(( $(<"$count_file") + increment )); printf '%s\n' "$count" > "$count_file"
  configured_device="$device"; capture_sequences="$(jq -cn --arg device "$device" --argjson sequence "$count" '[{agentId:$device,lastSequence:$sequence}]')"
  down_continuity_mode="${FAKE_DOWN_CONTINUITY_MODE:-}"
  if [[ "$control_state" == Paused && ( -n "$down_continuity_mode" || -n "${FAKE_DOWN_CONFIG_HASH_DRIFT:-}" ) ]]; then
    down_reads_file="$FAKE_HTTP_STATE/$host.down-continuity-reads"; down_reads=0
    [[ ! -f "$down_reads_file" ]] || down_reads="$(<"$down_reads_file")"
    down_reads=$((down_reads+1)); printf '%s\n' "$down_reads" > "$down_reads_file"
    case "$down_continuity_mode" in
      zero) count=0 ;;
      one) count=1 ;;
      two) count=2 ;;
      mismatch) configured_device="other-device" ;;
      duplicate) capture_sequences="$(jq -cn --arg device "$device" --argjson sequence "$count" '[{agentId:$device,lastSequence:$sequence},{agentId:$device,lastSequence:$sequence}]')" ;;
      change) [[ "$down_reads" -lt 2 ]] || count=$((count+1)) ;;
    esac
    [[ "$down_continuity_mode" == duplicate ]] || capture_sequences="$(jq -cn --arg device "$device" --argjson sequence "$count" '[{agentId:$device,lastSequence:$sequence}]')"
  fi
  printf -v acknowledged '2026-08-07T%02d:%02d:%02dZ' \
    "$(((120 + count) / 3600))" "$((((120 + count) / 60) % 60))" "$(((120 + count) % 60))"
  active_config_sha="$(printf 'B%.0s' {1..64})"; [[ ! -f "${FAKE_HTTP_STATE:?}/$host.active-config-sha" ]] || active_config_sha="$(<"$FAKE_HTTP_STATE/$host.active-config-sha")"
  if [[ "${FAKE_DOWN_CONFIG_HASH_DRIFT:-}" == observations && "${down_reads:-0}" -ge 2 ]] ||
     [[ "${FAKE_DOWN_CONFIG_HASH_DRIFT:-}" == final && "$url" == *downContinuity=*-final-* ]]; then
    active_config_sha="$(printf 'C%.0s' {1..64})"
  fi
  from="${url#*fromCaptureSequence=}"; [[ "$from" != "$url" ]] || from=0; from="${from%%&*}"
  to="${url#*toCaptureSequence=}"; [[ "$to" != "$url" ]] || to=-1; to="${to%%&*}"
  window='[]'
  if (( from > 0 && to >= from )); then
    upper=$count; (( upper <= to )) || upper=$to
    for ((sequence=from; sequence<=upper; sequence++)); do
      printf -v capture_id '00000000-0000-0000-0000-%012d' "$sequence"
      artifact_id=99999999-9999-9999-9999-999999999999
      [[ ! -f "$FAKE_HTTP_STATE/$host.measure-profile" ]] || printf -v artifact_id '10000000-0000-0000-0000-%012d' "$sequence"
      window="$(jq -c --argjson sequence "$sequence" --arg capture "$capture_id" --arg artifact "$artifact_id" --arg checksum "$FAKE_RAW_ARTIFACT_SHA" \
        '. + [{captureSequence:$sequence,captureId:$capture,rawArtifactId:$artifact,rawChecksumSha256:$checksum,rawByteLength:6144,state:"committed"}]' <<< "$window")"
    done
  fi
  jq -cn --arg device "$device" --arg configured "$configured_device" --argjson sequence "$count" --arg acknowledged "$acknowledged" --arg activeConfigSha "$active_config_sha" --argjson window "$window" --argjson captureSequences "$capture_sequences" '{deviceId:$device,configuredAgentId:$configured,isProvisioned:true,
    devicePublicId:"33333333-3333-3333-3333-333333333333",observatoryId:"11111111-1111-1111-1111-111111111111",
    rawPendingCount:0,rawQuarantineCount:0,artifactPendingCount:0,artifactLeasedCount:0,artifactRetryCount:0,artifactQuarantineCount:0,
    fleetPendingCount:0,fleetLeasedCount:0,fleetRetryCount:0,fleetQuarantineCount:0,lastFleetAcknowledgedUtc:$acknowledged,
    durable:{rawIngressDatabaseExists:true,captureSequences:$captureSequences,artifactOutboxDatabaseExists:true,
      artifactOutboxMaximumRecordId:$sequence,artifactOutboxMaximumAuditId:$sequence,fleetDatabaseExists:true,
      fleetAgentInstanceId:"44444444-4444-4444-4444-444444444444",fleetNextSequence:($sequence+1),fleetMaximumSequence:null,
       latestArtifacts:[
         {artifactId:"11111111-1111-1111-1111-111111111111",agentId:$device,role:"Preview",captureSequence:$sequence,
           checksumSha256:$ENV.FAKE_ARTIFACT_SHA,byteLength:($ENV.FAKE_ARTIFACT_BYTES|tonumber),status:"acknowledged"},
          {artifactId:"99999999-9999-9999-9999-999999999999",agentId:$device,role:"Raw",captureSequence:$sequence,
            checksumSha256:$ENV.FAKE_RAW_ARTIFACT_SHA,byteLength:6144,status:"acknowledged"}],captureWindow:$window},
      expectedRigProfileVersion:"fixture-v1",expectedRigProfileHash:$ENV.FAKE_RIG_HASH,activeConfigurationSha256:$activeConfigSha}' > "$output"
  printf 200; exit 0
fi
if [[ "$url" == */api/internal/deployment/measurement/reset ]]; then
  host="${FAKE_REMOTE_HOST:?}"; : > "${FAKE_HTTP_STATE:?}/$host.measurement-reset"
  jq -cn '{status:"reset"}' > "$output"; printf 200; exit 0
