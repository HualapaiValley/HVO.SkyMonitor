    test -d "$TEMP_DIR/remote/$prepared_target/runtime/.hvo-deploy"
    test "$(stat -c %a "$TEMP_DIR/remote/$prepared_target/runtime")" = 700
    test "$(stat -c %u "$TEMP_DIR/remote/$prepared_target/runtime")" = "$(id -u)"
    test "$(stat -c %u "$TEMP_DIR/remote/$prepared_target/runtime/.hvo-deploy")" = "$(id -u)"
    test "$(stat -c %a "$TEMP_DIR/remote/$prepared_target/runtime/.hvo-deploy/ownership")" = 600
    test "$(stat -c %u "$TEMP_DIR/remote/$prepared_target/runtime/.hvo-deploy/ownership")" = "$(id -u)"
