#!/usr/bin/env bash
# Exercise split-host preflight with fake hosts and Docker contexts; no target is mutated.

set -euo pipefail
umask 0022
export LC_ALL=C
export DEPLOY_TEST_POLL_SECONDS=0

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly REPO_ROOT
# The shard inventory is owned by scripts/deploy/shards.json (#875 stage 0) so the
# coordinator, --list-shards, the CLI contract test and the eventual typed runners
# all read one closed list. The manifest is validated before use: an object with
# a non-empty array of unique, lowercase-kebab names, every name backed by an
# `if shard_enabled NAME` block in this file, and every such block named in the
# manifest. A manifest that drifts from the bodies fails here, not at dispatch.
readonly DEPLOY_CONTRACT_SHARD_MANIFEST="$REPO_ROOT/scripts/deploy/shards.json"
load_deploy_contract_shards() {
    local names declared_bodies
    [[ -f "$DEPLOY_CONTRACT_SHARD_MANIFEST" ]] || {
        printf 'Deployment contract shard manifest is missing: %s\n' "$DEPLOY_CONTRACT_SHARD_MANIFEST" >&2
        exit 2
    }
    names="$(jq -r '
        if type != "object" or (.schemaVersion != 1) or (.shards | type) != "array" or (.shards | length) == 0 then
            error("manifest must be an object with schemaVersion 1 and a non-empty shards array")
        elif any(.shards[]; type != "object" or (.name | type) != "string" or (.name | test("^[a-z][a-z0-9-]*$") | not)) then
            error("every shard needs a lowercase-kebab name")
        elif ([.shards[].name] | length) != ([.shards[].name] | unique | length) then
            error("shard names must be unique")
        else .shards[].name end' "$DEPLOY_CONTRACT_SHARD_MANIFEST" 2>&1)" || {
        printf 'Deployment contract shard manifest is invalid: %s\n' "$names" >&2
        exit 2
    }
    mapfile -t DEPLOY_CONTRACT_SHARDS <<< "$names"
    # Order-sensitive on purpose. Serial execution follows the order of the shard
    # bodies in this file, and later bodies consume staging that earlier bodies
    # define, so that order is load-bearing; parallel dispatch follows the manifest.
    # Requiring the two orders to be identical keeps one contract, and makes a
    # reordering edit to either side fail here rather than change scheduling.
    # Each shard body lives in scripts/deploy-contracts/<name>[-part].sh (#875 stage 2)
    # and is sourced from a dispatch line of this exact shape; the dispatch lines are
    # the declaration the manifest is checked against, and every referenced body
    # file must exist so a manifest entry cannot name a shard with nothing behind it.
    declared_bodies="$(grep -oE '^if shard_enabled [a-z][a-z0-9-]*; then \. "\$REPO_ROOT/scripts/deploy-contracts/[a-z0-9-]+\.sh"; fi$' "${BASH_SOURCE[0]}" \
        | awk '{print $3}' | tr -d ';' | awk '!seen[$0]++')" || true
    if [[ "$(printf '%s\n' "${DEPLOY_CONTRACT_SHARDS[@]}")" != "$declared_bodies" ]]; then
        printf 'Deployment contract shard manifest and shard bodies disagree (order matters).\nmanifest: %s\nbodies:   %s\n' \
            "$(printf '%s ' "${DEPLOY_CONTRACT_SHARDS[@]}")" "$(printf '%s ' $declared_bodies)" >&2
        exit 2
    fi
    local body_file
    while IFS= read -r body_file; do
        [[ -f "$REPO_ROOT/$body_file" ]] || {
            printf 'Deployment contract shard body is missing: %s\n' "$body_file" >&2
            exit 2
        }
    done < <(grep -oE '^if shard_enabled [a-z][a-z0-9-]*; then \. "\$REPO_ROOT/scripts/deploy-contracts/[a-z0-9-]+\.sh"; fi$' "${BASH_SOURCE[0]}" \
        | grep -oE 'scripts/deploy-contracts/[a-z0-9-]+\.sh')
    readonly DEPLOY_CONTRACT_SHARDS
}
load_deploy_contract_shards

is_deploy_contract_shard() {
    local candidate="$1" shard
    for shard in "${DEPLOY_CONTRACT_SHARDS[@]}"; do
        [[ "$candidate" != "$shard" ]] || return 0
    done
    return 1
}

run_deploy_contract_shards() {
    local log_base="${DEPLOY_TEST_LOG_DIR:-$REPO_ROOT/TestResults/deployment-contracts}" log_root=''
    local started_at=$SECONDS shard pid status failed_shard='' failed_status=0 now sequence progress_file
    local processor_count max_parallel next_index=0 invocation_prefix invocation_candidate attempt
    local term_grace_seconds="${DEPLOY_TEST_TERM_GRACE_SECONDS:-2}"
    local status_seconds="${DEPLOY_TEST_STATUS_SECONDS:-60}" stall_seconds="${DEPLOY_TEST_STALL_SECONDS:-300}"
    local hard_seconds="${DEPLOY_TEST_HARD_SECONDS:-1800}" next_status_at
    local -A shard_by_pid=()
    local -A started_by_pid=()
    local -A progress_by_pid=()
    local -A progress_at_by_pid=()

    leader_stopped() {
        local leader_pid="$1" state
        [[ ! -r "/proc/$leader_pid/stat" ]] && return 0
        read -r _ _ state _ < "/proc/$leader_pid/stat" || return 0
        [[ "$state" == Z ]]
    }

    wait_for_leader_stop() {
        local leader_pid="$1" poll
        for ((poll=0; poll<50; poll++)); do
            leader_stopped "$leader_pid" && return 0
            sleep 0.1
        done
        return 1
    }

    terminate_running_shards() {
        local cleanup_pid cleanup_shard
        for cleanup_pid in "${!shard_by_pid[@]}"; do
            kill -TERM -- "-$cleanup_pid" 2>/dev/null || true
        done
        sleep "$term_grace_seconds"
        for cleanup_pid in "${!shard_by_pid[@]}"; do
            if kill -0 -- "-$cleanup_pid" 2>/dev/null; then
                kill -KILL -- "-$cleanup_pid" 2>/dev/null || true
            fi
        done
        for cleanup_pid in "${!shard_by_pid[@]}"; do
            cleanup_shard="${shard_by_pid[$cleanup_pid]}"
            if wait_for_leader_stop "$cleanup_pid"; then
                wait "$cleanup_pid" 2>/dev/null || true
            else
                printf 'Shard process group %s did not stop after KILL.\n' "$cleanup_pid" >> "$log_root/$cleanup_shard.log"
                disown "$cleanup_pid" 2>/dev/null || true
            fi
            [[ -e "$log_root/$cleanup_shard.status" ]] ||
                printf 'terminated elapsed_seconds=%s\n' "$((SECONDS - started_at))" > "$log_root/$cleanup_shard.status"
        done
    }

    mark_queued_shards() {
        local queued_reason="$1" queued_index queued_shard
        for ((queued_index=next_index; queued_index<${#DEPLOY_CONTRACT_SHARDS[@]}; queued_index++)); do
            queued_shard="${DEPLOY_CONTRACT_SHARDS[$queued_index]}"
            printf 'not-started elapsed_seconds=%s\n' "$((SECONDS - started_at))" > "$log_root/$queued_shard.status"
            printf 'Shard was not started because %s.\n' "$queued_reason" > "$log_root/$queued_shard.log"
        done
    }

    coordinator_cleanup() {
        trap - INT TERM EXIT
        terminate_running_shards
        mark_queued_shards 'the coordinator stopped'
    }

    start_deploy_contract_shard() {
        local selected_shard="$1" selected_pid
        printf 'sequence=0 checkpoint=started\n' > "$log_root/$selected_shard.progress"
        chmod 600 "$log_root/$selected_shard.progress"
        if [[ "${DEPLOY_TEST_COORDINATOR_FAIL_SHARD:-}" == "$selected_shard" ]]; then
            DEPLOY_TEST_EARLY_FAIL_SHARD="$selected_shard" DEPLOY_TEST_PROCESS_RECORD_DIR="$log_root" \
                setsid --wait "$0" --shard "$selected_shard" > "$log_root/$selected_shard.log" 2>&1 &
        else
            DEPLOY_TEST_PROCESS_RECORD_DIR="$log_root" setsid --wait "$0" --shard "$selected_shard" \
                > "$log_root/$selected_shard.log" 2>&1 &
        fi
        selected_pid=$!
        shard_by_pid[$selected_pid]="$selected_shard"
        started_by_pid[$selected_pid]=$SECONDS
        progress_by_pid[$selected_pid]=0
        progress_at_by_pid[$selected_pid]=$SECONDS
        printf '%s\n' "$selected_pid" > "$log_root/$selected_shard.leader.pid"
        printf 'Deployment contract shard %s started (pid=%s).\n' "$selected_shard" "$selected_pid"
    }

    report_running_shards() {
        local report_pid report_shard output_bytes progress_age output_age output_mtime epoch_now
        now=$SECONDS
        epoch_now="$(date +%s)"
        for report_pid in "${!shard_by_pid[@]}"; do
            report_shard="${shard_by_pid[$report_pid]}"
            output_bytes="$(stat -c %s "$log_root/$report_shard.log" 2>/dev/null || printf 0)"
            output_mtime="$(stat -c %Y "$log_root/$report_shard.log" 2>/dev/null || printf 0)"
            output_age=$(( epoch_now - output_mtime )); (( output_age >= 0 )) || output_age=0
            progress_age=$(( now - progress_at_by_pid[$report_pid] ))
            printf 'Deployment contract status shard=%s elapsed=%ss progress_idle=%ss output_idle=%ss output_bytes=%s checkpoint=%s.\n' \
              "$report_shard" "$(( now - started_by_pid[$report_pid] ))" "$progress_age" "$output_age" "$output_bytes" \
              "$(cut -d= -f3- "$log_root/$report_shard.progress" 2>/dev/null || printf unavailable)"
        done
    }

    if [[ -n "${DEPLOY_TEST_COORDINATOR_FAIL_SHARD:-}" ]] && ! is_deploy_contract_shard "$DEPLOY_TEST_COORDINATOR_FAIL_SHARD"; then
        printf 'Unknown injected deployment contract shard: %s\n' "$DEPLOY_TEST_COORDINATOR_FAIL_SHARD" >&2
        return 2
    fi

    if [[ -n "${DEPLOY_TEST_COORDINATOR_HANG_SHARD:-}" ]] && ! is_deploy_contract_shard "$DEPLOY_TEST_COORDINATOR_HANG_SHARD"; then
        printf 'Unknown injected hanging deployment contract shard: %s\n' "$DEPLOY_TEST_COORDINATOR_HANG_SHARD" >&2
        return 2
    fi
    if [[ -n "${DEPLOY_TEST_COORDINATOR_PROGRESS_SHARD:-}" ]] && ! is_deploy_contract_shard "$DEPLOY_TEST_COORDINATOR_PROGRESS_SHARD"; then
        printf 'Unknown injected progressing deployment contract shard: %s\n' "$DEPLOY_TEST_COORDINATOR_PROGRESS_SHARD" >&2
        return 2
    fi
    if [[ -n "${DEPLOY_TEST_COORDINATOR_FAIL_WITH_DESCENDANT_SHARD:-}" ]] && ! is_deploy_contract_shard "$DEPLOY_TEST_COORDINATOR_FAIL_WITH_DESCENDANT_SHARD"; then
        printf 'Unknown injected descendant-failure deployment contract shard: %s\n' "$DEPLOY_TEST_COORDINATOR_FAIL_WITH_DESCENDANT_SHARD" >&2
        return 2
    fi

    [[ "$term_grace_seconds" =~ ^[1-9]$|^10$ ]] || {
        printf 'DEPLOY_TEST_TERM_GRACE_SECONDS must be an integer from 1 through 10.\n' >&2
        return 2
    }
    for timing in "$status_seconds" "$stall_seconds" "$hard_seconds"; do
        [[ "$timing" =~ ^[1-9][0-9]*$ && ${#timing} -le 5 && "$timing" -le 86400 ]] || {
            printf 'Deployment watchdog intervals must be integers from 1 through 86400 seconds.\n' >&2
            return 2
        }
    done

    if [[ -n "${DEPLOY_TEST_MAX_PARALLEL:-}" ]]; then
        [[ "$DEPLOY_TEST_MAX_PARALLEL" =~ ^[1-8]$ ]] || {
            printf 'DEPLOY_TEST_MAX_PARALLEL must be an integer from 1 through 8.\n' >&2
            return 2
        }
        max_parallel="$DEPLOY_TEST_MAX_PARALLEL"
    else
        processor_count="$(nproc)"
        max_parallel="${#DEPLOY_CONTRACT_SHARDS[@]}"
        (( max_parallel <= processor_count )) || max_parallel="$processor_count"
        (( max_parallel <= 8 )) || max_parallel=8
        (( max_parallel >= 1 )) || max_parallel=1
    fi

    mkdir -p "$log_base"
    if [[ "${GITHUB_RUN_ID:-}" =~ ^[0-9]+$ && "${GITHUB_RUN_ATTEMPT:-}" =~ ^[0-9]+$ ]]; then
        invocation_prefix="github-${GITHUB_RUN_ID}-attempt-${GITHUB_RUN_ATTEMPT}"
    else
        invocation_prefix=local
    fi
    for ((attempt=0; attempt<10; attempt++)); do
        invocation_candidate="$log_base/$invocation_prefix-$(date -u +%Y%m%dT%H%M%S%N)-$$-$RANDOM"
        if mkdir -m 700 "$invocation_candidate" 2>/dev/null; then
            log_root="$invocation_candidate"
            break
        fi
    done
    [[ -n "$log_root" ]] || { printf 'Could not allocate a unique deployment contract log directory.\n' >&2; return 2; }

    printf 'Running %s deployment contract shards with at most %s workers.\n' "${#DEPLOY_CONTRACT_SHARDS[@]}" "$max_parallel"
    trap 'coordinator_cleanup; exit 130' INT
    trap 'coordinator_cleanup; exit 143' TERM
    trap coordinator_cleanup EXIT
    next_status_at=$(( SECONDS + status_seconds ))
    while (( next_index < ${#DEPLOY_CONTRACT_SHARDS[@]} && ${#shard_by_pid[@]} < max_parallel )); do
        start_deploy_contract_shard "${DEPLOY_CONTRACT_SHARDS[$next_index]}"
        ((next_index+=1))
    done
    while (( ${#shard_by_pid[@]} > 0 )); do
        now=$SECONDS
        # Completion wins over deadlines observed in the same polling cycle.
        for pid in "${!shard_by_pid[@]}"; do
            if ! kill -0 "$pid" 2>/dev/null || leader_stopped "$pid"; then
                shard="${shard_by_pid[$pid]}"
                if wait "$pid"; then status=0; else status=$?; fi
                printf '%s elapsed_seconds=%s\n' "$([[ "$status" -eq 0 ]] && printf passed || printf failed)" "$((SECONDS - started_at))" > "$log_root/$shard.status"
                printf 'Deployment contract shard %s %s after %ss.\n' "$shard" "$([[ "$status" -eq 0 ]] && printf completed || printf failed)" "$((SECONDS - started_at))"
                if (( status != 0 )); then failed_shard="$shard"; failed_status=$status; break; fi
                unset 'shard_by_pid[$pid]' 'started_by_pid[$pid]' 'progress_by_pid[$pid]' 'progress_at_by_pid[$pid]'
            fi
        done
        [[ -z "$failed_shard" ]] || break
        while (( next_index < ${#DEPLOY_CONTRACT_SHARDS[@]} && ${#shard_by_pid[@]} < max_parallel )); do
            start_deploy_contract_shard "${DEPLOY_CONTRACT_SHARDS[$next_index]}"
            ((next_index+=1))
        done
        now=$SECONDS
        for pid in "${!shard_by_pid[@]}"; do
            shard="${shard_by_pid[$pid]}"; progress_file="$log_root/$shard.progress"
            sequence="$(sed -n 's/^sequence=\([0-9][0-9]*\) .*/\1/p' "$progress_file" 2>/dev/null || true)"
            if [[ "$sequence" =~ ^[0-9]+$ ]] && (( sequence > progress_by_pid[$pid] )); then
                progress_by_pid[$pid]="$sequence"; progress_at_by_pid[$pid]=$now
            fi
            # A completion after the first sweep is reaped on the next cycle, never classified as a timeout.
            if ! kill -0 "$pid" 2>/dev/null || leader_stopped "$pid"; then continue; fi
            if (( now - started_by_pid[$pid] >= hard_seconds )); then
                failed_shard="$shard"; failed_status=124
                printf 'hard-timeout elapsed_seconds=%s checkpoint=%s\n' "$((now - started_by_pid[$pid]))" \
                  "$(cut -d= -f3- "$progress_file" 2>/dev/null || printf unavailable)" > "$log_root/$shard.status"
                printf 'Deployment contract shard %s exceeded hard timeout after %ss.\n' "$shard" "$((now - started_by_pid[$pid]))" >> "$log_root/$shard.log"
                break 2
            fi
            if (( now - progress_at_by_pid[$pid] >= stall_seconds )); then
                failed_shard="$shard"; failed_status=125
                printf 'stalled elapsed_seconds=%s progress_idle_seconds=%s checkpoint=%s\n' "$((now - started_by_pid[$pid]))" \
                  "$((now - progress_at_by_pid[$pid]))" "$(cut -d= -f3- "$progress_file" 2>/dev/null || printf unavailable)" > "$log_root/$shard.status"
                printf 'Deployment contract shard %s made no semantic progress for %ss.\n' "$shard" "$((now - progress_at_by_pid[$pid]))" >> "$log_root/$shard.log"
                break 2
            fi
        done
        if (( now >= next_status_at )); then report_running_shards; next_status_at=$(( now + status_seconds )); fi
        sleep 1
    done

    if [[ -n "$failed_shard" ]]; then
        terminate_running_shards
        mark_queued_shards 'another shard failed'
        shard_by_pid=()
        trap - INT TERM EXIT
        printf '%s\n' "===== failed deployment contract shard: $failed_shard =====" >&2
        cat "$log_root/$failed_shard.log" >&2
        printf 'Deployment contract shards failed after %ss; logs: %s\n' "$((SECONDS - started_at))" "$log_root" >&2
        return "$failed_status"
    fi

    trap - INT TERM EXIT
    printf 'All deployment contract shards completed in %ss; logs: %s\n' "$((SECONDS - started_at))" "$log_root"
}

SELECTED_SHARD=all
case "${1:-}" in
    '')
        (( $# == 0 )) || { printf 'Unexpected deployment contract arguments.\n' >&2; exit 2; }
        ;;
    --list-shards)
        (( $# == 1 )) || { printf '%s accepts no additional arguments.\n' "$1" >&2; exit 2; }
        printf '%s\n' "${DEPLOY_CONTRACT_SHARDS[@]}"
        exit 0
        ;;
    --parallel)
        (( $# == 1 )) || { printf '%s accepts no additional arguments.\n' "$1" >&2; exit 2; }
        run_deploy_contract_shards
        exit $?
        ;;
    --shard)
        (( $# == 2 )) || { printf '%s requires exactly one shard name.\n' "$1" >&2; exit 2; }
        is_deploy_contract_shard "$2" || { printf 'Unknown deployment contract shard: %s\n' "$2" >&2; exit 2; }
        SELECTED_SHARD="$2"
        ;;
    *)
        printf 'Unknown deployment contract argument: %s\n' "$1" >&2
        exit 2
        ;;
esac
readonly SELECTED_SHARD

deploy_test_checkpoint() {
    local checkpoint="$1" progress_file sequence temporary
    [[ -n "${DEPLOY_TEST_PROCESS_RECORD_DIR:-}" && "$SELECTED_SHARD" != all ]] || return 0
    progress_file="$DEPLOY_TEST_PROCESS_RECORD_DIR/$SELECTED_SHARD.progress"
    sequence="$(sed -n 's/^sequence=\([0-9][0-9]*\) .*/\1/p' "$progress_file" 2>/dev/null || true)"
    [[ "$sequence" =~ ^[0-9]+$ ]] || sequence=0
    temporary="$progress_file.$BASHPID"
    printf 'sequence=%s checkpoint=%s\n' "$((sequence + 1))" "$checkpoint" > "$temporary"
    chmod 600 "$temporary"
    mv -fT -- "$temporary" "$progress_file"
}

if [[ -n "${DEPLOY_TEST_COORDINATOR_PROGRESS_SHARD:-}" && "$DEPLOY_TEST_COORDINATOR_PROGRESS_SHARD" == "$SELECTED_SHARD" ]]; then
    for progress_step in 1 2 3 4; do
        deploy_test_checkpoint "injected-progress-$progress_step"
        sleep 1
    done
    exit 0
fi

if [[ -n "${DEPLOY_TEST_COORDINATOR_FAIL_WITH_DESCENDANT_SHARD:-}" && "$DEPLOY_TEST_COORDINATOR_FAIL_WITH_DESCENDANT_SHARD" == "$SELECTED_SHARD" ]]; then
    bash -c 'trap "" TERM; printf "%s\n" "$BASHPID" > "${DEPLOY_TEST_PROCESS_RECORD_DIR:?}/$1.failed-descendant.pid"; while true; do sleep 60; done' \
      _ "$SELECTED_SHARD" &
    while [[ ! -s "$DEPLOY_TEST_PROCESS_RECORD_DIR/$SELECTED_SHARD.failed-descendant.pid" ]]; do sleep 0.1; done
    printf 'Injected leader failure with descendant for deployment contract shard %s.\n' "$SELECTED_SHARD" >&2
    exit 97
fi

if [[ -n "${DEPLOY_TEST_EARLY_FAIL_SHARD:-}" ]]; then
    [[ "$DEPLOY_TEST_EARLY_FAIL_SHARD" == "$SELECTED_SHARD" ]] || {
        printf 'Invalid deployment contract early-failure request.\n' >&2
        exit 2
    }
    if [[ -n "${DEPLOY_TEST_EARLY_FAIL_DELAY_SECONDS:-}" ]]; then
        [[ "$DEPLOY_TEST_EARLY_FAIL_DELAY_SECONDS" =~ ^[0-9]+([.][0-9]+)?$ ]] || {
            printf 'Invalid deployment contract early-failure delay.\n' >&2
            exit 2
        }
        sleep "$DEPLOY_TEST_EARLY_FAIL_DELAY_SECONDS"
    fi
    printf 'Injected early failure for deployment contract shard %s.\n' "$SELECTED_SHARD" >&2
    exit 97
fi

if [[ -n "${DEPLOY_TEST_COORDINATOR_HANG_SHARD:-}" && "$DEPLOY_TEST_COORDINATOR_HANG_SHARD" == "$SELECTED_SHARD" ]]; then
    [[ -n "${DEPLOY_TEST_PROCESS_RECORD_DIR:-}" && -d "$DEPLOY_TEST_PROCESS_RECORD_DIR" ]] || {
        printf 'Missing deployment contract process-record directory.\n' >&2
        exit 2
    }
    bash -c 'trap "" TERM; printf "%s\n" "$BASHPID" > "${DEPLOY_TEST_PROCESS_RECORD_DIR:?}/$1.descendant.pid"; while true; do
      if [[ "${DEPLOY_TEST_HANG_CHATTER:-false}" == true ]]; then printf "injected activity\n"; sleep 0.2; else sleep 60; fi; done' \
        _ "$SELECTED_SHARD"
    exit 98
fi

shard_enabled() {
    [[ "$SELECTED_SHARD" == all || "$SELECTED_SHARD" == "$1" ]]
}

# `mkdir -m MODE -p a/b/c` applies MODE to the leaf only; intermediates get the umask
# (ShellCheck SC2174). Fixture trees that are meant to be owner-private at every level
# use this instead. Every level it creates is 0700. A level that already exists is set
# to 0700 only when it lies inside TEMP_DIR, which this harness owns; ancestors outside
# it (the system temp root, a caller-supplied parent) are left exactly as found.
make_private_tree() {
    local path level remainder component
    for path in "$@"; do
        level=''
        remainder="$path"
        while [[ -n "$remainder" ]]; do
            component="${remainder%%/*}"
            if [[ "$remainder" == */* ]]; then remainder="${remainder#*/}"; else remainder=''; fi
            if [[ -z "$component" ]]; then
                [[ -n "$level" ]] || level='/'
                continue
            fi
            if [[ "$level" == '' || "$level" == '/' ]]; then level="$level$component"; else level="$level/$component"; fi
            if [[ -d "$level" ]]; then
                [[ "$level" != "$TEMP_DIR" && "$level" != "$TEMP_DIR/"* ]] || chmod 700 "$level"
            else
                mkdir -m 700 "$level"
            fi
        done
    done
}

TEMP_DIR="$(mktemp -d -t hvo-deploy-test.XXXXXX)"
readonly TEMP_DIR
readonly BIN="$TEMP_DIR/bin"
readonly REMOTE_BIN="$TEMP_DIR/remote-bin"
readonly REMOTE_BIN_NO_SS="$TEMP_DIR/remote-bin-no-ss"
readonly REMOTE_BIN_NO_CURL="$TEMP_DIR/remote-bin-no-curl"
readonly REMOTE_BIN_NO_TIMEOUT="$TEMP_DIR/remote-bin-no-timeout"
readonly INVENTORY="$TEMP_DIR/inventory.yml"
readonly BASE_INVENTORY="$TEMP_DIR/inventory.base"
readonly SECRET_FILE="$TEMP_DIR/deploy.env"
readonly LOG="$TEMP_DIR/commands.log"
readonly REMOTE_LOG="$TEMP_DIR/remote-scripts.log"
readonly PREPARE_REMOTE_LOG="$TEMP_DIR/prepare-remote-scripts.log"
REVISION="$(git -C "$REPO_ROOT" rev-parse HEAD)"
readonly REVISION
REAL_STAT="$(command -v stat)"
readonly REAL_STAT
REAL_GREP="$(command -v grep)"
readonly REAL_GREP
REAL_GIT="$(command -v git)"
readonly REAL_GIT
SERVER_PID=""
FIXTURE_REPLACEMENT_PID=""
FIXTURE_REPLACEMENT_STOPPED_PID=""

cleanup() {
    [[ -z "$FIXTURE_REPLACEMENT_STOPPED_PID" ]] || kill -CONT "$FIXTURE_REPLACEMENT_STOPPED_PID" 2>/dev/null || true
    [[ -z "$FIXTURE_REPLACEMENT_PID" ]] || kill "$FIXTURE_REPLACEMENT_PID" 2>/dev/null || true
    if [[ -n "$SERVER_PID" ]]; then
        local cleanup_poll state
        kill "$SERVER_PID" 2>/dev/null || true
        for ((cleanup_poll=0; cleanup_poll<20; cleanup_poll++)); do
            [[ -r "/proc/$SERVER_PID/stat" ]] || break
            read -r _ _ state _ < "/proc/$SERVER_PID/stat" || break
            [[ "$state" == Z ]] && break
            sleep 0.1
        done
        if [[ -r "/proc/$SERVER_PID/stat" ]]; then
            read -r _ _ state _ < "/proc/$SERVER_PID/stat" || state=''
            [[ "$state" == Z ]] || kill -KILL "$SERVER_PID" 2>/dev/null || true
        fi
        wait "$SERVER_PID" 2>/dev/null || true
    fi
    if [[ "${DEPLOY_TEST_KEEP_TEMP:-false}" == true ]]; then
        printf 'Preserved deployment test directory: %s\n' "$TEMP_DIR" >&2
    else
        chmod -R u+w "$TEMP_DIR" 2>/dev/null || true
        rm -rf "$TEMP_DIR"
    fi
}
trap cleanup EXIT
trap 'printf "Deploy environment contract test failed near line %s.\n" "$LINENO" >&2' ERR
