#!/usr/bin/env python3
"""Docker-free contracts for CameraAgent's reproducible image inputs and diagnostics."""
import importlib.util
import hashlib
import io
import json
import os
from pathlib import Path
import subprocess
import tempfile
import tarfile
import unittest
from unittest.mock import patch

ROOT = Path(__file__).resolve().parent.parent


def checker():
    from importlib.machinery import SourceFileLoader
    loader = SourceFileLoader('image_check', str(ROOT / 'scripts/release:check-cameraagent-image'))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


class ImageReproducibility(unittest.TestCase):
    def test_builder_uses_commit_time_not_environment_or_checkout_time(self):
        with tempfile.TemporaryDirectory() as temporary:
            directory = Path(temporary)
            docker = directory / 'docker'
            docker.write_text('#!/usr/bin/env python3\nimport json,sys\nprint(json.dumps(sys.argv[1:]))\n')
            docker.chmod(0o755)
            revision = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
            epoch = subprocess.check_output(['git', 'show', '-s', '--format=%ct', revision], cwd=ROOT, text=True).strip()
            env = dict(os.environ, PATH=f'{directory}:{os.environ["PATH"]}', SOURCE_DATE_EPOCH='123')
            result = subprocess.run(['bash', str(ROOT / 'scripts/build:cameraagent-image'),
                                     '--commit', revision, '--platform', 'linux/amd64'],
                                    env=env, text=True, capture_output=True)
            self.assertEqual(result.returncode, 0, result.stderr)
            args = json.loads(result.stdout)
            self.assertIn(f'SOURCE_DATE_EPOCH={epoch}', args)
            self.assertIn(f'HVO_SOURCE_REVISION={revision}', args)
            self.assertIn('type=docker,rewrite-timestamp=true', args)
            self.assertIn('--provenance=false', args)
            self.assertIn('--sbom=false', args)

    def test_il_publish_normalizes_generated_dates_without_changing_created_label(self):
        with tempfile.TemporaryDirectory() as temporary:
            directory = Path(temporary)
            dotnet = directory / 'dotnet'
            dotnet.write_text('#!/usr/bin/env python3\nimport json,sys\nprint(json.dumps(sys.argv[1:]))\n')
            dotnet.chmod(0o755)
            env = dict(os.environ, PATH=f'{directory}:{os.environ["PATH"]}',
                       SOURCE_DATE_EPOCH='1792576456', HVO_READY_TO_RUN='false', HVO_CREATED='')
            result = subprocess.run(['bash', str(ROOT / 'scripts/release:cameraagent-publish'), 'publish'],
                                    env=env, text=True, capture_output=True)
            self.assertEqual(result.returncode, 0, result.stderr)
            args = json.loads(result.stdout)
            self.assertIn('-p:HvoReleaseCreatedUtc=2026-10-21T09:54:16Z', args)
            self.assertTrue(any(a.startswith('-p:CustomAfterMicrosoftCommonTargets=') for a in args))
            self.assertFalse(any('PublishReadyToRun' in a for a in args))

    def test_every_release_export_rewrites_layer_timestamps(self):
        for name in ('scripts/release:assets', '.github/workflows/release-image.yml', 'scripts/deploy/images.sh',
                     'scripts/test:cameraagent-arm64-ci'):
            with self.subTest(path=name):
                content = (ROOT / name).read_text()
                self.assertIn('--format=%ct', content)
                self.assertIn('SOURCE_DATE_EPOCH=', content)
                self.assertIn('rewrite-timestamp=true', content)

    def test_runtime_package_repository_and_transient_files_are_frozen(self):
        dockerfile = (ROOT / 'src/HVO.SkyMonitor.CameraAgent/Dockerfile').read_text()
        self.assertIn('snapshot.ubuntu.com', dockerfile)
        for path in ('/var/log', '/var/cache/ldconfig/aux-cache', '/var/lib/apt/lists', '/var/lib/dpkg/status-old'):
            self.assertIn(path, dockerfile)

    def test_published_copy_times_are_set_even_when_older_than_commit(self):
        # rewrite-timestamp only clamps newer mtimes. Files copied by publish from a reused checkout can be older.
        dockerfile = (ROOT / 'src/HVO.SkyMonitor.CameraAgent/Dockerfile').read_text()
        self.assertIn('find /app/publish /app/replay-runner -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +', dockerfile)

    def test_checker_reports_config_layers_and_archive_layout_independently(self):
        check = checker()
        first = {'configDigest': 'sha256:a', 'manifestDigest': 'sha256:m1', 'config': {'created': 'first'},
                 'layers': ['a'], 'archiveSha256': 'a', 'entries': {'index.json': ['a', 1]}}
        second = {'configDigest': 'sha256:b', 'manifestDigest': 'sha256:m2', 'config': {'created': 'second'},
                  'layers': ['b'], 'archiveSha256': 'b', 'entries': {'index.json': ['b', 2]}}
        messages = '\n'.join(check.differences(first, second))
        for category in ('config', 'layers', 'archive', 'index.json'):
            self.assertIn(category, messages)
        self.assertEqual(check.differences(first, first), [])

    def test_checker_rejects_archive_only_drift_with_equal_image_id(self):
        check = checker()
        config = b'{"created":"2026-10-21T00:00:00Z","rootfs":{"type":"layers","diff_ids":[]}}'
        digest = hashlib.sha256(config).hexdigest()
        manifest = json.dumps({'config': {'digest': f'sha256:{digest}'}, 'layers': []}).encode()
        manifest_digest = hashlib.sha256(manifest).hexdigest()
        with tempfile.TemporaryDirectory() as temporary:
            reports = []
            for trial in (1, 2):
                path = Path(temporary) / f'{trial}.tar'
                with tarfile.open(path, 'w') as archive:
                    for name, content in {
                            'index.json': json.dumps({'manifests': [{'digest': f'sha256:{manifest_digest}'}]}).encode(),
                            f'blobs/sha256/{digest}': config,
                            f'blobs/sha256/{manifest_digest}': manifest}.items():
                        info = tarfile.TarInfo(name)
                        info.size, info.mtime = len(content), trial
                        archive.addfile(info, io.BytesIO(content))
                reports.append(check.inspect(path))
            self.assertEqual(reports[0]['configDigest'], f'sha256:{digest}')
            self.assertEqual(reports[0]['configDigest'], reports[1]['configDigest'])
            messages = check.differences(*reports)
            self.assertEqual(len(messages), 1)
            self.assertIn('archive bytes/layout differ', messages[0])

    def test_checker_uses_two_uncached_builds_and_retains_both_reports(self):
        check = checker()
        report = {'configDigest': 'sha256:a', 'manifestDigest': 'sha256:m1', 'config': {}, 'layers': [], 'archiveSha256': 'b', 'entries': {}}
        with tempfile.TemporaryDirectory() as temporary:
            evidence = Path(temporary) / 'evidence'
            builds = []

            def build(command, **kwargs):
                builds.append(command)
                output = command[command.index('--output') + 1].split('dest=')[1]
                Path(output).write_bytes(b'archive')

            with patch.object(check.sys, 'argv', ['check', '--platform', 'linux/amd64', '--evidence', str(evidence)]), \
                    patch.object(check.subprocess, 'check_output', side_effect=['x86_64', 'a' * 40, '123']), \
                    patch.object(check.subprocess, 'run', side_effect=build), \
                    patch.object(check, 'inspect', return_value=report), \
                    patch.object(check.sys, 'stdout', io.StringIO()):
                self.assertEqual(check.main(), 0)
            self.assertEqual(len(builds), 2)
            self.assertEqual(builds[0], builds[1])
            self.assertIn('--no-cache', builds[0])
            for trial in (1, 2):
                self.assertTrue((evidence / f'trial-{trial}.oci.tar').is_file())
                self.assertEqual(json.loads((evidence / f'trial-{trial}.json').read_text()), report)


if __name__ == '__main__':
    unittest.main()
