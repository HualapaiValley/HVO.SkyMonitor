#!/usr/bin/env bash
# Report the internal OpenCode server state without changing it.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
readonly REPO_ROOT
# shellcheck source=.devcontainer/opencode-host.conf disable=SC1091
source "$REPO_ROOT/.devcontainer/opencode-host.conf"

readonly TMUX_SESSION="${OPENCODE_TMUX_SESSION:?OPENCODE_TMUX_SESSION is required}"
readonly CONTAINER_PORT="${OPENCODE_CONTAINER_PORT:?OPENCODE_CONTAINER_PORT is required}"
readonly PASSWORD_FILE="${OPENCODE_DATA_DIR:-$HOME/.local/share/opencode}/server-password"

if [[ ! -f /.dockerenv ]]; then
    echo "Run this script inside the devcontainer." >&2
    exit 1
fi
if ! tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    echo "OpenCode internal tmux session '$TMUX_SESSION' is not running."
    exit 1
fi
if [[ "$(tmux show-options -v -t "$TMUX_SESSION" @hvo-opencode-repo 2>/dev/null || true)" != "$REPO_ROOT" ]]; then
    echo "tmux session '$TMUX_SESSION' is not managed for workspace '$REPO_ROOT'." >&2
    exit 1
fi
if [[ ! -s "$PASSWORD_FILE" ]] || [[ "$(curl --silent --output /dev/null --write-out '%{http_code}' --connect-timeout 2 --max-time 5 --user "opencode:$(<"$PASSWORD_FILE")" "http://127.0.0.1:${CONTAINER_PORT}/global/health" 2>/dev/null || true)" != 200 ]]; then
    echo "OpenCode internal tmux session '$TMUX_SESSION' is not healthy." >&2
    exit 1
fi

echo "OpenCode is healthy at http://127.0.0.1:${CONTAINER_PORT}."