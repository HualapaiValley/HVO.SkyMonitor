#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${HVO_PRODUCTION_CATALOG_BUNDLE:-}" || ! -d "$HVO_PRODUCTION_CATALOG_BUNDLE" ]]; then
  printf 'HVO_PRODUCTION_CATALOG_BUNDLE must identify the exact production catalog bundle.\n' >&2
  exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$repo_root/scripts/lib/deployment-installer-qualification.sh"

normalize_image_architecture() {
  case "$1" in
    x86_64 | amd64) printf 'amd64\n' ;;
    aarch64 | arm64) printf 'arm64\n' ;;
    *) return 1 ;;
  esac
}

host_kernel_name="$(uname -s)"
host_machine_architecture="$(uname -m)"
if [[ "$host_kernel_name" != Linux ]]; then
  printf 'The installer campaign requires a native Linux host; uname reported %s.\n' "$host_kernel_name" >&2
  exit 2
fi
if ! host_image_architecture="$(normalize_image_architecture "$host_machine_architecture")"; then
  printf 'Unsupported installer campaign machine architecture: %s.\n' "$host_machine_architecture" >&2
  exit 2
fi
case "$host_image_architecture" in
  amd64) host_cli_runtime=linux-x64 ;;
  arm64) host_cli_runtime=linux-arm64 ;;
esac

hvo_installer_resolve_local_docker_endpoint
docker_server_operating_system="$(docker info --format '{{.OSType}}')"
docker_server_machine_architecture="$(docker info --format '{{.Architecture}}')"
if ! docker_server_image_architecture="$(normalize_image_architecture "$docker_server_machine_architecture")"; then
  printf 'Unsupported Docker server architecture: %s.\n' "$docker_server_machine_architecture" >&2
  exit 2
fi
if [[ "$docker_server_operating_system" != linux ||
      "$docker_server_image_architecture" != "$host_image_architecture" ]]; then
  printf 'Installer qualification requires a native local Linux Docker daemon; host is %s/%s (%s), daemon is %s/%s (%s).\n' \
    "$host_kernel_name" "$host_image_architecture" "$host_machine_architecture" "$docker_server_operating_system" \
    "$docker_server_image_architecture" "$docker_server_machine_architecture" >&2
  exit 2
fi
root="$(mktemp -d "/tmp/hvo-i.XXXXXX")"
publish_root="$root/publish"
archive="$root/cameraagent.tar"
baseline_revision="${HVO_INSTALLER_BASELINE_REVISION:-}"
install_tag="hvo-skymonitor-cameraagent:installer-contract-$$"
candidate_tag=""
variant_base_tag="hvo-skymonitor-cameraagent:installer-variant-base-$$"
routine_tag="hvo-skymonitor-cameraagent:installer-routine-$$"
migrating_tag="hvo-skymonitor-cameraagent:installer-migrating-$$"
port=55415
instance_id="$(tr -d '\n' </proc/sys/kernel/random/uuid)"

cleanup() {
  docker rm --force "hvo-skymonitor-${instance_id//-/}" >/dev/null 2>&1 || true
  docker rm --force "hvo-skymonitor-${instance_id//-/}-replay" >/dev/null 2>&1 || true
  docker network rm "hvo-skymonitor-${instance_id//-/}_default" >/dev/null 2>&1 || true
  for variant_tag in "$migrating_tag" "$routine_tag" "$variant_base_tag"; do
    docker image rm --force "$variant_tag" >/dev/null 2>&1 || true
  done
  docker image rm --force "$install_tag" >/dev/null 2>&1 || true
  if [[ -n "$candidate_tag" ]]; then
    docker image rm --force "$candidate_tag" >/dev/null 2>&1 || true
  fi
  if [[ -n "${loaded_release_image:-}" ]]; then
    docker image rm --force "$loaded_release_image" >/dev/null 2>&1 || true
  fi
  chmod -R u+w "$root" >/dev/null 2>&1 || true
  rm -rf "$root"
}
trap cleanup EXIT

chmod 700 "$root"
owner_socket_path="$root/product/cameraagents/$instance_id/state/identity/owner.sock"
if (( ${#owner_socket_path} > 107 )); then
  printf 'Installer contract root produces an overlong Unix socket path.\n' >&2
  exit 2
fi
source_root=.
if [[ -n "$baseline_revision" ]]; then
  if [[ -n "$(git status --porcelain)" ]]; then
    printf 'HVO_INSTALLER_BASELINE_REVISION requires a clean candidate worktree.\n' >&2
    exit 2
  fi
  baseline_revision="$(git rev-parse --verify "$baseline_revision^{commit}")"
  candidate_revision="$(git rev-parse --verify 'HEAD^{commit}')"
  if [[ "$candidate_revision" = "$baseline_revision" ]]; then
    printf 'The installer candidate revision must differ from its recovery baseline.\n' >&2
    exit 2
  fi
  if ! git merge-base --is-ancestor "$baseline_revision" "$candidate_revision"; then
    printf 'The installer recovery baseline must be an ancestor of the candidate revision.\n' >&2
    exit 2
  fi
  baseline_root="$root/baseline"
  candidate_root="$root/candidate"
  mkdir -m 700 "$baseline_root" "$candidate_root"
  git archive "$baseline_revision" | tar -x -C "$baseline_root"
  git archive "$candidate_revision" | tar -x -C "$candidate_root"
  source_root="$candidate_root"
  install_tag="hvo-skymonitor-cameraagent:installer-baseline-$$"
  candidate_tag="hvo-skymonitor-cameraagent:installer-candidate-$$"
  docker build --build-arg "HVO_SOURCE_REVISION=$baseline_revision" --tag "$install_tag" \
    --file "$baseline_root/src/HVO.SkyMonitor.CameraAgent/Dockerfile" "$baseline_root"
  docker build --build-arg "HVO_SOURCE_REVISION=$candidate_revision" --tag "$candidate_tag" \
    --file "$candidate_root/src/HVO.SkyMonitor.CameraAgent/Dockerfile" "$candidate_root"
  candidate_image_id="$(docker image inspect --format '{{.Id}}' "$candidate_tag")"
  test "$candidate_image_id" != "$(docker image inspect --format '{{.Id}}' "$install_tag")"
  test "$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$install_tag")" = "$baseline_revision"
  test "$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$candidate_tag")" = "$candidate_revision"
  # A development image is given no version, so its version label is empty (#1310).
  test -z "$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "$candidate_tag")"
elif [[ -n "${HVO_INSTALLER_RELEASE_ARCHIVE:-}" ]]; then
  # Install the exact bytes of an image archive an operator receives rather than an image built here, so the
  # lifecycle contract is proved against that artifact.
  test -f "$HVO_INSTALLER_RELEASE_ARCHIVE"
  release_archive=1
else
  docker build --build-arg "HVO_SOURCE_REVISION=$(git rev-parse HEAD)" --tag "$install_tag" \
    --file src/HVO.SkyMonitor.CameraAgent/Dockerfile .
  test -z "$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "$install_tag")"
fi
dotnet restore "$source_root/src/HVO.SkyMonitor.Deployment.Cli/HVO.SkyMonitor.Deployment.Cli.csproj" --runtime "$host_cli_runtime"
dotnet publish "$source_root/src/HVO.SkyMonitor.Deployment.Cli/HVO.SkyMonitor.Deployment.Cli.csproj" \
  --no-restore --configuration Release --runtime "$host_cli_runtime" --output "$publish_root"
if [[ "${release_archive:-0}" == 1 ]]; then
  cp "$HVO_INSTALLER_RELEASE_ARCHIVE" "$archive"
  loaded_reference="$(docker image load --input "$archive" | sed -n 's/^Loaded image ID: //p;s/^Loaded image: //p' | sed -n '1p')"
  test -n "$loaded_reference"
  image_id="$(docker image inspect --format '{{.Id}}' "$loaded_reference")"
  loaded_release_image="$image_id"
else
  image_id="$(docker image inspect --format '{{.Id}}' "$install_tag")"
  docker image save --output "$archive" "$install_tag"
fi
test "$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$image_id")" = \
  "linux/$host_image_architecture"
archive_sha256="$(sha256sum "$archive" | cut -d ' ' -f 1)"
if [[ "${release_archive:-0}" != 1 ]]; then
  docker image rm "$install_tag"
fi

common_arguments=(
  cameraagent install
  --instance-id "$instance_id"
  --friendly-name "Installer Contract Camera"
  --owner-email "installer-contract@example.test"
  --bind-address 127.0.0.1
  --port "$port"
  --product-root "$root/product"
  --catalog-bundle "$HVO_PRODUCTION_CATALOG_BUNDLE"
  --image-ref "$image_id"
  --image-archive "$archive"
  --image-archive-sha256 "$archive_sha256"
  --latitude 35.2
  --longitude -114.1
  --elevation 800
  --time-zone America/Phoenix
  --generate-password
  --replay-profile local-runner
  --json
)

export HVO_INSTALLER_ALLOW_TEST_ROOT=1
"$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" >"$root/first.json"
test "$(jq -er '.instanceId' "$root/first.json")" = "$instance_id"
container="hvo-skymonitor-${instance_id//-/}"
runner_container="$container-replay"
instance_root="$root/product/cameraagents/$instance_id"
identity_root="$instance_root/state/identity"
test "$(jq -er '.healthy' "$root/first.json")" = true
test "$(jq -er '.replayProfile' "$root/first.json")" = LocalRunner
test "$(jq -er '.image.imageId' "$root/first.json")" = "$image_id"
test "$(jq -er '.image.archiveSha256' "$root/first.json")" = "$archive_sha256"
# The image listing the installer reads to prove an imported image removed (#1315 PR-1355-R5 R5-1) has the shape it
# parses on this daemon: one JSON object per line, a full sha256 ID and string Repository, Tag and Digest; and the
# installed image is listed under the ID the installer recorded.
docker image ls --all --digests --no-trunc --format '{{json .}}' >"$root/image-listing.jsonl"
jq -es 'length > 0 and all(.[]; (.ID | type == "string" and test("^sha256:[0-9a-f]{64}$")) and
  ([.Repository, .Tag, .Digest] | all(type == "string" and length > 0)))' "$root/image-listing.jsonl" >/dev/null
jq -es --arg id "$image_id" 'any(.[]; .ID == $id or .Digest == $id)' "$root/image-listing.jsonl" >/dev/null
test "$(docker inspect --format '{{.State.Health.Status}}' "$runner_container")" = healthy
test "$(docker inspect --format '{{.Config.User}}' "$runner_container")" = "$(id -u):$(id -g)"
# The CameraAgent container gets the default 2 CPUs, 4 GiB and 256 PIDs, recorded with the instance as limits no
# operator set; the replay runner keeps its own bounds.
test "$(docker inspect "$container" | jq -er '.[0].HostConfig | "\(.NanoCpus) \(.Memory) \(.PidsLimit)"')" = \
  "2000000000 4294967296 256"
test "$(docker inspect "$runner_container" | jq -er '.[0].HostConfig | "\(.NanoCpus) \(.Memory) \(.PidsLimit)"')" = \
  "500000000 2147483648 64"
jq -e '.resources == {cpus: 2, memoryBytes: 4294967296, pidsLimit: 256, cpusSetByOperator: false, memorySetByOperator: false}' \
  "$instance_root/instance-manifest.json" >/dev/null

docker stop "$container" >/dev/null
"$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" >"$root/rerun.json"
test "$(docker inspect --format '{{.State.Health.Status}}' "$container")" = healthy
test "$(docker inspect --format '{{.State.Health.Status}}' "$runner_container")" = healthy
test "$(jq -er '.installationId' "$root/first.json")" = "$(jq -er '.installationId' "$root/rerun.json")"
test "$(jq -er '.configurationSha256' "$root/first.json")" = "$(jq -er '.configurationSha256' "$root/rerun.json")"
test "$(jq -er '.catalog.databaseSha256' "$root/first.json")" = "$(jq -er '.catalog.databaseSha256' "$root/rerun.json")"

# A re-run that gives a new limit changes it (#1315, install contract section 7): its plan changes nothing, Compose
# recreates the container with the new limit, and the manifest and the test root's install record follow. The same
# answers again change nothing, and a last re-run returns the memory to 4 GiB for the scenarios below.
"$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" --memory 6g --plan >"$root/limits-plan.json"
test "$(jq -er '.outcome' "$root/limits-plan.json")" = Planned
test "$(jq -er '[.plan.items[] | select(.kind == "container")][0].action' "$root/limits-plan.json")" = Change
test "$(docker inspect "$container" | jq -er '.[0].HostConfig.Memory')" = 4294967296
"$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" --memory 6g >"$root/limits.json"
test "$(docker inspect --format '{{.State.Health.Status}}' "$container")" = healthy
test "$(docker inspect "$container" | jq -er '.[0].HostConfig | "\(.NanoCpus) \(.Memory) \(.PidsLimit)"')" = \
  "2000000000 6442450944 256"
jq -e '.resources == {cpus: 2, memoryBytes: 6442450944, pidsLimit: 256, cpusSetByOperator: false, memorySetByOperator: true}' \
  "$instance_root/instance-manifest.json" >/dev/null
jq -e --arg id "$instance_id" '[.instances[] | select(.instanceId == $id)] | length == 1 and .[0].resources.memoryBytes == 6442450944' \
  "$root/product/operations/install.json" >/dev/null
"$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" --memory 6g >"$root/limits-again.json"
jq -e '.plan.summary | startswith("Nothing to change")' "$root/limits-again.json" >/dev/null
"$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" --memory 4g >"$root/limits-back.json"
test "$(docker inspect "$container" | jq -er '.[0].HostConfig.Memory')" = 4294967296

if [[ -n "$baseline_revision" ]]; then
  recovery_state="$root/product/operations/cameraagent-$instance_id.owner-recovery.json"
  lifecycle_state="$root/product/operations/cameraagent-$instance_id.lifecycle.json"
  result_path="$instance_root/state/deployment/installation-result.json"
  lifecycle_header="$root/lifecycle.header"

  owner_status_code() {
    local password_path="$1"
    local evidence_name="$2"
    local login_page="$root/$evidence_name-login.html"
    local cookie_jar="$root/$evidence_name-cookies.txt"
    local login_config="$root/$evidence_name-login.curl"
    local trimmed_password="$root/$evidence_name-password"
    local token_field
    local token

    tr -d '\r\n' <"$password_path" >"$trimmed_password"
    chmod 600 "$trimmed_password"
    curl --silent --show-error --fail --cookie-jar "$cookie_jar" \
      --output "$login_page" "http://127.0.0.1:$port/Account/Login"
    token_field="$(grep -o 'name="__RequestVerificationToken"[^>]*value="[^"]*"' "$login_page")"
    token="${token_field##*value=\"}"
    token="${token%%\"*}"
    test -n "$token"
    {
      printf 'silent\nshow-error\nrequest = "POST"\n'
      printf 'url = "http://127.0.0.1:%s/Account/Login"\n' "$port"
      printf 'cookie = "%s"\ncookie-jar = "%s"\n' "$cookie_jar" "$cookie_jar"
      printf 'output = "%s/%s-login-response.html"\n' "$root" "$evidence_name"
      printf 'data-urlencode = "__RequestVerificationToken=%s"\n' "$token"
      printf 'data-urlencode = "Input.Email=installer-contract@example.test"\n'
      printf 'data-urlencode = "Input.Password@%s"\n' "$trimmed_password"
      printf 'data-urlencode = "Input.RememberMe=false"\n'
      printf 'data-urlencode = "_handler=login"\n'
    } >"$login_config"
    chmod 600 "$login_config"
    curl --config "$login_config"
    curl --silent --show-error --output "$root/$evidence_name-status.json" --write-out '%{http_code}' \
      --cookie "$cookie_jar" "http://127.0.0.1:$port/api/internal/owner-bootstrap/status"
  }

  replace_owner_password() {
    local current_password_path="$1"
    local new_password_path="$2"
    local evidence_name="$3"
    local cookie_jar="$root/$evidence_name-cookies.txt"
    local replacement_page="$root/$evidence_name-replacement.html"
    local replacement_config="$root/$evidence_name-replacement.curl"
    local replacement_headers="$root/$evidence_name-replacement.headers"
    local current_password="$root/$evidence_name-current-password"
    local new_password="$root/$evidence_name-new-password"
    local token_field
    local token

    test "$(owner_status_code "$current_password_path" "$evidence_name")" = 200
    curl --silent --show-error --fail --cookie "$cookie_jar" \
      --output "$replacement_page" "http://127.0.0.1:$port/Account/ReplaceTemporaryPassword"
    token_field="$(grep -o 'name="__RequestVerificationToken"[^>]*value="[^"]*"' "$replacement_page")"
    token="${token_field##*value=\"}"
    token="${token%%\"*}"
    test -n "$token"
    tr -d '\r\n' <"$current_password_path" >"$current_password"
    tr -d '\r\n' <"$new_password_path" >"$new_password"
    chmod 600 "$current_password" "$new_password"
    {
      printf 'silent\nshow-error\nrequest = "POST"\n'
      printf 'url = "http://127.0.0.1:%s/Account/ReplaceTemporaryPassword"\n' "$port"
      printf 'cookie = "%s"\ncookie-jar = "%s"\n' "$cookie_jar" "$cookie_jar"
      printf 'output = "%s/%s-replacement-response.html"\n' "$root" "$evidence_name"
      printf 'dump-header = "%s"\n' "$replacement_headers"
      printf 'data-urlencode = "__RequestVerificationToken=%s"\n' "$token"
      printf 'data-urlencode = "Input.CurrentPassword@%s"\n' "$current_password"
      printf 'data-urlencode = "Input.NewPassword@%s"\n' "$new_password"
      printf 'data-urlencode = "Input.ConfirmPassword@%s"\n' "$new_password"
      printf 'data-urlencode = "_handler=replace-temporary-password"\n'
    } >"$replacement_config"
    chmod 600 "$replacement_config"
    curl --config "$replacement_config"
    grep -Eq '^HTTP/[^ ]+ 30[23]' "$replacement_headers"
  }

  assert_password_replacement_gate() {
    local evidence_name="$1"
    local cookie_jar="$root/$evidence_name-cookies.txt"
    local headers="$root/$evidence_name-gate.headers"
    local status_code

    status_code="$(curl --silent --show-error --output /dev/null --dump-header "$headers" \
      --write-out '%{http_code}' --cookie "$cookie_jar" "http://127.0.0.1:$port/")"
    test "$status_code" = 302
    tr -d '\r' <"$headers" | grep -Ei '^location: /Account/ReplaceTemporaryPassword$' >/dev/null
  }

  owner_session_status_code() {
    local evidence_name="$1"
    curl --silent --show-error --output "$root/$evidence_name-session-status.json" --write-out '%{http_code}' \
      --cookie "$root/$evidence_name-cookies.txt" "http://127.0.0.1:$port/api/internal/owner-bootstrap/status"
  }

  initial_password_path="$(jq -er '.passwordFile' "$root/first.json")"
  owner_ready_password_path="$root/owner-ready-password"
  printf 'Owner-%s-Aa1!\n' "$(tr -d '\n' </proc/sys/kernel/random/uuid)" >"$owner_ready_password_path"
  chmod 600 "$owner_ready_password_path"
  replace_owner_password "$initial_password_path" "$owner_ready_password_path" baseline-bootstrap
  test "$(owner_status_code "$owner_ready_password_path" baseline-owner-ready)" = 200
  test "$(jq -er '.state' "$root/baseline-owner-ready-status.json")" = owner-ready
  "$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" >"$root/owner-ready-rerun.json"
  test "$(jq -er '.installationId' "$root/owner-ready-rerun.json")" = "$(jq -er '.installationId' "$root/first.json")"
  test "$(jq -er '.configurationSha256' "$root/owner-ready-rerun.json")" = "$(jq -er '.configurationSha256' "$root/first.json")"
  test "$(owner_status_code "$owner_ready_password_path" baseline-owner-ready-rerun)" = 200
  test "$(jq -er '.state' "$root/baseline-owner-ready-rerun-status.json")" = owner-ready

  if "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent recover-owner \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --generate-password \
    --json >"$root/baseline-recovery.json" 2>"$root/baseline-recovery-error.json"; then
    printf 'Pre-support CameraAgent unexpectedly accepted owner recovery.\n' >&2
    exit 1
  fi
  test ! -s "$root/baseline-recovery.json"
  test "$(jq -er '.errorCode' "$root/baseline-recovery-error.json")" = recovery-unsupported
  test "$(jq -er '.completed' "$recovery_state")" = false
  recovery_operation_id="$(jq -er '.operationId' "$recovery_state")"
  recovery_password_path="$root/product/operations/owner-recovery/$recovery_operation_id/temporary-password"

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent upgrade \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --image-ref "$candidate_image_id" \
    --no-download \
    --migration-backward-compatible \
    --json >"$root/upgrade.json"
  test "$(jq -er '.outcome' "$root/upgrade.json")" = completed
  test "$(jq -er '.image.imageId' "$root/upgrade.json")" = "$candidate_image_id"
  jq -e '
    (.preMutationContinuity.captureSequence | type) == "number" and
    (.postMutationContinuity.captureSequence | type) == "number" and
    .preMutationContinuity.captureSequence <= .postMutationContinuity.captureSequence
  ' "$lifecycle_state" >/dev/null
  test "$(stat -c '%a' "$identity_root")" = 700
  test "$(stat -c '%a' "$identity_root/owner.sock")" = 600
  test -S "$identity_root/owner.sock"
  test "$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/app/App_Data"}}{{.Source}}|{{.RW}}{{end}}{{end}}' "$container")" = "$identity_root|true"
  test "$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/run/hvo-secrets"}}{{.Source}}|{{.RW}}{{end}}{{end}}' "$container")" = "$root/product/cameraagents/$instance_id/config/secrets|false"

  printf 'X-HVO-Installation-Token: %s\n' \
    "$(<"$root/product/cameraagents/$instance_id/config/lifecycle-control/token")" >"$lifecycle_header"
  chmod 600 "$lifecycle_header"
  curl --silent --show-error --fail --header "@$lifecycle_header" \
    "http://127.0.0.1:$port/api/internal/deployment/lifecycle/state" >"$root/continuity-before.json"
  test "$(jq -er '.captureControl.value.state' "$root/continuity-before.json")" = Running
  test "$(owner_status_code "$owner_ready_password_path" candidate-owner-ready)" = 200
  test "$(jq -er '.state' "$root/candidate-owner-ready-status.json")" = owner-ready
  recovery_runtime_identity="$(docker inspect --format '{{.Id}}|{{.State.StartedAt}}|{{.State.Pid}}' "$container")"

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent recover-owner \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --generate-password \
    --resume \
    --json >"$root/recovery.json"
  test "$(jq -er '.operationId' "$root/recovery.json")" = "$recovery_operation_id"
  test "$(jq -er '.ownerBootstrapState' "$root/recovery.json")" = owner-password-change-required
  test "$(jq -er '.completed' "$recovery_state")" = true
  curl --silent --show-error --fail --header "@$lifecycle_header" \
    "http://127.0.0.1:$port/api/internal/deployment/lifecycle/state" >"$root/continuity-after.json"
  test "$(jq -er '.captureControl.value.state' "$root/continuity-after.json")" = Running
  test "$(jq -er '.captureControl.value.version' "$root/continuity-after.json")" = \
    "$(jq -er '.captureControl.value.version' "$root/continuity-before.json")"
  test "$(jq -er '.captureSequence >= $before' --argjson before "$(jq -er '.captureSequence' "$root/continuity-before.json")" "$root/continuity-after.json")" = true
  test "$(docker inspect --format '{{.Id}}|{{.State.StartedAt}}|{{.State.Pid}}' "$container")" = "$recovery_runtime_identity"
  test "$(owner_session_status_code candidate-owner-ready)" != 200
  test "$(owner_status_code "$owner_ready_password_path" rejected-old-owner)" != 200
  test "$(owner_status_code "$recovery_password_path" recovered-owner)" = 200
  test "$(jq -er '.state' "$root/recovered-owner-status.json")" = owner-password-change-required
  assert_password_replacement_gate recovered-owner
  recovery_identity_sha256="$(
    sqlite3 "$identity_root/cameraagent_identity.db" \
      "SELECT PasswordHash || '|' || SecurityStamp || '|' || COALESCE((SELECT Value FROM AspNetUserTokens WHERE LoginProvider = 'HVO.SkyMonitor.OwnerRecovery' AND Name = 'LastCompletedOperation'), '') FROM AspNetUsers WHERE IsSiteOwner = 1;" |
      sha256sum | cut -d ' ' -f 1
  )"
  test "$(sqlite3 "$identity_root/cameraagent_identity.db" "SELECT COUNT(*) FROM AspNetUserTokens WHERE LoginProvider = 'HVO.SkyMonitor.OwnerRecovery' AND Name = 'LastCompletedOperation' AND Value = '$recovery_operation_id';")" = 1

  docker kill "$container" >/dev/null
  test -S "$identity_root/owner.sock"
  docker start "$container" >/dev/null
  for _ in {1..60}; do
    if [[ "$(docker inspect --format '{{.State.Health.Status}}' "$container")" = healthy ]]; then
      break
    fi
    sleep 1
  done
  test "$(docker inspect --format '{{.State.Health.Status}}' "$container")" = healthy
  test -S "$identity_root/owner.sock"
  test "$(stat -c '%a' "$identity_root/owner.sock")" = 600

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent recover-owner \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --generate-password \
    --resume \
    --json >"$root/restarted-recovery.json"
  test "$(jq -er '.operationId' "$root/restarted-recovery.json")" = "$recovery_operation_id"
  test "$(jq -er '.completed' "$recovery_state")" = true
  test "$(
    sqlite3 "$identity_root/cameraagent_identity.db" \
      "SELECT PasswordHash || '|' || SecurityStamp || '|' || COALESCE((SELECT Value FROM AspNetUserTokens WHERE LoginProvider = 'HVO.SkyMonitor.OwnerRecovery' AND Name = 'LastCompletedOperation'), '') FROM AspNetUsers WHERE IsSiteOwner = 1;" |
      sha256sum | cut -d ' ' -f 1
  )" = "$recovery_identity_sha256"

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent rollback \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --json >"$root/rollback.json"
  test "$(jq -er '.outcome' "$root/rollback.json")" = completed
  test "$(jq -er '.image.imageId' "$root/rollback.json")" = "$image_id"
  jq -e '
    (.preMutationContinuity.captureSequence | type) == "number" and
    (.postMutationContinuity.captureSequence | type) == "number" and
    .preMutationContinuity.captureSequence <= .postMutationContinuity.captureSequence
  ' "$lifecycle_state" >/dev/null
  test ! -e "$identity_root/owner.sock"

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" status \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --json >"$root/final-status.json"
  test "$(jq -er '.image.imageId' "$root/final-status.json")" = "$image_id"
  test "$(jq -er '.running' "$root/final-status.json")" = true
  test "$(jq -er '.healthy' "$root/final-status.json")" = true
  curl --silent --show-error --fail --header "@$lifecycle_header" \
    "http://127.0.0.1:$port/api/internal/deployment/lifecycle/state" >"$root/continuity-rollback.json"
  test "$(jq -er '.captureControl.value.state' "$root/continuity-rollback.json")" = Running
  test "$(jq -er '.captureSequence >= $before' --argjson before "$(jq -er '.captureSequence' "$root/continuity-before.json")" "$root/continuity-rollback.json")" = true
  test "$(owner_status_code "$owner_ready_password_path" rollback-rejected-old-owner)" != 200
  test "$(owner_session_status_code candidate-owner-ready)" != 200
  test "$(owner_status_code "$recovery_password_path" rollback-recovered-owner)" = 200
  test "$(jq -er '.state' "$root/rollback-recovered-owner-status.json")" = owner-password-change-required
  assert_password_replacement_gate rollback-recovered-owner
  test "$(jq -er '.installationId' "$result_path")" = "$(jq -er '.installationId' "$root/first.json")"
  test "$(jq -er '.configurationSha256' "$result_path")" = "$(jq -er '.configurationSha256' "$root/first.json")"
  test "$(jq -er '.catalog.databaseSha256' "$result_path")" = "$(jq -er '.catalog.databaseSha256' "$root/first.json")"

  printf 'Owner recovery upgrade, restart, and rollback contract passed from %s.\n' "$baseline_revision"
fi

"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent preflight \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/preflight.json"
test "$(jq -er '.compatible' "$root/preflight.json")" = true
test "$(jq -er '.outcome' "$root/preflight.json")" = compatible
test "$(jq -er '.instanceId' "$root/preflight.json")" = "$instance_id"
# An installed image that predates the state-compatibility correction declares no boundary, so the report may
# carry the advisory naming that gap. No finding may ever be blocking on a compatible instance.
test "$(jq -er '[.findings[] | select(.blocking)] | length' "$root/preflight.json")" = 0
test "$(jq -er '[.findings[] | select(.code != "candidate-boundaries-undeclared")] | length' "$root/preflight.json")" = 0

for bind_source in identity data-protection provisioning raw archive replay-runner; do
  test -d "$instance_root/state/$bind_source"
  test "$(stat -c '%a' "$instance_root/state/$bind_source")" = 700
  test "$(stat -c '%u:%g' "$instance_root/state/$bind_source")" = "$(id -u):$(id -g)"
done

# Backup and restore (#1353) run as the instance's service account, with no sudo (owner decision 2026-10-18,
# PR-1369-R2). The backup copies the running instance into one archive in <product-root>/backups, with capture paused and
# the container stopped only while it writes, and puts the instance back healthy. The folder and the archive are the
# account's own and owner-only, the record names the archive's bytes, --json reports progress on standard error, and
# nothing under the product root belongs to root.
# Runs the CLI, its standard error going to the file named first, which is shown if the command fails.
logged() {
  local errors="$1"
  shift
  if ! "$@" 2>"$errors"; then
    cat "$errors" >&2
    return 1
  fi
}
logged "$root/backup-events.jsonl" "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent backup \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/backup.json"
test "$(jq -er '.outcome' "$root/backup.json")" = completed
backup_archive="$(jq -er '.backup.archive' "$root/backup.json")"
backup_folder="$root/product/backups"
backup_path="$backup_folder/$backup_archive"
test "$(stat -c '%u:%g %a' "$backup_folder")" = "$(id -u):$(id -g) 700"
test "$(stat -c '%u:%g %a' "$backup_path")" = "$(id -u):$(id -g) 600"
test "$(stat -c '%u:%g %a' "$backup_path.json")" = "$(id -u):$(id -g) 600"
test "$(sha256sum "$backup_path" | cut -d' ' -f1)" = "$(jq -er '.backup.archiveSha256' "$root/backup.json")"
test "$(jq -er '.archiveSha256' "$backup_path.json")" = "$(jq -er '.backup.archiveSha256' "$root/backup.json")"
test "$(jq -er '.runtimeUid' "$backup_path.json"):$(jq -er '.runtimeGid' "$backup_path.json")" = "$(id -u):$(id -g)"
test -z "$(find "$backup_folder" -name '*.partial' -print -quit)"
test -z "$(find "$root/product" -uid 0 -print -quit)"
jq -es 'length > 0 and all(.[]; .event == "backup-progress")' "$root/backup-events.jsonl" >/dev/null
test "$(docker inspect --format '{{.State.Health.Status}}' "$container")" = healthy
test "$(docker inspect --format '{{.State.Health.Status}}' "$runner_container")" = healthy

"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent uninstall \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/reset-uninstall.json"
test "$(jq -er '.outcome' "$root/reset-uninstall.json")" = completed

# The uninstalled instance is restored from the archive, by the same account: its plan changes nothing, the restore leaves
# it uninstalled on the archive's files and databases, every one the account's, and reinstall starts it healthy on them.
# It is then uninstalled again for the reset below.
logged "$root/restore-plan-events.jsonl" "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent restore "$backup_archive" \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --plan \
  --json >"$root/restore-plan.json"
test "$(jq -er '.outcome' "$root/restore-plan.json")" = planned
logged "$root/restore-events.jsonl" "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent restore "$backup_path" \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/restore.json"
test "$(jq -er '.outcome' "$root/restore.json")" = completed
test "$(jq -er '.lifecycleCondition' "$root/restore.json")" = Uninstalled
test "$(jq -er '.restore.archive' "$root/restore.json")" = "$backup_archive"
test "$(jq -er '.restore.noLiveCredentialStore' "$root/restore.json")" = false
test ! -e "$instance_root/.hvo-restore"
test -z "$(find "$root/product" -uid 0 -print -quit)"
test "$(jq -er '.lifecycleCondition' "$instance_root/instance-manifest.json")" = Uninstalled
"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent reinstall \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/restore-reinstall.json"
test "$(jq -er '.outcome' "$root/restore-reinstall.json")" = completed
test "$(docker inspect --format '{{.State.Health.Status}}' "$container")" = healthy
test "$(docker inspect --format '{{.State.Health.Status}}' "$runner_container")" = healthy
"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent uninstall \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/restore-uninstall.json"
test "$(jq -er '.outcome' "$root/restore-uninstall.json")" = completed

if "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent reset-state \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/reset-refused.json" 2>"$root/reset-refused-error.json"; then
  printf 'CameraAgent reset-state accepted an unconfirmed destructive request.\n' >&2
  exit 1
fi
test ! -s "$root/reset-refused.json"
test "$(jq -er '.errorCode' "$root/reset-refused-error.json")" = usage
test -f "$identity_root/cameraagent_identity.db"
# The operator's settings file is the one thing a reset carries across the identity directory's deletion. It is
# edited first, as an operator would, so the carried file can be told apart from a freshly seeded one.
operator_settings_path="$identity_root/appsettings.local.json"
test -f "$operator_settings_path"
jq '.CameraAgent.SkyMap.MaximumObjects = 321' "$operator_settings_path" >"$root/operator-settings-edit.json"
install -m 600 "$root/operator-settings-edit.json" "$operator_settings_path"
operator_settings_sha256="$(sha256sum "$operator_settings_path" | cut -d' ' -f1)"

"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent reset-state \
  --instance-id "$instance_id" \
  --confirm-instance-id "$instance_id" \
  --product-root "$root/product" \
  --dry-run \
  --json >"$root/reset-plan.json"
test "$(jq -er '.outcome' "$root/reset-plan.json")" = planned
test -f "$identity_root/cameraagent_identity.db"
jq -e --arg path "$identity_root" '.deletedPaths | index($path) != null' "$root/reset-plan.json" >/dev/null
jq -e --arg path "$instance_root/instance-manifest.json" '.preservedPaths | index($path) != null' \
  "$root/reset-plan.json" >/dev/null
jq -e --arg path "$operator_settings_path" '.preservedPaths | index($path) != null' "$root/reset-plan.json" >/dev/null

"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent reset-state \
  --instance-id "$instance_id" \
  --confirm-instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/reset.json"
test "$(jq -er '.outcome' "$root/reset.json")" = completed
test ! -e "$identity_root/cameraagent_identity.db"
test ! -e "$instance_root/state/raw/journal/raw-ingress.db"
test "$(jq -er '.deletionCommitted' "$(jq -er '.evidencePath' "$root/reset.json")")" = true
test -f "$instance_root/instance-manifest.json"
test -f "$instance_root/application-identity.json"
test -f "$instance_root/config/camera-module.json"
test -f "$instance_root/config/owner-bootstrap/temporary-password"
test -n "$(ls -A "$instance_root/config/secrets")"
test ! -f "$instance_root/state/deployment/installation-result.json"
test -d "$root/product/catalogs/hyg-v42-production"
for bind_source in identity data-protection provisioning raw archive replay-runner; do
  if [ "$bind_source" = identity ]; then
    test "$(ls -A "$instance_root/state/$bind_source")" = appsettings.local.json
  else
    test -z "$(ls -A "$instance_root/state/$bind_source")"
  fi
  test "$(stat -c '%a' "$instance_root/state/$bind_source")" = 700
done
test "$(sha256sum "$operator_settings_path" | cut -d' ' -f1)" = "$operator_settings_sha256"
test "$(stat -c '%a' "$operator_settings_path")" = 600
test "$(stat -c '%u:%g' "$operator_settings_path")" = "$(id -u):$(id -g)"
# The copy the reset carried the file in is removed once the file is back.
test -z "$(find "$root/product/operations" -maxdepth 1 -name "cameraagent-$instance_id.state-reset-*.appsettings.local.json" -print -quit)"

"$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" >"$root/post-reset.json"
test "$(jq -er '.healthy' "$root/post-reset.json")" = true
test "$(jq -er '.ownerBootstrapState' "$root/post-reset.json")" = owner-password-change-required
test "$(jq -er '.installationId' "$root/post-reset.json")" = "$(jq -er '.installationId' "$root/first.json")"
test "$(jq -er '.applicationIdentity' "$root/post-reset.json")" = "$(jq -er '.applicationIdentity' "$root/first.json")"
test "$(jq -er '.configurationSha256' "$root/post-reset.json")" = "$(jq -er '.configurationSha256' "$root/first.json")"
test -f "$identity_root/cameraagent_identity.db"
sqlite3 "$identity_root/cameraagent_identity.db" \
  "SELECT MigrationId FROM __EFMigrationsHistory;" >"$root/post-reset-identity-migrations.txt"
test "$(wc -l <"$root/post-reset-identity-migrations.txt")" = 1
# Reinstalling after the reset keeps the carried settings instead of seeding a fresh file over them.
test "$(jq -er '.CameraAgent.SkyMap.MaximumObjects' "$operator_settings_path")" = 321

printf 'CameraAgent state preflight and operator-confirmed reset contract passed for instance %s.\n' "$instance_id"

# An upgrade is a swap that never archives state (#1314). Both candidates are the installed image with labels added.
# The routine one declares exactly the installed state boundaries: it upgrades as a pure swap and snapshots nothing.
# The migrating one declares a different minimum compatible revision, a state boundary the persisted-state preflight
# never compares with the instance: it upgrades without --migration-backward-compatible, after the installer has
# snapshotted and verified the real SQLite stores, and a rollback puts that snapshot back under the real container. A
# baseline-revision run may install an image that predates the boundary labels, from which no upgrade is routine.
if [[ -z "$baseline_revision" ]]; then
  lifecycle_state="$root/product/operations/cameraagent-$instance_id.lifecycle.json"
  state_boundary_labels() {
    docker image inspect "$1" | jq -cS '.[0].Config.Labels | with_entries(select(.key | IN(
      "io.hvo.skymonitor.state-compatibility", "io.hvo.skymonitor.minimum-compatible-revision",
      "io.hvo.skymonitor.identity-migration", "io.hvo.skymonitor.raw-ingress-schema",
      "io.hvo.skymonitor.raw-ingress-migration", "io.hvo.skymonitor.catalog-manifest-version")))'
  }
  assert_running_image() {
    local expected="$1" evidence_name="$2"
    "$publish_root/HVO.SkyMonitor.Deployment.Cli" status \
      --instance-id "$instance_id" \
      --product-root "$root/product" \
      --json >"$root/$evidence_name.json"
    # A container running any image other than the manifest's reports outcome "drifted" and still exits zero.
    test "$(jq -er '.outcome' "$root/$evidence_name.json")" = status
    test "$(jq -er '.image.imageId' "$root/$evidence_name.json")" = "$expected"
    test "$(jq -er '.running' "$root/$evidence_name.json")" = true
    test "$(jq -er '.healthy' "$root/$evidence_name.json")" = true
  }
  # Every boundary except the optional raw-ingress migration must be declared, or no upgrade from this image could
  # be routine and the routine case below would prove nothing.
  jq -e '.[0].Config.Labels as $labels | [
      "io.hvo.skymonitor.state-compatibility", "io.hvo.skymonitor.minimum-compatible-revision",
      "io.hvo.skymonitor.identity-migration", "io.hvo.skymonitor.raw-ingress-schema",
      "io.hvo.skymonitor.catalog-manifest-version"
    ] | all(. as $label | ($labels[$label] // "") != "")' <(docker image inspect "$image_id") >/dev/null
  test "$(docker image inspect --format '{{index .Config.Labels "io.hvo.skymonitor.state-compatibility"}}' "$image_id")" = \
    cameraagent-state-v2
  docker image tag "$image_id" "$variant_base_tag"
  printf 'FROM %s\nLABEL io.hvo.skymonitor.installer-campaign=routine-upgrade\n' "$variant_base_tag" |
    docker build --quiet --tag "$routine_tag" - >/dev/null
  printf 'FROM %s\nLABEL io.hvo.skymonitor.installer-campaign=migrating-upgrade io.hvo.skymonitor.minimum-compatible-revision=%s\n' \
    "$variant_base_tag" 0000000000000000000000000000000000000000 |
    docker build --quiet --tag "$migrating_tag" - >/dev/null
  routine_image_id="$(docker image inspect --format '{{.Id}}' "$routine_tag")"
  migrating_image_id="$(docker image inspect --format '{{.Id}}' "$migrating_tag")"
  test "$routine_image_id" != "$image_id"
  test "$migrating_image_id" != "$image_id"
  test "$(state_boundary_labels "$routine_image_id")" = "$(state_boundary_labels "$image_id")"
  test "$(state_boundary_labels "$migrating_image_id")" != "$(state_boundary_labels "$image_id")"

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent upgrade \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --image-ref "$routine_image_id" \
    --no-download \
    --json >"$root/routine-upgrade.json"
  test "$(jq -er '.outcome' "$root/routine-upgrade.json")" = completed
  test "$(jq -er '.image.imageId' "$root/routine-upgrade.json")" = "$routine_image_id"
  assert_running_image "$routine_image_id" routine-upgrade-status

  test "$(jq -er '.stateSnapshotRequired' "$lifecycle_state")" = false
  test "$(jq -er '.stateSnapshot' "$lifecycle_state")" = null
  test "$(jq -er '.previousStateSnapshot' "$instance_root/instance-manifest.json")" = null
  # No lifecycle operation archives the instance any more.
  test -z "$(find "$root/product/operations" -name '*.tar.gz' -print -quit)"

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent upgrade \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --image-ref "$migrating_image_id" \
    --no-download \
    --json >"$root/migrating-upgrade.json" 2>"$root/migrating-upgrade-error.json"
  test "$(jq -er '.outcome' "$root/migrating-upgrade.json")" = completed
  test "$(jq -er '.image.imageId' "$root/migrating-upgrade.json")" = "$migrating_image_id"
  test ! -s "$root/migrating-upgrade-error.json"
  assert_running_image "$migrating_image_id" migrating-upgrade-status
  test "$(jq -er '.stateSnapshotRequired' "$lifecycle_state")" = true
  jq -e '.stateMigration | contains("io.hvo.skymonitor.minimum-compatible-revision installed ")' "$lifecycle_state" >/dev/null
  migration_snapshot="$(jq -cS '.stateSnapshot' "$lifecycle_state")"
  test "$(jq -cS '.previousStateSnapshot' "$instance_root/instance-manifest.json")" = "$migration_snapshot"
  snapshot_root="$root/product/operations/lifecycle/$(jq -er '.operationId' <<<"$migration_snapshot")/state-snapshots/$(jq -er '.snapshotId' <<<"$migration_snapshot")"
  test "$(sha256sum "$snapshot_root/manifest.json" | cut -d ' ' -f 1)" = "$(jq -er '.manifestSha256' <<<"$migration_snapshot")"
  # The real instance had created its Identity database and raw-ingress journal, and each is in the snapshot.
  jq -e '[.databases[] | select(.present) | .relativePath] |
    index("identity/cameraagent_identity.db") != null and index("raw/journal/raw-ingress.db") != null' \
    "$snapshot_root/manifest.json" >/dev/null
  while IFS=$'\t' read -r snapshot_file snapshot_sha256; do
    test "$(sha256sum "$snapshot_root/$snapshot_file" | cut -d ' ' -f 1)" = "$snapshot_sha256"
    test "$(sqlite3 "file:$snapshot_root/$snapshot_file?immutable=1" 'PRAGMA integrity_check;')" = ok
  done < <(jq -er '.databases[] | select(.present) | [.snapshotFile, .sha256] | @tsv' "$snapshot_root/manifest.json")

  # Rollback undoes the migrating upgrade by putting its snapshot back under the real container, and says so first.
  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent rollback \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --json >"$root/migrating-rollback.json" 2>"$root/migrating-rollback-error.json"
  test "$(jq -er '.outcome' "$root/migrating-rollback.json")" = completed
  test "$(jq -er '.image.imageId' "$root/migrating-rollback.json")" = "$routine_image_id"
  test "$(jq -er '.event' "$root/migrating-rollback-error.json")" = state-snapshot-restore
  test "$(jq -cS '.snapshot' "$root/migrating-rollback-error.json")" = "$migration_snapshot"
  assert_running_image "$routine_image_id" migrating-rollback-status
  test "$(jq -cS '.retainedStateSnapshot' "$lifecycle_state")" = "$migration_snapshot"
  test "$(jq -cS '.previousStateSnapshot' "$instance_root/instance-manifest.json")" = "$(jq -cS '.stateSnapshot' "$lifecycle_state")"
  # The restored Identity database carries the snapshot's migration lineage. The restarted image has opened the stores
  # since, so they are compared by content rather than byte for byte.
  identity_snapshot="$(jq -er '.databases[] | select(.relativePath == "identity/cameraagent_identity.db") | .snapshotFile' "$snapshot_root/manifest.json")"
  test "$(sqlite3 "file:$snapshot_root/$identity_snapshot?immutable=1" 'SELECT group_concat(MigrationId) FROM __EFMigrationsHistory;')" = \
    "$(sqlite3 "file:$instance_root/state/identity/cameraagent_identity.db?immutable=1" 'SELECT group_concat(MigrationId) FROM __EFMigrationsHistory;')"

  # A state reset discards the retained snapshot: the documented uninstall, reset-state and install rebuild the manifest
  # without previousStateSnapshot, so a later rollback is a pure swap onto the reinstalled stores and never brings back
  # the databases from before the reset.
  retained_snapshot="$(jq -cS '.previousStateSnapshot' "$instance_root/instance-manifest.json")"
  test "$retained_snapshot" != null
  retained_root="$root/product/operations/lifecycle/$(jq -er '.operationId' <<<"$retained_snapshot")/state-snapshots/$(jq -er '.snapshotId' <<<"$retained_snapshot")"
  retained_identity="$(jq -er '.databases[] | select(.relativePath == "identity/cameraagent_identity.db") | .snapshotFile' "$retained_root/manifest.json")"
  pre_reset_users="$(sqlite3 "file:$retained_root/$retained_identity?immutable=1" 'SELECT group_concat(Id) FROM (SELECT Id FROM AspNetUsers ORDER BY Id);')"
  test -n "$pre_reset_users"
  rollback_target_image_id="$(jq -er '.previousImage.imageId' "$instance_root/instance-manifest.json")"
  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent uninstall \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --json >"$root/swap-reset-uninstall.json"
  test "$(jq -er '.outcome' "$root/swap-reset-uninstall.json")" = completed
  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent reset-state \
    --instance-id "$instance_id" \
    --confirm-instance-id "$instance_id" \
    --product-root "$root/product" \
    --json >"$root/swap-reset.json"
  test "$(jq -er '.outcome' "$root/swap-reset.json")" = completed
  # The reset preserves the manifest, retained snapshot reference included; the install is what clears it. Until
  # then the instance has no installation result, so no lifecycle operation, rollback included, can run on it.
  test "$(jq -cS '.previousStateSnapshot' "$instance_root/instance-manifest.json")" = "$retained_snapshot"
  if "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent rollback \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --json >"$root/reset-rollback-refused.json" 2>"$root/reset-rollback-refused-error.json"; then
    printf 'CameraAgent rollback ran on a reset instance before its reinstall.\n' >&2
    exit 1
  fi
  test ! -e "$identity_root/cameraagent_identity.db"
  "$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" >"$root/swap-post-reset.json"
  test "$(jq -er '.healthy' "$root/swap-post-reset.json")" = true
  test "$(jq -er '.previousStateSnapshot' "$instance_root/instance-manifest.json")" = null
  test "$(jq -er '.previousImage.imageId' "$instance_root/instance-manifest.json")" = "$rollback_target_image_id"
  post_reset_users="$(sqlite3 "file:$identity_root/cameraagent_identity.db?immutable=1" 'SELECT group_concat(Id) FROM (SELECT Id FROM AspNetUsers ORDER BY Id);')"
  test -n "$post_reset_users"
  test "$post_reset_users" != "$pre_reset_users"
  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent rollback \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --json >"$root/post-reset-rollback.json" 2>"$root/post-reset-rollback-error.json"
  test "$(jq -er '.outcome' "$root/post-reset-rollback.json")" = completed
  test "$(jq -er '.image.imageId' "$root/post-reset-rollback.json")" = "$rollback_target_image_id"
  # No restore warning and no snapshot: the rollback swapped images over the reinstalled databases.
  test ! -s "$root/post-reset-rollback-error.json"
  assert_running_image "$rollback_target_image_id" post-reset-rollback-status
  test "$(jq -er '.stateSnapshotRequired' "$lifecycle_state")" = false
  test "$(jq -er '.stateSnapshot' "$lifecycle_state")" = null
  test "$(jq -er '.retainedStateSnapshot' "$lifecycle_state")" = null
  test "$(jq -er '.previousStateSnapshot' "$instance_root/instance-manifest.json")" = null
  test "$(sqlite3 "file:$identity_root/cameraagent_identity.db?immutable=1" 'SELECT group_concat(Id) FROM (SELECT Id FROM AspNetUsers ORDER BY Id);')" = \
    "$post_reset_users"

  printf 'Swap upgrade contract passed for instance %s: routine upgrade snapshots nothing, migrating upgrade snapshots and verifies the real stores, rollback restores them, and a rollback after a state reset and reinstall is a pure swap.\n' \
    "$instance_id"
fi

# A restore keeps the live owner settings (#1353 PR-1369-R2 F14). The startup seeder makes the account
# LocalIdentity__AdminEmail names the site owner. After a purge and a fresh install of the same instance with another
# owner, the live settings name that owner; a backup taken before names the first. Restoring it over the fresh instance
# keeps the live settings and owner email, and reinstalling runs the real seeder on the restored databases, which must
# leave the backup's owner demoted and the live owner the site owner.
backup_owner="installer-contract@example.test"
live_owner="restore-live-owner@example.test"
site_owner() {
  sqlite3 -readonly "$identity_root/cameraagent_identity.db" \
    "SELECT COALESCE(MAX(IsSiteOwner), 'absent') FROM AspNetUsers WHERE NormalizedEmail = upper('$1');"
}
# Fails the campaign with a message, so no step of this contract stops it silently.
owner_contract_fails() {
  printf 'Restore owner settings contract: %s\n' "$1" >&2
  exit 1
}
[[ "$(site_owner "$backup_owner")" == 1 ]] || owner_contract_fails "$backup_owner is not the site owner before the backup."
logged "$root/owner-backup-events.jsonl" "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent backup \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/owner-backup.json"
[[ "$(jq -er '.outcome' "$root/owner-backup.json")" == completed ]] || owner_contract_fails "the backup did not complete."
owner_archive="$(jq -er '.backup.archive' "$root/owner-backup.json")"
"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent uninstall \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/owner-uninstall.json"
[[ "$(jq -er '.outcome' "$root/owner-uninstall.json")" == completed ]] || owner_contract_fails "the uninstall did not complete."
"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent purge \
  --instance-id "$instance_id" \
  --confirm-instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/owner-purge.json"
[[ "$(jq -er '.outcome' "$root/owner-purge.json")" == completed ]] || owner_contract_fails "the purge did not complete."
[[ ! -e "$instance_root" ]] || owner_contract_fails "the purge left the instance root."
[[ -f "$root/product/backups/$owner_archive" ]] || owner_contract_fails "the purge removed the backup."
live_owner_install=("${common_arguments[@]}")
for index in "${!live_owner_install[@]}"; do
  if [[ "${live_owner_install[$index]}" == "$backup_owner" ]]; then live_owner_install[$index]="$live_owner"; fi
done
"$publish_root/HVO.SkyMonitor.Deployment.Cli" "${live_owner_install[@]}" >"$root/owner-install.json"
[[ "$(jq -er '.healthy' "$root/owner-install.json")" == true ]] || owner_contract_fails "the fresh install with $live_owner is not healthy."
[[ "$(site_owner "$live_owner")" == 1 ]] || owner_contract_fails "the fresh install did not make $live_owner the site owner."
"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent uninstall \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/owner-live-uninstall.json"
[[ "$(jq -er '.outcome' "$root/owner-live-uninstall.json")" == completed ]] || owner_contract_fails "the second uninstall did not complete."
logged "$root/owner-restore-events.jsonl" "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent restore "$owner_archive" \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/owner-restore.json"
[[ "$(jq -er '.outcome' "$root/owner-restore.json")" == completed ]] || owner_contract_fails "the restore did not complete."
owner_reinstall_status=0
"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent reinstall \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/owner-reinstall.json" 2>"$root/owner-reinstall-error.json" || owner_reinstall_status=$?
# The real seeder has run on the restored databases once the reinstalled container started, whatever the reinstall's
# own verification then decided.
backup_owner_state="$(site_owner "$backup_owner")"
live_owner_state="$(site_owner "$live_owner")"
if [[ "$backup_owner_state" != 0 ]]; then
  owner_contract_fails "the restore brought back the backup's owner settings: the startup seeder made $backup_owner the site owner again ($backup_owner_state)."
fi
if (( owner_reinstall_status != 0 )); then
  cat "$root/owner-reinstall-error.json" >&2
  printf 'The restore reported: %s\n' "$(jq -c '.warnings' "$root/owner-restore.json")" >&2
  sqlite3 -readonly "$identity_root/cameraagent_identity.db" \
    "SELECT Id, UserName, Email, IsSiteOwner, PasswordHash IS NULL, LockoutEnd FROM AspNetUsers;" >&2 || true
  docker logs --tail 60 "$container" >&2 || true
  owner_contract_fails "the reinstall after the restore failed (exit $owner_reinstall_status; $live_owner is $live_owner_state)."
fi
[[ "$live_owner_state" == 1 ]] || owner_contract_fails "the startup seeder did not make $live_owner the site owner ($live_owner_state)."
[[ "$(jq -er '.outcome' "$root/owner-reinstall.json")" == completed ]] || owner_contract_fails "the reinstall did not complete."
[[ "$(docker inspect --format '{{.State.Health.Status}}' "$container")" == healthy ]] || owner_contract_fails "the reinstalled instance is not healthy."
[[ "$(cat "$instance_root/config/secrets/LocalIdentity__AdminEmail")" == "$live_owner" ]] ||
  owner_contract_fails "LocalIdentity__AdminEmail is not the live owner's."
[[ "$(jq -er '.ownerEmail' "$instance_root/instance-manifest.json")" == "$live_owner" ]] ||
  owner_contract_fails "the instance manifest does not name the live owner."
jq -e '[.warnings[]? | select(.code == "restore-live-owner-settings-kept")] | length == 1' "$root/owner-restore.json" >/dev/null ||
  owner_contract_fails "the restore did not report the owner settings it kept: $(jq -c '.warnings' "$root/owner-restore.json")."
printf 'Restore owner settings contract passed for instance %s: the real seeder kept the backup'"'"'s owner demoted and the live owner the site owner.\n' \
  "$instance_id"

printf 'Disposable offline installer contract passed for instance %s.\n' "$instance_id"
