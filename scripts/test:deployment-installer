#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${HVO_PRODUCTION_CATALOG_BUNDLE:-}" || ! -d "$HVO_PRODUCTION_CATALOG_BUNDLE" ]]; then
  printf 'HVO_PRODUCTION_CATALOG_BUNDLE must identify the exact production catalog bundle.\n' >&2
  exit 2
fi

root="$(mktemp -d "/tmp/hvo-i.XXXXXX")"
publish_root="$root/publish"
archive="$root/cameraagent.tar"
baseline_revision="${HVO_INSTALLER_BASELINE_REVISION:-}"
install_tag="hvo-skymonitor-cameraagent:installer-contract-$$"
candidate_tag=""
port=55415
instance_id="$(tr -d '\n' </proc/sys/kernel/random/uuid)"

cleanup() {
  docker rm --force "hvo-skymonitor-${instance_id//-/}" >/dev/null 2>&1 || true
  docker rm --force "hvo-skymonitor-${instance_id//-/}-replay" >/dev/null 2>&1 || true
  docker network rm "hvo-skymonitor-${instance_id//-/}_default" >/dev/null 2>&1 || true
  if [[ -n "${signed_instance_id:-}" ]]; then
    docker rm --force "hvo-skymonitor-${signed_instance_id//-/}" >/dev/null 2>&1 || true
    docker rm --force "hvo-skymonitor-${signed_instance_id//-/}-replay" >/dev/null 2>&1 || true
    docker network rm "hvo-skymonitor-${signed_instance_id//-/}_default" >/dev/null 2>&1 || true
  fi
  for signed_image in ${signed_loaded_images:-}; do
    docker image rm --force "$signed_image" >/dev/null 2>&1 || true
  done
  for signed_worktree in ${signed_source_worktrees:-}; do
    git worktree remove --force "$signed_worktree" >/dev/null 2>&1 || true
  done
  docker image rm --force "$install_tag" >/dev/null 2>&1 || true
  if [[ -n "$candidate_tag" ]]; then
    docker image rm --force "$candidate_tag" >/dev/null 2>&1 || true
  fi
  if [[ -n "${loaded_release_image:-}" ]]; then
    docker image rm --force "$loaded_release_image" >/dev/null 2>&1 || true
  fi
  chmod -R u+w "$root" >/dev/null 2>&1 || true
  rm -rf "$root"
}
trap cleanup EXIT

chmod 700 "$root"
owner_socket_path="$root/product/cameraagents/$instance_id/state/identity/owner.sock"
if (( ${#owner_socket_path} > 107 )); then
  printf 'Installer contract root produces an overlong Unix socket path.\n' >&2
  exit 2
fi
source_root=.
# Every signed-scenario precondition is checked here rather than after the other scenarios have run, so an
# unusable configuration fails in seconds instead of an hour.
if [[ "${HVO_INSTALLER_SIGNED_RELEASE_CAMPAIGN:-0}" == 1 ]]; then
  if [[ -n "$(git status --porcelain)" ]]; then
    printf 'The signed-release scenario builds its candidates and its CLI from committed revisions; the worktree must be clean.\n' >&2
    exit 2
  fi
  if ! command -v openssl >/dev/null; then
    printf 'The signed-release scenario requires openssl to create its ephemeral signing keys.\n' >&2
    exit 2
  fi
  signed_revision_b="$(git rev-parse --verify "${HVO_INSTALLER_SIGNED_CANDIDATE_REVISION:-HEAD}^{commit}")"
  signed_revision_a="$(git rev-parse --verify "${HVO_INSTALLER_SIGNED_BASE_REVISION:-HEAD~1}^{commit}")"
  if [[ "$signed_revision_a" = "$signed_revision_b" ]]; then
    printf 'The signed upgrade requires two distinct source revisions; set HVO_INSTALLER_SIGNED_BASE_REVISION.\n' >&2
    exit 2
  fi
  if ! git merge-base --is-ancestor "$signed_revision_a" "$signed_revision_b"; then
    printf 'The superseded signed release must be built from an ancestor of the candidate revision.\n' >&2
    exit 2
  fi
  # Both revisions build their own candidate with their own release train, so each manifest describes exactly the
  # tree it was built from rather than relabelling one build as two releases.
  git cat-file -e "$signed_revision_a:scripts/release:cameraagent-image"
  git cat-file -e "$signed_revision_b:scripts/release:cameraagent-image"
  signed_version_a="${HVO_INSTALLER_SIGNED_VERSION_A:-0.0.0-598a}"
  signed_version_b="${HVO_INSTALLER_SIGNED_VERSION_B:-0.0.0-598b}"
  if [[ "$signed_version_a" = "$signed_version_b" ]]; then
    printf 'The two signed candidates must publish distinct release versions.\n' >&2
    exit 2
  fi
fi
if [[ -n "$baseline_revision" ]]; then
  if [[ -n "$(git status --porcelain)" ]]; then
    printf 'HVO_INSTALLER_BASELINE_REVISION requires a clean candidate worktree.\n' >&2
    exit 2
  fi
  baseline_revision="$(git rev-parse --verify "$baseline_revision^{commit}")"
  candidate_revision="$(git rev-parse --verify 'HEAD^{commit}')"
  if [[ "$candidate_revision" = "$baseline_revision" ]]; then
    printf 'The installer candidate revision must differ from its recovery baseline.\n' >&2
    exit 2
  fi
  if ! git merge-base --is-ancestor "$baseline_revision" "$candidate_revision"; then
    printf 'The installer recovery baseline must be an ancestor of the candidate revision.\n' >&2
    exit 2
  fi
  baseline_root="$root/baseline"
  candidate_root="$root/candidate"
  mkdir -m 700 "$baseline_root" "$candidate_root"
  git archive "$baseline_revision" | tar -x -C "$baseline_root"
  git archive "$candidate_revision" | tar -x -C "$candidate_root"
  source_root="$candidate_root"
  install_tag="hvo-skymonitor-cameraagent:installer-baseline-$$"
  candidate_tag="hvo-skymonitor-cameraagent:installer-candidate-$$"
  docker build --build-arg "HVO_SOURCE_REVISION=$baseline_revision" --tag "$install_tag" \
    --file "$baseline_root/src/HVO.SkyMonitor.CameraAgent/Dockerfile" "$baseline_root"
  docker build --build-arg "HVO_SOURCE_REVISION=$candidate_revision" --tag "$candidate_tag" \
    --file "$candidate_root/src/HVO.SkyMonitor.CameraAgent/Dockerfile" "$candidate_root"
  candidate_image_id="$(docker image inspect --format '{{.Id}}' "$candidate_tag")"
  test "$candidate_image_id" != "$(docker image inspect --format '{{.Id}}' "$install_tag")"
  test "$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$install_tag")" = "$baseline_revision"
  test "$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$candidate_tag")" = "$candidate_revision"
elif [[ -n "${HVO_INSTALLER_RELEASE_ARCHIVE:-}" ]]; then
  # Install the exact bytes a signed image release publishes rather than an image built here, so the lifecycle
  # contract is proved against the artifact an operator receives.
  test -f "$HVO_INSTALLER_RELEASE_ARCHIVE"
  release_archive=1
else
  docker build --build-arg "HVO_SOURCE_REVISION=$(git rev-parse HEAD)" --tag "$install_tag" \
    --file src/HVO.SkyMonitor.CameraAgent/Dockerfile .
fi
dotnet restore "$source_root/src/HVO.SkyMonitor.Deployment.Cli/HVO.SkyMonitor.Deployment.Cli.csproj" --runtime linux-x64
dotnet publish "$source_root/src/HVO.SkyMonitor.Deployment.Cli/HVO.SkyMonitor.Deployment.Cli.csproj" \
  --no-restore --configuration Release --runtime linux-x64 --output "$publish_root"
if [[ "${release_archive:-0}" == 1 ]]; then
  cp "$HVO_INSTALLER_RELEASE_ARCHIVE" "$archive"
  loaded_reference="$(docker image load --input "$archive" | sed -n 's/^Loaded image ID: //p;s/^Loaded image: //p' | head -n 1)"
  test -n "$loaded_reference"
  image_id="$(docker image inspect --format '{{.Id}}' "$loaded_reference")"
  loaded_release_image="$image_id"
else
  image_id="$(docker image inspect --format '{{.Id}}' "$install_tag")"
  docker image save --output "$archive" "$install_tag"
fi
archive_sha256="$(sha256sum "$archive" | cut -d ' ' -f 1)"
if [[ "${release_archive:-0}" != 1 ]]; then
  docker image rm "$install_tag"
fi

common_arguments=(
  cameraagent install
  --instance-id "$instance_id"
  --friendly-name "Installer Contract Camera"
  --owner-email "installer-contract@example.test"
  --bind-address 127.0.0.1
  --port "$port"
  --product-root "$root/product"
  --catalog-bundle "$HVO_PRODUCTION_CATALOG_BUNDLE"
  --image-ref "$image_id"
  --image-archive "$archive"
  --image-archive-sha256 "$archive_sha256"
  --latitude 35.2
  --longitude -114.1
  --elevation 800
  --time-zone America/Phoenix
  --generate-password
  --replay-profile local-runner
  --json
)

export HVO_INSTALLER_ALLOW_TEST_ROOT=1
"$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" >"$root/first.json"
test "$(jq -er '.instanceId' "$root/first.json")" = "$instance_id"
container="hvo-skymonitor-${instance_id//-/}"
runner_container="$container-replay"
instance_root="$root/product/cameraagents/$instance_id"
identity_root="$instance_root/state/identity"
test "$(jq -er '.healthy' "$root/first.json")" = true
test "$(jq -er '.replayProfile' "$root/first.json")" = LocalRunner
test "$(jq -er '.image.imageId' "$root/first.json")" = "$image_id"
test "$(jq -er '.image.archiveSha256' "$root/first.json")" = "$archive_sha256"
test "$(docker inspect --format '{{.State.Health.Status}}' "$runner_container")" = healthy
test "$(docker inspect --format '{{.Config.User}}' "$runner_container")" = "$(id -u):$(id -g)"

docker stop "$container" >/dev/null
"$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" >"$root/rerun.json"
test "$(docker inspect --format '{{.State.Health.Status}}' "$container")" = healthy
test "$(docker inspect --format '{{.State.Health.Status}}' "$runner_container")" = healthy
test "$(jq -er '.installationId' "$root/first.json")" = "$(jq -er '.installationId' "$root/rerun.json")"
test "$(jq -er '.configurationSha256' "$root/first.json")" = "$(jq -er '.configurationSha256' "$root/rerun.json")"
test "$(jq -er '.catalog.databaseSha256' "$root/first.json")" = "$(jq -er '.catalog.databaseSha256' "$root/rerun.json")"

if [[ -n "$baseline_revision" ]]; then
  recovery_state="$root/product/operations/cameraagent-$instance_id.owner-recovery.json"
  lifecycle_state="$root/product/operations/cameraagent-$instance_id.lifecycle.json"
  result_path="$instance_root/state/deployment/installation-result.json"
  lifecycle_header="$root/lifecycle.header"

  owner_status_code() {
    local password_path="$1"
    local evidence_name="$2"
    local login_page="$root/$evidence_name-login.html"
    local cookie_jar="$root/$evidence_name-cookies.txt"
    local login_config="$root/$evidence_name-login.curl"
    local trimmed_password="$root/$evidence_name-password"
    local token_field
    local token

    tr -d '\r\n' <"$password_path" >"$trimmed_password"
    chmod 600 "$trimmed_password"
    curl --silent --show-error --fail --cookie-jar "$cookie_jar" \
      --output "$login_page" "http://127.0.0.1:$port/Account/Login"
    token_field="$(grep -o 'name="__RequestVerificationToken"[^>]*value="[^"]*"' "$login_page")"
    token="${token_field##*value=\"}"
    token="${token%%\"*}"
    test -n "$token"
    {
      printf 'silent\nshow-error\nrequest = "POST"\n'
      printf 'url = "http://127.0.0.1:%s/Account/Login"\n' "$port"
      printf 'cookie = "%s"\ncookie-jar = "%s"\n' "$cookie_jar" "$cookie_jar"
      printf 'output = "%s/%s-login-response.html"\n' "$root" "$evidence_name"
      printf 'data-urlencode = "__RequestVerificationToken=%s"\n' "$token"
      printf 'data-urlencode = "Input.Email=installer-contract@example.test"\n'
      printf 'data-urlencode = "Input.Password@%s"\n' "$trimmed_password"
      printf 'data-urlencode = "Input.RememberMe=false"\n'
      printf 'data-urlencode = "_handler=login"\n'
    } >"$login_config"
    chmod 600 "$login_config"
    curl --config "$login_config"
    curl --silent --show-error --output "$root/$evidence_name-status.json" --write-out '%{http_code}' \
      --cookie "$cookie_jar" "http://127.0.0.1:$port/api/internal/owner-bootstrap/status"
  }

  replace_owner_password() {
    local current_password_path="$1"
    local new_password_path="$2"
    local evidence_name="$3"
    local cookie_jar="$root/$evidence_name-cookies.txt"
    local replacement_page="$root/$evidence_name-replacement.html"
    local replacement_config="$root/$evidence_name-replacement.curl"
    local replacement_headers="$root/$evidence_name-replacement.headers"
    local current_password="$root/$evidence_name-current-password"
    local new_password="$root/$evidence_name-new-password"
    local token_field
    local token

    test "$(owner_status_code "$current_password_path" "$evidence_name")" = 200
    curl --silent --show-error --fail --cookie "$cookie_jar" \
      --output "$replacement_page" "http://127.0.0.1:$port/Account/ReplaceTemporaryPassword"
    token_field="$(grep -o 'name="__RequestVerificationToken"[^>]*value="[^"]*"' "$replacement_page")"
    token="${token_field##*value=\"}"
    token="${token%%\"*}"
    test -n "$token"
    tr -d '\r\n' <"$current_password_path" >"$current_password"
    tr -d '\r\n' <"$new_password_path" >"$new_password"
    chmod 600 "$current_password" "$new_password"
    {
      printf 'silent\nshow-error\nrequest = "POST"\n'
      printf 'url = "http://127.0.0.1:%s/Account/ReplaceTemporaryPassword"\n' "$port"
      printf 'cookie = "%s"\ncookie-jar = "%s"\n' "$cookie_jar" "$cookie_jar"
      printf 'output = "%s/%s-replacement-response.html"\n' "$root" "$evidence_name"
      printf 'dump-header = "%s"\n' "$replacement_headers"
      printf 'data-urlencode = "__RequestVerificationToken=%s"\n' "$token"
      printf 'data-urlencode = "Input.CurrentPassword@%s"\n' "$current_password"
      printf 'data-urlencode = "Input.NewPassword@%s"\n' "$new_password"
      printf 'data-urlencode = "Input.ConfirmPassword@%s"\n' "$new_password"
      printf 'data-urlencode = "_handler=replace-temporary-password"\n'
    } >"$replacement_config"
    chmod 600 "$replacement_config"
    curl --config "$replacement_config"
    grep -Eq '^HTTP/[^ ]+ 30[23]' "$replacement_headers"
  }

  assert_password_replacement_gate() {
    local evidence_name="$1"
    local cookie_jar="$root/$evidence_name-cookies.txt"
    local headers="$root/$evidence_name-gate.headers"
    local status_code

    status_code="$(curl --silent --show-error --output /dev/null --dump-header "$headers" \
      --write-out '%{http_code}' --cookie "$cookie_jar" "http://127.0.0.1:$port/")"
    test "$status_code" = 302
    tr -d '\r' <"$headers" | grep -Eqi '^location: /Account/ReplaceTemporaryPassword$'
  }

  owner_session_status_code() {
    local evidence_name="$1"
    curl --silent --show-error --output "$root/$evidence_name-session-status.json" --write-out '%{http_code}' \
      --cookie "$root/$evidence_name-cookies.txt" "http://127.0.0.1:$port/api/internal/owner-bootstrap/status"
  }

  initial_password_path="$(jq -er '.passwordFile' "$root/first.json")"
  owner_ready_password_path="$root/owner-ready-password"
  printf 'Owner-%s-Aa1!\n' "$(tr -d '\n' </proc/sys/kernel/random/uuid)" >"$owner_ready_password_path"
  chmod 600 "$owner_ready_password_path"
  replace_owner_password "$initial_password_path" "$owner_ready_password_path" baseline-bootstrap
  test "$(owner_status_code "$owner_ready_password_path" baseline-owner-ready)" = 200
  test "$(jq -er '.state' "$root/baseline-owner-ready-status.json")" = owner-ready
  "$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" >"$root/owner-ready-rerun.json"
  test "$(jq -er '.installationId' "$root/owner-ready-rerun.json")" = "$(jq -er '.installationId' "$root/first.json")"
  test "$(jq -er '.configurationSha256' "$root/owner-ready-rerun.json")" = "$(jq -er '.configurationSha256' "$root/first.json")"
  test "$(owner_status_code "$owner_ready_password_path" baseline-owner-ready-rerun)" = 200
  test "$(jq -er '.state' "$root/baseline-owner-ready-rerun-status.json")" = owner-ready

  if "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent recover-owner \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --generate-password \
    --json >"$root/baseline-recovery.json" 2>"$root/baseline-recovery-error.json"; then
    printf 'Pre-support CameraAgent unexpectedly accepted owner recovery.\n' >&2
    exit 1
  fi
  test ! -s "$root/baseline-recovery.json"
  test "$(jq -er '.errorCode' "$root/baseline-recovery-error.json")" = recovery-unsupported
  test "$(jq -er '.completed' "$recovery_state")" = false
  recovery_operation_id="$(jq -er '.operationId' "$recovery_state")"
  recovery_password_path="$root/product/operations/owner-recovery/$recovery_operation_id/temporary-password"

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent upgrade \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --image-ref "$candidate_image_id" \
    --no-download \
    --migration-backward-compatible \
    --json >"$root/upgrade.json"
  test "$(jq -er '.outcome' "$root/upgrade.json")" = completed
  test "$(jq -er '.image.imageId' "$root/upgrade.json")" = "$candidate_image_id"
  jq -e '
    (.preMutationContinuity.captureSequence | type) == "number" and
    (.postMutationContinuity.captureSequence | type) == "number" and
    .preMutationContinuity.captureSequence <= .postMutationContinuity.captureSequence
  ' "$lifecycle_state" >/dev/null
  test "$(stat -c '%a' "$identity_root")" = 700
  test "$(stat -c '%a' "$identity_root/owner.sock")" = 600
  test -S "$identity_root/owner.sock"
  test "$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/app/App_Data"}}{{.Source}}|{{.RW}}{{end}}{{end}}' "$container")" = "$identity_root|true"
  test "$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/run/hvo-secrets"}}{{.Source}}|{{.RW}}{{end}}{{end}}' "$container")" = "$root/product/cameraagents/$instance_id/config/secrets|false"

  printf 'X-HVO-Installation-Token: %s\n' \
    "$(<"$root/product/cameraagents/$instance_id/config/lifecycle-control/token")" >"$lifecycle_header"
  chmod 600 "$lifecycle_header"
  curl --silent --show-error --fail --header "@$lifecycle_header" \
    "http://127.0.0.1:$port/api/internal/deployment/lifecycle/state" >"$root/continuity-before.json"
  test "$(jq -er '.captureControl.value.state' "$root/continuity-before.json")" = Running
  test "$(owner_status_code "$owner_ready_password_path" candidate-owner-ready)" = 200
  test "$(jq -er '.state' "$root/candidate-owner-ready-status.json")" = owner-ready
  recovery_runtime_identity="$(docker inspect --format '{{.Id}}|{{.State.StartedAt}}|{{.State.Pid}}' "$container")"

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent recover-owner \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --generate-password \
    --resume \
    --json >"$root/recovery.json"
  test "$(jq -er '.operationId' "$root/recovery.json")" = "$recovery_operation_id"
  test "$(jq -er '.ownerBootstrapState' "$root/recovery.json")" = owner-password-change-required
  test "$(jq -er '.completed' "$recovery_state")" = true
  curl --silent --show-error --fail --header "@$lifecycle_header" \
    "http://127.0.0.1:$port/api/internal/deployment/lifecycle/state" >"$root/continuity-after.json"
  test "$(jq -er '.captureControl.value.state' "$root/continuity-after.json")" = Running
  test "$(jq -er '.captureControl.value.version' "$root/continuity-after.json")" = \
    "$(jq -er '.captureControl.value.version' "$root/continuity-before.json")"
  test "$(jq -er '.captureSequence >= $before' --argjson before "$(jq -er '.captureSequence' "$root/continuity-before.json")" "$root/continuity-after.json")" = true
  test "$(docker inspect --format '{{.Id}}|{{.State.StartedAt}}|{{.State.Pid}}' "$container")" = "$recovery_runtime_identity"
  test "$(owner_session_status_code candidate-owner-ready)" != 200
  test "$(owner_status_code "$owner_ready_password_path" rejected-old-owner)" != 200
  test "$(owner_status_code "$recovery_password_path" recovered-owner)" = 200
  test "$(jq -er '.state' "$root/recovered-owner-status.json")" = owner-password-change-required
  assert_password_replacement_gate recovered-owner
  recovery_identity_sha256="$(
    sqlite3 "$identity_root/cameraagent_identity.db" \
      "SELECT PasswordHash || '|' || SecurityStamp || '|' || COALESCE((SELECT Value FROM AspNetUserTokens WHERE LoginProvider = 'HVO.SkyMonitor.OwnerRecovery' AND Name = 'LastCompletedOperation'), '') FROM AspNetUsers WHERE IsSiteOwner = 1;" |
      sha256sum | cut -d ' ' -f 1
  )"
  test "$(sqlite3 "$identity_root/cameraagent_identity.db" "SELECT COUNT(*) FROM AspNetUserTokens WHERE LoginProvider = 'HVO.SkyMonitor.OwnerRecovery' AND Name = 'LastCompletedOperation' AND Value = '$recovery_operation_id';")" = 1

  docker kill "$container" >/dev/null
  test -S "$identity_root/owner.sock"
  docker start "$container" >/dev/null
  for _ in {1..60}; do
    if [[ "$(docker inspect --format '{{.State.Health.Status}}' "$container")" = healthy ]]; then
      break
    fi
    sleep 1
  done
  test "$(docker inspect --format '{{.State.Health.Status}}' "$container")" = healthy
  test -S "$identity_root/owner.sock"
  test "$(stat -c '%a' "$identity_root/owner.sock")" = 600

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent recover-owner \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --generate-password \
    --resume \
    --json >"$root/restarted-recovery.json"
  test "$(jq -er '.operationId' "$root/restarted-recovery.json")" = "$recovery_operation_id"
  test "$(jq -er '.completed' "$recovery_state")" = true
  test "$(
    sqlite3 "$identity_root/cameraagent_identity.db" \
      "SELECT PasswordHash || '|' || SecurityStamp || '|' || COALESCE((SELECT Value FROM AspNetUserTokens WHERE LoginProvider = 'HVO.SkyMonitor.OwnerRecovery' AND Name = 'LastCompletedOperation'), '') FROM AspNetUsers WHERE IsSiteOwner = 1;" |
      sha256sum | cut -d ' ' -f 1
  )" = "$recovery_identity_sha256"

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent rollback \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --json >"$root/rollback.json"
  test "$(jq -er '.outcome' "$root/rollback.json")" = completed
  test "$(jq -er '.image.imageId' "$root/rollback.json")" = "$image_id"
  jq -e '
    (.preMutationContinuity.captureSequence | type) == "number" and
    (.postMutationContinuity.captureSequence | type) == "number" and
    .preMutationContinuity.captureSequence <= .postMutationContinuity.captureSequence
  ' "$lifecycle_state" >/dev/null
  test ! -e "$identity_root/owner.sock"

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" status \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --json >"$root/final-status.json"
  test "$(jq -er '.image.imageId' "$root/final-status.json")" = "$image_id"
  test "$(jq -er '.running' "$root/final-status.json")" = true
  test "$(jq -er '.healthy' "$root/final-status.json")" = true
  curl --silent --show-error --fail --header "@$lifecycle_header" \
    "http://127.0.0.1:$port/api/internal/deployment/lifecycle/state" >"$root/continuity-rollback.json"
  test "$(jq -er '.captureControl.value.state' "$root/continuity-rollback.json")" = Running
  test "$(jq -er '.captureSequence >= $before' --argjson before "$(jq -er '.captureSequence' "$root/continuity-before.json")" "$root/continuity-rollback.json")" = true
  test "$(owner_status_code "$owner_ready_password_path" rollback-rejected-old-owner)" != 200
  test "$(owner_session_status_code candidate-owner-ready)" != 200
  test "$(owner_status_code "$recovery_password_path" rollback-recovered-owner)" = 200
  test "$(jq -er '.state' "$root/rollback-recovered-owner-status.json")" = owner-password-change-required
  assert_password_replacement_gate rollback-recovered-owner
  test "$(jq -er '.installationId' "$result_path")" = "$(jq -er '.installationId' "$root/first.json")"
  test "$(jq -er '.configurationSha256' "$result_path")" = "$(jq -er '.configurationSha256' "$root/first.json")"
  test "$(jq -er '.catalog.databaseSha256' "$result_path")" = "$(jq -er '.catalog.databaseSha256' "$root/first.json")"

  printf 'Owner recovery upgrade, restart, and rollback contract passed from %s.\n' "$baseline_revision"
fi

"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent preflight \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/preflight.json"
test "$(jq -er '.compatible' "$root/preflight.json")" = true
test "$(jq -er '.outcome' "$root/preflight.json")" = compatible
test "$(jq -er '.instanceId' "$root/preflight.json")" = "$instance_id"
# An installed image that predates the state-compatibility correction declares no boundary, so the report may
# carry the advisory naming that gap. No finding may ever be blocking on a compatible instance.
test "$(jq -er '[.findings[] | select(.blocking)] | length' "$root/preflight.json")" = 0
test "$(jq -er '[.findings[] | select(.code != "candidate-boundaries-undeclared")] | length' "$root/preflight.json")" = 0

for bind_source in identity data-protection provisioning raw archive replay-runner; do
  test -d "$instance_root/state/$bind_source"
  test "$(stat -c '%a' "$instance_root/state/$bind_source")" = 700
  test "$(stat -c '%u:%g' "$instance_root/state/$bind_source")" = "$(id -u):$(id -g)"
done

"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent uninstall \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/reset-uninstall.json"
test "$(jq -er '.outcome' "$root/reset-uninstall.json")" = completed

if "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent reset-state \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/reset-refused.json" 2>"$root/reset-refused-error.json"; then
  printf 'CameraAgent reset-state accepted an unconfirmed destructive request.\n' >&2
  exit 1
fi
test ! -s "$root/reset-refused.json"
test "$(jq -er '.errorCode' "$root/reset-refused-error.json")" = usage
test -f "$identity_root/cameraagent_identity.db"

"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent reset-state \
  --instance-id "$instance_id" \
  --confirm-instance-id "$instance_id" \
  --product-root "$root/product" \
  --dry-run \
  --json >"$root/reset-plan.json"
test "$(jq -er '.outcome' "$root/reset-plan.json")" = planned
test -f "$identity_root/cameraagent_identity.db"
jq -e --arg path "$identity_root" '.deletedPaths | index($path) != null' "$root/reset-plan.json" >/dev/null
jq -e --arg path "$instance_root/instance-manifest.json" '.preservedPaths | index($path) != null' \
  "$root/reset-plan.json" >/dev/null

"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent reset-state \
  --instance-id "$instance_id" \
  --confirm-instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/reset.json"
test "$(jq -er '.outcome' "$root/reset.json")" = completed
test ! -e "$identity_root/cameraagent_identity.db"
test ! -e "$instance_root/state/raw/journal/raw-ingress.db"
test "$(jq -er '.deletionCommitted' "$(jq -er '.evidencePath' "$root/reset.json")")" = true
test -f "$instance_root/instance-manifest.json"
test -f "$instance_root/application-identity.json"
test -f "$instance_root/config/camera-module.json"
test -f "$instance_root/config/owner-bootstrap/temporary-password"
test -n "$(ls -A "$instance_root/config/secrets")"
test ! -f "$instance_root/state/deployment/installation-result.json"
test -d "$root/product/catalogs/hyg-v42-production"
for bind_source in identity data-protection provisioning raw archive replay-runner; do
  test -z "$(ls -A "$instance_root/state/$bind_source")"
  test "$(stat -c '%a' "$instance_root/state/$bind_source")" = 700
done

"$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" >"$root/post-reset.json"
test "$(jq -er '.healthy' "$root/post-reset.json")" = true
test "$(jq -er '.ownerBootstrapState' "$root/post-reset.json")" = owner-password-change-required
test "$(jq -er '.installationId' "$root/post-reset.json")" = "$(jq -er '.installationId' "$root/first.json")"
test "$(jq -er '.applicationIdentity' "$root/post-reset.json")" = "$(jq -er '.applicationIdentity' "$root/first.json")"
test "$(jq -er '.configurationSha256' "$root/post-reset.json")" = "$(jq -er '.configurationSha256' "$root/first.json")"
test -f "$identity_root/cameraagent_identity.db"
sqlite3 "$identity_root/cameraagent_identity.db" \
  "SELECT MigrationId FROM __EFMigrationsHistory;" >"$root/post-reset-identity-migrations.txt"
test "$(wc -l <"$root/post-reset-identity-migrations.txt")" = 1

printf 'CameraAgent state preflight and operator-confirmed reset contract passed for instance %s.\n' "$instance_id"

printf 'Disposable offline installer contract passed for instance %s.\n' "$instance_id"

# The signed CameraAgent image train is proved end to end here: two real release candidates, a real container,
# and the retained release record following the image the instance actually runs across install, upgrade,
# rollback, and refusal. The scenario is opt-in because it builds two multi-architecture release candidates.
if [[ "${HVO_INSTALLER_SIGNED_RELEASE_CAMPAIGN:-0}" == 1 ]]; then
  signed_arm64_builder="${HVO_INSTALLER_SIGNED_ARM64_BUILDER:-${HVO_RELEASE_ARM64_BUILDER:-hvo-edge-01-arm64}}"
  signed_workspace="${HVO_INSTALLER_SIGNED_WORKSPACE:-$root/signed}"
  mkdir -p "$signed_workspace"
  chmod 700 "$signed_workspace"
  signed_evidence_root="${HVO_INSTALLER_SIGNED_EVIDENCE_ROOT:-TestResults/issue-598/$(date -u +%Y%m%dT%H%M%SZ)}"
  mkdir -p "$signed_evidence_root"
  signed_evidence_root="$(cd "$signed_evidence_root" && pwd)"

  # The production signing key is unavailable outside the release workflow, so the campaign signs with an ephemeral
  # key and publishes a campaign CLI whose embedded trust root is that key. Nothing else about verification changes:
  # the substitution is proved below to redirect trust rather than to remove it.
  if [[ ! -f "$signed_workspace/signing.pem" ]]; then
    openssl ecparam -name prime256v1 -genkey -noout -out "$signed_workspace/signing.pem"
    chmod 600 "$signed_workspace/signing.pem"
  fi
  openssl pkey -in "$signed_workspace/signing.pem" -pubout -out "$signed_workspace/signing.pub.pem"
  signed_key_id="p256-sha256:$(openssl pkey -pubin -in "$signed_workspace/signing.pub.pem" -outform DER |
    sha256sum | cut -d ' ' -f 1)"
  if [[ ! -f "$signed_workspace/untrusted.pem" ]]; then
    openssl ecparam -name prime256v1 -genkey -noout -out "$signed_workspace/untrusted.pem"
    chmod 600 "$signed_workspace/untrusted.pem"
  fi
  openssl pkey -in "$signed_workspace/untrusted.pem" -pubout -out "$signed_workspace/untrusted.pub.pem"
  signed_untrusted_key_id="p256-sha256:$(openssl pkey -pubin -in "$signed_workspace/untrusted.pub.pem" -outform DER |
    sha256sum | cut -d ' ' -f 1)"
  test "$signed_untrusted_key_id" != "$signed_key_id"

  signed_source_worktrees=""
  signed_loaded_images=""
  # `git worktree prune` deregisters every worktree whose directory is momentarily absent, including other agents'
  # checkouts of this repository, so the throwaway source worktrees are always removed through git itself.
  remove_signed_worktree() {
    local source_worktree="$1"
    if git worktree list --porcelain | grep -Fqx "worktree $source_worktree"; then
      git worktree remove --force "$source_worktree" >/dev/null 2>&1 || true
    fi
    rm -rf "$source_worktree"
  }
  # The release script loads the host archive for its smoke test and leaves the image behind, so each candidate's
  # identities are registered for cleanup as soon as its manifest exists rather than after both builds succeed.
  register_signed_images() {
    local manifest="$1" identity
    for identity in offlineArchiveImageId manifestDigest; do
      signed_loaded_images="$signed_loaded_images $(signed_amd64_identity "$manifest" "$identity")"
    done
  }
  build_signed_release() {
    local slot="$1" revision="$2" version="$3"
    local source_worktree="$signed_workspace/source-$slot"
    local manifest="$signed_workspace/release-$slot/image-manifest.json"
    if [[ -f "$manifest" ]]; then
      printf 'Reusing the retained %s release candidate in %s.\n' "$version" "$signed_workspace" >&2
      register_signed_images "$manifest"
      return 0
    fi
    rm -rf "$signed_workspace/release-$slot"
    remove_signed_worktree "$source_worktree"
    git worktree add --detach "$source_worktree" "$revision" >/dev/null
    signed_source_worktrees="$signed_source_worktrees $source_worktree"
    "$source_worktree/scripts/release:cameraagent-image" \
      --version "$version" \
      --revision "$revision" \
      --output "$signed_workspace/release-$slot" \
      --arm64-builder "$signed_arm64_builder" \
      --sign-key "$signed_workspace/signing.pem"
    register_signed_images "$manifest"
    remove_signed_worktree "$source_worktree"
    signed_source_worktrees="${signed_source_worktrees%" $source_worktree"}"
  }
  signed_amd64_identity() {
    jq -er --arg field "$2" \
      '.images[0].platforms[] | select(.operatingSystem == "linux" and .architecture == "amd64") | .[$field]' "$1"
  }
  build_signed_release a "$signed_revision_a" "$signed_version_a"
  build_signed_release b "$signed_revision_b" "$signed_version_b"

  signed_manifest_a="$signed_workspace/release-a/image-manifest.json"
  signed_manifest_b="$signed_workspace/release-b/image-manifest.json"
  signed_image_a="$(signed_amd64_identity "$signed_manifest_a" offlineArchiveImageId)"
  signed_image_b="$(signed_amd64_identity "$signed_manifest_b" offlineArchiveImageId)"
  signed_digest_a="$(signed_amd64_identity "$signed_manifest_a" manifestDigest)"
  signed_digest_b="$(signed_amd64_identity "$signed_manifest_b" manifestDigest)"
  signed_archive_a="$(signed_amd64_identity "$signed_manifest_a" offlineArchiveAsset)"
  signed_archive_b="$(signed_amd64_identity "$signed_manifest_b" offlineArchiveAsset)"
  # The upgrade must move the instance to different immutable bytes, otherwise the transition proves nothing.
  test "$signed_image_a" != "$signed_image_b"
  test "$signed_digest_a" != "$signed_digest_b"
  test "$(jq -er '.images[0].sourceRevision' "$signed_manifest_a")" = "$signed_revision_a"
  test "$(jq -er '.images[0].sourceRevision' "$signed_manifest_b")" = "$signed_revision_b"
  test "$(jq -er '.signing.keyId' "$signed_manifest_a")" = "$signed_key_id"
  test "$(jq -er '.signing.keyId' "$signed_manifest_b")" = "$signed_key_id"
  test "$(jq -er '.release.version' "$signed_manifest_b")" = "$signed_version_b"

  # Each refused release is a manifest and signature in its own directory that names the real published archives
  # through --asset-base-url, so nothing copies or links a gigabyte of archives, the published candidates keep
  # exactly the files their SHA256SUMS describe, and the installer's refusal to read a hard-linked input still
  # applies to every file it opens.
  signed_derived_root="$signed_workspace/derived"
  rm -rf "$signed_derived_root"
  mkdir -p "$signed_derived_root"
  signed_derived_manifest() { printf '%s/%s-image-manifest.json' "$signed_derived_root" "$1"; }

  # A release whose signed compatibility record contradicts the image it names. The manifest's own consistency
  # rules already bind the release identity to the image identity, so the boundary that can drift is exactly the
  # compatibility record the label-agreement gate exists to check. The signature is genuine, so the refusal below
  # comes from that gate rather than from signature verification.
  signed_manifest_contradicting="$(signed_derived_manifest contradicting)"
  test "$(jq -er '.images[0].compatibility.minimumCompatibleRevision' "$signed_manifest_b")" != "$signed_revision_a"
  jq --arg revision "$signed_revision_a" '.images[0].compatibility.minimumCompatibleRevision = $revision' \
    "$signed_manifest_b" >"$signed_manifest_contradicting"
  test "$(jq -er '.images[0].compatibility.minimumCompatibleRevision' "$signed_manifest_contradicting")" = \
    "$signed_revision_a"

  # The same release bytes, signed by a key the trust root does not hold. Verification runs before the manifest's
  # own key identity is compared, so this and the forged release below are two directions on signature
  # verification rather than two different gates.
  signed_manifest_untrusted="$(signed_derived_manifest untrusted)"
  jq --arg keyId "$signed_untrusted_key_id" '.signing.keyId = $keyId' \
    "$signed_manifest_b" >"$signed_manifest_untrusted"

  # The same release bytes and the trusted key id, presented with that key's signature over a different release.
  # The signature is well formed and made by the trusted key, so only verifying it against these bytes refuses it.
  signed_manifest_forged="$(signed_derived_manifest forged)"
  cp "$signed_manifest_b" "$signed_manifest_forged"
  cp "$signed_workspace/release-a/image-manifest.json.sig" "$signed_manifest_forged.sig"

  # A genuinely signed release that names the other candidate's archive under this release's signed length and
  # checksum. Only verifying the acquired bytes against the signed asset identity can refuse it, so without that
  # check the campaign would pass while archive integrity was unenforced.
  signed_manifest_mismatched="$(signed_derived_manifest mismatched)"
  jq --arg was "$signed_archive_b" --arg now "$signed_archive_a" '
      .images[0].platforms |= map(if .offlineArchiveAsset == $was then .offlineArchiveAsset = $now else . end)
      | .artifacts |= map(if .assetName == $was then .assetName = $now else . end)' \
    "$signed_manifest_b" >"$signed_manifest_mismatched"
  test "$(signed_amd64_identity "$signed_manifest_mismatched" offlineArchiveAsset)" = "$signed_archive_a"
  test "$(jq -er --arg name "$signed_archive_a" '[.artifacts[] | select(.assetName == $name)] | length' \
    "$signed_manifest_mismatched")" = 1

  dotnet build tools/HVO.SkyMonitor.Deployment.ReleaseTool/HVO.SkyMonitor.Deployment.ReleaseTool.csproj \
    --configuration Release -warnaserror >/dev/null
  signed_release_tool() {
    dotnet run --project tools/HVO.SkyMonitor.Deployment.ReleaseTool/HVO.SkyMonitor.Deployment.ReleaseTool.csproj \
      --no-build --configuration Release -- "$@"
  }
  signed_release_tool sign-local \
    --manifest "$signed_manifest_contradicting" \
    --private-key "$signed_workspace/signing.pem" \
    --signature "$signed_manifest_contradicting.sig"
  signed_release_tool sign-local \
    --manifest "$signed_manifest_untrusted" \
    --private-key "$signed_workspace/untrusted.pem" \
    --signature "$signed_manifest_untrusted.sig"
  signed_release_tool sign-local \
    --manifest "$signed_manifest_mismatched" \
    --private-key "$signed_workspace/signing.pem" \
    --signature "$signed_manifest_mismatched.sig"

  # Publish a campaign CLI from the exact candidate revision with the ephemeral public key substituted for the
  # committed production trust root. Only the trusted key changes; no verification step is removed or relaxed.
  signed_source="$root/signed-source"
  mkdir -m 700 "$signed_source"
  git archive "$signed_revision_b" | tar -x -C "$signed_source"
  signed_trust_pem="$signed_source/src/HVO.SkyMonitor.Deployment.Distribution/Trust/hvo-skymonitor-production-release-p256-public.pem"
  signed_trust_source="$signed_source/src/HVO.SkyMonitor.Deployment.Distribution/DistributionTrust.cs"
  test -f "$signed_trust_pem"
  # Publish the unmodified CLI from this exact source first. The production-trust-root refusal then compares two
  # binaries built from one revision that differ only in the embedded trusted key, rather than comparing against
  # whatever revision the rest of the campaign happened to publish.
  signed_production_publish_root="$root/signed-publish-production"
  dotnet restore "$signed_source/src/HVO.SkyMonitor.Deployment.Cli/HVO.SkyMonitor.Deployment.Cli.csproj" --runtime linux-x64
  dotnet publish "$signed_source/src/HVO.SkyMonitor.Deployment.Cli/HVO.SkyMonitor.Deployment.Cli.csproj" \
    --no-restore --configuration Release --runtime linux-x64 --output "$signed_production_publish_root"
  signed_production_cli="$signed_production_publish_root/HVO.SkyMonitor.Deployment.Cli"
  cp "$signed_workspace/signing.pub.pem" "$signed_trust_pem"
  signed_production_key_id="$(grep -m1 -o 'p256-sha256:[0-9a-f]\{64\}' "$signed_trust_source")"
  test -n "$signed_production_key_id"
  sed -i "s|$signed_production_key_id|$signed_key_id|g" "$signed_trust_source"
  test "$(grep -c "$signed_production_key_id" "$signed_trust_source")" = 0
  signed_publish_root="$root/signed-publish"
  dotnet restore "$signed_source/src/HVO.SkyMonitor.Deployment.Cli/HVO.SkyMonitor.Deployment.Cli.csproj" --runtime linux-x64
  dotnet publish "$signed_source/src/HVO.SkyMonitor.Deployment.Cli/HVO.SkyMonitor.Deployment.Cli.csproj" \
    --no-restore --configuration Release --runtime linux-x64 --output "$signed_publish_root"
  signed_cli="$signed_publish_root/HVO.SkyMonitor.Deployment.Cli"

  signed_instance_id="$(tr -d '\n' </proc/sys/kernel/random/uuid)"
  signed_port=55416
  signed_container="hvo-skymonitor-${signed_instance_id//-/}"
  signed_instance_root="$root/product/cameraagents/$signed_instance_id"
  signed_evidence_path="$signed_instance_root/state/deployment/image-distribution.json"
  signed_lifecycle_state="$root/product/operations/cameraagent-$signed_instance_id.lifecycle.json"

  signed_install_arguments=(
    cameraagent install
    --instance-id "$signed_instance_id"
    --friendly-name "Signed Release Camera"
    --owner-email "signed-release@example.test"
    --bind-address 127.0.0.1
    --port "$signed_port"
    --product-root "$root/product"
    --catalog-bundle "$HVO_PRODUCTION_CATALOG_BUNDLE"
    --channel local
    --image-manifest "$signed_manifest_a"
    --no-download
    --latitude 35.2
    --longitude -114.1
    --elevation 800
    --time-zone America/Phoenix
    --generate-password
    --replay-profile local-runner
    --json
  )

  # Every transition retains the release record, the durable lifecycle records, a state inventory with modes and
  # checksums, the container logs, and the exact reports the assertions read, so a reviewer can read the
  # transition rather than trust the exit code. Capture runs before the assertions so a failing step still leaves
  # its evidence, and each directory is cleared first so a reused evidence root can never mix two runs.
  capture_signed_state() {
    local label="$1"
    local destination="$signed_evidence_root/$label"
    rm -rf "$destination"
    mkdir -p "$destination"
    shift
    local retained_report
    for retained_report in "$@"; do
      test -f "$root/$retained_report.json"
      cp "$root/$retained_report.json" "$destination/$retained_report.json"
    done
    if [[ -f "$signed_evidence_path" ]]; then
      cp "$signed_evidence_path" "$destination/image-distribution.json"
    else
      printf 'image-distribution.json is absent\n' >"$destination/image-distribution.absent"
    fi
    for retained in instance-manifest.json state/deployment/installation-result.json; do
      if [[ -f "$signed_instance_root/$retained" ]]; then
        cp "$signed_instance_root/$retained" "$destination/$(basename "$retained")"
      fi
    done
    if [[ -f "$root/product/operations/cameraagent-$signed_instance_id.lifecycle.json" ]]; then
      cp "$root/product/operations/cameraagent-$signed_instance_id.lifecycle.json" "$destination/lifecycle.json"
    fi
    find "$signed_instance_root" -maxdepth 4 -printf '%y %M %P\n' | LC_ALL=C sort >"$destination/state-inventory.txt"
    find "$signed_instance_root/state/deployment" -maxdepth 1 -type f -exec sha256sum {} + |
      sed "s|$signed_instance_root/||" | LC_ALL=C sort -k2 >"$destination/deployment-checksums.txt"
    # Retained container logs and the container's real image are acceptance artifacts, so a failure to collect
    # them fails the campaign instead of leaving a diagnostic where the evidence should be.
    docker logs --tail 200 "$signed_container" >"$destination/container.log" 2>&1
    docker inspect --format '{{.Image}}|{{.State.Status}}|{{.State.Health.Status}}' "$signed_container" \
      >"$destination/container-runtime.txt"
  }

  # A refusal must leave the retained record exactly as it found it. Comparing its bytes catches a refused
  # operation that rewrites the record with the same content it would already have held.
  signed_record_fingerprint() {
    if [[ -f "$signed_evidence_path" ]]; then
      sha256sum "$signed_evidence_path" | cut -d ' ' -f 1
    else
      printf 'absent\n'
    fi
  }

  assert_signed_evidence_names() {
    local version="$1" image_id="$2" revision="$3"
    test -f "$signed_evidence_path"
    test "$(jq -er '.distribution.releaseTrain' "$signed_evidence_path")" = image
    test "$(jq -er '.distribution.releaseVersion' "$signed_evidence_path")" = "$version"
    test "$(jq -er '.distribution.releaseTag' "$signed_evidence_path")" = "image-v$version"
    test "$(jq -er '.distribution.signingKeyId' "$signed_evidence_path")" = "$signed_key_id"
    test "$(jq -er '.distribution.verificationResult' "$signed_evidence_path")" = verified
    test "$(jq -er '.imageId' "$signed_evidence_path")" = "$image_id"
    test "$(jq -er '.sourceRevision' "$signed_evidence_path")" = "$revision"
    test "$(jq -er '.platformOperatingSystem' "$signed_evidence_path")" = linux
    test "$(jq -er '.platformArchitecture' "$signed_evidence_path")" = amd64
    test "$(jq -er '.component' "$signed_evidence_path")" = CameraAgent
  }

  # A daemon backed by the containerd image store names a loaded image by its manifest digest and the classic store
  # by its configuration digest. The release signs both, so an installed identity is required to be one of them
  # rather than assumed to follow one store's scheme.
  assert_signed_installed_identity() {
    local actual="$1" archive_image_id="$2" manifest_digest="$3"
    test "$actual" = "$archive_image_id" || test "$actual" = "$manifest_digest"
  }

  # The running image is read back from the product's own status, whose "status" outcome means the container image
  # equals the recorded installation image; a drifted container reports "drifted" instead.
  read_signed_status() {
    "$signed_cli" status \
      --instance-id "$signed_instance_id" \
      --product-root "$root/product" \
      --json >"$root/$1.json"
  }

  assert_signed_running_image() {
    local archive_image_id="$1" manifest_digest="$2" evidence_name="$3"
    test "$(jq -er '.outcome' "$root/$evidence_name.json")" = status
    assert_signed_installed_identity \
      "$(jq -er '.image.imageId' "$root/$evidence_name.json")" "$archive_image_id" "$manifest_digest"
    test "$(jq -er '.running' "$root/$evidence_name.json")" = true
    test "$(jq -er '.healthy' "$root/$evidence_name.json")" = true
  }

  "$signed_cli" "${signed_install_arguments[@]}" >"$root/signed-install.json"
  read_signed_status signed-status-install
  capture_signed_state 01-install-release-a signed-install signed-status-install
  test "$(jq -er '.instanceId' "$root/signed-install.json")" = "$signed_instance_id"
  test "$(jq -er '.healthy' "$root/signed-install.json")" = true
  assert_signed_installed_identity \
    "$(jq -er '.image.imageId' "$root/signed-install.json")" "$signed_image_a" "$signed_digest_a"
  test "$(jq -er '.image.source' "$root/signed-install.json")" = archive
  test "$(jq -er '.image.sourceRevision' "$root/signed-install.json")" = "$signed_revision_a"
  assert_signed_evidence_names "$signed_version_a" "$signed_image_a" "$signed_revision_a"
  test "$(jq -er '.distribution.assetName' "$signed_evidence_path")" = "$signed_archive_a"
  assert_signed_running_image "$signed_image_a" "$signed_digest_a" signed-status-install

  # A refused upgrade must leave the retained record byte-identical. Each refusal below is a signed release the
  # instance is not running, and the record's own bytes are compared, so a refusal that rewrote the record with
  # the release it refused, or merely re-stamped the record it found, fails here.
  signed_record_before="$(signed_record_fingerprint)"

  # The committed production trust root must not accept an ephemeral-key release. This CLI is published from the
  # same archived candidate source as the campaign CLI and differs from it only in the embedded trust root, so the
  # refusal isolates the key rather than any other difference between two builds.
  if "$signed_production_cli" cameraagent upgrade \
    --instance-id "$signed_instance_id" \
    --product-root "$root/product" \
    --channel local \
    --image-manifest "$signed_manifest_b" \
    --no-download \
    --migration-backward-compatible \
    --json >"$root/signed-production-trust.json" 2>"$root/signed-production-trust-error.json"; then
    printf 'The production trust root accepted a release signed by the campaign key.\n' >&2
    exit 1
  fi
  read_signed_status signed-status-production-trust
  capture_signed_state 02-production-trust-root-refusal \
    signed-production-trust-error signed-status-production-trust
  test ! -s "$root/signed-production-trust.json"
  test "$(jq -er '.errorCode' "$root/signed-production-trust-error.json")" = installation-failed
  jq -er '.message | test("could not be acquired or verified")' "$root/signed-production-trust-error.json" >/dev/null
  test "$(signed_record_fingerprint)" = "$signed_record_before"
  assert_signed_evidence_names "$signed_version_a" "$signed_image_a" "$signed_revision_a"
  assert_signed_running_image "$signed_image_a" "$signed_digest_a" signed-status-production-trust

  # The state preflight resolves the same signed release the upgrade is about to consume, without acquiring the
  # archive or contacting Docker, so the candidate's declared boundaries are evaluated before anything is touched.
  # It must name that release and change nothing, or a preflight that ignored the selector would pass unnoticed.
  "$signed_cli" cameraagent preflight \
    --instance-id "$signed_instance_id" \
    --product-root "$root/product" \
    --channel local \
    --image-manifest "$signed_manifest_b" \
    --no-download \
    --json >"$root/signed-candidate-preflight.json"
  read_signed_status signed-status-candidate-preflight
  capture_signed_state 03a-candidate-preflight signed-candidate-preflight signed-status-candidate-preflight
  test "$(jq -er '.compatible' "$root/signed-candidate-preflight.json")" = true
  test "$(jq -er '.outcome' "$root/signed-candidate-preflight.json")" = compatible
  test "$(jq -er '.candidateRelease' "$root/signed-candidate-preflight.json")" = "image-v$signed_version_b"
  assert_signed_installed_identity \
    "$(jq -er '.candidateImageId' "$root/signed-candidate-preflight.json")" "$signed_image_b" "$signed_digest_b"
  test "$(jq -er '[.findings[] | select(.blocking)] | length' "$root/signed-candidate-preflight.json")" = 0
  test "$(signed_record_fingerprint)" = "$signed_record_before"
  assert_signed_evidence_names "$signed_version_a" "$signed_image_a" "$signed_revision_a"
  assert_signed_running_image "$signed_image_a" "$signed_digest_a" signed-status-candidate-preflight

  "$signed_cli" cameraagent upgrade \
    --instance-id "$signed_instance_id" \
    --product-root "$root/product" \
    --channel local \
    --image-manifest "$signed_manifest_b" \
    --no-download \
    --migration-backward-compatible \
    --json >"$root/signed-upgrade.json"
  read_signed_status signed-status-upgrade
  capture_signed_state 03b-upgrade-release-b signed-upgrade signed-status-upgrade
  test "$(jq -er '.outcome' "$root/signed-upgrade.json")" = completed
  assert_signed_installed_identity \
    "$(jq -er '.image.imageId' "$root/signed-upgrade.json")" "$signed_image_b" "$signed_digest_b"
  test "$(jq -er '.image.sourceRevision' "$root/signed-upgrade.json")" = "$signed_revision_b"
  assert_signed_evidence_names "$signed_version_b" "$signed_image_b" "$signed_revision_b"
  test "$(jq -er '.distribution.assetName' "$signed_evidence_path")" = "$signed_archive_b"
  assert_signed_running_image "$signed_image_b" "$signed_digest_b" signed-status-upgrade
  test "$(signed_record_fingerprint)" != "$signed_record_before"
  signed_record_before="$(signed_record_fingerprint)"
  signed_journal_before="$(sha256sum "$signed_lifecycle_state" | cut -d ' ' -f 1)"

  # Three acquisition-stage refusals. Each derived release differs from the release just accepted in exactly one
  # field, so each isolates one gate even though the CLI reports them all through one acquirer diagnostic: a
  # signature made by a key the trust root does not hold, that key's real signature over other bytes, and a
  # release naming the other candidate's archive under this release's signed length and checksum. None of them
  # may touch the instance, the retained record, or the lifecycle journal.
  refuse_signed_acquisition() {
    local label="$1" manifest="$2" asset_base="$3" evidence_label="$4" failure="$5"
    if "$signed_cli" cameraagent upgrade \
      --instance-id "$signed_instance_id" \
      --product-root "$root/product" \
      --channel local \
      --image-manifest "$manifest" \
      --asset-base-url "$asset_base" \
      --no-download \
      --migration-backward-compatible \
      --json >"$root/signed-$label.json" 2>"$root/signed-$label-error.json"; then
      printf '%s\n' "$failure" >&2
      exit 1
    fi
    read_signed_status "signed-status-$label"
    capture_signed_state "$evidence_label" "signed-$label-error" "signed-status-$label"
    test ! -s "$root/signed-$label.json"
    test "$(jq -er '.errorCode' "$root/signed-$label-error.json")" = installation-failed
    jq -er '.message | test("could not be acquired or verified")' "$root/signed-$label-error.json" >/dev/null
    test "$(sha256sum "$signed_lifecycle_state" | cut -d ' ' -f 1)" = "$signed_journal_before"
    test "$(signed_record_fingerprint)" = "$signed_record_before"
    assert_signed_evidence_names "$signed_version_b" "$signed_image_b" "$signed_revision_b"
    assert_signed_running_image "$signed_image_b" "$signed_digest_b" "signed-status-$label"
  }
  refuse_signed_acquisition untrusted "$signed_manifest_untrusted" "$signed_workspace/release-b" \
    04-untrusted-key-refusal 'The campaign trust root accepted a release signed by a key it does not hold.'
  refuse_signed_acquisition forged "$signed_manifest_forged" "$signed_workspace/release-b" \
    05-forged-signature-refusal 'A release presented with another release signature was accepted.'
  refuse_signed_acquisition mismatched "$signed_manifest_mismatched" "$signed_workspace/release-a" \
    06-archive-integrity-refusal 'A release naming an archive that is not the one it signed was accepted.'

  "$signed_cli" cameraagent rollback \
    --instance-id "$signed_instance_id" \
    --product-root "$root/product" \
    --json >"$root/signed-rollback.json"
  read_signed_status signed-status-rollback
  capture_signed_state 07-rollback signed-rollback signed-status-rollback
  test "$(jq -er '.outcome' "$root/signed-rollback.json")" = completed
  assert_signed_installed_identity \
    "$(jq -er '.image.imageId' "$root/signed-rollback.json")" "$signed_image_a" "$signed_digest_a"
  # The rollback target is the retained previous image, not a release, so the record is withdrawn rather than
  # rewritten: no retained evidence may claim a release the instance is no longer running.
  test ! -e "$signed_evidence_path"
  assert_signed_running_image "$signed_image_a" "$signed_digest_a" signed-status-rollback
  signed_record_before="$(signed_record_fingerprint)"
  test "$signed_record_before" = absent

  # A release whose signed compatibility record contradicts the image it names is refused after acquisition and
  # before any mutation, and it records nothing: a refused upgrade never resurrects a withdrawn release record.
  if "$signed_cli" cameraagent upgrade \
    --instance-id "$signed_instance_id" \
    --product-root "$root/product" \
    --channel local \
    --image-manifest "$signed_manifest_contradicting" \
    --asset-base-url "$signed_workspace/release-b" \
    --no-download \
    --migration-backward-compatible \
    --json >"$root/signed-contradicting.json" 2>"$root/signed-contradicting-error.json"; then
    printf 'A release contradicting the image labels was accepted.\n' >&2
    exit 1
  fi
  read_signed_status signed-status-contradicting
  capture_signed_state 08-contradicting-label-refusal signed-contradicting-error signed-status-contradicting
  test ! -s "$root/signed-contradicting.json"
  test "$(jq -er '.errorCode' "$root/signed-contradicting-error.json")" = installation-failed
  jq -er '.message | test("does not carry the compatibility identity the release signed")' \
    "$root/signed-contradicting-error.json" >/dev/null
  jq -er '.message | test("minimum compatible revision signed")' "$root/signed-contradicting-error.json" >/dev/null
  # The label-agreement gate runs after the operation is journalled but before any mutation, so the journal records
  # an upgrade that never touched the instance.
  test "$(jq -er '.kind' "$signed_lifecycle_state")" = Upgrade
  test "$(jq -er '.mutationStarted' "$signed_lifecycle_state")" = false
  assert_signed_installed_identity \
    "$(jq -er '.image.imageId' "$signed_instance_root/instance-manifest.json")" "$signed_image_a" "$signed_digest_a"
  test "$(signed_record_fingerprint)" = "$signed_record_before"
  test ! -e "$signed_evidence_path"
  assert_signed_running_image "$signed_image_a" "$signed_digest_a" signed-status-contradicting

  # The state-compatibility preflight must still pass on the instance the signed lifecycle left behind, so the
  # scenario cannot have reached its end by weakening the gate it shares with the operator-supplied image path.
  "$signed_cli" cameraagent preflight \
    --instance-id "$signed_instance_id" \
    --product-root "$root/product" \
    --json >"$root/signed-preflight.json"
  read_signed_status signed-status-preflight
  capture_signed_state 09-final-preflight signed-preflight signed-status-preflight
  test "$(jq -er '.compatible' "$root/signed-preflight.json")" = true
  test "$(jq -er '.outcome' "$root/signed-preflight.json")" = compatible
  test "$(jq -er '.instanceId' "$root/signed-preflight.json")" = "$signed_instance_id"
  test "$(jq -er '[.findings[] | select(.blocking)] | length' "$root/signed-preflight.json")" = 0
  test "$(signed_record_fingerprint)" = "$signed_record_before"
  test ! -e "$signed_evidence_path"
  assert_signed_running_image "$signed_image_a" "$signed_digest_a" signed-status-preflight

  {
    printf 'signed release campaign\n'
    printf 'campaign trust root: %s (ephemeral; the production key is unavailable outside the release workflow)\n' "$signed_key_id"
    printf 'production trust root refused this release: %s\n' "$signed_production_key_id"
    printf 'release %s revision %s image %s\n' "$signed_version_a" "$signed_revision_a" "$signed_image_a"
    printf 'release %s revision %s image %s\n' "$signed_version_b" "$signed_revision_b" "$signed_image_b"
    printf 'arm64 builder: %s\n' "$signed_arm64_builder"
  } >"$signed_evidence_root/summary.txt"
  cp "$signed_manifest_a" "$signed_evidence_root/image-manifest-a.json"
  cp "$signed_manifest_b" "$signed_evidence_root/image-manifest-b.json"
  cp "$signed_workspace/release-a/SHA256SUMS" "$signed_evidence_root/SHA256SUMS-a.txt"
  cp "$signed_workspace/release-b/SHA256SUMS" "$signed_evidence_root/SHA256SUMS-b.txt"
  mkdir -p "$signed_evidence_root/refused-releases"
  cp "$signed_derived_root"/*-image-manifest.json "$signed_evidence_root/refused-releases/"
  # Each published candidate must still contain exactly the files its own SHA256SUMS describes: the refused
  # releases were derived beside them, not inside them.
  for signed_slot in a b; do
    (cd "$signed_workspace/release-$signed_slot" && sha256sum --check --status SHA256SUMS)
  done

  printf 'Signed CameraAgent image install, upgrade, rollback, and refusal contract passed for instance %s.\n' \
    "$signed_instance_id"
  printf 'Signed release campaign evidence retained under %s.\n' "$signed_evidence_root"
fi
