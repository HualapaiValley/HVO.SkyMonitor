#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${HVO_PRODUCTION_CATALOG_BUNDLE:-}" || ! -d "$HVO_PRODUCTION_CATALOG_BUNDLE" ]]; then
  printf 'HVO_PRODUCTION_CATALOG_BUNDLE must identify the exact production catalog bundle.\n' >&2
  exit 2
fi

root="$(mktemp -d "/tmp/hvo-i.XXXXXX")"
publish_root="$root/publish"
archive="$root/cameraagent.tar"
baseline_revision="${HVO_INSTALLER_BASELINE_REVISION:-}"
install_tag="hvo-skymonitor-cameraagent:installer-contract-$$"
candidate_tag=""
port=55415
instance_id="$(tr -d '\n' </proc/sys/kernel/random/uuid)"

cleanup() {
  docker rm --force "hvo-skymonitor-${instance_id//-/}" >/dev/null 2>&1 || true
  docker rm --force "hvo-skymonitor-${instance_id//-/}-replay" >/dev/null 2>&1 || true
  docker network rm "hvo-skymonitor-${instance_id//-/}_default" >/dev/null 2>&1 || true
  docker image rm --force "$install_tag" >/dev/null 2>&1 || true
  if [[ -n "$candidate_tag" ]]; then
    docker image rm --force "$candidate_tag" >/dev/null 2>&1 || true
  fi
  chmod -R u+w "$root" >/dev/null 2>&1 || true
  rm -rf "$root"
}
trap cleanup EXIT

chmod 700 "$root"
owner_socket_path="$root/product/cameraagents/$instance_id/state/identity/owner.sock"
if (( ${#owner_socket_path} > 107 )); then
  printf 'Installer contract root produces an overlong Unix socket path.\n' >&2
  exit 2
fi
source_root=.
if [[ -n "$baseline_revision" ]]; then
  if [[ -n "$(git status --porcelain)" ]]; then
    printf 'HVO_INSTALLER_BASELINE_REVISION requires a clean candidate worktree.\n' >&2
    exit 2
  fi
  baseline_revision="$(git rev-parse --verify "$baseline_revision^{commit}")"
  candidate_revision="$(git rev-parse --verify 'HEAD^{commit}')"
  if [[ "$candidate_revision" = "$baseline_revision" ]]; then
    printf 'The installer candidate revision must differ from its recovery baseline.\n' >&2
    exit 2
  fi
  if ! git merge-base --is-ancestor "$baseline_revision" "$candidate_revision"; then
    printf 'The installer recovery baseline must be an ancestor of the candidate revision.\n' >&2
    exit 2
  fi
  baseline_root="$root/baseline"
  candidate_root="$root/candidate"
  mkdir -m 700 "$baseline_root" "$candidate_root"
  git archive "$baseline_revision" | tar -x -C "$baseline_root"
  git archive "$candidate_revision" | tar -x -C "$candidate_root"
  source_root="$candidate_root"
  install_tag="hvo-skymonitor-cameraagent:installer-baseline-$$"
  candidate_tag="hvo-skymonitor-cameraagent:installer-candidate-$$"
  docker build --build-arg "HVO_SOURCE_REVISION=$baseline_revision" --tag "$install_tag" \
    --file "$baseline_root/src/HVO.SkyMonitor.CameraAgent/Dockerfile" "$baseline_root"
  docker build --build-arg "HVO_SOURCE_REVISION=$candidate_revision" --tag "$candidate_tag" \
    --file "$candidate_root/src/HVO.SkyMonitor.CameraAgent/Dockerfile" "$candidate_root"
  candidate_image_id="$(docker image inspect --format '{{.Id}}' "$candidate_tag")"
  test "$candidate_image_id" != "$(docker image inspect --format '{{.Id}}' "$install_tag")"
  test "$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$install_tag")" = "$baseline_revision"
  test "$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$candidate_tag")" = "$candidate_revision"
else
  docker build --build-arg "HVO_SOURCE_REVISION=$(git rev-parse HEAD)" --tag "$install_tag" \
    --file src/HVO.SkyMonitor.CameraAgent/Dockerfile .
fi
dotnet restore "$source_root/src/HVO.SkyMonitor.Deployment.Cli/HVO.SkyMonitor.Deployment.Cli.csproj" --runtime linux-x64
dotnet publish "$source_root/src/HVO.SkyMonitor.Deployment.Cli/HVO.SkyMonitor.Deployment.Cli.csproj" \
  --no-restore --configuration Release --runtime linux-x64 --output "$publish_root"
image_id="$(docker image inspect --format '{{.Id}}' "$install_tag")"
docker image save --output "$archive" "$install_tag"
archive_sha256="$(sha256sum "$archive" | cut -d ' ' -f 1)"
docker image rm "$install_tag"

common_arguments=(
  cameraagent install
  --instance-id "$instance_id"
  --friendly-name "Installer Contract Camera"
  --owner-email "installer-contract@example.test"
  --bind-address 127.0.0.1
  --port "$port"
  --product-root "$root/product"
  --catalog-bundle "$HVO_PRODUCTION_CATALOG_BUNDLE"
  --image-ref "$image_id"
  --image-archive "$archive"
  --image-archive-sha256 "$archive_sha256"
  --latitude 35.2
  --longitude -114.1
  --elevation 800
  --time-zone America/Phoenix
  --generate-password
  --replay-profile local-runner
  --json
)

export HVO_INSTALLER_ALLOW_TEST_ROOT=1
"$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" >"$root/first.json"
test "$(jq -er '.instanceId' "$root/first.json")" = "$instance_id"
container="hvo-skymonitor-${instance_id//-/}"
runner_container="$container-replay"
instance_root="$root/product/cameraagents/$instance_id"
identity_root="$instance_root/state/identity"
test "$(jq -er '.healthy' "$root/first.json")" = true
test "$(jq -er '.replayProfile' "$root/first.json")" = LocalRunner
test "$(jq -er '.image.imageId' "$root/first.json")" = "$image_id"
test "$(jq -er '.image.archiveSha256' "$root/first.json")" = "$archive_sha256"
test "$(docker inspect --format '{{.State.Health.Status}}' "$runner_container")" = healthy
test "$(docker inspect --format '{{.Config.User}}' "$runner_container")" = "$(id -u):$(id -g)"

docker stop "$container" >/dev/null
"$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" >"$root/rerun.json"
test "$(docker inspect --format '{{.State.Health.Status}}' "$container")" = healthy
test "$(docker inspect --format '{{.State.Health.Status}}' "$runner_container")" = healthy
test "$(jq -er '.installationId' "$root/first.json")" = "$(jq -er '.installationId' "$root/rerun.json")"
test "$(jq -er '.configurationSha256' "$root/first.json")" = "$(jq -er '.configurationSha256' "$root/rerun.json")"
test "$(jq -er '.catalog.databaseSha256' "$root/first.json")" = "$(jq -er '.catalog.databaseSha256' "$root/rerun.json")"

if [[ -n "$baseline_revision" ]]; then
  recovery_state="$root/product/operations/cameraagent-$instance_id.owner-recovery.json"
  lifecycle_state="$root/product/operations/cameraagent-$instance_id.lifecycle.json"
  result_path="$instance_root/state/deployment/installation-result.json"
  lifecycle_header="$root/lifecycle.header"

  owner_status_code() {
    local password_path="$1"
    local evidence_name="$2"
    local login_page="$root/$evidence_name-login.html"
    local cookie_jar="$root/$evidence_name-cookies.txt"
    local login_config="$root/$evidence_name-login.curl"
    local trimmed_password="$root/$evidence_name-password"
    local token_field
    local token

    tr -d '\r\n' <"$password_path" >"$trimmed_password"
    chmod 600 "$trimmed_password"
    curl --silent --show-error --fail --cookie-jar "$cookie_jar" \
      --output "$login_page" "http://127.0.0.1:$port/Account/Login"
    token_field="$(grep -o 'name="__RequestVerificationToken"[^>]*value="[^"]*"' "$login_page")"
    token="${token_field##*value=\"}"
    token="${token%%\"*}"
    test -n "$token"
    {
      printf 'silent\nshow-error\nrequest = "POST"\n'
      printf 'url = "http://127.0.0.1:%s/Account/Login"\n' "$port"
      printf 'cookie = "%s"\ncookie-jar = "%s"\n' "$cookie_jar" "$cookie_jar"
      printf 'output = "%s/%s-login-response.html"\n' "$root" "$evidence_name"
      printf 'data-urlencode = "__RequestVerificationToken=%s"\n' "$token"
      printf 'data-urlencode = "Input.Email=installer-contract@example.test"\n'
      printf 'data-urlencode = "Input.Password@%s"\n' "$trimmed_password"
      printf 'data-urlencode = "Input.RememberMe=false"\n'
      printf 'data-urlencode = "_handler=login"\n'
    } >"$login_config"
    chmod 600 "$login_config"
    curl --config "$login_config"
    curl --silent --show-error --output "$root/$evidence_name-status.json" --write-out '%{http_code}' \
      --cookie "$cookie_jar" "http://127.0.0.1:$port/api/internal/owner-bootstrap/status"
  }

  replace_owner_password() {
    local current_password_path="$1"
    local new_password_path="$2"
    local evidence_name="$3"
    local cookie_jar="$root/$evidence_name-cookies.txt"
    local replacement_page="$root/$evidence_name-replacement.html"
    local replacement_config="$root/$evidence_name-replacement.curl"
    local replacement_headers="$root/$evidence_name-replacement.headers"
    local current_password="$root/$evidence_name-current-password"
    local new_password="$root/$evidence_name-new-password"
    local token_field
    local token

    test "$(owner_status_code "$current_password_path" "$evidence_name")" = 200
    curl --silent --show-error --fail --cookie "$cookie_jar" \
      --output "$replacement_page" "http://127.0.0.1:$port/Account/ReplaceTemporaryPassword"
    token_field="$(grep -o 'name="__RequestVerificationToken"[^>]*value="[^"]*"' "$replacement_page")"
    token="${token_field##*value=\"}"
    token="${token%%\"*}"
    test -n "$token"
    tr -d '\r\n' <"$current_password_path" >"$current_password"
    tr -d '\r\n' <"$new_password_path" >"$new_password"
    chmod 600 "$current_password" "$new_password"
    {
      printf 'silent\nshow-error\nrequest = "POST"\n'
      printf 'url = "http://127.0.0.1:%s/Account/ReplaceTemporaryPassword"\n' "$port"
      printf 'cookie = "%s"\ncookie-jar = "%s"\n' "$cookie_jar" "$cookie_jar"
      printf 'output = "%s/%s-replacement-response.html"\n' "$root" "$evidence_name"
      printf 'dump-header = "%s"\n' "$replacement_headers"
      printf 'data-urlencode = "__RequestVerificationToken=%s"\n' "$token"
      printf 'data-urlencode = "Input.CurrentPassword@%s"\n' "$current_password"
      printf 'data-urlencode = "Input.NewPassword@%s"\n' "$new_password"
      printf 'data-urlencode = "Input.ConfirmPassword@%s"\n' "$new_password"
      printf 'data-urlencode = "_handler=replace-temporary-password"\n'
    } >"$replacement_config"
    chmod 600 "$replacement_config"
    curl --config "$replacement_config"
    grep -Eq '^HTTP/[^ ]+ 30[23]' "$replacement_headers"
  }

  assert_password_replacement_gate() {
    local evidence_name="$1"
    local cookie_jar="$root/$evidence_name-cookies.txt"
    local headers="$root/$evidence_name-gate.headers"
    local status_code

    status_code="$(curl --silent --show-error --output /dev/null --dump-header "$headers" \
      --write-out '%{http_code}' --cookie "$cookie_jar" "http://127.0.0.1:$port/")"
    test "$status_code" = 302
    tr -d '\r' <"$headers" | grep -Eqi '^location: /Account/ReplaceTemporaryPassword$'
  }

  owner_session_status_code() {
    local evidence_name="$1"
    curl --silent --show-error --output "$root/$evidence_name-session-status.json" --write-out '%{http_code}' \
      --cookie "$root/$evidence_name-cookies.txt" "http://127.0.0.1:$port/api/internal/owner-bootstrap/status"
  }

  initial_password_path="$(jq -er '.passwordFile' "$root/first.json")"
  owner_ready_password_path="$root/owner-ready-password"
  printf 'Owner-%s-Aa1!\n' "$(tr -d '\n' </proc/sys/kernel/random/uuid)" >"$owner_ready_password_path"
  chmod 600 "$owner_ready_password_path"
  replace_owner_password "$initial_password_path" "$owner_ready_password_path" baseline-bootstrap
  test "$(owner_status_code "$owner_ready_password_path" baseline-owner-ready)" = 200
  test "$(jq -er '.state' "$root/baseline-owner-ready-status.json")" = owner-ready
  "$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" >"$root/owner-ready-rerun.json"
  test "$(jq -er '.installationId' "$root/owner-ready-rerun.json")" = "$(jq -er '.installationId' "$root/first.json")"
  test "$(jq -er '.configurationSha256' "$root/owner-ready-rerun.json")" = "$(jq -er '.configurationSha256' "$root/first.json")"
  test "$(owner_status_code "$owner_ready_password_path" baseline-owner-ready-rerun)" = 200
  test "$(jq -er '.state' "$root/baseline-owner-ready-rerun-status.json")" = owner-ready

  if "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent recover-owner \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --generate-password \
    --json >"$root/baseline-recovery.json" 2>"$root/baseline-recovery-error.json"; then
    printf 'Pre-support CameraAgent unexpectedly accepted owner recovery.\n' >&2
    exit 1
  fi
  test ! -s "$root/baseline-recovery.json"
  test "$(jq -er '.errorCode' "$root/baseline-recovery-error.json")" = recovery-unsupported
  test "$(jq -er '.completed' "$recovery_state")" = false
  recovery_operation_id="$(jq -er '.operationId' "$recovery_state")"
  recovery_password_path="$root/product/operations/owner-recovery/$recovery_operation_id/temporary-password"

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent upgrade \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --image-ref "$candidate_image_id" \
    --no-download \
    --migration-backward-compatible \
    --json >"$root/upgrade.json"
  test "$(jq -er '.outcome' "$root/upgrade.json")" = completed
  test "$(jq -er '.image.imageId' "$root/upgrade.json")" = "$candidate_image_id"
  jq -e '
    (.preMutationContinuity.captureSequence | type) == "number" and
    (.postMutationContinuity.captureSequence | type) == "number" and
    .preMutationContinuity.captureSequence <= .postMutationContinuity.captureSequence
  ' "$lifecycle_state" >/dev/null
  test "$(stat -c '%a' "$identity_root")" = 700
  test "$(stat -c '%a' "$identity_root/owner.sock")" = 600
  test -S "$identity_root/owner.sock"
  test "$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/app/App_Data"}}{{.Source}}|{{.RW}}{{end}}{{end}}' "$container")" = "$identity_root|true"
  test "$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/run/hvo-secrets"}}{{.Source}}|{{.RW}}{{end}}{{end}}' "$container")" = "$root/product/cameraagents/$instance_id/config/secrets|false"

  printf 'X-HVO-Installation-Token: %s\n' \
    "$(<"$root/product/cameraagents/$instance_id/config/lifecycle-control/token")" >"$lifecycle_header"
  chmod 600 "$lifecycle_header"
  curl --silent --show-error --fail --header "@$lifecycle_header" \
    "http://127.0.0.1:$port/api/internal/deployment/lifecycle/state" >"$root/continuity-before.json"
  test "$(jq -er '.captureControl.value.state' "$root/continuity-before.json")" = Running
  test "$(owner_status_code "$owner_ready_password_path" candidate-owner-ready)" = 200
  test "$(jq -er '.state' "$root/candidate-owner-ready-status.json")" = owner-ready
  recovery_runtime_identity="$(docker inspect --format '{{.Id}}|{{.State.StartedAt}}|{{.State.Pid}}' "$container")"

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent recover-owner \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --generate-password \
    --resume \
    --json >"$root/recovery.json"
  test "$(jq -er '.operationId' "$root/recovery.json")" = "$recovery_operation_id"
  test "$(jq -er '.ownerBootstrapState' "$root/recovery.json")" = owner-password-change-required
  test "$(jq -er '.completed' "$recovery_state")" = true
  curl --silent --show-error --fail --header "@$lifecycle_header" \
    "http://127.0.0.1:$port/api/internal/deployment/lifecycle/state" >"$root/continuity-after.json"
  test "$(jq -er '.captureControl.value.state' "$root/continuity-after.json")" = Running
  test "$(jq -er '.captureControl.value.version' "$root/continuity-after.json")" = \
    "$(jq -er '.captureControl.value.version' "$root/continuity-before.json")"
  test "$(jq -er '.captureSequence >= $before' --argjson before "$(jq -er '.captureSequence' "$root/continuity-before.json")" "$root/continuity-after.json")" = true
  test "$(docker inspect --format '{{.Id}}|{{.State.StartedAt}}|{{.State.Pid}}' "$container")" = "$recovery_runtime_identity"
  test "$(owner_session_status_code candidate-owner-ready)" != 200
  test "$(owner_status_code "$owner_ready_password_path" rejected-old-owner)" != 200
  test "$(owner_status_code "$recovery_password_path" recovered-owner)" = 200
  test "$(jq -er '.state' "$root/recovered-owner-status.json")" = owner-password-change-required
  assert_password_replacement_gate recovered-owner
  recovery_identity_sha256="$(
    sqlite3 "$identity_root/cameraagent_identity.db" \
      "SELECT PasswordHash || '|' || SecurityStamp || '|' || COALESCE((SELECT Value FROM AspNetUserTokens WHERE LoginProvider = 'HVO.SkyMonitor.OwnerRecovery' AND Name = 'LastCompletedOperation'), '') FROM AspNetUsers WHERE IsSiteOwner = 1;" |
      sha256sum | cut -d ' ' -f 1
  )"
  test "$(sqlite3 "$identity_root/cameraagent_identity.db" "SELECT COUNT(*) FROM AspNetUserTokens WHERE LoginProvider = 'HVO.SkyMonitor.OwnerRecovery' AND Name = 'LastCompletedOperation' AND Value = '$recovery_operation_id';")" = 1

  docker kill "$container" >/dev/null
  test -S "$identity_root/owner.sock"
  docker start "$container" >/dev/null
  for _ in {1..60}; do
    if [[ "$(docker inspect --format '{{.State.Health.Status}}' "$container")" = healthy ]]; then
      break
    fi
    sleep 1
  done
  test "$(docker inspect --format '{{.State.Health.Status}}' "$container")" = healthy
  test -S "$identity_root/owner.sock"
  test "$(stat -c '%a' "$identity_root/owner.sock")" = 600

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent recover-owner \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --generate-password \
    --resume \
    --json >"$root/restarted-recovery.json"
  test "$(jq -er '.operationId' "$root/restarted-recovery.json")" = "$recovery_operation_id"
  test "$(jq -er '.completed' "$recovery_state")" = true
  test "$(
    sqlite3 "$identity_root/cameraagent_identity.db" \
      "SELECT PasswordHash || '|' || SecurityStamp || '|' || COALESCE((SELECT Value FROM AspNetUserTokens WHERE LoginProvider = 'HVO.SkyMonitor.OwnerRecovery' AND Name = 'LastCompletedOperation'), '') FROM AspNetUsers WHERE IsSiteOwner = 1;" |
      sha256sum | cut -d ' ' -f 1
  )" = "$recovery_identity_sha256"

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent rollback \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --json >"$root/rollback.json"
  test "$(jq -er '.outcome' "$root/rollback.json")" = completed
  test "$(jq -er '.image.imageId' "$root/rollback.json")" = "$image_id"
  jq -e '
    (.preMutationContinuity.captureSequence | type) == "number" and
    (.postMutationContinuity.captureSequence | type) == "number" and
    .preMutationContinuity.captureSequence <= .postMutationContinuity.captureSequence
  ' "$lifecycle_state" >/dev/null
  test ! -e "$identity_root/owner.sock"

  "$publish_root/HVO.SkyMonitor.Deployment.Cli" status \
    --instance-id "$instance_id" \
    --product-root "$root/product" \
    --json >"$root/final-status.json"
  test "$(jq -er '.image.imageId' "$root/final-status.json")" = "$image_id"
  test "$(jq -er '.running' "$root/final-status.json")" = true
  test "$(jq -er '.healthy' "$root/final-status.json")" = true
  curl --silent --show-error --fail --header "@$lifecycle_header" \
    "http://127.0.0.1:$port/api/internal/deployment/lifecycle/state" >"$root/continuity-rollback.json"
  test "$(jq -er '.captureControl.value.state' "$root/continuity-rollback.json")" = Running
  test "$(jq -er '.captureSequence >= $before' --argjson before "$(jq -er '.captureSequence' "$root/continuity-before.json")" "$root/continuity-rollback.json")" = true
  test "$(owner_status_code "$owner_ready_password_path" rollback-rejected-old-owner)" != 200
  test "$(owner_session_status_code candidate-owner-ready)" != 200
  test "$(owner_status_code "$recovery_password_path" rollback-recovered-owner)" = 200
  test "$(jq -er '.state' "$root/rollback-recovered-owner-status.json")" = owner-password-change-required
  assert_password_replacement_gate rollback-recovered-owner
  test "$(jq -er '.installationId' "$result_path")" = "$(jq -er '.installationId' "$root/first.json")"
  test "$(jq -er '.configurationSha256' "$result_path")" = "$(jq -er '.configurationSha256' "$root/first.json")"
  test "$(jq -er '.catalog.databaseSha256' "$result_path")" = "$(jq -er '.catalog.databaseSha256' "$root/first.json")"

  printf 'Owner recovery upgrade, restart, and rollback contract passed from %s.\n' "$baseline_revision"
fi

"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent preflight \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/preflight.json"
test "$(jq -er '.compatible' "$root/preflight.json")" = true
test "$(jq -er '.outcome' "$root/preflight.json")" = compatible
test "$(jq -er '.instanceId' "$root/preflight.json")" = "$instance_id"
# An installed image that predates the state-compatibility correction declares no boundary, so the report may
# carry the advisory naming that gap. No finding may ever be blocking on a compatible instance.
test "$(jq -er '[.findings[] | select(.blocking)] | length' "$root/preflight.json")" = 0
test "$(jq -er '[.findings[] | select(.code != "candidate-boundaries-undeclared")] | length' "$root/preflight.json")" = 0

for bind_source in identity data-protection provisioning raw archive replay-runner; do
  test -d "$instance_root/state/$bind_source"
  test "$(stat -c '%a' "$instance_root/state/$bind_source")" = 700
  test "$(stat -c '%u:%g' "$instance_root/state/$bind_source")" = "$(id -u):$(id -g)"
done

"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent uninstall \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/reset-uninstall.json"
test "$(jq -er '.outcome' "$root/reset-uninstall.json")" = completed

if "$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent reset-state \
  --instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/reset-refused.json" 2>"$root/reset-refused-error.json"; then
  printf 'CameraAgent reset-state accepted an unconfirmed destructive request.\n' >&2
  exit 1
fi
test ! -s "$root/reset-refused.json"
test "$(jq -er '.errorCode' "$root/reset-refused-error.json")" = usage
test -f "$identity_root/cameraagent_identity.db"

"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent reset-state \
  --instance-id "$instance_id" \
  --confirm-instance-id "$instance_id" \
  --product-root "$root/product" \
  --dry-run \
  --json >"$root/reset-plan.json"
test "$(jq -er '.outcome' "$root/reset-plan.json")" = planned
test -f "$identity_root/cameraagent_identity.db"
jq -e --arg path "$identity_root" '.deletedPaths | index($path) != null' "$root/reset-plan.json" >/dev/null
jq -e --arg path "$instance_root/instance-manifest.json" '.preservedPaths | index($path) != null' \
  "$root/reset-plan.json" >/dev/null

"$publish_root/HVO.SkyMonitor.Deployment.Cli" cameraagent reset-state \
  --instance-id "$instance_id" \
  --confirm-instance-id "$instance_id" \
  --product-root "$root/product" \
  --json >"$root/reset.json"
test "$(jq -er '.outcome' "$root/reset.json")" = completed
test ! -e "$identity_root/cameraagent_identity.db"
test ! -e "$instance_root/state/raw/journal/raw-ingress.db"
test "$(jq -er '.deletionCommitted' "$(jq -er '.evidencePath' "$root/reset.json")")" = true
test -f "$instance_root/instance-manifest.json"
test -f "$instance_root/application-identity.json"
test -f "$instance_root/config/camera-module.json"
test -f "$instance_root/config/owner-bootstrap/temporary-password"
test -n "$(ls -A "$instance_root/config/secrets")"
test ! -f "$instance_root/state/deployment/installation-result.json"
test -d "$root/product/catalogs/hyg-v42-production"
for bind_source in identity data-protection provisioning raw archive replay-runner; do
  test -z "$(ls -A "$instance_root/state/$bind_source")"
  test "$(stat -c '%a' "$instance_root/state/$bind_source")" = 700
done

"$publish_root/HVO.SkyMonitor.Deployment.Cli" "${common_arguments[@]}" >"$root/post-reset.json"
test "$(jq -er '.healthy' "$root/post-reset.json")" = true
test "$(jq -er '.ownerBootstrapState' "$root/post-reset.json")" = owner-password-change-required
test "$(jq -er '.installationId' "$root/post-reset.json")" = "$(jq -er '.installationId' "$root/first.json")"
test "$(jq -er '.applicationIdentity' "$root/post-reset.json")" = "$(jq -er '.applicationIdentity' "$root/first.json")"
test "$(jq -er '.configurationSha256' "$root/post-reset.json")" = "$(jq -er '.configurationSha256' "$root/first.json")"
test -f "$identity_root/cameraagent_identity.db"
sqlite3 "$identity_root/cameraagent_identity.db" \
  "SELECT MigrationId FROM __EFMigrationsHistory;" >"$root/post-reset-identity-migrations.txt"
test "$(wc -l <"$root/post-reset-identity-migrations.txt")" = 1

printf 'CameraAgent state preflight and operator-confirmed reset contract passed for instance %s.\n' "$instance_id"

printf 'Disposable offline installer contract passed for instance %s.\n' "$instance_id"
