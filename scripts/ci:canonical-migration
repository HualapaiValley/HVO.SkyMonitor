#!/usr/bin/env bash
set -euo pipefail

# Enforce exactly one canonical non-designer migration source for CameraAgent.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

host="${1:-}"
if [[ "$host" != cameraagent ]]; then
  printf 'Usage: scripts/ci:canonical-migration cameraagent\n' >&2
  exit 2
fi
directory="src/HVO.SkyMonitor.CameraAgent/Data/Migrations"

shopt -s nullglob
migrations=()
for path in "$directory"/20*_*.cs; do
  [[ "$path" == *.Designer.cs ]] || migrations+=("$path")
done

if (( ${#migrations[@]} != 1 )); then
  printf 'Expected one canonical %s migration in %s; found %s\n' \
    "$host" "$directory" "${#migrations[@]}" >&2
  printf -- '- %s\n' "${migrations[@]}" >&2
  exit 1
fi

printf 'Canonical %s migration: %s\n' "$host" "${migrations[0]}"
