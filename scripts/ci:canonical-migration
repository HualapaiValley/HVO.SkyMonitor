#!/usr/bin/env bash
set -euo pipefail

# Enforce exactly one canonical non-designer migration source for one EF context.
# The check is per host so a CameraAgent-only or LogicHost-only plan still runs
# the migration gate that its change can affect.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

host="${1:-}"
case "$host" in
  cameraagent) directory="src/HVO.SkyMonitor.CameraAgent/Data/Migrations" ;;
  logichost) directory="src/HVO.SkyMonitor.LogicHost/Data/Migrations" ;;
  *)
    printf 'Usage: scripts/ci:canonical-migration <cameraagent|logichost>\n' >&2
    exit 2
    ;;
esac

shopt -s nullglob
migrations=()
for path in "$directory"/20*_*.cs; do
  [[ "$path" == *.Designer.cs ]] || migrations+=("$path")
done

if (( ${#migrations[@]} != 1 )); then
  printf 'Expected one canonical %s migration in %s; found %s\n' \
    "$host" "$directory" "${#migrations[@]}" >&2
  printf -- '- %s\n' "${migrations[@]}" >&2
  exit 1
fi

printf 'Canonical %s migration: %s\n' "$host" "${migrations[0]}"
