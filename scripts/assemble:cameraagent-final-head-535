#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
umask 077

# Assembles the issue #535 final-head evidence aggregate from its producers.
#
# The validator (validate:cameraagent-final-head-535) exists so that a release
# claim is recomputed from evidence rather than read from a writer's own verdict.
# An aggregate typed in by hand defeats that: every field would be an assertion by
# the person who wants the answer to be yes. This script therefore derives every
# value it can from a named file or a git fact and refuses when a source is absent
# or does not support the derivation. It validates what it assembled before
# writing it, and a refusal writes nothing.
#
# Two inputs are operator assertions and are recorded as such rather than dressed
# up as derivations: the command log (its ids, exit codes and argv are typed by the
# operator; only the receipt digest is derived), and the reviewed/candidate heads,
# which have no producer and are checked only for alignment with the bound head.
#
#   --bound-head SHA       the clean reviewed head; HEAD must equal it and be clean
#   --campaign-root DIR    one issue-211 campaign run root: the directory holding
#                          run-manifest.json and final-acceptance-summary.json
#   --dual-agent FILE      the #197 five-trial-summary.json produced in final mode
#   --components FILE      components.json from record:cameraagent-final-head-components-535;
#                          its component-evidence/ directory is copied beside the output
#   --ci FILE              ci.json from import:cameraagent-final-head-ci-535; its
#                          ci-artifacts/ directory is copied beside the output.
#                          Required in final mode, optional in local mode.
#   --command-log FILE     one recorded command per line:
#                          <commandId> TAB <exitCode> TAB <receiptPath> TAB <argv>
#                          receiptPath is relative to the campaign root and is hashed;
#                          argv is hashed and not carried, because final evidence
#                          refuses free text.
#   --output FILE          the aggregate; its directory must exist inside the repository
#                          and be ignored by git, and neither it nor a sibling
#                          ci-artifacts/ or component-evidence/ may already exist
#   --mode local|final     default final
#   --repo-root DIR        the repository to read git facts and the acceptance assembly
#                          from; defaults to the repository this script lives in. The
#                          deterministic gate points it at a fixture repository.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly VALIDATE="$SCRIPT_DIR/validate:cameraagent-final-head-535"
readonly IDENTITY="$SCRIPT_DIR/lib/assembly-identity.fsx"
readonly SCHEMA_REPLAY_PROFILE="issue-535-w6-replay-profile-v1"
readonly ACCEPTANCE_ASSEMBLY="tests/HVO.SkyMonitor.CameraAgent.AcceptanceTests/bin/Release/net10.0/HVO.SkyMonitor.CameraAgent.AcceptanceTests.dll"

usage() {
    cat >&2 <<'EOF'
Usage:
  assemble:cameraagent-final-head-535 --bound-head SHA --campaign-root DIR \
      --dual-agent FILE --components FILE [--ci FILE] --command-log FILE \
      --output FILE [--mode local|final] [--repo-root DIR]
EOF
    exit 2
}

die() { printf '%s\n' "$*" >&2; exit 1; }
sha256_of() { sha256sum -- "$1" | cut -d' ' -f1; }
bytes_of() { stat -c %s -- "$1"; }

# The same path discipline as the recorder: every component is checked before
# canonicalization, because resolving first would hide a linked ancestor.
reject_symlink_components() {
    local path="$1" part current=""
    [[ "$path" == /* ]] || path="$PWD/$path"
    [[ ! "$path" =~ [[:cntrl:]] ]] || die "Control characters are not allowed in paths"
    local -a parts
    IFS='/' read -r -a parts <<< "$path"
    for part in "${parts[@]}"; do
        case "$part" in
            ''|.) continue ;;
            ..) die "Parent traversal is not allowed: $path" ;;
        esac
        current="$current/$part"
        [[ ! -L "$current" ]] || die "Symlink path is not allowed: $current"
    done
}
require_regular_file() {
    reject_symlink_components "$1"
    [[ -f "$1" ]] || die "Path must be a regular file: $1"
    [[ "$(stat -c '%h' -- "$1")" == 1 ]] || die "Hard-linked file is not allowed: $1"
}
require_directory() {
    reject_symlink_components "$1"
    [[ -d "$1" ]] || die "Path must be a directory: $1"
}
require_json_object() {
    require_regular_file "$1"
    [[ -s "$1" ]] || die "File is empty: $1"
    jq --exit-status --slurp 'length == 1 and (.[0] | type == "object")' "$1" >/dev/null 2>&1 || die "File is not one JSON object: $1"
}
# One OTLP export batch per line, every line an object.
require_json_lines() {
    require_regular_file "$1"
    [[ -s "$1" ]] || die "File is empty: $1"
    jq --exit-status --slurp 'length >= 1 and all(.[]; type == "object")' "$1" >/dev/null 2>&1 || die "File is not a sequence of JSON objects: $1"
}

bound_head="" campaign_root="" dual_agent="" components="" ci="" command_log="" output="" mode="final" repo_root=""
while (($# > 0)); do
    case "$1" in
        --bound-head) bound_head="${2:-}"; shift 2 || usage ;;
        --campaign-root) campaign_root="${2:-}"; shift 2 || usage ;;
        --dual-agent) dual_agent="${2:-}"; shift 2 || usage ;;
        --components) components="${2:-}"; shift 2 || usage ;;
        --ci) ci="${2:-}"; shift 2 || usage ;;
        --command-log) command_log="${2:-}"; shift 2 || usage ;;
        --output) output="${2:-}"; shift 2 || usage ;;
        --mode) mode="${2:-}"; shift 2 || usage ;;
        --repo-root) repo_root="${2:-}"; shift 2 || usage ;;
        *) usage ;;
    esac
done
[[ -n "$bound_head" && -n "$campaign_root" && -n "$dual_agent" && -n "$components" && -n "$command_log" && -n "$output" ]] || usage
case "$mode" in local|final) ;; *) die "Mode must be local or final: $mode" ;; esac
[[ "$mode" == local || -n "$ci" ]] || die "final mode requires --ci"
[[ "$bound_head" =~ ^[0-9a-f]{40}$ ]] || die "Bound head must be a full 40-character lowercase commit SHA: $bound_head"
[[ "$(uname -s)" == Linux ]] || die "Assembler requires Linux and GNU coreutils"
command -v jq >/dev/null || die "jq is required"
command -v dotnet >/dev/null || die "dotnet is required to read assembly identity"
[[ -f "$VALIDATE" && -f "$IDENTITY" ]] || die "Validator or identity reader is missing beside this script"
[[ -n "$repo_root" ]] || repo_root="$(cd "$SCRIPT_DIR/.." && pwd)"
require_directory "$repo_root"
repo_root="$(realpath -e -- "$repo_root")"
# Every path argument is resolved against the caller's directory before the
# repository root becomes the working directory, so a relative path names what the
# caller meant rather than a same-named file under the repository.
absolutize() { [[ "$1" == /* ]] && printf '%s' "$1" || printf '%s/%s' "$PWD" "$1"; }
campaign_root="$(absolutize "$campaign_root")"
dual_agent="$(absolutize "$dual_agent")"
components="$(absolutize "$components")"
command_log="$(absolutize "$command_log")"
output="$(absolutize "$output")"
[[ -z "$ci" ]] || ci="$(absolutize "$ci")"

# --- source identity ----------------------------------------------------------
# The bound head is the tree the campaign executed, and that tree must be clean
# now: an assembler that ran against modified sources would stamp every artefact
# with a commit it did not read. Both facts come from git, not from arguments.
cd "$repo_root"
[[ "$(git rev-parse --show-toplevel 2>/dev/null)" == "$repo_root" ]] || die "Repository root is not the top level of a git working tree: $repo_root"
[[ "$(git rev-parse HEAD)" == "$bound_head" ]] || die "HEAD is $(git rev-parse HEAD), not the bound head $bound_head"
[[ -z "$(git status --porcelain)" ]] || die "The working tree is not clean; final evidence cannot be assembled from a dirty tree"
bound_tree="$(git rev-parse 'HEAD^{tree}')"
readonly bound_tree

# The dirty-state digest the campaign records is sha256 over `git diff --binary
# HEAD` plus every untracked path and blob. On a clean tree that is sha256 of
# nothing, which is the one value that proves cleanliness rather than stability.
empty_sha256="$(printf '' | sha256sum | cut -d' ' -f1)"
readonly empty_sha256

# --- output placement ---------------------------------------------------------
reject_symlink_components "$output"
output_dir="$(dirname -- "$output")"
[[ -d "$output_dir" ]] || die "Output directory does not exist: $output_dir"
output_dir="$(realpath -e -- "$output_dir")"
case "$output_dir" in
    "$repo_root"/*) ;;
    *) die "Output must live inside the repository so the recorder can record it by relative path: $output" ;;
esac
git check-ignore -q -- "$output_dir" || die "Output directory must be ignored by git, or writing it would dirty the tree: $output_dir"
output_name="$(basename -- "$output")"
[[ "$output_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.json$ ]] || die "Output file name must be a safe .json name: $output_name"
[[ ! -e "$output_dir/$output_name" && ! -L "$output_dir/$output_name" ]] || die "Output already exists: $output"
[[ ! -e "$output_dir/ci-artifacts" && ! -L "$output_dir/ci-artifacts" ]] || die "ci-artifacts already exists beside the output: $output_dir/ci-artifacts"
[[ ! -e "$output_dir/component-evidence" && ! -L "$output_dir/component-evidence" ]] || die "component-evidence already exists beside the output: $output_dir/component-evidence"

# --- campaign root ------------------------------------------------------------
require_directory "$campaign_root"
campaign_root="$(realpath -e -- "$campaign_root")"
manifest="$campaign_root/run-manifest.json"
acceptance="$campaign_root/final-acceptance-summary.json"
source_gate="$campaign_root/source-integrity-gate.json"
central="$campaign_root/final-central-traffic-summary.json"
in_process="$campaign_root/replay-inprocess/evidence/issue-719-replay-InProcess.json"
local_runner="$campaign_root/replay-localrunner/evidence/issue-719-replay-LocalRunner.json"
trial_files=()
for trial in trial-1 trial-2 trial-3 trial-4 trial-5; do
    trial_files+=("$campaign_root/$trial/evidence/issue-211-w6.json")
done
trial_files+=("$campaign_root/mono8-control/evidence/issue-211-mono8.json")
for file in "$manifest" "$acceptance" "$source_gate" "$central" "$in_process" "$local_runner" "${trial_files[@]}"; do
    require_json_object "$file"
done
# A count must be a recorded non-negative integer. A missing field is not zero.
# Not a command substitution: `die` inside `$(...)` ends only the subshell, and an
# arithmetic caller would then read the empty result as zero, which is the
# defaulting this function exists to prevent. The value is returned in a variable.
count_value=""
count_field() {
    local file="$1" field="$2"
    jq -e --arg f "$field" '.[$f] | type == "number" and . >= 0 and . == floor' "$file" >/dev/null \
        || die "$file does not record $field as a non-negative integer"
    count_value="$(jq -r --arg f "$field" '.[$f]' "$file")"
}
for file in "${trial_files[@]:0:5}"; do
    jq -e '.schemaVersion == "issue-211-w6-evidence-v3" and .result.passed == true' "$file" >/dev/null \
        || die "W6 trial evidence is not a passed issue-211-w6-evidence-v3 record: $file"
done
jq -e '.schemaVersion == "issue-211-mono8-evidence-v1" and .result.passed == true' "${trial_files[5]}" >/dev/null \
    || die "Mono8 evidence is not a passed issue-211-mono8-evidence-v1 record: ${trial_files[5]}"

jq -e '.schemaVersion == "issue-211-run-manifest-v1"' "$manifest" >/dev/null || die "Run manifest schema is not issue-211-run-manifest-v1: $manifest"
manifest_revision="$(jq -r '.revision' "$manifest")"
[[ "$manifest_revision" == "$bound_head" ]] || die "Run manifest revision $manifest_revision is not the bound head $bound_head"
manifest_dirty="$(jq -r '.dirtyStateSha256 | ascii_downcase' "$manifest")"
[[ "$manifest_dirty" == "$empty_sha256" ]] || die "Run manifest dirty-state digest $manifest_dirty is not the clean-tree digest; the campaign ran on a dirty tree"
manifest_fingerprint="$(jq -r '.worktreeFingerprint' "$manifest")"
[[ "$manifest_fingerprint" == "${bound_head:0:12}-${empty_sha256:0:12}" ]] || die "Run manifest worktree fingerprint $manifest_fingerprint does not name the clean bound head"

# The campaign's own terminal verdict is a claim the validator never reads. The
# assembler reads it only to refuse early: every gate must be recorded as passed on
# this fingerprint, or there is nothing here worth assembling.
jq -e --arg fp "$manifest_fingerprint" '
    .schemaVersion == "issue-211-final-acceptance-summary-v1" and .acceptanceReady == true and
    (.gates | type == "object" and length == 10 and all(.[]; . == true)) and .worktreeFingerprint == $fp' "$acceptance" >/dev/null \
    || die "The campaign's final acceptance summary does not record every gate as passed on this fingerprint: $acceptance"
jq -e --arg fp "$manifest_fingerprint" '
    .schemaVersion == "issue-211-source-integrity-gate-v1" and .passed == true and
    .unchangedAfterBuildAndTrials == true and .worktreeFingerprint == $fp' "$source_gate" >/dev/null \
    || die "The campaign's source integrity gate did not pass on this fingerprint: $source_gate"

# Every retained output is re-hashed. The manifest is what the campaign's terminal
# verification bound; re-verifying here refuses a file altered after the campaign
# ended instead of recording it under the digest it used to have.
[[ "$(jq '.retainedOutputs | length' "$manifest")" -gt 0 ]] || die "Run manifest records no retained outputs"
while IFS=$'\t' read -r path bytes sha; do
    [[ -n "$path" ]] || continue
    [[ "$path" =~ ^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$ ]] || die "Retained output path is not a bounded relative path: $path"
    file="$campaign_root/$path"
    require_regular_file "$file"
    [[ "$(bytes_of "$file")" == "$bytes" ]] || die "Retained output length changed since the campaign: $path"
    [[ "$(sha256_of "$file")" == "${sha,,}" ]] || die "Retained output digest changed since the campaign: $path"
done < <(jq -r '.retainedOutputs[] | [.path, .bytes, .sha256] | @tsv' "$manifest")

# --- replay profiles ----------------------------------------------------------
# Each profile's node list is projected as recorded, in the order the producer
# recorded it. The validator compares that order to #719's canonical order; the
# assembler must never sort or reorder a record into shape.
#
# The three counters are derived from the v2 #719 record (#973), which carries the
# durable facts, with the retained telemetry required only as a consistency check.
#   publishedOutputs      The sum of each node's publishedOutputs, which the producer
#                         reads from published_flag on the execution's output
#                         associations. A replay is inserted with automatic publication
#                         disabled, so any nonzero value is carried for the validator
#                         to refuse.
#   liveRunnerDispatches  The count of attempts whose recorded execution route is
#                         LocalRunner under the InProcess profile, plus every attempt
#                         of a complementary node that recorded any route at all.
#                         Under the LocalRunner profile every recipe-backed attempt
#                         must have routed to the runner, and the runner's job meter
#                         must be recorded; under InProcess it must be absent.
#   fallbacks             The record's attemptCount is the durable count of attempts
#                         the execution took; fallbacks is attemptCount - 1. The sampled
#                         replay retry and terminal backlog gauges are additionally
#                         required to be recorded and their peaks added, so a retry that
#                         completed between samples is still counted through attemptCount
#                         and a terminal work item seen at any sample is not lost.
replay_profile() {
    local evidence="$1" expected_profile="$2" phase="$3" expected_reused="$4"
    local trial_dir metrics
    trial_dir="$(dirname -- "$(dirname -- "$evidence")")"
    metrics="$trial_dir/evidence/runtime/metrics.json"
    require_json_lines "$metrics"
    jq -e --arg p "$expected_profile" --argjson reused "$expected_reused" '
        .schemaVersion == "issue-719-replay-evidence-v2" and .profile == $p and .declaredProfile == $p and
        .stateReused == $reused and .result.passed == true and
        (.replay.replay.executionId | type == "string" and length > 0) and
        (.replay.replay.status == 2) and (.replay.replay.nodes | type == "array" and length == 14) and
        all(.replay.replay.nodes[]; .status == "Completed" and
            (.publishedOutputs | type == "number" and . >= 0 and . == floor) and
            (.executionRoutes | type == "array" and length >= 1 and
             all(.[]; . == "InProcess" or . == "LocalRunner" or . == "Unknown")))' "$evidence" >/dev/null \
        || die "Replay evidence for $expected_profile is not a passed v2 #719 record: $evidence"
    # metrics.json is one OTLP export batch per line, as the campaign's own scan
    # reads it. The disposition and runner job counters are cumulative sums, so
    # their value is the maximum across batches; the retry and terminal meters are
    # backlog gauges, so their peak across batches is what is carried, and a
    # backlog that was ever nonzero is carried rather than averaged away.
    local derived
    derived="$(jq -c --slurp '
        def points($name): [.[] | .resourceMetrics[]?.scopeMetrics[]?.metrics[]? | select(.name == $name) |
            (.sum.dataPoints[]?, .gauge.dataPoints[]?, .histogram.dataPoints[]?)];
        def attr($p; $k): first($p.attributes[]? | select(.key == $k) | .value.stringValue) // null;
        def value: (.asInt // .asDouble // .count // error("data point carries no value")) | tonumber;
        (points("camera_agent.processing.replay.retry")) as $retry |
        (points("camera_agent.processing.replay.terminal")) as $terminal |
        (points("camera_agent.processing.replay.dispositions")) as $dispositions |
        (points("camera_agent.replay_runner.jobs")) as $jobs |
        {
          retryRecorded: ($retry | length > 0),
          retries: ([$retry[] | value] | max // 0),
          terminalRecorded: ($terminal | length > 0),
          terminals: ([$terminal[] | value] | max // 0),
          completedDispositions: ([$dispositions[] | select(attr(.; "outcome") == "Completed")] | length),
          otherDispositions: ([$dispositions[] | select(attr(.; "outcome") != "Completed")] | length),
          runnerJobsRecorded: ($jobs | length > 0),
          runnerNonCompleted: ([$jobs[] | select(attr(.; "outcome") != "completed")] | length)
        }' "$metrics")"
    jq -e '.retryRecorded and .terminalRecorded and .completedDispositions >= 1 and .otherDispositions == 0' <<< "$derived" >/dev/null \
        || die "Replay telemetry for $expected_profile does not record the retry, terminal and disposition meters the fallback count is checked against: $metrics"
    if [[ "$expected_profile" == LocalRunner ]]; then
        jq -e '.runnerJobsRecorded and .runnerNonCompleted == 0' <<< "$derived" >/dev/null \
            || die "LocalRunner telemetry does not prove the runner completed every job: $metrics"
    else
        jq -e '.runnerJobsRecorded | not' <<< "$derived" >/dev/null \
            || die "InProcess telemetry records replay runner jobs, so the profile did not run in process: $metrics"
    fi
    jq -cn --arg schema "$SCHEMA_REPLAY_PROFILE" --arg runner "$expected_profile" --argjson phase "$phase" \
        --argjson derived "$derived" --slurpfile evidence "$evidence" '
        def recipe_backed: ["projected-scene", "calibration", "calibrated-preview", "rolling", "combined-preview", "quality", "cloud"];
        ($evidence[0].replay.replay.attemptCount) as $attempts |
        if $runner == "LocalRunner" and ([$evidence[0].replay.replay.nodes[] | select(.nodeId | IN(recipe_backed[])) |
            .executionRoutes[] | select(. != "LocalRunner")] | length) != 0 then
            error("a LocalRunner replay attempt did not route to the runner") else . end |
        if ($attempts | type) != "number" or $attempts < 1 or $attempts != ($attempts | floor) then
            error("attemptCount is not a positive integer") else . end |
        {
          schemaVersion: $schema,
          runner: $runner,
          phase: $phase,
          nodes: [$evidence[0].replay.replay.nodes[].nodeId],
          publishedOutputs: ([$evidence[0].replay.replay.nodes[].publishedOutputs] | add),
          liveRunnerDispatches: ([$evidence[0].replay.replay.nodes[] |
            (if (.nodeId | IN(recipe_backed[])) then
               [.executionRoutes[] | select(. == "LocalRunner" and $runner == "InProcess")]
             else
               [.executionRoutes[] | select(. != "Unknown")]
             end) | length] | add),
          fallbacks: (($attempts - 1 + $derived.retries + $derived.terminals) | floor)
        }'
}
in_process_profile="$(replay_profile "$in_process" InProcess 1 false)"
local_runner_profile="$(replay_profile "$local_runner" LocalRunner 2 true)"
# The two invocations must be the pair the campaign bound: one capture and one
# revision, with the second naming the first's execution as its prior.
jq -en --slurpfile a "$in_process" --slurpfile b "$local_runner" '
    $a[0].replay.sourceCaptureId == $b[0].replay.sourceCaptureId and
    $a[0].replay.replay.executionId == $b[0].replay.inProcessExecutionId and
    $b[0].replay.replay.executionId == $b[0].replay.localRunnerExecutionId and
    $a[0].replay.graphRevisionId == $b[0].replay.graphRevisionId' >/dev/null \
    || die "The InProcess and LocalRunner replay records are not one bound pair"

# --- central traffic ----------------------------------------------------------
# The deny sink's final hit count, the in-test handler attempts the campaign
# summed across every trial, and each trial's own recorded traffic attempts. The
# per-trial attempts and the final deny-hit count read the same deny-sink log, so
# a hit can appear in both; the sum is a refusal signal, not a count, and the
# validator refuses any nonzero value. Every term must be a recorded integer.
jq -e '.schemaVersion == "issue-211-final-central-traffic-summary-v5" and .allPassed == true' "$central" >/dev/null \
    || die "Final central traffic summary is not a passed v5 record: $central"
central_attempts=0
for field in centralHandlerAttempts finalCentralHandlerAttempts finalDenyHits; do
    count_field "$central" "$field"
    central_attempts="$((central_attempts + count_value))"
done
for file in "${trial_files[@]}"; do
    count_field "$file" centralTrafficAttempts
    central_attempts="$((central_attempts + count_value))"
done

# --- dual agent ---------------------------------------------------------------
require_json_object "$dual_agent"
# The five-trial summary scripts/test:cameraagent-dual-standalone-smoke writes in
# final mode. The per-trial issue-197-dual-agent.json records carry a different
# schema and no citability; only the summary is the #197 producer for this section.
jq -e --arg head "$bound_head" --arg clean "$empty_sha256" '
    .schemaVersion == "issue-197-five-trial-summary-v3" and .evidenceMode == "final" and .trialCount == 5 and
    .revision.commit == $head and .revision.clean == true and (.revision.dirtyStateSha256 | ascii_downcase) == $clean and
    (.citable | type == "boolean")' "$dual_agent" >/dev/null \
    || die "The #197 summary is not a final five-trial record on the clean bound head: $dual_agent"
dual_agent_section="$(jq -c '{citable: .citable, evidenceMode: .evidenceMode}' "$dual_agent")"

# --- test assemblies ----------------------------------------------------------
# The acceptance assembly the campaign executed, bound by the digest the campaign
# retained (below) and identified from its metadata; the assembly is not loaded.
assembly="$repo_root/$ACCEPTANCE_ASSEMBLY"
require_regular_file "$assembly"
assembly_sha="$(sha256_of "$assembly")"
# The campaign driver writes the digest of the assembly every trial executed to
# test-assembly.sha256 in the run root, and the run manifest binds it. The
# assembly read here must be that one; a run root without the file is refused
# rather than admitted under the weaker "same source" binding, because a file
# that is optional is a file whose absence nobody notices.
executed_sha_file="$campaign_root/test-assembly.sha256"
require_regular_file "$executed_sha_file"
executed_sha="$(tr -d '[:space:]' < "$executed_sha_file")"
[[ "$executed_sha" =~ ^[0-9a-f]{64}$ ]] || die "Retained executed-assembly digest is not a SHA-256: $executed_sha_file"
[[ "$executed_sha" == "$assembly_sha" ]] || die "Acceptance assembly on disk is not the assembly the campaign executed"
identity_errors="$(mktemp)"
if ! assembly_identity="$(cd / && dotnet fsi --quiet --exec "$IDENTITY" "$assembly" 2>"$identity_errors")"; then
    cat "$identity_errors" >&2
    rm -f "$identity_errors"
    die "Could not read assembly identity from $assembly"
fi
rm -f "$identity_errors"
jq -e 'type == "object" and (keys | sort) == ["configuration","informationalVersion","mvid"]' <<< "$assembly_identity" >/dev/null \
    || die "Assembly identity reader returned an unexpected shape"
assembly_mvid="$(jq -r '.mvid' <<< "$assembly_identity")"
assembly_configuration="$(jq -r '.configuration' <<< "$assembly_identity")"
assembly_version="$(jq -r '.informationalVersion' <<< "$assembly_identity")"
[[ "$assembly_mvid" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || die "Assembly MVID is not a GUID: $assembly_mvid"
[[ "$assembly_configuration" == Release ]] || die "Acceptance assembly on disk is a ${assembly_configuration:-<unrecorded>} build, not Release"
[[ "$assembly_version" == *"+$bound_head" ]] || die "Acceptance assembly informational version ${assembly_version:-<unrecorded>} does not carry the bound head"
test_assemblies="$(jq -cn --arg path "$ACCEPTANCE_ASSEMBLY" --arg sha "$assembly_sha" \
    --arg mvid "$assembly_mvid" --arg configuration "$assembly_configuration" --arg version "$assembly_version" \
    '[{configuration:$configuration, informationalVersion:$version, mvid:$mvid, path:$path, sha256:$sha}]')"

# --- commands -----------------------------------------------------------------
# Operator-authored: the id, exit code and argv are what the operator recorded.
# The receipt digest is derived from the campaign tree. An unterminated last line
# is still a record; `read` alone would drop it silently.
require_regular_file "$command_log"
commands='[]'
while IFS=$'\t' read -r command_id exit_code receipt_path argv_rest || [[ -n "$command_id" ]]; do
    [[ -n "$command_id" ]] || continue
    [[ "$command_id" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,39}$ ]] || die "Command id is not a bounded token: $command_id"
    [[ "$exit_code" =~ ^[0-9]+$ ]] || die "Command $command_id exit code is not a non-negative integer: $exit_code"
    [[ "$receipt_path" =~ ^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$ ]] || die "Command $command_id receipt path is not a bounded relative path: $receipt_path"
    receipt="$campaign_root/$receipt_path"
    require_regular_file "$receipt"
    [[ -n "$argv_rest" ]] || die "Command $command_id records no argv"
    commands="$(jq -c --arg id "$command_id" --argjson exit "$exit_code" \
        --arg receipt "$(sha256_of "$receipt")" --arg argv "$(printf '%s' "$argv_rest" | sha256sum | cut -d' ' -f1)" \
        '. + [{argvSha256:$argv, commandId:$id, exitCode:$exit, receiptSha256:$receipt}]' <<< "$commands")"
done < "$command_log"
[[ "$(jq 'length' <<< "$commands")" -gt 0 ]] || die "The command log records no commands: $command_log"
[[ "$(jq '[.[].commandId] | length == (unique | length)' <<< "$commands")" == true ]] || die "The command log repeats a command id"

# --- artifacts ----------------------------------------------------------------
# Every retained campaign output, re-hashed above. Claimability follows the rule
# EvidenceSourceIdentity applies: the tree is clean and the requested revision is
# HEAD, which is the strongest state that exists and is still review-required.
artifacts="$(jq -c --arg head "$bound_head" --arg tree "$bound_tree" '
    [.retainedOutputs[] | {
        admissible: true,
        claimability: "clean-source-attributed-review-required",
        path: .path,
        sha256: (.sha256 | ascii_downcase),
        sourceRevision: $head,
        sourceTree: $tree
    }] | sort_by(.path)' "$manifest")"

# --- components and ci --------------------------------------------------------
require_json_object "$components"
components_dir="$(dirname -- "$(realpath -e -- "$components")")"
jq -e --arg head "$bound_head" '
    .schemaVersion == "issue-535-component-evidence-v1" and (.records | length) == 4 and
    all(.records[]; .headSha == $head)' "$components" >/dev/null \
    || die "components.json is not a four-record exact-head component projection: $components"
require_directory "$components_dir/component-evidence"
ci_section='null'
if [[ -n "$ci" ]]; then
    require_json_object "$ci"
    ci_dir="$(dirname -- "$(realpath -e -- "$ci")")"
    jq -e --arg head "$bound_head" '.schemaVersion == "issue-535-ci-import-v1" and .run.headSha == $head and .run.attempt == 1' "$ci" >/dev/null \
        || die "ci.json is not a first-attempt import on the bound head: $ci"
    require_directory "$ci_dir/ci-artifacts"
    ci_section="$(jq -c '.' "$ci")"
fi

# --- source fingerprints ------------------------------------------------------
# The campaign asserted the tree unchanged from build through trials and terminal
# verification; its dirty-state digest is the fingerprint, recorded once and
# re-verified at each checkpoint rather than recorded twice, so start and end are
# one value by that gate's contract.
fingerprint="${manifest_dirty^^}"

# --- assemble -----------------------------------------------------------------
staging="$(mktemp -d "$output_dir/.assemble.XXXXXX")"
trap 'rm -rf -- "$staging"' EXIT
cp -a -- "$components_dir/component-evidence" "$staging/component-evidence"
if [[ -n "$ci" ]]; then
    cp -a -- "$ci_dir/ci-artifacts" "$staging/ci-artifacts"
fi
find "$staging" -type f -exec chmod 600 {} +
find "$staging" -type d -exec chmod 700 {} +

# The sections travel through files rather than arguments: an aggregate over a
# few hundred retained outputs is larger than an argument vector may be.
sections="$staging/.sections"
mkdir "$sections"
printf '%s' "$artifacts" > "$sections/artifacts.json"
printf '%s' "$commands" > "$sections/commands.json"
printf '%s' "$dual_agent_section" > "$sections/dual-agent.json"
printf '%s' "$in_process_profile" > "$sections/in-process.json"
printf '%s' "$local_runner_profile" > "$sections/local-runner.json"
printf '%s' "$test_assemblies" > "$sections/test-assemblies.json"
printf '%s' "$ci_section" > "$sections/ci.json"
jq -nS \
    --slurpfile artifacts "$sections/artifacts.json" \
    --argjson centralTrafficAttempts "$central_attempts" \
    --slurpfile ci "$sections/ci.json" \
    --slurpfile commands "$sections/commands.json" \
    --slurpfile components "$components" \
    --slurpfile dualAgent "$sections/dual-agent.json" \
    --arg head "$bound_head" \
    --arg fingerprint "$fingerprint" \
    --slurpfile inProcess "$sections/in-process.json" \
    --slurpfile localRunner "$sections/local-runner.json" \
    --slurpfile testAssemblies "$sections/test-assemblies.json" '
    {
      artifacts: $artifacts[0],
      centralTrafficAttempts: $centralTrafficAttempts,
      commands: $commands[0],
      components: $components[0],
      dualAgent: $dualAgent[0],
      heads: {aggregate: $head, candidateB: $head, execution: $head, protectedCi: $head, reviewed: $head},
      replayProfiles: [$inProcess[0], $localRunner[0]],
      source: {clean: true, endFingerprint: $fingerprint, startFingerprint: $fingerprint},
      testAssemblies: $testAssemblies[0]
    } + (if $ci[0] == null then {} else {ci: $ci[0]} end)' > "$staging/$output_name"
rm -rf -- "$sections"
chmod 600 "$staging/$output_name"

# Validate in place before anything is published. A refusal leaves nothing behind,
# and the validator's own document says why.
validator_errors="$(mktemp)"
verdict="$("$VALIDATE" "$mode" --evidence "$staging/$output_name" --bound-head "$bound_head" 2>"$validator_errors")" && validated=true || validated=false
if [[ "$validated" != true ]]; then
    printf 'The validator refused the assembled evidence in %s mode; nothing was written.\n' "$mode" >&2
    cat "$validator_errors" >&2
    printf '%s\n' "$verdict" >&2
    rm -f "$validator_errors"
    exit 1
fi
rm -f "$validator_errors"

# The tree must still be clean and at the bound head after everything was read.
[[ "$(git rev-parse HEAD)" == "$bound_head" && -z "$(git status --porcelain)" ]] || die "Source changed during assembly"

# Publication is one rename per sibling, in an order that cannot leave a
# half-published set: the support directories first, the evidence file last, and
# on any failure everything already moved is withdrawn before exiting. The
# evidence file is what the recorder reads, so its absence is the whole set's
# absence.
moved=()
withdraw() {
    local path
    for path in "${moved[@]}"; do rm -rf -- "$path"; done
    die "$1"
}
mv -T --no-clobber -- "$staging/component-evidence" "$output_dir/component-evidence" || withdraw "Could not publish component-evidence"
moved+=("$output_dir/component-evidence")
if [[ -n "$ci" ]]; then
    mv -T --no-clobber -- "$staging/ci-artifacts" "$output_dir/ci-artifacts" || withdraw "Could not publish ci-artifacts"
    moved+=("$output_dir/ci-artifacts")
fi
mv --no-clobber -- "$staging/$output_name" "$output_dir/$output_name" || withdraw "Could not publish $output_name"
[[ -f "$output_dir/$output_name" ]] || withdraw "Output was not written: $output"
printf '%s\n' "$verdict"
