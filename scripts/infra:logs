#!/usr/bin/env bash
# infra:logs - View logs from infrastructure and application services
# Usage: ./scripts/infra:logs [OPTIONS] [SERVICE...]
# Examples:
#   ./scripts/infra:logs                    # Follow all service logs
#   ./scripts/infra:logs postgres           # Follow postgres logs
#   ./scripts/infra:logs logichost cameraagent  # Follow app logs
#   ./scripts/infra:logs --no-follow redis  # Show redis logs without following
#   ./scripts/infra:logs --tail 100 minio   # Show last 100 lines of minio logs

set -euo pipefail

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Change to repo root
cd "$REPO_ROOT"

# Load environment variables
if [ -f .env ]; then
    set -a
    source .env
    set +a
fi

# Define all available services
readonly INFRA_SERVICES=(postgres minio redis smtp)
readonly APP_SERVICES=(logichost cameraagent)
readonly ALL_SERVICES=("${INFRA_SERVICES[@]}" "${APP_SERVICES[@]}")

# Parse arguments
FOLLOW=true
TAIL_LINES=""
SERVICES=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --no-follow)
            FOLLOW=false
            shift
            ;;
        --tail)
            TAIL_LINES="$2"
            shift 2
            ;;
        -*)
            echo -e "${RED}Unknown option: $1${NC}"
            echo "Usage: ./scripts/infra:logs [--no-follow] [--tail N] [SERVICE...]"
            exit 1
            ;;
        *)
            SERVICES+=("$1")
            shift
            ;;
    esac
done

# If no services specified, show all
if [[ ${#SERVICES[@]} -eq 0 ]]; then
    SERVICES=("${ALL_SERVICES[@]}")
fi

# Function to get docker context for a service
get_docker_context() {
    local service="$1"
    local context_var="default"
    
    case "$service" in
        postgres) context_var="${POSTGRES_DOCKER_CONTEXT:-default}" ;;
        minio) context_var="${MINIO_DOCKER_CONTEXT:-default}" ;;
        redis) context_var="${REDIS_DOCKER_CONTEXT:-default}" ;;
        smtp) context_var="${SMTP_DOCKER_CONTEXT:-default}" ;;
        logichost) context_var="${LOGICHOST_DOCKER_CONTEXT:-default}" ;;
        cameraagent) context_var="${CAMERAAGENT_DOCKER_CONTEXT:-default}" ;;
    esac
    
    echo "$context_var"
}

get_compose_file() {
    local service="$1"
    case "$service" in
        postgres|minio|redis|smtp) echo "docker-compose.infrastructure.yml" ;;
        logichost|cameraagent) echo "docker-compose.apps.yml" ;;
        *) echo "docker-compose.infrastructure.yml" ;;
    esac
}

# Build log command arguments
LOG_ARGS=()
if [[ "$FOLLOW" == true ]]; then
    LOG_ARGS+=("-f")
fi
if [[ -n "$TAIL_LINES" ]]; then
    LOG_ARGS+=("--tail" "$TAIL_LINES")
fi

# If we have a single service, just show its logs
if [[ ${#SERVICES[@]} -eq 1 ]]; then
    service="${SERVICES[0]}"
    context="$(get_docker_context "$service")"
    compose_file="$(get_compose_file "$service")"
    
    echo -e "${BLUE}Viewing logs for ${service} via context '${context}'${NC}"
    exec docker --context "$context" compose -f "$compose_file" logs "${LOG_ARGS[@]}" "$service"
fi

# For multiple services, we need to handle different contexts/compose files
# Group services by their context and compose file
declare -A context_file_services

for service in "${SERVICES[@]}"; do
    context="$(get_docker_context "$service")"
    compose_file="$(get_compose_file "$service")"
    key="${context}:${compose_file}"
    
    if [[ -z "${context_file_services[$key]:-}" ]]; then
        context_file_services[$key]="$service"
    else
        context_file_services[$key]="${context_file_services[$key]} $service"
    fi
done

# If all services share the same context and compose file, we can stream them together
if [[ ${#context_file_services[@]} -eq 1 ]]; then
    for key in "${!context_file_services[@]}"; do
        IFS=':' read -r context compose_file <<< "$key"
        services_list="${context_file_services[$key]}"
        
        echo -e "${BLUE}Viewing logs for services: ${services_list} via context '${context}'${NC}"
        # shellcheck disable=SC2086
        exec docker --context "$context" compose -f "$compose_file" logs "${LOG_ARGS[@]}" $services_list
    done
else
    # Multiple contexts/files - need to run them in parallel (only works with --follow)
    if [[ "$FOLLOW" != true ]]; then
        echo -e "${YELLOW}Warning: Viewing logs from multiple contexts requires --follow mode${NC}"
        echo -e "${YELLOW}Showing logs sequentially instead...${NC}"
        echo ""
        
        for key in "${!context_file_services[@]}"; do
            IFS=':' read -r context compose_file <<< "$key"
            services_list="${context_file_services[$key]}"
            
            echo -e "${BLUE}=== Logs for: ${services_list} (context: ${context}) ===${NC}"
            # shellcheck disable=SC2086
            docker --context "$context" compose -f "$compose_file" logs "${LOG_ARGS[@]}" $services_list
            echo ""
        done
        exit 0
    fi
    
    echo -e "${BLUE}Following logs from multiple contexts (press Ctrl+C to stop)${NC}"
    echo ""
    
    # Launch each context/file group in background
    pids=()
    for key in "${!context_file_services[@]}"; do
        IFS=':' read -r context compose_file <<< "$key"
        services_list="${context_file_services[$key]}"
        
        echo -e "${BLUE}Starting log stream for: ${services_list} (context: ${context})${NC}"
        # shellcheck disable=SC2086
        docker --context "$context" compose -f "$compose_file" logs -f "${LOG_ARGS[@]}" $services_list &
        pids+=($!)
    done
    
    # Wait for all background processes
    trap 'kill "${pids[@]}" 2>/dev/null || true' EXIT INT TERM
    wait
fi
