#!/usr/bin/env bash
# infra:logs - View logs from infrastructure and application services
# Usage: ./scripts/infra:logs [OPTIONS] [SERVICE...]

set -euo pipefail

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [[ -f .env ]]; then
    set -a
    source .env
    set +a
fi

readonly INFRA_SERVICES=(postgres minio redis smtp)
readonly APP_SERVICES=(logichost cameraagent)
readonly ALL_SERVICES=("${INFRA_SERVICES[@]}" "${APP_SERVICES[@]}")

FOLLOW=true
TAIL_LINES=""
SERVICES=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --no-follow)
            FOLLOW=false
            shift
            ;;
        --tail)
            TAIL_LINES="$2"
            shift 2
            ;;
        -*)
            echo -e "${RED}Unknown option: $1${NC}"
            echo "Usage: ./scripts/infra:logs [--no-follow] [--tail N] [SERVICE...]"
            exit 1
            ;;
        *)
            SERVICES+=("$1")
            shift
            ;;
    esac
done

if [[ ${#SERVICES[@]} -eq 0 ]]; then
    SERVICES=("${ALL_SERVICES[@]}")
fi

get_compose_file() {
    local service="$1"
    case "$service" in
        postgres|minio|redis|smtp) echo "docker-compose.infrastructure.yml" ;;
        logichost|cameraagent) echo "docker-compose.apps.yml" ;;
        *) echo "docker-compose.infrastructure.yml" ;;
    esac
}

LOG_ARGS=()
if [[ "$FOLLOW" == true ]]; then
    LOG_ARGS+=("-f")
fi
if [[ -n "$TAIL_LINES" ]]; then
    LOG_ARGS+=("--tail" "$TAIL_LINES")
fi

if [[ ${#SERVICES[@]} -eq 1 ]]; then
    service="${SERVICES[0]}"
    compose_file="$(get_compose_file "$service")"
    echo -e "${BLUE}Viewing logs for ${service}${NC}"
    exec docker compose -f "$compose_file" logs "${LOG_ARGS[@]}" "$service"
fi

declare -A file_services
for service in "${SERVICES[@]}"; do
    compose_file="$(get_compose_file "$service")"
    key="$compose_file"
    if [[ -z "${file_services[$key]:-}" ]]; then
        file_services[$key]="$service"
    else
        file_services[$key]="${file_services[$key]} $service"
    fi
done

if [[ ${#file_services[@]} -eq 1 ]]; then
    for compose_file in "${!file_services[@]}"; do
        services_list="${file_services[$compose_file]}"
        echo -e "${BLUE}Viewing logs for services: ${services_list}${NC}"
        # shellcheck disable=SC2086
        exec docker compose -f "$compose_file" logs "${LOG_ARGS[@]}" $services_list
    done
    exit 0
fi

if [[ "$FOLLOW" != true ]]; then
    echo -e "${YELLOW}Warning: Viewing logs from multiple compose files requires --follow mode${NC}"
    echo -e "${YELLOW}Showing logs sequentially instead...${NC}\n"
    for compose_file in "${!file_services[@]}"; do
        services_list="${file_services[$compose_file]}"
        echo -e "${BLUE}=== Logs for: ${services_list} (${compose_file}) ===${NC}"
        # shellcheck disable=SC2086
        docker compose -f "$compose_file" logs "${LOG_ARGS[@]}" $services_list
        echo ""
    done
    exit 0
fi

echo -e "${BLUE}Following logs from multiple compose files (press Ctrl+C to stop)${NC}\n"
pids=()
for compose_file in "${!file_services[@]}"; do
    services_list="${file_services[$compose_file]}"
    echo -e "${BLUE}Starting log stream for: ${services_list} (${compose_file})${NC}"
    # shellcheck disable=SC2086
    docker compose -f "$compose_file" logs "${LOG_ARGS[@]}" $services_list &
    pids+=($!)
done

trap 'kill "${pids[@]}" 2>/dev/null || true' EXIT INT TERM
wait
