          ($family.commandTemplate | contains("--logger \"trx;LogFileName=result.trx\""))
        end) and
        ($family.input | contains("scenario-evidence")) and ($family.input | contains("TRX") or contains("trx")) and
        ($family.sanitizer | test("-v[0-9]+$")) and ($family.admissibilityValidator | test("-v[0-9]+$")) and
