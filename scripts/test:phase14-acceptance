#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
SOURCE_REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly SOURCE_REPO_ROOT
# shellcheck source=scripts/deploy/common.sh
. "$SCRIPT_DIR/deploy/common.sh"
# shellcheck source=scripts/deploy/run-state.sh
. "$SCRIPT_DIR/deploy/run-state.sh"
# shellcheck source=scripts/deploy/catalog.sh
. "$SCRIPT_DIR/deploy/catalog.sh"
# shellcheck source=scripts/deploy/acceptance.sh
. "$SCRIPT_DIR/deploy/acceptance.sh"

TEMP_DIR="$(mktemp -d -t hvo-acceptance-test.XXXXXX)"
readonly TEMP_DIR
trap 'rm -rf "$TEMP_DIR"' EXIT
trap 'printf "Phase 14 acceptance-init contract test failed near line %s.\n" "$LINENO" >&2' ERR
fail() { printf '%s\n' "$1" >&2; exit 1; }

REPO_ROOT="$TEMP_DIR/repository"
install -d -m 700 "$REPO_ROOT/deploy/split-host/acceptance" "$REPO_ROOT/deploy/split-host/workloads" \
  "$REPO_ROOT/src/HVO.SkyMonitor.CameraAgent"
cp "$SOURCE_REPO_ROOT/deploy/split-host/acceptance/phase14-scenarios.json" "$REPO_ROOT/deploy/split-host/acceptance/phase14-scenarios.json"
cp "$SOURCE_REPO_ROOT/deploy/split-host/workloads/canonical-workloads.json" "$REPO_ROOT/deploy/split-host/workloads/canonical-workloads.json"
cp "$SOURCE_REPO_ROOT/deploy/split-host/workloads/w0-virtual-mono16.json" "$REPO_ROOT/deploy/split-host/workloads/w0-virtual-mono16.json"
cp "$SOURCE_REPO_ROOT/src/HVO.SkyMonitor.CameraAgent/virtual-asi174.full.json" "$REPO_ROOT/src/HVO.SkyMonitor.CameraAgent/virtual-asi174.full.json"
cp "$SOURCE_REPO_ROOT/src/HVO.SkyMonitor.CameraAgent/virtual-asi178mc.full.json" "$REPO_ROOT/src/HVO.SkyMonitor.CameraAgent/virtual-asi178mc.full.json"
git -C "$REPO_ROOT" init --quiet
git -C "$REPO_ROOT" config user.email phase14-contract@example.invalid
git -C "$REPO_ROOT" config user.name "Phase 14 Contract Test"
git -C "$REPO_ROOT" add --all
git -C "$REPO_ROOT" commit --quiet -m fixture
revision="$(git -C "$REPO_ROOT" rev-parse HEAD)"
tree="$(git -C "$REPO_ROOT" rev-parse "${revision}^{tree}")"
inventory="$TEMP_DIR/inventory.json"
run_id="phase14-contract"
mode="isolated"
inventory_hash=""
FIXTURE_STATE=""
FIXTURE_EVIDENCE=""

jq -n --arg revision "$revision" '{environment:"contract",installationId:"contract-installation",source:{revision:$revision},
  logicHost:{name:"logic",expectedHostName:"logic-node",expectedArchitecture:"amd64",expectedHostIdentity:"logic-host",expectedDockerDaemonIdentity:"logic-daemon"},
  cameraAgents:[{name:"east",expectedHostName:"east-node",expectedArchitecture:"arm64",expectedHostIdentity:"east-host",expectedDockerDaemonIdentity:"east-daemon"}],
  sharedServices:{name:"services",expectedHostName:"services-node",expectedArchitecture:"amd64",expectedHostIdentity:"services-host",expectedDockerDaemonIdentity:"services-daemon"},
  deployment:{workload:{kind:"W0",durationSeconds:30,sustainedArmOptIn:false}}}' > "$inventory"
chmod 600 "$inventory"
inventory_hash="$(jq -S -c . "$inventory" | sha256sum)"; inventory_hash="${inventory_hash%% *}"

prepare_run_base() {
    local label="$1"
    FIXTURE_STATE="$TEMP_DIR/$label-state"
    FIXTURE_EVIDENCE="$TEMP_DIR/$label-evidence"
    deploy_prepare_run_state "$FIXTURE_STATE" "$FIXTURE_EVIDENCE"
    DEPLOY_MANIFEST_JSON="$(jq -n --arg run "$run_id" --arg mode "$mode" --arg hash "$inventory_hash" --arg revision "$revision" \
      '{schemaVersion:1,runId:$run,mode:$mode,inventorySha256:$hash,source:{revision:$revision,worktreeState:"clean"},phaseStatus:"passed"}')"
    deploy_publish_json "$DEPLOY_MANIFEST" "$DEPLOY_MANIFEST_JSON"
}

publish_smoke_fixture() {
    local smoke_json smoke_commit
    smoke_json="$(jq -cn --arg run "$run_id" --arg mode "$mode" --arg hash "$inventory_hash" --arg revision "$revision" \
      --argjson workload "$(jq -c '.deployment.workload' "$inventory")" '
      {schemaVersion:1,publicationGeneration:1,runId:$run,mode:$mode,inventorySha256:$hash,sourceRevision:$revision,
       workload:$workload,phaseStatus:"passed",startedAt:"2026-08-08T00:00:00Z",updatedAt:"2026-08-08T00:01:00Z",
       completedAt:"2026-08-08T00:01:00Z",targets:[{target:"east",deviceId:"east-device",status:"passed",profile:{},
       captureSequence:{},checks:{health:true},artifacts:[],telemetry:{}}]}')"
    smoke_commit="$(deploy_phase_commit_json "$smoke_json")"
    deploy_publish_json "$FIXTURE_STATE/smoke-ledger.json" "$smoke_json"
    deploy_publish_json "$FIXTURE_STATE/smoke-manifest.json" "$smoke_json"
    deploy_publish_json "$FIXTURE_EVIDENCE/smoke.json" "$smoke_json"
    deploy_publish_json "$FIXTURE_STATE/smoke-commit.json" "$smoke_commit"
}

prepare_fixture() {
    prepare_run_base "$1"
    publish_smoke_fixture
}

initialize_fixture() {
    prepare_fixture "$1"
    deploy_run_acceptance "$inventory" "$run_id" "$mode" "$inventory_hash" "$revision" clean "$tree"
}

close_fixture() {
    exec 201>&-
}

run_acceptance_child() {
    local state="$1" evidence="$2" failpoint="${3:-}"
    DEPLOY_TEST_FAILPOINT="$failpoint" bash -c '
      set -euo pipefail
      source_root="$1"
      REPO_ROOT="$2"
      . "$source_root/scripts/deploy/common.sh"
      . "$source_root/scripts/deploy/run-state.sh"
      . "$source_root/scripts/deploy/catalog.sh"
      . "$source_root/scripts/deploy/acceptance.sh"
      deploy_prepare_run_state "$3" "$4"
      deploy_run_acceptance "$5" "$6" "$7" "$8" "$9" clean "${10}"
    ' phase14-atomic "$SOURCE_REPO_ROOT" "$REPO_ROOT" "$state" "$evidence" "$inventory" "$run_id" "$mode" "$inventory_hash" "$revision" "$tree"
}

run_acceptance_record_child() {
    local state="$1" evidence="$2" artifact="$3" failpoint="${4:-}"
    DEPLOY_TEST_FAILPOINT="$failpoint" bash -c '
      set -euo pipefail
      source_root="$1"
      REPO_ROOT="$2"
      . "$source_root/scripts/deploy/common.sh"
      . "$source_root/scripts/deploy/run-state.sh"
      . "$source_root/scripts/deploy/catalog.sh"
      . "$source_root/scripts/deploy/acceptance.sh"
      deploy_prepare_run_state "$3" "$4"
      deploy_run_acceptance_record "$5" "$6" "$7" "$8" "$9" clean "${10}" normal-flow "${11}"
    ' phase14-record "$SOURCE_REPO_ROOT" "$REPO_ROOT" "$state" "$evidence" "$inventory" "$run_id" "$mode" "$inventory_hash" "$revision" "$tree" "$artifact"
}

write_scenario_artifact() {
    local destination="$1" scenario_id="$2" outcome="${3:-passed}" scenario ledger
    ledger="$(jq -c . "$FIXTURE_STATE/acceptance-ledger.json")"
    scenario="$(jq -c --arg id "$scenario_id" '.scenarios[] | select(.id == $id)' <<< "$ledger")"
    jq -S -n --argjson ledger "$ledger" --argjson scenario "$scenario" --arg outcome "$outcome" '
      {schemaVersion:1,runId:$ledger.runId,scenarioId:$scenario.id,inventorySha256:$ledger.inventorySha256,
       sourceRevision:$ledger.sourceRevision,sourceTree:$ledger.sourceTree,classification:$scenario.classification,
       executionClass:$scenario.executionClass,evidenceSource:$scenario.evidenceSource,workloads:$scenario.workloads,
       outcome:$outcome,startedAt:"2026-08-09T00:00:00Z",completedAt:"2026-08-09T00:10:00Z",
       assertions:[{id:"durable-convergence",passed:($outcome == "passed")}],
       outputs:[{id:"raw-window",byteLength:12879360,sha256:("a" * 64)}],
       measurements:[{id:"elapsed",value:600,unit:"seconds"}]}' > "$destination"
    chmod 600 "$destination"
}

expect_rejected() {
    local message="$1"
    shift
    if "$@" > "$TEMP_DIR/rejection.log" 2>&1; then fail "$message"; fi
}

audit_test_reference() {
    local reference="$1" payload fqn owner namespace class method
    local -a files
    [[ "$reference" =~ ^test:([A-Za-z_][A-Za-z0-9_]*\.){2,}[A-Za-z_][A-Za-z0-9_]*(\;case=[A-Za-z0-9._-]+)?$ && "$reference" != *'#'* ]] ||
      fail "Invalid test evidence syntax: $reference"
    payload="${reference#test:}"
    fqn="${payload%%;case=*}"
    method="${fqn##*.}"
    owner="${fqn%.*}"
    class="${owner##*.}"
    namespace="${owner%.*}"
    shopt -s globstar nullglob
    files=("$SOURCE_REPO_ROOT"/tests/**/"$class.cs")
    shopt -u globstar nullglob
    [[ "${#files[@]}" == 1 ]] || fail "Test evidence class did not resolve uniquely: $fqn"
    perl -0777 -e '
      my ($namespace, $class, $method, $path) = @ARGV;
      open my $file, "<", $path or exit 2;
      local $/; my $source = <$file>;
      exit 1 unless $source =~ /namespace\s+\Q$namespace\E\s*;/s;
      exit 1 unless $source =~ /(?:public\s+)?(?:sealed\s+)?class\s+\Q$class\E\b/s;
      exit 1 unless $source =~ /\[TestMethod\](?:(?!\bpublic\b).)*\bpublic\s+(?:async\s+)?(?:Task(?:<[^>]+>)?|void)\s+\Q$method\E\s*\(/s;
    ' "$namespace" "$class" "$method" "${files[0]}" || fail "Test evidence method is not a public MSTest method: $fqn"
}

audit_test_references() {
    local manifest="$1" reference
    while IFS= read -r reference; do audit_test_reference "$reference"; done < <(
      jq -r '[.scenarios[].evidenceSource | select(startswith("test:"))] | unique[]' "$manifest")
}

validate_evidence_contract() {
