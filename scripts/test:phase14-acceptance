        ($family.evidenceSourcePrefix | startswith("test:HVO.SkyMonitor.")) and
        ($family.commandTemplate | contains("8388002ce69aa1fa194e7644bd8f35352ac10acf")) and
        ($family.commandTemplate | contains("f045fcc2661ac6556d6765c13d5b03b3f223845e")) and
