         "sanitizer","admissibilityValidator","sourceRevision","sourceTree"] and
      .campaignIndexContract.revisionBindings ==
        [{actual:"scenarios[disposition=source-family-import].sourceRevision",expected:"sourceEvidenceContract.requiredSourceRevision"},
         {actual:"scenarios[disposition=source-family-import].sourceTree",expected:"sourceEvidenceContract.requiredSourceTree"},
         {actual:"scenarios[disposition=real-campaign].sourceRevision/sourceTree",expected:"corresponding runtime artifact sourceRevision/sourceTree retained by issue 320"},
         {actual:"scenarios[disposition=source-family-import|real-campaign].sourceRevision/sourceTree",expected:"corresponding runtime artifact sourceRevision/sourceTree"},
         {actual:"acceptanceRevision",expected:"acceptanceRevision"},
         {actual:"acceptanceTree",expected:"acceptanceTree"}] and
      .campaignIndexContract.transitions == ["not-run->recorded","recorded->passed"] and
      (.campaignIndexContract.resumePolicy | contains("immutable") and contains("commit envelope") and contains("SHA-256")) and
      (.campaignIndexContract.completionPolicy | contains("deferred") and contains("excluded") and contains("never reported as executed")) and
      [.statusContract[].status] == ["not-run","recorded","passed","deferred","excluded","campaign-complete","parent-complete"] and
      all(.statusContract[]; (.meaning | type == "string" and length > 0)) and
      [.followUpFamilies[] | {id,issue,dependsOn}] ==
        [{id:"source-family-import",issue:319,dependsOn:[318]},
         {id:"real-fault-campaigns",issue:320,dependsOn:[318]},
         {id:"campaign-aggregation",issue:321,dependsOn:[319,320]},
         {id:"measured-optimization",issue:322,dependsOn:[321]}] and
      (.followUpFamilies[] | select(.id == "real-fault-campaigns") | .owns |
        contains("normal-flow") and contains("logichost-network-outage") and
        contains("permanent-upload-rejection") and contains("network-failure")) and
      all(.followUpFamilies[]; (.owns | type == "string" and length > 0) and
        (.dependsOn | length > 0 and all(.[]; type == "number" and floor == .)))
    ' "$contract" >/dev/null
}

enum_values_json() {
    local file="$1" enum="$2"
    perl -0777 -e '
      my ($enum, $path) = @ARGV;
      open my $file, "<", $path or exit 2;
      local $/; my $source = <$file>;
      $source =~ /enum\s+\Q$enum\E\s*\{([^}]*)\}/s or exit 1;
      for my $value (split /,/, $1) {
        $value =~ s{//.*$}{}mg; $value =~ s/=.*//s; $value =~ s/^\s+|\s+$//g;
        print "$value\n" if $value =~ /^[A-Za-z_][A-Za-z0-9_]*$/;
      }
    ' "$enum" "$file" | jq -Rsc 'split("\n") | map(select(length > 0)) | sort'
}

assert_enum_coverage() {
    local file="$1" enum="$2" source_prefix="$3" exclusions="$4" actual expected
    actual="$(enum_values_json "$file" "$enum")" || fail "Could not parse fault enum $enum."
    actual="$(jq -c --argjson exclusions "$exclusions" '[.[] | select(. as $value | $exclusions | index($value) | not)]' <<< "$actual")"
    expected="$(jq -c --arg prefix "$source_prefix" '[.scenarios[].source | select(startswith($prefix)) | ltrimstr($prefix)] | sort' "$campaign")"
    [[ "$actual" == "$expected" ]] || fail "Manifest boundary coverage differs from $enum: enum=$actual manifest=$expected"
}

