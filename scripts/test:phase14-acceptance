    if run_acceptance_record_child "$final_state" "$final_evidence" "$final_input" "abrupt-after-acceptance-record-final-$boundary" \
      > "$TEMP_DIR/record-final-$boundary.log" 2>&1; then
        fail "Final acceptance-record $boundary failpoint unexpectedly passed."
    fi
    deploy_prepare_run_state "$final_state" "$final_evidence"
    deploy_run_acceptance_record "$inventory" "$run_id" "$mode" "$inventory_hash" "$revision" clean "$tree" normal-flow "$final_input"
    jq -e '.publicationGeneration == 4 and (.scenarios[] | select(.id == "normal-flow") | .status) == "recorded"' \
      "$final_evidence/acceptance-index.json" >/dev/null
    close_fixture
done

for failpoint in abrupt-after-acceptance-record-intent abrupt-after-acceptance-record-artifact; do
    initialize_fixture "record-${failpoint##*-}"
    interrupted_state="$FIXTURE_STATE"; interrupted_evidence="$FIXTURE_EVIDENCE"
    interrupted_input="$TEMP_DIR/$failpoint.json"
    write_scenario_artifact "$interrupted_input" normal-flow
    close_fixture
    if run_acceptance_record_child "$interrupted_state" "$interrupted_evidence" "$interrupted_input" "$failpoint" \
      > "$TEMP_DIR/$failpoint.log" 2>&1; then
        fail "$failpoint unexpectedly passed."
    fi
    deploy_prepare_run_state "$interrupted_state" "$interrupted_evidence"
    deploy_run_acceptance_record "$inventory" "$run_id" "$mode" "$inventory_hash" "$revision" clean "$tree" normal-flow "$interrupted_input"
    jq -e '.publicationGeneration == 4 and (.scenarios[] | select(.id == "normal-flow") | .status) == "recorded"' \
      "$interrupted_evidence/acceptance-index.json" >/dev/null
    close_fixture
done

prepare_fixture concurrent-lock
if (deploy_prepare_run_state "$FIXTURE_STATE" "$FIXTURE_EVIDENCE") >/dev/null 2>&1; then
    fail 'The shared deployment run lock allowed a concurrent acceptance-init invocation.'
fi
close_fixture

printf 'Phase 14 acceptance manifest/index contract tests passed.\n'
