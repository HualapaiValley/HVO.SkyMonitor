  all(.scenarios[] | select(.id != "normal-flow"); .status == "not-run") and
  all(.scenarios[]; .status != "passed")' "$FIXTURE_EVIDENCE/acceptance-index.json" >/dev/null
[[ "$(stat -c '%u:%h:%a' "$recorded")" == "$(id -u):1:600" ]] || fail 'Recorded artifact is not owner-only.'
record_digest="$(sha256sum "$recorded")"
index_digest="$(sha256sum "$FIXTURE_EVIDENCE/acceptance-index.json")"
deploy_run_acceptance_record "$inventory" "$run_id" "$mode" "$inventory_hash" "$revision" clean "$tree" normal-flow "$record_artifact"
[[ "$(sha256sum "$recorded")" == "$record_digest" && "$(sha256sum "$FIXTURE_EVIDENCE/acceptance-index.json")" == "$index_digest" ]] ||
  fail 'Idempotent artifact recording rewrote committed evidence.'
expect_rejected 'Unknown scenario recording was accepted.' \
  deploy_run_acceptance_record "$inventory" "$run_id" "$mode" "$inventory_hash" "$revision" clean "$tree" missing-scenario "$record_artifact"
mismatched="$TEMP_DIR/mismatched-flow.json"
jq '.scenarioId="logichost-network-outage"' "$record_artifact" > "$mismatched"; chmod 600 "$mismatched"
expect_rejected 'Contextually mismatched artifact was accepted.' \
  deploy_run_acceptance_record "$inventory" "$run_id" "$mode" "$inventory_hash" "$revision" clean "$tree" normal-flow "$mismatched"
close_fixture

initialize_fixture record-artifact-tamper
tamper_input="$TEMP_DIR/tamper-input.json"
write_scenario_artifact "$tamper_input" normal-flow
deploy_run_acceptance_record "$inventory" "$run_id" "$mode" "$inventory_hash" "$revision" clean "$tree" normal-flow "$tamper_input"
tampered_record="$FIXTURE_EVIDENCE/acceptance-artifacts/normal-flow.json"
jq '.measurements[0].value=601' "$tampered_record" > "$TEMP_DIR/tampered-record"; chmod 600 "$TEMP_DIR/tampered-record"; mv "$TEMP_DIR/tampered-record" "$tampered_record"
tampered_digest="$(sha256sum "$tampered_record")"
expect_rejected 'Tampered recorded artifact was accepted.' \
  deploy_run_acceptance "$inventory" "$run_id" "$mode" "$inventory_hash" "$revision" clean "$tree"
[[ "$(sha256sum "$tampered_record")" == "$tampered_digest" ]] || fail 'Rejected artifact tamper was changed.'
close_fixture

initialize_fixture record-hardlink-input
hardlink_input="$TEMP_DIR/hardlink-input.json"
write_scenario_artifact "$hardlink_input" normal-flow
ln "$hardlink_input" "$TEMP_DIR/hardlink-input-copy"
expect_rejected 'Hardlinked artifact input was accepted.' \
  deploy_run_acceptance_record "$inventory" "$run_id" "$mode" "$inventory_hash" "$revision" clean "$tree" normal-flow "$hardlink_input"
close_fixture

initialize_fixture record-symlink-input
symlink_target="$TEMP_DIR/symlink-input-target.json"
write_scenario_artifact "$symlink_target" normal-flow
ln -s "$symlink_target" "$TEMP_DIR/symlink-input.json"
expect_rejected 'Symlinked artifact input was accepted.' \
  deploy_run_acceptance_record "$inventory" "$run_id" "$mode" "$inventory_hash" "$revision" clean "$tree" normal-flow "$TEMP_DIR/symlink-input.json"
close_fixture

for boundary in ledger manifest evidence commit; do
    initialize_fixture "record-atomic-$boundary"
    atomic_record_state="$FIXTURE_STATE"; atomic_record_evidence="$FIXTURE_EVIDENCE"
    atomic_record_input="$TEMP_DIR/record-atomic-$boundary.json"
    write_scenario_artifact "$atomic_record_input" normal-flow
    close_fixture
    if run_acceptance_record_child "$atomic_record_state" "$atomic_record_evidence" "$atomic_record_input" "abrupt-after-acceptance-record-$boundary" \
      > "$TEMP_DIR/record-atomic-$boundary.log" 2>&1; then
        fail "Atomic acceptance-record $boundary failpoint unexpectedly passed."
    fi
    deploy_prepare_run_state "$atomic_record_state" "$atomic_record_evidence"
    deploy_run_acceptance_record "$inventory" "$run_id" "$mode" "$inventory_hash" "$revision" clean "$tree" normal-flow "$atomic_record_input"
    jq -e '.publicationGeneration == 4 and (.scenarios[] | select(.id == "normal-flow") | .status) == "recorded"' \
      "$atomic_record_evidence/acceptance-index.json" >/dev/null
    close_fixture
done

