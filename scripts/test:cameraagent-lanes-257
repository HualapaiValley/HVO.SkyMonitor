#!/usr/bin/env bash
# Collect and authenticate the five-trial current-profile lane evidence for issue #257.

set -euo pipefail
umask 077
export LC_ALL=C

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly REPO_ROOT
readonly PROJECT="$REPO_ROOT/tests/HVO.SkyMonitor.CameraAgent.Tests/HVO.SkyMonitor.CameraAgent.Tests.csproj"
readonly CONTROL_FILTER='FullyQualifiedName~CaptureControlPerformanceTests.W1AndW2SparseMeteringWritesCaptureControlEvidence'
readonly LANE_FILTER='FullyQualifiedName~DurableCaptureDistributionPerformanceTests.W2W3MAndBlockedLane_DurableLaneEvidence'

if [[ $# -ne 0 ]]; then
    printf 'Usage: %s\n' "${0##*/}" >&2
    exit 2
fi
for command in cut dotnet flock git jq sha256sum stat tr; do
    command -v "$command" >/dev/null 2>&1 || {
        printf 'Required command is unavailable: %s\n' "$command" >&2
        exit 2
    }
done
if [[ -z "${HVO_AGENT_STATE_ROOT:-}" || ! -d "$HVO_AGENT_STATE_ROOT" ]]; then
    printf 'HVO_AGENT_STATE_ROOT must identify the persistent agent-state directory.\n' >&2
    exit 2
fi

REVISION="$(git -C "$REPO_ROOT" rev-parse HEAD)"
readonly REVISION
BRANCH="$(git -C "$REPO_ROOT" branch --show-current)"
readonly BRANCH
STATUS="$(git -C "$REPO_ROOT" status --porcelain=v1 --untracked-files=all)"
readonly STATUS
readonly OUTPUT_ROOT="$HVO_AGENT_STATE_ROOT/issues/257/$REVISION"
OUTPUT_PARENT="$(dirname "$OUTPUT_ROOT")"
readonly OUTPUT_PARENT
if [[ ! "$REVISION" =~ ^[0-9a-f]{40}$ || "$BRANCH" != 'perf/cameraagent-lane-rebaseline-257' ]]; then
    printf 'Issue #257 evidence requires its claimed branch and exact 40-hex HEAD.\n' >&2
    exit 2
fi
if [[ -n "$STATUS" ]]; then
    printf 'Issue #257 evidence requires a clean working tree.\n' >&2
    exit 2
fi
if [[ -e "$OUTPUT_ROOT" ]]; then
    printf 'Issue #257 output already exists and will not be overwritten: %s\n' "$OUTPUT_ROOT" >&2
    exit 2
fi

mkdir -p "$OUTPUT_PARENT"
exec 8> "$OUTPUT_PARENT/.performance.lock"
flock -n 8 || {
    printf 'Another issue #257 performance campaign owns the evidence lock.\n' >&2
    exit 2
}
mkdir "$OUTPUT_ROOT"

dotnet restore "$PROJECT"
dotnet build "$PROJECT" --no-restore --configuration Release -warnaserror

run_control() {
    local trial="$1"
    DOTNET_gcServer=1 \
    HVO_ISSUE_257_EVIDENCE=1 \
    HVO_EVIDENCE_REVISION="$REVISION" \
    HVO_EVIDENCE_TRIAL="$trial" \
    HVO_ISSUE_257_OUTPUT_ROOT="$OUTPUT_ROOT" \
        dotnet test "$PROJECT" --no-build --configuration Release --filter "$CONTROL_FILTER"
}

run_lanes() {
    local trial="$1"
    local order="$2"
    DOTNET_gcServer=1 \
    HVO_ISSUE_257_EVIDENCE=1 \
    HVO_EVIDENCE_REVISION="$REVISION" \
    HVO_EVIDENCE_TRIAL="$trial" \
    HVO_ISSUE_257_ORDER="$order" \
    HVO_ISSUE_257_OUTPUT_ROOT="$OUTPUT_ROOT" \
        dotnet test "$PROJECT" --no-build --configuration Release --filter "$LANE_FILTER"
}

verify_trial_manifest() {
    local manifest="$1"
    local trial_dir="$2"
    local trial="$3"
    local expected_names_json="$4"
    jq --exit-status --arg revision "$REVISION" --argjson trial "$trial" --argjson expected "$expected_names_json" '
        .issue == 257 and .trial == $trial and .revision == $revision and
        (.artifacts | type) == "array" and
        ([.artifacts[].name] | sort) == ($expected | sort) and
        ([.artifacts[].name] | length) == ([.artifacts[].name] | unique | length) and
        all(.artifacts[]; (.name | type) == "string" and (.bytes | type) == "number" and .bytes > 0 and
            (.sha256 | type) == "string" and (.sha256 | test("^[0-9A-F]{64}$")))
    ' \
        "$manifest" >/dev/null
    local entries
    entries="$(jq -er '.artifacts[] | [.name, (.bytes | tostring), .sha256] | @tsv' "$manifest")"
    while IFS=$'\t' read -r name expected_bytes expected_sha256; do
        local artifact="$trial_dir/$name"
        [[ -f "$artifact" ]] || {
            printf 'Manifest artifact is missing: %s\n' "$artifact" >&2
            return 1
        }
        [[ "$(stat -c %s "$artifact")" == "$expected_bytes" ]] || {
            printf 'Manifest byte length changed: %s\n' "$artifact" >&2
            return 1
        }
        [[ "$(sha256sum "$artifact" | cut -d ' ' -f 1 | tr '[:lower:]' '[:upper:]')" == "$expected_sha256" ]] || {
            printf 'Manifest SHA-256 changed: %s\n' "$artifact" >&2
            return 1
        }
    done <<< "$entries"
}

assert_source_unchanged() {
    local current_revision
    local current_branch
    local current_status
    current_revision="$(git -C "$REPO_ROOT" rev-parse HEAD)"
    current_branch="$(git -C "$REPO_ROOT" branch --show-current)"
    current_status="$(git -C "$REPO_ROOT" status --porcelain=v1 --untracked-files=all)"
    [[ "$current_revision" == "$REVISION" && "$current_branch" == "$BRANCH" && -z "$current_status" ]] || {
        printf 'Repository HEAD, branch, or cleanliness changed during issue #257 evidence.\n' >&2
        exit 1
    }
}

for trial in 1 2 3 4 5; do
    if (( trial % 2 == 1 )); then
        run_control "$trial"
        run_lanes "$trial" UB
    else
        run_lanes "$trial" BU
        run_control "$trial"
    fi

    trial_dir="$OUTPUT_ROOT/trial-$(printf '%02d' "$trial")"
    expected_order="$([[ $((trial % 2)) -eq 1 ]] && printf UB || printf BU)"
    jq --exit-status --arg revision "$REVISION" --argjson trial "$trial" --arg order "$expected_order" '
        .issue == 257 and .trial == $trial and .revision == $revision and
        .workload.profileSha256 == "227FB3C0484AB5BBAFC4CA3674EA0D68B473315EBDD63F547CB2851D0A00F499" and
        .w3M.userVersion == 10 and .baseline.comparison == "N/A" and
        .blockedComparison.executionOrder == (if $order == "UB" then ["unblocked", "blocked"] else ["blocked", "unblocked"] end) and
        .blockedComparison.unblocked.productionClaimWarmupSamples == 5 and
        .blockedComparison.unblocked.productionClaimMeasuredSamples == 30 and
        .blockedComparison.blocked.productionClaimWarmupSamples == 5 and
        .blockedComparison.blocked.productionClaimMeasuredSamples == 30 and
        .blockedComparison.unblocked.finalPendingLaneRows == 0 and
        .blockedComparison.blocked.finalPendingLaneRows == 0 and
        .blockedComparison.unblocked.finalQuarantinedLaneRows == 0 and
        .blockedComparison.blocked.finalQuarantinedLaneRows == 0
    ' "$trial_dir/capture-lanes-performance.json" >/dev/null
    jq --exit-status --arg revision "$REVISION" --argjson trial "$trial" '
        .issue == 257 and .trial == $trial and .revision.evidenceRevision == $revision and
        .revision.dirty == false and
        ([.workloads[] | select(.id == "W2") | .canonicalProfileSha256] ==
          ["227FB3C0484AB5BBAFC4CA3674EA0D68B473315EBDD63F547CB2851D0A00F499"])
    ' "$trial_dir/capture-control-performance.json" >/dev/null
    jq --exit-status '
        .finalDurableState.blockedPendingRows == 0 and
        .finalDurableState.blockedQuarantinedRows == 0 and
        .finalDurableState.forcedShutdownObserved == false and
        ([.observedLogEvents[].eventId] | all(. < 2060 or . > 2062))
    ' "$trial_dir/runtime-signals.json" >/dev/null
    verify_trial_manifest \
        "$trial_dir/capture-control-manifest.json" "$trial_dir" "$trial" \
        '["capture-control-performance.json"]'
    verify_trial_manifest \
        "$trial_dir/capture-lanes-manifest.json" "$trial_dir" "$trial" \
        '["capture-lanes-performance.json","runtime-signals.json"]'
done

assert_source_unchanged

readonly LANES_TEMP="$OUTPUT_ROOT/.lanes.json"
readonly CONTROLS_TEMP="$OUTPUT_ROOT/.controls.json"
set -o noclobber
jq -s '.' "$OUTPUT_ROOT"/trial-*/capture-lanes-performance.json > "$LANES_TEMP"
jq -s '.' "$OUTPUT_ROOT"/trial-*/capture-control-performance.json > "$CONTROLS_TEMP"
jq -n --slurpfile lanes "$LANES_TEMP" --slurpfile controls "$CONTROLS_TEMP" --arg revision "$REVISION" '
    def stats:
        sort as $values |
        {minimum: $values[0], median: $values[2], maximum: $values[4],
         maximumToMinimumRatio: (if $values[0] > 0 then $values[4] / $values[0] else null end)};
    def stable:
        sort as $values |
        if $values[4] == 0 then $values[0] == 0
        else $values[0] > 0 and ($values[4] / $values[0]) <= 1.25
        end;
    def magnitude_stable:
        map(if . < 0 then -. else . end) | stable;
    def within_blocked_budget($baseline; $candidate):
        $candidate <= ($baseline + ([($baseline * 0.10), 5] | max));
    ($lanes[0]) as $lane |
    ($controls[0]) as $control |
    {
        schema: "hvo-issue-257-five-trial-summary-v1",
        issue: 257,
        revision: $revision,
        trialCount: 5,
        trialOrder: ["control-UB", "BU-control", "control-UB", "BU-control", "control-UB"],
        baseline: {
            comparison: "N/A",
            reason: "Issue #95 used a different profile identity and raw-ingress schema."
        },
        identities: {
            profileSha256: ($lane | map(.workload.profileSha256) | unique | if length == 1 then .[0] else error("profile changed") end),
            rawIngressSchema: ($lane | map(.w3M.userVersion) | unique | if length == 1 then .[0] else error("schema changed") end),
            testAssemblySha256: ($lane | map(.provenance.testAssembly.sha256) | unique | if length == 1 then .[0] else error("test assembly changed") end),
            productionAssemblySha256: ($lane | map(.provenance.productionAssembly.sha256) | unique | if length == 1 then .[0] else error("production assembly changed") end)
        },
        metrics: {
            w2IngressMedianMilliseconds: ($lane | map(.w2.medianMilliseconds) | stats),
            w2IngressP95Milliseconds: ($lane | map(.w2.p95Milliseconds) | stats),
            w2IngressCapturesPerSecond: ($lane | map(.w2.throughputPerSecond) | stats),
            w2CpuMilliseconds: ($lane | map(.w2.cpuMilliseconds) | stats),
            w2AllocatedBytes: ($lane | map(.w2.allocatedBytes) | stats),
            w2RssDeltaBytes: ($lane | map(.w2.rssAfterBytes - .w2.rssBeforeBytes) | stats),
            w3MMigrationMilliseconds: ($lane | map(.w3M.migrationMilliseconds) | stats),
            w3MCpuMilliseconds: ($lane | map(.w3M.cpuMilliseconds) | stats),
            w3MAllocatedBytes: ($lane | map(.w3M.allocatedBytes) | stats),
            w3MRestartDiscoveryMedianMilliseconds: ($lane | map(.w3M.restartDiscoveryMedianMilliseconds) | stats),
            syntheticIndexedTraversalMilliseconds: ($lane | map(.w3M.syntheticIndexedTraversalMilliseconds) | stats),
            unblockedProductionClaimP95Milliseconds: ($lane | map(.blockedComparison.unblocked.standardClaimP95Milliseconds) | stats),
            blockedProductionClaimP95Milliseconds: ($lane | map(.blockedComparison.blocked.standardClaimP95Milliseconds) | stats),
            unblockedProductionClaimMaximumMilliseconds: ($lane | map(.blockedComparison.unblocked.standardClaimMaximumMilliseconds) | stats),
            blockedProductionClaimMaximumMilliseconds: ($lane | map(.blockedComparison.blocked.standardClaimMaximumMilliseconds) | stats),
            unblockedStandardAckP95Milliseconds: ($lane | map(.blockedComparison.unblocked.standardAckP95Milliseconds) | stats),
            blockedStandardAckP95Milliseconds: ($lane | map(.blockedComparison.blocked.standardAckP95Milliseconds) | stats),
            unblockedIngressP95Milliseconds: ($lane | map(.blockedComparison.unblocked.acceptP95Milliseconds) | stats),
            blockedIngressP95Milliseconds: ($lane | map(.blockedComparison.blocked.acceptP95Milliseconds) | stats),
            unblockedCommitCpuMilliseconds: ($lane | map(.blockedComparison.unblocked.commitCpuMilliseconds) | stats),
            blockedCommitCpuMilliseconds: ($lane | map(.blockedComparison.blocked.commitCpuMilliseconds) | stats),
            unblockedCommitAllocatedBytes: ($lane | map(.blockedComparison.unblocked.commitAllocatedBytes) | stats),
            blockedCommitAllocatedBytes: ($lane | map(.blockedComparison.blocked.commitAllocatedBytes) | stats),
            unblockedRssMedianGrowthBytes: ($lane | map(.blockedComparison.unblocked.rssMedianGrowthBytes) | stats),
            blockedRssMedianGrowthBytes: ($lane | map(.blockedComparison.blocked.rssMedianGrowthBytes) | stats),
            requiredDrainCapturesPerSecond: ($lane | map(.blockedComparison.blocked.requiredDrainCapturesPerSecond) | stats),
            optionalRecoveryCapturesPerSecond: ($lane | map(.blockedComparison.blocked.optionalRecoveryCapturesPerSecond) | stats),
            blockedRestartDiscoveryMedianMilliseconds: ($lane | map(.blockedComparison.blocked.restartDiscoveryMedianMilliseconds) | stats),
            w2SparseMeterWallP95Milliseconds: ($control | map(.workloads[] | select(.id == "W2") | .candidate.wallP95Milliseconds) | stats),
            w2SparseMeterCpuP95Milliseconds: ($control | map(.workloads[] | select(.id == "W2") | .candidate.cpuP95Milliseconds) | stats),
            w2SparseMeterAllocatedBytes: ($control | map(.workloads[] | select(.id == "W2") | .candidate.allocatedBytesTotal) | stats)
        },
        gates: {
            perTrialCorrectness: ([$lane[] |
                .blockedComparison.unblocked.finalPendingLaneRows == 0 and
                .blockedComparison.blocked.finalPendingLaneRows == 0 and
                .blockedComparison.unblocked.finalQuarantinedLaneRows == 0 and
                .blockedComparison.blocked.finalQuarantinedLaneRows == 0 and
                .blockedComparison.blocked.requiredDrainCapturesPerSecond >= 1 and
                .blockedComparison.blocked.optionalRecoveryCapturesPerSecond >= 1 and
                .blockedComparison.unblocked.rssMedianGrowthBytes <= 67108864 and
                .blockedComparison.blocked.rssMedianGrowthBytes <= 67108864 and
                within_blocked_budget(
                    .blockedComparison.unblocked.acceptP95Milliseconds;
                    .blockedComparison.blocked.acceptP95Milliseconds) and
                within_blocked_budget(
                    .blockedComparison.unblocked.standardAckP95Milliseconds;
                    .blockedComparison.blocked.standardAckP95Milliseconds)] | all) and
                ([$control[].workloads[].productionScenarios[] |
                    .finalAcquisitionBacklog == 0 and
                    .postReleaseOptionalBacklog == 0 and
                    .postReleaseCentralBacklog == 0] | all),
            positiveScalarRangeWithin25Percent: ([$lane |
                map(.w2.medianMilliseconds),
                map(.w2.p95Milliseconds),
                map(.w2.throughputPerSecond),
                map(.w2.cpuMilliseconds),
                map(.w2.allocatedBytes),
                map(.w3M.migrationMilliseconds),
                map(.w3M.cpuMilliseconds),
                map(.w3M.allocatedBytes),
                map(.w3M.restartDiscoveryMedianMilliseconds),
                map(.w3M.syntheticIndexedTraversalMilliseconds),
                map(.blockedComparison.unblocked.standardClaimP95Milliseconds),
                map(.blockedComparison.blocked.standardClaimP95Milliseconds),
                map(.blockedComparison.unblocked.standardClaimMaximumMilliseconds),
                map(.blockedComparison.blocked.standardClaimMaximumMilliseconds),
                map(.blockedComparison.unblocked.standardAckP95Milliseconds),
                map(.blockedComparison.blocked.standardAckP95Milliseconds),
                map(.blockedComparison.unblocked.acceptP95Milliseconds),
                map(.blockedComparison.blocked.acceptP95Milliseconds),
                map(.blockedComparison.unblocked.commitCpuMilliseconds),
                map(.blockedComparison.blocked.commitCpuMilliseconds),
                map(.blockedComparison.unblocked.commitAllocatedBytes),
                map(.blockedComparison.blocked.commitAllocatedBytes),
                map(.blockedComparison.blocked.requiredDrainCapturesPerSecond),
                map(.blockedComparison.blocked.optionalRecoveryCapturesPerSecond),
                map(.blockedComparison.blocked.restartDiscoveryMedianMilliseconds)] |
                all(stable)) and
                ([$control |
                    map(.workloads[] | select(.id == "W2") | .candidate.wallP95Milliseconds),
                    map(.workloads[] | select(.id == "W2") | .candidate.cpuP95Milliseconds),
                    map(.workloads[] | select(.id == "W2") | .candidate.allocatedBytesTotal)] |
                    all(stable)),
            rssGrowthWithinDeclaredAbsoluteBudget: ([$lane[] |
                .blockedComparison.unblocked.rssMedianGrowthBytes <= 67108864 and
                .blockedComparison.blocked.rssMedianGrowthBytes <= 67108864] | all),
            rssMagnitudeRangeWithin25Percent: ([$lane |
                map(.w2.rssAfterBytes - .w2.rssBeforeBytes),
                map(.blockedComparison.unblocked.rssMedianGrowthBytes),
                map(.blockedComparison.blocked.rssMedianGrowthBytes)] |
                all(magnitude_stable))
        }
    } |
    .result = {passed: (.gates.perTrialCorrectness and .gates.positiveScalarRangeWithin25Percent and
        .gates.rssGrowthWithinDeclaredAbsoluteBudget and .gates.rssMagnitudeRangeWithin25Percent)}
' > "$OUTPUT_ROOT/five-trial-summary.json"
rm "$LANES_TEMP" "$CONTROLS_TEMP"
jq --exit-status '.result.passed == true' "$OUTPUT_ROOT/five-trial-summary.json" >/dev/null
assert_source_unchanged

{
    for artifact in "$OUTPUT_ROOT"/trial-*/*.json "$OUTPUT_ROOT/five-trial-summary.json"; do
        jq -n \
            --arg path "${artifact#"$OUTPUT_ROOT"/}" \
            --arg sha256 "$(sha256sum "$artifact" | cut -d ' ' -f 1 | tr '[:lower:]' '[:upper:]')" \
            --argjson bytes "$(stat -c %s "$artifact")" \
            '{path: $path, bytes: $bytes, sha256: $sha256}'
    done
} | jq -s --arg revision "$REVISION" '
    {schema: "hvo-issue-257-manifest-v1", issue: 257, revision: $revision, artifacts: sort_by(.path)}
' > "$OUTPUT_ROOT/manifest.json"

assert_source_unchanged

printf 'Issue #257 evidence completed: %s\n' "$OUTPUT_ROOT"
