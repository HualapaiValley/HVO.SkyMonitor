#!/usr/bin/env bash
# Merge-queue half of the hvo/reviewed-head gate.
#
# hvo/reviewed-head is a commit status that the reviewing operator publishes on
# a pull request's exact head after both formal reviews converge. Branch rules
# require it on the PR head before the PR can enter the merge queue. The queue
# then builds a temporary merge_group commit that never carries that status, so
# the same required context has to be produced there. This script produces it
# only after re-checking, through the API, that:
#
#   1. the merge_group commit is a two-parent merge whose second parent is the
#      queued pull request's current head (merge-commit method only);
#   2. that pull request is open and targets the queue's base branch; and
#   3. the newest hvo/reviewed-head commit status on that exact head is
#      `success` and was published by an allowed account.
#
# It runs only on merge_group (see merge-queue-reviewed-head.yml). It must never
# run on pull_request: a passing or skipped job with this name on a PR would
# satisfy the required context without a review.
#
# Inputs (environment): REPOSITORY, HEAD_REF, GROUP_SHA, BASE_REF,
# ALLOWED_SETTERS (space-separated logins). Uses `gh api` with GH_TOKEN.
set -euo pipefail

fail() { printf 'hvo/reviewed-head (merge queue): %s\n' "$*" >&2; exit 1; }

: "${REPOSITORY:?REPOSITORY is required}"
: "${HEAD_REF:?HEAD_REF is required}"
: "${GROUP_SHA:?GROUP_SHA is required}"
: "${BASE_REF:?BASE_REF is required}"
: "${ALLOWED_SETTERS:?ALLOWED_SETTERS is required}"
context="hvo/reviewed-head"

[[ "$GROUP_SHA" =~ ^[0-9a-f]{40}$ ]] || fail "merge group SHA is not a full commit SHA: $GROUP_SHA"
base_branch="${BASE_REF#refs/heads/}"
queue_prefix="refs/heads/gh-readonly-queue/${base_branch}/pr-"
[[ "$HEAD_REF" == "$queue_prefix"* ]] || fail "unexpected merge group ref: $HEAD_REF"
suffix="${HEAD_REF#"$queue_prefix"}"
[[ "$suffix" =~ ^([0-9]+)-[0-9a-f]{40}$ ]] || fail "cannot read the pull request number from $HEAD_REF"
pr="${BASH_REMATCH[1]}"

parents="$(gh api "repos/${REPOSITORY}/commits/${GROUP_SHA}" --jq '.parents | map(.sha) | join(" ")')" \
  || fail "cannot read merge group commit $GROUP_SHA"
read -r -a parent_list <<< "$parents"
((${#parent_list[@]} == 2)) || fail "merge group commit $GROUP_SHA has ${#parent_list[@]} parents; only the merge-commit method is supported"
queued_head="${parent_list[1]}"

pull="$(gh api "repos/${REPOSITORY}/pulls/${pr}" --jq '[.state, .base.ref, .head.sha] | join(" ")')" \
  || fail "cannot read pull request #$pr"
read -r pr_state pr_base pr_head <<< "$pull"
[[ "$pr_state" == "open" ]] || fail "pull request #$pr is $pr_state"
[[ "$pr_base" == "$base_branch" ]] || fail "pull request #$pr targets $pr_base, not $base_branch"
[[ "$pr_head" == "$queued_head" ]] || fail "pull request #$pr head $pr_head is not the queued head $queued_head"

# Statuses are returned newest first; sorting on the monotonically increasing id
# keeps "newest wins" explicit across pages, so a later failure revokes a success.
latest="$(gh api --paginate "repos/${REPOSITORY}/commits/${pr_head}/statuses?per_page=100" \
  --jq ".[] | select(.context == \"${context}\") | [.id, .state, .creator.login] | @tsv" \
  | sort -t $'\t' -k1,1nr | head -n 1)" || fail "cannot read commit statuses on $pr_head"
[[ -n "$latest" ]] || fail "pull request #$pr head $pr_head has no $context status"
IFS=$'\t' read -r _ state creator <<< "$latest"
[[ "$state" == "success" ]] || fail "newest $context on $pr_head is $state"
allowed="false"
for login in $ALLOWED_SETTERS; do
  [[ "$creator" == "$login" ]] && allowed="true"
done
[[ "$allowed" == "true" ]] || fail "newest $context on $pr_head was published by $creator, who is not allowed"

printf 'hvo/reviewed-head (merge queue): #%s head %s carries %s=success from %s; merge group %s\n' \
  "$pr" "$pr_head" "$context" "$creator" "$GROUP_SHA"
