#!/usr/bin/env bash
# infra:status - Show status of infrastructure and application services
# Usage: ./scripts/infra:status [SERVICE...]

set -euo pipefail

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [[ -f .env ]]; then
    set -a
    source .env
    set +a
fi

readonly ALL_SERVICES=(postgres minio redis smtp logichost cameraagent)

SERVICES=("$@")
if [[ ${#SERVICES[@]} -eq 0 ]]; then
    SERVICES=("${ALL_SERVICES[@]}")
fi

get_compose_file() {
    local service="$1"
    case "$service" in
        postgres|minio|redis|smtp) echo "docker-compose.infrastructure.yml" ;;
        logichost|cameraagent) echo "docker-compose.apps.yml" ;;
        *) echo "docker-compose.infrastructure.yml" ;;
    esac
}

format_status() {
    local status="$1"
    case "$status" in
        running)
            echo -e "${GREEN}running${NC}"
            ;;
        exited)
            echo -e "${RED}exited${NC}"
            ;;
        restarting)
            echo -e "${YELLOW}restarting${NC}"
            ;;
        paused)
            echo -e "${YELLOW}paused${NC}"
            ;;
        *)
            echo -e "${RED}$status${NC}"
            ;;
    esac
}

format_health() {
    local health="$1"
    case "$health" in
        healthy)
            echo -e "${GREEN}healthy${NC}"
            ;;
        unhealthy)
            echo -e "${RED}unhealthy${NC}"
            ;;
        starting)
            echo -e "${YELLOW}starting${NC}"
            ;;
        *)
            echo -e "${BLUE}$health${NC}"
            ;;
    esac
}

echo -e "${BLUE}=== Service Status ===${NC}\n"

for service in "${SERVICES[@]}"; do
    compose_file="$(get_compose_file "$service")"
    container_info=$(docker compose -f "$compose_file" ps "$service" --format json 2>/dev/null || echo "{}")

    if [[ -z "$container_info" ]] || [[ "$container_info" == "{}" ]]; then
        echo -e "${service}: ${RED}not found${NC}"
        continue
    fi

    state=$(echo "$container_info" | grep -o '"State":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
    status=$(echo "$container_info" | grep -o '"Status":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
    health=$(echo "$container_info" | grep -o '"Health":"[^"]*"' | cut -d'"' -f4 || echo "none")

    echo -n "$service: "
    format_status "$state"
    if [[ "$health" != "none" ]] && [[ -n "$health" ]]; then
        echo -n "  Health: "
        format_health "$health"
    fi
    if [[ "$status" != "unknown" ]]; then
        echo "  ($status)"
    else
        echo ""
    fi
done

echo ""
echo -e "${BLUE}Tip:${NC} Use './scripts/infra:logs <service>' to view logs"
echo -e "${BLUE}Tip:${NC} Use './scripts/infra:start' to start services"
