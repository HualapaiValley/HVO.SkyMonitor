#!/usr/bin/env bash
# infra:status - Show status of infrastructure and application services
# Usage: ./scripts/infra:status [SERVICE...]
# Examples:
#   ./scripts/infra:status           # Show status of all services
#   ./scripts/infra:status postgres  # Show status of specific service

set -euo pipefail

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Change to repo root
cd "$REPO_ROOT"

# Load environment variables
if [ -f .env ]; then
    set -a
    source .env
    set +a
fi

# Define all available services
readonly ALL_SERVICES=(postgres minio redis smtp skymonitor cameraagent-sim cameraagent-zwo)

# Parse arguments
SERVICES=("$@")

# If no services specified, check all
if [[ ${#SERVICES[@]} -eq 0 ]]; then
    SERVICES=("${ALL_SERVICES[@]}")
fi

# Function to get docker context for a service
get_docker_context() {
    local service="$1"
    local context_var=""
    
    case "$service" in
        postgres)
            context_var="${POSTGRES_DOCKER_CONTEXT:-default}"
            ;;
        minio)
            context_var="${MINIO_DOCKER_CONTEXT:-default}"
            ;;
        redis)
            context_var="${REDIS_DOCKER_CONTEXT:-default}"
            ;;
        smtp)
            context_var="${SMTP_DOCKER_CONTEXT:-default}"
            ;;
        skymonitor)
            context_var="${SKYMONITOR_DOCKER_CONTEXT:-default}"
            ;;
        cameraagent-sim)
            context_var="${CAMERAAGENT_SIM_DOCKER_CONTEXT:-default}"
            ;;
        cameraagent-zwo)
            context_var="${CAMERAAGENT_ZWO_DOCKER_CONTEXT:-default}"
            ;;
        *)
            context_var="default"
            ;;
    esac
    
    echo "$context_var"
}

# Function to format status with color
format_status() {
    local status="$1"
    case "$status" in
        running)
            echo -e "${GREEN}running${NC}"
            ;;
        exited)
            echo -e "${RED}exited${NC}"
            ;;
        restarting)
            echo -e "${YELLOW}restarting${NC}"
            ;;
        paused)
            echo -e "${YELLOW}paused${NC}"
            ;;
        *)
            echo -e "${RED}$status${NC}"
            ;;
    esac
}

# Function to format health with color
format_health() {
    local health="$1"
    case "$health" in
        healthy)
            echo -e "${GREEN}healthy${NC}"
            ;;
        unhealthy)
            echo -e "${RED}unhealthy${NC}"
            ;;
        starting)
            echo -e "${YELLOW}starting${NC}"
            ;;
        *)
            echo -e "${BLUE}$health${NC}"
            ;;
    esac
}

echo -e "${BLUE}=== Service Status ===${NC}"
echo ""

# Check each service
for service in "${SERVICES[@]}"; do
    context="$(get_docker_context "$service")"
    
    # Get container info
    container_info=$(docker --context "$context" compose -f docker-compose.dev.yml ps "$service" --format json 2>/dev/null || echo "{}")
    
    if [[ -z "$container_info" ]] || [[ "$container_info" == "{}" ]]; then
        echo -e "${service}: ${RED}not found${NC}"
        continue
    fi
    
    # Parse JSON output
    state=$(echo "$container_info" | grep -o '"State":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
    status=$(echo "$container_info" | grep -o '"Status":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
    health=$(echo "$container_info" | grep -o '"Health":"[^"]*"' | cut -d'"' -f4 || echo "none")
    
    # Format output
    echo -n "$service: "
    format_status "$state"
    
    if [[ "$health" != "none" ]] && [[ -n "$health" ]]; then
        echo -n "  Health: "
        format_health "$health"
    fi
    
    if [[ "$status" != "unknown" ]]; then
        echo "  ($status)"
    else
        echo ""
    fi
done

echo ""
echo -e "${BLUE}Tip:${NC} Use 'docker compose -f docker-compose.dev.yml logs -f <service>' to view logs"
echo -e "${BLUE}Tip:${NC} Use './scripts/infra:start' to start services"
