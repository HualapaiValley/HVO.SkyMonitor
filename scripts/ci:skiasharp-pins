#!/usr/bin/env python3
"""Reject partial managed/native SkiaSharp version bumps before native tests run."""
from pathlib import Path
import sys
import xml.etree.ElementTree as ET


def validate(path):
    pins = [item for item in ET.parse(path).iter("PackageVersion")
            if item.get("Include", "").startswith("SkiaSharp")]
    names = [item.get("Include") for item in pins]
    versions = {item.get("Version", "").strip() for item in pins}
    if ("SkiaSharp" not in names or "SkiaSharp.NativeAssets.Linux.NoDependencies" not in names
            or len(names) != len(set(names)) or len(versions) != 1 or "" in versions):
        raise ValueError("All SkiaSharp managed/native package pins must share one explicit version.")
    return len(pins), versions.pop()


if __name__ == "__main__":
    source = Path(sys.argv[1]) if len(sys.argv) == 2 else Path(__file__).resolve().parent.parent / "Directory.Packages.props"
    try:
        count, version = validate(source)
    except (ValueError, ET.ParseError, OSError):
        sys.exit("SkiaSharp pin guard failed: require matching, unique managed/native version pins.")
    print(f"SkiaSharp pin guard passed: {count} packages at {version}.")
