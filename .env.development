# Development Environment Variables
# These are non-sensitive defaults for local development
# DO NOT commit sensitive data to this file

USE_CONTAINERS=true
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPIRE_ALLOW_UNSECURED_TRANSPORT=true
DOCKER_HOST_ADDRESS=0.0.0.0

# Development MinIO Credentials (use user secrets for custom values)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# PostgreSQL Development Defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skymonitordb
