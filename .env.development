# Development Environment Variables (checked into repo)
# Add shared-service credentials only to the ignored root .env.

USE_CONTAINERS=true
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# Persistent shared services on hvo-docker.
SQLSERVER_HOST=hvo-docker.hvo.lan
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=SkyMonitor
SQLSERVER_USER=sa
REDIS_HOST=hvo-docker.hvo.lan
REDIS_PORT=6379
MINIO_HOST=hvo-docker.hvo.lan
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=hvo-docker.hvo.lan:9000
MINIO_ROOT_USER=skymonitor
SMTP_HOST=hvo-docker.hvo.lan
SMTP_PORT=1025
SMTP_WEB_PORT=8025

LOGIC_HOST_HTTP_PORT=5174
LOGIC_HOST_HTTPS_PORT=7096
CAMERA_AGENT_HTTP_PORT=5130
CAMERA_AGENT_IDENTITY_PUBLIC_URL=http://localhost:5174
CAMERA_AGENT_IDENTITY_DB_PATH=/app/App_Data/identity/cameraagent_identity.db
