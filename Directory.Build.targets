<Project>
  <!--
    A build names the product version in Directory.Build.props or a pre-release of it (install contract section 1,
    #1310), so a release cannot ship a program that says another version: -p:Version must be X.Y.Z or X.Y.Z-<pre-release>,
    and a build given an informational version must give that same version, compared ordinally, case and all (the SDK
    sets it from the version, and appends the commit, after this check; MSBuild's own != ignores case). A VERSION
    environment variable sets the version too, because MSBuild reads environment variables as properties, ignoring case.
  -->
  <Target Name="HvoCheckProductVersion" BeforeTargets="BeforeBuild">
    <Error Code="HVO1310"
           Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '\A$([System.Text.RegularExpressions.Regex]::Escape('$(VersionPrefix)'))(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?\z'))"
           Text="Version '$(Version)' is not the product version $(VersionPrefix) (Directory.Build.props) or a pre-release of it. If you did not pass -p:Version, a VERSION environment variable set it: unset it." />
    <Error Code="HVO1310"
           Condition="'$(InformationalVersion)' != '' and !$([System.String]::Equals('$(InformationalVersion)', '$(Version)', StringComparison.Ordinal))"
           Text="The informational version '$(InformationalVersion)' is not the version '$(Version)': give a build its version as -p:Version, not -p:InformationalVersion." />
  </Target>

  <!--
    Terminal.Gui brings in TextMateSharp, its grammars and Onigwrap's native Oniguruma for its Code and Markdown views'
    syntax highlighting, which no terminal program here uses (#1317). A project that builds on HVO.SkyMonitor.TerminalUi
    (the installer, and hvo-sky), or a test project that runs one in-process (HvoTerminalProgram), takes none of their
    files, so the published programs do not carry them or their notices. scripts/lib/published-installer-terminal.py
    runs the published installer to show it works without them.
  -->
  <ItemGroup Condition="'$(HvoTerminalProgram)' == 'true' or '@(ProjectReference->WithMetadataValue('Filename', 'HVO.SkyMonitor.TerminalUi'))' != ''">
    <PackageReference Include="TextMateSharp" ExcludeAssets="all" />
    <PackageReference Include="TextMateSharp.Grammars" ExcludeAssets="all" />
    <PackageReference Include="Onigwrap" ExcludeAssets="all" />
  </ItemGroup>
</Project>
