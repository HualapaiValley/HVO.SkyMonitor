# HVO.SkyMonitor Environment Template
# Copy to .env for local development. Only include non-sensitive values here.

ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# Telemetry is exported through the shared OpenTelemetry collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.1.238:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Application ports exposed to the host
HVO_RUNTIME_DATA_ROOT=./data
CAMERA_AGENT_HTTP_PORT=5130
CAMERA_AGENT_IDENTITY_DB_PATH=/app/App_Data/identity/cameraagent_identity.db
CAMERA_AGENT_ADMIN_EMAIL=owner@cameraagent.local
CAMERA_AGENT_ADMIN_PASSWORD=
# Operator settings file for a directly run CameraAgent, loaded over its appsettings.json and written by the
# Observatory & location page. Without it a directly run host loads none and those settings cannot be saved.
# Installer deployments use state/identity/appsettings.local.json instead. The path must be absolute and its
# directory must exist.
# HVO_SETTINGS_FILE=/absolute/path/to/data/cameraagent/appsettings.local.json

# Run local application commands with repository secrets loaded:
# ./scripts/with-env dotnet run --project src/HVO.SkyMonitor.CameraAgent/HVO.SkyMonitor.CameraAgent.csproj
# Install the verified production catalog before starting CameraAgent:
# hvo-sky-install catalog install --catalog-bundle /path/to/hyg-v4.4-p4-s3-r1.bundle --product-root "$PWD/data"
