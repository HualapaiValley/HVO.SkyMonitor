# HVO.SkyMonitor Environment Template
# Copy to .env for local development. Only include non-sensitive values here.

USE_CONTAINERS=true
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# Telemetry (safe default key)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=461820e1-768d-49c2-9ffa-dcadc6f8076a;IngestionEndpoint=https://westus3-1.in.applicationinsights.azure.com/;LiveEndpoint=https://westus3.livediagnostics.monitor.azure.com/;ApplicationId=ffe9f937-60da-4b07-8645-88b24d8f5e4f

# Infrastructure credentials (override with secrets for custom installs)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
POSTGRES_USER=hvo_dev
POSTGRES_PASSWORD=hvo_dev_password
POSTGRES_DB=skymonitordb
IDENTITYSERVER_ISSUER=http://logichost:8080/

# Data directories mounted into docker compose services
POSTGRES_DATA_DIR=./data/postgres
MINIO_DATA_DIR=./data/minio
REDIS_DATA_DIR=./data/redis

# Local infrastructure endpoints (docker compose runs inside devcontainer)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
MINIO_HOST=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_WEB_PORT=8025

# Application ports exposed to the host
LOGIC_HOST_HTTP_PORT=5174
LOGIC_HOST_HTTPS_PORT=7096
CAMERA_AGENT_HTTP_PORT=5130
CAMERA_AGENT_IDENTITY_PUBLIC_URL=http://localhost:5174
CAMERA_AGENT_IDENTITY_DB_PATH=/app/App_Data/identity/cameraagent_identity.db

# Additional knobs (keep defaults unless you know what to override)
CAMERA_AGENT_LOGIC_BASEURL=http://logichost:8080
CAMERA_AGENT_IDENTITY_URL=http://logichost:8080