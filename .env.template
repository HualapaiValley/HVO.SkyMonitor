# HVO.SkyMonitor Environment Template
# Copy to .env for local development. Only include non-sensitive values here.

ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# Telemetry is exported through the shared OpenTelemetry collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.1.238:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Shared infrastructure on hvo-docker.hvo.lan. Set passwords only in .env.
# SQL Server is provisioned separately on hvo-docker. Use a login scoped to SkyMonitor.
SQLSERVER_HOST=hvo-docker.hvo.lan
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=SkyMonitor
SQLSERVER_USER=skymonitor-app
SQLSERVER_PASSWORD=
REDIS_HOST=hvo-docker.hvo.lan
REDIS_PORT=6379
REDIS_USER=skymonitor-app
REDIS_PASSWORD=
MINIO_HOST=hvo-docker.hvo.lan
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=skymonitor
MINIO_ROOT_PASSWORD=
# Application-scoped MinIO service account, limited to skymonitor-* buckets.
MINIO_ACCESS_KEY=skymonitor-app
MINIO_SECRET_KEY=
SMTP_HOST=hvo-docker.hvo.lan
SMTP_PORT=1025
SMTP_WEB_PORT=8025
SMTP_FROM=no-reply@skymonitor.local

# Application ports exposed to the host
HVO_RUNTIME_DATA_ROOT=./data
LOGIC_HOST_HTTP_PORT=5174
CAMERA_AGENT_HTTP_PORT=5130
CAMERA_AGENT_IDENTITY_PUBLIC_URL=http://localhost:5174
CAMERA_AGENT_IDENTITY_DB_PATH=/app/App_Data/identity/cameraagent_identity.db
CAMERA_AGENT_ADMIN_EMAIL=owner@cameraagent.local
CAMERA_AGENT_ADMIN_PASSWORD=
CAMERA_AGENT_OAUTH_CLIENT_ID=system-camera-agent
CAMERA_AGENT_OAUTH_CLIENT_SECRET=

# Additional knobs (keep defaults unless you know what to override)
CAMERA_AGENT_LOGIC_BASEURL=http://logichost:8080
CAMERA_AGENT_IDENTITY_URL=http://logichost:8080
CAMERA_AGENT_PUBLIC_LOGIC_BASEURL=http://localhost:5174

# Optional remote Docker SSH key. Keep the value only in the host environment or
# .devcontainer/devcontainer.local.env. Newlines must be escaped as \n; never
# commit it. The devcontainer configures this key for SSH user roys.
# SSH_PRIVATE_KEY=

# Optional developer identity, matching HVO.WebSite devcontainer conventions.
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GH_PAT=

# Developer-tool bootstrap. Tailscale consumes this secret only when durable
# state does not already contain an authenticated node. Never commit a real key.
# TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=dev-host-skymonitor
TAILSCALE_ACCEPT_ROUTES=true

# Run local application commands with repository secrets loaded:
# ./scripts/with-env dotnet run --project src/HVO.SkyMonitor.LogicHost/HVO.SkyMonitor.LogicHost.csproj
# Install the verified production catalog before starting either host:
# ./scripts/catalog:install install /path/to/hyg-v4.2-p3-s2-r1.bundle ./data/catalog
